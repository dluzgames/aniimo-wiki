m","초원 형태",16,{"id":1289,"parentId":1218,"tagType":1219,"tagKey":1290,"name":1291,"language":1222,"sort":1292},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1294,"parentId":1218,"tagType":1219,"tagKey":1295,"name":1296,"language":1222,"sort":1297},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1299,"parentId":1218,"tagType":1219,"tagKey":1300,"name":1301,"language":1222,"sort":1302},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1304,"parentId":1218,"tagType":1219,"tagKey":1305,"name":1306,"language":1222,"sort":1307},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]