98},[207],"2",[22],{"id":210,"title":211,"children":212},"91268347_37","고유 스킬",[213],{"id":214,"type":139,"props":215},"91268347_38",{"id":216,"customKey":46,"icon":217,"iconStyle":63,"iconTitle":46,"descTitle":218,"descContent":219,"source":220},"91268347_39","/cdn/init/1002100_Skill_16800000_Icon.png","공격","무력화 시 어둠 원소 능력을 사용하여 근거리 대상을 공격합니다.",{"attributes":221,"type":222,"consume":223,"power":224},[183],[22],"0","6",[226,227,228],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":229,"entryId":12,"currentMorphology":230,"visible":15},"10003279","Mountain Woods Form",[232,244,254,265,275,285,295,307,317,327,337,348,358,370,380,391,402,412,422,432,442,452,462,473,483,493,503,513,523,533,543,553,563,573,583,593,603,614,624,634,644,654,664,674,684,694,704,714,724,734,744,754,764,774,784,794,804,814,824,834,843,847,856,865,875,885,895,905,915,925,935,945,955,965,975,985,995,1005,1015,1025,1035,1045,1055,1065,1075,1085,1095,1105,1115,1125,1135,1145,1155,1166],{"id":233,"viewCount":57,"searchKey":234,"visible":15},"10003217",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":21,"currentStage":22,"position":240,"attributes":242},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[241],"position-dps",[243],"attributes-fire",{"id":245,"viewCount":57,"searchKey":246,"visible":15},"10003309",{"type":10,"entryId":247,"sortOrder":248,"name":249,"imageUrl":250,"description":251,"currentMorphology":21,"currentStage":207,"position":252,"attributes":253},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[241],[243],{"id":255,"viewCount":57,"searchKey":256,"visible":15},"10003210",{"type":10,"entryId":257,"sortOrder":258,"name":259,"imageUrl":260,"description":261,"currentMorphology":21,"currentStage":262,"position":263,"attributes":264},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[241],[243],{"id":266,"viewCount":57,"searchKey":267,"visible":15},"10003203",{"type":10,"entryId":268,"sortOrder":269,"name":270,"imageUrl":271,"description":272,"currentMorphology":21,"currentStage":262,"position":273,"attributes":274},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[24],[243,26],{"id":276,"viewCount":57,"searchKey":277,"visible":15},"10003353",{"type":10,"entryId":278,"sortOrder":279,"name":280,"imageUrl":281,"description":282,"currentMorphology":21,"currentStage":22,"position":283,"attributes":284},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[241],[26],{"id":286,"viewCount":57,"searchKey":287,"visible":15},"10003192",{"type":10,"entryId":288,"sortOrder":289,"name":290,"imageUrl":291,"description":292,"currentMorphology":21,"currentStage":262,"position":293,"attributes":294},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[241],[26],{"id":296,"viewCount":57,"searchKey":297,"visible":15},"10003263",{"type":10,"entryId":298,"sortOrder":299,"name":300,"imageUrl":301,"description":302,"currentMorphology":21,"currentStage":22,"position":303,"attributes":305},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[304],"position-sup",[306],"attributes-wind",{"id":308,"viewCount":57,"searchKey":309,"visible":15},"10003323",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":21,"currentStage":262,"position":315,"attributes":316},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[304],[306],{"id":318,"viewCount":57,"searchKey":319,"visible":15},"10003249",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":21,"currentStage":262,"position":325,"attributes":326},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[241],[306],{"id":328,"viewCount":57,"searchKey":329,"visible":15},"10003242",{"type":10,"entryId":330,"sortOrder":331,"name":332,"imageUrl":333,"description":334,"currentMorphology":21,"currentStage":262,"position":335,"attributes":336},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[24],[306],{"id":338,"viewCount":57,"searchKey":339,"visible":15},"10003167",{"type":10,"entryId":340,"sortOrder":341,"name":342,"imageUrl":343,"description":344,"currentMorphology":21,"currentStage":22,"position":345,"attributes":346},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[241],[347],"attributes-grass",{"id":349,"viewCount":57,"searchKey":350,"visible":15},"10003285",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":21,"currentStage":262,"position":356,"attributes":357},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[241],[347],{"id":359,"viewCount":57,"searchKey":360,"visible":15},"10003252",{"type":10,"entryId":361,"sortOrder":362,"name":363,"imageUrl":364,"description":365,"currentMorphology":21,"currentStage":22,"position":366,"attributes":368},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[367],"position-heal",[369],"attributes-water",{"id":371,"viewCount":57,"searchKey":372,"visible":15},"10003344",{"type":10,"entryId":373,"sortOrder":374,"name":375,"imageUrl":376,"description":377,"currentMorphology":21,"currentStage":207,"position":378,"attributes":379},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[367],[369],{"id":381,"viewCount":57,"searchKey":382,"visible":15},"10003245",{"type":10,"entryId":383,"sortOrder":384,"name":385,"imageUrl":386,"description":387,"currentMorphology":21,"currentStage":262,"position":388,"attributes":389},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[367],[369,390],"attributes-ice",{"id":392,"viewCount":57,"searchKey":393,"visible":15},"10003238",{"type":10,"entryId":394,"sortOrder":395,"name":396,"imageUrl":397,"description":398,"currentMorphology":21,"currentStage":262,"position":399,"attributes":401},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[400],"position-energy",[347,369],{"id":403,"viewCount":57,"searchKey":404,"visible":15},"10003243",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":21,"currentStage":22,"position":410,"attributes":411},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[304],[306],{"id":413,"viewCount":57,"searchKey":414,"visible":15},"10003140",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":21,"currentStage":262,"position":420,"attributes":421},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[304],[306],{"id":423,"viewCount":57,"searchKey":424,"visible":15},"10003236",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":21,"currentStage":262,"position":430,"attributes":431},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[304],[26],{"id":433,"viewCount":57,"searchKey":434,"visible":15},"10003196",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":21,"currentStage":22,"position":440,"attributes":441},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[24],[347],{"id":443,"viewCount":57,"searchKey":444,"visible":15},"10003189",{"type":10,"entryId":445,"sortOrder":446,"name":447,"imageUrl":448,"description":449,"currentMorphology":21,"currentStage":262,"position":450,"attributes":451},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[400],[26,347],{"id":453,"viewCount":57,"searchKey":454,"visible":15},"10003179",{"type":10,"entryId":455,"sortOrder":456,"name":457,"imageUrl":458,"description":459,"currentMorphology":21,"currentStage":262,"position":460,"attributes":461},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[24],[347],{"id":463,"viewCount":57,"searchKey":464,"visible":15},"10003342",{"type":10,"entryId":465,"sortOrder":466,"name":467,"imageUrl":468,"description":469,"currentMorphology":21,"currentStage":22,"position":470,"attributes":471},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[24],[472,347],"attributes-rock",{"id":474,"viewCount":57,"searchKey":475,"visible":15},"10003237",{"type":10,"entryId":476,"sortOrder":477,"name":478,"imageUrl":479,"description":480,"currentMorphology":21,"currentStage":262,"position":481,"attributes":482},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[24],[472,347],{"id":484,"viewCount":57,"searchKey":485,"visible":15},"10003326",{"type":10,"entryId":486,"sortOrder":487,"name":488,"imageUrl":489,"description":490,"currentMorphology":21,"currentStage":262,"position":491,"attributes":492},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[24],[390],{"id":494,"viewCount":57,"searchKey":495,"visible":15},"10003184",{"type":10,"entryId":496,"sortOrder":497,"name":498,"imageUrl":499,"description":500,"currentMorphology":21,"currentStage":22,"position":501,"attributes":502},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[400],[243],{"id":504,"viewCount":57,"searchKey":505,"visible":15},"10003282",{"type":10,"entryId":506,"sortOrder":507,"name":508,"imageUrl":509,"description":510,"currentMorphology":21,"currentStage":262,"position":511,"attributes":512},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[400],[243],{"id":514,"viewCount":57,"searchKey":515,"visible":15},"10003317",{"type":10,"entryId":516,"sortOrder":517,"name":518,"imageUrl":519,"description":520,"currentMorphology":21,"currentStage":22,"position":521,"attributes":522},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[367],[306],{"id":524,"viewCount":57,"searchKey":525,"visible":15},"10003215",{"type":10,"entryId":526,"sortOrder":527,"name":528,"imageUrl":529,"description":530,"currentMorphology":21,"currentStage":262,"position":531,"attributes":532},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[367],[306],{"id":534,"viewCount":57,"searchKey":535,"visible":15},"10003338",{"type":10,"entryId":536,"sortOrder":537,"name":538,"imageUrl":539,"description":540,"currentMorphology":21,"currentStage":223,"position":541,"attributes":542},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[400],[306,347],{"id":544,"viewCount":57,"searchKey":545,"visible":15},"10003143",{"type":10,"entryId":546,"sortOrder":547,"name":548,"imageUrl":549,"description":550,"currentMorphology":21,"currentStage":22,"position":551,"attributes":552},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[304],[306],{"id":554,"viewCount":57,"searchKey":555,"visible":15},"10003138",{"type":10,"entryId":556,"sortOrder":557,"name":558,"imageUrl":559,"description":560,"currentMorphology":21,"currentStage":262,"position":561,"attributes":562},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[304],[306],{"id":564,"viewCount":57,"searchKey":565,"visible":15},"10003290",{"type":10,"entryId":566,"sortOrder":567,"name":568,"imageUrl":569,"description":570,"currentMorphology":21,"currentStage":22,"position":571,"attributes":572},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[241],[347],{"id":574,"viewCount":57,"searchKey":575,"visible":15},"10003271",{"type":10,"entryId":576,"sortOrder":577,"name":578,"imageUrl":579,"description":580,"currentMorphology":21,"currentStage":262,"position":581,"attributes":582},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[241],[347],{"id":584,"viewCount":57,"searchKey":585,"visible":15},"10003153",{"type":10,"entryId":586,"sortOrder":587,"name":588,"imageUrl":589,"description":590,"currentMorphology":21,"currentStage":262,"position":591,"attributes":592},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[304],[347],{"id":594,"viewCount":57,"searchKey":595,"visible":15},"10003231",{"type":10,"entryId":596,"sortOrder":597,"name":598,"imageUrl":599,"description":600,"currentMorphology":21,"currentStage":22,"position":601,"attributes":602},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[24],[347],{"id":604,"viewCount":57,"searchKey":605,"visible":15},"10003149",{"type":10,"entryId":606,"sortOrder":607,"name":608,"imageUrl":609,"description":610,"currentMorphology":21,"currentStage":262,"position":611,"attributes":612},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[304],[613],"attributes-electric",{"id":615,"viewCount":57,"searchKey":616,"visible":15},"10003218",{"type":10,"entryId":617,"sortOrder":618,"name":619,"imageUrl":620,"description":621,"currentMorphology":21,"currentStage":262,"position":622,"attributes":623},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[24],[347],{"id":625,"viewCount":57,"searchKey":626,"visible":15},"10003278",{"type":10,"entryId":627,"sortOrder":628,"name":629,"imageUrl":630,"description":631,"currentMorphology":21,"currentStage":22,"position":632,"attributes":633},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[304],[26],{"id":635,"viewCount":57,"searchKey":636,"visible":15},"10003296",{"type":10,"entryId":637,"sortOrder":638,"name":639,"imageUrl":640,"description":641,"currentMorphology":21,"currentStage":262,"position":642,"attributes":643},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[304],[26],{"id":645,"viewCount":57,"searchKey":646,"visible":15},"10003283",{"type":10,"entryId":647,"sortOrder":648,"name":649,"imageUrl":650,"description":651,"currentMorphology":21,"currentStage":22,"position":652,"attributes":653},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[241],[26],{"id":655,"viewCount":57,"searchKey":656,"visible":15},"10003144",{"type":10,"entryId":657,"sortOrder":658,"name":659,"imageUrl":660,"description":661,"currentMorphology":21,"currentStage":262,"position":662,"attributes":663},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[241],[26],{"id":665,"viewCount":57,"searchKey":666,"visible":15},"10003276",{"type":10,"entryId":667,"sortOrder":668,"name":669,"imageUrl":670,"description":671,"currentMorphology":21,"currentStage":262,"position":672,"attributes":673},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[241],[613],{"id":675,"viewCount":57,"searchKey":676,"visible":15},"10003197",{"type":10,"entryId":677,"sortOrder":678,"name":679,"imageUrl":680,"description":681,"currentMorphology":21,"currentStage":22,"position":682,"attributes":683},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[241],[390],{"id":685,"viewCount":57,"searchKey":686,"visible":15},"10003350",{"type":10,"entryId":687,"sortOrder":688,"name":689,"imageUrl":690,"description":691,"currentMorphology":21,"currentStage":207,"position":692,"attributes":693},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[241],[390],{"id":695,"viewCount":57,"searchKey":696,"visible":15},"10003190",{"type":10,"entryId":697,"sortOrder":698,"name":699,"imageUrl":700,"description":701,"currentMorphology":21,"currentStage":262,"position":702,"attributes":703},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[241],[390],{"id":705,"viewCount":57,"searchKey":706,"visible":15},"10003299",{"type":10,"entryId":707,"sortOrder":708,"name":709,"imageUrl":710,"description":711,"currentMorphology":21,"currentStage":22,"position":712,"attributes":713},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[24],[613],{"id":715,"viewCount":57,"searchKey":716,"visible":15},"10003250",{"type":10,"entryId":717,"sortOrder":718,"name":719,"imageUrl":720,"description":721,"currentMorphology":21,"currentStage":262,"position":722,"attributes":723},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[24],[613],{"id":725,"viewCount":57,"searchKey":726,"visible":15},"10003298",{"type":10,"entryId":727,"sortOrder":728,"name":729,"imageUrl":730,"description":731,"currentMorphology":21,"currentStage":22,"position":732,"attributes":733},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[24],[369],{"id":735,"viewCount":57,"searchKey":736,"visible":15},"10003173",{"type":10,"entryId":737,"sortOrder":738,"name":739,"imageUrl":740,"description":741,"currentMorphology":21,"currentStage":207,"position":742,"attributes":743},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[24],[369],{"id":745,"viewCount":57,"searchKey":746,"visible":15},"10003291",{"type":10,"entryId":747,"sortOrder":748,"name":749,"imageUrl":750,"description":751,"currentMorphology":21,"currentStage":262,"position":752,"attributes":753},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[304],[369],{"id":755,"viewCount":57,"searchKey":756,"visible":15},"10003341",{"type":10,"entryId":757,"sortOrder":758,"name":759,"imageUrl":760,"description":761,"currentMorphology":21,"currentStage":262,"position":762,"attributes":763},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[24],[369],{"id":765,"viewCount":57,"searchKey":766,"visible":15},"10003228",{"type":10,"entryId":767,"sortOrder":768,"name":769,"imageUrl":770,"description":771,"currentMorphology":21,"currentStage":22,"position":772,"attributes":773},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[241],[369],{"id":775,"viewCount":57,"searchKey":776,"visible":15},"10003352",{"type":10,"entryId":777,"sortOrder":778,"name":779,"imageUrl":780,"description":781,"currentMorphology":21,"currentStage":207,"position":782,"attributes":783},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[241],[369],{"id":785,"viewCount":57,"searchKey":786,"visible":15},"10003345",{"type":10,"entryId":787,"sortOrder":788,"name":789,"imageUrl":790,"description":791,"currentMorphology":21,"currentStage":262,"position":792,"attributes":793},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[241],[369],{"id":795,"viewCount":57,"searchKey":796,"visible":15},"10003340",{"type":10,"entryId":797,"sortOrder":798,"name":799,"imageUrl":800,"description":801,"currentMorphology":21,"currentStage":22,"position":802,"attributes":803},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[241],[472],{"id":805,"viewCount":57,"searchKey":806,"visible":15},"10003251",{"type":10,"entryId":807,"sortOrder":808,"name":809,"imageUrl":810,"description":811,"currentMorphology":21,"currentStage":262,"position":812,"attributes":813},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[241],[472],{"id":815,"viewCount":57,"searchKey":816,"visible":15},"10003241",{"type":10,"entryId":817,"sortOrder":818,"name":819,"imageUrl":820,"description":821,"currentMorphology":21,"currentStage":262,"position":822,"attributes":823},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[304],[472],{"id":825,"viewCount":57,"searchKey":826,"visible":15},"10003154",{"type":10,"entryId":827,"sortOrder":828,"name":829,"imageUrl":830,"description":831,"currentMorphology":21,"currentStage":22,"position":832,"attributes":833},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[241],[613],{"id":835,"viewCount":57,"searchKey":836,"visible":15},"10003151",{"type":10,"entryId":8,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":21,"currentStage":262,"position":841,"attributes":842},1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[241],[613],{"id":4,"viewCount":57,"searchKey":844,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":845,"attributes":846},[24],[26],{"id":848,"viewCount":57,"searchKey":849,"visible":15},"10003332",{"type":10,"entryId":850,"sortOrder":851,"name":80,"imageUrl":852,"description":853,"currentMorphology":21,"currentStage":262,"position":854,"attributes":855},"063",1002600,"/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[241],[26],{"id":857,"viewCount":57,"searchKey":858,"visible":15},"10003297",{"type":10,"entryId":859,"sortOrder":860,"name":88,"imageUrl":861,"description":862,"currentMorphology":21,"currentStage":262,"position":863,"attributes":864},"064",1002700,"/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[24],[26],{"id":866,"viewCount":57,"searchKey":867,"visible":15},"10003354",{"type":10,"entryId":868,"sortOrder":869,"name":870,"imageUrl":871,"description":872,"currentMorphology":21,"currentStage":22,"position":873,"attributes":874},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[24],[306],{"id":876,"viewCount":57,"searchKey":877,"visible":15},"10003164",{"type":10,"entryId":878,"sortOrder":879,"name":880,"imageUrl":881,"description":882,"currentMorphology":21,"currentStage":207,"position":883,"attributes":884},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[24],[306],{"id":886,"viewCount":57,"searchKey":887,"visible":15},"10003311",{"type":10,"entryId":888,"sortOrder":889,"name":890,"imageUrl":891,"description":892,"currentMorphology":21,"currentStage":262,"position":893,"attributes":894},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[24],[306],{"id":896,"viewCount":57,"searchKey":897,"visible":15},"10003304",{"type":10,"entryId":898,"sortOrder":899,"name":900,"imageUrl":901,"description":902,"currentMorphology":21,"currentStage":262,"position":903,"attributes":904},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[241],[243],{"id":906,"viewCount":57,"searchKey":907,"visible":15},"10003208",{"type":10,"entryId":908,"sortOrder":909,"name":910,"imageUrl":911,"description":912,"currentMorphology":21,"currentStage":22,"position":913,"attributes":914},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[241],[472],{"id":916,"viewCount":57,"searchKey":917,"visible":15},"10003202",{"type":10,"entryId":918,"sortOrder":919,"name":920,"imageUrl":921,"description":922,"currentMorphology":21,"currentStage":262,"position":923,"attributes":924},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[241],[472],{"id":926,"viewCount":57,"searchKey":927,"visible":15},"10003180",{"type":10,"entryId":928,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":21,"currentStage":22,"position":933,"attributes":934},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[24],[472],{"id":936,"viewCount":57,"searchKey":937,"visible":15},"10003300",{"type":10,"entryId":938,"sortOrder":939,"name":940,"imageUrl":941,"description":942,"currentMorphology":21,"currentStage":207,"position":943,"attributes":944},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[24],[243,472],{"id":946,"viewCount":57,"searchKey":947,"visible":15},"10003174",{"type":10,"entryId":948,"sortOrder":949,"name":950,"imageUrl":951,"description":952,"currentMorphology":21,"currentStage":262,"position":953,"attributes":954},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[24],[243,472],{"id":956,"viewCount":57,"searchKey":957,"visible":15},"10003293",{"type":10,"entryId":958,"sortOrder":959,"name":960,"imageUrl":961,"description":962,"currentMorphology":21,"currentStage":207,"position":963,"attributes":964},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[24],[472],{"id":966,"viewCount":57,"searchKey":967,"visible":15},"10003168",{"type":10,"entryId":968,"sortOrder":969,"name":970,"imageUrl":971,"description":972,"currentMorphology":21,"currentStage":262,"position":973,"attributes":974},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[24],[472],{"id":976,"viewCount":57,"searchKey":977,"visible":15},"10003161",{"type":10,"entryId":978,"sortOrder":979,"name":980,"imageUrl":981,"description":982,"currentMorphology":21,"currentStage":22,"position":983,"attributes":984},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[304],[472],{"id":986,"viewCount":57,"searchKey":987,"visible":15},"10003222",{"type":10,"entryId":988,"sortOrder":989,"name":990,"imageUrl":991,"description":992,"currentMorphology":21,"currentStage":262,"position":993,"attributes":994},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[304],[472],{"id":996,"viewCount":57,"searchKey":997,"visible":15},"10003272",{"type":10,"entryId":998,"sortOrder":999,"name":1000,"imageUrl":1001,"description":1002,"currentMorphology":21,"currentStage":22,"position":1003,"attributes":1004},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[304],[613],{"id":1006,"viewCount":57,"searchKey":1007,"visible":15},"10003254",{"type":10,"entryId":1008,"sortOrder":1009,"name":1010,"imageUrl":1011,"description":1012,"currentMorphology":21,"currentStage":207,"position":1013,"attributes":1014},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[304],[613],{"id":1016,"viewCount":57,"searchKey":1017,"visible":15},"10003163",{"type":10,"entryId":1018,"sortOrder":1019,"name":1020,"imageUrl":1021,"description":1022,"currentMorphology":21,"currentStage":262,"position":1023,"attributes":1024},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[304],[613],{"id":1026,"viewCount":57,"searchKey":1027,"visible":15},"10003204",{"type":10,"entryId":1028,"sortOrder":1029,"name":1030,"imageUrl":1031,"description":1032,"currentMorphology":21,"currentStage":22,"position":1033,"attributes":1034},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[400],[369],{"id":1036,"viewCount":57,"searchKey":1037,"visible":15},"10003205",{"type":10,"entryId":1038,"sortOrder":1039,"name":1040,"imageUrl":1041,"description":1042,"currentMorphology":21,"currentStage":262,"position":1043,"attributes":1044},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[400],[369],{"id":1046,"viewCount":57,"searchKey":1047,"visible":15},"10003324",{"type":10,"entryId":1048,"sortOrder":1049,"name":1050,"imageUrl":1051,"description":1052,"currentMorphology":21,"currentStage":223,"position":1053,"attributes":1054},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[400],[613],{"id":1056,"viewCount":57,"searchKey":1057,"visible":15},"10003269",{"type":10,"entryId":1058,"sortOrder":1059,"name":1060,"imageUrl":1061,"description":1062,"currentMorphology":21,"currentStage":22,"position":1063,"attributes":1064},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[400],[472,369],{"id":1066,"viewCount":57,"searchKey":1067,"visible":15},"10003261",{"type":10,"entryId":1068,"sortOrder":1069,"name":1070,"imageUrl":1071,"description":1072,"currentMorphology":21,"currentStage":262,"position":1073,"attributes":1074},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[400],[472,369],{"id":1076,"viewCount":57,"searchKey":1077,"visible":15},"10003305",{"type":10,"entryId":1078,"sortOrder":1079,"name":1080,"imageUrl":1081,"description":1082,"currentMorphology":21,"currentStage":22,"position":1083,"attributes":1084},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[24],[390],{"id":1086,"viewCount":57,"searchKey":1087,"visible":15},"10003232",{"type":10,"entryId":1088,"sortOrder":1089,"name":1090,"imageUrl":1091,"description":1092,"currentMorphology":21,"currentStage":262,"position":1093,"attributes":1094},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[24],[390],{"id":1096,"viewCount":57,"searchKey":1097,"visible":15},"10003198",{"type":10,"entryId":1098,"sortOrder":1099,"name":1100,"imageUrl":1101,"description":1102,"currentMorphology":21,"currentStage":22,"position":1103,"attributes":1104},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[367],[347,369],{"id":1106,"viewCount":57,"searchKey":1107,"visible":15},"10003194",{"type":10,"entryId":1108,"sortOrder":1109,"name":1110,"imageUrl":1111,"description":1112,"currentMorphology":21,"currentStage":262,"position":1113,"attributes":1114},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[367],[347,369],{"id":1116,"viewCount":57,"searchKey":1117,"visible":15},"10003185",{"type":10,"entryId":1118,"sortOrder":1119,"name":1120,"imageUrl":1121,"description":1122,"currentMorphology":21,"currentStage":22,"position":1123,"attributes":1124},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[241],[369],{"id":1126,"viewCount":57,"searchKey":1127,"visible":15},"10003284",{"type":10,"entryId":1128,"sortOrder":1129,"name":1130,"imageUrl":1131,"description":1132,"currentMorphology":21,"currentStage":262,"position":1133,"attributes":1134},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[241],[369],{"id":1136,"viewCount":57,"searchKey":1137,"visible":15},"10003188",{"type":10,"entryId":1138,"sortOrder":1139,"name":1140,"imageUrl":1141,"description":1142,"currentMorphology":21,"currentStage":22,"position":1143,"attributes":1144},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[241],[390],{"id":1146,"viewCount":57,"searchKey":1147,"visible":15},"10003182",{"type":10,"entryId":1148,"sortOrder":1149,"name":1150,"imageUrl":1151,"description":1152,"currentMorphology":21,"currentStage":262,"position":1153,"attributes":1154},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[241],[390],{"id":1156,"viewCount":57,"searchKey":1157,"visible":15},"10003273",{"type":10,"entryId":1158,"sortOrder":1159,"name":1160,"imageUrl":1161,"description":1162,"currentMorphology":21,"currentStage":223,"position":1163,"attributes":1164},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[241],[1165],"attributes-holy",{"id":1167,"viewCount":57,"searchKey":1168,"visible":15},"10003150",{"type":10,"entryId":1169,"sortOrder":1170,"name":1171,"imageUrl":1172,"description":1173,"currentMorphology":21,"currentStage":223,"position":1174,"attributes":1175},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[241],[1165],[1177,1184,1189,1192,1197,1202,1207,1212,1217,1222,1227,1230,1235,1239,1244,1249,1253,1258,1263],{"id":1178,"parentId":1179,"tagType":1180,"tagKey":13,"name":1181,"language":1182,"sort":1183},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","설원 형태","ko-KR",5,{"id":1185,"parentId":1179,"tagType":1180,"tagKey":1186,"name":1187,"language":1182,"sort":1188},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1190,"parentId":1179,"tagType":1180,"tagKey":21,"name":1191,"language":1182,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1193,"parentId":1179,"tagType":1180,"tagKey":1194,"name":1195,"language":1182,"sort":1196},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1198,"parentId":1179,"tagType":1180,"tagKey":1199,"name":1200,"language":1182,"sort":1201},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1203,"parentId":1179,"tagType":1180,"tagKey":1204,"name":1205,"language":1182,"sort":1206},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1208,"parentId":1179,"tagType":1180,"tagKey":1209,"name":1210,"language":1182,"sort":1211},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1213,"parentId":1179,"tagType":1180,"tagKey":1214,"name":1215,"language":1182,"sort":1216},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1218,"parentId":1179,"tagType":1180,"tagKey":1219,"name":1220,"language":1182,"sort":1221},"3c233890d20868e097e9cea7821aad8e","Umbrabow Form","옵시디언 형태",4,{"id":1223,"parentId":1179,"tagType":1180,"tagKey":1224,"name":1225,"language":1182,"sort":1226},"532c88e1ad2265245d2a450fe9e5629f","Highland Form","고지 형태",9,{"id":1228,"parentId":1179,"tagType":1180,"tagKey":9,"name":1229,"language":1182,"sort":82},"537f01b8a206e25a37d2ceb6c5325754","천휘 형태",{"id":1231,"parentId":1179,"tagType":1180,"tagKey":1232,"name":1233,"language":1182,"sort":1234},"6348a34364277