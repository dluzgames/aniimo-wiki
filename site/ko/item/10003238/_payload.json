,"애니모 능력",[145,161,177],{"id":146,"type":63,"props":147,"children":150},"91268266_21",{"title":148,"type":107,"id":149,"isUse":15,"isEdit":15,"useTabs":68,"blackHeader":68},"Pathfinding","91268266_22",[151],{"id":152,"type":153,"props":154,"children":60},"91268266_23","circle",{"id":155,"customKey":156,"icon":48,"iconStyle":48,"iconTitle":157,"descTitle":48,"descContent":48,"source":158,"bgColor":116,"fontColor":117,"type":118},"91268266_24","SWIM","수영 Lv.2",{"attributes":159,"type":160,"consume":48,"power":48},[],[],{"id":162,"type":63,"props":163,"children":166},"91268266_27",{"title":164,"type":66,"id":165,"isUse":15,"isEdit":15,"useTabs":68,"blackHeader":68},"애니모 특성","91268266_28",[167],{"id":168,"type":153,"props":169,"children":60},"91268266_29",{"id":170,"customKey":48,"icon":171,"iconStyle":66,"iconTitle":48,"descTitle":172,"descContent":173,"source":174},"91268266_30","/cdn/init/1004500_Feature_10473_Icon.png","자연의 힘","등장하지 않은 상태에서 아군이 스킬을 3회 사용할 때마다 발 아래에 풀밭이 생성됩니다.",{"attributes":175,"type":176,"consume":48,"power":48},[],[],{"id":178,"type":63,"props":179,"children":60},"91268266_31",{"title":180,"type":66,"id":181,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":68,"tabs":182},"스킬 소개","91268266_32",[183,223],{"id":184,"title":185,"children":186},"91268266_33","전투 스킬",[187,200,212],{"id":188,"type":153,"props":189},"91268266_34",{"id":190,"customKey":48,"icon":191,"iconStyle":66,"iconTitle":48,"descTitle":192,"descContent":193,"source":194},"91268266_35","/cdn/init/1004500_Skill_10600301_Icon.png","활력의 화원","발밑에 원형 마법진을 시전해 매초 범위 내 풀 원소 파티원의 에너지를 1 회복시키고, 12초 동안 지속됩니다. 또한 마법진은 범위 내의 풀밭을 활력의 화원으로 업그레이드해, 범위 내 풀 원소 파티원의 HP를 초당 1% 회복시킵니다.",{"attributes":195,"type":197,"consume":199,"power":198},[196],"6",[198],"0","10",{"id":201,"type":153,"props":202},"91268266_36",{"id":203,"customKey":48,"icon":204,"iconStyle":66,"iconTitle":48,"descTitle":205,"descContent":206,"source":207},"91268266_37","/cdn/init/1004500_Skill_10600322_Icon.png","리프 윈드","꼬리를 휘둘러 전방으로 이동하는 리프 윈드를 시전해 목표를 공격합니다. 자신 주위에 풀밭을 생성하고, 20초 동안 지속됩니다.",{"attributes":208,"type":209,"consume":199,"power":211},[196],[210],"2","33",{"id":213,"type":153,"props":214},"91268266_38",{"id":215,"customKey":48,"icon":216,"iconStyle":66,"iconTitle":48,"descTitle":217,"descContent":218,"source":219},"91268266_39","/cdn/init/1004500_Skill_10600306_Icon.png","덩굴 속박","목표 주위에 원형 마법 공격을 시전합니다. 영향을 받은 목표가 풀밭 위에 있으면 덩굴에 의해 3초 동안 속박됩니다.",{"attributes":220,"type":221,"consume":199,"power":222},[196],[210],"16",{"id":224,"title":225,"children":226},"91268266_40","고유 스킬",[227,237],{"id":228,"type":153,"props":229},"91268266_41",{"id":230,"customKey":48,"icon":231,"iconStyle":66,"iconTitle":48,"descTitle":232,"descContent":233,"source":234},"91268266_42","/cdn/init/1004500_Skill_10600420_Icon.png","연꽃의 꿈","빠르게 연꽃을 사용하여 자신을 감싼 뒤, 개화와 동시에 파티 전체의 HP가 순간적으로 회복됩니다. 회복량은 시전자 최대 HP의 15%이고, 전체 아군은 풀 원소 15% 강화 효과를 얻으며, 30초 동안 지속됩니다.",{"attributes":235,"type":236,"consume":198,"power":198},[196],[198],{"id":238,"type":153,"props":239},"91268266_43",{"id":240,"customKey":48,"icon":241,"iconStyle":66,"iconTitle":48,"descTitle":242,"descContent":243,"source":244},"91268266_44","/cdn/init/1004500_Skill_14200000_Icon.png","공격","풀 원소 능력을 사용하여 원거리에서 목표를 공격합니다.",{"attributes":245,"type":246,"consume":198,"power":196},[196],[210],[248],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[250,262,272,282,294,304,314,326,336,346,356,366,376,386,395,404,408,416,426,436,446,456,466,477,487,497,507,517,527,537,547,557,567,577,587,597,607,618,628,638,648,658,668,678,688,698,708,718,728,738,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,908,918,928,938,948,958,968,978,988,998,1008,1018,1028,1038,1048,1058,1068,1078,1088,1098,1108,1118,1128,1138,1148,1158,1168,1179],{"id":251,"viewCount":60,"searchKey":252,"visible":15},"10003217",{"type":10,"entryId":253,"sortOrder":254,"name":255,"imageUrl":256,"description":257,"currentMorphology":13,"currentStage":141,"position":258,"attributes":260},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[259],"position-dps",[261],"attributes-fire",{"id":263,"viewCount":60,"searchKey":264,"visible":15},"10003309",{"type":10,"entryId":265,"sortOrder":266,"name":267,"imageUrl":268,"description":269,"currentMorphology":13,"currentStage":210,"position":270,"attributes":271},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[259],[261],{"id":273,"viewCount":60,"searchKey":274,"visible":15},"10003210",{"type":10,"entryId":275,"sortOrder":276,"name":277,"imageUrl":278,"description":279,"currentMorphology":13,"currentStage":22,"position":280,"attributes":281},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[259],[261],{"id":283,"viewCount":60,"searchKey":284,"visible":15},"10003203",{"type":10,"entryId":285,"sortOrder":286,"name":287,"imageUrl":288,"description":289,"currentMorphology":13,"currentStage":22,"position":290,"attributes":292},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[291],"position-break",[261,293],"attributes-dark",{"id":295,"viewCount":60,"searchKey":296,"visible":15},"10003353",{"type":10,"entryId":297,"sortOrder":298,"name":299,"imageUrl":300,"description":301,"currentMorphology":13,"currentStage":141,"position":302,"attributes":303},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[259],[293],{"id":305,"viewCount":60,"searchKey":306,"visible":15},"10003192",{"type":10,"entryId":307,"sortOrder":308,"name":309,"imageUrl":310,"description":311,"currentMorphology":13,"currentStage":22,"position":312,"attributes":313},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[259],[293],{"id":315,"viewCount":60,"searchKey":316,"visible":15},"10003263",{"type":10,"entryId":317,"sortOrder":318,"name":319,"imageUrl":320,"description":321,"currentMorphology":13,"currentStage":141,"position":322,"attributes":324},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[323],"position-sup",[325],"attributes-wind",{"id":327,"viewCount":60,"searchKey":328,"visible":15},"10003323",{"type":10,"entryId":329,"sortOrder":330,"name":331,"imageUrl":332,"description":333,"currentMorphology":13,"currentStage":22,"position":334,"attributes":335},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[323],[325],{"id":337,"viewCount":60,"searchKey":338,"visible":15},"10003249",{"type":10,"entryId":339,"sortOrder":340,"name":341,"imageUrl":342,"description":343,"currentMorphology":13,"currentStage":22,"position":344,"attributes":345},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[259],[325],{"id":347,"viewCount":60,"searchKey":348,"visible":15},"10003242",{"type":10,"entryId":349,"sortOrder":350,"name":351,"imageUrl":352,"description":353,"currentMorphology":13,"currentStage":22,"position":354,"attributes":355},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[291],[325],{"id":357,"viewCount":60,"searchKey":358,"visible":15},"10003167",{"type":10,"entryId":359,"sortOrder":360,"name":361,"imageUrl":362,"description":363,"currentMorphology":13,"currentStage":141,"position":364,"attributes":365},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[259],[26],{"id":367,"viewCount":60,"searchKey":368,"visible":15},"10003285",{"type":10,"entryId":369,"sortOrder":370,"name":371,"imageUrl":372,"description":373,"currentMorphology":13,"currentStage":22,"position":374,"attributes":375},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[259],[26],{"id":377,"viewCount":60,"searchKey":378,"visible":15},"10003252",{"type":10,"entryId":379,"sortOrder":380,"name":76,"imageUrl":381,"description":382,"currentMorphology":13,"currentStage":141,"position":383,"attributes":385},"014",1004100,"/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[384],"position-heal",[27],{"id":387,"viewCount":60,"searchKey":388,"visible":15},"10003344",{"type":10,"entryId":389,"sortOrder":390,"name":84,"imageUrl":391,"description":392,"currentMorphology":13,"currentStage":210,"position":393,"attributes":394},"015",1004200,"/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[384],[27],{"id":396,"viewCount":60,"searchKey":397,"visible":15},"10003245",{"type":10,"entryId":8,"sortOrder":398,"name":91,"imageUrl":399,"description":400,"currentMorphology":13,"currentStage":22,"position":401,"attributes":402},1004300,"/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[384],[27,403],"attributes-ice",{"id":4,"viewCount":60,"searchKey":405,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":406,"attributes":407},[24],[26,27],{"id":6,"viewCount":60,"searchKey":409,"visible":15},{"type":10,"entryId":12,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":13,"currentStage":141,"position":414,"attributes":415},1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[323],[325],{"id":417,"viewCount":60,"searchKey":418,"visible":15},"10003140",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":13,"currentStage":22,"position":424,"attributes":425},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[323],[325],{"id":427,"viewCount":60,"searchKey":428,"visible":15},"10003236",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":13,"currentStage":22,"position":434,"attributes":435},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[323],[293],{"id":437,"viewCount":60,"searchKey":438,"visible":15},"10003196",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":13,"currentStage":141,"position":444,"attributes":445},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[291],[26],{"id":447,"viewCount":60,"searchKey":448,"visible":15},"10003189",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":13,"currentStage":22,"position":454,"attributes":455},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[24],[293,26],{"id":457,"viewCount":60,"searchKey":458,"visible":15},"10003179",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":13,"currentStage":22,"position":464,"attributes":465},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[291],[26],{"id":467,"viewCount":60,"searchKey":468,"visible":15},"10003342",{"type":10,"entryId":469,"sortOrder":470,"name":471,"imageUrl":472,"description":473,"currentMorphology":13,"currentStage":141,"position":474,"attributes":475},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[291],[476,26],"attributes-rock",{"id":478,"viewCount":60,"searchKey":479,"visible":15},"10003237",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":13,"currentStage":22,"position":485,"attributes":486},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[291],[476,26],{"id":488,"viewCount":60,"searchKey":489,"visible":15},"10003326",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":13,"currentStage":22,"position":495,"attributes":496},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[291],[403],{"id":498,"viewCount":60,"searchKey":499,"visible":15},"10003184",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":13,"currentStage":141,"position":505,"attributes":506},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[24],[261],{"id":508,"viewCount":60,"searchKey":509,"visible":15},"10003282",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":13,"currentStage":22,"position":515,"attributes":516},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[24],[261],{"id":518,"viewCount":60,"searchKey":519,"visible":15},"10003317",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":13,"currentStage":141,"position":525,"attributes":526},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[384],[325],{"id":528,"viewCount":60,"searchKey":529,"visible":15},"10003215",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":13,"currentStage":22,"position":535,"attributes":536},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[384],[325],{"id":538,"viewCount":60,"searchKey":539,"visible":15},"10003338",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":13,"currentStage":198,"position":545,"attributes":546},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[24],[325,26],{"id":548,"viewCount":60,"searchKey":549,"visible":15},"10003143",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":13,"currentStage":141,"position":555,"attributes":556},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[323],[325],{"id":558,"viewCount":60,"searchKey":559,"visible":15},"10003138",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":13,"currentStage":22,"position":565,"attributes":566},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[323],[325],{"id":568,"viewCount":60,"searchKey":569,"visible":15},"10003290",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":13,"currentStage":141,"position":575,"attributes":576},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[259],[26],{"id":578,"viewCount":60,"searchKey":579,"visible":15},"10003271",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":13,"currentStage":22,"position":585,"attributes":586},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[259],[26],{"id":588,"viewCount":60,"searchKey":589,"visible":15},"10003153",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":13,"currentStage":22,"position":595,"attributes":596},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[323],[26],{"id":598,"viewCount":60,"searchKey":599,"visible":15},"10003231",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":13,"currentStage":141,"position":605,"attributes":606},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[291],[26],{"id":608,"viewCount":60,"searchKey":609,"visible":15},"10003149",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":13,"currentStage":22,"position":615,"attributes":616},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[323],[617],"attributes-electric",{"id":619,"viewCount":60,"searchKey":620,"visible":15},"10003218",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":13,"currentStage":22,"position":626,"attributes":627},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[291],[26],{"id":629,"viewCount":60,"searchKey":630,"visible":15},"10003278",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":13,"currentStage":141,"position":636,"attributes":637},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[323],[293],{"id":639,"viewCount":60,"searchKey":640,"visible":15},"10003296",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":13,"currentStage":22,"position":646,"attributes":647},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[323],[293],{"id":649,"viewCount":60,"searchKey":650,"visible":15},"10003283",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":13,"currentStage":141,"position":656,"attributes":657},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[259],[293],{"id":659,"viewCount":60,"searchKey":660,"visible":15},"10003144",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":13,"currentStage":22,"position":666,"attributes":667},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[259],[293],{"id":669,"viewCount":60,"searchKey":670,"visible":15},"10003276",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":13,"currentStage":22,"position":676,"attributes":677},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[259],[617],{"id":679,"viewCount":60,"searchKey":680,"visible":15},"10003197",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":13,"currentStage":141,"position":686,"attributes":687},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[259],[403],{"id":689,"viewCount":60,"searchKey":690,"visible":15},"10003350",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":13,"currentStage":210,"position":696,"attributes":697},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[259],[403],{"id":699,"viewCount":60,"searchKey":700,"visible":15},"10003190",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":13,"currentStage":22,"position":706,"attributes":707},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[259],[403],{"id":709,"viewCount":60,"searchKey":710,"visible":15},"10003299",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":13,"currentStage":141,"position":716,"attributes":717},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[291],[617],{"id":719,"viewCount":60,"searchKey":720,"visible":15},"10003250",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":13,"currentStage":22,"position":726,"attributes":727},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[291],[617],{"id":729,"viewCount":60,"searchKey":730,"visible":15},"10003298",{"type":10,"entryId":731,"sortOrder":732,"name":733,"imageUrl":734,"description":735,"currentMorphology":13,"currentStage":141,"position":736,"attributes":737},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[291],[27],{"id":739,"viewCount":60,"searchKey":740,"visible":15},"10003173",{"type":10,"entryId":741,"sortOrder":742,"name":743,"imageUrl":744,"description":745,"currentMorphology":13,"currentStage":210,"position":746,"attributes":747},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[291],[27],{"id":749,"viewCount":60,"searchKey":750,"visible":15},"10003291",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":13,"currentStage":22,"position":756,"attributes":757},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[323],[27],{"id":759,"viewCount":60,"searchKey":760,"visible":15},"10003341",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":13,"currentStage":22,"position":766,"attributes":767},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[291],[27],{"id":769,"viewCount":60,"searchKey":770,"visible":15},"10003228",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":13,"currentStage":141,"position":776,"attributes":777},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[259],[27],{"id":779,"viewCount":60,"searchKey":780,"visible":15},"10003352",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":13,"currentStage":210,"position":786,"attributes":787},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[259],[27],{"id":789,"viewCount":60,"searchKey":790,"visible":15},"10003345",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":13,"currentStage":22,"position":796,"attributes":797},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[259],[27],{"id":799,"viewCount":60,"searchKey":800,"visible":15},"10003340",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":13,"currentStage":141,"position":806,"attributes":807},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[259],[476],{"id":809,"viewCount":60,"searchKey":810,"visible":15},"10003251",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":13,"currentStage":22,"position":816,"attributes":817},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[259],[476],{"id":819,"viewCount":60,"searchKey":820,"visible":15},"10003241",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":13,"currentStage":22,"position":826,"attributes":827},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[323],[476],{"id":829,"viewCount":60,"searchKey":830,"visible":15},"10003154",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":13,"currentStage":141,"position":836,"attributes":837},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[259],[617],{"id":839,"viewCount":60,"searchKey":840,"visible":15},"10003151",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":13,"currentStage":22,"position":846,"attributes":847},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[259],[617],{"id":849,"viewCount":60,"searchKey":850,"visible":15},"10003318",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":13,"currentStage":141,"position":856,"attributes":857},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[291],[293],{"id":859,"viewCount":60,"searchKey":860,"visible":15},"10003332",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":13,"currentStage":22,"position":866,"attributes":867},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[259],[293],{"id":869,"viewCount":60,"searchKey":870,"visible":15},"10003297",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":13,"currentStage":22,"position":876,"attributes":877},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[291],[293],{"id":879,"viewCount":60,"searchKey":880,"visible":15},"10003354",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":13,"currentStage":141,"position":886,"attributes":887},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[291],[325],{"id":889,"viewCount":60,"searchKey":890,"visible":15},"10003164",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":13,"currentStage":210,"position":896,"attributes":897},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[291],[325],{"id":899,"viewCount":60,"searchKey":900,"visible":15},"10003311",{"type":10,"entryId":901,"sortOrder":902,"name":903,"imageUrl":904,"description":905,"currentMorphology":13,"currentStage":22,"position":906,"attributes":907},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[291],[325],{"id":909,"viewCount":60,"searchKey":910,"visible":15},"10003304",{"type":10,"entryId":911,"sortOrder":912,"name":913,"imageUrl":914,"description":915,"currentMorphology":13,"currentStage":22,"position":916,"attributes":917},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[259],[261],{"id":919,"viewCount":60,"searchKey":920,"visible":15},"10003208",{"type":10,"entryId":921,"sortOrder":922,"name":923,"imageUrl":924,"description":925,"currentMorphology":13,"currentStage":141,"position":926,"attributes":927},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[259],[476],{"id":929,"viewCount":60,"searchKey":930,"visible":15},"10003202",{"type":10,"entryId":931,"sortOrder":932,"name":933,"imageUrl":934,"description":935,"currentMorphology":13,"currentStage":22,"position":936,"attributes":937},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[259],[476],{"id":939,"viewCount":60,"searchKey":940,"visible":15},"10003180",{"type":10,"entryId":941,"sortOrder":942,"name":943,"imageUrl":944,"description":945,"currentMorphology":13,"currentStage":141,"position":946,"attributes":947},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[291],[476],{"id":949,"viewCount":60,"searchKey":950,"visible":15},"10003300",{"type":10,"entryId":951,"sortOrder":952,"name":953,"imageUrl":954,"description":955,"currentMorphology":13,"currentStage":210,"position":956,"attributes":957},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[291],[261,476],{"id":959,"viewCount":60,"searchKey":960,"visible":15},"10003174",{"type":10,"entryId":961,"sortOrder":962,"name":963,"imageUrl":964,"description":965,"currentMorphology":13,"currentStage":22,"position":966,"attributes":967},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[291],[261,476],{"id":969,"viewCount":60,"searchKey":970,"visible":15},"10003293",{"type":10,"entryId":971,"sortOrder":972,"name":973,"imageUrl":974,"description":975,"currentMorphology":13,"currentStage":210,"position":976,"attributes":977},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[291],[476],{"id":979,"viewCount":60,"searchKey":980,"visible":15},"10003168",{"type":10,"entryId":981,"sortOrder":982,"name":983,"imageUrl":984,"description":985,"currentMorphology":13,"currentStage":22,"position":986,"attributes":987},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[291],[476],{"id":989,"viewCount":60,"searchKey":990,"visible":15},"10003161",{"type":10,"entryId":991,"sortOrder":992,"name":993,"imageUrl":994,"description":995,"currentMorphology":13,"currentStage":141,"position":996,"attributes":997},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[323],[476],{"id":999,"viewCount":60,"searchKey":1000,"visible":15},"10003222",{"type":10,"entryId":1001,"sortOrder":1002,"name":1003,"imageUrl":1004,"description":1005,"currentMorphology":13,"currentStage":22,"position":1006,"attributes":1007},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[323],[476],{"id":1009,"viewCount":60,"searchKey":1010,"visible":15},"10003272",{"type":10,"entryId":1011,"sortOrder":1012,"name":1013,"imageUrl":1014,"description":1015,"currentMorphology":13,"currentStage":141,"position":1016,"attributes":1017},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[323],[617],{"id":1019,"viewCount":60,"searchKey":1020,"visible":15},"10003254",{"type":10,"entryId":1021,"sortOrder":1022,"name":1023,"imageUrl":1024,"description":1025,"currentMorphology":13,"currentStage":210,"position":1026,"attributes":1027},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[323],[617],{"id":1029,"viewCount":60,"searchKey":1030,"visible":15},"10003163",{"type":10,"entryId":1031,"sortOrder":1032,"name":1033,"imageUrl":1034,"description":1035,"currentMorphology":13,"currentStage":22,"position":1036,"attributes":1037},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[323],[617],{"id":1039,"viewCount":60,"searchKey":1040,"visible":15},"10003204",{"type":10,"entryId":1041,"sortOrder":1042,"name":1043,"imageUrl":1044,"description":1045,"currentMorphology":13,"currentStage":141,"position":1046,"attributes":1047},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[24],[27],{"id":1049,"viewCount":60,"searchKey":1050,"visible":15},"10003205",{"type":10,"entryId":1051,"sortOrder":1052,"name":1053,"imageUrl":1054,"description":1055,"currentMorphology":13,"currentStage":22,"position":1056,"attributes":1057},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[24],[27],{"id":1059,"viewCount":60,"searchKey":1060,"visible":15},"10003324",{"type":10,"entryId":1061,"sortOrder":1062,"name":1063,"imageUrl":1064,"description":1065,"currentMorphology":13,"currentStage":198,"position":1066,"attributes":1067},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[24],[617],{"id":1069,"viewCount":60,"searchKey":1070,"visible":15},"10003269",{"type":10,"entryId":1071,"sortOrder":1072,"name":1073,"imageUrl":1074,"description":1075,"currentMorphology":13,"currentStage":141,"position":1076,"attributes":1077},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[24],[476,27],{"id":1079,"viewCount":60,"searchKey":1080,"visible":15},"10003261",{"type":10,"entryId":1081,"sortOrder":1082,"name":1083,"imageUrl":1084,"description":1085,"currentMorphology":13,"currentStage":22,"position":1086,"attributes":1087},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[24],[476,27],{"id":1089,"viewCount":60,"searchKey":1090,"visible":15},"10003305",{"type":10,"entryId":1091,"sortOrder":1092,"name":1093,"imageUrl":1094,"description":1095,"currentMorphology":13,"currentStage":141,"position":1096,"attributes":1097},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[291],[403],{"id":1099,"viewCount":60,"searchKey":1100,"visible":15},"10003232",{"type":10,"entryId":1101,"sortOrder":1102,"name":1103,"imageUrl":1104,"description":1105,"currentMorphology":13,"currentStage":22,"position":1106,"attributes":1107},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[291],[403],{"id":1109,"viewCount":60,"searchKey":1110,"visible":15},"10003198",{"type":10,"entryId":1111,"sortOrder":1112,"name":1113,"imageUrl":1114,"description":1115,"currentMorphology":13,"currentStage":141,"position":1116,"attributes":1117},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[384],[26,27],{"id":1119,"viewCount":60,"searchKey":1120,"visible":15},"10003194",{"type":10,"entryId":1121,"sortOrder":1122,"name":1123,"imageUrl":1124,"description":1125,"currentMorphology":13,"currentStage":22,"position":1126,"attributes":1127},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[384],[26,27],{"id":1129,"viewCount":60,"searchKey":1130,"visible":15},"10003185",{"type":10,"entryId":1131,"sortOrder":1132,"name":1133,"imageUrl":1134,"description":1135,"currentMorphology":13,"currentStage":141,"position":1136,"attributes":1137},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[259],[27],{"id":1139,"viewCount":60,"searchKey":1140,"visible":15},"10003284",{"type":10,"entryId":1141,"sortOrder":1142,"name":1143,"imageUrl":1144,"description":1145,"currentMorphology":13,"currentStage":22,"position":1146,"attributes":1147},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[259],[27],{"id":1149,"viewCount":60,"searchKey":1150,"visible":15},"10003188",{"type":10,"entryId":1151,"sortOrder":1152,"name":1153,"imageUrl":1154,"description":1155,"currentMorphology":13,"currentStage":141,"position":1156,"attributes":1157},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[259],[403],{"id":1159,"viewCount":60,"searchKey":1160,"visible":15},"10003182",{"type":10,"entryId":1161,"sortOrder":1162,"name":1163,"imageUrl":1164,"description":1165,"currentMorphology":13,"currentStage":22,"position":1166,"attributes":1167},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[259],[403],{"id":1169,"viewCount":60,"searchKey":1170,"visible":15},"10003273",{"type":10,"entryId":1171,"sortOrder":1172,"name":1173,"imageUrl":1174,"description":1175,"currentMorphology":13,"currentStage":198,"position":1176,"attributes":1177},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[259],[1178],"attributes-holy",{"id":1180,"viewCount":60,"searchKey":1181,"visible":15},"10003150",{"type":10,"entryId":1182,"sortOrder":1183,"name":1184,"imageUrl":1185,"description":1186,"currentMorphology":13,"currentStage":198,"position":1187,"attributes":1188},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[259],[1178],[1190,1198,1203,1206,1211,1216,1221,1226,1231,1236,1241,1244,1249,1253,1258,1263,1268,1273,1278],{"id":1191,"parentId":1192,"tagType":1193,"tagKey":1194,"name":1195,"language":1196,"sort":1197},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1199,"parentId":1192,"tagType":1193,"tagKey":1200,"name":1201,"language":1196,"sort":1202},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1204,"parentId":1192,"tagType":1193,"tagKey":13,"name":1205,"language":1196,"sort":30},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1207,"parentId":1192,"tagType":1193,"tagKey":1208,"name":1209,"language":1196,"sort":1210},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1212,"parentId":1192,"tagType":1193,"tagKey":1213,"name":1214,"language":1196,"sort":1215},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1217,"parentId":1192,"tagType":1193,"tagKey":1218,"name":1219,"language":1196,"sort":1220},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1222,"parentId":1192,"tagType":1193,"tagKey":1223,"name":1224,"language":1196,"sort":1225},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1227,"parentId":1192,"tagType":1193,"tagKey":1228,"name":1229,"language":1196,"sort":1230},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1232,"parentId":1192,"tagType":1193,"tagKey":1233,"name":1234,"language":1196,"sort":1235},"3c233890d20868e097e9cea7821aad8e","Umbrabow Form","옵시디언 형태",4,{"id":1237,"parentId":1192,"tagType":1193,"tagKey":1238,"name":1239,"language":1196,"sort":1240},"532c88e1ad2265245d2a450fe9e5629f","Highland Form","고지 형태",9,{"id":1242,"parentId":1192,"tagType":1193,"tagKey":9,"name":1243,"language":1196,"sort":59},"537f01b8a206e25a37d2ceb6c5325754","천휘 형태",{"id":1245,"parentId":1192,"tagType":1193,"tagKey":1246,"name":1247,"language":1196,"sort":1248},"6348a343642770f35403dea19746668c","Sea of Flowers Form","꽃바다 형태",10,{"id":1250,"parentId":1192,"tagType":1193,"tagKey":1251,"name":1252,"language":1196,"sort":39},"7ea85e648dc7b02bb3fb4a7758faf69b","Rainstorm Form","우천 형태",{"id":1254,"parentId":1192,"tagType":1193,"tagKey":1255,"name":1256,"language":1196,"sort":1257},"8c5ed9c90ca3d54060ed14e67377089f","Nighttime Form","밤 형태",12,{"id":1259,"parentId":1192,"tagType":1193,"tagKey":1260,"name":1261,"language":1196,"sort":1262},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1264,"parentId":1192,"tagType":1193,"tagKey":1265,"name":1266,"language":1196,"sort":1267},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1269,"parentId":1192,"tagType":1193,"tagKey":1270,"name":1271,"language":1196,"sort":1272},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1274,"parentId":1192,"tagType":1193,"tagKey":1275,"name":1276,"language":1196,"sort":1277},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1279,"parentId":1192,"tagType":1193,"tagKey":1280,"name":1281,"language":1196,"sort":1282},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]