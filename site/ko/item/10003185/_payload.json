[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"aniimo-detail-10003185-ko":3,"header-aniimo-list-ko":203,"morphology-tags-ko":1147},{"id":4,"previousId":5,"nextId":6,"previousAnchor":7,"nextAnchor":11,"viewCount":14,"visible":15,"searchKey":16,"directories":27,"morphologyList":201},"10003185","10003187","10003284",{"entryId":8,"currentMorphology":9,"type":10},"089","Prismana Form","ANIIMO",{"entryId":12,"currentMorphology":13,"type":10},"091","Basic Form",356,true,{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":23,"attributes":25},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.","1",[24],"position-dps",[26],"attributes-water",[28,116],{"id":29,"title":30,"components":31},1,"기본 정보",[32,58,87,103],{"id":33,"type":34,"props":35,"children":57},"91268212_0","aniimoInfo",{"id":36,"formData":37},"91268212_1",{"name":19,"sortOrder":29,"serialNumber":17,"heightMin":29,"heightMax":29,"weightMin":38,"weightMax":39,"attributes":40,"position":41,"gender":42,"desc":21,"maleImage":20,"femaleImage":20,"noGenderImage":20,"illustrationImage":45,"backgroundImage":46,"attributeValue":47,"hp":48,"magicAttack":49,"physicalAttack":50,"magicDefense":51,"haste":48,"physicalDefense":52,"displayNames":53,"currentMorphology":13,"currentStage":29,"femaleIllustrationImage":46,"maleIllustrationImage":46},23.4,34.93,[26],[24],[43,44],"male","female","/cdn/Vfx/1062100.mp4","",450,90,45,102,65,58,{"maleImage":54,"femaleImage":55,"illustrationImage":56,"backgroundImage":46,"noGenderImage":46},"Stellarys.png","Scorchhowl.png","evolutionarySpirit.png",null,{"id":59,"type":60,"props":61,"children":66},"91268212_2","crumbTitle",{"title":62,"type":63,"id":64,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"진화 루트","big","91268212_3",false,[67],{"id":68,"type":69,"props":70,"children":57},"91268212_4","evolution",{"data":71,"id":86},{"id":72,"name":19,"label":19,"icon":73,"stage":29,"position":74,"stageStrength":29,"condition":75,"children":77},"root","/cdn/init/Wiki_PetHead_10621.png",0,{"isVariant":65,"list":76},[],[78],{"id":79,"name":80,"label":80,"icon":81,"stage":82,"position":29,"stageStrength":82,"condition":83,"children":85},"91268212_6","가챠코","/cdn/init/Wiki_PetHead_10623.png",3,{"isVariant":65,"list":84},[],[],"91268212_5",{"id":88,"type":60,"props":89,"children":93},"91268212_7",{"title":90,"type":91,"id":92,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"출현 지역","small","91268212_8",[94],{"id":95,"type":96,"props":97,"children":57},"91268212_9","capsule",{"id":98,"customKey":46,"title":99,"icon":46,"bgColor":100,"fontColor":101,"type":102},"91268212_10","초승달 만","#dee2ec","#60606e","normal",{"id":104,"type":60,"props":105,"children":108},"91268212_11",{"title":106,"type":91,"id":107,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"홈 능력","91268212_12",[109],{"id":110,"type":96,"props":111,"children":57},"91268212_13",{"id":112,"customKey":113,"title":114,"icon":46,"bgColor":46,"fontColor":46,"type":115},"91268212_14","home-1002","3","spritePic",{"id":117,"title":118,"components":119},2,"애니모 능력",[120,136,152],{"id":121,"type":60,"props":122,"children":125},"91268212_15",{"title":123,"type":91,"id":124,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"Pathfinding","91268212_16",[126],{"id":127,"type":128,"props":129,"children":57},"91268212_17","circle",{"id":130,"customKey":131,"icon":46,"iconStyle":46,"iconTitle":132,"descTitle":46,"descContent":46,"source":133,"bgColor":100,"fontColor":101,"type":102},"91268212_18","SWIM","수영 Lv.1",{"attributes":134,"type":135,"consume":46,"power":46},[],[],{"id":137,"type":60,"props":138,"children":141},"91268212_21",{"title":139,"type":63,"id":140,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"애니모 특성","91268212_22",[142],{"id":143,"type":128,"props":144,"children":57},"91268212_23",{"id":145,"customKey":46,"icon":146,"iconStyle":63,"iconTitle":46,"descTitle":147,"descContent":148,"source":149},"91268212_24","/cdn/init/1062100_Feature_162301_Icon.png","캡슐 뽑기","일반 공격과 스킬을 사용할 때마다 뽑기를 한 번 진행하며, 주황, 보라, 파랑, 금색 네 가지 색의 버블이 랜덤으로 나와 뽑기 슬롯에 저장됩니다. 금색 버블이 나올 확률은 1%, 나머지 색상은 33%입니다. 뽑기 슬롯에 같은 색 버블이 5개가 있거나 금색 버블이 나오면 슬롯이 초기화되고 [당첨] 상태가 되며 10초 동안 지속됩니다. [당첨] 상태에서는 반드시 무지개 버블을 발사하고, 일반 공격 피해가 60% 증가합니다.",{"attributes":150,"type":151,"consume":46,"power":46},[],[],{"id":153,"type":60,"props":154,"children":57},"91268212_25",{"title":155,"type":63,"id":156,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":65,"tabs":157},"스킬 소개","91268212_26",[158,186],{"id":159,"title":160,"children":161},"91268212_27","전투 스킬",[162,174],{"id":163,"type":128,"props":164},"91268212_28",{"id":165,"customKey":46,"icon":166,"iconStyle":63,"iconTitle":46,"descTitle":167,"descContent":168,"source":169},"91268212_29","/cdn/init/1062100_Skill_10301180_Icon.png","밀실 조작","현재 색상 중 가장 적은 버블을 소모하며, 다음 일반 공격은 반드시 현재 수량이 가장 많은 색상의 버블을 발사합니다. 일반 공격 피해가 25% 증가하며 15초 동안 지속됩니다.",{"attributes":170,"type":171,"consume":173,"power":172},[114],[172],"0","10",{"id":175,"type":128,"props":176},"91268212_30",{"id":177,"customKey":46,"icon":178,"iconStyle":63,"iconTitle":46,"descTitle":179,"descContent":180,"source":181},"91268212_31","/cdn/init/1062100_Skill_10301190_Icon.png","창고 대방출 세일","대상에게 버블을 지속적으로 뿜어내며, 5초 동안 지속됩니다. 사용 중 이동할 수 있지만 이동 속도가 감소하며, 주는 피해는 일반 공격 피해로 간주됩니다.",{"attributes":182,"type":183,"consume":184,"power":185},[114],[22],"40","124",{"id":187,"title":188,"children":189},"91268212_32","고유 스킬",[190],{"id":191,"type":128,"props":192},"91268212_33",{"id":193,"customKey":46,"icon":194,"iconStyle":63,"iconTitle":46,"descTitle":195,"descContent":196,"source":197},"91268212_34","/cdn/init/1062100_Skill_11600000_Icon.png","공격","물 원소 능력을 사용하여 원거리에서 목표를 공격합니다.",{"attributes":198,"type":199,"consume":172,"power":200},[114],[22],"6",[202],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[204,215,226,236,248,258,268,280,290,300,310,321,331,342,352,363,374,384,394,404,414,424,434,445,455,465,475,485,495,505,515,525,535,545,555,565,575,586,596,606,616,626,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,846,856,866,876,886,896,906,916,926,936,946,956,966,976,986,996,1006,1016,1026,1036,1046,1056,1066,1076,1086,1095,1099,1106,1116,1126,1137],{"id":205,"viewCount":57,"searchKey":206,"visible":15},"10003217",{"type":10,"entryId":207,"sortOrder":208,"name":209,"imageUrl":210,"description":211,"currentMorphology":13,"currentStage":22,"position":212,"attributes":213},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[24],[214],"attributes-fire",{"id":216,"viewCount":57,"searchKey":217,"visible":15},"10003309",{"type":10,"entryId":218,"sortOrder":219,"name":220,"imageUrl":221,"description":222,"currentMorphology":13,"currentStage":223,"position":224,"attributes":225},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[24],[214],{"id":227,"viewCount":57,"searchKey":228,"visible":15},"10003210",{"type":10,"entryId":229,"sortOrder":230,"name":231,"imageUrl":232,"description":233,"currentMorphology":13,"currentStage":114,"position":234,"attributes":235},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[24],[214],{"id":237,"viewCount":57,"searchKey":238,"visible":15},"10003203",{"type":10,"entryId":239,"sortOrder":240,"name":241,"imageUrl":242,"description":243,"currentMorphology":13,"currentStage":114,"position":244,"attributes":246},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[245],"position-break",[214,247],"attributes-dark",{"id":249,"viewCount":57,"searchKey":250,"visible":15},"10003353",{"type":10,"entryId":251,"sortOrder":252,"name":253,"imageUrl":254,"description":255,"currentMorphology":13,"currentStage":22,"position":256,"attributes":257},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[24],[247],{"id":259,"viewCount":57,"searchKey":260,"visible":15},"10003192",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":13,"currentStage":114,"position":266,"attributes":267},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[24],[247],{"id":269,"viewCount":57,"searchKey":270,"visible":15},"10003263",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":13,"currentStage":22,"position":276,"attributes":278},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[277],"position-sup",[279],"attributes-wind",{"id":281,"viewCount":57,"searchKey":282,"visible":15},"10003323",{"type":10,"entryId":283,"sortOrder":284,"name":285,"imageUrl":286,"description":287,"currentMorphology":13,"currentStage":114,"position":288,"attributes":289},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[277],[279],{"id":291,"viewCount":57,"searchKey":292,"visible":15},"10003249",{"type":10,"entryId":293,"sortOrder":294,"name":295,"imageUrl":296,"description":297,"currentMorphology":13,"currentStage":114,"position":298,"attributes":299},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[24],[279],{"id":301,"viewCount":57,"searchKey":302,"visible":15},"10003242",{"type":10,"entryId":303,"sortOrder":304,"name":305,"imageUrl":306,"description":307,"currentMorphology":13,"currentStage":114,"position":308,"attributes":309},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[245],[279],{"id":311,"viewCount":57,"searchKey":312,"visible":15},"10003167",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":13,"currentStage":22,"position":318,"attributes":319},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[24],[320],"attributes-grass",{"id":322,"viewCount":57,"searchKey":323,"visible":15},"10003285",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":13,"currentStage":114,"position":329,"attributes":330},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[24],[320],{"id":332,"viewCount":57,"searchKey":333,"visible":15},"10003252",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":13,"currentStage":22,"position":339,"attributes":341},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[340],"position-heal",[26],{"id":343,"viewCount":57,"searchKey":344,"visible":15},"10003344",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":13,"currentStage":223,"position":350,"attributes":351},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[340],[26],{"id":353,"viewCount":57,"searchKey":354,"visible":15},"10003245",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":13,"currentStage":114,"position":360,"attributes":361},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[340],[26,362],"attributes-ice",{"id":364,"viewCount":57,"searchKey":365,"visible":15},"10003238",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":13,"currentStage":114,"position":371,"attributes":373},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[372],"position-energy",[320,26],{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10003243",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":13,"currentStage":22,"position":382,"attributes":383},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[277],[279],{"id":385,"viewCount":57,"searchKey":386,"visible":15},"10003140",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":13,"currentStage":114,"position":392,"attributes":393},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[277],[279],{"id":395,"viewCount":57,"searchKey":396,"visible":15},"10003236",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":13,"currentStage":114,"position":402,"attributes":403},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[277],[247],{"id":405,"viewCount":57,"searchKey":406,"visible":15},"10003196",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":13,"currentStage":22,"position":412,"attributes":413},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[245],[320],{"id":415,"viewCount":57,"searchKey":416,"visible":15},"10003189",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":13,"currentStage":114,"position":422,"attributes":423},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[372],[247,320],{"id":425,"viewCount":57,"searchKey":426,"visible":15},"10003179",{"type":10,"entryId":427,"sortOrder":428,"name":429,"imageUrl":430,"description":431,"currentMorphology":13,"currentStage":114,"position":432,"attributes":433},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[245],[320],{"id":435,"viewCount":57,"searchKey":436,"visible":15},"10003342",{"type":10,"entryId":437,"sortOrder":438,"name":439,"imageUrl":440,"description":441,"currentMorphology":13,"currentStage":22,"position":442,"attributes":443},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[245],[444,320],"attributes-rock",{"id":446,"viewCount":57,"searchKey":447,"visible":15},"10003237",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":13,"currentStage":114,"position":453,"attributes":454},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[245],[444,320],{"id":456,"viewCount":57,"searchKey":457,"visible":15},"10003326",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":13,"currentStage":114,"position":463,"attributes":464},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[245],[362],{"id":466,"viewCount":57,"searchKey":467,"visible":15},"10003184",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":13,"currentStage":22,"position":473,"attributes":474},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[372],[214],{"id":476,"viewCount":57,"searchKey":477,"visible":15},"10003282",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":13,"currentStage":114,"position":483,"attributes":484},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[372],[214],{"id":486,"viewCount":57,"searchKey":487,"visible":15},"10003317",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":13,"currentStage":22,"position":493,"attributes":494},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[340],[279],{"id":496,"viewCount":57,"searchKey":497,"visible":15},"10003215",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":13,"currentStage":114,"position":503,"attributes":504},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[340],[279],{"id":506,"viewCount":57,"searchKey":507,"visible":15},"10003338",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":13,"currentStage":172,"position":513,"attributes":514},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[372],[279,320],{"id":516,"viewCount":57,"searchKey":517,"visible":15},"10003143",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":13,"currentStage":22,"position":523,"attributes":524},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[277],[279],{"id":526,"viewCount":57,"searchKey":527,"visible":15},"10003138",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":13,"currentStage":114,"position":533,"attributes":534},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[277],[279],{"id":536,"viewCount":57,"searchKey":537,"visible":15},"10003290",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":13,"currentStage":22,"position":543,"attributes":544},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[24],[320],{"id":546,"viewCount":57,"searchKey":547,"visible":15},"10003271",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":13,"currentStage":114,"position":553,"attributes":554},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[24],[320],{"id":556,"viewCount":57,"searchKey":557,"visible":15},"10003153",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":13,"currentStage":114,"position":563,"attributes":564},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[277],[320],{"id":566,"viewCount":57,"searchKey":567,"visible":15},"10003231",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":13,"currentStage":22,"position":573,"attributes":574},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[245],[320],{"id":576,"viewCount":57,"searchKey":577,"visible":15},"10003149",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":13,"currentStage":114,"position":583,"attributes":584},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[277],[585],"attributes-electric",{"id":587,"viewCount":57,"searchKey":588,"visible":15},"10003218",{"type":10,"entryId":589,"sortOrder":590,"name":591,"imageUrl":592,"description":593,"currentMorphology":13,"currentStage":114,"position":594,"attributes":595},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[245],[320],{"id":597,"viewCount":57,"searchKey":598,"visible":15},"10003278",{"type":10,"entryId":599,"sortOrder":600,"name":601,"imageUrl":602,"description":603,"currentMorphology":13,"currentStage":22,"position":604,"attributes":605},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[277],[247],{"id":607,"viewCount":57,"searchKey":608,"visible":15},"10003296",{"type":10,"entryId":609,"sortOrder":610,"name":611,"imageUrl":612,"description":613,"currentMorphology":13,"currentStage":114,"position":614,"attributes":615},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[277],[247],{"id":617,"viewCount":57,"searchKey":618,"visible":15},"10003283",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":13,"currentStage":22,"position":624,"attributes":625},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[24],[247],{"id":627,"viewCount":57,"searchKey":628,"visible":15},"10003144",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":13,"currentStage":114,"position":634,"attributes":635},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[24],[247],{"id":637,"viewCount":57,"searchKey":638,"visible":15},"10003276",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":13,"currentStage":114,"position":644,"attributes":645},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[24],[585],{"id":647,"viewCount":57,"searchKey":648,"visible":15},"10003197",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":13,"currentStage":22,"position":654,"attributes":655},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[24],[362],{"id":657,"viewCount":57,"searchKey":658,"visible":15},"10003350",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":13,"currentStage":223,"position":664,"attributes":665},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[24],[362],{"id":667,"viewCount":57,"searchKey":668,"visible":15},"10003190",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":13,"currentStage":114,"position":674,"attributes":675},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[24],[362],{"id":677,"viewCount":57,"searchKey":678,"visible":15},"10003299",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":13,"currentStage":22,"position":684,"attributes":685},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[245],[585],{"id":687,"viewCount":57,"searchKey":688,"visible":15},"10003250",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":13,"currentStage":114,"position":694,"attributes":695},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[245],[585],{"id":697,"viewCount":57,"searchKey":698,"visible":15},"10003298",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":13,"currentStage":22,"position":704,"attributes":705},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[245],[26],{"id":707,"viewCount":57,"searchKey":708,"visible":15},"10003173",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":13,"currentStage":223,"position":714,"attributes":715},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[245],[26],{"id":717,"viewCount":57,"searchKey":718,"visible":15},"10003291",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":13,"currentStage":114,"position":724,"attributes":725},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[277],[26],{"id":727,"viewCount":57,"searchKey":728,"visible":15},"10003341",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":13,"currentStage":114,"position":734,"attributes":735},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[245],[26],{"id":737,"viewCount":57,"searchKey":738,"visible":15},"10003228",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":13,"currentStage":22,"position":744,"attributes":745},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[24],[26],{"id":747,"viewCount":57,"searchKey":748,"visible":15},"10003352",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":13,"currentStage":223,"position":754,"attributes":755},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[24],[26],{"id":757,"viewCount":57,"searchKey":758,"visible":15},"10003345",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":13,"currentStage":114,"position":764,"attributes":765},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[24],[26],{"id":767,"viewCount":57,"searchKey":768,"visible":15},"10003340",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":13,"currentStage":22,"position":774,"attributes":775},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[24],[444],{"id":777,"viewCount":57,"searchKey":778,"visible":15},"10003251",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":13,"currentStage":114,"position":784,"attributes":785},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[24],[444],{"id":787,"viewCount":57,"searchKey":788,"visible":15},"10003241",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":13,"currentStage":114,"position":794,"attributes":795},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[277],[444],{"id":797,"viewCount":57,"searchKey":798,"visible":15},"10003154",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":13,"currentStage":22,"position":804,"attributes":805},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[24],[585],{"id":807,"viewCount":57,"searchKey":808,"visible":15},"10003151",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":13,"currentStage":114,"position":814,"attributes":815},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[24],[585],{"id":817,"viewCount":57,"searchKey":818,"visible":15},"10003318",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":13,"currentStage":22,"position":824,"attributes":825},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[245],[247],{"id":827,"viewCount":57,"searchKey":828,"visible":15},"10003332",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":13,"currentStage":114,"position":834,"attributes":835},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[24],[247],{"id":837,"viewCount":57,"searchKey":838,"visible":15},"10003297",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":13,"currentStage":114,"position":844,"attributes":845},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[245],[247],{"id":847,"viewCount":57,"searchKey":848,"visible":15},"10003354",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":13,"currentStage":22,"position":854,"attributes":855},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[245],[279],{"id":857,"viewCount":57,"searchKey":858,"visible":15},"10003164",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":13,"currentStage":223,"position":864,"attributes":865},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[245],[279],{"id":867,"viewCount":57,"searchKey":868,"visible":15},"10003311",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":13,"currentStage":114,"position":874,"attributes":875},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[245],[279],{"id":877,"viewCount":57,"searchKey":878,"visible":15},"10003304",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":13,"currentStage":114,"position":884,"attributes":885},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[24],[214],{"id":887,"viewCount":57,"searchKey":888,"visible":15},"10003208",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":13,"currentStage":22,"position":894,"attributes":895},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[24],[444],{"id":897,"viewCount":57,"searchKey":898,"visible":15},"10003202",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":13,"currentStage":114,"position":904,"attributes":905},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[24],[444],{"id":907,"viewCount":57,"searchKey":908,"visible":15},"10003180",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":13,"currentStage":22,"position":914,"attributes":915},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[245],[444],{"id":917,"viewCount":57,"searchKey":918,"visible":15},"10003300",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":13,"currentStage":223,"position":924,"attributes":925},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[245],[214,444],{"id":927,"viewCount":57,"searchKey":928,"visible":15},"10003174",{"type":10,"entryId":929,"sortOrder":930,"name":931,"imageUrl":932,"description":933,"currentMorphology":13,"currentStage":114,"position":934,"attributes":935},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[245],[214,444],{"id":937,"viewCount":57,"searchKey":938,"visible":15},"10003293",{"type":10,"entryId":939,"sortOrder":940,"name":941,"imageUrl":942,"description":943,"currentMorphology":13,"currentStage":223,"position":944,"attributes":945},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[245],[444],{"id":947,"viewCount":57,"searchKey":948,"visible":15},"10003168",{"type":10,"entryId":949,"sortOrder":950,"name":951,"imageUrl":952,"description":953,"currentMorphology":13,"currentStage":114,"position":954,"attributes":955},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[245],[444],{"id":957,"viewCount":57,"searchKey":958,"visible":15},"10003161",{"type":10,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":13,"currentStage":22,"position":964,"attributes":965},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[277],[444],{"id":967,"viewCount":57,"searchKey":968,"visible":15},"10003222",{"type":10,"entryId":969,"sortOrder":970,"name":971,"imageUrl":972,"description":973,"currentMorphology":13,"currentStage":114,"position":974,"attributes":975},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[277],[444],{"id":977,"viewCount":57,"searchKey":978,"visible":15},"10003272",{"type":10,"entryId":979,"sortOrder":980,"name":981,"imageUrl":982,"description":983,"currentMorphology":13,"currentStage":22,"position":984,"attributes":985},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[277],[585],{"id":987,"viewCount":57,"searchKey":988,"visible":15},"10003254",{"type":10,"entryId":989,"sortOrder":990,"name":991,"imageUrl":992,"description":993,"currentMorphology":13,"currentStage":223,"position":994,"attributes":995},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[277],[585],{"id":997,"viewCount":57,"searchKey":998,"visible":15},"10003163",{"type":10,"entryId":999,"sortOrder":1000,"name":1001,"imageUrl":1002,"description":1003,"currentMorphology":13,"currentStage":114,"position":1004,"attributes":1005},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[277],[585],{"id":1007,"viewCount":57,"searchKey":1008,"visible":15},"10003204",{"type":10,"entryId":1009,"sortOrder":1010,"name":1011,"imageUrl":1012,"description":1013,"currentMorphology":13,"currentStage":22,"position":1014,"attributes":1015},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[372],[26],{"id":1017,"viewCount":57,"searchKey":1018,"visible":15},"10003205",{"type":10,"entryId":1019,"sortOrder":1020,"name":1021,"imageUrl":1022,"description":1023,"currentMorphology":13,"currentStage":114,"position":1024,"attributes":1025},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[372],[26],{"id":1027,"viewCount":57,"searchKey":1028,"visible":15},"10003324",{"type":10,"entryId":1029,"sortOrder":1030,"name":1031,"imageUrl":1032,"description":1033,"currentMorphology":13,"currentStage":172,"position":1034,"attributes":1035},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[372],[585],{"id":1037,"viewCount":57,"searchKey":1038,"visible":15},"10003269",{"type":10,"entryId":1039,"sortOrder":1040,"name":1041,"imageUrl":1042,"description":1043,"currentMorphology":13,"currentStage":22,"position":1044,"attributes":1045},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[372],[444,26],{"id":1047,"viewCount":57,"searchKey":1048,"visible":15},"10003261",{"type":10,"entryId":1049,"sortOrder":1050,"name":1051,"imageUrl":1052,"description":1053,"currentMorphology":13,"currentStage":114,"position":1054,"attributes":1055},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[372],[444,26],{"id":1057,"viewCount":57,"searchKey":1058,"visible":15},"10003305",{"type":10,"entryId":1059,"sortOrder":1060,"name":1061,"imageUrl":1062,"description":1063,"currentMorphology":13,"currentStage":22,"position":1064,"attributes":1065},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[245],[362],{"id":1067,"viewCount":57,"searchKey":1068,"visible":15},"10003232",{"type":10,"entryId":1069,"sortOrder":1070,"name":1071,"imageUrl":1072,"description":1073,"currentMorphology":13,"currentStage":114,"position":1074,"attributes":1075},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[245],[362],{"id":1077,"viewCount":57,"searchKey":1078,"visible":15},"10003198",{"type":10,"entryId":1079,"sortOrder":1080,"name":1081,"imageUrl":1082,"description":1083,"currentMorphology":13,"currentStage":22,"position":1084,"attributes":1085},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[340],[320,26],{"id":1087,"viewCount":57,"searchKey":1088,"visible":15},"10003194",{"type":10,"entryId":8,"sortOrder":1089,"name":1090,"imageUrl":1091,"description":1092,"currentMorphology":13,"currentStage":114,"position":1093,"attributes":1094},1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[340],[320,26],{"id":4,"viewCount":57,"searchKey":1096,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":1097,"attributes":1098},[24],[26],{"id":6,"viewCount":57,"searchKey":1100,"visible":15},{"type":10,"entryId":12,"sortOrder":1101,"name":80,"imageUrl":1102,"description":1103,"currentMorphology":13,"currentStage":114,"position":1104,"attributes":1105},1062300,"/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[24],[26],{"id":1107,"viewCount":57,"searchKey":1108,"visible":15},"10003188",{"type":10,"entryId":1109,"sortOrder":1110,"name":1111,"imageUrl":1112,"description":1113,"currentMorphology":13,"currentStage":22,"position":1114,"attributes":1115},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[24],[362],{"id":1117,"viewCount":57,"searchKey":1118,"visible":15},"10003182",{"type":10,"entryId":1119,"sortOrder":1120,"name":1121,"imageUrl":1122,"description":1123,"currentMorphology":13,"currentStage":114,"position":1124,"attributes":1125},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[24],[362],{"id":1127,"viewCount":57,"searchKey":1128,"visible":15},"10003273",{"type":10,"entryId":1129,"sortOrder":1130,"name":1131,"imageUrl":1132,"description":1133,"currentMorphology":13,"currentStage":172,"position":1134,"attributes":1135},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[24],[1136],"attributes-holy",{"id":1138,"viewCount":57,"searchKey":1139,"visible":15},"10003150",{"type":10,"entryId":1140,"sortOrder":1141,"name":1142,"imageUrl":1143,"description":1144,"currentMorphology":13,"currentStage":172,"position":1145,"attributes":1146},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[24],[1136],[1148,1156,1161,1164,1169,1174,1179,1184,1189,1194,1199,1202,1207,1211,1216,1221,1226,1231,1236],{"id":1149,"parentId":1150,"tagType":1151,"tagKey":1152,"name":1153,"language":1154,"sort":1155},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1157,"parentId":1150,"tagType":1151,"tagKey":1158,"name":1159,"language":1154,"sort":1160},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1162,"parentId":1150,"tagType":1151,"tagKey":13,"name":1163,"language":1154,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1165,"parentId":1150,"tagType":1151,"tagKey":1