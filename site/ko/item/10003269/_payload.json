289,299,309,319,330,340,351,361,372,382,392,402,412,422,432,442,452,462,472,482,492,502,512,522,532,542,552,562,572,582,593,603,613,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,893,903,913,923,933,943,953,963,973,983,993,1003,1013,1023,1033,1041,1045,1054,1064,1074,1084,1094,1104,1114,1124,1134,1145],{"id":212,"viewCount":59,"searchKey":213,"visible":15},"10003217",{"type":10,"entryId":214,"sortOrder":215,"name":216,"imageUrl":217,"description":218,"currentMorphology":9,"currentStage":21,"position":219,"attributes":221},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[220],"position-dps",[222],"attributes-fire",{"id":224,"viewCount":59,"searchKey":225,"visible":15},"10003309",{"type":10,"entryId":226,"sortOrder":227,"name":228,"imageUrl":229,"description":230,"currentMorphology":9,"currentStage":231,"position":232,"attributes":233},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[220],[222],{"id":235,"viewCount":59,"searchKey":236,"visible":15},"10003210",{"type":10,"entryId":237,"sortOrder":238,"name":239,"imageUrl":240,"description":241,"currentMorphology":9,"currentStage":242,"position":243,"attributes":244},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[220],[222],{"id":246,"viewCount":59,"searchKey":247,"visible":15},"10003203",{"type":10,"entryId":248,"sortOrder":249,"name":250,"imageUrl":251,"description":252,"currentMorphology":9,"currentStage":242,"position":253,"attributes":255},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[254],"position-break",[222,256],"attributes-dark",{"id":258,"viewCount":59,"searchKey":259,"visible":15},"10003353",{"type":10,"entryId":260,"sortOrder":261,"name":262,"imageUrl":263,"description":264,"currentMorphology":9,"currentStage":21,"position":265,"attributes":266},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[220],[256],{"id":268,"viewCount":59,"searchKey":269,"visible":15},"10003192",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":9,"currentStage":242,"position":275,"attributes":276},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[220],[256],{"id":278,"viewCount":59,"searchKey":279,"visible":15},"10003263",{"type":10,"entryId":280,"sortOrder":281,"name":282,"imageUrl":283,"description":284,"currentMorphology":9,"currentStage":21,"position":285,"attributes":287},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[286],"position-sup",[288],"attributes-wind",{"id":290,"viewCount":59,"searchKey":291,"visible":15},"10003323",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":9,"currentStage":242,"position":297,"attributes":298},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[286],[288],{"id":300,"viewCount":59,"searchKey":301,"visible":15},"10003249",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":9,"currentStage":242,"position":307,"attributes":308},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[220],[288],{"id":310,"viewCount":59,"searchKey":311,"visible":15},"10003242",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":9,"currentStage":242,"position":317,"attributes":318},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[254],[288],{"id":320,"viewCount":59,"searchKey":321,"visible":15},"10003167",{"type":10,"entryId":322,"sortOrder":323,"name":324,"imageUrl":325,"description":326,"currentMorphology":9,"currentStage":21,"position":327,"attributes":328},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[220],[329],"attributes-grass",{"id":331,"viewCount":59,"searchKey":332,"visible":15},"10003285",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":9,"currentStage":242,"position":338,"attributes":339},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[220],[329],{"id":341,"viewCount":59,"searchKey":342,"visible":15},"10003252",{"type":10,"entryId":343,"sortOrder":344,"name":345,"imageUrl":346,"description":347,"currentMorphology":9,"currentStage":21,"position":348,"attributes":350},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[349],"position-heal",[26],{"id":352,"viewCount":59,"searchKey":353,"visible":15},"10003344",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":9,"currentStage":231,"position":359,"attributes":360},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[349],[26],{"id":362,"viewCount":59,"searchKey":363,"visible":15},"10003245",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":9,"currentStage":242,"position":369,"attributes":370},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[349],[26,371],"attributes-ice",{"id":373,"viewCount":59,"searchKey":374,"visible":15},"10003238",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":9,"currentStage":242,"position":380,"attributes":381},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[23],[329,26],{"id":383,"viewCount":59,"searchKey":384,"visible":15},"10003243",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":9,"currentStage":21,"position":390,"attributes":391},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[286],[288],{"id":393,"viewCount":59,"searchKey":394,"visible":15},"10003140",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":9,"currentStage":242,"position":400,"attributes":401},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[286],[288],{"id":403,"viewCount":59,"searchKey":404,"visible":15},"10003236",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":9,"currentStage":242,"position":410,"attributes":411},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[286],[256],{"id":413,"viewCount":59,"searchKey":414,"visible":15},"10003196",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":9,"currentStage":21,"position":420,"attributes":421},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[254],[329],{"id":423,"viewCount":59,"searchKey":424,"visible":15},"10003189",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":9,"currentStage":242,"position":430,"attributes":431},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[23],[256,329],{"id":433,"viewCount":59,"searchKey":434,"visible":15},"10003179",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":9,"currentStage":242,"position":440,"attributes":441},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[254],[329],{"id":443,"viewCount":59,"searchKey":444,"visible":15},"10003342",{"type":10,"entryId":445,"sortOrder":446,"name":447,"imageUrl":448,"description":449,"currentMorphology":9,"currentStage":21,"position":450,"attributes":451},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[254],[25,329],{"id":453,"viewCount":59,"searchKey":454,"visible":15},"10003237",{"type":10,"entryId":455,"sortOrder":456,"name":457,"imageUrl":458,"description":459,"currentMorphology":9,"currentStage":242,"position":460,"attributes":461},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[254],[25,329],{"id":463,"viewCount":59,"searchKey":464,"visible":15},"10003326",{"type":10,"entryId":465,"sortOrder":466,"name":467,"imageUrl":468,"description":469,"currentMorphology":9,"currentStage":242,"position":470,"attributes":471},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[254],[371],{"id":473,"viewCount":59,"searchKey":474,"visible":15},"10003184",{"type":10,"entryId":475,"sortOrder":476,"name":477,"imageUrl":478,"description":479,"currentMorphology":9,"currentStage":21,"position":480,"attributes":481},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[23],[222],{"id":483,"viewCount":59,"searchKey":484,"visible":15},"10003282",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":9,"currentStage":242,"position":490,"attributes":491},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[23],[222],{"id":493,"viewCount":59,"searchKey":494,"visible":15},"10003317",{"type":10,"entryId":495,"sortOrder":496,"name":497,"imageUrl":498,"description":499,"currentMorphology":9,"currentStage":21,"position":500,"attributes":501},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[349],[288],{"id":503,"viewCount":59,"searchKey":504,"visible":15},"10003215",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":9,"currentStage":242,"position":510,"attributes":511},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[349],[288],{"id":513,"viewCount":59,"searchKey":514,"visible":15},"10003338",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":9,"currentStage":205,"position":520,"attributes":521},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[23],[288,329],{"id":523,"viewCount":59,"searchKey":524,"visible":15},"10003143",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":9,"currentStage":21,"position":530,"attributes":531},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[286],[288],{"id":533,"viewCount":59,"searchKey":534,"visible":15},"10003138",{"type":10,"entryId":535,"sortOrder":536,"name":537,"imageUrl":538,"description":539,"currentMorphology":9,"currentStage":242,"position":540,"attributes":541},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[286],[288],{"id":543,"viewCount":59,"searchKey":544,"visible":15},"10003290",{"type":10,"entryId":545,"sortOrder":546,"name":547,"imageUrl":548,"description":549,"currentMorphology":9,"currentStage":21,"position":550,"attributes":551},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[220],[329],{"id":553,"viewCount":59,"searchKey":554,"visible":15},"10003271",{"type":10,"entryId":555,"sortOrder":556,"name":557,"imageUrl":558,"description":559,"currentMorphology":9,"currentStage":242,"position":560,"attributes":561},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[220],[329],{"id":563,"viewCount":59,"searchKey":564,"visible":15},"10003153",{"type":10,"entryId":565,"sortOrder":566,"name":567,"imageUrl":568,"description":569,"currentMorphology":9,"currentStage":242,"position":570,"attributes":571},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[286],[329],{"id":573,"viewCount":59,"searchKey":574,"visible":15},"10003231",{"type":10,"entryId":575,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":9,"currentStage":21,"position":580,"attributes":581},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[254],[329],{"id":583,"viewCount":59,"searchKey":584,"visible":15},"10003149",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":9,"currentStage":242,"position":590,"attributes":591},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[286],[592],"attributes-electric",{"id":594,"viewCount":59,"searchKey":595,"visible":15},"10003218",{"type":10,"entryId":596,"sortOrder":597,"name":598,"imageUrl":599,"description":600,"currentMorphology":9,"currentStage":242,"position":601,"attributes":602},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[254],[329],{"id":604,"viewCount":59,"searchKey":605,"visible":15},"10003278",{"type":10,"entryId":606,"sortOrder":607,"name":608,"imageUrl":609,"description":610,"currentMorphology":9,"currentStage":21,"position":611,"attributes":612},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[286],[256],{"id":614,"viewCount":59,"searchKey":615,"visible":15},"10003296",{"type":10,"entryId":616,"sortOrder":617,"name":618,"imageUrl":619,"description":620,"currentMorphology":9,"currentStage":242,"position":621,"attributes":622},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[286],[256],{"id":624,"viewCount":59,"searchKey":625,"visible":15},"10003283",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":9,"currentStage":21,"position":631,"attributes":632},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[220],[256],{"id":634,"viewCount":59,"searchKey":635,"visible":15},"10003144",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":9,"currentStage":242,"position":641,"attributes":642},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[220],[256],{"id":644,"viewCount":59,"searchKey":645,"visible":15},"10003276",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":9,"currentStage":242,"position":651,"attributes":652},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[220],[592],{"id":654,"viewCount":59,"searchKey":655,"visible":15},"10003197",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":9,"currentStage":21,"position":661,"attributes":662},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[220],[371],{"id":664,"viewCount":59,"searchKey":665,"visible":15},"10003350",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":9,"currentStage":231,"position":671,"attributes":672},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[220],[371],{"id":674,"viewCount":59,"searchKey":675,"visible":15},"10003190",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":9,"currentStage":242,"position":681,"attributes":682},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[220],[371],{"id":684,"viewCount":59,"searchKey":685,"visible":15},"10003299",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":9,"currentStage":21,"position":691,"attributes":692},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[254],[592],{"id":694,"viewCount":59,"searchKey":695,"visible":15},"10003250",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":9,"currentStage":242,"position":701,"attributes":702},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[254],[592],{"id":704,"viewCount":59,"searchKey":705,"visible":15},"10003298",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":9,"currentStage":21,"position":711,"attributes":712},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[254],[26],{"id":714,"viewCount":59,"searchKey":715,"visible":15},"10003173",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":9,"currentStage":231,"position":721,"attributes":722},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[254],[26],{"id":724,"viewCount":59,"searchKey":725,"visible":15},"10003291",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":9,"currentStage":242,"position":731,"attributes":732},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[286],[26],{"id":734,"viewCount":59,"searchKey":735,"visible":15},"10003341",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":9,"currentStage":242,"position":741,"attributes":742},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[254],[26],{"id":744,"viewCount":59,"searchKey":745,"visible":15},"10003228",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":9,"currentStage":21,"position":751,"attributes":752},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[220],[26],{"id":754,"viewCount":59,"searchKey":755,"visible":15},"10003352",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":9,"currentStage":231,"position":761,"attributes":762},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[220],[26],{"id":764,"viewCount":59,"searchKey":765,"visible":15},"10003345",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":9,"currentStage":242,"position":771,"attributes":772},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[220],[26],{"id":774,"viewCount":59,"searchKey":775,"visible":15},"10003340",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":9,"currentStage":21,"position":781,"attributes":782},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[220],[25],{"id":784,"viewCount":59,"searchKey":785,"visible":15},"10003251",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":9,"currentStage":242,"position":791,"attributes":792},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[220],[25],{"id":794,"viewCount":59,"searchKey":795,"visible":15},"10003241",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":9,"currentStage":242,"position":801,"attributes":802},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[286],[25],{"id":804,"viewCount":59,"searchKey":805,"visible":15},"10003154",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":9,"currentStage":21,"position":811,"attributes":812},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[220],[592],{"id":814,"viewCount":59,"searchKey":815,"visible":15},"10003151",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":9,"currentStage":242,"position":821,"attributes":822},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[220],[592],{"id":824,"viewCount":59,"searchKey":825,"visible":15},"10003318",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":9,"currentStage":21,"position":831,"attributes":832},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[254],[256],{"id":834,"viewCount":59,"searchKey":835,"visible":15},"10003332",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":9,"currentStage":242,"position":841,"attributes":842},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[220],[256],{"id":844,"viewCount":59,"searchKey":845,"visible":15},"10003297",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":9,"currentStage":242,"position":851,"attributes":852},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[254],[256],{"id":854,"viewCount":59,"searchKey":855,"visible":15},"10003354",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":9,"currentStage":21,"position":861,"attributes":862},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[254],[288],{"id":864,"viewCount":59,"searchKey":865,"visible":15},"10003164",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":9,"currentStage":231,"position":871,"attributes":872},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[254],[288],{"id":874,"viewCount":59,"searchKey":875,"visible":15},"10003311",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":9,"currentStage":242,"position":881,"attributes":882},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[254],[288],{"id":884,"viewCount":59,"searchKey":885,"visible":15},"10003304",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":9,"currentStage":242,"position":891,"attributes":892},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[220],[222],{"id":894,"viewCount":59,"searchKey":895,"visible":15},"10003208",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":9,"currentStage":21,"position":901,"attributes":902},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[220],[25],{"id":904,"viewCount":59,"searchKey":905,"visible":15},"10003202",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":9,"currentStage":242,"position":911,"attributes":912},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[220],[25],{"id":914,"viewCount":59,"searchKey":915,"visible":15},"10003180",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":9,"currentStage":21,"position":921,"attributes":922},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[254],[25],{"id":924,"viewCount":59,"searchKey":925,"visible":15},"10003300",{"type":10,"entryId":926,"sortOrder":927,"name":928,"imageUrl":929,"description":930,"currentMorphology":9,"currentStage":231,"position":931,"attributes":932},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[254],[222,25],{"id":934,"viewCount":59,"searchKey":935,"visible":15},"10003174",{"type":10,"entryId":936,"sortOrder":937,"name":938,"imageUrl":939,"description":940,"currentMorphology":9,"currentStage":242,"position":941,"attributes":942},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[254],[222,25],{"id":944,"viewCount":59,"searchKey":945,"visible":15},"10003293",{"type":10,"entryId":946,"sortOrder":947,"name":948,"imageUrl":949,"description":950,"currentMorphology":9,"currentStage":231,"position":951,"attributes":952},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[254],[25],{"id":954,"viewCount":59,"searchKey":955,"visible":15},"10003168",{"type":10,"entryId":956,"sortOrder":957,"name":958,"imageUrl":959,"description":960,"currentMorphology":9,"currentStage":242,"position":961,"attributes":962},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[254],[25],{"id":964,"viewCount":59,"searchKey":965,"visible":15},"10003161",{"type":10,"entryId":966,"sortOrder":967,"name":968,"imageUrl":969,"description":970,"currentMorphology":9,"currentStage":21,"position":971,"attributes":972},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[286],[25],{"id":974,"viewCount":59,"searchKey":975,"visible":15},"10003222",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":9,"currentStage":242,"position":981,"attributes":982},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[286],[25],{"id":984,"viewCount":59,"searchKey":985,"visible":15},"10003272",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":9,"currentStage":21,"position":991,"attributes":992},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[286],[592],{"id":994,"viewCount":59,"searchKey":995,"visible":15},"10003254",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":9,"currentStage":231,"position":1001,"attributes":1002},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[286],[592],{"id":1004,"viewCount":59,"searchKey":1005,"visible":15},"10003163",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":9,"currentStage":242,"position":1011,"attributes":1012},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[286],[592],{"id":1014,"viewCount":59,"searchKey":1015,"visible":15},"10003204",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":9,"currentStage":21,"position":1021,"attributes":1022},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[23],[26],{"id":1024,"viewCount":59,"searchKey":1025,"visible":15},"10003205",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":9,"currentStage":242,"position":1031,"attributes":1032},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[23],[26],{"id":5,"viewCount":59,"searchKey":1034,"visible":15},{"type":10,"entryId":8,"sortOrder":1035,"name":1036,"imageUrl":1037,"description":1038,"currentMorphology":9,"currentStage":205,"position":1039,"attributes":1040},1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[23],[592],{"id":4,"viewCount":59,"searchKey":1042,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1043,"attributes":1044},[23],[25,26],{"id":1046,"viewCount":59,"searchKey":1047,"visible":15},"10003261",{"type":10,"entryId":1048,"sortOrder":1049,"name":81,"imageUrl":1050,"description":1051,"currentMorphology":9,"currentStage":242,"position":1052,"attributes":1053},"085",1038300,"/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[23],[25,26],{"id":1055,"viewCount":59,"searchKey":1056,"visible":15},"10003305",{"type":10,"entryId":1057,"sortOrder":1058,"name":1059,"imageUrl":1060,"description":1061,"currentMorphology":9,"currentStage":21,"position":1062,"attributes":1063},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[254],[371],{"id":1065,"viewCount":59,"searchKey":1066,"visible":15},"10003232",{"type":10,"entryId":1067,"sortOrder":1068,"name":1069,"imageUrl":1070,"description":1071,"currentMorphology":9,"currentStage":242,"position":1072,"attributes":1073},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[254],[371],{"id":1075,"viewCount":59,"searchKey":1076,"visible":15},"10003198",{"type":10,"entryId":1077,"sortOrder":1078,"name":1079,"imageUrl":1080,"description":1081,"currentMorphology":9,"currentStage":21,"position":1082,"attributes":1083},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[349],[329,26],{"id":1085,"viewCount":59,"searchKey":1086,"visible":15},"10003194",{"type":10,"entryId":1087,"sortOrder":1088,"name":1089,"imageUrl":1090,"description":1091,"currentMorphology":9,"currentStage":242,"position":1092,"attributes":1093},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[349],[329,26],{"id":1095,"viewCount":59,"searchKey":1096,"visible":15},"10003185",{"type":10,"entryId":1097,"sortOrder":1098,"name":1099,"imageUrl":1100,"description":1101,"currentMorphology":9,"currentStage":21,"position":1102,"attributes":1103},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[220],[26],{"id":1105,"viewCount":59,"searchKey":1106,"visible":15},"10003284",{"type":10,"entryId":1107,"sortOrder":1108,"name":1109,"imageUrl":1110,"description":1111,"currentMorphology":9,"currentStage":242,"position":1112,"attributes":1113},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[220],[26],{"id":1115,"viewCount":59,"searchKey":1116,"visible":15},"10003188",{"type":10,"entryId":1117,"sortOrder":1118,"name":1119,"imageUrl":1120,"description":1121,"currentMorphology":9,"currentStage":21,"position":1122,"attributes":1123},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[220],[371],{"id":1125,"viewCount":59,"searchKey":1126,"visible":15},"10003182",{"type":10,"entryId":1127,"sortOrder":1128,"name":1129,"imageUrl":1130,"description":1131,"currentMorphology":9,"currentStage":242,"position":1132,"attributes":1133},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[220],[371],{"id":1135,"viewCount":59,"searchKey":1136,"visible":15},"10003273",{"type":10,"entryId":1137,"sortOrder":1138,"name":1139,"imageUrl":1140,"description":1141,"currentMorphology":9,"currentStage":205,"position":1142,"attributes":1143},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[220],[1144],"attributes-holy",{"id":1146,"viewCount":59,"searchKey":1147,"visible":15},"10003150",{"type":10,"entryId":1148,"sortOrder":1149,"name":1150,"imageUrl":1151,"description":1152,"currentMorphology":9,"currentStage":205,"position":1153,"attributes":1154},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[220],[1144],[1156,1164,1169,1172,1177,1182,1187,1192,1197,1202,1207,1211,1216,1219,1224,1229,1234,1239,1244],{"id":1157,"parentId":1158,"tagType":1159,"tagKey":1160,"name":1161,"language":1162,"sort":1163},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1165,"parentId":1158,"tagType":1159,"tagKey":1166,"name":1167,"language":1162,"sort":1168},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1170,"parentId":1158,"tagType":1159,"tagKey":9,"name":1171,"language":1162,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1173,"parentId":1158,"tagType":1159,"tagKey":1174,"name":1175,"language":1162,"sort":1176},"1e04356b5eba7afe911f44a3d60b6035","Thunders