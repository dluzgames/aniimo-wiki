2,"name":73,"label":73,"icon":74,"stage":28,"position":75,"stageStrength":28,"condition":76,"children":78},"root","버블코타","/cdn/init/Wiki_PetHead_10621.png",0,{"isVariant":65,"list":77},[],[79],{"id":80,"name":18,"label":18,"icon":81,"stage":56,"position":28,"stageStrength":56,"condition":82,"children":84},"91268313_6","/cdn/init/Wiki_PetHead_10623.png",{"isVariant":65,"list":83},[],[],"91268313_5",{"id":87,"type":60,"props":88,"children":92},"91268313_7",{"title":89,"type":90,"id":91,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"출현 지역","small","91268313_8",[93],{"id":94,"type":95,"props":96,"children":57},"91268313_9","capsule",{"id":97,"customKey":45,"title":98,"icon":45,"bgColor":99,"fontColor":100,"type":101},"91268313_10","초승달 만","#dee2ec","#60606e","normal",{"id":103,"type":60,"props":104,"children":107},"91268313_11",{"title":105,"type":90,"id":106,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"홈 능력","91268313_12",[108,114],{"id":109,"type":95,"props":110,"children":57},"91268313_13",{"id":111,"customKey":112,"title":21,"icon":45,"bgColor":45,"fontColor":45,"type":113},"91268313_14","home-1101","spritePic",{"id":115,"type":95,"props":116,"children":57},"91268313_15",{"id":117,"customKey":118,"title":21,"icon":45,"bgColor":45,"fontColor":45,"type":113},"91268313_16","home-1002",{"id":120,"title":121,"components":122},2,"애니모 능력",[123,139,155],{"id":124,"type":60,"props":125,"children":128},"91268313_17",{"title":126,"type":90,"id":127,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"Pathfinding","91268313_18",[129],{"id":130,"type":131,"props":132,"children":57},"91268313_19","circle",{"id":133,"customKey":134,"icon":45,"iconStyle":45,"iconTitle":135,"descTitle":45,"descContent":45,"source":136,"bgColor":99,"fontColor":100,"type":101},"91268313_20","SWIM","수영 Lv.3",{"attributes":137,"type":138,"consume":45,"power":45},[],[],{"id":140,"type":60,"props":141,"children":144},"91268313_23",{"title":142,"type":63,"id":143,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"애니모 특성","91268313_24",[145],{"id":146,"type":131,"props":147,"children":57},"91268313_25",{"id":148,"customKey":45,"icon":149,"iconStyle":63,"iconTitle":45,"descTitle":150,"descContent":151,"source":152},"91268313_26","/cdn/init/1062300_Feature_162301_Icon.png","캡슐 뽑기","일반 공격과 스킬을 사용할 때마다 뽑기를 한 번 진행하며, 주황, 보라, 파랑, 금색 네 가지 색의 버블이 랜덤으로 나와 뽑기 슬롯에 저장됩니다. 금색 버블이 나올 확률은 1%, 나머지 색상은 33%입니다. 뽑기 슬롯에 같은 색 버블이 5개가 있거나 금색 버블이 나오면 슬롯이 초기화되고 [당첨] 상태가 되며 10초 동안 지속됩니다. [당첨] 상태에서는 반드시 무지개 버블을 발사하고, 일반 공격 피해가 60% 증가합니다.",{"attributes":153,"type":154,"consume":45,"power":45},[],[],{"id":156,"type":60,"props":157,"children":57},"91268313_27",{"title":158,"type":63,"id":159,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":65,"tabs":160},"스킬 소개","91268313_28",[161,202],{"id":162,"title":163,"children":164},"91268313_29","전투 스킬",[165,178,190],{"id":166,"type":131,"props":167},"91268313_30",{"id":168,"customKey":45,"icon":169,"iconStyle":63,"iconTitle":45,"descTitle":170,"descContent":171,"source":172},"91268313_31","/cdn/init/1062300_Skill_10301190_Icon.png","창고 대방출 세일","대상에게 버블을 지속적으로 뿜어내며, 5초 동안 지속됩니다. 사용 중 이동할 수 있지만 이동 속도가 감소하며, 주는 피해는 일반 공격 피해로 간주됩니다.",{"attributes":173,"type":174,"consume":176,"power":177},[21],[175],"1","40","124",{"id":179,"type":131,"props":180},"91268313_32",{"id":181,"customKey":45,"icon":182,"iconStyle":63,"iconTitle":45,"descTitle":183,"descContent":184,"source":185},"91268313_33","/cdn/init/1062300_Skill_10301180_Icon.png","밀실 조작","현재 색상 중 가장 적은 버블을 소모하며, 다음 일반 공격은 반드시 현재 수량이 가장 많은 색상의 버블을 발사합니다. 일반 공격 피해가 25% 증가하며 15초 동안 지속됩니다.",{"attributes":186,"type":187,"consume":189,"power":188},[21],[188],"0","10",{"id":191,"type":131,"props":192},"91268313_34",{"id":193,"customKey":45,"icon":194,"iconStyle":63,"iconTitle":45,"descTitle":195,"descContent":196,"source":197},"91268313_35","/cdn/init/1062300_Skill_10301200_Icon.png","강화 버블","대상에게 강화 버블을 뿜어내 버블의 색상에 따라 서로 다른 효과를 획득합니다. 주황색 버블은 범위 피해를 주고, 파란색 버블은 명중 후 에너지를 5 회복합니다. 보라색 버블은 추가로 20%의 피해를 줍니다. 금색 버블과 무지개 버블은 세 가지 색상 버블의 효과를 동시에 가집니다.",{"attributes":198,"type":199,"consume":200,"power":201},[21],[175],"20","43",{"id":203,"title":204,"children":205},"91268313_36","고유 스킬",[206,217],{"id":207,"type":131,"props":208},"91268313_37",{"id":209,"customKey":45,"icon":210,"iconStyle":63,"iconTitle":45,"descTitle":211,"descContent":212,"source":213},"91268313_38","/cdn/init/1062300_Skill_11600000_Icon.png","공격","물 원소 능력을 사용하여 원거리에서 목표를 공격합니다.",{"attributes":214,"type":215,"consume":188,"power":216},[21],[175],"6",{"id":218,"type":131,"props":219},"91268313_39",{"id":220,"customKey":45,"icon":221,"iconStyle":63,"iconTitle":45,"descTitle":222,"descContent":223,"source":224},"91268313_40","/cdn/init/1062300_Skill_10301340_Icon.png","슈퍼 잭팟","대상에게 거대한 무지개 버블을 뿜어내 넓은 범위 피해를 주고, 즉시 10초 동안 지속되는 [당첨] 상태에 진입합니다.",{"attributes":225,"type":226,"consume":188,"power":228},[21],[227],"2","183",[230],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[232,243,253,263,275,285,295,307,317,327,337,348,358,369,379,390,401,411,421,431,441,451,461,472,482,492,502,512,522,532,542,552,562,572,582,592,602,613,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,893,903,913,923,933,943,953,963,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1130,1134,1142,1152,1163],{"id":233,"viewCount":57,"searchKey":234,"visible":14},"10003217",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":9,"currentStage":175,"position":240,"attributes":241},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[23],[242],"attributes-fire",{"id":244,"viewCount":57,"searchKey":245,"visible":14},"10003309",{"type":10,"entryId":246,"sortOrder":247,"name":248,"imageUrl":249,"description":250,"currentMorphology":9,"currentStage":227,"position":251,"attributes":252},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[23],[242],{"id":254,"viewCount":57,"searchKey":255,"visible":14},"10003210",{"type":10,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":9,"currentStage":21,"position":261,"attributes":262},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[23],[242],{"id":264,"viewCount":57,"searchKey":265,"visible":14},"10003203",{"type":10,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":9,"currentStage":21,"position":271,"attributes":273},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[272],"position-break",[242,274],"attributes-dark",{"id":276,"viewCount":57,"searchKey":277,"visible":14},"10003353",{"type":10,"entryId":278,"sortOrder":279,"name":280,"imageUrl":281,"description":282,"currentMorphology":9,"currentStage":175,"position":283,"attributes":284},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[23],[274],{"id":286,"viewCount":57,"searchKey":287,"visible":14},"10003192",{"type":10,"entryId":288,"sortOrder":289,"name":290,"imageUrl":291,"description":292,"currentMorphology":9,"currentStage":21,"position":293,"attributes":294},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[23],[274],{"id":296,"viewCount":57,"searchKey":297,"visible":14},"10003263",{"type":10,"entryId":298,"sortOrder":299,"name":300,"imageUrl":301,"description":302,"currentMorphology":9,"currentStage":175,"position":303,"attributes":305},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[304],"position-sup",[306],"attributes-wind",{"id":308,"viewCount":57,"searchKey":309,"visible":14},"10003323",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":9,"currentStage":21,"position":315,"attributes":316},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[304],[306],{"id":318,"viewCount":57,"searchKey":319,"visible":14},"10003249",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":21,"position":325,"attributes":326},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[23],[306],{"id":328,"viewCount":57,"searchKey":329,"visible":14},"10003242",{"type":10,"entryId":330,"sortOrder":331,"name":332,"imageUrl":333,"description":334,"currentMorphology":9,"currentStage":21,"position":335,"attributes":336},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[272],[306],{"id":338,"viewCount":57,"searchKey":339,"visible":14},"10003167",{"type":10,"entryId":340,"sortOrder":341,"name":342,"imageUrl":343,"description":344,"currentMorphology":9,"currentStage":175,"position":345,"attributes":346},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[23],[347],"attributes-grass",{"id":349,"viewCount":57,"searchKey":350,"visible":14},"10003285",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":9,"currentStage":21,"position":356,"attributes":357},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[23],[347],{"id":359,"viewCount":57,"searchKey":360,"visible":14},"10003252",{"type":10,"entryId":361,"sortOrder":362,"name":363,"imageUrl":364,"description":365,"currentMorphology":9,"currentStage":175,"position":366,"attributes":368},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[367],"position-heal",[25],{"id":370,"viewCount":57,"searchKey":371,"visible":14},"10003344",{"type":10,"entryId":372,"sortOrder":373,"name":374,"imageUrl":375,"description":376,"currentMorphology":9,"currentStage":227,"position":377,"attributes":378},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[367],[25],{"id":380,"viewCount":57,"searchKey":381,"visible":14},"10003245",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":9,"currentStage":21,"position":387,"attributes":388},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[367],[25,389],"attributes-ice",{"id":391,"viewCount":57,"searchKey":392,"visible":14},"10003238",{"type":10,"entryId":393,"sortOrder":394,"name":395,"imageUrl":396,"description":397,"currentMorphology":9,"currentStage":21,"position":398,"attributes":400},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[399],"position-energy",[347,25],{"id":402,"viewCount":57,"searchKey":403,"visible":14},"10003243",{"type":10,"entryId":404,"sortOrder":405,"name":406,"imageUrl":407,"description":408,"currentMorphology":9,"currentStage":175,"position":409,"attributes":410},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[304],[306],{"id":412,"viewCount":57,"searchKey":413,"visible":14},"10003140",{"type":10,"entryId":414,"sortOrder":415,"name":416,"imageUrl":417,"description":418,"currentMorphology":9,"currentStage":21,"position":419,"attributes":420},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[304],[306],{"id":422,"viewCount":57,"searchKey":423,"visible":14},"10003236",{"type":10,"entryId":424,"sortOrder":425,"name":426,"imageUrl":427,"description":428,"currentMorphology":9,"currentStage":21,"position":429,"attributes":430},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[304],[274],{"id":432,"viewCount":57,"searchKey":433,"visible":14},"10003196",{"type":10,"entryId":434,"sortOrder":435,"name":436,"imageUrl":437,"description":438,"currentMorphology":9,"currentStage":175,"position":439,"attributes":440},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[272],[347],{"id":442,"viewCount":57,"searchKey":443,"visible":14},"10003189",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":9,"currentStage":21,"position":449,"attributes":450},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[399],[274,347],{"id":452,"viewCount":57,"searchKey":453,"visible":14},"10003179",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":9,"currentStage":21,"position":459,"attributes":460},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[272],[347],{"id":462,"viewCount":57,"searchKey":463,"visible":14},"10003342",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":9,"currentStage":175,"position":469,"attributes":470},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[272],[471,347],"attributes-rock",{"id":473,"viewCount":57,"searchKey":474,"visible":14},"10003237",{"type":10,"entryId":475,"sortOrder":476,"name":477,"imageUrl":478,"description":479,"currentMorphology":9,"currentStage":21,"position":480,"attributes":481},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[272],[471,347],{"id":483,"viewCount":57,"searchKey":484,"visible":14},"10003326",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":9,"currentStage":21,"position":490,"attributes":491},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[272],[389],{"id":493,"viewCount":57,"searchKey":494,"visible":14},"10003184",{"type":10,"entryId":495,"sortOrder":496,"name":497,"imageUrl":498,"description":499,"currentMorphology":9,"currentStage":175,"position":500,"attributes":501},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[399],[242],{"id":503,"viewCount":57,"searchKey":504,"visible":14},"10003282",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":9,"currentStage":21,"position":510,"attributes":511},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[399],[242],{"id":513,"viewCount":57,"searchKey":514,"visible":14},"10003317",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":9,"currentStage":175,"position":520,"attributes":521},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[367],[306],{"id":523,"viewCount":57,"searchKey":524,"visible":14},"10003215",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":9,"currentStage":21,"position":530,"attributes":531},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[367],[306],{"id":533,"viewCount":57,"searchKey":534,"visible":14},"10003338",{"type":10,"entryId":535,"sortOrder":536,"name":537,"imageUrl":538,"description":539,"currentMorphology":9,"currentStage":188,"position":540,"attributes":541},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[399],[306,347],{"id":543,"viewCount":57,"searchKey":544,"visible":14},"10003143",{"type":10,"entryId":545,"sortOrder":546,"name":547,"imageUrl":548,"description":549,"currentMorphology":9,"currentStage":175,"position":550,"attributes":551},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[304],[306],{"id":553,"viewCount":57,"searchKey":554,"visible":14},"10003138",{"type":10,"entryId":555,"sortOrder":556,"name":557,"imageUrl":558,"description":559,"currentMorphology":9,"currentStage":21,"position":560,"attributes":561},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[304],[306],{"id":563,"viewCount":57,"searchKey":564,"visible":14},"10003290",{"type":10,"entryId":565,"sortOrder":566,"name":567,"imageUrl":568,"description":569,"currentMorphology":9,"currentStage":175,"position":570,"attributes":571},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[23],[347],{"id":573,"viewCount":57,"searchKey":574,"visible":14},"10003271",{"type":10,"entryId":575,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":9,"currentStage":21,"position":580,"attributes":581},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[23],[347],{"id":583,"viewCount":57,"searchKey":584,"visible":14},"10003153",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":9,"currentStage":21,"position":590,"attributes":591},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[304],[347],{"id":593,"viewCount":57,"searchKey":594,"visible":14},"10003231",{"type":10,"entryId":595,"sortOrder":596,"name":597,"imageUrl":598,"description":599,"currentMorphology":9,"currentStage":175,"position":600,"attributes":601},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[272],[347],{"id":603,"viewCount":57,"searchKey":604,"visible":14},"10003149",{"type":10,"entryId":605,"sortOrder":606,"name":607,"imageUrl":608,"description":609,"currentMorphology":9,"currentStage":21,"position":610,"attributes":611},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[304],[612],"attributes-electric",{"id":614,"viewCount":57,"searchKey":615,"visible":14},"10003218",{"type":10,"entryId":616,"sortOrder":617,"name":618,"imageUrl":619,"description":620,"currentMorphology":9,"currentStage":21,"position":621,"attributes":622},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[272],[347],{"id":624,"viewCount":57,"searchKey":625,"visible":14},"10003278",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":9,"currentStage":175,"position":631,"attributes":632},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[304],[274],{"id":634,"viewCount":57,"searchKey":635,"visible":14},"10003296",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":9,"currentStage":21,"position":641,"attributes":642},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[304],[274],{"id":644,"viewCount":57,"searchKey":645,"visible":14},"10003283",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":9,"currentStage":175,"position":651,"attributes":652},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[23],[274],{"id":654,"viewCount":57,"searchKey":655,"visible":14},"10003144",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":9,"currentStage":21,"position":661,"attributes":662},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[23],[274],{"id":664,"viewCount":57,"searchKey":665,"visible":14},"10003276",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":9,"currentStage":21,"position":671,"attributes":672},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[23],[612],{"id":674,"viewCount":57,"searchKey":675,"visible":14},"10003197",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":9,"currentStage":175,"position":681,"attributes":682},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[23],[389],{"id":684,"viewCount":57,"searchKey":685,"visible":14},"10003350",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":9,"currentStage":227,"position":691,"attributes":692},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[23],[389],{"id":694,"viewCount":57,"searchKey":695,"visible":14},"10003190",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":9,"currentStage":21,"position":701,"attributes":702},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[23],[389],{"id":704,"viewCount":57,"searchKey":705,"visible":14},"10003299",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":9,"currentStage":175,"position":711,"attributes":712},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[272],[612],{"id":714,"viewCount":57,"searchKey":715,"visible":14},"10003250",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":9,"currentStage":21,"position":721,"attributes":722},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[272],[612],{"id":724,"viewCount":57,"searchKey":725,"visible":14},"10003298",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":9,"currentStage":175,"position":731,"attributes":732},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[272],[25],{"id":734,"viewCount":57,"searchKey":735,"visible":14},"10003173",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":9,"currentStage":227,"position":741,"attributes":742},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[272],[25],{"id":744,"viewCount":57,"searchKey":745,"visible":14},"10003291",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":9,"currentStage":21,"position":751,"attributes":752},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[304],[25],{"id":754,"viewCount":57,"searchKey":755,"visible":14},"10003341",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":9,"currentStage":21,"position":761,"attributes":762},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[272],[25],{"id":764,"viewCount":57,"searchKey":765,"visible":14},"10003228",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":9,"currentStage":175,"position":771,"attributes":772},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[23],[25],{"id":774,"viewCount":57,"searchKey":775,"visible":14},"10003352",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":9,"currentStage":227,"position":781,"attributes":782},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[23],[25],{"id":784,"viewCount":57,"searchKey":785,"visible":14},"10003345",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":9,"currentStage":21,"position":791,"attributes":792},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[23],[25],{"id":794,"viewCount":57,"searchKey":795,"visible":14},"10003340",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":9,"currentStage":175,"position":801,"attributes":802},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[23],[471],{"id":804,"viewCount":57,"searchKey":805,"visible":14},"10003251",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":9,"currentStage":21,"position":811,"attributes":812},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[23],[471],{"id":814,"viewCount":57,"searchKey":815,"visible":14},"10003241",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":9,"currentStage":21,"position":821,"attributes":822},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[304],[471],{"id":824,"viewCount":57,"searchKey":825,"visible":14},"10003154",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":9,"currentStage":175,"position":831,"attributes":832},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[23],[612],{"id":834,"viewCount":57,"searchKey":835,"visible":14},"10003151",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":9,"currentStage":21,"position":841,"attributes":842},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[23],[612],{"id":844,"viewCount":57,"searchKey":845,"visible":14},"10003318",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":9,"currentStage":175,"position":851,"attributes":852},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[272],[274],{"id":854,"viewCount":57,"searchKey":855,"visible":14},"10003332",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":9,"currentStage":21,"position":861,"attributes":862},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[23],[274],{"id":864,"viewCount":57,"searchKey":865,"visible":14},"10003297",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":9,"currentStage":21,"position":871,"attributes":872},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[272],[274],{"id":874,"viewCount":57,"searchKey":875,"visible":14},"10003354",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":9,"currentStage":175,"position":881,"attributes":882},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[272],[306],{"id":884,"viewCount":57,"searchKey":885,"visible":14},"10003164",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":9,"currentStage":227,"position":891,"attributes":892},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[272],[306],{"id":894,"viewCount":57,"searchKey":895,"visible":14},"10003311",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":9,"currentStage":21,"position":901,"attributes":902},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[272],[306],{"id":904,"viewCount":57,"searchKey":905,"visible":14},"10003304",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":9,"currentStage":21,"position":911,"attributes":912},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[23],[242],{"id":914,"viewCount":57,"searchKey":915,"visible":14},"10003208",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":9,"currentStage":175,"position":921,"attributes":922},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[23],[471],{"id":924,"viewCount":57,"searchKey":925,"visible":14},"10003202",{"type":10,"entryId":926,"sortOrder":927,"name":928,"imageUrl":929,"description":930,"currentMorphology":9,"currentStage":21,"position":931,"attributes":932},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[23],[471],{"id":934,"viewCount":57,"searchKey":935,"visible":14},"10003180",{"type":10,"entryId":936,"sortOrder":937,"name":938,"imageUrl":939,"description":940,"currentMorphology":9,"currentStage":175,"position":941,"attributes":942},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[272],[471],{"id":944,"viewCount":57,"searchKey":945,"visible":14},"10003300",{"type":10,"entryId":946,"sortOrder":947,"name":948,"imageUrl":949,"description":950,"currentMorphology":9,"currentStage":227,"position":951,"attributes":952},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[272],[242,471],{"id":954,"viewCount":57,"searchKey":955,"visible":14},"10003174",{"type":10,"entryId":956,"sortOrder":957,"name":958,"imageUrl":959,"description":960,"currentMorphology":9,"currentStage":21,"position":961,"attributes":962},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[272],[242,471],{"id":964,"viewCount":57,"searchKey":965,"visible":14},"10003293",{"type":10,"entryId":966,"sortOrder":967,"name":968,"imageUrl":969,"description":970,"currentMorphology":9,"currentStage":227,"position":971,"attributes":972},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[272],[471],{"id":974,"viewCount":57,"searchKey":975,"visible":14},"10003168",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":9,"currentStage":21,"position":981,"attributes":982},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[272],[471],{"id":984,"viewCount":57,"searchKey":985,"visible":14},"10003161",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":9,"currentStage":175,"position":991,"attributes":992},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[304],[471],{"id":994,"viewCount":57,"searchKey":995,"visible":14},"10003222",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":9,"currentStage":21,"position":1001,"attributes":1002},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[304],[471],{"id":1004,"viewCount":57,"searchKey":1005,"visible":14},"10003272",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":9,"currentStage":175,"position":1011,"attributes":1012},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[304],[612],{"id":1014,"viewCount":57,"searchKey":1015,"visible":14},"10003254",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":9,"currentStage":227,"position":1021,"attributes":1022},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[304],[612],{"id":1024,"viewCount":57,"searchKey":1025,"visible":14},"10003163",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":9,"currentStage":21,"position":1031,"attributes":1032},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[304],[612],{"id":1034,"viewCount":57,"searchKey":1035,"visible":14},"10003204",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":9,"currentStage":175,"position":1041,"attributes":1042},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[399],[25],{"id":1044,"viewCount":57,"searchKey":1045,"visible":14},"10003205",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":9,"currentStage":21,"position":1051,"attributes":1052},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[399],[25],{"id":1054,"viewCount":57,"searchKey":1055,"visible":14},"10003324",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":9,"currentStage":188,"position":1061,"attributes":1062},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[399],[612],{"id":1064,"viewCount":57,"searchKey":1065,"visible":14},"10003269",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":9,"currentStage":175,"position":1071,"attributes":1072},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[399],[471,25],{"id":1074,"viewCount":57,"searchKey":1075,"visible":14},"10003261",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":9,"currentStage":21,"position":1081,"attributes":1082},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[399],[471,25],{"id":1084,"viewCount":57,"searchKey":1085,"visible":14},"10003305",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":9,"currentStage":175,"position":1091,"attributes":1092},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[272],[389],{"id":1094,"viewCount":57,"searchKey":1095,"visible":14},"10003232",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":9,"currentStage":21,"position":1101,"attributes":1102},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[272],[389],{"id":1104,"viewCount":57,"searchKey":1105,"visible":14},"10003198",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":9,"currentStage":175,"position":1111,"attributes":1112},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[367],[347,25],{"id":1114,"viewCount":57,"searchKey":1115,"visible":14},"10003194",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":9,"currentStage":21,"position":1121,"attributes":1122},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[367],[347,25],{"id":5,"viewCount":57,"searchKey":1124,"visible":14},{"type":10,"entryId":8,"sortOrder":1125,"name":73,"imageUrl":1126,"description":1127,"currentMorphology":9,"currentStage":175,"position":1128,"attributes":1129},1062100,"/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[23],[25],{"id":4,"viewCount":57,"searchKey":1131,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1132,"attributes":1133},[23],[25],{"id":6,"viewCount":57,"searchKey":1135,"visible":14},{"type":10,"entryId":12,"sortOrder":1136,"name":1137,"imageUrl":1138,"description":1139,"currentMorphology":9,"currentStage":175,"position":1140,"attributes":1141},1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[23],[389],{"id":1143,"viewCount":57,"searchKey":1144,"visible":14},"10003182",{"type":10,"entryId":1145,"sortOrder":1146,"name":1147,"imageUrl":1148,"description":1149,"currentMorphology":9,"currentStage":21,"position":1150,"attributes":1151},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[23],[389],{"id":1153,"viewCount":57,"searchKey":1154,"visible":14},"10003273",{"type":10,"entryId":1155,"sortOrder":1156,"name":1157,"imageUrl":1158,"description":1159,"currentMorphology":9,"currentStage":188,"position":1160,"attributes":1161},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[23],[1162],"attributes-holy",{"id":1164,"viewCount":57,"searchKey":1165,"visible":14},"10003150",{"type":10,"entryId":1166,"sortOrder":1167,"name":1168,"imageUrl":1169,"description":1170,"currentMorphology":9,"currentStage":188,"position":1171,"attributes":1172},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[23],[1162],[1174,1182,1187,1190,1195,1200,1205,1210,1215,1220,1225,1229,1234,1238,1243,1248,1253,1258,1263],{"id":1175,"parentId":1176,"tagType":1177,"tagKey":1178,"name":1179,"language":1180,"sort":1181},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1183,"parentId":1176,"tagType":1177,"tagKey":1184,"name":1185,"language":1180,"sort":1186},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1188,"parentId":1176,"tagType":1177,"tagKey":9,"name":1189,"language":1180,"sort":28},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1191,"parentId":1176,"tagType":1177,"tagKey":1192,"name":1193,"language":1180,"sort":1194},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1196,"parentId":1176,"tagType":1177,"tagKey":1197,"name":1198,"language":1180,"sort":1199},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1201,"parentId":1176,"tagType":1177,"tagKey":1202,"name":1203,"language":1180,"sort":1204},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1206,"parentId":1176,"tagType":1177,"tagKey":1207,"name":1208,"language":1180,"sort":1209},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1211,"parentId":1176,"tagType":1177,"tagKey":1212,"name":1213,"language":1180,"sort":1214},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1216,"parentId":1176,"tagType":1177,"tagKey":1217,"name":1218,"language":1180,"sort":1219},"3c233890d20868e097e9cea7821aad8e","Umbrabow Form","옵시디언 형태",4,{"id":1221,"parentId":1176,"tagType":1177,"tagKey":1222,"name":1223,"language":1180,"sort":1224},"532c88e1ad2265245d2a450fe9e5629f","Highland Form","고지 형태",9,{"id":1226,"parentId":1176,"tagType":1177,"tagKey":1227,"name":1228,"language":1180,"sort":56},"537f01b8a206e25a37d2ceb6c5325754","Prismana Form","천휘 형태",{"id":1230,"parentId":1176,"tagType":1177,"tagKey":1231,"name":1232,"language":1180,"sort":1233},"6348a343642770f35403dea19746668c","Sea of Flowers Form","꽃바다 형태",10,{"id":1235,"parentId":1176,"tagType":1177,"tagKey":1236,"name":1237,"language":1180,"sort":120},"7ea85e648dc7b02bb3fb4a7758faf69b","Rainstorm Form","우천 형태",{"id":1239,"parentId":1176,"tagType":1177,"tagKey":1240,"name":1241,"language":1180,"sort":1242},"8c5ed9c90ca3d54060ed14e67377089f","Nighttime Form","밤 형태",12,{"id":1244,"parentId":1176,"tagType":1177,"tagKey":1245,"name":1246,"language":1180,"sort":1247},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1249,"parentId":1176,"tagType":1177,"tagKey":1250,"name":1251,"language":1180,"sort":1252},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1254,"parentId":1176,"tagType":1177,"tagKey":1255,"name":1256,"language":1180,"sort":1257},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1259,"parentId":1176,"tagType":1177,"tagKey":1260,"name":1261,"language":1180,"sort":1262},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1264,"parentId":1176,"tagType":1177,"tagKey":1265,"name":1266,"language":1180,"sort":1267},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]