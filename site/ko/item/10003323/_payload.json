1226,"tagType":1227,"tagKey":1288,"name":1289,"language":1230,"sort":1290},"8c5ed9c90ca3d54060ed14e67377089f","Nighttime Form","밤 형태",12,{"id":1292,"parentId":1226,"tagType":1227,"tagKey":1293,"name":1294,"language":1230,"sort":1295},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1297,"parentId":1226,"tagType":1227,"tagKey":1298,"name":1299,"language":1230,"sort":1300},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1302,"parentId":1226,"tagType":1227,"tagKey":1303,"name":1304,"language":1230,"sort":1305},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1307,"parentId":1226,"tagType":1227,"tagKey":1308,"name":1309,"language":1230,"sort":1310},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1312,"parentId":1226,"tagType":1227,"tagKey":1313,"name":1314,"language":1230,"sort":1315},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]