sort":1234},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1236,"parentId":1163,"tagType":1164,"tagKey":1237,"name":1238,"language":1167,"sort":1239},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1241,"parentId":1163,"tagType":1164,"tagKey":1242,"name":1243,"language":1167,"sort":1244},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1246,"parentId":1163,"tagType":1164,"tagKey":1247,"name":1248,"language":1167,"sort":1249},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1251,"parentId":1163,"tagType":1164,"tagKey":1252,"name":1253,"language":1167,"sort":1254},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]