icon":214,"iconStyle":65,"iconTitle":47,"descTitle":215,"descContent":216,"source":217},"91268327_38","/cdn/init/1017100_Skill_16200000_Icon.png","공격","무력화 시 물 원소 능력을 사용하여 근거리 대상을 공격합니다.",{"attributes":218,"type":219,"consume":220,"power":221},[190],[22],"0","6",[223,224],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},[226,238,249,259,270,280,290,302,312,322,332,343,353,364,374,385,396,406,416,426,436,446,456,467,477,487,497,507,517,527,537,547,557,567,577,587,597,608,618,628,638,648,658,668,678,688,698,708,717,721,730,739,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,908,918,928,938,948,958,968,978,988,998,1008,1018,1028,1038,1048,1058,1068,1078,1088,1098,1108,1118,1128,1138,1148,1159],{"id":227,"viewCount":59,"searchKey":228,"visible":15},"10003217",{"type":10,"entryId":229,"sortOrder":230,"name":231,"imageUrl":232,"description":233,"currentMorphology":21,"currentStage":22,"position":234,"attributes":236},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[235],"position-dps",[237],"attributes-fire",{"id":239,"viewCount":59,"searchKey":240,"visible":15},"10003309",{"type":10,"entryId":241,"sortOrder":242,"name":243,"imageUrl":244,"description":245,"currentMorphology":21,"currentStage":246,"position":247,"attributes":248},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[235],[237],{"id":250,"viewCount":59,"searchKey":251,"visible":15},"10003210",{"type":10,"entryId":252,"sortOrder":253,"name":254,"imageUrl":255,"description":256,"currentMorphology":21,"currentStage":190,"position":257,"attributes":258},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[235],[237],{"id":260,"viewCount":59,"searchKey":261,"visible":15},"10003203",{"type":10,"entryId":262,"sortOrder":263,"name":264,"imageUrl":265,"description":266,"currentMorphology":21,"currentStage":190,"position":267,"attributes":268},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[24],[237,269],"attributes-dark",{"id":271,"viewCount":59,"searchKey":272,"visible":15},"10003353",{"type":10,"entryId":273,"sortOrder":274,"name":275,"imageUrl":276,"description":277,"currentMorphology":21,"currentStage":22,"position":278,"attributes":279},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[235],[269],{"id":281,"viewCount":59,"searchKey":282,"visible":15},"10003192",{"type":10,"entryId":283,"sortOrder":284,"name":285,"imageUrl":286,"description":287,"currentMorphology":21,"currentStage":190,"position":288,"attributes":289},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[235],[269],{"id":291,"viewCount":59,"searchKey":292,"visible":15},"10003263",{"type":10,"entryId":293,"sortOrder":294,"name":295,"imageUrl":296,"description":297,"currentMorphology":21,"currentStage":22,"position":298,"attributes":300},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[299],"position-sup",[301],"attributes-wind",{"id":303,"viewCount":59,"searchKey":304,"visible":15},"10003323",{"type":10,"entryId":305,"sortOrder":306,"name":307,"imageUrl":308,"description":309,"currentMorphology":21,"currentStage":190,"position":310,"attributes":311},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[299],[301],{"id":313,"viewCount":59,"searchKey":314,"visible":15},"10003249",{"type":10,"entryId":315,"sortOrder":316,"name":317,"imageUrl":318,"description":319,"currentMorphology":21,"currentStage":190,"position":320,"attributes":321},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[235],[301],{"id":323,"viewCount":59,"searchKey":324,"visible":15},"10003242",{"type":10,"entryId":325,"sortOrder":326,"name":327,"imageUrl":328,"description":329,"currentMorphology":21,"currentStage":190,"position":330,"attributes":331},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[24],[301],{"id":333,"viewCount":59,"searchKey":334,"visible":15},"10003167",{"type":10,"entryId":335,"sortOrder":336,"name":337,"imageUrl":338,"description":339,"currentMorphology":21,"currentStage":22,"position":340,"attributes":341},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[235],[342],"attributes-grass",{"id":344,"viewCount":59,"searchKey":345,"visible":15},"10003285",{"type":10,"entryId":346,"sortOrder":347,"name":348,"imageUrl":349,"description":350,"currentMorphology":21,"currentStage":190,"position":351,"attributes":352},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[235],[342],{"id":354,"viewCount":59,"searchKey":355,"visible":15},"10003252",{"type":10,"entryId":356,"sortOrder":357,"name":358,"imageUrl":359,"description":360,"currentMorphology":21,"currentStage":22,"position":361,"attributes":363},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[362],"position-heal",[26],{"id":365,"viewCount":59,"searchKey":366,"visible":15},"10003344",{"type":10,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":21,"currentStage":246,"position":372,"attributes":373},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[362],[26],{"id":375,"viewCount":59,"searchKey":376,"visible":15},"10003245",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":21,"currentStage":190,"position":382,"attributes":383},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[362],[26,384],"attributes-ice",{"id":386,"viewCount":59,"searchKey":387,"visible":15},"10003238",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":21,"currentStage":190,"position":393,"attributes":395},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[394],"position-energy",[342,26],{"id":397,"viewCount":59,"searchKey":398,"visible":15},"10003243",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":21,"currentStage":22,"position":404,"attributes":405},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[299],[301],{"id":407,"viewCount":59,"searchKey":408,"visible":15},"10003140",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":21,"currentStage":190,"position":414,"attributes":415},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[299],[301],{"id":417,"viewCount":59,"searchKey":418,"visible":15},"10003236",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":21,"currentStage":190,"position":424,"attributes":425},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[299],[269],{"id":427,"viewCount":59,"searchKey":428,"visible":15},"10003196",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":21,"currentStage":22,"position":434,"attributes":435},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[24],[342],{"id":437,"viewCount":59,"searchKey":438,"visible":15},"10003189",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":21,"currentStage":190,"position":444,"attributes":445},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[394],[269,342],{"id":447,"viewCount":59,"searchKey":448,"visible":15},"10003179",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":21,"currentStage":190,"position":454,"attributes":455},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[24],[342],{"id":457,"viewCount":59,"searchKey":458,"visible":15},"10003342",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":21,"currentStage":22,"position":464,"attributes":465},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[24],[466,342],"attributes-rock",{"id":468,"viewCount":59,"searchKey":469,"visible":15},"10003237",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":21,"currentStage":190,"position":475,"attributes":476},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[24],[466,342],{"id":478,"viewCount":59,"searchKey":479,"visible":15},"10003326",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":21,"currentStage":190,"position":485,"attributes":486},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[24],[384],{"id":488,"viewCount":59,"searchKey":489,"visible":15},"10003184",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":21,"currentStage":22,"position":495,"attributes":496},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[394],[237],{"id":498,"viewCount":59,"searchKey":499,"visible":15},"10003282",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":21,"currentStage":190,"position":505,"attributes":506},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[394],[237],{"id":508,"viewCount":59,"searchKey":509,"visible":15},"10003317",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":21,"currentStage":22,"position":515,"attributes":516},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[362],[301],{"id":518,"viewCount":59,"searchKey":519,"visible":15},"10003215",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":21,"currentStage":190,"position":525,"attributes":526},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[362],[301],{"id":528,"viewCount":59,"searchKey":529,"visible":15},"10003338",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":21,"currentStage":220,"position":535,"attributes":536},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[394],[301,342],{"id":538,"viewCount":59,"searchKey":539,"visible":15},"10003143",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":21,"currentStage":22,"position":545,"attributes":546},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[299],[301],{"id":548,"viewCount":59,"searchKey":549,"visible":15},"10003138",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":21,"currentStage":190,"position":555,"attributes":556},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[299],[301],{"id":558,"viewCount":59,"searchKey":559,"visible":15},"10003290",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":21,"currentStage":22,"position":565,"attributes":566},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[235],[342],{"id":568,"viewCount":59,"searchKey":569,"visible":15},"10003271",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":21,"currentStage":190,"position":575,"attributes":576},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[235],[342],{"id":578,"viewCount":59,"searchKey":579,"visible":15},"10003153",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":21,"currentStage":190,"position":585,"attributes":586},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[299],[342],{"id":588,"viewCount":59,"searchKey":589,"visible":15},"10003231",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":21,"currentStage":22,"position":595,"attributes":596},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[24],[342],{"id":598,"viewCount":59,"searchKey":599,"visible":15},"10003149",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":21,"currentStage":190,"position":605,"attributes":606},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[299],[607],"attributes-electric",{"id":609,"viewCount":59,"searchKey":610,"visible":15},"10003218",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":21,"currentStage":190,"position":616,"attributes":617},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[24],[342],{"id":619,"viewCount":59,"searchKey":620,"visible":15},"10003278",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":21,"currentStage":22,"position":626,"attributes":627},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[299],[269],{"id":629,"viewCount":59,"searchKey":630,"visible":15},"10003296",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":21,"currentStage":190,"position":636,"attributes":637},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[299],[269],{"id":639,"viewCount":59,"searchKey":640,"visible":15},"10003283",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":21,"currentStage":22,"position":646,"attributes":647},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[235],[269],{"id":649,"viewCount":59,"searchKey":650,"visible":15},"10003144",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":21,"currentStage":190,"position":656,"attributes":657},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[235],[269],{"id":659,"viewCount":59,"searchKey":660,"visible":15},"10003276",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":21,"currentStage":190,"position":666,"attributes":667},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[235],[607],{"id":669,"viewCount":59,"searchKey":670,"visible":15},"10003197",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":21,"currentStage":22,"position":676,"attributes":677},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[235],[384],{"id":679,"viewCount":59,"searchKey":680,"visible":15},"10003350",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":21,"currentStage":246,"position":686,"attributes":687},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[235],[384],{"id":689,"viewCount":59,"searchKey":690,"visible":15},"10003190",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":21,"currentStage":190,"position":696,"attributes":697},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[235],[384],{"id":699,"viewCount":59,"searchKey":700,"visible":15},"10003299",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":21,"currentStage":22,"position":706,"attributes":707},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[24],[607],{"id":709,"viewCount":59,"searchKey":710,"visible":15},"10003250",{"type":10,"entryId":8,"sortOrder":711,"name":712,"imageUrl":713,"description":714,"currentMorphology":21,"currentStage":190,"position":715,"attributes":716},1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[24],[607],{"id":4,"viewCount":59,"searchKey":718,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":719,"attributes":720},[24],[26],{"id":722,"viewCount":59,"searchKey":723,"visible":15},"10003173",{"type":10,"entryId":724,"sortOrder":725,"name":81,"imageUrl":726,"description":727,"currentMorphology":21,"currentStage":246,"position":728,"attributes":729},"051",1017200,"/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[24],[26],{"id":731,"viewCount":59,"searchKey":732,"visible":15},"10003291",{"type":10,"entryId":733,"sortOrder":734,"name":97,"imageUrl":735,"description":736,"currentMorphology":21,"currentStage":190,"position":737,"attributes":738},"052",1017300,"/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[299],[26],{"id":740,"viewCount":59,"searchKey":741,"visible":15},"10003341",{"type":10,"entryId":742,"sortOrder":743,"name":89,"imageUrl":744,"description":745,"currentMorphology":21,"currentStage":190,"position":746,"attributes":747},"053",1017400,"/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[24],[26],{"id":749,"viewCount":59,"searchKey":750,"visible":15},"10003228",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":21,"currentStage":22,"position":756,"attributes":757},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[235],[26],{"id":759,"viewCount":59,"searchKey":760,"visible":15},"10003352",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":21,"currentStage":246,"position":766,"attributes":767},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[235],[26],{"id":769,"viewCount":59,"searchKey":770,"visible":15},"10003345",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":21,"currentStage":190,"position":776,"attributes":777},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[235],[26],{"id":779,"viewCount":59,"searchKey":780,"visible":15},"10003340",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":21,"currentStage":22,"position":786,"attributes":787},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[235],[466],{"id":789,"viewCount":59,"searchKey":790,"visible":15},"10003251",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":21,"currentStage":190,"position":796,"attributes":797},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[235],[466],{"id":799,"viewCount":59,"searchKey":800,"visible":15},"10003241",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":21,"currentStage":190,"position":806,"attributes":807},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[299],[466],{"id":809,"viewCount":59,"searchKey":810,"visible":15},"10003154",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":21,"currentStage":22,"position":816,"attributes":817},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[235],[607],{"id":819,"viewCount":59,"searchKey":820,"visible":15},"10003151",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":21,"currentStage":190,"position":826,"attributes":827},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[235],[607],{"id":829,"viewCount":59,"searchKey":830,"visible":15},"10003318",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":21,"currentStage":22,"position":836,"attributes":837},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[24],[269],{"id":839,"viewCount":59,"searchKey":840,"visible":15},"10003332",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":21,"currentStage":190,"position":846,"attributes":847},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[235],[269],{"id":849,"viewCount":59,"searchKey":850,"visible":15},"10003297",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":21,"currentStage":190,"position":856,"attributes":857},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[24],[269],{"id":859,"viewCount":59,"searchKey":860,"visible":15},"10003354",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":21,"currentStage":22,"position":866,"attributes":867},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[24],[301],{"id":869,"viewCount":59,"searchKey":870,"visible":15},"10003164",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":21,"currentStage":246,"position":876,"attributes":877},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[24],[301],{"id":879,"viewCount":59,"searchKey":880,"visible":15},"10003311",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":21,"currentStage":190,"position":886,"attributes":887},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[24],[301],{"id":889,"viewCount":59,"searchKey":890,"visible":15},"10003304",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":21,"currentStage":190,"position":896,"attributes":897},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[235],[237],{"id":899,"viewCount":59,"searchKey":900,"visible":15},"10003208",{"type":10,"entryId":901,"sortOrder":902,"name":903,"imageUrl":904,"description":905,"currentMorphology":21,"currentStage":22,"position":906,"attributes":907},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[235],[466],{"id":909,"viewCount":59,"searchKey":910,"visible":15},"10003202",{"type":10,"entryId":911,"sortOrder":912,"name":913,"imageUrl":914,"description":915,"currentMorphology":21,"currentStage":190,"position":916,"attributes":917},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[235],[466],{"id":919,"viewCount":59,"searchKey":920,"visible":15},"10003180",{"type":10,"entryId":921,"sortOrder":922,"name":923,"imageUrl":924,"description":925,"currentMorphology":21,"currentStage":22,"position":926,"attributes":927},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[24],[466],{"id":929,"viewCount":59,"searchKey":930,"visible":15},"10003300",{"type":10,"entryId":931,"sortOrder":932,"name":933,"imageUrl":934,"description":935,"currentMorphology":21,"currentStage":246,"position":936,"attributes":937},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[24],[237,466],{"id":939,"viewCount":59,"searchKey":940,"visible":15},"10003174",{"type":10,"entryId":941,"sortOrder":942,"name":943,"imageUrl":944,"description":945,"currentMorphology":21,"currentStage":190,"position":946,"attributes":947},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[24],[237,466],{"id":949,"viewCount":59,"searchKey":950,"visible":15},"10003293",{"type":10,"entryId":951,"sortOrder":952,"name":953,"imageUrl":954,"description":955,"currentMorphology":21,"currentStage":246,"position":956,"attributes":957},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[24],[466],{"id":959,"viewCount":59,"searchKey":960,"visible":15},"10003168",{"type":10,"entryId":961,"sortOrder":962,"name":963,"imageUrl":964,"description":965,"currentMorphology":21,"currentStage":190,"position":966,"attributes":967},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[24],[466],{"id":969,"viewCount":59,"searchKey":970,"visible":15},"10003161",{"type":10,"entryId":971,"sortOrder":972,"name":973,"imageUrl":974,"description":975,"currentMorphology":21,"currentStage":22,"position":976,"attributes":977},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[299],[466],{"id":979,"viewCount":59,"searchKey":980,"visible":15},"10003222",{"type":10,"entryId":981,"sortOrder":982,"name":983,"imageUrl":984,"description":985,"currentMorphology":21,"currentStage":190,"position":986,"attributes":987},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[299],[466],{"id":989,"viewCount":59,"searchKey":990,"visible":15},"10003272",{"type":10,"entryId":991,"sortOrder":992,"name":993,"imageUrl":994,"description":995,"currentMorphology":21,"currentStage":22,"position":996,"attributes":997},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[299],[607],{"id":999,"viewCount":59,"searchKey":1000,"visible":15},"10003254",{"type":10,"entryId":1001,"sortOrder":1002,"name":1003,"imageUrl":1004,"description":1005,"currentMorphology":21,"currentStage":246,"position":1006,"attributes":1007},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[299],[607],{"id":1009,"viewCount":59,"searchKey":1010,"visible":15},"10003163",{"type":10,"entryId":1011,"sortOrder":1012,"name":1013,"imageUrl":1014,"description":1015,"currentMorphology":21,"currentStage":190,"position":1016,"attributes":1017},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[299],[607],{"id":1019,"viewCount":59,"searchKey":1020,"visible":15},"10003204",{"type":10,"entryId":1021,"sortOrder":1022,"name":1023,"imageUrl":1024,"description":1025,"currentMorphology":21,"currentStage":22,"position":1026,"attributes":1027},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[394],[26],{"id":1029,"viewCount":59,"searchKey":1030,"visible":15},"10003205",{"type":10,"entryId":1031,"sortOrder":1032,"name":1033,"imageUrl":1034,"description":1035,"currentMorphology":21,"currentStage":190,"position":1036,"attributes":1037},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[394],[26],{"id":1039,"viewCount":59,"searchKey":1040,"visible":15},"10003324",{"type":10,"entryId":1041,"sortOrder":1042,"name":1043,"imageUrl":1044,"description":1045,"currentMorphology":21,"currentStage":220,"position":1046,"attributes":1047},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[394],[607],{"id":1049,"viewCount":59,"searchKey":1050,"visible":15},"10003269",{"type":10,"entryId":1051,"sortOrder":1052,"name":1053,"imageUrl":1054,"description":1055,"currentMorphology":21,"currentStage":22,"position":1056,"attributes":1057},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[394],[466,26],{"id":1059,"viewCount":59,"searchKey":1060,"visible":15},"10003261",{"type":10,"entryId":1061,"sortOrder":1062,"name":1063,"imageUrl":1064,"description":1065,"currentMorphology":21,"currentStage":190,"position":1066,"attributes":1067},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[394],[466,26],{"id":1069,"viewCount":59,"searchKey":1070,"visible":15},"10003305",{"type":10,"entryId":1071,"sortOrder":1072,"name":1073,"imageUrl":1074,"description":1075,"currentMorphology":21,"currentStage":22,"position":1076,"attributes":1077},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[24],[384],{"id":1079,"viewCount":59,"searchKey":1080,"visible":15},"10003232",{"type":10,"entryId":1081,"sortOrder":1082,"name":1083,"imageUrl":1084,"description":1085,"currentMorphology":21,"currentStage":190,"position":1086,"attributes":1087},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[24],[384],{"id":1089,"viewCount":59,"searchKey":1090,"visible":15},"10003198",{"type":10,"entryId":1091,"sortOrder":1092,"name":1093,"imageUrl":1094,"description":1095,"currentMorphology":21,"currentStage":22,"position":1096,"attributes":1097},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[362],[342,26],{"id":1099,"viewCount":59,"searchKey":1100,"visible":15},"10003194",{"type":10,"entryId":1101,"sortOrder":1102,"name":1103,"imageUrl":1104,"description":1105,"currentMorphology":21,"currentStage":190,"position":1106,"attributes":1107},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[362],[342,26],{"id":1109,"viewCount":59,"searchKey":1110,"visible":15},"10003185",{"type":10,"entryId":1111,"sortOrder":1112,"name":1113,"imageUrl":1114,"description":1115,"currentMorphology":21,"currentStage":22,"position":1116,"attributes":1117},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[235],[26],{"id":1119,"viewCount":59,"searchKey":1120,"visible":15},"10003284",{"type":10,"entryId":1121,"sortOrder":1122,"name":1123,"imageUrl":1124,"description":1125,"currentMorphology":21,"currentStage":190,"position":1126,"attributes":1127},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[235],[26],{"id":1129,"viewCount":59,"searchKey":1130,"visible":15},"10003188",{"type":10,"entryId":1131,"sortOrder":1132,"name":1133,"imageUrl":1134,"description":1135,"currentMorphology":21,"currentStage":22,"position":1136,"attributes":1137},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[235],[384],{"id":1139,"viewCount":59,"searchKey":1140,"visible":15},"10003182",{"type":10,"entryId":1141,"sortOrder":1142,"name":1143,"imageUrl":1144,"description":1145,"currentMorphology":21,"currentStage":190,"position":1146,"attributes":1147},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[235],[384],{"id":1149,"viewCount":59,"searchKey":1150,"visible":15},"10003273",{"type":10,"entryId":1151,"sortOrder":1152,"name":1153,"imageUrl":1154,"description":1155,"currentMorphology":21,"currentStage":220,"position":1156,"attributes":1157},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[235],[1158],"attributes-holy",{"id":1160,"viewCount":59,"searchKey":1161,"visible":15},"10003150",{"type":10,"entryId":1162,"sortOrder":1163,"name":1164,"imageUrl":1165,"description":1166,"currentMorphology":21,"currentStage":220,"position":1167,"attributes":1168},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[235],[1158],[1170,1178,1183,1186,1191,1196,1201,1206,1211,1215,1220,1224,1229,1233,1237,1242,1247,1252,1257],{"id":1171,"parentId":1172,"tagType":1173,"tagKey":1174,"name":1175,"language