tagType":1173,"tagKey":13,"name":1235,"language":1176,"sort":1236},"8c5ed9c90ca3d54060ed14e67377089f","밤 형태",12,{"id":1238,"parentId":1172,"tagType":1173,"tagKey":1239,"name":1240,"language":1176,"sort":1241},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1243,"parentId":1172,"tagType":1173,"tagKey":1244,"name":1245,"language":1176,"sort":1246},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1248,"parentId":1172,"tagType":1173,"tagKey":1249,"name":1250,"language":1176,"sort":1251},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1253,"parentId":1172,"tagType":1173,"tagKey":1254,"name":1255,"language":1176,"sort":1256},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1258,"parentId":1172,"tagType":1173,"tagKey":1259,"name":1260,"language":1176,"sort":1261},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]