"fontColor":109,"type":110},"91268171_21","GLIDE","비행 Lv.2",{"attributes":146,"type":147,"consume":46,"power":46},[],[],{"id":149,"type":62,"props":150,"children":153},"91268171_22",{"title":151,"type":99,"id":152,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"탐사 스킬","91268171_23",[154],{"id":155,"type":140,"props":156,"children":59},"91268171_24",{"id":157,"customKey":46,"icon":158,"iconStyle":99,"iconTitle":46,"descTitle":159,"descContent":160,"source":161},"91268171_25","/cdn/init/1003200_Skill_9400062_Icon.png","은신","은신 상태에 진입합니다.",{"attributes":162,"type":163,"consume":46,"power":46},[],[],{"id":165,"type":62,"props":166,"children":169},"91268171_26",{"title":167,"type":65,"id":168,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"애니모 특성","91268171_27",[170],{"id":171,"type":140,"props":172,"children":59},"91268171_28",{"id":173,"customKey":46,"icon":174,"iconStyle":65,"iconTitle":46,"descTitle":175,"descContent":176,"source":177},"91268171_29","/cdn/init/1003200_Feature_10372_Icon.png","광열의 전의","목표를 처치하면 전의를 1중첩 획득하고 피해가 25% 증가합니다. 20초 동안 지속되며, 최대 2중첩됩니다.",{"attributes":178,"type":179,"consume":46,"power":46},[],[],{"id":181,"type":62,"props":182,"children":59},"91268171_30",{"title":183,"type":65,"id":184,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":185},"스킬 소개","91268171_31",[186,249],{"id":187,"title":188,"children":189},"91268171_32","전투 스킬",[190,204,217,227,238],{"id":191,"type":140,"props":192},"91268171_33",{"id":193,"customKey":46,"icon":194,"iconStyle":65,"iconTitle":46,"descTitle":195,"descContent":196,"source":197},"91268171_34","/cdn/init/1003200_Skill_11200011_Icon.png","영혼 베기","순식간에 대상 근처로 이동하여 기습합니다. 대상의 HP가 50% 미만인 경우, HP를 1% 잃을 때마다 피해가 1% 증가합니다. 해당 스킬이 대상을 처치하면 일정 시간 동안 에너지를 소모하지 않고 다시 스킬을 시전합니다.",{"attributes":198,"type":200,"consume":202,"power":203},[199],"12",[201],"1","20","50",{"id":205,"type":140,"props":206},"91268171_35",{"id":207,"customKey":46,"icon":208,"iconStyle":65,"iconTitle":46,"descTitle":209,"descContent":210,"source":211},"91268171_36","/cdn/init/1003200_Skill_10500020_Icon.png","플레임 러시","화염의 힘을 두르고 목표에게 돌진합니다. 스킬 시전 후, 일반 공격 피해가 40% 증가하고, 10초 동안 지속됩니다.",{"attributes":212,"type":214,"consume":215,"power":216},[213],"5",[201],"10","25",{"id":218,"type":140,"props":219},"91268171_37",{"id":220,"customKey":46,"icon":221,"iconStyle":65,"iconTitle":46,"descTitle":222,"descContent":223,"source":224},"91268171_38","/cdn/init/1003200_Skill_11200021_Icon.png","섀도우 러시","그림자의 힘을 두르고 목표에게 돌진합니다. 스킬 시전 후, 일반 공격 피해가 40% 증가하고, 10초 동안 지속됩니다.",{"attributes":225,"type":226,"consume":215,"power":216},[199],[201],{"id":228,"type":140,"props":229},"91268171_39",{"id":230,"customKey":46,"icon":231,"iconStyle":65,"iconTitle":46,"descTitle":232,"descContent":233,"source":234},"91268171_40","/cdn/init/1003200_Skill_11200030_Icon.png","그림자 론도","회전 베기로 주위의 모든 목표에게 어둠 원소 피해를 3회 줍니다. 해당 스킬이 목표를 1회 명중할 때마다 자신의 피해가 8% 증가하고, 최대 32%까지 증가하며, 10초 동안 지속됩니다.",{"attributes":235,"type":236,"consume":202,"power":237},[199],[201],"60",{"id":239,"type":140,"props":240},"91268171_41",{"id":241,"customKey":46,"icon":242,"iconStyle":65,"iconTitle":46,"descTitle":243,"descContent":244,"source":245},"91268171_42","/cdn/init/1003200_Skill_10600513_Icon.png","포레스트 휠","회전 베기로 주위의 모든 목표에게 풀 원소 피해를 3회 줍니다. 해당 스킬이 목표를 1회 명중할 때마다 자신의 피해가 8% 증가하고, 최대 32%까지 증가하며, 10초 동안 지속됩니다.",{"attributes":246,"type":248,"consume":202,"power":237},[247],"6",[201],{"id":250,"title":251,"children":252},"91268171_43","고유 스킬",[253,264],{"id":254,"type":140,"props":255},"91268171_44",{"id":256,"customKey":46,"icon":257,"iconStyle":65,"iconTitle":46,"descTitle":258,"descContent":259,"source":260},"91268171_45","/cdn/init/1003200_Skill_11200000_Icon.png","공격","어둠 원소 능력을 사용하여 근거리에서 목표를 공격합니다.",{"attributes":261,"type":262,"consume":263,"power":247},[199],[201],"0",{"id":265,"type":140,"props":266},"91268171_46",{"id":267,"customKey":46,"icon":268,"iconStyle":65,"iconTitle":46,"descTitle":269,"descContent":270,"source":271},"91268171_47","/cdn/init/1003200_Skill_11200040_Icon.png","섀도우 슬래시","공간을 절단해 대량의 물리 피해를 줍니다.",{"attributes":272,"type":273,"consume":263,"power":274},[199],[201],"170",[276,277,278,281,283],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":279,"entryId":12,"currentMorphology":280,"visible":15},"10003156","Prismana Form",{"id":282,"entryId":12,"currentMorphology":9,"visible":15},"10003158",{"id":284,"entryId":12,"currentMorphology":285,"visible":15},"10003361","Umbrabow Form",[287,298,309,319,330,340,350,362,372,382,392,403,413,425,435,446,457,467,477,487,497,507,517,528,538,548,558,568,578,588,598,608,618,628,638,648,658,669,679,689,699,707,711,720,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1130,1140,1150,1160,1170,1180,1190,1200,1210,1221],{"id":288,"viewCount":59,"searchKey":289,"visible":15},"10003217",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":21,"currentStage":201,"position":295,"attributes":296},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[24],[297],"attributes-fire",{"id":299,"viewCount":59,"searchKey":300,"visible":15},"10003309",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":21,"currentStage":306,"position":307,"attributes":308},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[24],[297],{"id":310,"viewCount":59,"searchKey":311,"visible":15},"10003210",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":21,"currentStage":22,"position":317,"attributes":318},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[24],[297],{"id":320,"viewCount":59,"searchKey":321,"visible":15},"10003203",{"type":10,"entryId":322,"sortOrder":323,"name":324,"imageUrl":325,"description":326,"currentMorphology":21,"currentStage":22,"position":327,"attributes":329},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[328],"position-break",[297,26],{"id":331,"viewCount":59,"searchKey":332,"visible":15},"10003353",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":21,"currentStage":201,"position":338,"attributes":339},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[24],[26],{"id":341,"viewCount":59,"searchKey":342,"visible":15},"10003192",{"type":10,"entryId":343,"sortOrder":344,"name":345,"imageUrl":346,"description":347,"currentMorphology":21,"currentStage":22,"position":348,"attributes":349},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[24],[26],{"id":351,"viewCount":59,"searchKey":352,"visible":15},"10003263",{"type":10,"entryId":353,"sortOrder":354,"name":355,"imageUrl":356,"description":357,"currentMorphology":21,"currentStage":201,"position":358,"attributes":360},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[359],"position-sup",[361],"attributes-wind",{"id":363,"viewCount":59,"searchKey":364,"visible":15},"10003323",{"type":10,"entryId":365,"sortOrder":366,"name":367,"imageUrl":368,"description":369,"currentMorphology":21,"currentStage":22,"position":370,"attributes":371},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[359],[361],{"id":373,"viewCount":59,"searchKey":374,"visible":15},"10003249",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":21,"currentStage":22,"position":380,"attributes":381},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[24],[361],{"id":383,"viewCount":59,"searchKey":384,"visible":15},"10003242",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":21,"currentStage":22,"position":390,"attributes":391},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[328],[361],{"id":393,"viewCount":59,"searchKey":394,"visible":15},"10003167",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":21,"currentStage":201,"position":400,"attributes":401},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[24],[402],"attributes-grass",{"id":404,"viewCount":59,"searchKey":405,"visible":15},"10003285",{"type":10,"entryId":406,"sortOrder":407,"name":408,"imageUrl":409,"description":410,"currentMorphology":21,"currentStage":22,"position":411,"attributes":412},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[24],[402],{"id":414,"viewCount":59,"searchKey":415,"visible":15},"10003252",{"type":10,"entryId":416,"sortOrder":417,"name":418,"imageUrl":419,"description":420,"currentMorphology":21,"currentStage":201,"position":421,"attributes":423},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[422],"position-heal",[424],"attributes-water",{"id":426,"viewCount":59,"searchKey":427,"visible":15},"10003344",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":21,"currentStage":306,"position":433,"attributes":434},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[422],[424],{"id":436,"viewCount":59,"searchKey":437,"visible":15},"10003245",{"type":10,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":21,"currentStage":22,"position":443,"attributes":444},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[422],[424,445],"attributes-ice",{"id":447,"viewCount":59,"searchKey":448,"visible":15},"10003238",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":21,"currentStage":22,"position":454,"attributes":456},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[455],"position-energy",[402,424],{"id":458,"viewCount":59,"searchKey":459,"visible":15},"10003243",{"type":10,"entryId":460,"sortOrder":461,"name":462,"imageUrl":463,"description":464,"currentMorphology":21,"currentStage":201,"position":465,"attributes":466},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[359],[361],{"id":468,"viewCount":59,"searchKey":469,"visible":15},"10003140",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":21,"currentStage":22,"position":475,"attributes":476},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[359],[361],{"id":478,"viewCount":59,"searchKey":479,"visible":15},"10003236",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":21,"currentStage":22,"position":485,"attributes":486},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[359],[26],{"id":488,"viewCount":59,"searchKey":489,"visible":15},"10003196",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":21,"currentStage":201,"position":495,"attributes":496},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[328],[402],{"id":498,"viewCount":59,"searchKey":499,"visible":15},"10003189",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":21,"currentStage":22,"position":505,"attributes":506},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[455],[26,402],{"id":508,"viewCount":59,"searchKey":509,"visible":15},"10003179",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":21,"currentStage":22,"position":515,"attributes":516},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[328],[402],{"id":518,"viewCount":59,"searchKey":519,"visible":15},"10003342",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":21,"currentStage":201,"position":525,"attributes":526},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[328],[527,402],"attributes-rock",{"id":529,"viewCount":59,"searchKey":530,"visible":15},"10003237",{"type":10,"entryId":531,"sortOrder":532,"name":533,"imageUrl":534,"description":535,"currentMorphology":21,"currentStage":22,"position":536,"attributes":537},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[328],[527,402],{"id":539,"viewCount":59,"searchKey":540,"visible":15},"10003326",{"type":10,"entryId":541,"sortOrder":542,"name":543,"imageUrl":544,"description":545,"currentMorphology":21,"currentStage":22,"position":546,"attributes":547},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[328],[445],{"id":549,"viewCount":59,"searchKey":550,"visible":15},"10003184",{"type":10,"entryId":551,"sortOrder":552,"name":553,"imageUrl":554,"description":555,"currentMorphology":21,"currentStage":201,"position":556,"attributes":557},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[455],[297],{"id":559,"viewCount":59,"searchKey":560,"visible":15},"10003282",{"type":10,"entryId":561,"sortOrder":562,"name":563,"imageUrl":564,"description":565,"currentMorphology":21,"currentStage":22,"position":566,"attributes":567},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[455],[297],{"id":569,"viewCount":59,"searchKey":570,"visible":15},"10003317",{"type":10,"entryId":571,"sortOrder":572,"name":573,"imageUrl":574,"description":575,"currentMorphology":21,"currentStage":201,"position":576,"attributes":577},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[422],[361],{"id":579,"viewCount":59,"searchKey":580,"visible":15},"10003215",{"type":10,"entryId":581,"sortOrder":582,"name":583,"imageUrl":584,"description":585,"currentMorphology":21,"currentStage":22,"position":586,"attributes":587},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[422],[361],{"id":589,"viewCount":59,"searchKey":590,"visible":15},"10003338",{"type":10,"entryId":591,"sortOrder":592,"name":593,"imageUrl":594,"description":595,"currentMorphology":21,"currentStage":263,"position":596,"attributes":597},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[455],[361,402],{"id":599,"viewCount":59,"searchKey":600,"visible":15},"10003143",{"type":10,"entryId":601,"sortOrder":602,"name":603,"imageUrl":604,"description":605,"currentMorphology":21,"currentStage":201,"position":606,"attributes":607},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[359],[361],{"id":609,"viewCount":59,"searchKey":610,"visible":15},"10003138",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":21,"currentStage":22,"position":616,"attributes":617},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[359],[361],{"id":619,"viewCount":59,"searchKey":620,"visible":15},"10003290",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":21,"currentStage":201,"position":626,"attributes":627},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[24],[402],{"id":629,"viewCount":59,"searchKey":630,"visible":15},"10003271",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":21,"currentStage":22,"position":636,"attributes":637},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[24],[402],{"id":639,"viewCount":59,"searchKey":640,"visible":15},"10003153",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":21,"currentStage":22,"position":646,"attributes":647},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[359],[402],{"id":649,"viewCount":59,"searchKey":650,"visible":15},"10003231",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":21,"currentStage":201,"position":656,"attributes":657},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[328],[402],{"id":659,"viewCount":59,"searchKey":660,"visible":15},"10003149",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":21,"currentStage":22,"position":666,"attributes":667},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[359],[668],"attributes-electric",{"id":670,"viewCount":59,"searchKey":671,"visible":15},"10003218",{"type":10,"entryId":672,"sortOrder":673,"name":674,"imageUrl":675,"description":676,"currentMorphology":21,"currentStage":22,"position":677,"attributes":678},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[328],[402],{"id":680,"viewCount":59,"searchKey":681,"visible":15},"10003278",{"type":10,"entryId":682,"sortOrder":683,"name":684,"imageUrl":685,"description":686,"currentMorphology":21,"currentStage":201,"position":687,"attributes":688},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[359],[26],{"id":690,"viewCount":59,"searchKey":691,"visible":15},"10003296",{"type":10,"entryId":692,"sortOrder":693,"name":694,"imageUrl":695,"description":696,"currentMorphology":21,"currentStage":22,"position":697,"attributes":698},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[359],[26],{"id":700,"viewCount":59,"searchKey":701,"visible":15},"10003283",{"type":10,"entryId":8,"sortOrder":702,"name":75,"imageUrl":703,"description":704,"currentMorphology":21,"currentStage":201,"position":705,"attributes":706},1003100,"/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[24],[26],{"id":4,"viewCount":59,"searchKey":708,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":709,"attributes":710},[24],[26],{"id":712,"viewCount":59,"searchKey":713,"visible":15},"10003276",{"type":10,"entryId":714,"sortOrder":715,"name":83,"imageUrl":716,"description":717,"currentMorphology":21,"currentStage":22,"position":718,"attributes":719},"044",1003300,"/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[24],[668],{"id":721,"viewCount":59,"searchKey":722,"visible":15},"10003197",{"type":10,"entryId":723,"sortOrder":724,"name":725,"imageUrl":726,"description":727,"currentMorphology":21,"currentStage":201,"position":728,"attributes":729},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[24],[445],{"id":731,"viewCount":59,"searchKey":732,"visible":15},"10003350",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":21,"currentStage":306,"position":738,"attributes":739},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[24],[445],{"id":741,"viewCount":59,"searchKey":742,"visible":15},"10003190",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":21,"currentStage":22,"position":748,"attributes":749},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[24],[445],{"id":751,"viewCount":59,"searchKey":752,"visible":15},"10003299",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":21,"currentStage":201,"position":758,"attributes":759},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[328],[668],{"id":761,"viewCount":59,"searchKey":762,"visible":15},"10003250",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":21,"currentStage":22,"position":768,"attributes":769},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[328],[668],{"id":771,"viewCount":59,"searchKey":772,"visible":15},"10003298",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":21,"currentStage":201,"position":778,"attributes":779},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[328],[424],{"id":781,"viewCount":59,"searchKey":782,"visible":15},"10003173",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":21,"currentStage":306,"position":788,"attributes":789},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[328],[424],{"id":791,"viewCount":59,"searchKey":792,"visible":15},"10003291",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":21,"currentStage":22,"position":798,"attributes":799},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[359],[424],{"id":801,"viewCount":59,"searchKey":802,"visible":15},"10003341",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":21,"currentStage":22,"position":808,"attributes":809},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[328],[424],{"id":811,"viewCount":59,"searchKey":812,"visible":15},"10003228",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":21,"currentStage":201,"position":818,"attributes":819},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[24],[424],{"id":821,"viewCount":59,"searchKey":822,"visible":15},"10003352",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":21,"currentStage":306,"position":828,"attributes":829},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[24],[424],{"id":831,"viewCount":59,"searchKey":832,"visible":15},"10003345",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":21,"currentStage":22,"position":838,"attributes":839},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[24],[424],{"id":841,"viewCount":59,"searchKey":842,"visible":15},"10003340",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":21,"currentStage":201,"position":848,"attributes":849},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[24],[527],{"id":851,"viewCount":59,"searchKey":852,"visible":15},"10003251",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":21,"currentStage":22,"position":858,"attributes":859},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[24],[527],{"id":861,"viewCount":59,"searchKey":862,"visible":15},"10003241",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":21,"currentStage":22,"position":868,"attributes":869},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[359],[527],{"id":871,"viewCount":59,"searchKey":872,"visible":15},"10003154",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":21,"currentStage":201,"position":878,"attributes":879},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[24],[668],{"id":881,"viewCount":59,"searchKey":882,"visible":15},"10003151",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":21,"currentStage":22,"position":888,"attributes":889},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[24],[668],{"id":891,"viewCount":59,"searchKey":892,"visible":15},"10003318",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":21,"currentStage":201,"position":898,"attributes":899},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[328],[26],{"id":901,"viewCount":59,"searchKey":902,"visible":15},"10003332",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":21,"currentStage":22,"position":908,"attributes":909},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[24],[26],{"id":911,"viewCount":59,"searchKey":912,"visible":15},"10003297",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":21,"currentStage":22,"position":918,"attributes":919},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[328],[26],{"id":921,"viewCount":59,"searchKey":922,"visible":15},"10003354",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":21,"currentStage":201,"position":928,"attributes":929},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[328],[361],{"id":931,"viewCount":59,"searchKey":932,"visible":15},"10003164",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":21,"currentStage":306,"position":938,"attributes":939},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[328],[361],{"id":941,"viewCount":59,"searchKey":942,"visible":15},"10003311",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":21,"currentStage":22,"position":948,"attributes":949},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[328],[361],{"id":951,"viewCount":59,"searchKey":952,"visible":15},"10003304",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":21,"currentStage":22,"position":958,"attributes":959},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[24],[297],{"id":961,"viewCount":59,"searchKey":962,"visible":15},"10003208",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":21,"currentStage":201,"position":968,"attributes":969},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[24],[527],{"id":971,"viewCount":59,"searchKey":972,"visible":15},"10003202",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":21,"currentStage":22,"position":978,"attributes":979},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[24],[527],{"id":981,"viewCount":59,"searchKey":982,"visible":15},"10003180",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":21,"currentStage":201,"position":988,"attributes":989},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[328],[527],{"id":991,"viewCount":59,"searchKey":992,"visible":15},"10003300",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":21,"currentStage":306,"position":998,"attributes":999},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[328],[297,527],{"id":1001,"viewCount":59,"searchKey":1002,"visible":15},"10003174",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":21,"currentStage":22,"position":1008,"attributes":1009},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[328],[297,527],{"id":1011,"viewCount":59,"searchKey":1012,"visible":15},"10003293",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":21,"currentStage":306,"position":1018,"attributes":1019},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[328],[527],{"id":1021,"viewCount":59,"searchKey":1022,"visible":15},"10003168",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":21,"currentStage":22,"position":1028,"attributes":1029},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[328],[527],{"id":1031,"viewCount":59,"searchKey":1032,"visible":15},"10003161",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":21,"currentStage":201,"position":1038,"attributes":1039},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[359],[527],{"id":1041,"viewCount":59,"searchKey":1042,"visible":15},"10003222",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":21,"currentStage":22,"position":1048,"attributes":1049},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[359],[527],{"id":1051,"viewCount":59,"searchKey":1052,"visible":15},"10003272",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":21,"currentStage":201,"position":1058,"attributes":1059},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[359],[668],{"id":1061,"viewCount":59,"searchKey":1062,"visible":15},"10003254",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":21,"currentStage":306,"position":1068,"attributes":1069},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[359],[668],{"id":1071,"viewCount":59,"searchKey":1072,"visible":15},"10003163",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":21,"currentStage":22,"position":1078,"attributes":1079},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[359],[668],{"id":1081,"viewCount":59,"searchKey":1082,"visible":15},"10003204",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":21,"currentStage":201,"position":1088,"attributes":1089},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[455],[424],{"id":1091,"viewCount":59,"searchKey":1092,"visible":15},"10003205",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":21,"currentStage":22,"position":1098,"attributes":1099},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[455],[424],{"id":1101,"viewCount":59,"searchKey":1102,"visible":15},"10003324",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":21,"currentStage":263,"position":1108,"attributes":1109},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[455],[668],{"id":1111,"viewCount":59,"searchKey":1112,"visible":15},"10003269",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":21,"currentStage":201,"position":1118,"attributes":1119},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[455],[527,424],{"id":1121,"viewCount":59,"searchKey":1122,"visible":15},"10003261",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":21,"currentStage":22,"position":1128,"attributes":1129},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[455],[527,424],{"id":1131,"viewCount":59,"searchKey":1132,"visible":15},"10003305",{"type":10,"entryId":1133,"sortOrder":1134,"name":1135,"imageUrl":1136,"description":1137,"currentMorphology":21,"currentStage":201,"position":1138,"attributes":1139},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[328],[445],{"id":1141,"viewCount":59,"searchKey":1142,"visible":15},"10003232",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":21,"currentStage":22,"position":1148,"attributes":1149},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[328],[445],{"id":1151,"viewCount":59,"searchKey":1152,"visible":15},"10003198",{"type":10,"entryId":1153,"sortOrder":1154,"name":1155,"imageUrl":1156,"description":1157,"currentMorphology":21,"currentStage":201,"position":1158,"attributes":1159},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[422],[402,424],{"id":1161,"viewCount":59,"searchKey":1162,"visible":15},"10003194",{"type":10,"entryId":1163,"sortOrder":1164,"name":1165,"imageUrl":1166,"description":1167,"currentMorphology":21,"currentStage":22,"position":1168,"attributes":1169},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[422],[402,424],{"id":1171,"viewCount":59,"searchKey":1172,"visible":15},"10003185",{"type":10,"entryId":1173,"sortOrder":1174,"name":1175,"imageUrl":1176,"description":1177,"currentMorphology":21,"currentStage":201,"position":1178,"attributes":1179},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[24],[424],{"id":1181,"viewCount":59,"searchKey":1182,"visible":15},"10003284",{"type":10,"entryId":1183,"sortOrder":1184,"name":1185,"imageUrl":1186,"description":1187,"currentMorphology":21,"currentStage":22,"position":1188,"attributes":1189},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[24],[424],{"id":1191,"viewCount":59,"searchKey":1192,"visible":15},"10003188",{"type":10,"entryId":1193,"sortOrder":1194,"name":1195,"imageUrl":1196,"description":1197,"currentMorphology":21,"currentStage":201,"position":1198,"attributes":1199},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[24],[445],{"id":1201,"viewCount":59,"searchKey":1202,"visible":15},"10003182",{"type":10,"entryId":1203,"sortOrder":1204,"name":1205,"imageUrl":1206,"description":1207,"currentMorphology":21,"currentStage":22,"position":1208,"attributes":1209},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[24],[445],{"id":1211,"viewCount":59,"searchKey":1212,"visible":15},"10003273",{"type":10,"entryId":1213,"sortOrder":1214,"name":1215,"imageUrl":1216,"description":1217,"currentMorphology":21,"currentStage":263,"position":1218,"attributes":1219},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[24],[1220],"attributes-holy",{"id":1222,"viewCount":59,"searchKey":1223,"visible":15},"10003150",{"type":10,"entryId":1224,"sortOrder":1225,"name":1226,"imageUrl":1227,"description":1228,"currentMorphology":21,"currentStage":263,"position":1229,"attributes":1230},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[24],[1220],[1232,1240,1244,1247,1252,1257,1262,1267,1272,1276,1280,1283,1288,1292,1297,1302,1307,1312,1317],{"id":1233,"parentId":1234,"tagType":1235,"tagKey":1236,"name":1237,"language":1238,"sort":1239},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1241,"parentId":1234,"tagType":1235,"tagKey":13,"name":1242,"language":1238,"sort":1243},"089cb4ebad45a4d969062ffaabafd5cf","숲 형태",8,{"id":1245,"parentId":1234,"tagType":1235,"tagKey":21,"name":1246,"language":1238,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1248,"parentId":1234,"tagType":1235,"tagKey":1249,"name":1250,"language":1238,"sort":1251},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1253,"parentId":1234,"tagType":1235,"tagKey":1254,"name":1255,"language":1238,"sort":1256},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1258,"parentId":1234,"tagType":1235,"tagKey":1259,"name":1260,"language":1238,"sort":1261},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1263,"parentId":1234,"tagType":1235,"tagKey":1264,"name":1265,"language":1238,"sort":1266},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1268,"parentId":1234,"tagType":1235,"tagKey":1269,"name":1270,"language":1238,"sort":1271},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1273,"parentId":1234,"tagType":1235,"tagKey":285,"name":1274,"language":1238,"sort":1275},"3c233890d20868e097e9cea7821aad8e","옵시디언 형태",4,{"id":1277,"parentId":1234,"tagType":1235,"tagKey":9,"name":1278,"language":1238,"sort":1279},"532c88e1ad2265245d2a450fe9e5629f","고지 형태",9,{"id":1281,"parentId":1234,"tagType":1235,"tagKey":280,"name":1282,"language":1238,"sort":58},"537f01b8a206e25a37d2ceb6c5325754","천휘 형태",{"id":1284,"parentId":1234,"tagType":1235,"tagKey":1285,"name":1286,"language":1238,"sort":1287},"6348a343642770f35403dea19746668c","Sea of Flowers Form","꽃바다 형태",10,{"id":1289,"parentId":1234,"tagType":1235,"tagKey":1290,"name":1291,"language":1238,"sort":129},"7ea85e648dc7b02bb3fb4a7758faf69b","Rainstorm Form","우천 형태",{"id":1293,"parentId":1234,"tagType":1235,"tagKey":1294,"name":1295,"language":1238,"sort":1296},"8c5ed9c90ca3d54060ed14e67377089f","Nighttime Form","밤 형태",12,{"id":1298,"parentId":1234,"tagType":1235,"tagKey":1299,"name":1300,"language":1238,"sort":1301},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1303,"parentId":1234,"tagType":1235,"tagKey":1304,"name":1305,"language":1238,"sort":1306},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1308,"parentId":1234,"tagType":1235,"tagKey":1309,"name":1310,"language":1238,"sort":1311},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1313,"parentId":1234,"tagType":1235,"tagKey":1314,"name":1315,"language":1238,"sort":1316},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1318,"parentId":1234,"tagType":1235,"tagKey":1319,"name":1320,"language":1238,"sort":1321},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]