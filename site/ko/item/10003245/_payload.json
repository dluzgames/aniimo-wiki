,"tagType":1213,"tagKey":1288,"name":1289,"language":1215,"sort":1290},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1292,"parentId":1212,"tagType":1213,"tagKey":1293,"name":1294,"language":1215,"sort":1295},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1297,"parentId":1212,"tagType":1213,"tagKey":1298,"name":1299,"language":1215,"sort":1300},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]