[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"aniimo-detail-10003154-ko":3,"header-aniimo-list-ko":224,"morphology-tags-ko":1168},{"id":4,"previousId":5,"nextId":6,"previousAnchor":7,"nextAnchor":11,"viewCount":14,"visible":15,"searchKey":16,"directories":27,"morphologyList":222},"10003154","10003199","10003151",{"entryId":8,"currentMorphology":9,"type":10},"059","Snowfield Form","ANIIMO",{"entryId":12,"currentMorphology":13,"type":10},"061","Basic Form",575,true,{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":23,"attributes":25},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.","1",[24],"position-dps",[26],"attributes-electric",[28,120],{"id":29,"title":30,"components":31},1,"기본 정보",[32,59,87,103],{"id":33,"type":34,"props":35,"children":58},"91268181_0","aniimoInfo",{"id":36,"formData":37},"91268181_1",{"name":19,"sortOrder":29,"serialNumber":17,"heightMin":38,"heightMax":38,"weightMin":39,"weightMax":40,"attributes":41,"position":42,"gender":43,"desc":21,"maleImage":20,"femaleImage":20,"noGenderImage":20,"illustrationImage":46,"backgroundImage":47,"attributeValue":48,"hp":49,"magicAttack":50,"physicalAttack":51,"magicDefense":52,"haste":53,"physicalDefense":52,"displayNames":54,"currentMorphology":13,"currentStage":29,"femaleIllustrationImage":47,"maleIllustrationImage":47},0,23.4,34.93,[26],[24],[44,45],"male","female","/cdn/Vfx/1029100.mp4","",429,85,41,106,60,77,{"maleImage":55,"femaleImage":56,"illustrationImage":57,"backgroundImage":47,"noGenderImage":47},"Stellarys.png","Scorchhowl.png","evolutionarySpirit.png",null,{"id":60,"type":61,"props":62,"children":67},"91268181_2","crumbTitle",{"title":63,"type":64,"id":65,"isUse":15,"isEdit":15,"useTabs":66,"blackHeader":66},"진화 루트","big","91268181_3",false,[68],{"id":69,"type":70,"props":71,"children":58},"91268181_4","evolution",{"data":