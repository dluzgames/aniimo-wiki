44,"isUse":15,"isEdit":15,"useTabs":66,"blackHeader":66},"탐사 스킬","91268181_22",[146],{"id":147,"type":132,"props":148,"children":58},"91268181_23",{"id":149,"customKey":47,"icon":150,"iconStyle":91,"iconTitle":47,"descTitle":151,"descContent":152,"source":153},"91268181_24","/cdn/init/1029100_Skill_9400136_Icon.png","돌격","일정 거리를 빠르게 전진합니다.",{"attributes":154,"type":155,"consume":47,"power":47},[],[],{"id":157,"type":61,"props":158,"children":161},"91268181_25",{"title":159,"type":64,"id":160,"isUse":15,"isEdit":15,"useTabs":66,"blackHeader":66},"애니모 특성","91268181_26",[162],{"id":163,"type":132,"props":164,"children":58},"91268181_27",{"id":165,"customKey":47,"icon":166,"iconStyle":64,"iconTitle":47,"descTitle":167,"descContent":168,"source":169},"91268181_28","/cdn/init/1029100_Feature_12932_Icon.png","번개의 계약","공격이 목표를 명중하면 1중첩 [번개의 계약]을 획득합니다. 30중첩에 도달하면 다음 스킬과 궁극기 스킬 시전 시 [썬더윙 자세]로 전환되며 10초 동안 지속됩니다.",{"attributes":170,"type":171,"consume":47,"power":47},[],[],{"id":173,"type":61,"props":174,"children":58},"91268181_29",{"title":175,"type":64,"id":176,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":66,"tabs":177},"스킬 소개","91268181_30",[178,206],{"id":179,"title":180,"children":181},"91268181_31","전투 스킬",[182,195],{"id":183,"type":132,"props":184},"91268181_32",{"id":185,"customKey":47,"icon":186,"iconStyle":64,"iconTitle":47,"descTitle":187,"descContent":188,"source":189},"91268181_33","/cdn/init/1029100_Skill_10400360_Icon.png","전자기장","대상을 중심으로 전자기장을 시전하고 계속 추적합니다. 전자기장 안의 대상이 전기 공격을 받으면 전기 원소 공격 1회가 추가 시전되고, 대상에게 [전기 원소 상태 이상]을 부여합니다. 전자기장은 8초 동안 지속됩니다.",{"attributes":190,"type":192,"consume":194,"power":22},[191],"4",[193],"2","20",{"id":196,"type":132,"props":197},"91268181_34",{"id":198,"customKey":47,"icon":199,"iconStyle":64,"iconTitle":47,"descTitle":200,"descContent":201,"source":202},"91268181_35","/cdn/init/1029100_Skill_10400370_Icon.png","라이트닝 필드","대상에게 라이트닝 필드를 발사해 경로상의 대상에게 지속적으로 피해를 주고 계속해서 대상을 흡착합니다.",{"attributes":203,"type":204,"consume":194,"power":205},[191],[193],"50",{"id":207,"title":208,"children":209},"91268181_36","고유 스킬",[210],{"id":211,"type":132,"props":212},"91268181_37",{"id":213,"customKey":47,"icon":214,"iconStyle":64,"iconTitle":47,"descTitle":215,"descContent":216,"source":217},"91268181_38","/cdn/init/1029100_Skill_14000000_Icon.png","공격","전기 원소 능력을 사용하여 원거리에서 목표를 공격합니다.",{"attributes":218,"type":219,"consume":220,"power":221},[191],[193],"0","6",[223],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[225,236,246,257,269,279,289,301,311,321,331,342,352,364,374,385,396,406,416,426,436,446,456,467,477,487,497,507,517,527,537,547,557,567,577,587,597,607,617,627,637,647,657,667,677,687,697,707,717,727,737,747,757,767,777,787,797,807,816,820,827,837,847,857,867,877,887,897,907,917,927,937,947,957,967,977,987,997,1007,1017,1027,1037,1047,1057,1067,1077,1087,1097,1107,1117,1127,1137,1147,1158],{"id":226,"viewCount":58,"searchKey":227,"visible":15},"10003217",{"type":10,"entryId":228,"sortOrder":229,"name":230,"imageUrl":231,"description":232,"currentMorphology":13,"currentStage":22,"position":233,"attributes":234},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[24],[235],"attributes-fire",{"id":237,"viewCount":58,"searchKey":238,"visible":15},"10003309",{"type":10,"entryId":239,"sortOrder":240,"name":241,"imageUrl":242,"description":243,"currentMorphology":13,"currentStage":193,"position":244,"attributes":245},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[24],[235],{"id":247,"viewCount":58,"searchKey":248,"visible":15},"10003210",{"type":10,"entryId":249,"sortOrder":250,"name":251,"imageUrl":252,"description":253,"currentMorphology":13,"currentStage":254,"position":255,"attributes":256},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[24],[235],{"id":258,"viewCount":58,"searchKey":259,"visible":15},"10003203",{"type":10,"entryId":260,"sortOrder":261,"name":262,"imageUrl":263,"description":264,"currentMorphology":13,"currentStage":254,"position":265,"attributes":267},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[266],"position-break",[235,268],"attributes-dark",{"id":270,"viewCount":58,"searchKey":271,"visible":15},"10003353",{"type":10,"entryId":272,"sortOrder":273,"name":274,"imageUrl":275,"description":276,"currentMorphology":13,"currentStage":22,"position":277,"attributes":278},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[24],[268],{"id":280,"viewCount":58,"searchKey":281,"visible":15},"10003192",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":13,"currentStage":254,"position":287,"attributes":288},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[24],[268],{"id":290,"viewCount":58,"searchKey":291,"visible":15},"10003263",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":13,"currentStage":22,"position":297,"attributes":299},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[298],"position-sup",[300],"attributes-wind",{"id":302,"viewCount":58,"searchKey":303,"visible":15},"10003323",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":13,"currentStage":254,"position":309,"attributes":310},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[298],[300],{"id":312,"viewCount":58,"searchKey":313,"visible":15},"10003249",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":13,"currentStage":254,"position":319,"attributes":320},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[24],[300],{"id":322,"viewCount":58,"searchKey":323,"visible":15},"10003242",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":13,"currentStage":254,"position":329,"attributes":330},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[266],[300],{"id":332,"viewCount":58,"searchKey":333,"visible":15},"10003167",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":13,"currentStage":22,"position":339,"attributes":340},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[24],[341],"attributes-grass",{"id":343,"viewCount":58,"searchKey":344,"visible":15},"10003285",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":13,"currentStage":254,"position":350,"attributes":351},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[24],[341],{"id":353,"viewCount":58,"searchKey":354,"visible":15},"10003252",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":13,"currentStage":22,"position":360,"attributes":362},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[361],"position-heal",[363],"attributes-water",{"id":365,"viewCount":58,"searchKey":366,"visible":15},"10003344",{"type":10,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":13,"currentStage":193,"position":372,"attributes":373},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[361],[363],{"id":375,"viewCount":58,"searchKey":376,"visible":15},"10003245",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":13,"currentStage":254,"position":382,"attributes":383},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[361],[363,384],"attributes-ice",{"id":386,"viewCount":58,"searchKey":387,"visible":15},"10003238",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":13,"currentStage":254,"position":393,"attributes":395},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[394],"position-energy",[341,363],{"id":397,"viewCount":58,"searchKey":398,"visible":15},"10003243",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":13,"currentStage":22,"position":404,"attributes":405},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[298],[300],{"id":407,"viewCount":58,"searchKey":408,"visible":15},"10003140",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":13,"currentStage":254,"position":414,"attributes":415},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[298],[300],{"id":417,"viewCount":58,"searchKey":418,"visible":15},"10003236",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":13,"currentStage":254,"position":424,"attributes":425},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[298],[268],{"id":427,"viewCount":58,"searchKey":428,"visible":15},"10003196",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":13,"currentStage":22,"position":434,"attributes":435},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[266],[341],{"id":437,"viewCount":58,"searchKey":438,"visible":15},"10003189",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":13,"currentStage":254,"position":444,"attributes":445},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[394],[268,341],{"id":447,"viewCount":58,"searchKey":448,"visible":15},"10003179",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":13,"currentStage":254,"position":454,"attributes":455},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[266],[341],{"id":457,"viewCount":58,"searchKey":458,"visible":15},"10003342",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":13,"currentStage":22,"position":464,"attributes":465},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[266],[466,341],"attributes-rock",{"id":468,"viewCount":58,"searchKey":469,"visible":15},"10003237",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":13,"currentStage":254,"position":475,"attributes":476},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[266],[466,341],{"id":478,"viewCount":58,"searchKey":479,"visible":15},"10003326",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":13,"currentStage":254,"position":485,"attributes":486},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[266],[384],{"id":488,"viewCount":58,"searchKey":489,"visible":15},"10003184",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":13,"currentStage":22,"position":495,"attributes":496},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[394],[235],{"id":498,"viewCount":58,"searchKey":499,"visible":15},"10003282",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":13,"currentStage":254,"position":505,"attributes":506},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[394],[235],{"id":508,"viewCount":58,"searchKey":509,"visible":15},"10003317",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":13,"currentStage":22,"position":515,"attributes":516},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[361],[300],{"id":518,"viewCount":58,"searchKey":519,"visible":15},"10003215",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":13,"currentStage":254,"position":525,"attributes":526},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[361],[300],{"id":528,"viewCount":58,"searchKey":529,"visible":15},"10003338",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":13,"currentStage":220,"position":535,"attributes":536},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[394],[300,341],{"id":538,"viewCount":58,"searchKey":539,"visible":15},"10003143",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":13,"currentStage":22,"position":545,"attributes":546},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[298],[300],{"id":548,"viewCount":58,"searchKey":549,"visible":15},"10003138",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":13,"currentStage":254,"position":555,"attributes":556},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[298],[300],{"id":558,"viewCount":58,"searchKey":559,"visible":15},"10003290",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":13,"currentStage":22,"position":565,"attributes":566},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[24],[341],{"id":568,"viewCount":58,"searchKey":569,"visible":15},"10003271",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":13,"currentStage":254,"position":575,"attributes":576},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[24],[341],{"id":578,"viewCount":58,"searchKey":579,"visible":15},"10003153",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":13,"currentStage":254,"position":585,"attributes":586},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[298],[341],{"id":588,"viewCount":58,"searchKey":589,"visible":15},"10003231",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":13,"currentStage":22,"position":595,"attributes":596},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[266],[341],{"id":598,"viewCount":58,"searchKey":599,"visible":15},"10003149",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":13,"currentStage":254,"position":605,"attributes":606},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[298],[26],{"id":608,"viewCount":58,"searchKey":609,"visible":15},"10003218",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":13,"currentStage":254,"position":615,"attributes":616},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[266],[341],{"id":618,"viewCount":58,"searchKey":619,"visible":15},"10003278",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":13,"currentStage":22,"position":625,"attributes":626},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[298],[268],{"id":628,"viewCount":58,"searchKey":629,"visible":15},"10003296",{"type":10,"entryId":630,"sortOrder":631,"name":632,"imageUrl":633,"description":634,"currentMorphology":13,"currentStage":254,"position":635,"attributes":636},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[298],[268],{"id":638,"viewCount":58,"searchKey":639,"visible":15},"10003283",{"type":10,"entryId":640,"sortOrder":641,"name":642,"imageUrl":643,"description":644,"currentMorphology":13,"currentStage":22,"position":645,"attributes":646},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[24],[268],{"id":648,"viewCount":58,"searchKey":649,"visible":15},"10003144",{"type":10,"entryId":650,"sortOrder":651,"name":652,"imageUrl":653,"description":654,"currentMorphology":13,"currentStage":254,"position":655,"attributes":656},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[24],[268],{"id":658,"viewCount":58,"searchKey":659,"visible":15},"10003276",{"type":10,"entryId":660,"sortOrder":661,"name":662,"imageUrl":663,"description":664,"currentMorphology":13,"currentStage":254,"position":665,"attributes":666},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[24],[26],{"id":668,"viewCount":58,"searchKey":669,"visible":15},"10003197",{"type":10,"entryId":670,"sortOrder":671,"name":672,"imageUrl":673,"description":674,"currentMorphology":13,"currentStage":22,"position":675,"attributes":676},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[24],[384],{"id":678,"viewCount":58,"searchKey":679,"visible":15},"10003350",{"type":10,"entryId":680,"sortOrder":681,"name":682,"imageUrl":683,"description":684,"currentMorphology":13,"currentStage":193,"position":685,"attributes":686},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[24],[384],{"id":688,"viewCount":58,"searchKey":689,"visible":15},"10003190",{"type":10,"entryId":690,"sortOrder":691,"name":692,"imageUrl":693,"description":694,"currentMorphology":13,"currentStage":254,"position":695,"attributes":696},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[24],[384],{"id":698,"viewCount":58,"searchKey":699,"visible":15},"10003299",{"type":10,"entryId":700,"sortOrder":701,"name":702,"imageUrl":703,"description":704,"currentMorphology":13,"currentStage":22,"position":705,"attributes":706},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[266],[26],{"id":708,"viewCount":58,"searchKey":709,"visible":15},"10003250",{"type":10,"entryId":710,"sortOrder":711,"name":712,"imageUrl":713,"description":714,"currentMorphology":13,"currentStage":254,"position":715,"attributes":716},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[266],[26],{"id":718,"viewCount":58,"searchKey":719,"visible":15},"10003298",{"type":10,"entryId":720,"sortOrder":721,"name":722,"imageUrl":723,"description":724,"currentMorphology":13,"currentStage":22,"position":725,"attributes":726},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[266],[363],{"id":728,"viewCount":58,"searchKey":729,"visible":15},"10003173",{"type":10,"entryId":730,"sortOrder":731,"name":732,"imageUrl":733,"description":734,"currentMorphology":13,"currentStage":193,"position":735,"attributes":736},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[266],[363],{"id":738,"viewCount":58,"searchKey":739,"visible":15},"10003291",{"type":10,"entryId":740,"sortOrder":741,"name":742,"imageUrl":743,"description":744,"currentMorphology":13,"currentStage":254,"position":745,"attributes":746},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[298],[363],{"id":748,"viewCount":58,"searchKey":749,"visible":15},"10003341",{"type":10,"entryId":750,"sortOrder":751,"name":752,"imageUrl":753,"description":754,"currentMorphology":13,"currentStage":254,"position":755,"attributes":756},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[266],[363],{"id":758,"viewCount":58,"searchKey":759,"visible":15},"10003228",{"type":10,"entryId":760,"sortOrder":761,"name":762,"imageUrl":763,"description":764,"currentMorphology":13,"currentStage":22,"position":765,"attributes":766},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[24],[363],{"id":768,"viewCount":58,"searchKey":769,"visible":15},"10003352",{"type":10,"entryId":770,"sortOrder":771,"name":772,"imageUrl":773,"description":774,"currentMorphology":13,"currentStage":193,"position":775,"attributes":776},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[24],[363],{"id":778,"viewCount":58,"searchKey":779,"visible":15},"10003345",{"type":10,"entryId":780,"sortOrder":781,"name":782,"imageUrl":783,"description":784,"currentMorphology":13,"currentStage":254,"position":785,"attributes":786},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[24],[363],{"id":788,"viewCount":58,"searchKey":789,"visible":15},"10003340",{"type":10,"entryId":790,"sortOrder":791,"name":792,"imageUrl":793,"description":794,"currentMorphology":13,"currentStage":22,"position":795,"attributes":796},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[24],[466],{"id":798,"viewCount":58,"searchKey":799,"visible":15},"10003251",{"type":10,"entryId":800,"sortOrder":801,"name":802,"imageUrl":803,"description":804,"currentMorphology":13,"currentStage":254,"position":805,"attributes":806},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[24],[466],{"id":808,"viewCount":58,"searchKey":809,"visible":15},"10003241",{"type":10,"entryId":8,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":13,"currentStage":254,"position":814,"attributes":815},1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[298],[466],{"id":4,"viewCount":58,"searchKey":817,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":818,"attributes":819},[24],[26],{"id":6,"viewCount":58,"searchKey":821,"visible":15},{"type":10,"entryId":12,"sortOrder":822,"name":80,"imageUrl":823,"description":824,"currentMorphology":13,"currentStage":254,"position":825,"attributes":826},1029300,"/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[24],[26],{"id":828,"viewCount":58,"searchKey":829,"visible":15},"10003318",{"type":10,"entryId":830,"sortOrder":831,"name":832,"imageUrl":833,"description":834,"currentMorphology":13,"currentStage":22,"position":835,"attributes":836},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[266],[268],{"id":838,"viewCount":58,"searchKey":839,"visible":15},"10003332",{"type":10,"entryId":840,"sortOrder":841,"name":842,"imageUrl":843,"description":844,"currentMorphology":13,"currentStage":254,"position":845,"attributes":846},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[24],[268],{"id":848,"viewCount":58,"searchKey":849,"visible":15},"10003297",{"type":10,"entryId":850,"sortOrder":851,"name":852,"imageUrl":853,"description":854,"currentMorphology":13,"currentStage":254,"position":855,"attributes":856},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[266],[268],{"id":858,"viewCount":58,"searchKey":859,"visible":15},"10003354",{"type":10,"entryId":860,"sortOrder":861,"name":862,"imageUrl":863,"description":864,"currentMorphology":13,"currentStage":22,"position":865,"attributes":866},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[266],[300],{"id":868,"viewCount":58,"searchKey":869,"visible":15},"10003164",{"type":10,"entryId":870,"sortOrder":871,"name":872,"imageUrl":873,"description":874,"currentMorphology":13,"currentStage":193,"position":875,"attributes":876},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[266],[300],{"id":878,"viewCount":58,"searchKey":879,"visible":15},"10003311",{"type":10,"entryId":880,"sortOrder":881,"name":882,"imageUrl":883,"description":884,"currentMorphology":13,"currentStage":254,"position":885,"attributes":886},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[266],[300],{"id":888,"viewCount":58,"searchKey":889,"visible":15},"10003304",{"type":10,"entryId":890,"sortOrder":891,"name":892,"imageUrl":893,"description":894,"currentMorphology":13,"currentStage":254,"position":895,"attributes":896},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[24],[235],{"id":898,"viewCount":58,"searchKey":899,"visible":15},"10003208",{"type":10,"entryId":900,"sortOrder":901,"name":902,"imageUrl":903,"description":904,"currentMorphology":13,"currentStage":22,"position":905,"attributes":906},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[24],[466],{"id":908,"viewCount":58,"searchKey":909,"visible":15},"10003202",{"type":10,"entryId":910,"sortOrder":911,"name":912,"imageUrl":913,"description":914,"currentMorphology":13,"currentStage":254,"position":915,"attributes":916},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[24],[466],{"id":918,"viewCount":58,"searchKey":919,"visible":15},"10003180",{"type":10,"entryId":920,"sortOrder":921,"name":922,"imageUrl":923,"description":924,"currentMorphology":13,"currentStage":22,"position":925,"attributes":926},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[266],[466],{"id":928,"viewCount":58,"searchKey":929,"visible":15},"10003300",{"type":10,"entryId":930,"sortOrder":931,"name":932,"imageUrl":933,"description":934,"currentMorphology":13,"currentStage":193,"position":935,"attributes":936},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[266],[235,466],{"id":938,"viewCount":58,"searchKey":939,"visible":15},"10003174",{"type":10,"entryId":940,"sortOrder":941,"name":942,"imageUrl":943,"description":944,"currentMorphology":13,"currentStage":254,"position":945,"attributes":946},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[266],[235,466],{"id":948,"viewCount":58,"searchKey":949,"visible":15},"10003293",{"type":10,"entryId":950,"sortOrder":951,"name":952,"imageUrl":953,"description":954,"currentMorphology":13,"currentStage":193,"position":955,"attributes":956},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[266],[466],{"id":958,"viewCount":58,"searchKey":959,"visible":15},"10003168",{"type":10,"entryId":960,"sortOrder":961,"name":962,"imageUrl":963,"description":964,"currentMorphology":13,"currentStage":254,"position":965,"attributes":966},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[266],[466],{"id":968,"viewCount":58,"searchKey":969,"visible":15},"10003161",{"type":10,"entryId":970,"sortOrder":971,"name":972,"imageUrl":973,"description":974,"currentMorphology":13,"currentStage":22,"position":975,"attributes":976},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[298],[466],{"id":978,"viewCount":58,"searchKey":979,"visible":15},"10003222",{"type":10,"entryId":980,"sortOrder":981,"name":982,"imageUrl":983,"description":984,"currentMorphology":13,"currentStage":254,"position":985,"attributes":986},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[298],[466],{"id":988,"viewCount":58,"searchKey":989,"visible":15},"10003272",{"type":10,"entryId":990,"sortOrder":991,"name":992,"imageUrl":993,"description":994,"currentMorphology":13,"currentStage":22,"position":995,"attributes":996},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[298],[26],{"id":998,"viewCount":58,"searchKey":999,"visible":15},"10003254",{"type":10,"entryId":1000,"sortOrder":1001,"name":1002,"imageUrl":1003,"description":1004,"currentMorphology":13,"currentStage":193,"position":1005,"attributes":1006},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[298],[26],{"id":1008,"viewCount":58,"searchKey":1009,"visible":15},"10003163",{"type":10,"entryId":1010,"sortOrder":1011,"name":1012,"imageUrl":1013,"description":1014,"currentMorphology":13,"currentStage":254,"position":1015,"attributes":1016},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[298],[26],{"id":1018,"viewCount":58,"searchKey":1019,"visible":15},"10003204",{"type":10,"entryId":1020,"sortOrder":1021,"name":1022,"imageUrl":1023,"description":1024,"currentMorphology":13,"currentStage":22,"position":1025,"attributes":1026},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[394],[363],{"id":1028,"viewCount":58,"searchKey":1029,"visible":15},"10003205",{"type":10,"entryId":1030,"sortOrder":1031,"name":1032,"imageUrl":1033,"description":1034,"currentMorphology":13,"currentStage":254,"position":1035,"attributes":1036},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[394],[363],{"id":1038,"viewCount":58,"searchKey":1039,"visible":15},"10003324",{"type":10,"entryId":1040,"sortOrder":1041,"name":1042,"imageUrl":1043,"description":1044,"currentMorphology":13,"currentStage":220,"position":1045,"attributes":1046},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[394],[26],{"id":1048,"viewCount":58,"searchKey":1049,"visible":15},"10003269",{"type":10,"entryId":1050,"sortOrder":1051,"name":1052,"imageUrl":1053,"description":1054,"currentMorphology":13,"currentStage":22,"position":1055,"attributes":1056},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[394],[466,363],{"id":1058,"viewCount":58,"searchKey":1059,"visible":15},"10003261",{"type":10,"entryId":1060,"sortOrder":1061,"name":1062,"imageUrl":1063,"description":1064,"currentMorphology":13,"currentStage":254,"position":1065,"attributes":1066},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[394],[466,363],{"id":1068,"viewCount":58,"searchKey":1069,"visible":15},"10003305",{"type":10,"entryId":1070,"sortOrder":1071,"name":1072,"imageUrl":1073,"description":1074,"currentMorphology":13,"currentStage":22,"position":1075,"attributes":1076},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[266],[384],{"id":1078,"viewCount":58,"searchKey":1079,"visible":15},"10003232",{"type":10,"entryId":1080,"sortOrder":1081,"name":1082,"imageUrl":1083,"description":1084,"currentMorphology":13,"currentStage":254,"position":1085,"attributes":1086},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[266],[384],{"id":1088,"viewCount":58,"searchKey":1089,"visible":15},"10003198",{"type":10,"entryId":1090,"sortOrder":1091,"name":1092,"imageUrl":1093,"description":1094,"currentMorphology":13,"currentStage":22,"position":1095,"attributes":1096},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[361],[341,363],{"id":1098,"viewCount":58,"searchKey":1099,"visible":15},"10003194",{"type":10,"entryId":1100,"sortOrder":1101,"name":1102,"imageUrl":1103,"description":1104,"currentMorphology":13,"currentStage":254,"position":1105,"attributes":1106},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[361],[341,363],{"id":1108,"viewCount":58,"searchKey":1109,"visible":15},"10003185",{"type":10,"entryId":1110,"sortOrder":1111,"name":1112,"imageUrl":1113,"description":1114,"currentMorphology":13,"currentStage":22,"position":1115,"attributes":1116},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[24],[363],{"id":1118,"viewCount":58,"searchKey":1119,"visible":15},"10003284",{"type":10,"entryId":1120,"sortOrder":1121,"name":1122,"imageUrl":1123,"description":1124,"currentMorphology":13,"currentStage":254,"position":1125,"attributes":1126},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[24],[363],{"id":1128,"viewCount":58,"searchKey":1129,"visible":15},"10003188",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":13,"currentStage":22,"position":1135,"attributes":1136},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[24],[384],{"id":1138,"viewCount":58,"searchKey":1139,"visible":15},"10003182",{"type":10,"entryId":1140,"sortOrder":1141,"name":1142,"imageUrl":1143,"description":1144,"currentMorphology":13,"currentStage":254,"position":1145,"attributes":1146},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[24],[384],{"id":1148,"viewCount":58,"searchKey":1149,"visible":15},"10003273",{"type":10,"entryId":1150,"sortOrder":1151,"name":1152,"imageUrl":1153,"description":1154,"currentMorphology":13,"currentStage":220,"position":1155,"attributes":1156},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[24],[1157],"attributes-holy",{"id":1159,"viewCount":58,"searchKey":1160,"visible":15},"10003150",{"type":10,"entryId":1161,"sortOrder":1162,"name":1163,"imageUrl":1164,"description":1165,"currentMorphology":13,"currentStage":220,"position":1166,"attributes":1167},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[24],[1157],[1169,1176,1181,1184,1189,1194,1199,1204,1209,1214,1219,1223,1228,1232,1237,1242,1247,1252,1257],{"id":1170,"parentId":1171,"tagType":1172,"tagKey":9,"name":1173,"language":1174,"sort":1175},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","설원 형태","ko-KR",5,{"id":1177,"parentId":1171,"tagType":1172,"tagKey":1178,"name":1179,"language":1174,"sort":1180},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1182,"parentId":1171,"tagType":1172,"tagKey":13,"name":1183,"language":1174,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1185,"parentId":1171,"tagType":1172,"tagKey":1186,"name":1187,"language":1174,"sort":1188},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1190,"parentId":1171,"tagType":1172,"tagKey":1191,"name":1192,"language":1174,"sort":1193},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1195,"parentId":1171,"tagType":1172,"tagKey":1196,"name":1197,"language":1174,"sort":1198},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1200,"parentId":1171,"tagType":1172,"tagKey":1201,"name":1202,"language":1174,"sort":1203},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1205,"parentId":1171,"tagType":1172,"tagKey":1206,"name":1207,"language":1174,"sort":1208},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1210,"parentId":1171,"tagType":1172,"tagKey":1211,"name":1212,"language":1174,"sort":1213},"3c233890d20868e097e9cea7821aad8e","Umbrabow Form","옵시디언 형태",4,{"id":1215,"parentId":1171,"tagType":1172,"tagKey":1216,"name":1217,"language":1174,"sort":1218},"532c88e1ad2265245d2a450fe9e5629f","Highland Form","고지 형태",9,{"id":1220,"parentId":1171,"tagType":1172,"tagKey":1221,"name":1222,"language":1174,"sort":82},"537f01b8a206e25a37d2ceb6c5325754","Prismana Form","천휘 형태",{"id":1224,"parentId":1171,"tagType":1172,"tagKey":1225,"name":1226,"language":1174,"sort":1227},"6348a343642770f35403dea19746668c","Sea of Flowers Form","꽃바다 형태",10,{"id":1229,"parentId":1171,"tagType":1172,"tagKey":1230,"name":1231,"language":1174,"sor