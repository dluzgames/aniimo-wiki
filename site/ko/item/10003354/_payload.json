mKey":45,"icon":142,"iconStyle":63,"iconTitle":45,"descTitle":143,"descContent":144,"source":145},"91268384_25","/cdn/init/1002400_Feature_10281_Icon.png","리벤지 마스터","공격을 받으면 무력화 효율이 30% 증가하며 10초 동안 지속됩니다.",{"attributes":146,"type":147,"consume":45,"power":45},[],[],{"id":149,"type":60,"props":150,"children":57},"91268384_26",{"title":151,"type":63,"id":152,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":65,"tabs":153},"스킬 소개","91268384_27",[154,183],{"id":155,"title":156,"children":157},"91268384_28","전투 스킬",[158,171],{"id":159,"type":123,"props":160},"91268384_29",{"id":161,"customKey":45,"icon":162,"iconStyle":63,"iconTitle":45,"descTitle":163,"descContent":164,"source":165},"91268384_30","/cdn/init/1002400_Skill_10900200_Icon.png","질풍 돌진","작은 체형의 목표에게 돌진하여 넉백시키고, 자신의 피해 감소를 15% 증가시키며 10초 동안 지속됩니다.",{"attributes":166,"type":168,"consume":169,"power":170},[167],"9",[22],"15","45",{"id":172,"type":123,"props":173},"91268384_31",{"id":174,"customKey":45,"icon":175,"iconStyle":63,"iconTitle":45,"descTitle":176,"descContent":177,"source":178},"91268384_32","/cdn/init/1002400_Skill_10700180_Icon.png","에너지 클로","발톱을 휘둘러 목표를 공격합니다.",{"attributes":179,"type":180,"consume":181,"power":182},[167],[22],"20","68",{"id":184,"title":185,"children":186},"91268384_33","고유 스킬",[187],{"id":188,"type":123,"props":189},"91268384_34",{"id":190,"customKey":45,"icon":191,"iconStyle":63,"iconTitle":45,"descTitle":192,"descContent":193,"source":194},"91268384_35","/cdn/init/1002400_Skill_16700000_Icon.png","공격","무력화 시 바람 원소 능력을 사용하여 근거리 대상을 공격합니다.",{"attributes":195,"type":196,"consume":197,"power":198},[167],[22],"0","6",[200,201],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},[203,215,226,237,248,258,268,279,289,299,309,320,330,342,352,363,374,384,394,404,414,424,434,445,455,465,475,485,495,505,515,525,535,545,555,565,575,586,596,606,616,626,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,845,849,859,869,879,889,899,909,919,929,939,949,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1140],{"id":204,"viewCount":57,"searchKey":205,"visible":15},"10003217",{"type":10,"entryId":206,"sortOrder":207,"name":208,"imageUrl":209,"description":210,"currentMorphology":21,"currentStage":22,"position":211,"attributes":213},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[212],"position-dps",[214],"attributes-fire",{"id":216,"viewCount":57,"searchKey":217,"visible":15},"10003309",{"type":10,"entryId":218,"sortOrder":219,"name":220,"imageUrl":221,"description":222,"currentMorphology":21,"currentStage":223,"position":224,"attributes":225},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[212],[214],{"id":227,"viewCount":57,"searchKey":228,"visible":15},"10003210",{"type":10,"entryId":229,"sortOrder":230,"name":231,"imageUrl":232,"description":233,"currentMorphology":21,"currentStage":234,"position":235,"attributes":236},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[212],[214],{"id":238,"viewCount":57,"searchKey":239,"visible":15},"10003203",{"type":10,"entryId":240,"sortOrder":241,"name":242,"imageUrl":243,"description":244,"currentMorphology":21,"currentStage":234,"position":245,"attributes":246},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[24],[214,247],"attributes-dark",{"id":249,"viewCount":57,"searchKey":250,"visible":15},"10003353",{"type":10,"entryId":251,"sortOrder":252,"name":253,"imageUrl":254,"description":255,"currentMorphology":21,"currentStage":22,"position":256,"attributes":257},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[212],[247],{"id":259,"viewCount":57,"searchKey":260,"visible":15},"10003192",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":21,"currentStage":234,"position":266,"attributes":267},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[212],[247],{"id":269,"viewCount":57,"searchKey":270,"visible":15},"10003263",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":21,"currentStage":22,"position":276,"attributes":278},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[277],"position-sup",[26],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10003323",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":21,"currentStage":234,"position":287,"attributes":288},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[277],[26],{"id":290,"viewCount":57,"searchKey":291,"visible":15},"10003249",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":21,"currentStage":234,"position":297,"attributes":298},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[212],[26],{"id":300,"viewCount":57,"searchKey":301,"visible":15},"10003242",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":21,"currentStage":234,"position":307,"attributes":308},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[24],[26],{"id":310,"viewCount":57,"searchKey":311,"visible":15},"10003167",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":21,"currentStage":22,"position":317,"attributes":318},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[212],[319],"attributes-grass",{"id":321,"viewCount":57,"searchKey":322,"visible":15},"10003285",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":21,"currentStage":234,"position":328,"attributes":329},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[212],[319],{"id":331,"viewCount":57,"searchKey":332,"visible":15},"10003252",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":21,"currentStage":22,"position":338,"attributes":340},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[339],"position-heal",[341],"attributes-water",{"id":343,"viewCount":57,"searchKey":344,"visible":15},"10003344",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":21,"currentStage":223,"position":350,"attributes":351},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[339],[341],{"id":353,"viewCount":57,"searchKey":354,"visible":15},"10003245",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":21,"currentStage":234,"position":360,"attributes":361},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[339],[341,362],"attributes-ice",{"id":364,"viewCount":57,"searchKey":365,"visible":15},"10003238",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":21,"currentStage":234,"position":371,"attributes":373},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[372],"position-energy",[319,341],{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10003243",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":21,"currentStage":22,"position":382,"attributes":383},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[277],[26],{"id":385,"viewCount":57,"searchKey":386,"visible":15},"10003140",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":21,"currentStage":234,"position":392,"attributes":393},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[277],[26],{"id":395,"viewCount":57,"searchKey":396,"visible":15},"10003236",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":21,"currentStage":234,"position":402,"attributes":403},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[277],[247],{"id":405,"viewCount":57,"searchKey":406,"visible":15},"10003196",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":21,"currentStage":22,"position":412,"attributes":413},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[24],[319],{"id":415,"viewCount":57,"searchKey":416,"visible":15},"10003189",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":21,"currentStage":234,"position":422,"attributes":423},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[372],[247,319],{"id":425,"viewCount":57,"searchKey":426,"visible":15},"10003179",{"type":10,"entryId":427,"sortOrder":428,"name":429,"imageUrl":430,"description":431,"currentMorphology":21,"currentStage":234,"position":432,"attributes":433},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[24],[319],{"id":435,"viewCount":57,"searchKey":436,"visible":15},"10003342",{"type":10,"entryId":437,"sortOrder":438,"name":439,"imageUrl":440,"description":441,"currentMorphology":21,"currentStage":22,"position":442,"attributes":443},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[24],[444,319],"attributes-rock",{"id":446,"viewCount":57,"searchKey":447,"visible":15},"10003237",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":21,"currentStage":234,"position":453,"attributes":454},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[24],[444,319],{"id":456,"viewCount":57,"searchKey":457,"visible":15},"10003326",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":21,"currentStage":234,"position":463,"attributes":464},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[24],[362],{"id":466,"viewCount":57,"searchKey":467,"visible":15},"10003184",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":21,"currentStage":22,"position":473,"attributes":474},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[372],[214],{"id":476,"viewCount":57,"searchKey":477,"visible":15},"10003282",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":21,"currentStage":234,"position":483,"attributes":484},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[372],[214],{"id":486,"viewCount":57,"searchKey":487,"visible":15},"10003317",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":21,"currentStage":22,"position":493,"attributes":494},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[339],[26],{"id":496,"viewCount":57,"searchKey":497,"visible":15},"10003215",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":21,"currentStage":234,"position":503,"attributes":504},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[339],[26],{"id":506,"viewCount":57,"searchKey":507,"visible":15},"10003338",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":21,"currentStage":197,"position":513,"attributes":514},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[372],[26,319],{"id":516,"viewCount":57,"searchKey":517,"visible":15},"10003143",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":21,"currentStage":22,"position":523,"attributes":524},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[277],[26],{"id":526,"viewCount":57,"searchKey":527,"visible":15},"10003138",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":21,"currentStage":234,"position":533,"attributes":534},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[277],[26],{"id":536,"viewCount":57,"searchKey":537,"visible":15},"10003290",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":21,"currentStage":22,"position":543,"attributes":544},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[212],[319],{"id":546,"viewCount":57,"searchKey":547,"visible":15},"10003271",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":21,"currentStage":234,"position":553,"attributes":554},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[212],[319],{"id":556,"viewCount":57,"searchKey":557,"visible":15},"10003153",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":21,"currentStage":234,"position":563,"attributes":564},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[277],[319],{"id":566,"viewCount":57,"searchKey":567,"visible":15},"10003231",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":21,"currentStage":22,"position":573,"attributes":574},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[24],[319],{"id":576,"viewCount":57,"searchKey":577,"visible":15},"10003149",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":21,"currentStage":234,"position":583,"attributes":584},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[277],[585],"attributes-electric",{"id":587,"viewCount":57,"searchKey":588,"visible":15},"10003218",{"type":10,"entryId":589,"sortOrder":590,"name":591,"imageUrl":592,"description":593,"currentMorphology":21,"currentStage":234,"position":594,"attributes":595},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[24],[319],{"id":597,"viewCount":57,"searchKey":598,"visible":15},"10003278",{"type":10,"entryId":599,"sortOrder":600,"name":601,"imageUrl":602,"description":603,"currentMorphology":21,"currentStage":22,"position":604,"attributes":605},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[277],[247],{"id":607,"viewCount":57,"searchKey":608,"visible":15},"10003296",{"type":10,"entryId":609,"sortOrder":610,"name":611,"imageUrl":612,"description":613,"currentMorphology":21,"currentStage":234,"position":614,"attributes":615},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[277],[247],{"id":617,"viewCount":57,"searchKey":618,"visible":15},"10003283",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":21,"currentStage":22,"position":624,"attributes":625},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[212],[247],{"id":627,"viewCount":57,"searchKey":628,"visible":15},"10003144",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":21,"currentStage":234,"position":634,"attributes":635},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[212],[247],{"id":637,"viewCount":57,"searchKey":638,"visible":15},"10003276",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":21,"currentStage":234,"position":644,"attributes":645},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[212],[585],{"id":647,"viewCount":57,"searchKey":648,"visible":15},"10003197",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":21,"currentStage":22,"position":654,"attributes":655},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[212],[362],{"id":657,"viewCount":57,"searchKey":658,"visible":15},"10003350",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":21,"currentStage":223,"position":664,"attributes":665},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[212],[362],{"id":667,"viewCount":57,"searchKey":668,"visible":15},"10003190",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":21,"currentStage":234,"position":674,"attributes":675},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[212],[362],{"id":677,"viewCount":57,"searchKey":678,"visible":15},"10003299",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":21,"currentStage":22,"position":684,"attributes":685},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[24],[585],{"id":687,"viewCount":57,"searchKey":688,"visible":15},"10003250",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":21,"currentStage":234,"position":694,"attributes":695},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[24],[585],{"id":697,"viewCount":57,"searchKey":698,"visible":15},"10003298",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":21,"currentStage":22,"position":704,"attributes":705},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[24],[341],{"id":707,"viewCount":57,"searchKey":708,"visible":15},"10003173",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":21,"currentStage":223,"position":714,"attributes":715},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[24],[341],{"id":717,"viewCount":57,"searchKey":718,"visible":15},"10003291",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":21,"currentStage":234,"position":724,"attributes":725},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[277],[341],{"id":727,"viewCount":57,"searchKey":728,"visible":15},"10003341",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":21,"currentStage":234,"position":734,"attributes":735},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[24],[341],{"id":737,"viewCount":57,"searchKey":738,"visible":15},"10003228",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":21,"currentStage":22,"position":744,"attributes":745},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[212],[341],{"id":747,"viewCount":57,"searchKey":748,"visible":15},"10003352",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":21,"currentStage":223,"position":754,"attributes":755},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[212],[341],{"id":757,"viewCount":57,"searchKey":758,"visible":15},"10003345",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":21,"currentStage":234,"position":764,"attributes":765},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[212],[341],{"id":767,"viewCount":57,"searchKey":768,"visible":15},"10003340",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":21,"currentStage":22,"position":774,"attributes":775},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[212],[444],{"id":777,"viewCount":57,"searchKey":778,"visible":15},"10003251",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":21,"currentStage":234,"position":784,"attributes":785},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[212],[444],{"id":787,"viewCount":57,"searchKey":788,"visible":15},"10003241",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":21,"currentStage":234,"position":794,"attributes":795},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[277],[444],{"id":797,"viewCount":57,"searchKey":798,"visible":15},"10003154",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":21,"currentStage":22,"position":804,"attributes":805},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[212],[585],{"id":807,"viewCount":57,"searchKey":808,"visible":15},"10003151",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":21,"currentStage":234,"position":814,"attributes":815},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[212],[585],{"id":817,"viewCount":57,"searchKey":818,"visible":15},"10003318",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":21,"currentStage":22,"position":824,"attributes":825},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[24],[247],{"id":827,"viewCount":57,"searchKey":828,"visible":15},"10003332",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":21,"currentStage":234,"position":834,"attributes":835},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[212],[247],{"id":837,"viewCount":57,"searchKey":838,"visible":15},"10003297",{"type":10,"entryId":8,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":21,"currentStage":234,"position":843,"attributes":844},1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[24],[247],{"id":4,"viewCount":57,"searchKey":846,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":847,"attributes":848},[24],[26],{"id":850,"viewCount":57,"searchKey":851,"visible":15},"10003164",{"type":10,"entryId":852,"sortOrder":853,"name":854,"imageUrl":855,"description":856,"currentMorphology":21,"currentStage":223,"position":857,"attributes":858},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[24],[26],{"id":860,"viewCount":57,"searchKey":861,"visible":15},"10003311",{"type":10,"entryId":862,"sortOrder":863,"name":864,"imageUrl":865,"description":866,"currentMorphology":21,"currentStage":234,"position":867,"attributes":868},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[24],[26],{"id":870,"viewCount":57,"searchKey":871,"visible":15},"10003304",{"type":10,"entryId":872,"sortOrder":873,"name":874,"imageUrl":875,"description":876,"currentMorphology":21,"currentStage":234,"position":877,"attributes":878},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[212],[214],{"id":880,"viewCount":57,"searchKey":881,"visible":15},"10003208",{"type":10,"entryId":882,"sortOrder":883,"name":884,"imageUrl":885,"description":886,"currentMorphology":21,"currentStage":22,"position":887,"attributes":888},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[212],[444],{"id":890,"viewCount":57,"searchKey":891,"visible":15},"10003202",{"type":10,"entryId":892,"sortOrder":893,"name":894,"imageUrl":895,"description":896,"currentMorphology":21,"currentStage":234,"position":897,"attributes":898},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[212],[444],{"id":900,"viewCount":57,"searchKey":901,"visible":15},"10003180",{"type":10,"entryId":902,"sortOrder":903,"name":904,"imageUrl":905,"description":906,"currentMorphology":21,"currentStage":22,"position":907,"attributes":908},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[24],[444],{"id":910,"viewCount":57,"searchKey":911,"visible":15},"10003300",{"type":10,"entryId":912,"sortOrder":913,"name":914,"imageUrl":915,"description":916,"currentMorphology":21,"currentStage":223,"position":917,"attributes":918},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[24],[214,444],{"id":920,"viewCount":57,"searchKey":921,"visible":15},"10003174",{"type":10,"entryId":922,"sortOrder":923,"name":924,"imageUrl":925,"description":926,"currentMorphology":21,"currentStage":234,"position":927,"attributes":928},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[24],[214,444],{"id":930,"viewCount":57,"searchKey":931,"visible":15},"10003293",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":21,"currentStage":223,"position":937,"attributes":938},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[24],[444],{"id":940,"viewCount":57,"searchKey":941,"visible":15},"10003168",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":21,"currentStage":234,"position":947,"attributes":948},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[24],[444],{"id":950,"viewCount":57,"searchKey":951,"visible":15},"10003161",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":21,"currentStage":22,"position":957,"attributes":958},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[277],[444],{"id":960,"viewCount":57,"searchKey":961,"visible":15},"10003222",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":21,"currentStage":234,"position":967,"attributes":968},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[277],[444],{"id":970,"viewCount":57,"searchKey":971,"visible":15},"10003272",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":21,"currentStage":22,"position":977,"attributes":978},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[277],[585],{"id":980,"viewCount":57,"searchKey":981,"visible":15},"10003254",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":21,"currentStage":223,"position":987,"attributes":988},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[277],[585],{"id":990,"viewCount":57,"searchKey":991,"visible":15},"10003163",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":21,"currentStage":234,"position":997,"attributes":998},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[277],[585],{"id":1000,"viewCount":57,"searchKey":1001,"visible":15},"10003204",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":21,"currentStage":22,"position":1007,"attributes":1008},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[372],[341],{"id":1010,"viewCount":57,"searchKey":1011,"visible":15},"10003205",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":21,"currentStage":234,"position":1017,"attributes":1018},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[372],[341],{"id":1020,"viewCount":57,"searchKey":1021,"visible":15},"10003324",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":21,"currentStage":197,"position":1027,"attributes":1028},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[372],[585],{"id":1030,"viewCount":57,"searchKey":1031,"visible":15},"10003269",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":21,"currentStage":22,"position":1037,"attributes":1038},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[372],[444,341],{"id":1040,"viewCount":57,"searchKey":1041,"visible":15},"10003261",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":21,"currentStage":234,"position":1047,"attributes":1048},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[372],[444,341],{"id":1050,"viewCount":57,"searchKey":1051,"visible":15},"10003305",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":21,"currentStage":22,"position":1057,"attributes":1058},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[24],[362],{"id":1060,"viewCount":57,"searchKey":1061,"visible":15},"10003232",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":21,"currentStage":234,"position":1067,"attributes":1068},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[24],[362],{"id":1070,"viewCount":57,"searchKey":1071,"visible":15},"10003198",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":21,"currentStage":22,"position":1077,"attributes":1078},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[339],[319,341],{"id":1080,"viewCount":57,"searchKey":1081,"visible":15},"10003194",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":21,"currentStage":234,"position":1087,"attributes":1088},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[339],[319,341],{"id":1090,"viewCount":57,"searchKey":1091,"visible":15},"10003185",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":21,"currentStage":22,"position":1097,"attributes":1098},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[212],[341],{"id":1100,"viewCount":57,"searchKey":1101,"visible":15},"10003284",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":21,"currentStage":234,"position":1107,"attributes":1108},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[212],[341],{"id":1110,"viewCount":57,"searchKey":1111,"visible":15},"10003188",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":21,"currentStage":22,"position":1117,"attributes":1118},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[212],[362],{"id":1120,"viewCount":57,"searchKey":1121,"visible":15},"10003182",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":21,"currentStage":234,"position":1127,"attributes":1128},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[212],[362],{"id":1130,"viewCount":57,"searchKey":1131,"visible":15},"10003273",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":21,"currentStage":197,"position":1137,"attributes":1138},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[212],[1139],"attributes-holy",{"id":1141,"viewCount":57,"searchKey":1142,"visible":15},"10003150",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":21,"currentStage":197,"position":1148,"attributes":1149},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[212],[1139],[1151,1159,1164,1167,1172,1177,1182,1187,1191,1196,1201,1206,1211,1215,1220,1225,1229,1234,1239],{"id":1152,"parentId":1153,"tagType":1154,"tagKey":1155,"name":1156,"language":1157,"sort":1158},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1160,"parentId":1153,"tagType":1154,"tagKey":1161,"name":1162,"language":1157,"sort":1163},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1165,"parentId":1153,"tagType":1154,"tagKey":21,"name":1166,"language":1157,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1168,"parentId":1153,"tagType":1154,"tagKey":1169,"name":1170,"language":1157,"sort":1171},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1173,"parentId":1153,"tagType":1154,"tagKey":1174,"name":1175,"language":1157,"sort