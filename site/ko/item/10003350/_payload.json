,"children":57},"91268379_24","circle",{"id":145,"customKey":45,"icon":146,"iconStyle":98,"iconTitle":45,"descTitle":147,"descContent":148,"source":149},"91268379_25","/cdn/init/1013200_Skill_9400107_Icon.png","가속","가속 상태에 진입하여 급속으로 이동합니다. 체력을 지속 소모합니다.",{"attributes":150,"type":151,"consume":45,"power":45},[],[],{"id":153,"type":60,"props":154,"children":157},"91268379_26",{"title":155,"type":63,"id":156,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"애니모 특성","91268379_27",[158],{"id":159,"type":143,"props":160,"children":57},"91268379_28",{"id":161,"customKey":45,"icon":162,"iconStyle":63,"iconTitle":45,"descTitle":163,"descContent":164,"source":165},"91268379_29","/cdn/init/1013200_Feature_11372_Icon.png","아찔한 서리 바람","[얼음 원소 상태 이상]이 5중첩 이상인 목표에게 피해를 줄 때, 피해에 치명타율이 15% 추가됩니다.",{"attributes":166,"type":167,"consume":45,"power":45},[],[],{"id":169,"type":60,"props":170,"children":57},"91268379_30",{"title":171,"type":63,"id":172,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":65,"tabs":173},"스킬 소개","91268379_31",[174,213],{"id":175,"title":176,"children":177},"91268379_32","전투 스킬",[178,191,202],{"id":179,"type":143,"props":180},"91268379_33",{"id":181,"customKey":45,"icon":182,"iconStyle":63,"iconTitle":45,"descTitle":183,"descContent":184,"source":185},"91268379_34","/cdn/init/1013200_Skill_10200081_Icon.png","아이스 트리플 슬래시","앞으로 발을 내디디며 몸을 회전시켜 공격하고, 마력장을 생성해 얼음의 칼날 3개를 발사하고 3회 공격해 피해를 준 후, 5중첩의 [얼음 원소 상태 이상]을 부여합니다.",{"attributes":186,"type":187,"consume":189,"power":190},[21],[188],"1","20","55",{"id":192,"type":143,"props":193},"91268379_35",{"id":194,"customKey":45,"icon":195,"iconStyle":63,"iconTitle":45,"descTitle":196,"descContent":197,"source":198},"91268379_36","/cdn/init/1013200_Skill_11200286_Icon.png","악몽 베기","전진한 뒤, 몸을 회전하며 어둠 칼날을 3개 발사해 피해를 줍니다.",{"attributes":199,"type":201,"consume":189,"power":190},[200],"12",[188],{"id":203,"type":143,"props":204},"91268379_37",{"id":205,"customKey":45,"icon":206,"iconStyle":63,"iconTitle":45,"descTitle":207,"descContent":208,"source":209},"91268379_38","/cdn/init/1013200_Skill_10200061_Icon.png","아이스 부메랑","전방으로 얼음 칼날을 투척하여 범위 내 목표에게 피해를 주고 [얼음 원소 상태 이상] 중첩을 누적합니다. 얼음 칼날이 회전하는 동안 에너지를 지속적으로 소모합니다. 다시 스킬 버튼을 누르면 얼음 칼날을 회수할 수 있습니다.",{"attributes":210,"type":211,"consume":189,"power":212},[21],[188],"39",{"id":214,"title":215,"children":216},"91268379_39","고유 스킬",[217],{"id":218,"type":143,"props":219},"91268379_40",{"id":220,"customKey":45,"icon":221,"iconStyle":63,"iconTitle":45,"descTitle":222,"descContent":223,"source":224},"91268379_41","/cdn/init/1013200_Skill_10200000_Icon.png","공격","얼음 원소 능력을 사용하여 근거리에서 목표를 공격합니다.",{"attributes":225,"type":226,"consume":227,"power":228},[21],[188],"0","6",[230,231],{"id":4,"entryId":12,"currentMorphology":20,"visible":14},{"id":6,"entryId":12,"currentMorphology":9,"visible":14},[233,244,254,265,277,287,297,309,319,329,339,350,360,372,382,392,403,413,423,433,443,453,463,474,484,494,504,514,524,534,544,554,564,574,584,594,604,615,625,635,645,655,665,675,683,687,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,846,856,866,876,886,896,906,916,926,936,946,956,966,976,986,996,1006,1016,1026,1036,1046,1056,1066,1076,1086,1096,1106,1116,1126,1136,1146,1156,1167],{"id":234,"viewCount":57,"searchKey":235,"visible":14},"10003217",{"type":10,"entryId":236,"sortOrder":237,"name":238,"imageUrl":239,"description":240,"currentMorphology":20,"currentStage":188,"position":241,"attributes":242},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[23],[243],"attributes-fire",{"id":245,"viewCount":57,"searchKey":246,"visible":14},"10003309",{"type":10,"entryId":247,"sortOrder":248,"name":249,"imageUrl":250,"description":251,"currentMorphology":20,"currentStage":21,"position":252,"attributes":253},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[23],[243],{"id":255,"viewCount":57,"searchKey":256,"visible":14},"10003210",{"type":10,"entryId":257,"sortOrder":258,"name":259,"imageUrl":260,"description":261,"currentMorphology":20,"currentStage":262,"position":263,"attributes":264},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[23],[243],{"id":266,"viewCount":57,"searchKey":267,"visible":14},"10003203",{"type":10,"entryId":268,"sortOrder":269,"name":270,"imageUrl":271,"description":272,"currentMorphology":20,"currentStage":262,"position":273,"attributes":275},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[274],"position-break",[243,276],"attributes-dark",{"id":278,"viewCount":57,"searchKey":279,"visible":14},"10003353",{"type":10,"entryId":280,"sortOrder":281,"name":282,"imageUrl":283,"description":284,"currentMorphology":20,"currentStage":188,"position":285,"attributes":286},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[23],[276],{"id":288,"viewCount":57,"searchKey":289,"visible":14},"10003192",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":20,"currentStage":262,"position":295,"attributes":296},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[23],[276],{"id":298,"viewCount":57,"searchKey":299,"visible":14},"10003263",{"type":10,"entryId":300,"sortOrder":301,"name":302,"imageUrl":303,"description":304,"currentMorphology":20,"currentStage":188,"position":305,"attributes":307},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[306],"position-sup",[308],"attributes-wind",{"id":310,"viewCount":57,"searchKey":311,"visible":14},"10003323",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":20,"currentStage":262,"position":317,"attributes":318},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[306],[308],{"id":320,"viewCount":57,"searchKey":321,"visible":14},"10003249",{"type":10,"entryId":322,"sortOrder":323,"name":324,"imageUrl":325,"description":326,"currentMorphology":20,"currentStage":262,"position":327,"attributes":328},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[23],[308],{"id":330,"viewCount":57,"searchKey":331,"visible":14},"10003242",{"type":10,"entryId":332,"sortOrder":333,"name":334,"imageUrl":335,"description":336,"currentMorphology":20,"currentStage":262,"position":337,"attributes":338},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[274],[308],{"id":340,"viewCount":57,"searchKey":341,"visible":14},"10003167",{"type":10,"entryId":342,"sortOrder":343,"name":344,"imageUrl":345,"description":346,"currentMorphology":20,"currentStage":188,"position":347,"attributes":348},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[23],[349],"attributes-grass",{"id":351,"viewCount":57,"searchKey":352,"visible":14},"10003285",{"type":10,"entryId":353,"sortOrder":354,"name":355,"imageUrl":356,"description":357,"currentMorphology":20,"currentStage":262,"position":358,"attributes":359},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[23],[349],{"id":361,"viewCount":57,"searchKey":362,"visible":14},"10003252",{"type":10,"entryId":363,"sortOrder":364,"name":365,"imageUrl":366,"description":367,"currentMorphology":20,"currentStage":188,"position":368,"attributes":370},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[369],"position-heal",[371],"attributes-water",{"id":373,"viewCount":57,"searchKey":374,"visible":14},"10003344",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":20,"currentStage":21,"position":380,"attributes":381},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[369],[371],{"id":383,"viewCount":57,"searchKey":384,"visible":14},"10003245",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":20,"currentStage":262,"position":390,"attributes":391},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[369],[371,25],{"id":393,"viewCount":57,"searchKey":394,"visible":14},"10003238",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":20,"currentStage":262,"position":400,"attributes":402},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[401],"position-energy",[349,371],{"id":404,"viewCount":57,"searchKey":405,"visible":14},"10003243",{"type":10,"entryId":406,"sortOrder":407,"name":408,"imageUrl":409,"description":410,"currentMorphology":20,"currentStage":188,"position":411,"attributes":412},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[306],[308],{"id":414,"viewCount":57,"searchKey":415,"visible":14},"10003140",{"type":10,"entryId":416,"sortOrder":417,"name":418,"imageUrl":419,"description":420,"currentMorphology":20,"currentStage":262,"position":421,"attributes":422},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[306],[308],{"id":424,"viewCount":57,"searchKey":425,"visible":14},"10003236",{"type":10,"entryId":426,"sortOrder":427,"name":428,"imageUrl":429,"description":430,"currentMorphology":20,"currentStage":262,"position":431,"attributes":432},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[306],[276],{"id":434,"viewCount":57,"searchKey":435,"visible":14},"10003196",{"type":10,"entryId":436,"sortOrder":437,"name":438,"imageUrl":439,"description":440,"currentMorphology":20,"currentStage":188,"position":441,"attributes":442},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[274],[349],{"id":444,"viewCount":57,"searchKey":445,"visible":14},"10003189",{"type":10,"entryId":446,"sortOrder":447,"name":448,"imageUrl":449,"description":450,"currentMorphology":20,"currentStage":262,"position":451,"attributes":452},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[401],[276,349],{"id":454,"viewCount":57,"searchKey":455,"visible":14},"10003179",{"type":10,"entryId":456,"sortOrder":457,"name":458,"imageUrl":459,"description":460,"currentMorphology":20,"currentStage":262,"position":461,"attributes":462},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[274],[349],{"id":464,"viewCount":57,"searchKey":465,"visible":14},"10003342",{"type":10,"entryId":466,"sortOrder":467,"name":468,"imageUrl":469,"description":470,"currentMorphology":20,"currentStage":188,"position":471,"attributes":472},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[274],[473,349],"attributes-rock",{"id":475,"viewCount":57,"searchKey":476,"visible":14},"10003237",{"type":10,"entryId":477,"sortOrder":478,"name":479,"imageUrl":480,"description":481,"currentMorphology":20,"currentStage":262,"position":482,"attributes":483},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[274],[473,349],{"id":485,"viewCount":57,"searchKey":486,"visible":14},"10003326",{"type":10,"entryId":487,"sortOrder":488,"name":489,"imageUrl":490,"description":491,"currentMorphology":20,"currentStage":262,"position":492,"attributes":493},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[274],[25],{"id":495,"viewCount":57,"searchKey":496,"visible":14},"10003184",{"type":10,"entryId":497,"sortOrder":498,"name":499,"imageUrl":500,"description":501,"currentMorphology":20,"currentStage":188,"position":502,"attributes":503},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[401],[243],{"id":505,"viewCount":57,"searchKey":506,"visible":14},"10003282",{"type":10,"entryId":507,"sortOrder":508,"name":509,"imageUrl":510,"description":511,"currentMorphology":20,"currentStage":262,"position":512,"attributes":513},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[401],[243],{"id":515,"viewCount":57,"searchKey":516,"visible":14},"10003317",{"type":10,"entryId":517,"sortOrder":518,"name":519,"imageUrl":520,"description":521,"currentMorphology":20,"currentStage":188,"position":522,"attributes":523},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[369],[308],{"id":525,"viewCount":57,"searchKey":526,"visible":14},"10003215",{"type":10,"entryId":527,"sortOrder":528,"name":529,"imageUrl":530,"description":531,"currentMorphology":20,"currentStage":262,"position":532,"attributes":533},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[369],[308],{"id":535,"viewCount":57,"searchKey":536,"visible":14},"10003338",{"type":10,"entryId":537,"sortOrder":538,"name":539,"imageUrl":540,"description":541,"currentMorphology":20,"currentStage":227,"position":542,"attributes":543},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[401],[308,349],{"id":545,"viewCount":57,"searchKey":546,"visible":14},"10003143",{"type":10,"entryId":547,"sortOrder":548,"name":549,"imageUrl":550,"description":551,"currentMorphology":20,"currentStage":188,"position":552,"attributes":553},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[306],[308],{"id":555,"viewCount":57,"searchKey":556,"visible":14},"10003138",{"type":10,"entryId":557,"sortOrder":558,"name":559,"imageUrl":560,"description":561,"currentMorphology":20,"currentStage":262,"position":562,"attributes":563},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[306],[308],{"id":565,"viewCount":57,"searchKey":566,"visible":14},"10003290",{"type":10,"entryId":567,"sortOrder":568,"name":569,"imageUrl":570,"description":571,"currentMorphology":20,"currentStage":188,"position":572,"attributes":573},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[23],[349],{"id":575,"viewCount":57,"searchKey":576,"visible":14},"10003271",{"type":10,"entryId":577,"sortOrder":578,"name":579,"imageUrl":580,"description":581,"currentMorphology":20,"currentStage":262,"position":582,"attributes":583},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[23],[349],{"id":585,"viewCount":57,"searchKey":586,"visible":14},"10003153",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":20,"currentStage":262,"position":592,"attributes":593},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[306],[349],{"id":595,"viewCount":57,"searchKey":596,"visible":14},"10003231",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":20,"currentStage":188,"position":602,"attributes":603},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[274],[349],{"id":605,"viewCount":57,"searchKey":606,"visible":14},"10003149",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":20,"currentStage":262,"position":612,"attributes":613},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[306],[614],"attributes-electric",{"id":616,"viewCount":57,"searchKey":617,"visible":14},"10003218",{"type":10,"entryId":618,"sortOrder":619,"name":620,"imageUrl":621,"description":622,"currentMorphology":20,"currentStage":262,"position":623,"attributes":624},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[274],[349],{"id":626,"viewCount":57,"searchKey":627,"visible":14},"10003278",{"type":10,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":20,"currentStage":188,"position":633,"attributes":634},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[306],[276],{"id":636,"viewCount":57,"searchKey":637,"visible":14},"10003296",{"type":10,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":20,"currentStage":262,"position":643,"attributes":644},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[306],[276],{"id":646,"viewCount":57,"searchKey":647,"visible":14},"10003283",{"type":10,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":20,"currentStage":188,"position":653,"attributes":654},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[23],[276],{"id":656,"viewCount":57,"searchKey":657,"visible":14},"10003144",{"type":10,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":20,"currentStage":262,"position":663,"attributes":664},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[23],[276],{"id":666,"viewCount":57,"searchKey":667,"visible":14},"10003276",{"type":10,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":20,"currentStage":262,"position":673,"attributes":674},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[23],[614],{"id":676,"viewCount":57,"searchKey":677,"visible":14},"10003197",{"type":10,"entryId":8,"sortOrder":678,"name":73,"imageUrl":679,"description":680,"currentMorphology":20,"currentStage":188,"position":681,"attributes":682},1013100,"/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[23],[25],{"id":4,"viewCount":57,"searchKey":684,"visible":14},{"type":10,"entryId":12,"sortOrder":16,"name":17,"imageUrl":18,"description":19,"currentMorphology":20,"currentStage":21,"position":685,"attributes":686},[23],[25],{"id":688,"viewCount":57,"searchKey":689,"visible":14},"10003190",{"type":10,"entryId":690,"sortOrder":691,"name":87,"imageUrl":692,"description":693,"currentMorphology":20,"currentStage":262,"position":694,"attributes":695},"047",1013300,"/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[23],[25],{"id":697,"viewCount":57,"searchKey":698,"visible":14},"10003299",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":20,"currentStage":188,"position":704,"attributes":705},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[274],[614],{"id":707,"viewCount":57,"searchKey":708,"visible":14},"10003250",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":20,"currentStage":262,"position":714,"attributes":715},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[274],[614],{"id":717,"viewCount":57,"searchKey":718,"visible":14},"10003298",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":20,"currentStage":188,"position":724,"attributes":725},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[274],[371],{"id":727,"viewCount":57,"searchKey":728,"visible":14},"10003173",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":20,"currentStage":21,"position":734,"attributes":735},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[274],[371],{"id":737,"viewCount":57,"searchKey":738,"visible":14},"10003291",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":20,"currentStage":262,"position":744,"attributes":745},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[306],[371],{"id":747,"viewCount":57,"searchKey":748,"visible":14},"10003341",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":20,"currentStage":262,"position":754,"attributes":755},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[274],[371],{"id":757,"viewCount":57,"searchKey":758,"visible":14},"10003228",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":20,"currentStage":188,"position":764,"attributes":765},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[23],[371],{"id":767,"viewCount":57,"searchKey":768,"visible":14},"10003352",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":20,"currentStage":21,"position":774,"attributes":775},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[23],[371],{"id":777,"viewCount":57,"searchKey":778,"visible":14},"10003345",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":20,"currentStage":262,"position":784,"attributes":785},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[23],[371],{"id":787,"viewCount":57,"searchKey":788,"visible":14},"10003340",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":20,"currentStage":188,"position":794,"attributes":795},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[23],[473],{"id":797,"viewCount":57,"searchKey":798,"visible":14},"10003251",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":20,"currentStage":262,"position":804,"attributes":805},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[23],[473],{"id":807,"viewCount":57,"searchKey":808,"visible":14},"10003241",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":20,"currentStage":262,"position":814,"attributes":815},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[306],[473],{"id":817,"viewCount":57,"searchKey":818,"visible":14},"10003154",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":20,"currentStage":188,"position":824,"attributes":825},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[23],[614],{"id":827,"viewCount":57,"searchKey":828,"visible":14},"10003151",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":20,"currentStage":262,"position":834,"attributes":835},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[23],[614],{"id":837,"viewCount":57,"searchKey":838,"visible":14},"10003318",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":20,"currentStage":188,"position":844,"attributes":845},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[274],[276],{"id":847,"viewCount":57,"searchKey":848,"visible":14},"10003332",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":20,"currentStage":262,"position":854,"attributes":855},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[23],[276],{"id":857,"viewCount":57,"searchKey":858,"visible":14},"10003297",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":20,"currentStage":262,"position":864,"attributes":865},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[274],[276],{"id":867,"viewCount":57,"searchKey":868,"visible":14},"10003354",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":20,"currentStage":188,"position":874,"attributes":875},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[274],[308],{"id":877,"viewCount":57,"searchKey":878,"visible":14},"10003164",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":20,"currentStage":21,"position":884,"attributes":885},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[274],[308],{"id":887,"viewCount":57,"searchKey":888,"visible":14},"10003311",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":20,"currentStage":262,"position":894,"attributes":895},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[274],[308],{"id":897,"viewCount":57,"searchKey":898,"visible":14},"10003304",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":20,"currentStage":262,"position":904,"attributes":905},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[23],[243],{"id":907,"viewCount":57,"searchKey":908,"visible":14},"10003208",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":20,"currentStage":188,"position":914,"attributes":915},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[23],[473],{"id":917,"viewCount":57,"searchKey":918,"visible":14},"10003202",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":20,"currentStage":262,"position":924,"attributes":925},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[23],[473],{"id":927,"viewCount":57,"searchKey":928,"visible":14},"10003180",{"type":10,"entryId":929,"sortOrder":930,"name":931,"imageUrl":932,"description":933,"currentMorphology":20,"currentStage":188,"position":934,"attributes":935},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[274],[473],{"id":937,"viewCount":57,"searchKey":938,"visible":14},"10003300",{"type":10,"entryId":939,"sortOrder":940,"name":941,"imageUrl":942,"description":943,"currentMorphology":20,"currentStage":21,"position":944,"attributes":945},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[274],[243,473],{"id":947,"viewCount":57,"searchKey":948,"visible":14},"10003174",{"type":10,"entryId":949,"sortOrder":950,"name":951,"imageUrl":952,"description":953,"currentMorphology":20,"currentStage":262,"position":954,"attributes":955},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[274],[243,473],{"id":957,"viewCount":57,"searchKey":958,"visible":14},"10003293",{"type":10,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":20,"currentStage":21,"position":964,"attributes":965},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[274],[473],{"id":967,"viewCount":57,"searchKey":968,"visible":14},"10003168",{"type":10,"entryId":969,"sortOrder":970,"name":971,"imageUrl":972,"description":973,"currentMorphology":20,"currentStage":262,"position":974,"attributes":975},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[274],[473],{"id":977,"viewCount":57,"searchKey":978,"visible":14},"10003161",{"type":10,"entryId":979,"sortOrder":980,"name":981,"imageUrl":982,"description":983,"currentMorphology":20,"currentStage":188,"position":984,"attributes":985},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[306],[473],{"id":987,"viewCount":57,"searchKey":988,"visible":14},"10003222",{"type":10,"entryId":989,"sortOrder":990,"name":991,"imageUrl":992,"description":993,"currentMorphology":20,"currentStage":262,"position":994,"attributes":995},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[306],[473],{"id":997,"viewCount":57,"searchKey":998,"visible":14},"10003272",{"type":10,"entryId":999,"sortOrder":1000,"name":1001,"imageUrl":1002,"description":1003,"currentMorphology":20,"currentStage":188,"position":1004,"attributes":1005},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[306],[614],{"id":1007,"viewCount":57,"searchKey":1008,"visible":14},"10003254",{"type":10,"entryId":1009,"sortOrder":1010,"name":1011,"imageUrl":1012,"description":1013,"currentMorphology":20,"currentStage":21,"position":1014,"attributes":1015},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[306],[614],{"id":1017,"viewCount":57,"searchKey":1018,"visible":14},"10003163",{"type":10,"entryId":1019,"sortOrder":1020,"name":1021,"imageUrl":1022,"description":1023,"currentMorphology":20,"currentStage":262,"position":1024,"attributes":1025},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[306],[614],{"id":1027,"viewCount":57,"searchKey":1028,"visible":14},"10003204",{"type":10,"entryId":1029,"sortOrder":1030,"name":1031,"imageUrl":1032,"description":1033,"currentMorphology":20,"currentStage":188,"position":1034,"attributes":1035},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[401],[371],{"id":1037,"viewCount":57,"searchKey":1038,"visible":14},"10003205",{"type":10,"entryId":1039,"sortOrder":1040,"name":1041,"imageUrl":1042,"description":1043,"currentMorphology":20,"currentStage":262,"position":1044,"attributes":1045},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[401],[371],{"id":1047,"viewCount":57,"searchKey":1048,"visible":14},"10003324",{"type":10,"entryId":1049,"sortOrder":1050,"name":1051,"imageUrl":1052,"description":1053,"currentMorphology":20,"currentStage":227,"position":1054,"attributes":1055},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[401],[614],{"id":1057,"viewCount":57,"searchKey":1058,"visible":14},"10003269",{"type":10,"entryId":1059,"sortOrder":1060,"name":1061,"imageUrl":1062,"description":1063,"currentMorphology":20,"currentStage":188,"position":1064,"attributes":1065},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[401],[473,371],{"id":1067,"viewCount":57,"searchKey":1068,"visible":14},"10003261",{"type":10,"entryId":1069,"sortOrder":1070,"name":1071,"imageUrl":1072,"description":1073,"currentMorphology":20,"currentStage":262,"position":1074,"attributes":1075},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[401],[473,371],{"id":1077,"viewCount":57,"searchKey":1078,"visible":14},"10003305",{"type":10,"entryId":1079,"sortOrder":1080,"name":1081,"imageUrl":1082,"description":1083,"currentMorphology":20,"currentStage":188,"position":1084,"attributes":1085},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[274],[25],{"id":1087,"viewCount":57,"searchKey":1088,"visible":14},"10003232",{"type":10,"entryId":1089,"sortOrder":1090,"name":1091,"imageUrl":1092,"description":1093,"currentMorphology":20,"currentStage":262,"position":1094,"attributes":1095},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[274],[25],{"id":1097,"viewCount":57,"searchKey":1098,"visible":14},"10003198",{"type":10,"entryId":1099,"sortOrder":1100,"name":1101,"imageUrl":1102,"description":1103,"currentMorphology":20,"currentStage":188,"position":1104,"attributes":1105},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[369],[349,371],{"id":1107,"viewCount":57,"searchKey":1108,"visible":14},"10003194",{"type":10,"entryId":1109,"sortOrder":1110,"name":1111,"imageUrl":1112,"description":1113,"currentMorphology":20,"currentStage":262,"position":1114,"attributes":1115},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[369],[349,371],{"id":1117,"viewCount":57,"searchKey":1118,"visible":14},"10003185",{"type":10,"entryId":1119,"sortOrder":1120,"name":1121,"imageUrl":1122,"description":1123,"currentMorphology":20,"currentStage":188,"position":1124,"attributes":1125},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[23],[371],{"id":1127,"viewCount":57,"searchKey":1128,"visible":14},"10003284",{"type":10,"entryId":1129,"sortOrder":1130,"name":1131,"imageUrl":1132,"description":1133,"currentMorphology":20,"currentStage":262,"position":1134,"attributes":1135},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[23],[371],{"id":1137,"viewCount":57,"searchKey":1138,"visible":14},"10003188",{"type":10,"entryId":1139,"sortOrder":1140,"name":1141,"imageUrl":1142,"description":1143,"currentMorphology":20,"currentStage":188,"position":1144,"attributes":1145},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[23],[25],{"id":1147,"viewCount":57,"searchKey":1148,"visible":14},"10003182",{"type":10,"entryId":1149,"sortOrder":1150,"name":1151,"imageUrl":1152,"description":1153,"currentMorphology":20,"currentStage":262,"position":1154,"attributes":1155},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[23],[25],{"id":1157,"viewCount":57,"searchKey":1158,"visible":14},"10003273",{"type":10,"entryId":1159,"sortOrder":1160,"name":1161,"imageUrl":1162,"description":1163,"currentMorphology":20,"currentStage":227,"position":1164,"attributes":1165},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[23],[1166],"attributes-holy",{"id":1168,"viewCount":57,"searchKey":1169,"visible":14},"10003150",{"type":10,"entryId":1170,"sortOrder":1171,"name":1172,"imageUrl":1173,"description":1174,"currentMorphology":20,"currentStage":227,"position":1175,"attributes":1176},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[23],[1166],[1178,1186,1191,1194,1199,1204,1209,1214,1219,1224,1229,1233,1238,1242,1246,1251,1256,1261,1266],{"id":1179,"parentId":1180,"tagType":1181,"tagKey":1182,"name":1183,"language":1184,"sort":1185},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1187,"parentId":1180,"tagType":1181,"tagKey":1188,"name":1189,"language":1184,"sort":1190},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1192,"parentId":1180,"tagType":1181,"tagKey":20,"name":1193,"language":1184,"sort":28},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1195,"parentId":1180,"tagType":1181,"tagKey":1196,"name":1197,"language":1184,"sort":1198},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1200,"parentId":1180,"tagType":1181,"tagKey":1201,"name":1202,"language":1184,"sort":1203},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1205,"parentId":1180,"tagType":1181,"tagKey":1206,"name":1207,"language":1184,"sort":1208},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1210,"parentId":1180,"tagType":1181,"tagKey":1211,"name":1212,"language":1184,"sort":1213},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1215,"parentId":1180,"tagType":1181,"tagKey":1216,"name":1217,"language":1184,"sort":1218},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1220,"parentId":1180,"tagType":1181,"tagKey":1221,"name":1222,"language":1184,"sort":1223},"3c233890d20868e097e9cea7821aad8e","Umbrabow Form","옵시디언 형태",4,{"id":1225,"parentId":1180,"tagType":1181,"tagKey":1226,"name":1227,"language":1184,"sort":1228},"532c88e1ad2265245d2a450fe9e5629f","Highland Form","고지 형태",9,{"id":1230