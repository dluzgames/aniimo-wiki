[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"aniimo-detail-10003150-ko":3,"header-aniimo-list-ko":208,"morphology-tags-ko":1153},{"id":4,"previousId":5,"nextId":6,"previousAnchor":7,"nextAnchor":11,"viewCount":13,"visible":14,"searchKey":15,"directories":26,"morphologyList":206},"10003150","10003273","10003217",{"entryId":8,"currentMorphology":9,"type":10},"9997","Basic Form","ANIIMO",{"entryId":12,"currentMorphology":9,"type":10},"001",1368,true,{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":22,"attributes":24},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.","0",[23],"position-dps",[25],"attributes-holy",[27,78],{"id":28,"title":29,"components":30},1,"기본 정보",[31,56],{"id":32,"type":33,"props":34,"children":55},"91268304_0","aniimoInfo",{"id":35,"formData":36},"91268304_1",{"name":18,"sortOrder":28,"serialNumber":16,"heightMin":28,"heightMax":28,"weightMin":37,"weightMax":38,"attributes":39,"position":40,"gender":41,"desc":20,"maleImage":19,"femaleImage":19,"noGenderImage":19,"illustrationImage":42,"backgroundImage":43,"attributeValue":44,"hp":45,"magicAttack":46,"physicalAttack":47,"magicDefense":48,"haste":49,"physicalDefense":48,"displayNames":50,"currentMorphology":9,"currentStage":54,"femaleIllustrationImage":43,"maleIllustrationImage":43},23.4,34.93,[25],[23],[],"/cdn/Vfx/1036100.mp4","",504,90,85,116,65,83,{"maleImage":51,"femaleImage":52,"illustrationImage":53,"backgroundImage":43,"noGenderImage":43},"Stellarys.png","Scorchhowl.png","evolutionarySpirit.png",0,null,{"id":57,"type":58,"props":59,"children":64},"91268304_8","crumbTitle",{"title":60,"type":61,"id":62,"isUse":14,"isEdit":14,"useTabs":63,"blackHeader":63},"홈 능력","small","91268304_9",false,[65,73],{"id":66,"type":67,"props":68,"children":55},"91268304_10","capsule",{"id":69,"customKey":70,"title":71,"icon":43,"bgColor":43,"fontColor":43,"type":72},"91268304_11","home-1008","1","spritePic",{"id":74,"type":67,"props":75,"children":55},"91268304_12",{"id":76,"customKey":77,"title":71,"icon":43,"bgColor":43,"fontColor":43,"type":72},"91268304_13","home-1101",{"id":79,"title":80,"components":81},2,"애니모 능력",[82,99,116],{"id":83,"type":58,"props":84,"children":87},"91268304_16",{"title":85,"type":61,"id":86,"isUse":14,"isEdit":14,"useTabs":63,"blackHeader":63},"탐사 스킬","91268304_17",[88],{"id":89,"type":90,"props":91,"children":55},"91268304_18","circle",{"id":92,"customKey":43,"icon":93,"iconStyle":61,"iconTitle":43,"descTitle":94,"descContent":95,"source":96},"91268304_19","/cdn/init/1036100_Skill_9400107_Icon.png","가속","가속 상태에 진입하여 급속으로 이동합니다. 체력을 지속 소모합니다.",{"attributes":97,"type":98,"consume":43,"power":43},[],[],{"id":100,"type":58,"props":101,"children":105},"91268304_20",{"title":102,"type":103,"id":104,"isUse":14,"isEdit":14,"useTabs":63,"blackHeader":63},"애니모 특성","big","91268304_21",[106],{"id":107,"type":90,"props":108,"children":55},"91268304_22",{"id":109,"customKey":43,"icon":110,"iconStyle":103,"iconTitle":43,"descTitle":111,"descContent":112,"source":113},"91268304_23","/cdn/init/1036100_Feature_13611_Icon.png","햇님별의 힘","원소가 상성 관계가 아닐 때, 추가로 최종 피해가 20% 증가하며, 일반 공격 4회마다 [태양의 고리]를 획득하여 다음 스킬 효과를 강화합니다.",{"attributes":114,"type":115,"consume":43,"power":43},[],[],{"id":117,"type":58,"props":118,"children":55},"91268304_24",{"title":119,"type":103,"id":120,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":63,"tabs":121},"스킬 소개","91268304_25",[122,180],{"id":123,"title":124,"children":125},"91268304_26","전투 스킬",[126,139,148,160,171],{"id":127,"type":90,"props":128},"91268304_27",{"id":129,"customKey":43,"icon":130,"iconStyle":103,"iconTitle":43,"descTitle":131,"descContent":132,"source":133},"91268304_28","/cdn/init/1036300_Skill_11300040_Icon.png","성광의 포격","공중에서 목표를 향해 돌진하여 공격하며，착지 시 성광 폭발을 일으킵니다. 【진햇님별의 고리】를 보유하고 있다면 이번 피해가 30% 증가합니다.",{"attributes":134,"type":136,"consume":137,"power":138},[135],"13",[71],"20","62",{"id":140,"type":90,"props":141},"91268304_29",{"id":142,"customKey":43,"icon":43,"iconStyle":103,"iconTitle":43,"descTitle":143,"descContent":144,"source":145},"91268304_30","성광의 축복","태양의 빛을 받아 에너지를 20 회복합니다. [태양의 고리]가 스킬 효과를 강화해 추가로 에너지를 5 회복합니다.",{"attributes":146,"type":147,"consume":21,"power":21},[135],[21],{"id":149,"type":90,"props":150},"91268304_31",{"id":151,"customKey":43,"icon":152,"iconStyle":103,"iconTitle":43,"descTitle":153,"descContent":154,"source":155},"91268304_32","/cdn/init/1036300_Skill_11300020_Icon.png","신성한 포효","신성한 힘이 담긴 사자후로 적을 공격하며，명중 시 자신의%빛 원소 피해 증가를 상승시키고，최대3스택까지 중첩되며，20초 지속됩니다.【진의 햇님별 고리】는 스킬 효과를 강화하여，1회에3스택 중첩됩니다.",{"attributes":156,"type":157,"consume":158,"power":159},[135],[71],"10","30",{"id":161,"type":90,"props":162},"91268304_33",{"id":163,"customKey":43,"icon":164,"iconStyle":103,"iconTitle":43,"descTitle":165,"descContent":166,"source":167},"91268304_34","/cdn/init/1036300_Skill_11300030_Icon.png","신성한 폭풍","몸을 회전하며 점프하여 폭풍을 일으켜 대상을 중심으로 끌어모으고, 동시에 막대한 파괴 피해를 입힙니다. 【금일의 고리】가 스킬 효과를 강화하며, 마지막 단계에서는 추가로 1초 동안 기절시킵니다.",{"attributes":168,"type":169,"consume":137,"power":170},[135],[71],"60",{"id":172,"type":90,"props":173},"91268304_35",{"id":174,"customKey":43,"icon":175,"iconStyle":103,"iconTitle":43,"descTitle":131,"descContent":176,"source":177},"91268304_36","/cdn/init/1036300_Skill_11300041_Icon.png","공중에서 목표를 향해 돌진 공격하고，착지 시 성광 폭발을 일으킨다. 【진햇님별의 고리】를 보유하고 있다면 이번 피해가 30% 증가하며，동시에 자신의 % HP를 회복한다.그리고 % 확률로 이번 스킬이 【진햇님별의 고리】를 소모하지 않는다.",{"attributes":178,"type":179,"consume":137,"power":138},[135],[71],{"id":181,"title":182,"children":183},"91268304_37","고유 스킬",[184,195],{"id":185,"type":90,"props":186},"91268304_38",{"id":187,"customKey":43,"icon":188,"iconStyle":103,"iconTitle":43,"descTitle":189,"descContent":190,"source":191},"91268304_39","/cdn/init/1036300_Skill_11300051_Icon.png","태양의 심판","주변 목표에게 태양의 심판을 내려 대량의 피해를 주고, [플레어리온]으로 진화합니다. 동시에 전투 이탈 전까지 자신의 피해 강화가 15% 증가하며, [태양의 고리]를 획득합니다.",{"attributes":192,"type":193,"consume":21,"power":194},[135],[71],"167",{"id":196,"type":90,"props":197},"91268304_40",{"id":198,"customKey":43,"icon":199,"iconStyle":103,"iconTitle":43,"descTitle":200,"descContent":201,"source":202},"91268304_41","/cdn/init/1036300_Skill_11300000_Icon.png","공격","빛 원소 능력을 사용하여 근거리에서 목표를 공격합니다.",{"attributes":203,"type":204,"consume":21,"power":205},[135],[71],"6",[207],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[209,218,229,240,252,262,272,284,294,304,314,325,335,347,357,368,379,389,399,409,419,429,439,450,460,470,480,490,500,510,520,530,540,550,560,570,580,591,601,611,621,631,641,651,661,671,681,691,701,711,721,731,741,751,761,771,781,791,801,811,821,831,841,851,861,871,881,891,901,911,921,931,941,951,961,971,981,991,1001,1011,1021,1031,1041,1051,1061,1071,1081,1091,1101,1111,1121,1131,1141,1149],{"id":6,"viewCount":55,"searchKey":210,"visible":14},{"type":10,"entryId":12,"sortOrder":211,"name":212,"imageUrl":213,"description":214,"currentMorphology":9,"currentStage":71,"position":215,"attributes":216},1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[23],[217],"attributes-fire",{"id":219,"viewCount":55,"searchKey":220,"visible":14},"10003309",{"type":10,"entryId":221,"sortOrder":222,"name":223,"imageUrl":224,"description":225,"currentMorphology":9,"currentStage":226,"position":227,"attributes":228},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[23],[217],{"id":230,"viewCount":55,"searchKey":231,"visible":14},"10003210",{"type":10,"entryId":232,"sortOrder":233,"name":234,"imageUrl":235,"description":236,"currentMorphology":9,"currentStage":237,"position":238,"attributes":239},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[23],[217],{"id":241,"viewCount":55,"searchKey":242,"visible":14},"10003203",{"type":10,"entryId":243,"sortOrder":244,"name":245,"imageUrl":246,"description":247,"currentMorphology":9,"currentStage":237,"position":248,"attributes":250},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[249],"position-break",[217,251],"attributes-dark",{"id":253,"viewCount":55,"searchKey":254,"visible":14},"10003353",{"type":10,"entryId":255,"sortOrder":256,"name":257,"imageUrl":258,"description":259,"currentMorphology":9,"currentStage":71,"position":260,"attributes":261},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[23],[251],{"id":263,"viewCount":55,"searchKey":264,"visible":14},"10003192",{"type":10,"entryId":265,"sortOrder":266,"name":267,"imageUrl":268,"description":269,"currentMorphology":9,"currentStage":237,"position":270,"attributes":271},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[23],[251],{"id":273,"viewCount":55,"searchKey":274,"visible":14},"10003263",{"type":10,"entryId":275,"sortOrder":276,"name":277,"imageUrl":278,"description":279,"currentMorphology":9,"currentStage":71,"position":280,"attributes":282},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[281],"position-sup",[283],"attributes-wind",{"id":285,"viewCount":55,"searchKey":286,"visible":14},"10003323",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":9,"currentStage":237,"position":292,"attributes":293},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[281],[283],{"id":295,"viewCount":55,"searchKey":296,"visible":14},"10003249",{"type":10,"entryId":297,"sortOrder":298,"name":299,"imageUrl":300,"description":301,"currentMorphology":9,"currentStage":237,"position":302,"attributes":303},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[23],[283],{"id":305,"viewCount":55,"searchKey":306,"visible":14},"10003242",{"type":10,"entryId":307,"sortOrder":308,"name":309,"imageUrl":310,"description":311,"currentMorphology":9,"currentStage":237,"position":312,"attributes":313},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[249],[283],{"id":315,"viewCount":55,"searchKey":316,"visible":14},"10003167",{"type":10,"entryId":317,"sortOrder":318,"name":319,"imageUrl":320,"description":321,"currentMorphology":9,"currentStage":71,"position":322,"attributes":323},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[23],[324],"attributes-grass",{"id":326,"viewCount":55,"searchKey":327,"visible":14},"10003285",{"type":10,"entryId":328,"sortOrder":329,"name":330,"imageUrl":331,"description":332,"currentMorphology":9,"currentStage":237,"position":333,"attributes":334},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[23],[324],{"id":336,"viewCount":55,"searchKey":337,"visible":14},"10003252",{"type":10,"entryId":338,"sortOrder":339,"name":340,"imageUrl":341,"description":342,"currentMorphology":9,"currentStage":71,"position":343,"attributes":345},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[344],"position-heal",[346],"attributes-water",{"id":348,"viewCount":55,"searchKey":349,"visible":14},"10003344",{"type":10,"entryId":350,"sortOrder":351,"name":352,"imageUrl":353,"description":354,"currentMorphology":9,"currentStage":226,"position":355,"attributes":356},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[344],[346],{"id":358,"viewCount":55,"searchKey":359,"visible":14},"10003245",{"type":10,"entryId":360,"sortOrder":361,"name":362,"imageUrl":363,"description":364,"currentMorphology":9,"currentStage":237,"position":365,"attributes":366},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[344],[346,367],"attributes-ice",{"id":369,"viewCount":55,"searchKey":370,"visible":14},"10003238",{"type":10,"entryId":371,"sortOrder":372,"name":373,"imageUrl":374,"description":375,"currentMorphology":9,"currentStage":237,"position":376,"attributes":378},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[377],"position-energy",[324,346],{"id":380,"viewCount":55,"searchKey":381,"visible":14},"10003243",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":9,"currentStage":71,"position":387,"attributes":388},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[281],[283],{"id":390,"viewCount":55,"searchKey":391,"visible":14},"10003140",{"type":10,"entryId":392,"sortOrder":393,"name":394,"imageUrl":395,"description":396,"currentMorphology":9,"currentStage":237,"position":397,"attributes":398},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[281],[283],{"id":400,"viewCount":55,"searchKey":401,"visible":14},"10003236",{"type":10,"entryId":402,"sortOrder":403,"name":404,"imageUrl":405,"description":406,"currentMorphology":9,"currentStage":237,"position":407,"attributes":408},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[281],[251],{"id":410,"viewCount":55,"searchKey":411,"visible":14},"10003196",{"type":10,"entryId":412,"sortOrder":413,"name":414,"imageUrl":415,"description":416,"currentMorphology":9,"currentStage":71,"position":417,"attributes":418},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[249],[324],{"id":420,"viewCount":55,"searchKey":421,"visible":14},"10003189",{"type":10,"entryId":422,"sortOrder":423,"name":424,"imageUrl":425,"description":426,"currentMorphology":9,"currentStage":237,"position":427,"attributes":428},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[377],[251,324],{"id":430,"viewCount":55,"searchKey":431,"visible":14},"10003179",{"type":10,"entryId":432,"sortOrder":433,"name":434,"imageUrl":435,"description":436,"currentMorphology":9,"currentStage":237,"position":437,"attributes":438},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[249],[324],{"id":440,"viewCount":55,"searchKey":441,"visible":14},"10003342",{"type":10,"entryId":442,"sortOrder":443,"name":444,"imageUrl":445,"description":446,"currentMorphology":9,"currentStage":71,"position":447,"attributes":448},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[249],[449,324],"attributes-rock",{"id":451,"viewCount":55,"searchKey":452,"visible":14},"10003237",{"type":10,"entryId":453,"sortOrder":454,"name":455,"imageUrl":456,"description":457,"currentMorphology":9,"currentStage":237,"position":458,"attributes":459},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[249],[449,324],{"id":461,"viewCount":55,"searchKey":462,"visible":14},"10003326",{"type":10,"entryId":463,"sortOrder":464,"name":465,"imageUrl":466,"description":467,"currentMorphology":9,"currentStage":237,"position":468,"attributes":469},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[249],[367],{"id":471,"viewCount":55,"searchKey":472,"visible":14},"10003184",{"type":10,"entryId":473,"sortOrder":474,"name":475,"imageUrl":476,"description":477,"currentMorphology":9,"currentStage":71,"position":478,"attributes":479},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[377],[217],{"id":481,"viewCount":55,"searchKey":482,"visible":14},"10003282",{"type":10,"entryId":483,"sortOrder":484,"name":485,"imageUrl":486,"description":487,"currentMorphology":9,"currentStage":237,"position":488,"attributes":489},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[377],[217],{"id":491,"viewCount":55,"searchKey":492,"visible":14},"10003317",{"type":10,"entryId":493,"sortOrder":494,"name":495,"imageUrl":496,"description":497,"currentMorphology":9,"currentStage":71,"position":498,"attributes":499},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[344],[283],{"id":501,"viewCount":55,"searchKey":502,"visible":14},"10003215",{"type":10,"entryId":503,"sortOrder":504,"name":505,"imageUrl":506,"description":507,"currentMorphology":9,"currentStage":237,"position":508,"attributes":509},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[344],[283],{"id":511,"viewCount":55,"searchKey":512,"visible":14},"10003338",{"type":10,"entryId":513,"sortOrder":514,"name":515,"imageUrl":516,"description":517,"currentMorphology":9,"currentStage":21,"position":518,"attributes":519},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[377],[283,324],{"id":521,"viewCount":55,"searchKey":522,"visible":14},"10003143",{"type":10,"entryId":523,"sortOrder":524,"name":525,"imageUrl":526,"description":527,"currentMorphology":9,"currentStage":71,"position":528,"attributes":529},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[281],[283],{"id":531,"viewCount":55,"searchKey":532,"visible":14},"10003138",{"type":10,"entryId":533,"sortOrder":534,"name":535,"imageUrl":536,"description":537,"currentMorphology":9,"currentStage":237,"position":538,"attributes":539},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[281],[283],{"id":541,"viewCount":55,"searchKey":542,"visible":14},"10003290",{"type":10,"entryId":543,"sortOrder":544,"name":545,"imageUrl":546,"description":547,"currentMorphology":9,"currentStage":71,"position":548,"attributes":549},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[23],[324],{"id":551,"viewCount":55,"searchKey":552,"visible":14},"10003271",{"type":10,"entryId":553,"sortOrder":554,"name":555,"imageUrl":556,"description":557,"currentMorphology":9,"currentStage":237,"position":558,"attributes":559},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[23],[324],{"id":561,"viewCount":55,"searchKey":562,"visible":14},"10003153",{"type":10,"entryId":563,"sortOrder":564,"name":565,"imageUrl":566,"description":567,"currentMorphology":9,"currentStage":237,"position":568,"attributes":569},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[281],[324],{"id":571,"viewCount":55,"searchKey":572,"visible":14},"10003231",{"type":10,"entryId":573,"sortOrder":574,"name":575,"imageUrl":576,"description":577,"currentMorphology":9,"currentStage":71,"position":578,"attributes":579},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[249],[324],{"id":581,"viewCount":55,"searchKey":582,"visible":14},"10003149",{"type":10,"entryId":583,"sortOrder":584,"name":585,"imageUrl":586,"description":587,"currentMorphology":9,"currentStage":237,"position":588,"attributes":589},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[281],[590],"attributes-electric",{"id":592,"viewCount":55,"searchKey":593,"visible":14},"10003218",{"type":10,"entryId":594,"sortOrder":595,"name":596,"imageUrl":597,"description":598,"currentMorphology":9,"currentStage":237,"position":599,"attributes":600},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[249],[324],{"id":602,"viewCount":55,"searchKey":603,"visible":14},"10003278",{"type":10,"entryId":604,"sortOrder":605,"name":606,"imageUrl":607,"description":608,"currentMorphology":9,"currentStage":71,"position":609,"attributes":610},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[281],[251],{"id":612,"viewCount":55,"searchKey":613,"visible":14},"10003296",{"type":10,"entryId":614,"sortOrder":615,"name":616,"imageUrl":617,"description":618,"currentMorphology":9,"currentStage":237,"position":619,"attributes":620},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[281],[251],{"id":622,"viewCount":55,"searchKey":623,"visible":14},"10003283",{"type":10,"entryId":624,"sortOrder":625,"name":626,"imageUrl":627,"description":628,"currentMorphology":9,"currentStage":71,"position":629,"attributes":630},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[23],[251],{"id":632,"viewCount":55,"searchKey":633,"visible":14},"10003144",{"type":10,"entryId":634,"sortOrder":635,"name":636,"imageUrl":637,"description":638,"currentMorphology":9,"currentStage":237,"position":639,"attributes":640},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[23],[251],{"id":642,"viewCount":55,"searchKey":643,"visible":14},"10003276",{"type":10,"entryId":644,"sortOrder":645,"name":646,"imageUrl":647,"description":648,"currentMorphology":9,"currentStage":237,"position":649,"attributes":650},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[23],[590],{"id":652,"viewCount":55,"searchKey":653,"visible":14},"10003197",{"type":10,"entryId":654,"sortOrder":655,"name":656,"imageUrl":657,"description":658,"currentMorphology":9,"currentStage":71,"position":659,"attributes":660},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[23],[367],{"id":662,"viewCount":55,"searchKey":663,"visible":14},"10003350",{"type":10,"entryId":664,"sortOrder":665,"name":666,"imageUrl":667,"description":668,"currentMorphology":9,"currentStage":226,"position":669,"attributes":670},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[23],[367],{"id":672,"viewCount":55,"searchKey":673,"visible":14},"10003190",{"type":10,"entryId":674,"sortOrder":675,"name":676,"imageUrl":677,"description":678,"currentMorphology":9,"currentStage":237,"position":679,"attributes":680},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[23],[367],{"id":682,"viewCount":55,"searchKey":683,"visible":14},"10003299",{"type":10,"entryId":684,"sortOrder":685,"name":686,"imageUrl":687,"description":688,"currentMorphology":9,"currentStage":71,"position":689,"attributes":690},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[249],[590],{"id":692,"viewCount":55,"searchKey":693,"visible":14},"10003250",{"type":10,"entryId":694,"sortOrder":695,"name":696,"imageUrl":697,"description":698,"currentMorphology":9,"currentStage":237,"position":699,"attributes":700},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[249],[590],{"id":702,"viewCount":55,"searchKey":703,"visible":14},"10003298",{"type":10,"entryId":704,"sortOrder":705,"name":706,"imageUrl":707,"description":708,"currentMorphology":9,"currentStage":71,"position":709,"attributes":710},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[249],[346],{"id":712,"viewCount":55,"searchKey":713,"visible":14},"10003173",{"type":10,"entryId":714,"sortOrder":715,"name":716,"imageUrl":717,"description":718,"currentMorphology":9,"currentStage":226,"position":719,"attributes":720},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[249],[346],{"id":722,"viewCount":55,"searchKey":723,"visible":14},"10003291",{"type":10,"entryId":724,"sortOrder":725,"name":726,"imageUrl":727,"description":728,"currentMorphology":9,"currentStage":237,"position":729,"attributes":730},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[281],[346],{"id":732,"viewCount":55,"searchKey":733,"visible":14},"10003341",{"type":10,"entryId":734,"sortOrder":735,"name":736,"imageUrl":737,"description":738,"currentMorphology":9,"currentStage":237,"position":739,"attributes":740},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[249],[346],{"id":742,"viewCount":55,"searchKey":743,"visible":14},"10003228",{"type":10,"entryId":744,"sortOrder":745,"name":746,"imageUrl":747,"description":748,"currentMorphology":9,"currentStage":71,"position":749,"attributes":750},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[23],[346],{"id":752,"viewCount":55,"searchKey":753,"visible":14},"10003352",{"type":10,"entryId":754,"sortOrder":755,"name":756,"imageUrl":757,"description":758,"currentMorphology":9,"currentStage":226,"position":759,"attributes":760},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[23],[346],{"id":762,"viewCount":55,"searchKey":763,"visible":14},"10003345",{"type":10,"entryId":764,"sortOrder":765,"name":766,"imageUrl":767,"description":768,"currentMorphology":9,"currentStage":237,"position":769,"attributes":770},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[23],[346],{"id":772,"viewCount":55,"searchKey":773,"visible":14},"10003340",{"type":10,"entryId":774,"sortOrder":775,"name":776,"imageUrl":777,"description":778,"currentMorphology":9,"currentStage":71,"position":779,"attributes":780},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[23],[449],{"id":782,"viewCount":55,"searchKey":783,"visible":14},"10003251",{"type":10,"entryId":784,"sortOrder":785,"name":786,"imageUrl":787,"description":788,"currentMorphology":9,"currentStage":237,"position":789,"attributes":790},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[23],[449],{"id":792,"viewCount":55,"searchKey":793,"visible":14},"10003241",{"type":10,"entryId":794,"sortOrder":795,"name":796,"imageUrl":797,"description":798,"currentMorphology":9,"currentStage":237,"position":799,"attributes":800},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[281],[449],{"id":802,"viewCount":55,"searchKey":803,"visible":14},"10003154",{"type":10,"entryId":804,"sortOrder":805,"name":806,"imageUrl":807,"description":808,"currentMorphology":9,"currentStage":71,"position":809,"attributes":810},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[23],[590],{"id":812,"viewCount":55,"searchKey":813,"visible":14},"10003151",{"type":10,"entryId":814,"sortOrder":815,"name":816,"imageUrl":817,"description":818,"currentMorphology":9,"currentStage":237,"position":819,"attributes":820},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[23],[590],{"id":822,"viewCount":55,"searchKey":823,"visible":14},"10003318",{"type":10,"entryId":824,"sortOrder":825,"name":826,"imageUrl":827,"description":828,"currentMorphology":9,"currentStage":71,"position":829,"attributes":830},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[249],[251],{"id":832,"viewCount":55,"searchKey":833,"visible":14},"10003332",{"type":10,"entryId":834,"sortOrder":835,"name":836,"imageUrl":837,"description":838,"currentMorphology":9,"currentStage":237,"position":839,"attributes":840},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[23],[251],{"id":842,"viewCount":55,"searchKey":843,"visible":14},"10003297",{"type":10,"entryId":844,"sortOrder":845,"name":846,"imageUrl":847,"description":848,"currentMorphology":9,"currentStage":237,"position":849,"attributes":850},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[249],[251],{"id":852,"viewCount":55,"searchKey":853,"visible":14},"10003354",{"type":10,"entryId":854,"sortOrder":855,"name":856,"imageUrl":857,"description":858,"currentMorphology":9,"currentStage":71,"position":859,"attributes":860},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[249],[283],{"id":862,"viewCount":55,"searchKey":863,"visible":14},"10003164",{"type":10,"entryId":864,"sortOrder":865,"name":866,"imageUrl":867,"description":868,"currentMorphology":9,"currentStage":226,"position":869,"attributes":870},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[249],[283],{"id":872,"viewCount":55,"searchKey":873,"visible":14},"10003311",{"type":10,"entryId":874,"sortOrder":875,"name":876,"imageUrl":877,"description":878,"currentMorphology":9,"currentStage":237,"position":879,"attributes":880},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[249],[283],{"id":882,"viewCount":55,"searchKey":883,"visible":14},"10003304",{"type":10,"entryId":884,"sortOrder":885,"name":886,"imageUrl":887,"description":888,"currentMorphology":9,"currentStage":237,"position":889,"attributes":890},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[23],[217],{"id":892,"viewCount":55,"searchKey":893,"visible":14},"10003208",{"type":10,"entryId":894,"sortOrder":895,"name":896,"imageUrl":897,"description":898,"currentMorphology":9,"currentStage":71,"position":899,"attributes":900},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[23],[449],{"id":902,"viewCount":55,"searchKey":903,"visible":14},"10003202",{"type":10,"entryId":904,"sortOrder":905,"name":906,"imageUrl":907,"description":908,"currentMorphology":9,"currentStage":237,"position":909,"attributes":910},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[23],[449],{"id":912,"viewCount":55,"searchKey":913,"visible":14},"10003180",{"type":10,"entryId":914,"sortOrder":915,"name":916,"imageUrl":917,"description":918,"currentMorphology":9,"currentStage":71,"position":919,"attributes":920},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[249],[449],{"id":922,"viewCount":55,"searchKey":923,"visible":14},"10003300",{"type":10,"entryId":924,"sortOrder":925,"name":926,"imageUrl":927,"description":928,"currentMorphology":9,"currentStage":226,"position":929,"attributes":930},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[249],[217,449],{"id":932,"viewCount":55,"searchKey":933,"visible":14},"10003174",{"type":10,"entryId":934,"sortOrder":935,"name":936,"imageUrl":937,"description":938,"currentMorphology":9,"currentStage":237,"position":939,"attributes":940},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[249],[217,449],{"id":942,"viewCount":55,"searchKey":943,"visible":14},"10003293",{"type":10,"entryId":944,"sortOrder":945,"name":946,"imageUrl":947,"description":948,"currentMorphology":9,"currentStage":226,"position":949,"attributes":950},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[249],[449],{"id":952,"viewCount":55,"searchKey":953,"visible":14},"10003168",{"type":10,"entryId":954,"sortOrder":955,"name":956,"imageUrl":957,"description":958,"currentMorphology":9,"currentStage":237,"position":959,"attributes":960},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[249],[449],{"id":962,"viewCount":55,"searchKey":963,"visible":14},"10003161",{"type":10,"entryId":964,"sortOrder":965,"name":966,"imageUrl":967,"description":968,"currentMorphology":9,"currentStage":71,"position":969,"attributes":970},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[281],[449],{"id":972,"viewCount":55,"searchKey":973,"visible":14},"10003222",{"type":10,"entryId":974,"sortOrder":975,"name":976,"imageUrl":977,"description":978,"currentMorphology":9,"currentStage":237,"position":979,"attributes":980},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[281],[449],{"id":982,"viewCount":55,"searchKey":983,"visible":14},"10003272",{"type":10,"entryId":984,"sortOrder":985,"name":986,"imageUrl":987,"description":988,"currentMorphology":9,"currentStage":71,"position":989,"attributes":990},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[281],[590],{"id":992,"viewCount":55,"searchKey":993,"visible":14},"10003254",{"type":10,"entryId":994,"sortOrder":995,"name":996,"imageUrl":997,"description":998,"currentMorphology":9,"currentStage":226,"position":999,"attributes":1000},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[281],[590],{"id":1002,"viewCount":55,"searchKey":1003,"visible":14},"10003163",{"type":10,"entryId":1004,"sortOrder":1005,"name":1006,"imageUrl":1007,"description":1008,"currentMorphology":9,"currentStage":237,"position":1009,"attributes":1010},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[281],[590],{"id":1012,"viewCount":55,"searchKey":1013,"visible":14},"10003204",{"type":10,"entryId":1014,"sortOrder":1015,"name":1016,"imageUrl":1017,"description":1018,"currentMorphology":9,"currentStage":71,"position":1019,"attributes":1020},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[377],[346],{"id":1022,"viewCount":55,"searchKey":1023,"visible":14},"10003205",{"type":10,"entryId":1024,"sortOrder":1025,"name":1026,"imageUrl":1027,"description":1028,"currentMorphology":9,"currentStage":237,"position":1029,"attributes":1030},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[377],[346],{"id":1032,"viewCount":55,"searchKey":1033,"visible":14},"10003324",{"type":10,"entryId":1034,"sortOrder":1035,"name":1036,"imageUrl":1037,"description":1038,"currentMorphology":9,"currentStage":21,"position":1039,"attributes":1040},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[377],[590],{"id":1042,"viewCount":55,"searchKey":1043,"visible":14},"10003269",{"type":10,"entryId":1044,"sortOrder":1045,"name":1046,"imageUrl":1047,"description":1048,"currentMorphology":9,"currentStage":71,"position":1049,"attributes":1050},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[377],[449,346],{"id":1052,"viewCount":55,"searchKey":1053,"visible":14},"10003261",{"type":10,"entryId":1054,"sortOrder":1055,"name":1056,"imageUrl":1057,"description":1058,"currentMorphology":9,"currentStage":237,"position":1059,"attributes":1060},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[377],[449,346],{"id":1062,"viewCount":55,"searchKey":1063,"visible":14},"10003305",{"type":10,"entryId":1064,"sortOrder":1065,"name":1066,"imageUrl":1067,"description":1068,"currentMorphology":9,"currentStage":71,"position":1069,"attributes":1070},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[249],[367],{"id":1072,"viewCount":55,"searchKey":1073,"visible":14},"10003232",{"type":10,"entryId":1074,"sortOrder":1075,"name":1076,"imageUrl":1077,"description":1078,"currentMorphology":9,"currentStage":237,"position":1079,"attributes":1080},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[249],[367],{"id":1082,"viewCount":55,"searchKey":1083,"visible":14},"10003198",{"type":10,"entryId":1084,"sortOrder":1085,"name":1086,"imageUrl":1087,"description":1088,"currentMorphology":9,"currentStage":71,"position":1089,"attributes":1090},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[344],[324,346],{"id":1092,"viewCount":55,"searchKey":1093,"visible":14},"10003194",{"type":10,"entryId":1094,"sortOrder":1095,"name":1096,"imageUrl":1097,"description":1098,"currentMorphology":9,"currentStage":237,"position":1099,"attributes":1100},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[344],[324,346],{"id":1102,"viewCount":55,"searchKey":1103,"visible":14},"10003185",{"type":10,"entryId":1104,"sortOrder":1105,"name":1106,"imageUrl":1107,"description":1108,"currentMorphology":9,"currentStage":71,"position":1109,"attributes":1110},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[23],[346],{"id":1112,"viewCount":55,"searchKey":1113,"visible":14},"10003284",{"type":10,"entryId":1114,"sortOrder":1115,"name":1116,"imageUrl":1117,"description":1118,"currentMorphology":9,"currentStage":237,"position":1119,"attributes":1120},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[23],[346],{"id":1122,"viewCount":55,"searchKey":1123,"visible":14},"10003188",{"type":10,"entryId":1124,"sortOrder":1125,"name":1126,"imageUrl":1127,"description":1128,"currentMorphology":9,"currentStage":71,"position":1129,"attributes":1130},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[23],[367],{"id":1132,"viewCount":55,"searchKey":1133,"visible":14},"10003182",{"type":10,"entryId":1134,"sortOrder":1135,"name":1136,"imageUrl":1137,"description":1138,"currentMorphology":9,"currentStage":237,"position":1139,"attributes":1140},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[23],[367],{"id":5,"viewCount":55,"searchKey":1142,"visible":14},{"type":10,"entryId":8,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":9,"currentStage":21,"position":1147,"attributes":1148},1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[23],[25],{"id":4,"viewCount":55,"searchKey":1150,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1151,"attributes":1152},[23],[25],[1154,1162,1167,1170,1175,1180,1185,1190,1195,1200,1205,1210,1215,1219,1224,1229,1234,1239,1244],{"id":1155,"parentId":1156,"tagType":1157,"tagKey":1158,"name":1159,"language":1160,"sort":1161},"03663aa1