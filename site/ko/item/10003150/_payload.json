":1157,"tagKey":1221,"name":1222,"language":1160,"sort":1223},"8c5ed9c90ca3d54060ed14e67377089f","Nighttime Form","밤 형태",12,{"id":1225,"parentId":1156,"tagType":1157,"tagKey":1226,"name":1227,"language":1160,"sort":1228},"9856738eb9984d160ce2cea67245ec04","Grassland Form","초원 형태",16,{"id":1230,"parentId":1156,"tagType":1157,"tagKey":1231,"name":1232,"language":1160,"sort":1233},"99d1743a158877166e16dd8985760c91","Mountain Woods Form","산림 형태",6,{"id":1235,"parentId":1156,"tagType":1157,"tagKey":1236,"name":1237,"language":1160,"sort":1238},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1240,"parentId":1156,"tagType":1157,"tagKey":1241,"name":1242,"language":1160,"sort":1243},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1245,"parentId":1156,"tagType":1157,"tagKey":1246,"name":1247,"language":1160,"sort":1248},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]