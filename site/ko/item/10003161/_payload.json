ackHeader":64},"애니모 특성","91268188_24",[144],{"id":145,"type":130,"props":146,"children":56},"91268188_25",{"id":147,"customKey":46,"icon":148,"iconStyle":62,"iconTitle":46,"descTitle":149,"descContent":150,"source":151},"91268188_26","/cdn/init/1043100_Feature_143301_Icon.png","강력한 침식","스킬 또는 궁극기가 목표를 명중하면 목표의 땅 원소 저항이 2% 감소하고, 최대 5중첩되며, 10초 동안 지속됩니다.",{"attributes":152,"type":153,"consume":46,"power":46},[],[],{"id":155,"type":59,"props":156,"children":56},"91268188_27",{"title":157,"type":62,"id":158,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":64,"tabs":159},"스킬 소개","91268188_28",[160,190],{"id":161,"title":162,"children":163},"91268188_29","전투 스킬",[164,177],{"id":165,"type":130,"props":166},"91268188_30",{"id":167,"customKey":46,"icon":168,"iconStyle":62,"iconTitle":46,"descTitle":169,"descContent":170,"source":171},"91268188_31","/cdn/init/1043100_Skill_10800360_Icon.png","연막탄","연막을 생성해 시야를 차단합니다. 연막 너머로는 조준할 수 없습니다.",{"attributes":172,"type":174,"consume":176,"power":175},[173],"8",[175],"0","10",{"id":178,"type":130,"props":179},"91268188_32",{"id":180,"customKey":46,"icon":181,"iconStyle":62,"iconTitle":46,"descTitle":182,"descContent":183,"source":184},"91268188_33","/cdn/init/1043100_Skill_10800330_Icon.png","머드 볼링","앞으로 굴러가는 진흙공을 발사해 충돌 시 범위 피해를 줍니다. 길게 눌러 조준 발사할 수 있습니다.",{"attributes":185,"type":186,"consume":188,"power":189},[173],[187],"2","20","31",{"id":191,"title":192,"children":193},"91268188_34","고유 스킬",[194],{"id":195,"type":130,"props":196},"91268188_35",{"id":197,"customKey":46,"icon":198,"iconStyle":62,"iconTitle":46,"descTitle":199,"descContent":200,"source":201},"91268188_36","/cdn/init/1043100_Skill_14300000_Icon.png","공격","땅 원소 능력을 사용하여 원거리에서 목표를 공격합니다.",{"attributes":202,"type":203,"consume":175,"power":204},[173],[187],"6",[206],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[208,220,230,241,253,263,273,284,294,304,314,325,335,347,357,368,379,389,399,409,419,429,439,449,459,469,479,489,499,509,519,529,539,549,559,569,579,590,600,610,620,630,640,650,660,670,680,690,700,710,720,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,958,962,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1140],{"id":209,"viewCount":56,"searchKey":210,"visible":14},"10003217",{"type":10,"entryId":211,"sortOrder":212,"name":213,"imageUrl":214,"description":215,"currentMorphology":9,"currentStage":21,"position":216,"attributes":218},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[217],"position-dps",[219],"attributes-fire",{"id":221,"viewCount":56,"searchKey":222,"visible":14},"10003309",{"type":10,"entryId":223,"sortOrder":224,"name":225,"imageUrl":226,"description":227,"currentMorphology":9,"currentStage":187,"position":228,"attributes":229},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[217],[219],{"id":231,"viewCount":56,"searchKey":232,"visible":14},"10003210",{"type":10,"entryId":233,"sortOrder":234,"name":235,"imageUrl":236,"description":237,"currentMorphology":9,"currentStage":238,"position":239,"attributes":240},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[217],[219],{"id":242,"viewCount":56,"searchKey":243,"visible":14},"10003203",{"type":10,"entryId":244,"sortOrder":245,"name":246,"imageUrl":247,"description":248,"currentMorphology":9,"currentStage":238,"position":249,"attributes":251},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[250],"position-break",[219,252],"attributes-dark",{"id":254,"viewCount":56,"searchKey":255,"visible":14},"10003353",{"type":10,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":9,"currentStage":21,"position":261,"attributes":262},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[217],[252],{"id":264,"viewCount":56,"searchKey":265,"visible":14},"10003192",{"type":10,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":9,"currentStage":238,"position":271,"attributes":272},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[217],[252],{"id":274,"viewCount":56,"searchKey":275,"visible":14},"10003263",{"type":10,"entryId":276,"sortOrder":277,"name":278,"imageUrl":279,"description":280,"currentMorphology":9,"currentStage":21,"position":281,"attributes":282},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[23],[283],"attributes-wind",{"id":285,"viewCount":56,"searchKey":286,"visible":14},"10003323",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":9,"currentStage":238,"position":292,"attributes":293},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[23],[283],{"id":295,"viewCount":56,"searchKey":296,"visible":14},"10003249",{"type":10,"entryId":297,"sortOrder":298,"name":299,"imageUrl":300,"description":301,"currentMorphology":9,"currentStage":238,"position":302,"attributes":303},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[217],[283],{"id":305,"viewCount":56,"searchKey":306,"visible":14},"10003242",{"type":10,"entryId":307,"sortOrder":308,"name":309,"imageUrl":310,"description":311,"currentMorphology":9,"currentStage":238,"position":312,"attributes":313},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[250],[283],{"id":315,"viewCount":56,"searchKey":316,"visible":14},"10003167",{"type":10,"entryId":317,"sortOrder":318,"name":319,"imageUrl":320,"description":321,"currentMorphology":9,"currentStage":21,"position":322,"attributes":323},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[217],[324],"attributes-grass",{"id":326,"viewCount":56,"searchKey":327,"visible":14},"10003285",{"type":10,"entryId":328,"sortOrder":329,"name":330,"imageUrl":331,"description":332,"currentMorphology":9,"currentStage":238,"position":333,"attributes":334},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[217],[324],{"id":336,"viewCount":56,"searchKey":337,"visible":14},"10003252",{"type":10,"entryId":338,"sortOrder":339,"name":340,"imageUrl":341,"description":342,"currentMorphology":9,"currentStage":21,"position":343,"attributes":345},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[344],"position-heal",[346],"attributes-water",{"id":348,"viewCount":56,"searchKey":349,"visible":14},"10003344",{"type":10,"entryId":350,"sortOrder":351,"name":352,"imageUrl":353,"description":354,"currentMorphology":9,"currentStage":187,"position":355,"attributes":356},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[344],[346],{"id":358,"viewCount":56,"searchKey":359,"visible":14},"10003245",{"type":10,"entryId":360,"sortOrder":361,"name":362,"imageUrl":363,"description":364,"currentMorphology":9,"currentStage":238,"position":365,"attributes":366},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[344],[346,367],"attributes-ice",{"id":369,"viewCount":56,"searchKey":370,"visible":14},"10003238",{"type":10,"entryId":371,"sortOrder":372,"name":373,"imageUrl":374,"description":375,"currentMorphology":9,"currentStage":238,"position":376,"attributes":378},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[377],"position-energy",[324,346],{"id":380,"viewCount":56,"searchKey":381,"visible":14},"10003243",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":9,"currentStage":21,"position":387,"attributes":388},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[23],[283],{"id":390,"viewCount":56,"searchKey":391,"visible":14},"10003140",{"type":10,"entryId":392,"sortOrder":393,"name":394,"imageUrl":395,"description":396,"currentMorphology":9,"currentStage":238,"position":397,"attributes":398},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[23],[283],{"id":400,"viewCount":56,"searchKey":401,"visible":14},"10003236",{"type":10,"entryId":402,"sortOrder":403,"name":404,"imageUrl":405,"description":406,"currentMorphology":9,"currentStage":238,"position":407,"attributes":408},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[23],[252],{"id":410,"viewCount":56,"searchKey":411,"visible":14},"10003196",{"type":10,"entryId":412,"sortOrder":413,"name":414,"imageUrl":415,"description":416,"currentMorphology":9,"currentStage":21,"position":417,"attributes":418},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[250],[324],{"id":420,"viewCount":56,"searchKey":421,"visible":14},"10003189",{"type":10,"entryId":422,"sortOrder":423,"name":424,"imageUrl":425,"description":426,"currentMorphology":9,"currentStage":238,"position":427,"attributes":428},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[377],[252,324],{"id":430,"viewCount":56,"searchKey":431,"visible":14},"10003179",{"type":10,"entryId":432,"sortOrder":433,"name":434,"imageUrl":435,"description":436,"currentMorphology":9,"currentStage":238,"position":437,"attributes":438},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[250],[324],{"id":440,"viewCount":56,"searchKey":441,"visible":14},"10003342",{"type":10,"entryId":442,"sortOrder":443,"name":444,"imageUrl":445,"description":446,"currentMorphology":9,"currentStage":21,"position":447,"attributes":448},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[250],[25,324],{"id":450,"viewCount":56,"searchKey":451,"visible":14},"10003237",{"type":10,"entryId":452,"sortOrder":453,"name":454,"imageUrl":455,"description":456,"currentMorphology":9,"currentStage":238,"position":457,"attributes":458},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[250],[25,324],{"id":460,"viewCount":56,"searchKey":461,"visible":14},"10003326",{"type":10,"entryId":462,"sortOrder":463,"name":464,"imageUrl":465,"description":466,"currentMorphology":9,"currentStage":238,"position":467,"attributes":468},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[250],[367],{"id":470,"viewCount":56,"searchKey":471,"visible":14},"10003184",{"type":10,"entryId":472,"sortOrder":473,"name":474,"imageUrl":475,"description":476,"currentMorphology":9,"currentStage":21,"position":477,"attributes":478},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[377],[219],{"id":480,"viewCount":56,"searchKey":481,"visible":14},"10003282",{"type":10,"entryId":482,"sortOrder":483,"name":484,"imageUrl":485,"description":486,"currentMorphology":9,"currentStage":238,"position":487,"attributes":488},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[377],[219],{"id":490,"viewCount":56,"searchKey":491,"visible":14},"10003317",{"type":10,"entryId":492,"sortOrder":493,"name":494,"imageUrl":495,"description":496,"currentMorphology":9,"currentStage":21,"position":497,"attributes":498},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[344],[283],{"id":500,"viewCount":56,"searchKey":501,"visible":14},"10003215",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":9,"currentStage":238,"position":507,"attributes":508},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[344],[283],{"id":510,"viewCount":56,"searchKey":511,"visible":14},"10003338",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":9,"currentStage":175,"position":517,"attributes":518},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[377],[283,324],{"id":520,"viewCount":56,"searchKey":521,"visible":14},"10003143",{"type":10,"entryId":522,"sortOrder":523,"name":524,"imageUrl":525,"description":526,"currentMorphology":9,"currentStage":21,"position":527,"attributes":528},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[23],[283],{"id":530,"viewCount":56,"searchKey":531,"visible":14},"10003138",{"type":10,"entryId":532,"sortOrder":533,"name":534,"imageUrl":535,"description":536,"currentMorphology":9,"currentStage":238,"position":537,"attributes":538},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[23],[283],{"id":540,"viewCount":56,"searchKey":541,"visible":14},"10003290",{"type":10,"entryId":542,"sortOrder":543,"name":544,"imageUrl":545,"description":546,"currentMorphology":9,"currentStage":21,"position":547,"attributes":548},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[217],[324],{"id":550,"viewCount":56,"searchKey":551,"visible":14},"10003271",{"type":10,"entryId":552,"sortOrder":553,"name":554,"imageUrl":555,"description":556,"currentMorphology":9,"currentStage":238,"position":557,"attributes":558},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[217],[324],{"id":560,"viewCount":56,"searchKey":561,"visible":14},"10003153",{"type":10,"entryId":562,"sortOrder":563,"name":564,"imageUrl":565,"description":566,"currentMorphology":9,"currentStage":238,"position":567,"attributes":568},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[23],[324],{"id":570,"viewCount":56,"searchKey":571,"visible":14},"10003231",{"type":10,"entryId":572,"sortOrder":573,"name":574,"imageUrl":575,"description":576,"currentMorphology":9,"currentStage":21,"position":577,"attributes":578},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[250],[324],{"id":580,"viewCount":56,"searchKey":581,"visible":14},"10003149",{"type":10,"entryId":582,"sortOrder":583,"name":584,"imageUrl":585,"description":586,"currentMorphology":9,"currentStage":238,"position":587,"attributes":588},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[23],[589],"attributes-electric",{"id":591,"viewCount":56,"searchKey":592,"visible":14},"10003218",{"type":10,"entryId":593,"sortOrder":594,"name":595,"imageUrl":596,"description":597,"currentMorphology":9,"currentStage":238,"position":598,"attributes":599},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[250],[324],{"id":601,"viewCount":56,"searchKey":602,"visible":14},"10003278",{"type":10,"entryId":603,"sortOrder":604,"name":605,"imageUrl":606,"description":607,"currentMorphology":9,"currentStage":21,"position":608,"attributes":609},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[23],[252],{"id":611,"viewCount":56,"searchKey":612,"visible":14},"10003296",{"type":10,"entryId":613,"sortOrder":614,"name":615,"imageUrl":616,"description":617,"currentMorphology":9,"currentStage":238,"position":618,"attributes":619},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[23],[252],{"id":621,"viewCount":56,"searchKey":622,"visible":14},"10003283",{"type":10,"entryId":623,"sortOrder":624,"name":625,"imageUrl":626,"description":627,"currentMorphology":9,"currentStage":21,"position":628,"attributes":629},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[217],[252],{"id":631,"viewCount":56,"searchKey":632,"visible":14},"10003144",{"type":10,"entryId":633,"sortOrder":634,"name":635,"imageUrl":636,"description":637,"currentMorphology":9,"currentStage":238,"position":638,"attributes":639},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[217],[252],{"id":641,"viewCount":56,"searchKey":642,"visible":14},"10003276",{"type":10,"entryId":643,"sortOrder":644,"name":645,"imageUrl":646,"description":647,"currentMorphology":9,"currentStage":238,"position":648,"attributes":649},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[217],[589],{"id":651,"viewCount":56,"searchKey":652,"visible":14},"10003197",{"type":10,"entryId":653,"sortOrder":654,"name":655,"imageUrl":656,"description":657,"currentMorphology":9,"currentStage":21,"position":658,"attributes":659},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[217],[367],{"id":661,"viewCount":56,"searchKey":662,"visible":14},"10003350",{"type":10,"entryId":663,"sortOrder":664,"name":665,"imageUrl":666,"description":667,"currentMorphology":9,"currentStage":187,"position":668,"attributes":669},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[217],[367],{"id":671,"viewCount":56,"searchKey":672,"visible":14},"10003190",{"type":10,"entryId":673,"sortOrder":674,"name":675,"imageUrl":676,"description":677,"currentMorphology":9,"currentStage":238,"position":678,"attributes":679},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[217],[367],{"id":681,"viewCount":56,"searchKey":682,"visible":14},"10003299",{"type":10,"entryId":683,"sortOrder":684,"name":685,"imageUrl":686,"description":687,"currentMorphology":9,"currentStage":21,"position":688,"attributes":689},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[250],[589],{"id":691,"viewCount":56,"searchKey":692,"visible":14},"10003250",{"type":10,"entryId":693,"sortOrder":694,"name":695,"imageUrl":696,"description":697,"currentMorphology":9,"currentStage":238,"position":698,"attributes":699},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[250],[589],{"id":701,"viewCount":56,"searchKey":702,"visible":14},"10003298",{"type":10,"entryId":703,"sortOrder":704,"name":705,"imageUrl":706,"description":707,"currentMorphology":9,"currentStage":21,"position":708,"attributes":709},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[250],[346],{"id":711,"viewCount":56,"searchKey":712,"visible":14},"10003173",{"type":10,"entryId":713,"sortOrder":714,"name":715,"imageUrl":716,"description":717,"currentMorphology":9,"currentStage":187,"position":718,"attributes":719},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[250],[346],{"id":721,"viewCount":56,"searchKey":722,"visible":14},"10003291",{"type":10,"entryId":723,"sortOrder":724,"name":725,"imageUrl":726,"description":727,"currentMorphology":9,"currentStage":238,"position":728,"attributes":729},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[23],[346],{"id":731,"viewCount":56,"searchKey":732,"visible":14},"10003341",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":9,"currentStage":238,"position":738,"attributes":739},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[250],[346],{"id":741,"viewCount":56,"searchKey":742,"visible":14},"10003228",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":9,"currentStage":21,"position":748,"attributes":749},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[217],[346],{"id":751,"viewCount":56,"searchKey":752,"visible":14},"10003352",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":9,"currentStage":187,"position":758,"attributes":759},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[217],[346],{"id":761,"viewCount":56,"searchKey":762,"visible":14},"10003345",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":9,"currentStage":238,"position":768,"attributes":769},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[217],[346],{"id":771,"viewCount":56,"searchKey":772,"visible":14},"10003340",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":9,"currentStage":21,"position":778,"attributes":779},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[217],[25],{"id":781,"viewCount":56,"searchKey":782,"visible":14},"10003251",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":9,"currentStage":238,"position":788,"attributes":789},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[217],[25],{"id":791,"viewCount":56,"searchKey":792,"visible":14},"10003241",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":9,"currentStage":238,"position":798,"attributes":799},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[23],[25],{"id":801,"viewCount":56,"searchKey":802,"visible":14},"10003154",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":9,"currentStage":21,"position":808,"attributes":809},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[217],[589],{"id":811,"viewCount":56,"searchKey":812,"visible":14},"10003151",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":9,"currentStage":238,"position":818,"attributes":819},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[217],[589],{"id":821,"viewCount":56,"searchKey":822,"visible":14},"10003318",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":9,"currentStage":21,"position":828,"attributes":829},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[250],[252],{"id":831,"viewCount":56,"searchKey":832,"visible":14},"10003332",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":9,"currentStage":238,"position":838,"attributes":839},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[217],[252],{"id":841,"viewCount":56,"searchKey":842,"visible":14},"10003297",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":9,"currentStage":238,"position":848,"attributes":849},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[250],[252],{"id":851,"viewCount":56,"searchKey":852,"visible":14},"10003354",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":9,"currentStage":21,"position":858,"attributes":859},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[250],[283],{"id":861,"viewCount":56,"searchKey":862,"visible":14},"10003164",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":9,"currentStage":187,"position":868,"attributes":869},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[250],[283],{"id":871,"viewCount":56,"searchKey":872,"visible":14},"10003311",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":9,"currentStage":238,"position":878,"attributes":879},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[250],[283],{"id":881,"viewCount":56,"searchKey":882,"visible":14},"10003304",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":9,"currentStage":238,"position":888,"attributes":889},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[217],[219],{"id":891,"viewCount":56,"searchKey":892,"visible":14},"10003208",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":9,"currentStage":21,"position":898,"attributes":899},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[217],[25],{"id":901,"viewCount":56,"searchKey":902,"visible":14},"10003202",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":9,"currentStage":238,"position":908,"attributes":909},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[217],[25],{"id":911,"viewCount":56,"searchKey":912,"visible":14},"10003180",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":9,"currentStage":21,"position":918,"attributes":919},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[250],[25],{"id":921,"viewCount":56,"searchKey":922,"visible":14},"10003300",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":9,"currentStage":187,"position":928,"attributes":929},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[250],[219,25],{"id":931,"viewCount":56,"searchKey":932,"visible":14},"10003174",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":9,"currentStage":238,"position":938,"attributes":939},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[250],[219,25],{"id":941,"viewCount":56,"searchKey":942,"visible":14},"10003293",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":9,"currentStage":187,"position":948,"attributes":949},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[250],[25],{"id":5,"viewCount":56,"searchKey":951,"visible":14},{"type":10,"entryId":8,"sortOrder":952,"name":953,"imageUrl":954,"description":955,"currentMorphology":9,"currentStage":238,"position":956,"attributes":957},1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[250],[25],{"id":4,"viewCount":56,"searchKey":959,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":960,"attributes":961},[23],[25],{"id":6,"viewCount":56,"searchKey":963,"visible":14},{"type":10,"entryId":12,"sortOrder":964,"name":78,"imageUrl":965,"description":966,"currentMorphology":9,"currentStage":238,"position":967,"attributes":968},1043300,"/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[23],[25],{"id":970,"viewCount":56,"searchKey":971,"visible":14},"10003272",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":9,"currentStage":21,"position":977,"attributes":978},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[23],[589],{"id":980,"viewCount":56,"searchKey":981,"visible":14},"10003254",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":9,"currentStage":187,"position":987,"attributes":988},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[23],[589],{"id":990,"viewCount":56,"searchKey":991,"visible":14},"10003163",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":9,"currentStage":238,"position":997,"attributes":998},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[23],[589],{"id":1000,"viewCount":56,"searchKey":1001,"visible":14},"10003204",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":9,"currentStage":21,"position":1007,"attributes":1008},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[377],[346],{"id":1010,"viewCount":56,"searchKey":1011,"visible":14},"10003205",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":9,"currentStage":238,"position":1017,"attributes":1018},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[377],[346],{"id":1020,"viewCount":56,"searchKey":1021,"visible":14},"10003324",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":9,"currentStage":175,"position":1027,"attributes":1028},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[377],[589],{"id":1030,"viewCount":56,"searchKey":1031,"visible":14},"10003269",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":9,"currentStage":21,"position":1037,"attributes":1038},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[377],[25,346],{"id":1040,"viewCount":56,"searchKey":1041,"visible":14},"10003261",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":9,"currentStage":238,"position":1047,"attributes":1048},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[377],[25,346],{"id":1050,"viewCount":56,"searchKey":1051,"visible":14},"10003305",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":9,"currentStage":21,"position":1057,"attributes":1058},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[250],[367],{"id":1060,"viewCount":56,"searchKey":1061,"visible":14},"10003232",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":9,"currentStage":238,"position":1067,"attributes":1068},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[250],[367],{"id":1070,"viewCount":56,"searchKey":1071,"visible":14},"10003198",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":9,"currentStage":21,"position":1077,"attributes":1078},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[344],[324,346],{"id":1080,"viewCount":56,"searchKey":1081,"visible":14},"10003194",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":9,"currentStage":238,"position":1087,"attributes":1088},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[344],[324,346],{"id":1090,"viewCount":56,"searchKey":1091,"visible":14},"10003185",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":9,"currentStage":21,"position":1097,"attributes":1098},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[217],[346],{"id":1100,"viewCount":56,"searchKey":1101,"visible":14},"10003284",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":9,"currentStage":238,"position":1107,"attributes":1108},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[217],[346],{"id":1110,"viewCount":56,"searchKey":1111,"visible":14},"10003188",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":9,"currentStage":21,"position":1117,"attributes":1118},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[217],[367],{"id":1120,"viewCount":56,"searchKey":1121,"visible":14},"10003182",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":9,"currentStage":238,"position":1127,"attributes":1128},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[217],[367],{"id":1130,"viewCount":56,"searchKey":1131,"visible":14},"10003273",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":9,"currentStage":175,"position":1137,"attributes":1138},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[217],[1139],"attributes-holy",{"id":1141,"viewCount":56,"searchKey":1142,"visible":14},"10003150",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":9,"currentStage":175,"position":1148,"attributes":1149},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[217],[1139],[1151,1159,1164,1167,1172,1177,1182,1187,1192,1197,1202,1206,1211,1215,1220,1225,1230,1235,1240],{"id":1152,"parentId":1153,"tagType":1154,"tagKey":1155,"name":1156,"language":1157,"sort":1158},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1160,"parentId":1153,"tagType":1154,"tagKey":1161,"name":1162,"language":1157,"sort":1163},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1165,"parentId":1153,"tagType":1154,"tagKey":9,"name":1166,"language":1157,"sort":28},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1168,"parentId":1153,"tagType":1154,"tagKey":1169,"name":1170,"language":1157,"sort":1171},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1173,"parentId":1153,"tagType":1154,"tagKey":1174,"name":1175,"language":1157,"