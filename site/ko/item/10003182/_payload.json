"label":74,"icon":75,"stage":28,"position":76,"stageStrength":28,"condition":77,"children":79},"root","엔젤후드","/cdn/init/Wiki_PetHead_10421.png",0,{"isVariant":66,"list":78},[],[80],{"id":81,"name":18,"label":18,"icon":82,"stage":57,"position":28,"stageStrength":57,"condition":83,"children":85},"91268209_6","/cdn/init/Wiki_PetHead_10423.png",{"isVariant":66,"list":84},[],[],"91268209_5",{"id":88,"type":61,"props":89,"children":93},"91268209_9",{"title":90,"type":91,"id":92,"isUse":14,"isEdit":14,"useTabs":66,"blackHeader":66},"홈 능력","small","91268209_10",[94,101],{"id":95,"type":96,"props":97,"children":58},"91268209_11","capsule",{"id":98,"customKey":99,"title":21,"icon":45,"bgColor":45,"fontColor":45,"type":100},"91268209_12","home-1005","spritePic",{"id":102,"type":96,"props":103,"children":58},"91268209_13",{"id":104,"customKey":105,"title":21,"icon":45,"bgColor":45,"fontColor":45,"type":100},"91268209_14","home-1101",{"id":107,"title":108,"components":109},2,"애니모 능력",[110,127],{"id":111,"type":61,"props":112,"children":115},"91268209_19",{"title":113,"type":64,"id":114,"isUse":14,"isEdit":14,"useTabs":66,"blackHeader":66},"애니모 특성","91268209_20",[116],{"id":117,"type":118,"props":119,"children":58},"91268209_21","circle",{"id":120,"customKey":45,"icon":121,"iconStyle":64,"iconTitle":45,"descTitle":122,"descContent":123,"source":124},"91268209_22","/cdn/init/1042300_Feature_142301_Icon.png","갈증","HP를 1% 잃을 때마다 피해가 0.8% 증가하고, 최대 48%까지 증가합니다.",{"attributes":125,"type":126,"consume":45,"power":45},[],[],{"id":128,"type":61,"props":129,"children":58},"91268209_23",{"title":130,"type":64,"id":131,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":66,"tabs":132},"스킬 소개","91268209_24",[133,174],{"id":134,"title":135,"children":136},"91268209_25","전투 스킬",[137,151,163],{"id":138,"type":118,"props":139},"91268209_26",{"id":140,"customKey":45,"icon":141,"iconStyle":64,"iconTitle":45,"descTitle":142,"descContent":143,"source":144},"91268209_27","/cdn/init/1042300_Skill_10200330_Icon.png","악마화","[악마화]를 활성화하면 에너지를 지속적으로 소모합니다. 다시 스킬을 누르면 상태가 종료되고, 자신 주위에 피해를 주고 변신 기간 준 피해의 30%만큼 HP를 회복합니다. 회복량은 최대 HP의 50%를 초과하지 않습니다.[악마화] 상태에서는 스킬 피해가 30% 증가하고, 스킬 소모가 현재 HP의 10% 소모로 변경됩니다. 스킬 6회 시전 후, 일반 공격을 길게 누르면 추가로 50 위력의 추가 피해를 줍니다.",{"attributes":145,"type":147,"consume":149,"power":150},[146],"2",[148],"1","0","65",{"id":152,"type":118,"props":153},"91268209_28",{"id":154,"customKey":45,"icon":155,"iconStyle":64,"iconTitle":45,"descTitle":156,"descContent":157,"source":158},"91268209_29","/cdn/init/1042300_Skill_10200320_Icon.png","난무","연속으로 다단 발톱 공격을 합니다. 공격 중 20% 피해 감소를 획득합니다.",{"attributes":159,"type":160,"consume":161,"power":162},[146],[148],"10","33",{"id":164,"type":118,"props":165},"91268209_30",{"id":166,"customKey":45,"icon":167,"iconStyle":64,"iconTitle":45,"descTitle":168,"descContent":169,"source":170},"91268209_31","/cdn/init/1042300_Skill_10200340_Icon.png","귀신 밟기","목표에게 돌진하여 공격하며, 명중 시 최대 HP의 5%를 회복합니다.",{"attributes":171,"type":172,"consume":161,"power":173},[146],[148],"13",{"id":175,"title":176,"children":177},"91268209_32","고유 스킬",[178,189],{"id":179,"type":118,"props":180},"91268209_33",{"id":181,"customKey":45,"icon":182,"iconStyle":64,"iconTitle":45,"descTitle":183,"descContent":184,"source":185},"91268209_34","/cdn/init/1042300_Skill_10200350_Icon.png","서릿불 단죄","궁극의 악마로 변신해 전방의 목표에게 연속 발톱 공격으로 피해를 주고, 마지막 일격에서 지속 피해를 부여합니다. 초당 6 위력의 피해를 주고 10초 동안 지속됩니다.",{"attributes":186,"type":187,"consume":149,"power":188},[146],[148],"154",{"id":190,"type":118,"props":191},"91268209_35",{"id":192,"customKey":45,"icon":193,"iconStyle":64,"iconTitle":45,"descTitle":194,"descContent":195,"source":196},"91268209_36","/cdn/init/1042300_Skill_12800000_Icon.png","공격","얼음 원소 능력을 사용하여 근거리에서 목표를 공격합니다.",{"attributes":197,"type":198,"consume":149,"power":199},[146],[146],"6",[201],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[203,214,224,234,246,256,266,278,288,298,308,319,329,341,351,361,372,382,392,402,412,422,432,443,453,463,473,483,493,503,513,523,533,543,553,563,573,584,594,604,614,624,634,644,654,664,674,684,694,704,714,724,734,744,754,764,774,784,794,804,814,824,834,844,854,864,874,884,894,904,914,924,934,944,954,964,974,984,994,1004,1014,1024,1034,1044,1054,1064,1074,1084,1094,1104,1114,1121,1125,1134],{"id":204,"viewCount":58,"searchKey":205,"visible":14},"10003217",{"type":10,"entryId":206,"sortOrder":207,"name":208,"imageUrl":209,"description":210,"currentMorphology":9,"currentStage":148,"position":211,"attributes":212},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[23],[213],"attributes-fire",{"id":215,"viewCount":58,"searchKey":216,"visible":14},"10003309",{"type":10,"entryId":217,"sortOrder":218,"name":219,"imageUrl":220,"description":221,"currentMorphology":9,"currentStage":146,"position":222,"attributes":223},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[23],[213],{"id":225,"viewCount":58,"searchKey":226,"visible":14},"10003210",{"type":10,"entryId":227,"sortOrder":228,"name":229,"imageUrl":230,"description":231,"currentMorphology":9,"currentStage":21,"position":232,"attributes":233},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[23],[213],{"id":235,"viewCount":58,"searchKey":236,"visible":14},"10003203",{"type":10,"entryId":237,"sortOrder":238,"name":239,"imageUrl":240,"description":241,"currentMorphology":9,"currentStage":21,"position":242,"attributes":244},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[243],"position-break",[213,245],"attributes-dark",{"id":247,"viewCount":58,"searchKey":248,"visible":14},"10003353",{"type":10,"entryId":249,"sortOrder":250,"name":251,"imageUrl":252,"description":253,"currentMorphology":9,"currentStage":148,"position":254,"attributes":255},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[23],[245],{"id":257,"viewCount":58,"searchKey":258,"visible":14},"10003192",{"type":10,"entryId":259,"sortOrder":260,"name":261,"imageUrl":262,"description":263,"currentMorphology":9,"currentStage":21,"position":264,"attributes":265},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[23],[245],{"id":267,"viewCount":58,"searchKey":268,"visible":14},"10003263",{"type":10,"entryId":269,"sortOrder":270,"name":271,"imageUrl":272,"description":273,"currentMorphology":9,"currentStage":148,"position":274,"attributes":276},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[275],"position-sup",[277],"attributes-wind",{"id":279,"viewCount":58,"searchKey":280,"visible":14},"10003323",{"type":10,"entryId":281,"sortOrder":282,"name":283,"imageUrl":284,"description":285,"currentMorphology":9,"currentStage":21,"position":286,"attributes":287},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[275],[277],{"id":289,"viewCount":58,"searchKey":290,"visible":14},"10003249",{"type":10,"entryId":291,"sortOrder":292,"name":293,"imageUrl":294,"description":295,"currentMorphology":9,"currentStage":21,"position":296,"attributes":297},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[23],[277],{"id":299,"viewCount":58,"searchKey":300,"visible":14},"10003242",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":9,"currentStage":21,"position":306,"attributes":307},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[243],[277],{"id":309,"viewCount":58,"searchKey":310,"visible":14},"10003167",{"type":10,"entryId":311,"sortOrder":312,"name":313,"imageUrl":314,"description":315,"currentMorphology":9,"currentStage":148,"position":316,"attributes":317},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[23],[318],"attributes-grass",{"id":320,"viewCount":58,"searchKey":321,"visible":14},"10003285",{"type":10,"entryId":322,"sortOrder":323,"name":324,"imageUrl":325,"description":326,"currentMorphology":9,"currentStage":21,"position":327,"attributes":328},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[23],[318],{"id":330,"viewCount":58,"searchKey":331,"visible":14},"10003252",{"type":10,"entryId":332,"sortOrder":333,"name":334,"imageUrl":335,"description":336,"currentMorphology":9,"currentStage":148,"position":337,"attributes":339},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[338],"position-heal",[340],"attributes-water",{"id":342,"viewCount":58,"searchKey":343,"visible":14},"10003344",{"type":10,"entryId":344,"sortOrder":345,"name":346,"imageUrl":347,"description":348,"currentMorphology":9,"currentStage":146,"position":349,"attributes":350},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[338],[340],{"id":352,"viewCount":58,"searchKey":353,"visible":14},"10003245",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":9,"currentStage":21,"position":359,"attributes":360},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[338],[340,25],{"id":362,"viewCount":58,"searchKey":363,"visible":14},"10003238",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":9,"currentStage":21,"position":369,"attributes":371},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[370],"position-energy",[318,340],{"id":373,"viewCount":58,"searchKey":374,"visible":14},"10003243",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":9,"currentStage":148,"position":380,"attributes":381},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[275],[277],{"id":383,"viewCount":58,"searchKey":384,"visible":14},"10003140",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":9,"currentStage":21,"position":390,"attributes":391},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[275],[277],{"id":393,"viewCount":58,"searchKey":394,"visible":14},"10003236",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":9,"currentStage":21,"position":400,"attributes":401},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[275],[245],{"id":403,"viewCount":58,"searchKey":404,"visible":14},"10003196",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":9,"currentStage":148,"position":410,"attributes":411},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[243],[318],{"id":413,"viewCount":58,"searchKey":414,"visible":14},"10003189",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":9,"currentStage":21,"position":420,"attributes":421},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[370],[245,318],{"id":423,"viewCount":58,"searchKey":424,"visible":14},"10003179",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":9,"currentStage":21,"position":430,"attributes":431},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[243],[318],{"id":433,"viewCount":58,"searchKey":434,"visible":14},"10003342",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":9,"currentStage":148,"position":440,"attributes":441},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[243],[442,318],"attributes-rock",{"id":444,"viewCount":58,"searchKey":445,"visible":14},"10003237",{"type":10,"entryId":446,"sortOrder":447,"name":448,"imageUrl":449,"description":450,"currentMorphology":9,"currentStage":21,"position":451,"attributes":452},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[243],[442,318],{"id":454,"viewCount":58,"searchKey":455,"visible":14},"10003326",{"type":10,"entryId":456,"sortOrder":457,"name":458,"imageUrl":459,"description":460,"currentMorphology":9,"currentStage":21,"position":461,"attributes":462},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[243],[25],{"id":464,"viewCount":58,"searchKey":465,"visible":14},"10003184",{"type":10,"entryId":466,"sortOrder":467,"name":468,"imageUrl":469,"description":470,"currentMorphology":9,"currentStage":148,"position":471,"attributes":472},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[370],[213],{"id":474,"viewCount":58,"searchKey":475,"visible":14},"10003282",{"type":10,"entryId":476,"sortOrder":477,"name":478,"imageUrl":479,"description":480,"currentMorphology":9,"currentStage":21,"position":481,"attributes":482},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[370],[213],{"id":484,"viewCount":58,"searchKey":485,"visible":14},"10003317",{"type":10,"entryId":486,"sortOrder":487,"name":488,"imageUrl":489,"description":490,"currentMorphology":9,"currentStage":148,"position":491,"attributes":492},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[338],[277],{"id":494,"viewCount":58,"searchKey":495,"visible":14},"10003215",{"type":10,"entryId":496,"sortOrder":497,"name":498,"imageUrl":499,"description":500,"currentMorphology":9,"currentStage":21,"position":501,"attributes":502},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[338],[277],{"id":504,"viewCount":58,"searchKey":505,"visible":14},"10003338",{"type":10,"entryId":506,"sortOrder":507,"name":508,"imageUrl":509,"description":510,"currentMorphology":9,"currentStage":149,"position":511,"attributes":512},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[370],[277,318],{"id":514,"viewCount":58,"searchKey":515,"visible":14},"10003143",{"type":10,"entryId":516,"sortOrder":517,"name":518,"imageUrl":519,"description":520,"currentMorphology":9,"currentStage":148,"position":521,"attributes":522},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[275],[277],{"id":524,"viewCount":58,"searchKey":525,"visible":14},"10003138",{"type":10,"entryId":526,"sortOrder":527,"name":528,"imageUrl":529,"description":530,"currentMorphology":9,"currentStage":21,"position":531,"attributes":532},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[275],[277],{"id":534,"viewCount":58,"searchKey":535,"visible":14},"10003290",{"type":10,"entryId":536,"sortOrder":537,"name":538,"imageUrl":539,"description":540,"currentMorphology":9,"currentStage":148,"position":541,"attributes":542},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[23],[318],{"id":544,"viewCount":58,"searchKey":545,"visible":14},"10003271",{"type":10,"entryId":546,"sortOrder":547,"name":548,"imageUrl":549,"description":550,"currentMorphology":9,"currentStage":21,"position":551,"attributes":552},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[23],[318],{"id":554,"viewCount":58,"searchKey":555,"visible":14},"10003153",{"type":10,"entryId":556,"sortOrder":557,"name":558,"imageUrl":559,"description":560,"currentMorphology":9,"currentStage":21,"position":561,"attributes":562},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[275],[318],{"id":564,"viewCount":58,"searchKey":565,"visible":14},"10003231",{"type":10,"entryId":566,"sortOrder":567,"name":568,"imageUrl":569,"description":570,"currentMorphology":9,"currentStage":148,"position":571,"attributes":572},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[243],[318],{"id":574,"viewCount":58,"searchKey":575,"visible":14},"10003149",{"type":10,"entryId":576,"sortOrder":577,"name":578,"imageUrl":579,"description":580,"currentMorphology":9,"currentStage":21,"position":581,"attributes":582},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[275],[583],"attributes-electric",{"id":585,"viewCount":58,"searchKey":586,"visible":14},"10003218",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":9,"currentStage":21,"position":592,"attributes":593},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[243],[318],{"id":595,"viewCount":58,"searchKey":596,"visible":14},"10003278",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":9,"currentStage":148,"position":602,"attributes":603},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[275],[245],{"id":605,"viewCount":58,"searchKey":606,"visible":14},"10003296",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":9,"currentStage":21,"position":612,"attributes":613},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[275],[245],{"id":615,"viewCount":58,"searchKey":616,"visible":14},"10003283",{"type":10,"entryId":617,"sortOrder":618,"name":619,"imageUrl":620,"description":621,"currentMorphology":9,"currentStage":148,"position":622,"attributes":623},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[23],[245],{"id":625,"viewCount":58,"searchKey":626,"visible":14},"10003144",{"type":10,"entryId":627,"sortOrder":628,"name":629,"imageUrl":630,"description":631,"currentMorphology":9,"currentStage":21,"position":632,"attributes":633},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[23],[245],{"id":635,"viewCount":58,"searchKey":636,"visible":14},"10003276",{"type":10,"entryId":637,"sortOrder":638,"name":639,"imageUrl":640,"description":641,"currentMorphology":9,"currentStage":21,"position":642,"attributes":643},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[23],[583],{"id":645,"viewCount":58,"searchKey":646,"visible":14},"10003197",{"type":10,"entryId":647,"sortOrder":648,"name":649,"imageUrl":650,"description":651,"currentMorphology":9,"currentStage":148,"position":652,"attributes":653},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[23],[25],{"id":655,"viewCount":58,"searchKey":656,"visible":14},"10003350",{"type":10,"entryId":657,"sortOrder":658,"name":659,"imageUrl":660,"description":661,"currentMorphology":9,"currentStage":146,"position":662,"attributes":663},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[23],[25],{"id":665,"viewCount":58,"searchKey":666,"visible":14},"10003190",{"type":10,"entryId":667,"sortOrder":668,"name":669,"imageUrl":670,"description":671,"currentMorphology":9,"currentStage":21,"position":672,"attributes":673},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[23],[25],{"id":675,"viewCount":58,"searchKey":676,"visible":14},"10003299",{"type":10,"entryId":677,"sortOrder":678,"name":679,"imageUrl":680,"description":681,"currentMorphology":9,"currentStage":148,"position":682,"attributes":683},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[243],[583],{"id":685,"viewCount":58,"searchKey":686,"visible":14},"10003250",{"type":10,"entryId":687,"sortOrder":688,"name":689,"imageUrl":690,"description":691,"currentMorphology":9,"currentStage":21,"position":692,"attributes":693},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[243],[583],{"id":695,"viewCount":58,"searchKey":696,"visible":14},"10003298",{"type":10,"entryId":697,"sortOrder":698,"name":699,"imageUrl":700,"description":701,"currentMorphology":9,"currentStage":148,"position":702,"attributes":703},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[243],[340],{"id":705,"viewCount":58,"searchKey":706,"visible":14},"10003173",{"type":10,"entryId":707,"sortOrder":708,"name":709,"imageUrl":710,"description":711,"currentMorphology":9,"currentStage":146,"position":712,"attributes":713},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[243],[340],{"id":715,"viewCount":58,"searchKey":716,"visible":14},"10003291",{"type":10,"entryId":717,"sortOrder":718,"name":719,"imageUrl":720,"description":721,"currentMorphology":9,"currentStage":21,"position":722,"attributes":723},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[275],[340],{"id":725,"viewCount":58,"searchKey":726,"visible":14},"10003341",{"type":10,"entryId":727,"sortOrder":728,"name":729,"imageUrl":730,"description":731,"currentMorphology":9,"currentStage":21,"position":732,"attributes":733},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[243],[340],{"id":735,"viewCount":58,"searchKey":736,"visible":14},"10003228",{"type":10,"entryId":737,"sortOrder":738,"name":739,"imageUrl":740,"description":741,"currentMorphology":9,"currentStage":148,"position":742,"attributes":743},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[23],[340],{"id":745,"viewCount":58,"searchKey":746,"visible":14},"10003352",{"type":10,"entryId":747,"sortOrder":748,"name":749,"imageUrl":750,"description":751,"currentMorphology":9,"currentStage":146,"position":752,"attributes":753},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[23],[340],{"id":755,"viewCount":58,"searchKey":756,"visible":14},"10003345",{"type":10,"entryId":757,"sortOrder":758,"name":759,"imageUrl":760,"description":761,"currentMorphology":9,"currentStage":21,"position":762,"attributes":763},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[23],[340],{"id":765,"viewCount":58,"searchKey":766,"visible":14},"10003340",{"type":10,"entryId":767,"sortOrder":768,"name":769,"imageUrl":770,"description":771,"currentMorphology":9,"currentStage":148,"position":772,"attributes":773},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[23],[442],{"id":775,"viewCount":58,"searchKey":776,"visible":14},"10003251",{"type":10,"entryId":777,"sortOrder":778,"name":779,"imageUrl":780,"description":781,"currentMorphology":9,"currentStage":21,"position":782,"attributes":783},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[23],[442],{"id":785,"viewCount":58,"searchKey":786,"visible":14},"10003241",{"type":10,"entryId":787,"sortOrder":788,"name":789,"imageUrl":790,"description":791,"currentMorphology":9,"currentStage":21,"position":792,"attributes":793},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[275],[442],{"id":795,"viewCount":58,"searchKey":796,"visible":14},"10003154",{"type":10,"entryId":797,"sortOrder":798,"name":799,"imageUrl":800,"description":801,"currentMorphology":9,"currentStage":148,"position":802,"attributes":803},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[23],[583],{"id":805,"viewCount":58,"searchKey":806,"visible":14},"10003151",{"type":10,"entryId":807,"sortOrder":808,"name":809,"imageUrl":810,"description":811,"currentMorphology":9,"currentStage":21,"position":812,"attributes":813},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[23],[583],{"id":815,"viewCount":58,"searchKey":816,"visible":14},"10003318",{"type":10,"entryId":817,"sortOrder":818,"name":819,"imageUrl":820,"description":821,"currentMorphology":9,"currentStage":148,"position":822,"attributes":823},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[243],[245],{"id":825,"viewCount":58,"searchKey":826,"visible":14},"10003332",{"type":10,"entryId":827,"sortOrder":828,"name":829,"imageUrl":830,"description":831,"currentMorphology":9,"currentStage":21,"position":832,"attributes":833},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[23],[245],{"id":835,"viewCount":58,"searchKey":836,"visible":14},"10003297",{"type":10,"entryId":837,"sortOrder":838,"name":839,"imageUrl":840,"description":841,"currentMorphology":9,"currentStage":21,"position":842,"attributes":843},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[243],[245],{"id":845,"viewCount":58,"searchKey":846,"visible":14},"10003354",{"type":10,"entryId":847,"sortOrder":848,"name":849,"imageUrl":850,"description":851,"currentMorphology":9,"currentStage":148,"position":852,"attributes":853},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[243],[277],{"id":855,"viewCount":58,"searchKey":856,"visible":14},"10003164",{"type":10,"entryId":857,"sortOrder":858,"name":859,"imageUrl":860,"description":861,"currentMorphology":9,"currentStage":146,"position":862,"attributes":863},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[243],[277],{"id":865,"viewCount":58,"searchKey":866,"visible":14},"10003311",{"type":10,"entryId":867,"sortOrder":868,"name":869,"imageUrl":870,"description":871,"currentMorphology":9,"currentStage":21,"position":872,"attributes":873},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[243],[277],{"id":875,"viewCount":58,"searchKey":876,"visible":14},"10003304",{"type":10,"entryId":877,"sortOrder":878,"name":879,"imageUrl":880,"description":881,"currentMorphology":9,"currentStage":21,"position":882,"attributes":883},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[23],[213],{"id":885,"viewCount":58,"searchKey":886,"visible":14},"10003208",{"type":10,"entryId":887,"sortOrder":888,"name":889,"imageUrl":890,"description":891,"currentMorphology":9,"currentStage":148,"position":892,"attributes":893},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[23],[442],{"id":895,"viewCount":58,"searchKey":896,"visible":14},"10003202",{"type":10,"entryId":897,"sortOrder":898,"name":899,"imageUrl":900,"description":901,"currentMorphology":9,"currentStage":21,"position":902,"attributes":903},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[23],[442],{"id":905,"viewCount":58,"searchKey":906,"visible":14},"10003180",{"type":10,"entryId":907,"sortOrder":908,"name":909,"imageUrl":910,"description":911,"currentMorphology":9,"currentStage":148,"position":912,"attributes":913},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[243],[442],{"id":915,"viewCount":58,"searchKey":916,"visible":14},"10003300",{"type":10,"entryId":917,"sortOrder":918,"name":919,"imageUrl":920,"description":921,"currentMorphology":9,"currentStage":146,"position":922,"attributes":923},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[243],[213,442],{"id":925,"viewCount":58,"searchKey":926,"visible":14},"10003174",{"type":10,"entryId":927,"sortOrder":928,"name":929,"imageUrl":930,"description":931,"currentMorphology":9,"currentStage":21,"position":932,"attributes":933},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[243],[213,442],{"id":935,"viewCount":58,"searchKey":936,"visible":14},"10003293",{"type":10,"entryId":937,"sortOrder":938,"name":939,"imageUrl":940,"description":941,"currentMorphology":9,"currentStage":146,"position":942,"attributes":943},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[243],[442],{"id":945,"viewCount":58,"searchKey":946,"visible":14},"10003168",{"type":10,"entryId":947,"sortOrder":948,"name":949,"imageUrl":950,"description":951,"currentMorphology":9,"currentStage":21,"position":952,"attributes":953},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[243],[442],{"id":955,"viewCount":58,"searchKey":956,"visible":14},"10003161",{"type":10,"entryId":957,"sortOrder":958,"name":959,"imageUrl":960,"description":961,"currentMorphology":9,"currentStage":148,"position":962,"attributes":963},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[275],[442],{"id":965,"viewCount":58,"searchKey":966,"visible":14},"10003222",{"type":10,"entryId":967,"sortOrder":968,"name":969,"imageUrl":970,"description":971,"currentMorphology":9,"currentStage":21,"position":972,"attributes":973},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[275],[442],{"id":975,"viewCount":58,"searchKey":976,"visible":14},"10003272",{"type":10,"entryId":977,"sortOrder":978,"name":979,"imageUrl":980,"description":981,"currentMorphology":9,"currentStage":148,"position":982,"attributes":983},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[275],[583],{"id":985,"viewCount":58,"searchKey":986,"visible":14},"10003254",{"type":10,"entryId":987,"sortOrder":988,"name":989,"imageUrl":990,"description":991,"currentMorphology":9,"currentStage":146,"position":992,"attributes":993},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[275],[583],{"id":995,"viewCount":58,"searchKey":996,"visible":14},"10003163",{"type":10,"entryId":997,"sortOrder":998,"name":999,"imageUrl":1000,"description":1001,"currentMorphology":9,"currentStage":21,"position":1002,"attributes":1003},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[275],[583],{"id":1005,"viewCount":58,"searchKey":1006,"visible":14},"10003204",{"type":10,"entryId":1007,"sortOrder":1008,"name":1009,"imageUrl":1010,"description":1011,"currentMorphology":9,"currentStage":148,"position":1012,"attributes":1013},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[370],[340],{"id":1015,"viewCount":58,"searchKey":1016,"visible":14},"10003205",{"type":10,"entryId":1017,"sortOrder":1018,"name":1019,"imageUrl":1020,"description":1021,"currentMorphology":9,"currentStage":21,"position":1022,"attributes":1023},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[370],[340],{"id":1025,"viewCount":58,"searchKey":1026,"visible":14},"10003324",{"type":10,"entryId":1027,"sortOrder":1028,"name":1029,"imageUrl":1030,"description":1031,"currentMorphology":9,"currentStage":149,"position":1032,"attributes":1033},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[370],[583],{"id":1035,"viewCount":58,"searchKey":1036,"visible":14},"10003269",{"type":10,"entryId":1037,"sortOrder":1038,"name":1039,"imageUrl":1040,"description":1041,"currentMorphology":9,"currentStage":148,"position":1042,"attributes":1043},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[370],[442,340],{"id":1045,"viewCount":58,"searchKey":1046,"visible":14},"10003261",{"type":10,"entryId":1047,"sortOrder":1048,"name":1049,"imageUrl":1050,"description":1051,"currentMorphology":9,"currentStage":21,"position":1052,"attributes":1053},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[370],[442,340],{"id":1055,"viewCount":58,"searchKey":1056,"visible":14},"10003305",{"type":10,"entryId":1057,"sortOrder":1058,"name":1059,"imageUrl":1060,"description":1061,"currentMorphology":9,"currentStage":148,"position":1062,"attributes":1063},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[243],[25],{"id":1065,"viewCount":58,"searchKey":1066,"visible":14},"10003232",{"type":10,"entryId":1067,"sortOrder":1068,"name":1069,"imageUrl":1070,"description":1071,"currentMorphology":9,"currentStage":21,"position":1072,"attributes":1073},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[243],[25],{"id":1075,"viewCount":58,"searchKey":1076,"visible":14},"10003198",{"type":10,"entryId":1077,"sortOrder":1078,"name":1079,"imageUrl":1080,"description":1081,"currentMorphology":9,"currentStage":148,"position":1082,"attributes":1083},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[338],[318,340],{"id":1085,"viewCount":58,"searchKey":1086,"visible":14},"10003194",{"type":10,"entryId":1087,"sortOrder":1088,"name":1089,"imageUrl":1090,"description":1091,"currentMorphology":9,"currentStage":21,"position":1092,"attributes":1093},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[338],[318,340],{"id":1095,"viewCount":58,"searchKey":1096,"visible":14},"10003185",{"type":10,"entryId":1097,"sortOrder":1098,"name":1099,"imageUrl":1100,"description":1101,"currentMorphology":9,"currentStage":148,"position":1102,"attributes":1103},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[23],[340],{"id":1105,"viewCount":58,"searchKey":1106,"visible":14},"10003284",{"type":10,"entryId":1107,"sortOrder":1108,"name":1109,"imageUrl":1110,"description":1111,"currentMorphology":9,"currentStage":21,"position":1112,"attributes":1113},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[23],[340],{"id":5,"viewCount":58,"searchKey":1115,"visible":14},{"type":10,"entryId":8,"sortOrder":1116,"name":74,"imageUrl":1117,"description":1118,"currentMorphology":9,"currentStage":148,"position":1119,"attributes":1120},1042100,"/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[23],[25],{"id":4,"viewCount":58,"searchKey":1122,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1123,"attributes":1124},[23],[25],{"id":6,"viewCount":58,"searchKey":1126,"visible":14},{"type":10,"entryId":12,"sortOrder":1127,"name":1128,"imageUrl":1129,"description":1130,"currentMorphology":9,"currentStage":149,"position":1131,"attributes":1132},1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[23],[1133],"attributes-holy",{"id":1135,"viewCount":58,"searchKey":1136,"visible":14},"10003150",{"type":10,"entryId":1137,"sortOrder":1138,"name":1139,"imageUrl":1140,"description":1141,"currentMorphology":9,"currentStage":149,"position":1142,"attributes":1143},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[23],[1133],[1145,1153,1158,1161,1166,1171,1176,1181,1186,1191,1196,1200,1205,1209,1214,1219,1224,1229,1234],{"id":1146,"parentId":1147,"tagType":1148,"tagKey":1149,"name":1150,"language":1151,"sort":1152},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1154,"parentId":1147,"tagType":1148,"tagKey":1155,"name":1156,"language":1151,"sort":1157},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1159,"parentId":1147,"tagType":1148,"tagKey":9,"name":1160,"language":1151,"sort":28},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1162,"parentId":1147,"tagType":1148,"tagKey":1163,"name":1164,"language":1151,"sort":1165},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1167,"parentId":1147,"tagType":1148,"tagKey":1168,"name":1169,"language":1151