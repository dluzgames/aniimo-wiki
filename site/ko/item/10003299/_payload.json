43,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"탐사 스킬","91268328_22",[145],{"id":146,"type":131,"props":147,"children":57},"91268328_23",{"id":148,"customKey":47,"icon":149,"iconStyle":90,"iconTitle":47,"descTitle":150,"descContent":151,"source":152},"91268328_24","/cdn/init/1022100_Skill_9400109_Icon.png","하이 점프","1회 높이 점프합니다.",{"attributes":153,"type":154,"consume":47,"power":47},[],[],{"id":156,"type":60,"props":157,"children":160},"91268328_25",{"title":158,"type":63,"id":159,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"애니모 특성","91268328_26",[161],{"id":162,"type":131,"props":163,"children":57},"91268328_27",{"id":164,"customKey":47,"icon":165,"iconStyle":63,"iconTitle":47,"descTitle":166,"descContent":167,"source":168},"91268328_28","/cdn/init/1022100_Feature_12222_Icon.png","전력 지속","스킬로 치명타를 6회 적중시키면 [전격 상태]로 전환됩니다. 즉시 HP의 5%에 해당하는 실드를 획득하고 모든 스킬의 에너지 소모가 12 감소합니다. 지속 시간 동안 궁극기 게이지를 획득할 수 없으며 6초 동안 지속됩니다.",{"attributes":169,"type":170,"consume":47,"power":47},[],[],{"id":172,"type":60,"props":173,"children":57},"91268328_29",{"title":174,"type":63,"id":175,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":65,"tabs":176},"스킬 소개","91268328_30",[177,204],{"id":178,"title":179,"children":180},"91268328_31","전투 스킬",[181,194],{"id":182,"type":131,"props":183},"91268328_32",{"id":184,"customKey":47,"icon":185,"iconStyle":63,"iconTitle":47,"descTitle":186,"descContent":187,"source":188},"91268328_33","/cdn/init/1022100_Skill_10400210_Icon.png","볼트 충격","전기를 띠고 목표에게 돌진하여 피해를 줍니다.",{"attributes":189,"type":191,"consume":192,"power":193},[190],"4",[22],"20","48",{"id":195,"type":131,"props":196},"91268328_34",{"id":197,"customKey":47,"icon":198,"iconStyle":63,"iconTitle":47,"descTitle":199,"descContent":200,"source":201},"91268328_35","/cdn/init/1022100_Skill_10400202_Icon.png","번개 꼬리","번개의 힘을 다룹니다. 꼬리를 휘둘러 전방의 목표를 공격하며, 스킬에 추가로 50%의 치명타율이 적용됩니다.",{"attributes":202,"type":203,"consume":192,"power":192},[190],[22],{"id":205,"title":206,"children":207},"91268328_36","고유 스킬",[208],{"id":209,"type":131,"props":210},"91268328_37",{"id":211,"customKey":47,"icon":212,"iconStyle":63,"iconTitle":47,"descTitle":213,"descContent":214,"source":215},"91268328_38","/cdn/init/1022100_Skill_10400000_Icon.png","공격","전기 원소 능력을 사용하여 근거리에서 목표를 공격합니다.",{"attributes":216,"type":217,"consume":218,"power":219},[190],[22],"0","6",[221,222],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},[224,236,247,258,269,279,289,301,311,321,331,342,352,364,374,385,396,406,416,426,436,446,456,467,477,487,497,507,517,527,537,547,557,567,577,587,597,607,617,627,637,647,657,667,677,687,696,700,709,719,729,739,749,759,769,779,789,799,809,819,829,839,849,859,869,879,889,899,909,919,929,939,949,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1139,1149,1160],{"id":225,"viewCount":57,"searchKey":226,"visible":15},"10003217",{"type":10,"entryId":227,"sortOrder":228,"name":229,"imageUrl":230,"description":231,"currentMorphology":21,"currentStage":22,"position":232,"attributes":234},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[233],"position-dps",[235],"attributes-fire",{"id":237,"viewCount":57,"searchKey":238,"visible":15},"10003309",{"type":10,"entryId":239,"sortOrder":240,"name":241,"imageUrl":242,"description":243,"currentMorphology":21,"currentStage":244,"position":245,"attributes":246},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[233],[235],{"id":248,"viewCount":57,"searchKey":249,"visible":15},"10003210",{"type":10,"entryId":250,"sortOrder":251,"name":252,"imageUrl":253,"description":254,"currentMorphology":21,"currentStage":255,"position":256,"attributes":257},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[233],[235],{"id":259,"viewCount":57,"searchKey":260,"visible":15},"10003203",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":21,"currentStage":255,"position":266,"attributes":267},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[24],[235,268],"attributes-dark",{"id":270,"viewCount":57,"searchKey":271,"visible":15},"10003353",{"type":10,"entryId":272,"sortOrder":273,"name":274,"imageUrl":275,"description":276,"currentMorphology":21,"currentStage":22,"position":277,"attributes":278},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[233],[268],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10003192",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":21,"currentStage":255,"position":287,"attributes":288},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[233],[268],{"id":290,"viewCount":57,"searchKey":291,"visible":15},"10003263",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":21,"currentStage":22,"position":297,"attributes":299},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[298],"position-sup",[300],"attributes-wind",{"id":302,"viewCount":57,"searchKey":303,"visible":15},"10003323",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":21,"currentStage":255,"position":309,"attributes":310},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[298],[300],{"id":312,"viewCount":57,"searchKey":313,"visible":15},"10003249",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":21,"currentStage":255,"position":319,"attributes":320},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[233],[300],{"id":322,"viewCount":57,"searchKey":323,"visible":15},"10003242",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":21,"currentStage":255,"position":329,"attributes":330},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[24],[300],{"id":332,"viewCount":57,"searchKey":333,"visible":15},"10003167",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":21,"currentStage":22,"position":339,"attributes":340},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[233],[341],"attributes-grass",{"id":343,"viewCount":57,"searchKey":344,"visible":15},"10003285",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":21,"currentStage":255,"position":350,"attributes":351},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[233],[341],{"id":353,"viewCount":57,"searchKey":354,"visible":15},"10003252",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":21,"currentStage":22,"position":360,"attributes":362},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[361],"position-heal",[363],"attributes-water",{"id":365,"viewCount":57,"searchKey":366,"visible":15},"10003344",{"type":10,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":21,"currentStage":244,"position":372,"attributes":373},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[361],[363],{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10003245",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":21,"currentStage":255,"position":382,"attributes":383},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[361],[363,384],"attributes-ice",{"id":386,"viewCount":57,"searchKey":387,"visible":15},"10003238",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":21,"currentStage":255,"position":393,"attributes":395},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[394],"position-energy",[341,363],{"id":397,"viewCount":57,"searchKey":398,"visible":15},"10003243",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":21,"currentStage":22,"position":404,"attributes":405},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[298],[300],{"id":407,"viewCount":57,"searchKey":408,"visible":15},"10003140",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":21,"currentStage":255,"position":414,"attributes":415},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[298],[300],{"id":417,"viewCount":57,"searchKey":418,"visible":15},"10003236",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":21,"currentStage":255,"position":424,"attributes":425},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[298],[268],{"id":427,"viewCount":57,"searchKey":428,"visible":15},"10003196",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":21,"currentStage":22,"position":434,"attributes":435},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[24],[341],{"id":437,"viewCount":57,"searchKey":438,"visible":15},"10003189",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":21,"currentStage":255,"position":444,"attributes":445},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[394],[268,341],{"id":447,"viewCount":57,"searchKey":448,"visible":15},"10003179",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":21,"currentStage":255,"position":454,"attributes":455},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[24],[341],{"id":457,"viewCount":57,"searchKey":458,"visible":15},"10003342",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":21,"currentStage":22,"position":464,"attributes":465},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[24],[466,341],"attributes-rock",{"id":468,"viewCount":57,"searchKey":469,"visible":15},"10003237",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":21,"currentStage":255,"position":475,"attributes":476},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[24],[466,341],{"id":478,"viewCount":57,"searchKey":479,"visible":15},"10003326",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":21,"currentStage":255,"position":485,"attributes":486},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[24],[384],{"id":488,"viewCount":57,"searchKey":489,"visible":15},"10003184",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":21,"currentStage":22,"position":495,"attributes":496},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[394],[235],{"id":498,"viewCount":57,"searchKey":499,"visible":15},"10003282",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":21,"currentStage":255,"position":505,"attributes":506},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[394],[235],{"id":508,"viewCount":57,"searchKey":509,"visible":15},"10003317",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":21,"currentStage":22,"position":515,"attributes":516},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[361],[300],{"id":518,"viewCount":57,"searchKey":519,"visible":15},"10003215",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":21,"currentStage":255,"position":525,"attributes":526},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[361],[300],{"id":528,"viewCount":57,"searchKey":529,"visible":15},"10003338",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":21,"currentStage":218,"position":535,"attributes":536},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[394],[300,341],{"id":538,"viewCount":57,"searchKey":539,"visible":15},"10003143",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":21,"currentStage":22,"position":545,"attributes":546},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[298],[300],{"id":548,"viewCount":57,"searchKey":549,"visible":15},"10003138",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":21,"currentStage":255,"position":555,"attributes":556},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[298],[300],{"id":558,"viewCount":57,"searchKey":559,"visible":15},"10003290",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":21,"currentStage":22,"position":565,"attributes":566},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[233],[341],{"id":568,"viewCount":57,"searchKey":569,"visible":15},"10003271",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":21,"currentStage":255,"position":575,"attributes":576},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[233],[341],{"id":578,"viewCount":57,"searchKey":579,"visible":15},"10003153",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":21,"currentStage":255,"position":585,"attributes":586},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[298],[341],{"id":588,"viewCount":57,"searchKey":589,"visible":15},"10003231",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":21,"currentStage":22,"position":595,"attributes":596},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[24],[341],{"id":598,"viewCount":57,"searchKey":599,"visible":15},"10003149",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":21,"currentStage":255,"position":605,"attributes":606},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[298],[26],{"id":608,"viewCount":57,"searchKey":609,"visible":15},"10003218",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":21,"currentStage":255,"position":615,"attributes":616},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[24],[341],{"id":618,"viewCount":57,"searchKey":619,"visible":15},"10003278",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":21,"currentStage":22,"position":625,"attributes":626},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[298],[268],{"id":628,"viewCount":57,"searchKey":629,"visible":15},"10003296",{"type":10,"entryId":630,"sortOrder":631,"name":632,"imageUrl":633,"description":634,"currentMorphology":21,"currentStage":255,"position":635,"attributes":636},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[298],[268],{"id":638,"viewCount":57,"searchKey":639,"visible":15},"10003283",{"type":10,"entryId":640,"sortOrder":641,"name":642,"imageUrl":643,"description":644,"currentMorphology":21,"currentStage":22,"position":645,"attributes":646},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[233],[268],{"id":648,"viewCount":57,"searchKey":649,"visible":15},"10003144",{"type":10,"entryId":650,"sortOrder":651,"name":652,"imageUrl":653,"description":654,"currentMorphology":21,"currentStage":255,"position":655,"attributes":656},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[233],[268],{"id":658,"viewCount":57,"searchKey":659,"visible":15},"10003276",{"type":10,"entryId":660,"sortOrder":661,"name":662,"imageUrl":663,"description":664,"currentMorphology":21,"currentStage":255,"position":665,"attributes":666},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[233],[26],{"id":668,"viewCount":57,"searchKey":669,"visible":15},"10003197",{"type":10,"entryId":670,"sortOrder":671,"name":672,"imageUrl":673,"description":674,"currentMorphology":21,"currentStage":22,"position":675,"attributes":676},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[233],[384],{"id":678,"viewCount":57,"searchKey":679,"visible":15},"10003350",{"type":10,"entryId":680,"sortOrder":681,"name":682,"imageUrl":683,"description":684,"currentMorphology":21,"currentStage":244,"position":685,"attributes":686},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[233],[384],{"id":688,"viewCount":57,"searchKey":689,"visible":15},"10003190",{"type":10,"entryId":8,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":21,"currentStage":255,"position":694,"attributes":695},1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[233],[384],{"id":4,"viewCount":57,"searchKey":697,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":698,"attributes":699},[24],[26],{"id":701,"viewCount":57,"searchKey":702,"visible":15},"10003250",{"type":10,"entryId":703,"sortOrder":704,"name":79,"imageUrl":705,"description":706,"currentMorphology":21,"currentStage":255,"position":707,"attributes":708},"049",1022200,"/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[24],[26],{"id":710,"viewCount":57,"searchKey":711,"visible":15},"10003298",{"type":10,"entryId":712,"sortOrder":713,"name":714,"imageUrl":715,"description":716,"currentMorphology":21,"currentStage":22,"position":717,"attributes":718},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[24],[363],{"id":720,"viewCount":57,"searchKey":721,"visible":15},"10003173",{"type":10,"entryId":722,"sortOrder":723,"name":724,"imageUrl":725,"description":726,"currentMorphology":21,"currentStage":244,"position":727,"attributes":728},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[24],[363],{"id":730,"viewCount":57,"searchKey":731,"visible":15},"10003291",{"type":10,"entryId":732,"sortOrder":733,"name":734,"imageUrl":735,"description":736,"currentMorphology":21,"currentStage":255,"position":737,"attributes":738},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[298],[363],{"id":740,"viewCount":57,"searchKey":741,"visible":15},"10003341",{"type":10,"entryId":742,"sortOrder":743,"name":744,"imageUrl":745,"description":746,"currentMorphology":21,"currentStage":255,"position":747,"attributes":748},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[24],[363],{"id":750,"viewCount":57,"searchKey":751,"visible":15},"10003228",{"type":10,"entryId":752,"sortOrder":753,"name":754,"imageUrl":755,"description":756,"currentMorphology":21,"currentStage":22,"position":757,"attributes":758},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[233],[363],{"id":760,"viewCount":57,"searchKey":761,"visible":15},"10003352",{"type":10,"entryId":762,"sortOrder":763,"name":764,"imageUrl":765,"description":766,"currentMorphology":21,"currentStage":244,"position":767,"attributes":768},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[233],[363],{"id":770,"viewCount":57,"searchKey":771,"visible":15},"10003345",{"type":10,"entryId":772,"sortOrder":773,"name":774,"imageUrl":775,"description":776,"currentMorphology":21,"currentStage":255,"position":777,"attributes":778},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[233],[363],{"id":780,"viewCount":57,"searchKey":781,"visible":15},"10003340",{"type":10,"entryId":782,"sortOrder":783,"name":784,"imageUrl":785,"description":786,"currentMorphology":21,"currentStage":22,"position":787,"attributes":788},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[233],[466],{"id":790,"viewCount":57,"searchKey":791,"visible":15},"10003251",{"type":10,"entryId":792,"sortOrder":793,"name":794,"imageUrl":795,"description":796,"currentMorphology":21,"currentStage":255,"position":797,"attributes":798},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[233],[466],{"id":800,"viewCount":57,"searchKey":801,"visible":15},"10003241",{"type":10,"entryId":802,"sortOrder":803,"name":804,"imageUrl":805,"description":806,"currentMorphology":21,"currentStage":255,"position":807,"attributes":808},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[298],[466],{"id":810,"viewCount":57,"searchKey":811,"visible":15},"10003154",{"type":10,"entryId":812,"sortOrder":813,"name":814,"imageUrl":815,"description":816,"currentMorphology":21,"currentStage":22,"position":817,"attributes":818},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[233],[26],{"id":820,"viewCount":57,"searchKey":821,"visible":15},"10003151",{"type":10,"entryId":822,"sortOrder":823,"name":824,"imageUrl":825,"description":826,"currentMorphology":21,"currentStage":255,"position":827,"attributes":828},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[233],[26],{"id":830,"viewCount":57,"searchKey":831,"visible":15},"10003318",{"type":10,"entryId":832,"sortOrder":833,"name":834,"imageUrl":835,"description":836,"currentMorphology":21,"currentStage":22,"position":837,"attributes":838},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[24],[268],{"id":840,"viewCount":57,"searchKey":841,"visible":15},"10003332",{"type":10,"entryId":842,"sortOrder":843,"name":844,"imageUrl":845,"description":846,"currentMorphology":21,"currentStage":255,"position":847,"attributes":848},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[233],[268],{"id":850,"viewCount":57,"searchKey":851,"visible":15},"10003297",{"type":10,"entryId":852,"sortOrder":853,"name":854,"imageUrl":855,"description":856,"currentMorphology":21,"currentStage":255,"position":857,"attributes":858},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[24],[268],{"id":860,"viewCount":57,"searchKey":861,"visible":15},"10003354",{"type":10,"entryId":862,"sortOrder":863,"name":864,"imageUrl":865,"description":866,"currentMorphology":21,"currentStage":22,"position":867,"attributes":868},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[24],[300],{"id":870,"viewCount":57,"searchKey":871,"visible":15},"10003164",{"type":10,"entryId":872,"sortOrder":873,"name":874,"imageUrl":875,"description":876,"currentMorphology":21,"currentStage":244,"position":877,"attributes":878},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[24],[300],{"id":880,"viewCount":57,"searchKey":881,"visible":15},"10003311",{"type":10,"entryId":882,"sortOrder":883,"name":884,"imageUrl":885,"description":886,"currentMorphology":21,"currentStage":255,"position":887,"attributes":888},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[24],[300],{"id":890,"viewCount":57,"searchKey":891,"visible":15},"10003304",{"type":10,"entryId":892,"sortOrder":893,"name":894,"imageUrl":895,"description":896,"currentMorphology":21,"currentStage":255,"position":897,"attributes":898},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[233],[235],{"id":900,"viewCount":57,"searchKey":901,"visible":15},"10003208",{"type":10,"entryId":902,"sortOrder":903,"name":904,"imageUrl":905,"description":906,"currentMorphology":21,"currentStage":22,"position":907,"attributes":908},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[233],[466],{"id":910,"viewCount":57,"searchKey":911,"visible":15},"10003202",{"type":10,"entryId":912,"sortOrder":913,"name":914,"imageUrl":915,"description":916,"currentMorphology":21,"currentStage":255,"position":917,"attributes":918},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[233],[466],{"id":920,"viewCount":57,"searchKey":921,"visible":15},"10003180",{"type":10,"entryId":922,"sortOrder":923,"name":924,"imageUrl":925,"description":926,"currentMorphology":21,"currentStage":22,"position":927,"attributes":928},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[24],[466],{"id":930,"viewCount":57,"searchKey":931,"visible":15},"10003300",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":21,"currentStage":244,"position":937,"attributes":938},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[24],[235,466],{"id":940,"viewCount":57,"searchKey":941,"visible":15},"10003174",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":21,"currentStage":255,"position":947,"attributes":948},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[24],[235,466],{"id":950,"viewCount":57,"searchKey":951,"visible":15},"10003293",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":21,"currentStage":244,"position":957,"attributes":958},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[24],[466],{"id":960,"viewCount":57,"searchKey":961,"visible":15},"10003168",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":21,"currentStage":255,"position":967,"attributes":968},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[24],[466],{"id":970,"viewCount":57,"searchKey":971,"visible":15},"10003161",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":21,"currentStage":22,"position":977,"attributes":978},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[298],[466],{"id":980,"viewCount":57,"searchKey":981,"visible":15},"10003222",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":21,"currentStage":255,"position":987,"attributes":988},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[298],[466],{"id":990,"viewCount":57,"searchKey":991,"visible":15},"10003272",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":21,"currentStage":22,"position":997,"attributes":998},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[298],[26],{"id":1000,"viewCount":57,"searchKey":1001,"visible":15},"10003254",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":21,"currentStage":244,"position":1007,"attributes":1008},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[298],[26],{"id":1010,"viewCount":57,"searchKey":1011,"visible":15},"10003163",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":21,"currentStage":255,"position":1017,"attributes":1018},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[298],[26],{"id":1020,"viewCount":57,"searchKey":1021,"visible":15},"10003204",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":21,"currentStage":22,"position":1027,"attributes":1028},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[394],[363],{"id":1030,"viewCount":57,"searchKey":1031,"visible":15},"10003205",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":21,"currentStage":255,"position":1037,"attributes":1038},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[394],[363],{"id":1040,"viewCount":57,"searchKey":1041,"visible":15},"10003324",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":21,"currentStage":218,"position":1047,"attributes":1048},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[394],[26],{"id":1050,"viewCount":57,"searchKey":1051,"visible":15},"10003269",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":21,"currentStage":22,"position":1057,"attributes":1058},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[394],[466,363],{"id":1060,"viewCount":57,"searchKey":1061,"visible":15},"10003261",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":21,"currentStage":255,"position":1067,"attributes":1068},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[394],[466,363],{"id":1070,"viewCount":57,"searchKey":1071,"visible":15},"10003305",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":21,"currentStage":22,"position":1077,"attributes":1078},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[24],[384],{"id":1080,"viewCount":57,"searchKey":1081,"visible":15},"10003232",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":21,"currentStage":255,"position":1087,"attributes":1088},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[24],[384],{"id":1090,"viewCount":57,"searchKey":1091,"visible":15},"10003198",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":21,"currentStage":22,"position":1097,"attributes":1098},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[361],[341,363],{"id":1100,"viewCount":57,"searchKey":1101,"visible":15},"10003194",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":21,"currentStage":255,"position":1107,"attributes":1108},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[361],[341,363],{"id":1110,"viewCount":57,"searchKey":1111,"visible":15},"10003185",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":21,"currentStage":22,"position":1117,"attributes":1118},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[233],[363],{"id":1120,"viewCount":57,"searchKey":1121,"visible":15},"10003284",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":21,"currentStage":255,"position":1127,"attributes":1128},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[233],[363],{"id":1130,"viewCount":57,"searchKey":1131,"visible":15},"10003188",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":21,"currentStage":22,"position":1137,"attributes":1138},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[233],[384],{"id":1140,"viewCount":57,"searchKey":1141,"visible":15},"10003182",{"type":10,"entryId":1142,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":21,"currentStage":255,"position":1147,"attributes":1148},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[233],[384],{"id":1150,"viewCount":57,"searchKey":1151,"visible":15},"10003273",{"type":10,"entryId":1152,"sortOrder":1153,"name":1154,"imageUrl":1155,"description":1156,"currentMorphology":21,"currentStage":218,"position":1157,"attributes":1158},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[233],[1159],"attributes-holy",{"id":1161,"viewCount":57,"searchKey":1162,"visible":15},"10003150",{"type":10,"entryId":1163,"sortOrder":1164,"name":1165,"imageUrl":1166,"description":1167,"currentMorphology":21,"currentStage":218,"position":1168,"attributes":1169},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[233],[1159],[1171,1179,1184,1187,1192,1197,1202,1207,1212,1217,1222,1226,1231,1235,1239,1244,1248,1253,1258],{"id":1172,"parentId":1173,"tagType":1174,"tagKey":1175,"name":1176,"language":1177,"sort":1178},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1180,"parentId":1173,"tagType":1174,"tagKey":1181,"name":1182,"language":1177,"sort":1183},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1185,"parentId":1173,"tagType":1174,"tagKey":21,"name":1186,"language":1177,"sort":29},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1188,"parentId":1173,"tagType":1174,"tagKey":1189,"name":1190,"language":1177,"sort":1191},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1193,"parentId":1173,"tagType":1174,"tagKey":1194,"name":1195,"language":1177,"sort":1196},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1198,"parentId":1173,"tagType":1174,"tagKey":1199,"name":1200,"language":1177,"sort":1201},"2387fbfcb535355f8989034c6a5d57d6","Bay Form","바다만 형태",15,{"id":1203,"parentId":1173,"tagType":1174,"tagKey":1204,"name":1205,"language":1177,"sort":1206},"2539a45b96c7561e772e917a91e2ec0f","Cloudmist Form","구름 형태",18,{"id":1208,"parentId":1173,"tagType":1174,"tagKey":1209,"name":1210,"language":1177,"sort":1211},"2a84ab1f7f852e14b27ce76755727cca","Mountain Form","산지 형태",7,{"id":1213,"parentId":1173,"tagType":1174,"tagKey":1214,"name":1215,"language":1177,"sort":1216},"3c233890d20868e097e9cea7821aad8e","Umbrabow Form","옵시디언 형태",4,{"id":1218,"parentId":1173,"tagType":1174,"tagKey":1219,"name":1220,"language":1177,"sort":1221},"532c88e1ad2265245d2a450fe9e5629f","Highland Form","고지 형태",9,{"id":1223,"parentId":1173,"tagType":1174,"tagKey":1224,"name":1225,"language":1177,"sort":81},"537f01b8a206e25a37d2ceb6c5325754","Prismana Form","천휘 형태",{"id":1227,"parentId":1173,"tagType":1174,"tagKey":1228,"name":1229,"language":1177,"sort":1230},"6348a343642770f35403dea19746668c","Sea of Flowers Form","꽃바다 형태",10,{"id":1232,"parentId":1173,"tagTy