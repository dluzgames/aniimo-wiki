Edit":15,"useTabs":65,"blackHeader":65},"탐사 스킬","91268178_22",[146],{"id":147,"type":132,"props":148,"children":57},"91268178_23",{"id":149,"customKey":45,"icon":150,"iconStyle":90,"iconTitle":45,"descTitle":151,"descContent":152,"source":153},"91268178_24","/cdn/init/1029300_Skill_9400136_Icon.png","돌격","일정 거리를 빠르게 전진합니다.",{"attributes":154,"type":155,"consume":45,"power":45},[],[],{"id":157,"type":60,"props":158,"children":161},"91268178_25",{"title":159,"type":63,"id":160,"isUse":15,"isEdit":15,"useTabs":65,"blackHeader":65},"애니모 특성","91268178_26",[162],{"id":163,"type":132,"props":164,"children":57},"91268178_27",{"id":165,"customKey":45,"icon":166,"iconStyle":63,"iconTitle":45,"descTitle":167,"descContent":168,"source":169},"91268178_28","/cdn/init/1029300_Feature_12932_Icon.png","번개의 계약","공격이 목표를 명중하면 1중첩 [번개의 계약]을 획득합니다. 30중첩에 도달하면 다음 스킬과 궁극기 스킬 시전 시 [썬더윙 자세]로 전환되며 10초 동안 지속됩니다.",{"attributes":170,"type":171,"consume":45,"power":45},[],[],{"id":173,"type":60,"props":174,"children":57},"91268178_29",{"title":175,"type":63,"id":176,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":65,"tabs":177},"스킬 소개","91268178_30",[178,227],{"id":179,"title":180,"children":181},"91268178_31","전투 스킬",[182,195,206,217],{"id":183,"type":132,"props":184},"91268178_32",{"id":185,"customKey":45,"icon":186,"iconStyle":63,"iconTitle":45,"descTitle":187,"descContent":188,"source":189},"91268178_33","/cdn/init/1029300_Skill_10400360_Icon.png","전자기장","대상을 중심으로 전자기장을 시전하고 계속 추적합니다. 전자기장 안의 대상이 전기 공격을 받으면 전기 원소 공격 1회가 추가 시전되고, 대상에게 [전기 원소 상태 이상]을 부여합니다. 전자기장은 8초 동안 지속됩니다.",{"attributes":190,"type":192,"consume":194,"power":119},[191],"4",[193],"2","20",{"id":196,"type":132,"props":197},"91268178_34",{"id":198,"customKey":45,"icon":199,"iconStyle":63,"iconTitle":45,"descTitle":200,"descContent":201,"source":202},"91268178_35","/cdn/init/1029300_Skill_10400370_Icon.png","라이트닝 필드","대상에게 라이트닝 필드를 발사해 경로상의 대상에게 지속적으로 피해를 주고 계속해서 대상을 흡착합니다.",{"attributes":203,"type":204,"consume":194,"power":205},[191],[193],"50",{"id":207,"type":132,"props":208},"91268178_36",{"id":209,"customKey":45,"icon":210,"iconStyle":63,"iconTitle":45,"descTitle":211,"descContent":212,"source":213},"91268178_37","/cdn/init/1029300_Skill_10400350_Icon.png","번개 각인","자신에게 [번개 각인]을 부여합니다. 지속 시간 동안 적군에게 피해를 줄 때마다 대상에게 피해를 저장하고 종료 시 모든 누적 피해를 정산합니다. 8초 동안 지속됩니다. 대상이 원소 이상 상태 10스택 보유 시, 이를 소모하고 추가로 100%의 피해를 줍니다.",{"attributes":214,"type":215,"consume":216,"power":119},[191],[193],"30",{"id":218,"type":132,"props":219},"91268178_38",{"id":220,"customKey":45,"icon":221,"iconStyle":63,"iconTitle":45,"descTitle":222,"descContent":201,"source":223},"91268178_39","/cdn/init/1029300_Skill_11300130_Icon.png","신성 필드",{"attributes":224,"type":226,"consume":194,"power":205},[225],"13",[193],{"id":228,"title":229,"children":230},"91268178_40","고유 스킬",[231,243],{"id":232,"type":132,"props":233},"91268178_41",{"id":234,"customKey":45,"icon":235,"iconStyle":63,"iconTitle":45,"descTitle":236,"descContent":237,"source":238},"91268178_42","/cdn/init/1029300_Skill_14000000_Icon.png","공격","전기 원소 능력을 사용하여 원거리에서 목표를 공격합니다.",{"attributes":239,"type":240,"consume":241,"power":242},[191],[193],"0","6",{"id":244,"type":132,"props":245},"91268178_43",{"id":246,"customKey":45,"icon":247,"iconStyle":63,"iconTitle":45,"descTitle":248,"descContent":249,"source":250},"91268178_44","/cdn/init/1029300_Skill_10400420_Icon.png","번개 화살비","양 날개에 휘감긴 번개가 화살 5개로 바뀌어 목표를 향해 발사됩니다. [썬더윙 자세]인 경우 추가로 5개의 화살을 발사하고, 마지막에 추가로 20 위력의 폭발 피해를 줍니다.",{"attributes":251,"type":252,"consume":241,"power":253},[191],[193],"100",[255,256],{"id":4,"entryId":12,"currentMorphology":9,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},[258,269,279,289,301,311,321,333,343,353,363,374,384,396,406,417,428,438,448,458,468,478,488,499,509,519,529,539,549,559,569,579,589,599,609,619,629,639,649,659,669,679,689,699,709,719,729,739,749,759,769,779,789,799,809,819,829,839,849,856,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1130,1140,1150,1160,1170,1180,1191],{"id":259,"viewCount":57,"searchKey":260,"visible":15},"10003217",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":9,"currentStage":119,"position":266,"attributes":267},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[23],[268],"attributes-fire",{"id":270,"viewCount":57,"searchKey":271,"visible":15},"10003309",{"type":10,"entryId":272,"sortOrder":273,"name":274,"imageUrl":275,"description":276,"currentMorphology":9,"currentStage":193,"position":277,"attributes":278},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.",[23],[268],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10003210",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":9,"currentStage":21,"position":287,"attributes":288},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.",[23],[268],{"id":290,"viewCount":57,"searchKey":291,"visible":15},"10003203",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":9,"currentStage":21,"position":297,"attributes":299},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[298],"position-break",[268,300],"attributes-dark",{"id":302,"viewCount":57,"searchKey":303,"visible":15},"10003353",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":9,"currentStage":119,"position":309,"attributes":310},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[23],[300],{"id":312,"viewCount":57,"searchKey":313,"visible":15},"10003192",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":9,"currentStage":21,"position":319,"attributes":320},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[23],[300],{"id":322,"viewCount":57,"searchKey":323,"visible":15},"10003263",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":9,"currentStage":119,"position":329,"attributes":331},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[330],"position-sup",[332],"attributes-wind",{"id":334,"viewCount":57,"searchKey":335,"visible":15},"10003323",{"type":10,"entryId":336,"sortOrder":337,"name":338,"imageUrl":339,"description":340,"currentMorphology":9,"currentStage":21,"position":341,"attributes":342},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[330],[332],{"id":344,"viewCount":57,"searchKey":345,"visible":15},"10003249",{"type":10,"entryId":346,"sortOrder":347,"name":348,"imageUrl":349,"description":350,"currentMorphology":9,"currentStage":21,"position":351,"attributes":352},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[23],[332],{"id":354,"viewCount":57,"searchKey":355,"visible":15},"10003242",{"type":10,"entryId":356,"sortOrder":357,"name":358,"imageUrl":359,"description":360,"currentMorphology":9,"currentStage":21,"position":361,"attributes":362},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[298],[332],{"id":364,"viewCount":57,"searchKey":365,"visible":15},"10003167",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":9,"currentStage":119,"position":371,"attributes":372},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[23],[373],"attributes-grass",{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10003285",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":9,"currentStage":21,"position":382,"attributes":383},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[23],[373],{"id":385,"viewCount":57,"searchKey":386,"visible":15},"10003252",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":9,"currentStage":119,"position":392,"attributes":394},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[393],"position-heal",[395],"attributes-water",{"id":397,"viewCount":57,"searchKey":398,"visible":15},"10003344",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":9,"currentStage":193,"position":404,"attributes":405},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[393],[395],{"id":407,"viewCount":57,"searchKey":408,"visible":15},"10003245",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":9,"currentStage":21,"position":414,"attributes":415},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[393],[395,416],"attributes-ice",{"id":418,"viewCount":57,"searchKey":419,"visible":15},"10003238",{"type":10,"entryId":420,"sortOrder":421,"name":422,"imageUrl":423,"description":424,"currentMorphology":9,"currentStage":21,"position":425,"attributes":427},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[426],"position-energy",[373,395],{"id":429,"viewCount":57,"searchKey":430,"visible":15},"10003243",{"type":10,"entryId":431,"sortOrder":432,"name":433,"imageUrl":434,"description":435,"currentMorphology":9,"currentStage":119,"position":436,"attributes":437},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[330],[332],{"id":439,"viewCount":57,"searchKey":440,"visible":15},"10003140",{"type":10,"entryId":441,"sortOrder":442,"name":443,"imageUrl":444,"description":445,"currentMorphology":9,"currentStage":21,"position":446,"attributes":447},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[330],[332],{"id":449,"viewCount":57,"searchKey":450,"visible":15},"10003236",{"type":10,"entryId":451,"sortOrder":452,"name":453,"imageUrl":454,"description":455,"currentMorphology":9,"currentStage":21,"position":456,"attributes":457},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[330],[300],{"id":459,"viewCount":57,"searchKey":460,"visible":15},"10003196",{"type":10,"entryId":461,"sortOrder":462,"name":463,"imageUrl":464,"description":465,"currentMorphology":9,"currentStage":119,"position":466,"attributes":467},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[298],[373],{"id":469,"viewCount":57,"searchKey":470,"visible":15},"10003189",{"type":10,"entryId":471,"sortOrder":472,"name":473,"imageUrl":474,"description":475,"currentMorphology":9,"currentStage":21,"position":476,"attributes":477},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[426],[300,373],{"id":479,"viewCount":57,"searchKey":480,"visible":15},"10003179",{"type":10,"entryId":481,"sortOrder":482,"name":483,"imageUrl":484,"description":485,"currentMorphology":9,"currentStage":21,"position":486,"attributes":487},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[298],[373],{"id":489,"viewCount":57,"searchKey":490,"visible":15},"10003342",{"type":10,"entryId":491,"sortOrder":492,"name":493,"imageUrl":494,"description":495,"currentMorphology":9,"currentStage":119,"position":496,"attributes":497},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[298],[498,373],"attributes-rock",{"id":500,"viewCount":57,"searchKey":501,"visible":15},"10003237",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":9,"currentStage":21,"position":507,"attributes":508},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[298],[498,373],{"id":510,"viewCount":57,"searchKey":511,"visible":15},"10003326",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":9,"currentStage":21,"position":517,"attributes":518},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[298],[416],{"id":520,"viewCount":57,"searchKey":521,"visible":15},"10003184",{"type":10,"entryId":522,"sortOrder":523,"name":524,"imageUrl":525,"description":526,"currentMorphology":9,"currentStage":119,"position":527,"attributes":528},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[426],[268],{"id":530,"viewCount":57,"searchKey":531,"visible":15},"10003282",{"type":10,"entryId":532,"sortOrder":533,"name":534,"imageUrl":535,"description":536,"currentMorphology":9,"currentStage":21,"position":537,"attributes":538},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[426],[268],{"id":540,"viewCount":57,"searchKey":541,"visible":15},"10003317",{"type":10,"entryId":542,"sortOrder":543,"name":544,"imageUrl":545,"description":546,"currentMorphology":9,"currentStage":119,"position":547,"attributes":548},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[393],[332],{"id":550,"viewCount":57,"searchKey":551,"visible":15},"10003215",{"type":10,"entryId":552,"sortOrder":553,"name":554,"imageUrl":555,"description":556,"currentMorphology":9,"currentStage":21,"position":557,"attributes":558},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[393],[332],{"id":560,"viewCount":57,"searchKey":561,"visible":15},"10003338",{"type":10,"entryId":562,"sortOrder":563,"name":564,"imageUrl":565,"description":566,"currentMorphology":9,"currentStage":241,"position":567,"attributes":568},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[426],[332,373],{"id":570,"viewCount":57,"searchKey":571,"visible":15},"10003143",{"type":10,"entryId":572,"sortOrder":573,"name":574,"imageUrl":575,"description":576,"currentMorphology":9,"currentStage":119,"position":577,"attributes":578},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[330],[332],{"id":580,"viewCount":57,"searchKey":581,"visible":15},"10003138",{"type":10,"entryId":582,"sortOrder":583,"name":584,"imageUrl":585,"description":586,"currentMorphology":9,"currentStage":21,"position":587,"attributes":588},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[330],[332],{"id":590,"viewCount":57,"searchKey":591,"visible":15},"10003290",{"type":10,"entryId":592,"sortOrder":593,"name":594,"imageUrl":595,"description":596,"currentMorphology":9,"currentStage":119,"position":597,"attributes":598},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[23],[373],{"id":600,"viewCount":57,"searchKey":601,"visible":15},"10003271",{"type":10,"entryId":602,"sortOrder":603,"name":604,"imageUrl":605,"description":606,"currentMorphology":9,"currentStage":21,"position":607,"attributes":608},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[23],[373],{"id":610,"viewCount":57,"searchKey":611,"visible":15},"10003153",{"type":10,"entryId":612,"sortOrder":613,"name":614,"imageUrl":615,"description":616,"currentMorphology":9,"currentStage":21,"position":617,"attributes":618},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[330],[373],{"id":620,"viewCount":57,"searchKey":621,"visible":15},"10003231",{"type":10,"entryId":622,"sortOrder":623,"name":624,"imageUrl":625,"description":626,"currentMorphology":9,"currentStage":119,"position":627,"attributes":628},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[298],[373],{"id":630,"viewCount":57,"searchKey":631,"visible":15},"10003149",{"type":10,"entryId":632,"sortOrder":633,"name":634,"imageUrl":635,"description":636,"currentMorphology":9,"currentStage":21,"position":637,"attributes":638},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[330],[25],{"id":640,"viewCount":57,"searchKey":641,"visible":15},"10003218",{"type":10,"entryId":642,"sortOrder":643,"name":644,"imageUrl":645,"description":646,"currentMorphology":9,"currentStage":21,"position":647,"attributes":648},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[298],[373],{"id":650,"viewCount":57,"searchKey":651,"visible":15},"10003278",{"type":10,"entryId":652,"sortOrder":653,"name":654,"imageUrl":655,"description":656,"currentMorphology":9,"currentStage":119,"position":657,"attributes":658},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[330],[300],{"id":660,"viewCount":57,"searchKey":661,"visible":15},"10003296",{"type":10,"entryId":662,"sortOrder":663,"name":664,"imageUrl":665,"description":666,"currentMorphology":9,"currentStage":21,"position":667,"attributes":668},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[330],[300],{"id":670,"viewCount":57,"searchKey":671,"visible":15},"10003283",{"type":10,"entryId":672,"sortOrder":673,"name":674,"imageUrl":675,"description":676,"currentMorphology":9,"currentStage":119,"position":677,"attributes":678},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[23],[300],{"id":680,"viewCount":57,"searchKey":681,"visible":15},"10003144",{"type":10,"entryId":682,"sortOrder":683,"name":684,"imageUrl":685,"description":686,"currentMorphology":9,"currentStage":21,"position":687,"attributes":688},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[23],[300],{"id":690,"viewCount":57,"searchKey":691,"visible":15},"10003276",{"type":10,"entryId":692,"sortOrder":693,"name":694,"imageUrl":695,"description":696,"currentMorphology":9,"currentStage":21,"position":697,"attributes":698},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[23],[25],{"id":700,"viewCount":57,"searchKey":701,"visible":15},"10003197",{"type":10,"entryId":702,"sortOrder":703,"name":704,"imageUrl":705,"description":706,"currentMorphology":9,"currentStage":119,"position":707,"attributes":708},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[23],[416],{"id":710,"viewCount":57,"searchKey":711,"visible":15},"10003350",{"type":10,"entryId":712,"sortOrder":713,"name":714,"imageUrl":715,"description":716,"currentMorphology":9,"currentStage":193,"position":717,"attributes":718},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[23],[416],{"id":720,"viewCount":57,"searchKey":721,"visible":15},"10003190",{"type":10,"entryId":722,"sortOrder":723,"name":724,"imageUrl":725,"description":726,"currentMorphology":9,"currentStage":21,"position":727,"attributes":728},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[23],[416],{"id":730,"viewCount":57,"searchKey":731,"visible":15},"10003299",{"type":10,"entryId":732,"sortOrder":733,"name":734,"imageUrl":735,"description":736,"currentMorphology":9,"currentStage":119,"position":737,"attributes":738},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[298],[25],{"id":740,"viewCount":57,"searchKey":741,"visible":15},"10003250",{"type":10,"entryId":742,"sortOrder":743,"name":744,"imageUrl":745,"description":746,"currentMorphology":9,"currentStage":21,"position":747,"attributes":748},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[298],[25],{"id":750,"viewCount":57,"searchKey":751,"visible":15},"10003298",{"type":10,"entryId":752,"sortOrder":753,"name":754,"imageUrl":755,"description":756,"currentMorphology":9,"currentStage":119,"position":757,"attributes":758},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[298],[395],{"id":760,"viewCount":57,"searchKey":761,"visible":15},"10003173",{"type":10,"entryId":762,"sortOrder":763,"name":764,"imageUrl":765,"description":766,"currentMorphology":9,"currentStage":193,"position":767,"attributes":768},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[298],[395],{"id":770,"viewCount":57,"searchKey":771,"visible":15},"10003291",{"type":10,"entryId":772,"sortOrder":773,"name":774,"imageUrl":775,"description":776,"currentMorphology":9,"currentStage":21,"position":777,"attributes":778},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[330],[395],{"id":780,"viewCount":57,"searchKey":781,"visible":15},"10003341",{"type":10,"entryId":782,"sortOrder":783,"name":784,"imageUrl":785,"description":786,"currentMorphology":9,"currentStage":21,"position":787,"attributes":788},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[298],[395],{"id":790,"viewCount":57,"searchKey":791,"visible":15},"10003228",{"type":10,"entryId":792,"sortOrder":793,"name":794,"imageUrl":795,"description":796,"currentMorphology":9,"currentStage":119,"position":797,"attributes":798},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[23],[395],{"id":800,"viewCount":57,"searchKey":801,"visible":15},"10003352",{"type":10,"entryId":802,"sortOrder":803,"name":804,"imageUrl":805,"description":806,"currentMorphology":9,"currentStage":193,"position":807,"attributes":808},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[23],[395],{"id":810,"viewCount":57,"searchKey":811,"visible":15},"10003345",{"type":10,"entryId":812,"sortOrder":813,"name":814,"imageUrl":815,"description":816,"currentMorphology":9,"currentStage":21,"position":817,"attributes":818},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[23],[395],{"id":820,"viewCount":57,"searchKey":821,"visible":15},"10003340",{"type":10,"entryId":822,"sortOrder":823,"name":824,"imageUrl":825,"description":826,"currentMorphology":9,"currentStage":119,"position":827,"attributes":828},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[23],[498],{"id":830,"viewCount":57,"searchKey":831,"visible":15},"10003251",{"type":10,"entryId":832,"sortOrder":833,"name":834,"imageUrl":835,"description":836,"currentMorphology":9,"currentStage":21,"position":837,"attributes":838},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[23],[498],{"id":840,"viewCount":57,"searchKey":841,"visible":15},"10003241",{"type":10,"entryId":842,"sortOrder":843,"name":844,"imageUrl":845,"description":846,"currentMorphology":9,"currentStage":21,"position":847,"attributes":848},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[330],[498],{"id":5,"viewCount":57,"searchKey":850,"visible":15},{"type":10,"entryId":8,"sortOrder":851,"name":73,"imageUrl":852,"description":853,"currentMorphology":9,"currentStage":119,"position":854,"attributes":855},1029100,"/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[23],[25],{"id":4,"viewCount":57,"searchKey":857,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":858,"attributes":859},[23],[25],{"id":861,"viewCount":57,"searchKey":862,"visible":15},"10003318",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":9,"currentStage":119,"position":868,"attributes":869},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[298],[300],{"id":871,"viewCount":57,"searchKey":872,"visible":15},"10003332",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":9,"currentStage":21,"position":878,"attributes":879},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[23],[300],{"id":881,"viewCount":57,"searchKey":882,"visible":15},"10003297",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":9,"currentStage":21,"position":888,"attributes":889},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[298],[300],{"id":891,"viewCount":57,"searchKey":892,"visible":15},"10003354",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":9,"currentStage":119,"position":898,"attributes":899},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[298],[332],{"id":901,"viewCount":57,"searchKey":902,"visible":15},"10003164",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":9,"currentStage":193,"position":908,"attributes":909},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[298],[332],{"id":911,"viewCount":57,"searchKey":912,"visible":15},"10003311",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":9,"currentStage":21,"position":918,"attributes":919},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[298],[332],{"id":921,"viewCount":57,"searchKey":922,"visible":15},"10003304",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":9,"currentStage":21,"position":928,"attributes":929},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[23],[268],{"id":931,"viewCount":57,"searchKey":932,"visible":15},"10003208",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":9,"currentStage":119,"position":938,"attributes":939},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[23],[498],{"id":941,"viewCount":57,"searchKey":942,"visible":15},"10003202",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":9,"currentStage":21,"position":948,"attributes":949},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[23],[498],{"id":951,"viewCount":57,"searchKey":952,"visible":15},"10003180",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":9,"currentStage":119,"position":958,"attributes":959},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[298],[498],{"id":961,"viewCount":57,"searchKey":962,"visible":15},"10003300",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":9,"currentStage":193,"position":968,"attributes":969},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[298],[268,498],{"id":971,"viewCount":57,"searchKey":972,"visible":15},"10003174",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":9,"currentStage":21,"position":978,"attributes":979},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[298],[268,498],{"id":981,"viewCount":57,"searchKey":982,"visible":15},"10003293",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":9,"currentStage":193,"position":988,"attributes":989},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[298],[498],{"id":991,"viewCount":57,"searchKey":992,"visible":15},"10003168",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":9,"currentStage":21,"position":998,"attributes":999},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[298],[498],{"id":1001,"viewCount":57,"searchKey":1002,"visible":15},"10003161",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":9,"currentStage":119,"position":1008,"attributes":1009},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[330],[498],{"id":1011,"viewCount":57,"searchKey":1012,"visible":15},"10003222",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":9,"currentStage":21,"position":1018,"attributes":1019},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[330],[498],{"id":1021,"viewCount":57,"searchKey":1022,"visible":15},"10003272",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":9,"currentStage":119,"position":1028,"attributes":1029},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[330],[25],{"id":1031,"viewCount":57,"searchKey":1032,"visible":15},"10003254",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":9,"currentStage":193,"position":1038,"attributes":1039},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[330],[25],{"id":1041,"viewCount":57,"searchKey":1042,"visible":15},"10003163",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":9,"currentStage":21,"position":1048,"attributes":1049},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[330],[25],{"id":1051,"viewCount":57,"searchKey":1052,"visible":15},"10003204",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":9,"currentStage":119,"position":1058,"attributes":1059},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[426],[395],{"id":1061,"viewCount":57,"searchKey":1062,"visible":15},"10003205",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":9,"currentStage":21,"position":1068,"attributes":1069},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[426],[395],{"id":1071,"viewCount":57,"searchKey":1072,"visible":15},"10003324",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":9,"currentStage":241,"position":1078,"attributes":1079},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[426],[25],{"id":1081,"viewCount":57,"searchKey":1082,"visible":15},"10003269",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":9,"currentStage":119,"position":1088,"attributes":1089},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[426],[498,395],{"id":1091,"viewCount":57,"searchKey":1092,"visible":15},"10003261",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":9,"currentStage":21,"position":1098,"attributes":1099},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[426],[498,395],{"id":1101,"viewCount":57,"searchKey":1102,"visible":15},"10003305",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":9,"currentStage":119,"position":1108,"attributes":1109},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[298],[416],{"id":1111,"viewCount":57,"searchKey":1112,"visible":15},"10003232",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":9,"currentStage":21,"position":1118,"attributes":1119},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[298],[416],{"id":1121,"viewCount":57,"searchKey":1122,"visible":15},"10003198",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":9,"currentStage":119,"position":1128,"attributes":1129},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[393],[373,395],{"id":1131,"viewCount":57,"searchKey":1132,"visible":15},"10003194",{"type":10,"entryId":1133,"sortOrder":1134,"name":1135,"imageUrl":1136,"description":1137,"currentMorphology":9,"currentStage":21,"position":1138,"attributes":1139},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[393],[373,395],{"id":1141,"viewCount":57,"searchKey":1142,"visible":15},"10003185",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":9,"currentStage":119,"position":1148,"attributes":1149},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[23],[395],{"id":1151,"viewCount":57,"searchKey":1152,"visible":15},"10003284",{"type":10,"entryId":1153,"sortOrder":1154,"name":1155,"imageUrl":1156,"description":1157,"currentMorphology":9,"currentStage":21,"position":1158,"attributes":1159},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[23],[395],{"id":1161,"viewCount":57,"searchKey":1162,"visible":15},"10003188",{"type":10,"entryId":1163,"sortOrder":1164,"name":1165,"imageUrl":1166,"description":1167,"currentMorphology":9,"currentStage":119,"position":1168,"attributes":1169},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[23],[416],{"id":1171,"viewCount":57,"searchKey":1172,"visible":15},"10003182",{"type":10,"entryId":1173,"sortOrder":1174,"name":1175,"imageUrl":1176,"description":1177,"currentMorphology":9,"currentStage":21,"position":1178,"attributes":1179},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[23],[416],{"id":1181,"viewCount":57,"searchKey":1182,"visible":15},"10003273",{"type":10,"entryId":1183,"sortOrder":1184,"name":1185,"imageUrl":1186,"description":1187,"currentMorphology":9,"currentStage":241,"position":1188,"attributes":1189},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[23],[1190],"attributes-holy",{"id":1192,"viewCount":57,"searchKey":1193,"visible":15},"10003150",{"type":10,"entryId":1194,"sortOrder":1195,"name":1196,"imageUrl":1197,"description":1198,"currentMorphology":9,"currentStage":241,"position":1199,"attributes":1200},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[23],[1190],[1202,1210,1215,1218,1223,1228,1233,1238,1243,1248,1253,1256,1261,1265,1270,1275,1280,1285,1290],{"id":1203,"parentId":1204,"tagType":1205,"tagKey":1206,"name":1207,"language":1208,"sort":1209},"03663aa10bbd95a2b13b6e70ae4a5946","1300","morphologyTypes","Snowfield Form","설원 형태","ko-KR",5,{"id":1211,"parentId":1204,"tagType":1205,"tagKey":1212,"name":1213,"language":1208,"sort":1214},"089cb4ebad45a4d969062ffaabafd5cf","Forest Form","숲 형태",8,{"id":1216,"parentId":1204,"tagType":1205,"tagKey":9,"name":1217,"language":1208,"sort":28},"13845d725e4c20f6f6da5d156af5c1b7","기본 형태",{"id":1219,"parentId":1204,"tagType":1205,"tagKey":1220,"name":1221,"language":1208,"sort":1222},"1e04356b5eba7afe911f44a3d60b6035","Thunderstorm Form","뇌우 형태",11,{"id":1224,"parentId":1204,"tagType":1205,"tagKey":1225,"name":1226,"language":1208,"sort":1227},"211828f08ad49fc60141026e4e1130e6","Beach Form","해변 형태",14,{"id":1229,"parentId":1204,"tagT