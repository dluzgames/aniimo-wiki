[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"header-aniimo-list-ko":3,"aniimo-detail-10003243-ko":966,"morphology-tags-ko":1198},[4,21,32,43,55,65,75,87,97,107,117,128,138,150,160,171,182,192,202,212,222,232,242,253,263,273,283,293,303,313,324,334,344,354,364,374,384,395,405,415,425,435,445,455,465,475,485,495,505,515,525,535,545,555,565,575,585,595,605,615,625,635,645,655,665,675,685,695,705,715,725,735,745,755,765,775,785,795,805,815,825,835,845,855,865,875,885,895,905,915,925,935,945,956],{"id":5,"viewCount":6,"searchKey":7,"visible":20},"10003217",null,{"type":8,"entryId":9,"sortOrder":10,"name":11,"imageUrl":12,"description":13,"currentMorphology":14,"currentStage":15,"position":16,"attributes":18},"ANIIMO","001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.","Basic Form","1",[17],"position-dps",[19],"attributes-fire",true,{"id":22,"viewCount":6,"searchKey":23,"visible":20},"10003309",{"type":8,"entryId":24,"sortOrder":25,"name":26,"imageUrl":27,"description":28,"currentMorphology":14,"currentStage":29,"position":30,"attributes":31},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[17],[19],{"id":33,"viewCount":6,"searchKey":34,"visible":20},"10003210",{"type":8,"entryId":35,"sortOrder":36,"name":37,"imageUrl":38,"description":39,"currentMorphology":14,"currentStage":40,"position":41,"attributes":42},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[17],[19],{"id":44,"viewCount":6,"searchKey":45,"visible":20},"10003203",{"type":8,"entryId":46,"sortOrder":47,"name":48,"imageUrl":49,"description":50,"currentMorphology":14,"currentStage":40,"position":51,"attributes":53},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[52],"position-break",[19,54],"attributes-dark",{"id":56,"viewCount":6,"searchKey":57,"visible":20},"10003353",{"type":8,"entryId":58,"sortOrder":59,"name":60,"imageUrl":61,"description":62,"currentMorphology":14,"currentStage":15,"position":63,"attributes":64},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[17],[54],{"id":66,"viewCount":6,"searchKey":67,"visible":20},"10003192",{"type":8,"entryId":68,"sortOrder":69,"name":70,"imageUrl":71,"description":72,"currentMorphology":14,"currentStage":40,"position":73,"attributes":74},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[17],[54],{"id":76,"viewCount":6,"searchKey":77,"visible":20},"10003263",{"type":8,"entryId":78,"sortOrder":79,"name":80,"imageUrl":81,"description":82,"currentMorphology":14,"currentStage":15,"position":83,"attributes":85},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[84],"position-sup",[86],"attributes-wind",{"id":88,"viewCount":6,"searchKey":89,"visible":20},"10003323",{"type":8,"entryId":90,"sortOrder":91,"name":92,"imageUrl":93,"description":94,"currentMorphology":14,"currentStage":40,"position":95,"attributes":96},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[84],[86],{"id":98,"viewCount":6,"searchKey":99,"visible":20},"10003249",{"type":8,"entryId":100,"sortOrder":101,"name":102,"imageUrl":103,"description":104,"currentMorphology":14,"currentStage":40,"position":105,"attributes":106},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[17],[86],{"id":108,"viewCount":6,"searchKey":109,"visible":20},"10003242",{"type":8,"entryId":110,"sortOrder":111,"name":112,"imageUrl":113,"description":114,"currentMorphology":14,"currentStage":40,"position":115,"attributes":116},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[52],[86],{"id":118,"viewCount":6,"searchKey":119,"visible":20},"10003167",{"type":8,"entryId":120,"sortOrder":121,"name":122,"imageUrl":123,"description":124,"currentMorphology":14,"currentStage":15,"position":125,"attributes":126},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[17],[127],"attributes-grass",{"id":129,"viewCount":6,"searchKey":130,"visible":20},"10003285",{"type":8,"entryId":131,"sortOrder":132,"name":133,"imageUrl":134,"description":135,"currentMorphology":14,"currentStage":40,"position":136,"attributes":137},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[17],[127],{"id":139,"viewCount":6,"searchKey":140,"visible":20},"10003252",{"type":8,"entryId":141,"sortOrder":142,"name":143,"imageUrl":144,"description":145,"currentMorphology":14,"currentStage":15,"position":146,"attributes":148},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[147],"position-heal",[149],"attributes-water",{"id":151,"viewCount":6,"searchKey":152,"visible":20},"10003344",{"type":8,"entryId":153,"sortOrder":154,"name":155,"imageUrl":156,"description":157,"currentMorphology":14,"currentStage":29,"position":158,"attributes":159},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[147],[149],{"id":161,"viewCount":6,"searchKey":162,"visible":20},"10003245",{"type":8,"entryId":163,"sortOrder":164,"name":165,"imageUrl":166,"description":167,"currentMorphology":14,"currentStage":40,"position":168,"attributes":169},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[147],[149,170],"attributes-ice",{"id":172,"viewCount":6,"searchKey":173,"visible":20},"10003238",{"type":8,"entryId":174,"sortOrder":175,"name":176,"imageUrl":177,"description":178,"currentMorphology":14,"currentStage":40,"position":179,"attributes":181},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[180],"position-energy",[127,149],{"id":183,"viewCount":6,"searchKey":184,"visible":20},"10003243",{"type":8,"entryId":185,"sortOrder":186,"name":187,"imageUrl":188,"description":189,"currentMorphology":14,"currentStage":15,"position":190,"attributes":191},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[84],[86],{"id":193,"viewCount":6,"searchKey":194,"visible":20},"10003140",{"type":8,"entryId":195,"sortOrder":196,"name":197,"imageUrl":198,"description":199,"currentMorphology":14,"currentStage":40,"position":200,"attributes":201},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[84],[86],{"id":203,"viewCount":6,"searchKey":204,"visible":20},"10003236",{"type":8,"entryId":205,"sortOrder":206,"name":207,"imageUrl":208,"description":209,"currentMorphology":14,"currentStage":40,"position":210,"attributes":211},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[84],[54],{"id":213,"viewCount":6,"searchKey":214,"visible":20},"10003196",{"type":8,"entryId":215,"sortOrder":216,"name":217,"imageUrl":218,"description":219,"currentMorphology":14,"currentStage":15,"position":220,"attributes":221},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[52],[127],{"id":223,"viewCount":6,"searchKey":224,"visible":20},"10003189",{"type":8,"entryId":225,"sortOrder":226,"name":227,"imageUrl":228,"description":229,"currentMorphology":14,"currentStage":40,"position":230,"attributes":231},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[180],[54,127],{"id":233,"viewCount":6,"searchKey":234,"visible":20},"10003179",{"type":8,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":14,"currentStage":40,"position":240,"attributes":241},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[52],[127],{"id":243,"viewCount":6,"searchKey":244,"visible":20},"10003342",{"type":8,"entryId":245,"sortOrder":246,"name":247,"imageUrl":248,"description":249,"currentMorphology":14,"currentStage":15,"position":250,"attributes":251},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[52],[252,127],"attributes-rock",{"id":254,"viewCount":6,"searchKey":255,"visible":20},"10003237",{"type":8,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":14,"currentStage":40,"position":261,"attributes":262},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[52],[252,127],{"id":264,"viewCount":6,"searchKey":265,"visible":20},"10003326",{"type":8,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":14,"currentStage":40,"position":271,"attributes":272},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[52],[170],{"id":274,"viewCount":6,"searchKey":275,"visible":20},"10003184",{"type":8,"entryId":276,"sortOrder":277,"name":278,"imageUrl":279,"description":280,"currentMorphology":14,"currentStage":15,"position":281,"attributes":282},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[180],[19],{"id":284,"viewCount":6,"searchKey":285,"visible":20},"10003282",{"type":8,"entryId":286,"sortOrder":287,"name":288,"imageUrl":289,"description":290,"currentMorphology":14,"currentStage":40,"position":291,"attributes":292},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[180],[19],{"id":294,"viewCount":6,"searchKey":295,"visible":20},"10003317",{"type":8,"entryId":296,"sortOrder":297,"name":298,"imageUrl":299,"description":300,"currentMorphology":14,"currentStage":15,"position":301,"attributes":302},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[147],[86],{"id":304,"viewCount":6,"searchKey":305,"visible":20},"10003215",{"type":8,"entryId":306,"sortOrder":307,"name":308,"imageUrl":309,"description":310,"currentMorphology":14,"currentStage":40,"position":311,"attributes":312},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[147],[86],{"id":314,"viewCount":6,"searchKey":315,"visible":20},"10003338",{"type":8,"entryId":316,"sortOrder":317,"name":318,"imageUrl":319,"description":320,"currentMorphology":14,"currentStage":321,"position":322,"attributes":323},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.","0",[180],[86,127],{"id":325,"viewCount":6,"searchKey":326,"visible":20},"10003143",{"type":8,"entryId":327,"sortOrder":328,"name":329,"imageUrl":330,"description":331,"currentMorphology":14,"currentStage":15,"position":332,"attributes":333},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[84],[86],{"id":335,"viewCount":6,"searchKey":336,"visible":20},"10003138",{"type":8,"entryId":337,"sortOrder":338,"name":339,"imageUrl":340,"description":341,"currentMorphology":14,"currentStage":40,"position":342,"attributes":343},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[84],[86],{"id":345,"viewCount":6,"searchKey":346,"visible":20},"10003290",{"type":8,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":14,"currentStage":15,"position":352,"attributes":353},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[17],[127],{"id":355,"viewCount":6,"searchKey":356,"visible":20},"10003271",{"type":8,"entryId":357,"sortOrder":358,"name":359,"imageUrl":360,"description":361,"currentMorphology":14,"currentStage":40,"position":362,"attributes":363},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[17],[127],{"id":365,"viewCount":6,"searchKey":366,"visible":20},"10003153",{"type":8,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":14,"currentStage":40,"position":372,"attributes":373},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[84],[127],{"id":375,"viewCount":6,"searchKey":376,"visible":20},"10003231",{"type":8,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":14,"currentStage":15,"position":382,"attributes":383},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[52],[127],{"id":385,"viewCount":6,"searchKey":386,"visible":20},"10003149",{"type":8,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":14,"currentStage":40,"position":392,"attributes":393},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[84],[394],"attributes-electric",{"id":396,"viewCount":6,"searchKey":397,"visible":20},"10003218",{"type":8,"entryId":398,"sortOrder":399,"name":400,"imageUrl":401,"description":402,"currentMorphology":14,"currentStage":40,"position":403,"attributes":404},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[52],[127],{"id":406,"viewCount":6,"searchKey":407,"visible":20},"10003278",{"type":8,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":14,"currentStage":15,"position":413,"attributes":414},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[84],[54],{"id":416,"viewCount":6,"searchKey":417,"visible":20},"10003296",{"type":8,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":14,"currentStage":40,"position":423,"attributes":424},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[84],[54],{"id":426,"viewCount":6,"searchKey":427,"visible":20},"10003283",{"type":8,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":14,"currentStage":15,"position":433,"attributes":434},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[17],[54],{"id":436,"viewCount":6,"searchKey":437,"visible":20},"10003144",{"type":8,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":14,"currentStage":40,"position":443,"attributes":444},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[17],[54],{"id":446,"viewCount":6,"searchKey":447,"visible":20},"10003276",{"type":8,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":14,"currentStage":40,"position":453,"attributes":454},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[17],[394],{"id":456,"viewCount":6,"searchKey":457,"visible":20},"10003197",{"type":8,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":14,"currentStage":15,"position":463,"attributes":464},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[17],[170],{"id":466,"viewCount":6,"searchKey":467,"visible":20},"10003350",{"type":8,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":14,"currentStage":29,"position":473,"attributes":474},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[17],[170],{"id":476,"viewCount":6,"searchKey":477,"visible":20},"10003190",{"type":8,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":14,"currentStage":40,"position":483,"attributes":484},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[17],[170],{"id":486,"viewCount":6,"searchKey":487,"visible":20},"10003299",{"type":8,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":14,"currentStage":15,"position":493,"attributes":494},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[52],[394],{"id":496,"viewCount":6,"searchKey":497,"visible":20},"10003250",{"type":8,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":14,"currentStage":40,"position":503,"attributes":504},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[52],[394],{"id":506,"viewCount":6,"searchKey":507,"visible":20},"10003298",{"type":8,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":14,"currentStage":15,"position":513,"attributes":514},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[52],[149],{"id":516,"viewCount":6,"searchKey":517,"visible":20},"10003173",{"type":8,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":14,"currentStage":29,"position":523,"attributes":524},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[52],[149],{"id":526,"viewCount":6,"searchKey":527,"visible":20},"10003291",{"type":8,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":14,"currentStage":40,"position":533,"attributes":534},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[84],[149],{"id":536,"viewCount":6,"searchKey":537,"visible":20},"10003341",{"type":8,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":14,"currentStage":40,"position":543,"attributes":544},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[52],[149],{"id":546,"viewCount":6,"searchKey":547,"visible":20},"10003228",{"type":8,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":14,"currentStage":15,"position":553,"attributes":554},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[17],[149],{"id":556,"viewCount":6,"searchKey":557,"visible":20},"10003352",{"type":8,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":14,"currentStage":29,"position":563,"attributes":564},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[17],[149],{"id":566,"viewCount":6,"searchKey":567,"visible":20},"10003345",{"type":8,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":14,"currentStage":40,"position":573,"attributes":574},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[17],[149],{"id":576,"viewCount":6,"searchKey":577,"visible":20},"10003340",{"type":8,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":14,"currentStage":15,"position":583,"attributes":584},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[17],[252],{"id":586,"viewCount":6,"searchKey":587,"visible":20},"10003251",{"type":8,"entryId":588,"sortOrder":589,"name":590,"imageUrl":591,"description":592,"currentMorphology":14,"currentStage":40,"position":593,"attributes":594},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[17],[252],{"id":596,"viewCount":6,"searchKey":597,"visible":20},"10003241",{"type":8,"entryId":598,"sortOrder":599,"name":600,"imageUrl":601,"description":602,"currentMorphology":14,"currentStage":40,"position":603,"attributes":604},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[84],[252],{"id":606,"viewCount":6,"searchKey":607,"visible":20},"10003154",{"type":8,"entryId":608,"sortOrder":609,"name":610,"imageUrl":611,"description":612,"currentMorphology":14,"currentStage":15,"position":613,"attributes":614},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[17],[394],{"id":616,"viewCount":6,"searchKey":617,"visible":20},"10003151",{"type":8,"entryId":618,"sortOrder":619,"name":620,"imageUrl":621,"description":622,"currentMorphology":14,"currentStage":40,"position":623,"attributes":624},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[17],[394],{"id":626,"viewCount":6,"searchKey":627,"visible":20},"10003318",{"type":8,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":14,"currentStage":15,"position":633,"attributes":634},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[52],[54],{"id":636,"viewCount":6,"searchKey":637,"visible":20},"10003332",{"type":8,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":14,"currentStage":40,"position":643,"attributes":644},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[17],[54],{"id":646,"viewCount":6,"searchKey":647,"visible":20},"10003297",{"type":8,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":14,"currentStage":40,"position":653,"attributes":654},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[52],[54],{"id":656,"viewCount":6,"searchKey":657,"visible":20},"10003354",{"type":8,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":14,"currentStage":15,"position":663,"attributes":664},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[52],[86],{"id":666,"viewCount":6,"searchKey":667,"visible":20},"10003164",{"type":8,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":14,"currentStage":29,"position":673,"attributes":674},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[52],[86],{"id":676,"viewCount":6,"searchKey":677,"visible":20},"10003311",{"type":8,"entryId":678,"sortOrder":679,"name":680,"imageUrl":681,"description":682,"currentMorphology":14,"currentStage":40,"position":683,"attributes":684},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[52],[86],{"id":686,"viewCount":6,"searchKey":687,"visible":20},"10003304",{"type":8,"entryId":688,"sortOrder":689,"name":690,"imageUrl":691,"description":692,"currentMorphology":14,"currentStage":40,"position":693,"attributes":694},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[17],[19],{"id":696,"viewCount":6,"searchKey":697,"visible":20},"10003208",{"type":8,"entryId":698,"sortOrder":699,"name":700,"imageUrl":701,"description":702,"currentMorphology":14,"currentStage":15,"position":703,"attributes":704},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[17],[252],{"id":706,"viewCount":6,"searchKey":707,"visible":20},"10003202",{"type":8,"entryId":708,"sortOrder":709,"name":710,"imageUrl":711,"description":712,"currentMorphology":14,"currentStage":40,"position":713,"attributes":714},"070",1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[17],[252],{"id":716,"viewCount":6,"searchKey":717,"visible":20},"10003180",{"type":8,"entryId":718,"sortOrder":719,"name":720,"imageUrl":721,"description":722,"currentMorphology":14,"currentStage":15,"position":723,"attributes":724},"071",1028100,"록키","/cdn/init/Wiki_Aniimo_10281.png","태어날 때부터 광물을 찾아내는 능력을 지니고 있으며, 다양한 광물을 먹는 것을 좋아해 먹는 광물에 따라 성장 방식도 달라진다.",[52],[252],{"id":726,"viewCount":6,"searchKey":727,"visible":20},"10003300",{"type":8,"entryId":728,"sortOrder":729,"name":730,"imageUrl":731,"description":732,"currentMorphology":14,"currentStage":29,"position":733,"attributes":734},"072",1028200,"라바크","/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[52],[19,252],{"id":736,"viewCount":6,"searchKey":737,"visible":20},"10003174",{"type":8,"entryId":738,"sortOrder":739,"name":740,"imageUrl":741,"description":742,"currentMorphology":14,"currentStage":40,"position":743,"attributes":744},"073",1028300,"마그라곤","/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[52],[19,252],{"id":746,"viewCount":6,"searchKey":747,"visible":20},"10003293",{"type":8,"entryId":748,"sortOrder":749,"name":750,"imageUrl":751,"description":752,"currentMorphology":14,"currentStage":29,"position":753,"attributes":754},"074",1028400,"크리스톤","/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[52],[252],{"id":756,"viewCount":6,"searchKey":757,"visible":20},"10003168",{"type":8,"entryId":758,"sortOrder":759,"name":760,"imageUrl":761,"description":762,"currentMorphology":14,"currentStage":40,"position":763,"attributes":764},"075",1028500,"크리스바인","/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[52],[252],{"id":766,"viewCount":6,"searchKey":767,"visible":20},"10003161",{"type":8,"entryId":768,"sortOrder":769,"name":770,"imageUrl":771,"description":772,"currentMorphology":14,"currentStage":15,"position":773,"attributes":774},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[84],[252],{"id":776,"viewCount":6,"searchKey":777,"visible":20},"10003222",{"type":8,"entryId":778,"sortOrder":779,"name":780,"imageUrl":781,"description":782,"currentMorphology":14,"currentStage":40,"position":783,"attributes":784},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[84],[252],{"id":786,"viewCount":6,"searchKey":787,"visible":20},"10003272",{"type":8,"entryId":788,"sortOrder":789,"name":790,"imageUrl":791,"description":792,"currentMorphology":14,"currentStage":15,"position":793,"attributes":794},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[84],[394],{"id":796,"viewCount":6,"searchKey":797,"visible":20},"10003254",{"type":8,"entryId":798,"sortOrder":799,"name":800,"imageUrl":801,"description":802,"currentMorphology":14,"currentStage":29,"position":803,"attributes":804},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[84],[394],{"id":806,"viewCount":6,"searchKey":807,"visible":20},"10003163",{"type":8,"entryId":808,"sortOrder":809,"name":810,"imageUrl":811,"description":812,"currentMorphology":14,"currentStage":40,"position":813,"attributes":814},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[84],[394],{"id":816,"viewCount":6,"searchKey":817,"visible":20},"10003204",{"type":8,"entryId":818,"sortOrder":819,"name":820,"imageUrl":821,"description":822,"currentMorphology":14,"currentStage":15,"position":823,"attributes":824},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[180],[149],{"id":826,"viewCount":6,"searchKey":827,"visible":20},"10003205",{"type":8,"entryId":828,"sortOrder":829,"name":830,"imageUrl":831,"description":832,"currentMorphology":14,"currentStage":40,"position":833,"attributes":834},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[180],[149],{"id":836,"viewCount":6,"searchKey":837,"visible":20},"10003324",{"type":8,"entryId":838,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":14,"currentStage":321,"position":843,"attributes":844},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[180],[394],{"id":846,"viewCount":6,"searchKey":847,"visible":20},"10003269",{"type":8,"entryId":848,"sortOrder":849,"name":850,"imageUrl":851,"description":852,"currentMorphology":14,"currentStage":15,"position":853,"attributes":854},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[180],[252,149],{"id":856,"viewCount":6,"searchKey":857,"visible":20},"10003261",{"type":8,"entryId":858,"sortOrder":859,"name":860,"imageUrl":861,"description":862,"currentMorphology":14,"currentStage":40,"position":863,"attributes":864},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[180],[252,149],{"id":866,"viewCount":6,"searchKey":867,"visible":20},"10003305",{"type":8,"entryId":868,"sortOrder":869,"name":870,"imageUrl":871,"description":872,"currentMorphology":14,"currentStage":15,"position":873,"attributes":874},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[52],[170],{"id":876,"viewCount":6,"searchKey":877,"visible":20},"10003232",{"type":8,"entryId":878,"sortOrder":879,"name":880,"imageUrl":881,"description":882,"currentMorphology":14,"currentStage":40,"position":883,"attributes":884},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[52],[170],{"id":886,"viewCount":6,"searchKey":887,"visible":20},"10003198",{"type":8,"entryId":888,"sortOrder":889,"name":890,"imageUrl":891,"description":892,"currentMorphology":14,"currentStage":15,"position":893,"attributes":894},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[147],[127,149],{"id":896,"viewCount":6,"searchKey":897,"visible":20},"10003194",{"type":8,"entryId":898,"sortOrder":899,"name":900,"imageUrl":901,"description":902,"currentMorphology":14,"currentStage":40,"position":903,"attributes":904},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[147],[127,149],{"id":906,"viewCount":6,"searchKey":907,"visible":20},"10003185",{"type":8,"entryId":908,"sortOrder":909,"name":910,"imageUrl":911,"description":912,"currentMorphology":14,"currentStage":15,"position":913,"attributes":914},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[17],[149],{"id":916,"viewCount":6,"searchKey":917,"visible":20},"10003284",{"type":8,"entryId":918,"sortOrder":919,"name":920,"imageUrl":921,"description":922,"currentMorphology":14,"currentStage":40,"position":923,"attributes":924},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[17],[149],{"id":926,"viewCount":6,"searchKey":927,"visible":20},"10003188",{"type":8,"entryId":928,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":14,"currentStage":15,"position":933,"attributes":934},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[17],[170],{"id":936,"viewCount":6,"searchKey":937,"visible":20},"10003182",{"type":8,"entryId":938,"sortOrder":939,"name":940,"imageUrl":941,"description":942,"currentMorphology":14,"currentStage":40,"position":943,"attributes":944},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[17],[170],{"id":946,"viewCount":6,"searchKey":947,"visible":20},"10003273",{"type":8,"entryId":948,"sortOrder":949,"name":950,"imageUrl":951,"description":952,"currentMorphology":14,"currentStage":321,"position":953,"attributes":954},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[17],[955],"attributes-holy",{"id":957,"viewCount":6,"searchKey":958,"visible":20},"10003150",{"type":8,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":14,"currentStage":321,"position":964,"attributes":965},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[17],[955],{"id":183,"previousId":172,"nextId":967,"previousAnchor":968,"nextAnchor":969,"viewCount":971,"visible":20,"searchKey":972,"directories":975,"morphologyList":1189},"10003239",{"entryId":174,"currentMorphology":14,"type":8},{"entryId":185,"currentMorphology":970,"type":8},"Rainstorm Form",540,{"type":8,"entryId":185,"sortOrder":186,"name":187,"imageUrl":188,"description":189,"currentMorphology":14,"currentStage":15,"position":973,"attributes":974},[84],[86],[976,1078],{"id":977,"title":978,"components":979},1,"기본 정보",[980,1007,1040,1061],{"id":981,"type":982,"props":983,"children":6},"91268271_0","aniimoInfo",{"id":984,"formData":985},"91268271_1",{"name":187,"sortOrder":977,"serialNumber":185,"heightMin":986,"heightMax":986,