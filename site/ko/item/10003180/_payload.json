:211,"consume":212,"power":213},[198],[22],"10","33",{"id":215,"title":216,"children":217},"91268207_37","고유 스킬",[218],{"id":219,"type":154,"props":220},"91268207_38",{"id":221,"customKey":47,"icon":222,"iconStyle":65,"iconTitle":47,"descTitle":223,"descContent":224,"source":225},"91268207_39","/cdn/init/1028100_Skill_16600000_Icon.png","공격","무력화 시 땅 원소 능력을 사용하여 근거리 대상을 공격합니다.",{"attributes":226,"type":227,"consume":228,"power":229},[198],[22],"0","6",[231],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[233,245,256,267,278,288,298,310,320,330,340,351,361,373,383,394,405,415,425,435,445,455,465,475,485,495,505,515,525,535,545,555,565,575,585,595,605,616,626,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,846,856,866,876,886,896,906,916,926,935,939,946,955,964,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1133,1143,1153,1164],{"id":234,"viewCount":59,"searchKey":235,"visible":15},"10003217",{"type":10,"entryId":236,"sortOrder":237,"name":238,"imageUrl":239,"description":240,"currentMorphology":13,"currentStage":22,"position":241,"attributes":243},"001",1005100,"탄멍멍","/cdn/init/Wiki_Aniimo_10051.png","활발하고 장난기가 많아 늘 화르랑의 뒤를 따라다닌다. 복슬복슬한 잿빛 털 사이에는 꺼지지 않는 불씨가 숨겨져 있으며, 그 불씨가 타오를수록 더욱 강해진다.",[242],"position-dps",[244],"attributes-fire",{"id":246,"viewCount":59,"searchKey":247,"visible":15},"10003309",{"type":10,"entryId":248,"sortOrder":249,"name":250,"imageUrl":251,"description":252,"currentMorphology":13,"currentStage":253,"position":254,"attributes":255},"002",1005200,"화르랑","/cdn/init/Wiki_Aniimo_10052.png","항상 무리를 지어 다니며, 충성과 결속을 무엇보다 중시한다. 차분하고 집중된 눈빛 속에는 불꽃처럼 뜨거운 마음을 품고 있다.","2",[242],[244],{"id":257,"viewCount":59,"searchKey":258,"visible":15},"10003210",{"type":10,"entryId":259,"sortOrder":260,"name":261,"imageUrl":262,"description":263,"currentMorphology":13,"currentStage":264,"position":265,"attributes":266},"003",1005300,"이글랑","/cdn/init/Wiki_Aniimo_10053.png","승부욕이 강해 강한 상대를 만날수록 더욱 뜨겁게 타오른다. 불꽃과 재는 자신이 강해졌다는 증거가 된다.","3",[242],[244],{"id":268,"viewCount":59,"searchKey":269,"visible":15},"10003203",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":13,"currentStage":264,"position":275,"attributes":276},"004",1005500,"헬울프","/cdn/init/Wiki_Aniimo_10055.png","강자에게 도전했다가 패배한 화르랑은 같은 억울함을 품은 채 쓰러진 동료들의 영혼을 흡수하고, 그 복수심에 이끌려 움직인다.",[24],[244,277],"attributes-dark",{"id":279,"viewCount":59,"searchKey":280,"visible":15},"10003353",{"type":10,"entryId":281,"sortOrder":282,"name":283,"imageUrl":284,"description":285,"currentMorphology":13,"currentStage":22,"position":286,"attributes":287},"005",1001100,"스타라미","/cdn/init/Wiki_Aniimo_10011.png","먹는 것을 매우 좋아한다. 숲속을 비행하며 먹이를 찾는 동안 머리 위의 빛나는 별이 종종 유성으로 오해받는다. 먹이를 모아두는 습성이 있으며, 음식으로 둥지를 꾸미기도 한다.",[242],[277],{"id":289,"viewCount":59,"searchKey":290,"visible":15},"10003192",{"type":10,"entryId":291,"sortOrder":292,"name":293,"imageUrl":294,"description":295,"currentMorphology":13,"currentStage":264,"position":296,"attributes":297},"006",1001200,"스타저드","/cdn/init/Wiki_Aniimo_10012.png","혼자 다니는 것을 좋아하며, 주로 밤에 모습을 드러낸다. 외형은 마치 별빛 망토를 두른 신비한 마법사와 같으며, 정신 에너지를 이용해 순간이동할 수 있다.",[242],[277],{"id":299,"viewCount":59,"searchKey":300,"visible":15},"10003263",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":13,"currentStage":22,"position":306,"attributes":308},"007",1018100,"호루매기","/cdn/init/Wiki_Aniimo_10181.png","낮은 고도를 맴돌며 해변의 움직임을 늘 살핀다. 무리를 지어 어울리기를 좋아하고, 휘파람을 불며 분위기를 띄운다.",[307],"position-sup",[309],"attributes-wind",{"id":311,"viewCount":59,"searchKey":312,"visible":15},"10003323",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":13,"currentStage":264,"position":318,"attributes":319},"008",1018400,"롬본이","/cdn/init/Wiki_Aniimo_10184.png","흥겨운 분위기를 좋아하며 리듬감 있는 소리를 낸다. 흥을 참지 못해 동료들의 합주에 자연스럽게 끼어들 때도 많다.",[307],[309],{"id":321,"viewCount":59,"searchKey":322,"visible":15},"10003249",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":13,"currentStage":264,"position":328,"attributes":329},"009",1018500,"럼펫이","/cdn/init/Wiki_Aniimo_10185.png","날카롭고 우렁찬 소리를 내어 해변 전체에 울려 퍼진다. 주목받는 것을 좋아해 소음을 내는 것도 신경 쓰지 않는다. 귀 건강을 생각한다면 괜히 자극하지 않는 것이 좋다.",[242],[309],{"id":331,"viewCount":59,"searchKey":332,"visible":15},"10003242",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":13,"currentStage":264,"position":338,"attributes":339},"010",1018700,"튜바얌","/cdn/init/Wiki_Aniimo_10187.png","깊고 낮은 튜바 같은 음색을 낸다. 음색처럼 성격도 차분하고 듬직하며, 주변을 잘 살핀다. 폭풍이 해안을 덮칠 때도 그 곁에 있으면 안전하다.",[24],[309],{"id":341,"viewCount":59,"searchKey":342,"visible":15},"10003167",{"type":10,"entryId":343,"sortOrder":344,"name":345,"imageUrl":346,"description":347,"currentMorphology":13,"currentStage":22,"position":348,"attributes":349},"011",1021100,"플러터","/cdn/init/Wiki_Aniimo_10211.png","플러터는 몸이 매우 가벼워 바람을 타고 자주 떠오른다. 꽃잎 치마가 만드는 저항으로 천천히 빙글 돌며 내려오거나 바람에 몸을 맡기고 여행을 떠나기도 한다.",[242],[350],"attributes-grass",{"id":352,"viewCount":59,"searchKey":353,"visible":15},"10003285",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":13,"currentStage":264,"position":359,"attributes":360},"012",1021200,"왈츠페탈","/cdn/init/Wiki_Aniimo_10212.png","공연에 몰두하고 있다. 끊임없이 춤 실력을 갈고닦아, 언젠가는 모든 생물이 춤에 담긴 생명의 힘을 느끼게 하는 것을 가장 큰 목표로 삼고 있다.",[242],[350],{"id":362,"viewCount":59,"searchKey":363,"visible":15},"10003252",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":13,"currentStage":22,"position":369,"attributes":371},"014",1004100,"연댕모리","/cdn/init/Wiki_Aniimo_10041.png","물속에 몸을 숨긴 채 고개만 내밀고 주변을 살피는 것을 좋아한다. 연잎 모자를 훌륭한 위장이라고 생각하지만, 계속 떠올랐다 가라앉기를 반복해 오히려 더 눈에 띈다.",[370],"position-heal",[372],"attributes-water",{"id":374,"viewCount":59,"searchKey":375,"visible":15},"10003344",{"type":10,"entryId":376,"sortOrder":377,"name":378,"imageUrl":379,"description":380,"currentMorphology":13,"currentStage":253,"position":381,"attributes":382},"015",1004200,"장꾸모리","/cdn/init/Wiki_Aniimo_10042.png","고온에 약해 서늘하고 습한 곳에 머무는 것을 좋아한다. 몸 표면은 온도를 낮추고 수분을 유지하는 막으로 덮여 있어, 만지면 매우 차갑고 매끈하다. 물을 오래 벗어나 있으면 피부가 갈라진다.",[370],[372],{"id":384,"viewCount":59,"searchKey":385,"visible":15},"10003245",{"type":10,"entryId":386,"sortOrder":387,"name":388,"imageUrl":389,"description":390,"currentMorphology":13,"currentStage":264,"position":391,"attributes":392},"016",1004300,"아이시우스","/cdn/init/Wiki_Aniimo_10043.png","우아한 외형과 기품을 지닌 생물이다. 천성이 온화해 약한 존재를 먼저 돌보지만, 이를 악용해 해치려 하는 상대는 그대로 얼려 버린다.",[370],[372,393],"attributes-ice",{"id":395,"viewCount":59,"searchKey":396,"visible":15},"10003238",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":13,"currentStage":264,"position":402,"attributes":404},"017",1004500,"연잎룡","/cdn/init/Wiki_Aniimo_10045.png","연꽃과 함께 살아가며 연잎 사이에 몸을 숨긴다. 연잎 같은 꼬리로 얼굴을 가리며, 우아한 자태를 드러낸다.",[403],"position-energy",[350,372],{"id":406,"viewCount":59,"searchKey":407,"visible":15},"10003243",{"type":10,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":13,"currentStage":22,"position":413,"attributes":414},"018",1026100,"뭉게양","/cdn/init/Wiki_Aniimo_10261.png","맑은 초원에서 무리를 지어 활동하며, 가벼운 몸으로 구름 사이에 떠올라 옹기종기 모여 떠다닌다.",[307],[309],{"id":416,"viewCount":59,"searchKey":417,"visible":15},"10003140",{"type":10,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":13,"currentStage":264,"position":423,"attributes":424},"019",1026200,"몽실양","/cdn/init/Wiki_Aniimo_10262.png","구름 속에 숨어 잠드는 것을 좋아하며, 기압과 정전기의 영향으로 복슬한 양털에는 바람에 날려 온 것들이 쉽게 달라붙는다.",[307],[309],{"id":426,"viewCount":59,"searchKey":427,"visible":15},"10003236",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":13,"currentStage":264,"position":433,"attributes":434},"020",1026300,"쿨쿨양","/cdn/init/Wiki_Aniimo_10263.png","꿈의 에너지를 머금은 털은 몽환적인 색을 띠며, 그 털을 베개로 삼아 잠들면 깊고 달콤한 꿈을 꾼다.",[307],[277],{"id":436,"viewCount":59,"searchKey":437,"visible":15},"10003196",{"type":10,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":13,"currentStage":22,"position":443,"attributes":444},"021",1020100,"삑삑초","/cdn/init/Wiki_Aniimo_10201.png","초원에서 무리를 이루어 서식하며, 평소에는 땅속으로 들어가 영양분을 흡수한다. 모여서 노래하는 걸 좋아하지만, 본인의 음이 어긋나도 전혀 모른다.",[24],[350],{"id":446,"viewCount":59,"searchKey":447,"visible":15},"10003189",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":13,"currentStage":264,"position":453,"attributes":454},"022",1020300,"위치그라스","/cdn/init/Wiki_Aniimo_10203.png","자신의 영역에 침입한 존재를 몹시 싫어해, 기묘한 음파로 상대의 정신을 흐트러뜨리고 방어력을 떨어뜨리며, 심하면 기절시키기도 한다.",[403],[277,350],{"id":456,"viewCount":59,"searchKey":457,"visible":15},"10003179",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":13,"currentStage":264,"position":463,"attributes":464},"023",1020700,"굴파미","/cdn/init/Wiki_Aniimo_10207.png","오랜 시간 땅속에 묻혀 있다가 다시 모습을 드러냈을 때는 이미 몸집이 거대해져 있었다. 뿌리로 흙 속 영양분을 흡수해야만 활력을 유지할 수 있어, 땅을 떠나는 것을 몹시 싫어한다.",[24],[350],{"id":466,"viewCount":59,"searchKey":467,"visible":15},"10003342",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":13,"currentStage":22,"position":473,"attributes":474},"024",1016100,"싹크랩","/cdn/init/Wiki_Aniimo_10161.png","평생 단 한 짝만을 선택하는 종으로, 사랑에 매우 충실하다. 늘 짝을 이루어 다니며, 머리 위의 게심초는 행복의 정도를 드러낸다.",[24],[26,350],{"id":476,"viewCount":59,"searchKey":477,"visible":15},"10003237",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":13,"currentStage":264,"position":483,"attributes":484},"025",1016200,"풀크랩","/cdn/init/Wiki_Aniimo_10162.png","등껍질을 뒤덮은 식물은 햇빛을 받아 영양을 공급하며, 햇빛이 충분하면 따로 먹이를 먹지 않아도 살아갈 수 있다.",[24],[26,350],{"id":486,"viewCount":59,"searchKey":487,"visible":15},"10003326",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":13,"currentStage":264,"position":493,"attributes":494},"026",1016300,"스탈크랩","/cdn/init/Wiki_Aniimo_10163.png","동굴에 숨어 지내며, 먹이에 포함된 광물 성분의 영향으로 등껍질이 점차 결정으로 뒤덮였다. 평소에는 땅속에 숨어 있다가 아름다운 등껍질로 먹잇감을 유인한다.",[24],[393],{"id":496,"viewCount":59,"searchKey":497,"visible":15},"10003184",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":13,"currentStage":22,"position":503,"attributes":504},"027",1033100,"도깨불","/cdn/init/Wiki_Aniimo_10331.png","겉모습은 불꽃 같지만, 사실은 에너지의 흐름이 만들어 낸 모습일 뿐이다. 열을 내기는커녕 오히려 주변의 열을 빨아들이고, 가끔은 이를 이용해 모닥불인 척 장난을 치기도 한다.",[403],[244],{"id":506,"viewCount":59,"searchKey":507,"visible":15},"10003282",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":13,"currentStage":264,"position":513,"attributes":514},"028",1033300,"일렁깨비","/cdn/init/Wiki_Aniimo_10333.png","밤에만 나타나고, 몸이 기체 에너지로 이루어져 있어 자유롭게 분열하거나 분신까지 만들어 낼 수 있다.",[403],[244],{"id":516,"viewCount":59,"searchKey":517,"visible":15},"10003317",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":13,"currentStage":22,"position":523,"attributes":524},"029",1023100,"반짝쵸","/cdn/init/Wiki_Aniimo_10231.png","겁이 많고 경계심이 강하다. 위험을 느끼면 곧바로 몸을 숨기지만, 떨어진 형광 비늘가루 때문에 오히려 행적이 드러난다.",[370],[309],{"id":526,"viewCount":59,"searchKey":527,"visible":15},"10003215",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":13,"currentStage":264,"position":533,"attributes":534},"030",1023200,"판타쵸","/cdn/init/Wiki_Aniimo_10232.png","차갑고 무심한 성격으로 혼자 지내는 것을 좋아하며, 위험이 다가오면 날개를 퍼덕여 비늘가루를 흩뿌려 환각으로 상대를 혼란시키고 그 틈에 유유히 떠난다.",[370],[309],{"id":536,"viewCount":59,"searchKey":537,"visible":15},"10003338",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":13,"currentStage":228,"position":543,"attributes":544},"031",1023300,"드림쵸","/cdn/init/Wiki_Aniimo_10233.png","화려하게 빛나는 나비 날개를 지녔고, 날갯짓할 때마다 흩뿌리는 비늘가루는 식물의 성장을 돕는다. 그가 지나간 자리에는 늘 생기가 넘친다.",[403],[309,350],{"id":546,"viewCount":59,"searchKey":547,"visible":15},"10003143",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":13,"currentStage":22,"position":553,"attributes":554},"032",1044100,"래빗배트","/cdn/init/Wiki_Aniimo_10441.png","커다란 귀를 쫑긋 세우고 있다. 소리에 매우 민감해, 한 번 포착한 움직임은 거리와 관계없이 놓치지 않는다.",[307],[309],{"id":556,"viewCount":59,"searchKey":557,"visible":15},"10003138",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":13,"currentStage":264,"position":563,"attributes":564},"033",1044300,"디텍배트","/cdn/init/Wiki_Aniimo_10443.png","호기심이 많아 흔적을 쫓아 대상을 추적하는 걸 즐긴다. 꼬리 끝의 고리는 초음파를 증폭시켜, 숨어 있는 상대도 단번에 찾아낸다.",[307],[309],{"id":566,"viewCount":59,"searchKey":567,"visible":15},"10003290",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":13,"currentStage":22,"position":573,"attributes":574},"034",1032100,"울먹팡","/cdn/init/Wiki_Aniimo_10321.png","겁이 많고 아픈 것도 싫어해 툭하면 울지만, 궁지에 몰리면 가시를 휘두르며 맞서기도 한다. 진심으로 용기를 내면 머리 위의 꽃봉오리가 활짝 피어난다.",[242],[350],{"id":576,"viewCount":59,"searchKey":577,"visible":15},"10003271",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":13,"currentStage":264,"position":583,"attributes":584},"035",1032300,"콕콕바라","/cdn/init/Wiki_Aniimo_10323.png","가시 줄기로 만든 검은 평소 팔의 잎 안에 접어 두었다가, 전투가 시작되면 꺼내 든다. 두려움을 모르는 성격으로 도전을 마다하지 않고, 무리를 지키기 위해 힘을 다한다.",[242],[350],{"id":586,"viewCount":59,"searchKey":587,"visible":15},"10003153",{"type":10,"entryId":588,"sortOrder":589,"name":590,"imageUrl":591,"description":592,"currentMorphology":13,"currentStage":264,"position":593,"attributes":594},"036",1032400,"플로리안","/cdn/init/Wiki_Aniimo_10324.png","분쟁을 가라앉히기 위해 향기로운 꽃잎을 흩뿌리며, 꽃잎에 닿은 대상은 행복한 기분에 휩싸여 전의를 잃는다.",[307],[350],{"id":596,"viewCount":59,"searchKey":597,"visible":15},"10003231",{"type":10,"entryId":598,"sortOrder":599,"name":600,"imageUrl":601,"description":602,"currentMorphology":13,"currentStage":22,"position":603,"attributes":604},"037",1047100,"라라에그","/cdn/init/Wiki_Aniimo_10471.png","쉴 때는 껍데기 속에 몸을 숨겨 종종 애니모 알로 착각되곤 한다. 싸움은 무서워하면서도 북적이는 건 좋아해, 풀공을 흔들며 춤으로 응원한다.",[24],[350],{"id":606,"viewCount":59,"searchKey":607,"visible":15},"10003149",{"type":10,"entryId":608,"sortOrder":609,"name":610,"imageUrl":611,"description":612,"currentMorphology":13,"currentStage":264,"position":613,"attributes":614},"038",1047400,"썬더자드","/cdn/init/Wiki_Aniimo_10474.png","팔다리가 유연해 누구를 만나든 화려한 발차기를 뽐내려 한다. 벗어낸 허물을 후드처럼 머리에 쓰는 것도 좋아한다.",[307],[615],"attributes-electric",{"id":617,"viewCount":59,"searchKey":618,"visible":15},"10003218",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":13,"currentStage":264,"position":624,"attributes":625},"039",1047500,"붐테일자드","/cdn/init/Wiki_Aniimo_10475.png","치솟은 갈기만 봐도 거칠고 자유분방한 성격이 느껴지며, 포효에는 짙은 야성이 담겨 있다. 꼬리는 음파를 모아 두었다가 부딪히는 순간 폭발시키는 구조다.",[24],[350],{"id":627,"viewCount":59,"searchKey":628,"visible":15},"10003278",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":13,"currentStage":22,"position":634,"attributes":635},"040",1035100,"허니버드","/cdn/init/Wiki_Aniimo_10351.png","모은 꽃꿀을 몸속에 저장해 발효시킨 뒤 향수 원료로 만들어 낸다. 조향사들에게 꼭 필요한 존재다.",[307],[277],{"id":637,"viewCount":59,"searchKey":638,"visible":15},"10003296",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":13,"currentStage":264,"position":644,"attributes":645},"041",1035200,"플로라버드","/cdn/init/Wiki_Aniimo_10352.png","향에 예민해 다양한 꽃꿀을 모아 몸속에 저장하고, 자신만의 향수 원료를 만들어 낸다. 온몸의 깃털에서는 독특한 향기가 퍼진다.",[307],[277],{"id":647,"viewCount":59,"searchKey":648,"visible":15},"10003283",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":13,"currentStage":22,"position":654,"attributes":655},"042",1003100,"싹뚜기","/cdn/init/Wiki_Aniimo_10031.png","동료를 이겨야만 진화할 수 있다. 언제 마주칠지 모를 상대에 대비해, 틈만 나면 알맞은 돌로 발톱을 갈아 날을 유지한다.",[242],[277],{"id":657,"viewCount":59,"searchKey":658,"visible":15},"10003144",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":13,"currentStage":264,"position":664,"attributes":665},"043",1003200,"서걱리퍼","/cdn/init/Wiki_Aniimo_10032.png","날을 갈아 두고 때를 노린다. 어둠 속에 몸을 숨긴 채 상대를 농락하며, 단 한 번의 일격으로 끝내려는 냉혹한 암살자다.",[242],[277],{"id":667,"viewCount":59,"searchKey":668,"visible":15},"10003276",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":13,"currentStage":264,"position":674,"attributes":675},"044",1003300,"썬더스퀵","/cdn/init/Wiki_Aniimo_10033.png","앞다리가 부러진 싹뚜기가 번개의 힘을 흡수해 진화한다. 새롭게 형성된 역날은 극도로 날카로우며, 눈부신 전류를 내뿜는다.",[242],[615],{"id":677,"viewCount":59,"searchKey":678,"visible":15},"10003197",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":13,"currentStage":22,"position":684,"attributes":685},"045",1013100,"서린댕","/cdn/init/Wiki_Aniimo_10131.png","커다란 귀를 가진 활기찬 어린 늑대다. 가슴에 달린 얼음뼈 나비넥타이를 가장 좋아하며, 선을 모르는 탄멍멍을 싫어한다.",[242],[393],{"id":687,"viewCount":59,"searchKey":688,"visible":15},"10003350",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":13,"currentStage":253,"position":694,"attributes":695},"046",1013200,"빙참랑","/cdn/init/Wiki_Aniimo_10132.png","투지를 잃는 것을 두려워해 쓰다듬어지는 걸 좋아하지 않는다. 무리 사냥에 나설 때면 얼음 칼날을 물고 앞장서며, 언젠가 홀로 설 수 있는 전사를 꿈꾼다.",[242],[393],{"id":697,"viewCount":59,"searchKey":698,"visible":15},"10003190",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":13,"currentStage":264,"position":704,"attributes":705},"047",1013300,"설휘랑","/cdn/init/Wiki_Aniimo_10133.png","자신의 힘에 절대적인 확신을 가진 오만한 전사다. 입에 문 얼음 칼날에서는 매서운 냉기가 흘러나오며, 강한 적과 마주할 때만 흥분한다.",[242],[393],{"id":707,"viewCount":59,"searchKey":708,"visible":15},"10003299",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":13,"currentStage":22,"position":714,"attributes":715},"048",1022100,"라이트밍","/cdn/init/Wiki_Aniimo_10221.png","숲속에 서식하며, 공격할 때는 꼬리에서 금빛 번개가 튀고 전류가 타닥거리는 소리가 난다. 동작이 민첩해 붙잡기 어렵다.",[24],[615],{"id":717,"viewCount":59,"searchKey":718,"visible":15},"10003250",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":13,"currentStage":264,"position":724,"attributes":725},"049",1022200,"볼트밍","/cdn/init/Wiki_Aniimo_10222.png","특수한 털에서 생기는 정전기로 공기 중의 전하 입자를 끌어 모아 전기를 저장한다. 물에 젖으면 축전 능력이 떨어져 비 오는 날에는 좀처럼 모습을 드러내지 않는다.",[24],[615],{"id":727,"viewCount":59,"searchKey":728,"visible":15},"10003298",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":13,"currentStage":22,"position":734,"attributes":735},"050",1017100,"수줍달","/cdn/init/Wiki_Aniimo_10171.png","여기저기 파헤치며 구애 선물로 쓸 것을 찾지만, 쉽게 부끄러워해 번번이 고백에 실패하고 만다. 작은 집게로 볼을 비비는 것이 특징이다.",[24],[372],{"id":737,"viewCount":59,"searchKey":738,"visible":15},"10003173",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":13,"currentStage":253,"position":744,"attributes":745},"051",1017200,"보글달","/cdn/init/Wiki_Aniimo_10172.png","자신에게 맞는 삽을 만들기 위해 조개껍데기를 신중하게 고른다. 마음에 드는 상대를 만나면 분홍빛 거품을 뿜어낸다고 한다.",[24],[372],{"id":747,"viewCount":59,"searchKey":748,"visible":15},"10003291",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":13,"currentStage":264,"position":754,"attributes":755},"052",1017300,"둥실달","/cdn/init/Wiki_Aniimo_10173.png","자기애가 다소 강해 매일 오랜 시간을 들여 털을 손질하고, 물 밖으로 나오는 자세까지 계산할 만큼 시선을 받는 것을 즐긴다. 하지만 발달한 근육은 풍성한 털에 가려 자랑할 수 없다.",[307],[372],{"id":757,"viewCount":59,"searchKey":758,"visible":15},"10003341",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":13,"currentStage":264,"position":764,"attributes":765},"053",1017400,"둔둔달","/cdn/init/Wiki_Aniimo_10174.png","튼튼한 몸에서 강한 힘을 발휘할 수 있지만, 이를 과시하기보다는 둥지에 머물며 장식품을 모아 꾸미는 것을 더 좋아한다.",[24],[372],{"id":767,"viewCount":59,"searchKey":768,"visible":15},"10003228",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":13,"currentStage":22,"position":774,"attributes":775},"054",1019100,"클램스타","/cdn/init/Wiki_Aniimo_10191.png","부드러운 촉수로 조개껍데기를 감싸 몸을 숨기고, 해변의 평범한 조개 무리 속에 섞여 지낸다. 평소에는 껍데기를 꼭 닫고 있다가, 밤이 되면 열어 달빛을 쬔다.",[242],[372],{"id":777,"viewCount":59,"searchKey":778,"visible":15},"10003352",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":13,"currentStage":253,"position":784,"attributes":785},"055",1019200,"위즈스타","/cdn/init/Wiki_Aniimo_10192.png","밤하늘을 동경해 자주 등껍질 위에 누워 몸을 흔들며, 눈을 감은 채 별이 빚어낸 꿈에 잠긴다.",[242],[372],{"id":787,"viewCount":59,"searchKey":788,"visible":15},"10003345",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":13,"currentStage":264,"position":794,"attributes":795},"056",1019400,"나이트스타","/cdn/init/Wiki_Aniimo_10194.png","한때 자신을 감싸던 껍데기를 검과 방패로 삼는다. 연약한 클램스타가 위험에 처하면 가장 먼저 나서고, 해안선을 따라 파도에 몸을 맡긴 채 흘러가듯 움직이는 것을 좋아한다.",[242],[372],{"id":797,"viewCount":59,"searchKey":798,"visible":15},"10003340",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":13,"currentStage":22,"position":804,"attributes":805},"057",1045100,"데굴굴","/cdn/init/Wiki_Aniimo_10451.png","태어날 때부터 돌구슬과 한순간도 떨어져 본 적이 없다. 쉼 없이 굴려 점점 더 둥글게 다듬어 가지만, 그 구슬은 겉보기만큼 단순해 보이지는 않는다.",[242],[26],{"id":807,"viewCount":59,"searchKey":808,"visible":15},"10003251",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":13,"currentStage":264,"position":814,"attributes":815},"058",1045300,"모터터","/cdn/init/Wiki_Aniimo_10453.png","예전처럼 뒤로 이동하지만, 이제는 구르기를 완전히 익혀 다양한 고난도 기술로 상대를 공격한다.",[242],[26],{"id":817,"viewCount":59,"searchKey":818,"visible":15},"10003241",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":13,"currentStage":264,"position":824,"attributes":825},"059",1045400,"록볼볼","/cdn/init/Wiki_Aniimo_10454.png","데굴굴과 늘 함께해 온 돌구슬은 끊임없는 흔들림 끝에 깨어났다. 더 이상 제 뜻대로 움직일 수 없는 삶에 질려, 벌레의 몸을 삼킨 뒤 스스로 움직이기 시작했다.",[307],[26],{"id":827,"viewCount":59,"searchKey":828,"visible":15},"10003154",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":13,"currentStage":22,"position":834,"attributes":835},"060",1029100,"엔젤멍","/cdn/init/Wiki_Aniimo_10291.png","항상 특유의 밝은 미소로 다른 애니모를 불러 함께 놀자고 한다. 장난기와 식탐 때문에 가끔 말썽을 부리기도 하지만, 늘 모두에게 용서받는다.",[242],[615],{"id":837,"viewCount":59,"searchKey":838,"visible":15},"10003151",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":13,"currentStage":264,"position":844,"attributes":845},"061",1029300,"우스멍","/cdn/init/Wiki_Aniimo_10293.png","털의 높은 전도성으로 번개의 힘을 모아 날개처럼 펼치고, 번개처럼 돌진해 먹구름을 걷어내 기분까지 함께 맑아지게 한다.",[242],[615],{"id":847,"viewCount":59,"searchKey":848,"visible":15},"10003318",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":13,"currentStage":22,"position":854,"attributes":855},"062",1002100,"투구누니","/cdn/init/Wiki_Aniimo_10021.png","단단한 투구로 부드러운 몸을 보호한다. 입에서 갈고리처럼 휘어진 발톱을 뻗어 먹이를 사냥하며, 탄력 있는 몸 덕분에 자기 몸집의 10배에 달하는 먹이도 담아 둘 수 있다.",[24],[277],{"id":857,"viewCount":59,"searchKey":858,"visible":15},"10003332",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":13,"currentStage":264,"position":864,"attributes":865},"063",1002600,"누니용사","/cdn/init/Wiki_Aniimo_10026.png","부러진 검과 갑옷을 얻고, 용기와 힘을 이어받아 마침내 동료를 지키고 강적에 맞서 싸우는 진정한 용사가 되었다.",[242],[277],{"id":867,"viewCount":59,"searchKey":868,"visible":15},"10003297",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":13,"currentStage":264,"position":874,"attributes":875},"064",1002700,"아머누니","/cdn/init/Wiki_Aniimo_10027.png","덩치는 크지만 온순하고 겁이 많아 싸움을 피하려 한다. 위험에 처하면 몸을 둥글게 말지만, 동료를 지키기 위해서라면 용기를 내어 맞서 싸운다.",[24],[277],{"id":877,"viewCount":59,"searchKey":878,"visible":15},"10003354",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":13,"currentStage":22,"position":884,"attributes":885},"065",1002400,"바이티","/cdn/init/Wiki_Aniimo_10024.png","지나는 것은 무엇이든 한 번씩 깨무는 버릇이 있다. 턱의 가동성이 좋아 크게 벌릴 수 있으며, 가볍게 깨무는 행동으로 애정과 기쁨을 표현한다. 특히 금속을 좋아하는데 쉽게 망가지지 않기 때문이다.",[24],[309],{"id":887,"viewCount":59,"searchKey":888,"visible":15},"10003164",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":13,"currentStage":253,"position":894,"attributes":895},"066",1002200,"갸면뇽","/cdn/init/Wiki_Aniimo_10022.png","연약함을 투구 아래에 숨긴 어린 용이다. 더 강해져 자유롭게 하늘을 날며, 세상 곳곳의 숨겨진 보물을 찾기를 꿈꾼다.",[24],[309],{"id":897,"viewCount":59,"searchKey":898,"visible":15},"10003311",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":13,"currentStage":264,"position":904,"attributes":905},"067",1002300,"갸고일","/cdn/init/Wiki_Aniimo_10023.png","온몸이 단단한 갑옷으로 뒤덮여 있다. 움직이지 않고 바위 위에 서 있으면 거대한 석상처럼 보이며, 전설에 따르면 유적 입구를 지키며 고대 보물을 수호한다고 한다.",[24],[309],{"id":907,"viewCount":59,"searchKey":908,"visible":15},"10003304",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":13,"currentStage":264,"position":914,"attributes":915},"068",1002500,"갸갑파이어","/cdn/init/Wiki_Aniimo_10025.png","불꽃으로 단련된 금속 중갑을 두르고 있다. 분노할 때 내뿜는 불길은 주변을 녹여버릴 만큼 강력하다. 재가 되고 싶지 않다면 가까이 가지 않는 편이 좋다.",[242],[244],{"id":917,"viewCount":59,"searchKey":918,"visible":15},"10003208",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":13,"currentStage":22,"position":924,"attributes":925},"069",1050100,"드리미","/cdn/init/Wiki_Aniimo_10501.png","낮에는 몽유 상태로 돌아다닌다. 깨우는 순간 난폭해지지만, 기운이 다하면 다시 깊은 잠에 빠져든다.",[242],[26],{"id":927,"viewCount":59,"searchKey":928,"visible":15},"10003202",{"type":10,"entryId":8,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":13,"currentStage":264,"position":933,"attributes":934},1050300,"푹자곰","/cdn/init/Wiki_Aniimo_10503.png","평소에는 온순하지만, 그 안에는 늘 억눌린 감정이 쌓여 있다. 자극을 받거나 배가 고프면 이를 참지 못하고 광폭해진다.",[242],[26],{"id":4,"viewCount":59,"searchKey":936,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":937,"attributes":938},[24],[26],{"id":6,"viewCount":59,"searchKey":940,"visible":15},{"type":10,"entryId":12,"sortOrder":941,"name":81,"imageUrl":942,"description":943,"currentMorphology":13,"currentStage":253,"position":944,"attributes":945},1028200,"/cdn/init/Wiki_Aniimo_10282.png","단단한 발톱으로 결정석을 부수어 먹고 열을 축적해, 몸에는 붉은빛 무늬가 드러난다. 작은 체구지만 입에서 고온의 불길을 계속해서 뿜어낼 수 있다.",[24],[244,26],{"id":947,"viewCount":59,"searchKey":948,"visible":15},"10003174",{"type":10,"entryId":949,"sortOrder":950,"name":89,"imageUrl":951,"description":952,"currentMorphology":13,"currentStage":264,"position":953,"attributes":954},"073",1028300,"/cdn/init/Wiki_Aniimo_10283.png","타오르는 결정이 굳은 용암처럼 몸에 자리 잡고 있으며, 그 안에 쌓인 열이 한꺼번에 폭발하면 앞을 가로막는 모든 것을 녹여버린다.",[24],[244,26],{"id":956,"viewCount":59,"searchKey":957,"visible":15},"10003293",{"type":10,"entryId":958,"sortOrder":959,"name":97,"imageUrl":960,"description":961,"currentMorphology":13,"currentStage":253,"position":962,"attributes":963},"074",1028400,"/cdn/init/Wiki_Aniimo_10284.png","섭취한 광물은 체내에서 정제되어, 순수한 에너지를 담은 결정 척추로 자라난다.",[24],[26],{"id":965,"viewCount":59,"searchKey":966,"visible":15},"10003168",{"type":10,"entryId":967,"sortOrder":968,"name":104,"imageUrl":969,"description":970,"currentMorphology":13,"currentStage":264,"position":971,"attributes":972},"075",1028500,"/cdn/init/Wiki_Aniimo_10285.png","수정 광맥이 풍부한 곳에 서식하며, 등에 난 단단한 결정 척추는 몸을 보호하고 에너지를 저장하는 역할을 한다.",[24],[26],{"id":974,"viewCount":59,"searchKey":975,"visible":15},"10003161",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":13,"currentStage":22,"position":981,"attributes":982},"076",1043100,"침니앤트","/cdn/init/Wiki_Aniimo_10431.png","침니앤트는 흙을 차곡차곡 쌓아 올려 외피를 만든다. 위험을 느끼면 위쪽 구멍에서 연기를 뿜어내 주변을 뒤덮고 모습을 숨긴다.",[307],[26],{"id":984,"viewCount":59,"searchKey":985,"visible":15},"10003222",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":13,"currentStage":264,"position":991,"attributes":992},"077",1043300,"캐슬앤트","/cdn/init/Wiki_Aniimo_10433.png","상하체가 따로 회전하는 구조 덕분에 캐슬앤트는 주변을 유연하게 살필 수 있다. 상황에 따라 형태를 바꿔 포탑처럼 변해 적을 물리친다.",[307],[26],{"id":994,"viewCount":59,"searchKey":995,"visible":15},"10003272",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":13,"currentStage":22,"position":1001,"attributes":1002},"078",1014100,"램프젤리","/cdn/init/Wiki_Aniimo_10141.png","겁이 많아 작은 인기척에도 바로 달아난다. 머리 위의 전구처럼 생긴 기관은 건강 상태에 따라 변한다.",[307],[615],{"id":1004,"viewCount":59,"searchKey":1005,"visible":15},"10003254",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":13,"currentStage":253,"position":1011,"attributes":1012},"079",1014200,"루미젤리","/cdn/init/Wiki_Aniimo_10142.png","어둠을 무서워하는 해파리다. 밤이 되면 스스로 빛을 내며, 잠이 들어도 그 빛은 꺼지지 않아 마치 밤을 지키는 등불처럼 보인다.",[307],[615],{"id":1014,"viewCount":59,"searchKey":1015,"visible":15},"10003163",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":13,"currentStage":264,"position":1021,"attributes":1022},"080",1014300,"샹들라젤리","/cdn/init/Wiki_Aniimo_10143.png","기분에 따라 빛의 밝기와 깜박임의 빈도를 자유롭게 조절한다. 촉수는 화려한 빛무늬를 만들어낼 뿐만 아니라, 전류를 흘려 상대를 공격하기도 한다.",[307],[615],{"id":1024,"viewCount":59,"searchKey":1025,"visible":15},"10003204",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":13,"currentStage":22,"position":1031,"attributes":1032},"081",1048100,"버블버드","/cdn/init/Wiki_Aniimo_10481.png","몸의 기름기를 문질러 거품을 만들어 낸다. 이 거품은 몸을 깨끗하게 하고 보호해 주지만, 가끔은 거품을 밟고 미끄러지기도 한다.",[403],[372],{"id":1034,"viewCount":59,"searchKey":1035,"visible":15},"10003205",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":13,"currentStage":264,"position":1041,"attributes":1042},"082",1048300,"폼폼버드","/cdn/init/Wiki_Aniimo_10483.png","깃털에서 기름이 계속 분비되어 조금만 문질러도 다양한 거품이 만들어진다. 등에 업은 새끼를 보호할 때는 그중에서도 가장 부드럽고 촘촘한 거품을 쓴다.",[403],[372],{"id":1044,"viewCount":59,"searchKey":1045,"visible":15},"10003324",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":13,"currentStage":228,"position":1051,"attributes":1052},"083",1012200,"베서스","/cdn/init/Wiki_Aniimo_10122.png","심장 박동의 리듬에 시달리는 베서스는 그 박동을 덮을 비트를 끊임없이 찾는다. 음악에 맞춰 몸을 흔드는 것을 좋아하며, 특히 개성 강한 음악을 즐긴다.",[403],[615],{"id":1054,"viewCount":59,"searchKey":1055,"visible":15},"10003269",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":13,"currentStage":22,"position":1061,"attributes":1062},"084",1038100,"쉘코랄","/cdn/init/Wiki_Aniimo_10381.png","몸을 땅속에 묻어 산호처럼 위장하다가, 먹이가 가까이 오면 단숨에 물어버린다. 하지만 가끔은 참지 못하고 눈만 내민 채 주위를 살피기도 한다.",[403],[26,372],{"id":1064,"viewCount":59,"searchKey":1065,"visible":15},"10003261",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":13,"currentStage":264,"position":1071,"attributes":1072},"085",1038300,"코랄드래곤","/cdn/init/Wiki_Aniimo_10383.png","몸을 모래 속에 파묻은 채 산호 군락처럼 위장한다. 머리와 등에 자란 산호에서 빛을 내어 생물을 유인한 뒤, 기회를 포착해 기습한다.",[403],[26,372],{"id":1074,"viewCount":59,"searchKey":1075,"visible":15},"10003305",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":13,"currentStage":22,"position":1081,"attributes":1082},"086",1046100,"시뚠뚠","/cdn/init/Wiki_Aniimo_10461.png","볼의 둥근 무늬는 종종 눈으로 착각되곤 한다. 해안가에 무리를 지어 나타나는 걸 좋아하며, 서로 바짝 붙어 있을 때 가장 편안해한다.",[24],[393],{"id":1084,"viewCount":59,"searchKey":1085,"visible":15},"10003232",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":13,"currentStage":264,"position":1091,"attributes":1092},"087",1046300,"랑뚠뚠","/cdn/init/Wiki_Aniimo_10463.png","네 발로 땅을 이동할 때는 다소 둔해 보이지만, 배로 미끄러지듯 이동하는 데는 능하다. 같은 성별끼리는 영역 의식이 강해, 화가 나면 해일처럼 거센 기세를 드러낸다.",[24],[393],{"id":1094,"viewCount":59,"searchKey":1095,"visible":15},"10003198",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":13,"currentStage":22,"position":1101,"attributes":1102},"088",1058100,"리프램","/cdn/init/Wiki_Aniimo_10581.png","나른하게 잎사귀 깃털을 펼치고 입은 늘 뭔가를 씹고 있다. 녹조와 점액을 거품으로 바꾸고, 가볍게 뛰어올라 거품을 타고 유유히 여행을 시작한다.",[370],[350,372],{"id":1104,"viewCount":59,"searchKey":1105,"visible":15},"10003194",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":13,"currentStage":264,"position":1111,"attributes":1112},"089",1058300,"리벨라","/cdn/init/Wiki_Aniimo_10583.png","푸르른 잎사귀 깃털로 몸을 감싼 리벨라는 가벼운 몸놀림으로 호숫가를 한가로이 거닌다. 리벨라는 맑고 투명한 물결을 사랑하고, 수면에 비친 자신의 우아하고 차분한 모습을 감상하는 데에 푹 빠져 있다.",[370],[350,372],{"id":1114,"viewCount":59,"searchKey":1115,"visible":15},"10003185",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":13,"currentStage":22,"position":1121,"attributes":1122},"090",1062100,"버블코타","/cdn/init/Wiki_Aniimo_10621.png","다채로운 거품을 모으는 것을 좋아하며, 공기주머니 속 거품은 몸을 움직일 때마다 일렁인다. 영감이 떠오르면 형형색색의 거품으로 신기한 낙서를 그려낸다.",[242],[372],{"id":1124,"viewCount":59,"searchKey":1125,"visible":15},"10003284",{"type":10,"entryId":1126,"sortOrder":1127,"name":1128,"imageUrl":1129,"description":1130,"currentMorphology":13,"currentStage":264,"position":1131,"attributes":1132},"091",1062300,"가챠코","/cdn/init/Wiki_Aniimo_10623.png","유연한 촉수로 머리를 자극해 각양각색의 캡슐 거품을 발사할 수 있다. 거품 속에 숨겨진 것이 놀라움일지, 아니면 뜻밖의 사고일지는 아무도 모른다.",[242],[372],{"id":1134,"viewCount":59,"searchKey":1135,"visible":15},"10003188",{"type":10,"entryId":1136,"sortOrder":1137,"name":1138,"imageUrl":1139,"description":1140,"currentMorphology":13,"currentStage":22,"position":1141,"attributes":1142},"092",1042100,"엔젤후드","/cdn/init/Wiki_Aniimo_10421.png","밝은 미소로 자신을 감춘 채 조용히 목표에 접근한다. 전투가 시작되는 순간 본모습을 드러내며, 곧바로 덮칠 듯 날카로운 이빨을 드러낸다.",[242],[393],{"id":1144,"viewCount":59,"searchKey":1145,"visible":15},"10003182",{"type":10,"entryId":1146,"sortOrder":1147,"name":1148,"imageUrl":1149,"description":1150,"currentMorphology":13,"currentStage":264,"position":1151,"attributes":1152},"093",1042300,"이블엔젤","/cdn/init/Wiki_Aniimo_10423.png","부드러운 몸 안에 날카로운 이빨과 발톱을 숨기고 있다. 온순하고 무해해 보이는 모습으로 상대를 방심하게 만든 뒤 얼려 버린다.",[242],[393],{"id":1154,"viewCount":59,"searchKey":1155,"visible":15},"10003273",{"type":10,"entryId":1156,"sortOrder":1157,"name":1158,"imageUrl":1159,"description":1160,"currentMorphology":13,"currentStage":228,"position":1161,"attributes":1162},"9997",1037300,"루나티아","/cdn/init/Wiki_Aniimo_10373.png","털에는 부드러운 달빛이 흐르는 듯해 쉽게 다가가기 어려운 인상을 준다. 늘 이성적이고 침착하지만, 가까운 이들 앞에서는 다정한 면을 보이기도 한다.",[242],[1163],"attributes-holy",{"id":1165,"viewCount":59,"searchKey":1166,"visible":15},"10003150",{"type":10,"entryId":1167,"sortOrder":1168,"name":1169,"imageUrl":1170,"description":1171,"currentMorphology":13,"currentStage":228,"position":1172,"attributes":1173},"9998",1036100,"헬리온","/cdn/init/Wiki_Aniimo_10361.png","열정적이고 활발하며 자신감이 넘친다. 동료를 지키는 데 망설임이 없고, 위기의 순간에는 강한 힘이 각성되어 폭발적인 전투력을 보여 준다.",[242],[1163],[1175,1183,1188,1191,1196,1201,1206,1211,1216,1221,122