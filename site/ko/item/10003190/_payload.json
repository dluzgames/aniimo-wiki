,"tagType":1215,"tagKey":1291,"name":1292,"language":1218,"sort":1293},"a5dd55d7659ba6929497a1b768057354","Mudflat Form","습지 형태",13,{"id":1295,"parentId":1214,"tagType":1215,"tagKey":1296,"name":1297,"language":1218,"sort":1298},"b4924477dc9369d2b717b9ca871be676","Plateau Form","고원 형태",17,{"id":1300,"parentId":1214,"tagType":1215,"tagKey":1301,"name":1302,"language":1218,"sort":1303},"c386b0e74f27675730ef0f5fd54ea37b","Towerwood Form","타워 숲 형태",19]