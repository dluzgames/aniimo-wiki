,279,289,299,309,320,330,342,352,363,374,384,394,404,414,424,434,445,455,465,475,485,495,505,515,525,535,545,555,565,575,586,596,606,616,626,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,845,849,859,869,879,889,899,909,919,929,939,949,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1140],{"id":204,"viewCount":57,"searchKey":205,"visible":15},"10002767",{"type":10,"entryId":206,"sortOrder":207,"name":208,"imageUrl":209,"description":210,"currentMorphology":21,"currentStage":22,"position":211,"attributes":213},"001",1005100,"Emberpup","/cdn/init/Wiki_Aniimo_10051.png","The lively creatures like to follow Flameruffs around. Once the smoldering fur starts to burn, they thrive.",[212],"position-dps",[214],"attributes-fire",{"id":216,"viewCount":57,"searchKey":217,"visible":15},"10002859",{"type":10,"entryId":218,"sortOrder":219,"name":220,"imageUrl":221,"description":222,"currentMorphology":21,"currentStage":223,"position":224,"attributes":225},"002",1005200,"Flameruff","/cdn/init/Wiki_Aniimo_10052.png","Pack creatures that prize loyalty and unity, these hunters maintain focused, calm eyes that mask their fiery hearts.","2",[212],[214],{"id":227,"viewCount":57,"searchKey":228,"visible":15},"10002760",{"type":10,"entryId":229,"sortOrder":230,"name":231,"imageUrl":232,"description":233,"currentMorphology":21,"currentStage":234,"position":235,"attributes":236},"003",1005300,"Scorchhowl","/cdn/init/Wiki_Aniimo_10053.png","They enjoy the thrill of the fight since flame and burning mark their growth.","3",[212],[214],{"id":238,"viewCount":57,"searchKey":239,"visible":15},"10002753",{"type":10,"entryId":240,"sortOrder":241,"name":242,"imageUrl":243,"description":244,"currentMorphology":21,"currentStage":234,"position":245,"attributes":246},"004",1005500,"Inferlupa","/cdn/init/Wiki_Aniimo_10055.png","A Flameruff who challenged the strong and lost, absorbing the souls of companions who fell with equal bitterness. It is driven by the desire for revenge.",[24],[214,247],"attributes-dark",{"id":249,"viewCount":57,"searchKey":250,"visible":15},"10002903",{"type":10,"entryId":251,"sortOrder":252,"name":253,"imageUrl":254,"description":255,"currentMorphology":21,"currentStage":22,"position":256,"attributes":257},"005",1001100,"Celestis","/cdn/init/Wiki_Aniimo_10011.png","They love food! When they search the forest for food, the glowing stars on their heads are often mistaken for comets. They like hoarding food, adorning their nest with it.",[212],[247],{"id":259,"viewCount":57,"searchKey":260,"visible":15},"10002742",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":21,"currentStage":234,"position":266,"attributes":267},"006",1001200,"Stellarys","/cdn/init/Wiki_Aniimo_10012.png","They prefer solitude and often move through the night. With their starry, cloak-like forms, they resemble mysterious mages and can teleport using psychic energy.",[212],[247],{"id":269,"viewCount":57,"searchKey":270,"visible":15},"10002813",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":21,"currentStage":22,"position":276,"attributes":278},"007",1018100,"Chirpi","/cdn/init/Wiki_Aniimo_10181.png","They often hover at low altitudes, paying attention to every movement on the beach so they won't miss any opportunity.",[277],"position-sup",[26],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10002873",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":21,"currentStage":234,"position":287,"attributes":288},"008",1018400,"Tromber","/cdn/init/Wiki_Aniimo_10184.png","They like having fun and producing rhythmic music, so don't be surprised to see a grand symphony.",[277],[26],{"id":290,"viewCount":57,"searchKey":291,"visible":15},"10002799",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":21,"currentStage":234,"position":297,"attributes":298},"009",1018500,"Cornet","/cdn/init/Wiki_Aniimo_10185.png","They can produce loud, piercing noises that resonate throughout the entire beach just to draw attention.",[212],[26],{"id":300,"viewCount":57,"searchKey":301,"visible":15},"10002792",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":21,"currentStage":234,"position":307,"attributes":308},"010",1018700,"Tubster","/cdn/init/Wiki_Aniimo_10187.png","Creates deep, tuba-like sounds that match its steady, friendly character.",[24],[26],{"id":310,"viewCount":57,"searchKey":311,"visible":15},"10002717",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":21,"currentStage":22,"position":317,"attributes":318},"011",1021100,"Iris","/cdn/init/Wiki_Aniimo_10211.png","Iris possesses an extremely lightweight body, often lifted by the wind. It then either slowly spirals downward using the resistance from its petal skirt, or simply allows itself to be carried away by the wind.",[212],[319],"attributes-grass",{"id":321,"viewCount":57,"searchKey":322,"visible":15},"10002835",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":21,"currentStage":234,"position":328,"attributes":329},"012",1021200,"Irisal","/cdn/init/Wiki_Aniimo_10212.png","Devoted to the art of dance, they constantly hone their craft, hoping to share the pure joy and energy of movement.",[212],[319],{"id":331,"viewCount":57,"searchKey":332,"visible":15},"10002802",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":21,"currentStage":22,"position":338,"attributes":340},"014",1004100,"Skippy","/cdn/init/Wiki_Aniimo_10041.png","They like to hide underwater and observe their surroundings using a lotus leaf as a strikingly ineffective disguise.",[339],"position-heal",[341],"attributes-water",{"id":343,"viewCount":57,"searchKey":344,"visible":15},"10002894",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":21,"currentStage":223,"position":350,"attributes":351},"015",1004200,"Pranky","/cdn/init/Wiki_Aniimo_10042.png","They like to stay cool and moist. That's what the layer of film over their bodies is for.",[339],[341],{"id":353,"viewCount":57,"searchKey":354,"visible":15},"10002795",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":21,"currentStage":234,"position":360,"attributes":361},"016",1004300,"Glacy","/cdn/init/Wiki_Aniimo_10043.png","They are elegant and kind aniimo that always take care of weaker ones, and freeze anyone who crosses them in ice.",[339],[341,362],"attributes-ice",{"id":364,"viewCount":57,"searchKey":365,"visible":15},"10002788",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":21,"currentStage":234,"position":371,"attributes":373},"017",1004500,"Leafy","/cdn/init/Wiki_Aniimo_10045.png","They live among lotus flowers and use their lotus leaf tails to conceal their face and show off their elegant nature.",[372],"position-energy",[319,341],{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10002793",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":21,"currentStage":22,"position":382,"attributes":383},"018",1026100,"Nimbi","/cdn/init/Wiki_Aniimo_10261.png","Don't be surprised to see them floating in the clouds in small groups above the grasslands.",[277],[26],{"id":385,"viewCount":57,"searchKey":386,"visible":15},"10002690",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":21,"currentStage":234,"position":392,"attributes":393},"019",1026200,"Turbo","/cdn/init/Wiki_Aniimo_10262.png","They like to sleep hidden in the clouds, because with the presence of wind pressure and static electricity, the fluffy wool easily attracts things that drift by on the wind.",[277],[26],{"id":395,"viewCount":57,"searchKey":396,"visible":15},"10002786",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":21,"currentStage":234,"position":402,"attributes":403},"020",1026300,"Dreaple","/cdn/init/Wiki_Aniimo_10263.png","Their fur that has absorbed dream energy presents a mesmerizing illusion of colors. When they use this fur as a pillow to sleep, they sink into sweet dreams.",[277],[247],{"id":405,"viewCount":57,"searchKey":406,"visible":15},"10002746",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":21,"currentStage":22,"position":412,"attributes":413},"021",1020100,"Hummin","/cdn/init/Wiki_Aniimo_10201.png","They live on the grassland in groups, they like burrowing for nutrients, and they love singing off-key together!",[24],[319],{"id":415,"viewCount":57,"searchKey":416,"visible":15},"10002739",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":21,"currentStage":234,"position":422,"attributes":423},"022",1020300,"Witchin","/cdn/init/Wiki_Aniimo_10203.png","They make bizarre noises to drive intruders to madness, lower their defenses and even cause them to pass out.",[372],[247,319],{"id":425,"viewCount":57,"searchKey":426,"visible":15},"10002729",{"type":10,"entryId":427,"sortOrder":428,"name":429,"imageUrl":430,"description":431,"currentMorphology":21,"currentStage":234,"position":432,"attributes":433},"023",1020700,"Tuckin","/cdn/init/Wiki_Aniimo_10207.png","They need to absorb nutrients from the soil through their roots to maintain vitality and hate leaving the ground.",[24],[319],{"id":435,"viewCount":57,"searchKey":436,"visible":15},"10002892",{"type":10,"entryId":437,"sortOrder":438,"name":439,"imageUrl":440,"description":441,"currentMorphology":21,"currentStage":22,"position":442,"attributes":443},"024",1016100,"Budclaw.","/cdn/init/Wiki_Aniimo_10161.png","Mating for life, they're always found in pairs. The heartbloom atop their shells indicates their state of happiness.",[24],[444,319],"attributes-rock",{"id":446,"viewCount":57,"searchKey":447,"visible":15},"10002787",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":21,"currentStage":234,"position":453,"attributes":454},"025",1016200,"Shrubclaw","/cdn/init/Wiki_Aniimo_10162.png","The lush plants that cover their shells convert sunlight into nutrients, so they don't even need to eat on sunny days.",[24],[444,319],{"id":456,"viewCount":57,"searchKey":457,"visible":15},"10002876",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":21,"currentStage":234,"position":463,"attributes":464},"026",1016300,"Geoclaw","/cdn/init/Wiki_Aniimo_10163.png","They live in caves, feed on minerals, and use their beautifully crystallized shells to lure prey.",[24],[362],{"id":466,"viewCount":57,"searchKey":467,"visible":15},"10002734",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":21,"currentStage":22,"position":473,"attributes":474},"027",1033100,"Sparki","/cdn/init/Wiki_Aniimo_10331.png","Though they look like fire, those flames are only flowing energy. They give off no heat at all—in fact, they absorb heat from their surroundings. Sometimes they use this to disguise themselves as campfires and play tricks on others.",[372],[214],{"id":476,"viewCount":57,"searchKey":477,"visible":15},"10002832",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":21,"currentStage":234,"position":483,"attributes":484},"028",1033300,"Flamerion","/cdn/init/Wiki_Aniimo_10333.png","They only come out at night and their bodies are made of gaseous energy and can split as they want!",[372],[214],{"id":486,"viewCount":57,"searchKey":487,"visible":15},"10002867",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":21,"currentStage":22,"position":493,"attributes":494},"029",1023100,"Flutternym","/cdn/init/Wiki_Aniimo_10231.png","They are timid and hide whenever they sense danger, but the fluorescent scales they shake off always give them away.",[339],[26],{"id":496,"viewCount":57,"searchKey":497,"visible":15},"10002765",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":21,"currentStage":234,"position":503,"attributes":504},"030",1023200,"Gracewing","/cdn/init/Wiki_Aniimo_10232.png","Lone wanderers. They create illusions by shedding scales from their wings when threats approach.",[339],[26],{"id":506,"viewCount":57,"searchKey":507,"visible":15},"10002888",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":21,"currentStage":197,"position":513,"attributes":514},"031",1023300,"Somniwing","/cdn/init/Wiki_Aniimo_10233.png","Their magnificent wings spread scales to help flowers grow and spread vitality wherever they fly.",[372],[26,319],{"id":516,"viewCount":57,"searchKey":517,"visible":15},"10002693",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":21,"currentStage":22,"position":523,"attributes":524},"032",1044100,"Eko","/cdn/init/Wiki_Aniimo_10441.png","With their big ears perked up, they are extremely sensitive to sound. They won't miss any movement that catches their attention, near or far.",[277],[26],{"id":526,"viewCount":57,"searchKey":527,"visible":15},"10002688",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":21,"currentStage":234,"position":533,"attributes":534},"033",1044300,"Eklue","/cdn/init/Wiki_Aniimo_10443.png","Curious and keen on searching for traces and tracking targets. The ring on their tail amplifies ultrasound, allowing them to easily see through cloaked creatures.",[277],[26],{"id":536,"viewCount":57,"searchKey":537,"visible":15},"10002840",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":21,"currentStage":22,"position":543,"attributes":544},"034",1032100,"Budsquire","/cdn/init/Wiki_Aniimo_10321.png","The timid crybabies can also rise up against enemies when cornered. The buds on their heads will blossom as they do so.",[212],[319],{"id":546,"viewCount":57,"searchKey":547,"visible":15},"10002821",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":21,"currentStage":234,"position":553,"attributes":554},"035",1032300,"Thornblade","/cdn/init/Wiki_Aniimo_10323.png","The swords made from thorny stems are drawn only when it's time to protect their pack against enemies.",[212],[319],{"id":556,"viewCount":57,"searchKey":557,"visible":15},"10002703",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":21,"currentStage":234,"position":563,"attributes":564},"036",1032400,"Melloblum","/cdn/init/Wiki_Aniimo_10324.png","To quell disputes, they scatter fragrant petals, causing those who touch them to feel happiness and crush their fighting spirit.",[277],[319],{"id":566,"viewCount":57,"searchKey":567,"visible":15},"10002781",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":21,"currentStage":22,"position":573,"attributes":574},"037",1047100,"Pomegg","/cdn/init/Wiki_Aniimo_10471.png","They retreat into their shells to rest, often getting mistaken for eggs. They fear battle but love a crowd, dancing with grass balls to cheer others on.",[24],[319],{"id":576,"viewCount":57,"searchKey":577,"visible":15},"10002699",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":21,"currentStage":234,"position":583,"attributes":584},"038",1047400,"Dazmand","/cdn/init/Wiki_Aniimo_10474.png","They have flexible limbs and love to show off their flashy kicks to anyone watching. They wear their shed skin over their heads like a cool hood.",[277],[585],"attributes-electric",{"id":587,"viewCount":57,"searchKey":588,"visible":15},"10002768",{"type":10,"entryId":589,"sortOrder":590,"name":591,"imageUrl":592,"description":593,"currentMorphology":21,"currentStage":234,"position":594,"attributes":595},"039",1047500,"Pomawk","/cdn/init/Wiki_Aniimo_10475.png","Their towering manes display their wild nature, while their feral roars reveal their true colors. Their tails are built to store sound waves, releasing a sonic boom when they strike an opponent.",[24],[319],{"id":597,"viewCount":57,"searchKey":598,"visible":15},"10002828",{"type":10,"entryId":599,"sortOrder":600,"name":601,"imageUrl":602,"description":603,"currentMorphology":21,"currentStage":22,"position":604,"attributes":605},"040",1035100,"Dewy","/cdn/init/Wiki_Aniimo_10351.png","As partners to perfumers, they store and ferment nectar within their bodies, transforming it into perfume ingredients.",[277],[247],{"id":607,"viewCount":57,"searchKey":608,"visible":15},"10002846",{"type":10,"entryId":609,"sortOrder":610,"name":611,"imageUrl":612,"description":613,"currentMorphology":21,"currentStage":234,"position":614,"attributes":615},"041",1035200,"Fragrancier","/cdn/init/Wiki_Aniimo_10352.png","They're picky about odors, so they harvest and store various nectar within them to craft unique perfume ingredients.",[277],[247],{"id":617,"viewCount":57,"searchKey":618,"visible":15},"10002833",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":21,"currentStage":22,"position":624,"attributes":625},"042",1003100,"Wisptis","/cdn/init/Wiki_Aniimo_10031.png","If the only way to evolve is to defeat other Wisptises, then there is no other choice but to keep their claws sharp.",[212],[247],{"id":627,"viewCount":57,"searchKey":628,"visible":15},"10002694",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":21,"currentStage":234,"position":634,"attributes":635},"043",1003200,"Ignitis","/cdn/init/Wiki_Aniimo_10032.png","They sharpen their blades and wait for the perfect moment, hiding in the shadows as they toy with their prey. As cold-blooded assassins, they seek to end every fight in a single strike.",[212],[247],{"id":637,"viewCount":57,"searchKey":638,"visible":15},"10002826",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":21,"currentStage":234,"position":644,"attributes":645},"044",1003300,"Fulmintis","/cdn/init/Wiki_Aniimo_10033.png","Evolved from a Wisptis with broken forelimbs absorbing the power of lightning. The reshaped reverse blades are incredibly sharp and flash with dazzling electric light.",[212],[585],{"id":647,"viewCount":57,"searchKey":648,"visible":15},"10002747",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":21,"currentStage":22,"position":654,"attributes":655},"045",1013100,"Bonesky","/cdn/init/Wiki_Aniimo_10131.png","An energetic pup with a pair of big ears. The ice-bone bow tie on its chest is its favorite toy. It hates Emberpups that don’t respect personal space.",[212],[362],{"id":657,"viewCount":57,"searchKey":658,"visible":15},"10002900",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":21,"currentStage":223,"position":664,"attributes":665},"046",1013200,"Fenrier","/cdn/init/Wiki_Aniimo_10132.png","Resisting gentle pets that might soften its resolve, it leads pack hunts with its ice blade.",[212],[362],{"id":667,"viewCount":57,"searchKey":668,"visible":15},"10002740",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":21,"currentStage":234,"position":674,"attributes":675},"047",1013300,"Glynsera","/cdn/init/Wiki_Aniimo_10133.png","Proud and confident warriors, the chilling blades in its mouth send shivers down its enemies' spines.",[212],[362],{"id":677,"viewCount":57,"searchKey":678,"visible":15},"10002849",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":21,"currentStage":22,"position":684,"attributes":685},"048",1022100,"Bolty","/cdn/init/Wiki_Aniimo_10221.png","They live among the trees. When they attack, golden sparks flash from their tails with crackling electric sounds. Agile and quick on their feet, they are very difficult to catch.",[24],[585],{"id":687,"viewCount":57,"searchKey":688,"visible":15},"10002800",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":21,"currentStage":234,"position":694,"attributes":695},"049",1022200,"Blazen","/cdn/init/Wiki_Aniimo_10222.png","They use their special fur to capture charged particles in the air to produce and store electricity.",[24],[585],{"id":697,"viewCount":57,"searchKey":698,"visible":15},"10002848",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":21,"currentStage":22,"position":704,"attributes":705},"050",1017100,"Susuta","/cdn/init/Wiki_Aniimo_10171.png","They dig around to search for gifts to give to their crushes, but their wooing always fails because they are so shy.",[24],[341],{"id":707,"viewCount":57,"searchKey":708,"visible":15},"10002723",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":21,"currentStage":223,"position":714,"attributes":715},"051",1017200,"Popota","/cdn/init/Wiki_Aniimo_10172.png","They select shells and make them into shovels. It's said that they produce pink bubbles when they see someone they love.",[24],[341],{"id":717,"viewCount":57,"searchKey":718,"visible":15},"10002841",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":21,"currentStage":234,"position":724,"attributes":725},"052",1017300,"Piopiota","/cdn/init/Wiki_Aniimo_10173.png","Narcissistic little creatures who spend a large amount of time grooming their fur and striking the perfect pose.",[277],[341],{"id":727,"viewCount":57,"searchKey":728,"visible":15},"10002891",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":21,"currentStage":234,"position":734,"attributes":735},"053",1017400,"Panpanta","/cdn/init/Wiki_Aniimo_10174.png","They are strong and powerful, but they'd rather stay in their nests and decorate than show off their muscles.",[24],[341],{"id":737,"viewCount":57,"searchKey":738,"visible":15},"10002778",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":21,"currentStage":22,"position":744,"attributes":745},"054",1019100,"Shelly","/cdn/init/Wiki_Aniimo_10191.png","Conceals itself among beach shells using its soft appendages to hold shells in place. Remains sealed during daylight.",[212],[341],{"id":747,"viewCount":57,"searchKey":748,"visible":15},"10002902",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":21,"currentStage":223,"position":754,"attributes":755},"055",1019200,"Sheldon","/cdn/init/Wiki_Aniimo_10192.png","Lying on their shells, they face the night sky, drowning in a dream woven by the stars.",[212],[341],{"id":757,"viewCount":57,"searchKey":758,"visible":15},"10002895",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":21,"currentStage":234,"position":764,"attributes":765},"056",1019400,"Sherro","/cdn/init/Wiki_Aniimo_10194.png","They turn the shells that once covered them into swords and shields to protect fragile Shellies along the coastline.",[212],[341],{"id":767,"viewCount":57,"searchKey":768,"visible":15},"10002890",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":21,"currentStage":22,"position":774,"attributes":775},"057",1045100,"Baleetle","/cdn/init/Wiki_Aniimo_10451.png","They never go anywhere without their stone balls, and the constant rolling makes the balls rounder and stranger.",[212],[444],{"id":777,"viewCount":57,"searchKey":778,"visible":15},"10002801",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":21,"currentStage":234,"position":784,"attributes":785},"058",1045300,"Waleetle","/cdn/init/Wiki_Aniimo_10453.png","They move backwards like their kin, but in a much fancier way.",[212],[444],{"id":787,"viewCount":57,"searchKey":788,"visible":15},"10002791",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":21,"currentStage":234,"position":794,"attributes":795},"059",1045400,"Bouldus","/cdn/init/Wiki_Aniimo_10454.png","A round stone that had stayed with Baleetle day and night woke up from all that bumping. Tired of being controlled, it swallowed an insect and could finally move by its own will.",[277],[444],{"id":797,"viewCount":57,"searchKey":798,"visible":15},"10002704",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":21,"currentStage":22,"position":804,"attributes":805},"060",1029100,"Fentuft","/cdn/init/Wiki_Aniimo_10291.png","They always wear a signature smile and invite other aniimo to play. Though they sometimes cause trouble due to mischief and greed, they are always forgiven.",[212],[585],{"id":807,"viewCount":57,"searchKey":808,"visible":15},"10002701",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":21,"currentStage":234,"position":814,"attributes":815},"061",1029300,"Fenmane","/cdn/init/Wiki_Aniimo_10293.png","Using the excellent conductivity of their fur, they condense the power of lightning to extend their wings, dashing to dispel the haze and brighten their mood.",[212],[585],{"id":817,"viewCount":57,"searchKey":818,"visible":15},"10002868",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":21,"currentStage":22,"position":824,"attributes":825},"062",1002100,"Helmut","/cdn/init/Wiki_Aniimo_10021.png","That tough helmet keeps its squishy body safe, while those extendable mouth-claws help it hunt.",[24],[247],{"id":827,"viewCount":57,"searchKey":828,"visible":15},"10002882",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":21,"currentStage":234,"position":834,"attributes":835},"063",1002600,"Pawney","/cdn/init/Wiki_Aniimo_10026.png","Armed with a broken sword and armor, blessed with courage and might, it defends its friends and challenges its foes.",[212],[247],{"id":837,"viewCount":57,"searchKey":838,"visible":15},"10002847",{"type":10,"entryId":8,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":21,"currentStage":234,"position":843,"attributes":844},1002700,"Rookey","/cdn/init/Wiki_Aniimo_10027.png","Despite its imposing size, it is timid and avoids conflict. It finds its courage when friends need protection.",[24],[247],{"id":4,"viewCount":57,"searchKey":846,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":847,"attributes":848},[24],[26],{"id":850,"viewCount":57,"searchKey":851,"visible":15},"10002714",{"type":10,"entryId":852,"sortOrder":853,"name":854,"imageUrl":855,"description":856,"currentMorphology":21,"currentStage":223,"position":857,"attributes":858},"066",1002200,"Helmwhelp","/cdn/init/Wiki_Aniimo_10022.png","A fledgling concealing weakness under its helmet, dreaming of becoming strong enough to soar freely.",[24],[26],{"id":860,"viewCount":57,"searchKey":861,"visible":15},"10002861",{"type":10,"entryId":862,"sortOrder":863,"name":864,"imageUrl":865,"description":866,"currentMorphology":21,"currentStage":234,"position":867,"attributes":868},"067",1002300,"Helgon","/cdn/init/Wiki_Aniimo_10023.png","Covered in hard armor, they look like tall statues when they stand still, as if standing guard over ancient treasures.",[24],[26],{"id":870,"viewCount":57,"searchKey":871,"visible":15},"10002854",{"type":10,"entryId":872,"sortOrder":873,"name":874,"imageUrl":875,"description":876,"currentMorphology":21,"currentStage":234,"position":877,"attributes":878},"068",1002500,"Infergon","/cdn/init/Wiki_Aniimo_10025.png","Covered in armor forged by flames, the fire they breathe in fury can melt almost everything.",[212],[214],{"id":880,"viewCount":57,"searchKey":881,"visible":15},"10002758",{"type":10,"entryId":882,"sortOrder":883,"name":884,"imageUrl":885,"description":886,"currentMorphology":21,"currentStage":22,"position":887,"attributes":888},"069",1050100,"Cubbo","/cdn/init/Wiki_Aniimo_10501.png","They spend the day sleepwalking. If woken up, they instantly become violent and lose control. Once they exhaust their energy, they fall back asleep like a baby.",[212],[444],{"id":890,"viewCount":57,"searchKey":891,"visible":15},"10002752",{"type":10,"entryId":892,"sortOrder":893,"name":894,"imageUrl":895,"description":896,"currentMorphology":21,"currentStage":234,"position":897,"attributes":898},"070",1050300,"Grizbo","/cdn/init/Wiki_Aniimo_10503.png","They hide constant endurance and restraint beneath a gentle exterior. However, if provoked or hungry, they lose control and fall into a frenzy.",[212],[444],{"id":900,"viewCount":57,"searchKey":901,"visible":15},"10002730",{"type":10,"entryId":902,"sortOrder":903,"name":904,"imageUrl":905,"description":906,"currentMorphology":21,"currentStage":22,"position":907,"attributes":908},"071",1028100,"Pebbling","/cdn/init/Wiki_Aniimo_10281.png","They are natural geologists who like eating all kinds of minerals. And what they eat determines how they grow.",[24],[444],{"id":910,"viewCount":57,"searchKey":911,"visible":15},"10002850",{"type":10,"entryId":912,"sortOrder":913,"name":914,"imageUrl":915,"description":916,"currentMorphology":21,"currentStage":223,"position":917,"attributes":918},"072",1028200,"Lavazar","/cdn/init/Wiki_Aniimo_10282.png","They use hard claws to crush crystals and eat them to store heat, causing fiery red patterns to appear on their body. Though small, they can continuously spew high-heat flame streams from their mouth.",[24],[214,444],{"id":920,"viewCount":57,"searchKey":921,"visible":15},"10002724",{"type":10,"entryId":922,"sortOrder":923,"name":924,"imageUrl":925,"description":926,"currentMorphology":21,"currentStage":234,"position":927,"attributes":928},"073",1028300,"Magmarex","/cdn/init/Wiki_Aniimo_10283.png","Scorching crystals grow on their body like solidified lava. If the stored heat erupts, it can melt everything in their path.",[24],[214,444],{"id":930,"viewCount":57,"searchKey":931,"visible":15},"10002843",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":21,"currentStage":223,"position":937,"attributes":938},"074",1028400,"Geodeback","/cdn/init/Wiki_Aniimo_10284.png","The minerals they eat will grow back on them with refined energy stored inside.",[24],[444],{"id":940,"viewCount":57,"searchKey":941,"visible":15},"10002718",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":21,"currentStage":234,"position":947,"attributes":948},"075",1028500,"Minespine","/cdn/init/Wiki_Aniimo_10285.png","Wherever crystal minerals are found, so are they. Their hard spines serve both as protection and as storage for energy.",[24],[444],{"id":950,"viewCount":57,"searchKey":951,"visible":15},"10002711",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":21,"currentStage":22,"position":957,"attributes":958},"076",1043100,"Cozite","/cdn/init/Wiki_Aniimo_10431.png","Cozites build their shells bit by bit with mud. When in danger, they spray smoke from the top hole to cover the surroundings and hide themselves.",[277],[444],{"id":960,"viewCount":57,"searchKey":961,"visible":15},"10002772",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":21,"currentStage":234,"position":967,"attributes":968},"077",1043300,"Bailite","/cdn/init/Wiki_Aniimo_10433.png","Bailites' anatomy allows independent rotation of their upper and lower bodies. This means they can observe surroundings flexibly, ready to transform into turrets to repel opponents.",[277],[444],{"id":970,"viewCount":57,"searchKey":971,"visible":15},"10002822",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":21,"currentStage":22,"position":977,"attributes":978},"078",1014100,"Bulbly","/cdn/init/Wiki_Aniimo_10141.png","Their first reaction to everything is to escape, and their bulb-like organs indicate whether they are healthy.",[277],[585],{"id":980,"viewCount":57,"searchKey":981,"visible":15},"10002804",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":21,"currentStage":223,"position":987,"attributes":988},"079",1014200,"Veilfloat","/cdn/init/Wiki_Aniimo_10142.png","A light-dependent creature that glows when night falls, keeping its light on even while sleeping.",[277],[585],{"id":990,"viewCount":57,"searchKey":991,"visible":15},"10002713",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":21,"currentStage":234,"position":997,"attributes":998},"080",1014300,"Luminelle","/cdn/init/Wiki_Aniimo_10143.png","Changes its glow to match its mood while its tentacles create mesmerizing patterns and deliver shocking attacks.",[277],[585],{"id":1000,"viewCount":57,"searchKey":1001,"visible":15},"10002754",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":21,"currentStage":22,"position":1007,"attributes":1008},"081",1048100,"Fahloo","/cdn/init/Wiki_Aniimo_10481.png","They rub the oil on their bodies to create a thick foam. This foam cleans and protects them, though they sometimes slip on it by accident.",[372],[341],{"id":1010,"viewCount":57,"searchKey":1011,"visible":15},"10002755",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":21,"currentStage":234,"position":1017,"attributes":1018},"082",1048300,"Erlath","/cdn/init/Wiki_Aniimo_10483.png","Their feathers constantly secrete oil, creating various bubbles with just a little friction. They naturally use the softest, densest foam to protect the Fahloos on their backs.",[372],[341],{"id":1020,"viewCount":57,"searchKey":1021,"visible":15},"10002874",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":21,"currentStage":197,"position":1027,"attributes":1028},"083",1012200,"Besauce","/cdn/init/Wiki_Aniimo_10122.png","Always trying to find beats to drown out its persistent heartbeat, Besauce loves to groove to the music.",[372],[585],{"id":1030,"viewCount":57,"searchKey":1031,"visible":15},"10002819",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":21,"currentStage":22,"position":1037,"attributes":1038},"084",1038100,"Reefish","/cdn/init/Wiki_Aniimo_10381.png","They burrow underground to camouflage as coral and bite any prey that comes near. However, they sometimes get impatient and peek around.",[372],[444,341],{"id":1040,"viewCount":57,"searchKey":1041,"visible":15},"10002811",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":21,"currentStage":234,"position":1047,"attributes":1048},"085",1038300,"Coraliz","/cdn/init/Wiki_Aniimo_10383.png","They love to bury themselves in sand, mimicking coral clumps. They use the glow of the coral on their head and back to lure creatures for a surprise attack.",[372],[444,341],{"id":1050,"viewCount":57,"searchKey":1051,"visible":15},"10002855",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":21,"currentStage":22,"position":1057,"attributes":1058},"086",1046100,"Cheekie","/cdn/init/Wiki_Aniimo_10461.png","People often mistake the circles on their cheeks for eyes. They love to gather in groups on the shore, feeling safe only when they huddle closely with their companions.",[24],[362],{"id":1060,"viewCount":57,"searchKey":1061,"visible":15},"10002782",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":21,"currentStage":234,"position":1067,"attributes":1068},"087",1046300,"Wavwal","/cdn/init/Wiki_Aniimo_10463.png","They move clumsily on land using their four limbs, but they are experts at sliding on their bellies. The males are highly territorial against other males, once angered, they unleash their wrath like a tsunami.",[24],[362],{"id":1070,"viewCount":57,"searchKey":1071,"visible":15},"10002748",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":21,"currentStage":22,"position":1077,"attributes":1078},"088",1058100,"Bubbeep","/cdn/init/Wiki_Aniimo_10581.png","It stretches its leafy feathers with lazy ease, always chewing away as it turns algae and slime into floating bubbles. One light hop, and off it drifts, riding the bubbles like a little boat in the breeze.",[339],[319,341],{"id":1080,"viewCount":57,"searchKey":1081,"visible":15},"10002744",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":21,"currentStage":234,"position":1087,"attributes":1088},"089",1058300,"Glameep","/cdn/init/Wiki_Aniimo_10583.png","Draped in fresh green leaf-feathers, Glameep moves lightly along the lake shore. It adores clear water most of all, especially when that water reflects its own graceful, unhurried beauty.",[339],[319,341],{"id":1090,"viewCount":57,"searchKey":1091,"visible":15},"10002735",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":21,"currentStage":22,"position":1097,"attributes":1098},"090",1062100,"Popapus","/cdn/init/Wiki_Aniimo_10621.png","It loves collecting colorful bubbles. They bob and sway inside its air sac as it moves, and when inspiration strikes, it uses them to doodle strange little wonders in the air.",[212],[341],{"id":1100,"viewCount":57,"searchKey":1101,"visible":15},"10002834",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":21,"currentStage":234,"position":1107,"attributes":1108},"091",1062300,"Gachapus","/cdn/init/Wiki_Aniimo_10623.png","With a quick tap from its nimble tentacles, it can launch all kinds of capsule bubbles from its head. No one knows what will pop out next—a delightful surprise, or a complete accident.",[212],[341],{"id":1110,"viewCount":57,"searchKey":1111,"visible":15},"10002738",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":21,"currentStage":22,"position":1117,"attributes":1118},"092",1042100,"Malangel","/cdn/init/Wiki_Aniimo_10421.png","They disguise themselves with a cheerful smile to sneak up on targets. Once in combat, they reveal their true colors and bare their fangs poised to strike.",[212],[362],{"id":1120,"viewCount":57,"searchKey":1121,"visible":15},"10002732",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":21,"currentStage":234,"position":1127,"attributes":1128},"093",1042300,"Malevsera","/cdn/init/Wiki_Aniimo_10423.png","They hide their fangs and claws in their soft body. Expert at using their gentle, harmless look to lower other creatures' guard before casually freezing them into ice sculptures.",[212],[362],{"id":1130,"viewCount":57,"searchKey":1131,"visible":15},"10002823",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":21,"currentStage":197,"position":1137,"attributes":1138},"9997",1037300,"Fennelun","/cdn/init/Wiki_Aniimo_10373.png","The soft moonlight running through their fur gives them an aloof and rational look. But they can also be sentimental.",[212],[1139],"attributes-holy",{"id":1141,"viewCount":57,"searchKey":1142,"visible":15},"10002700",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":21,"currentStage":197,"position":1148,"attributes":1149},"9998",1036100,"Helion","/cdn/init/Wiki_Aniimo_10361.png","Enthusiastic and confident, they always stand up for their friends at critical moments, displaying amazing power.",[212],[1139],[1151,1158,1161,1165,1169,1173,1177,1179,1183,1187,1191,1195,1198,1202,1206,1209,1213,1217,1221],{"id":1152,"parentId":1153,"tagType":1154,"tagKey":1155,"name":1155,"language":1156,"sort":1157},"06786e92e215f6cc817d2c680245f743","1250","morphologyTypes","Thunderstorm Form","en-US",11,{"id":1159,"parentId":1153,"tagType":1154,"tagKey":1160,"name":1160,"language":1156,"sort":112},"5e0432e316214a73181b21c113d62cd2","Rainstorm Form",{"id":1162,"parentId":1153,"tagType":1154,"tagKey":1163,"name":1163,"language":1156,"sort":1164},"63948cc6deb35b6b6f9be96aa7ddf4bd","Forest Form",8,{"id":1166,"parentId":1153,"tagType":1154,"tagKey":1167,"name":1167,"language":1156,"sort":1168},"7522d1e00bc2916bdedd2880073dc454","Prismana Form",3,{"id":1170,"parentId":1153,"tagType":1154,"tagKey":1171,"name":1171,"language":1156,"sort":1172},"7b864ad9c3dc3df8ff9ef50784abb4a8","Towerwood Form",19,{"id":1174,"parentId":1153,"tagType":1154,"tagKey":1175,"name":1175,"language":1156,"sort":1176},"8aa756c14d59124ad4641013a1beca72","Mudflat Form",13,{"id":1178,"parentId":1153,"tagType":1154,"tagKey":21