attributes":145,"type":146,"consume":46,"power":46},[],[],{"id":148,"type":61,"props":149,"children":58},"91268609_26",{"title":150,"type":64,"id":151,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":66,"tabs":152},"技能介紹","91268609_27",[153,182],{"id":154,"title":155,"children":156},"91268609_28","戰鬥技能",[157,171],{"id":158,"type":138,"props":159},"91268609_29",{"id":160,"customKey":46,"icon":161,"iconStyle":64,"iconTitle":46,"descTitle":162,"descContent":163,"source":164},"91268609_30","/cdn/init/1019200_Skill_10300090_Icon.png","流水猛擊","用貝殼砸向目標，如果附近有水灘，會激發命中範圍內的水灘額外造成30%原威力的傷害，並水元素強化提高15%，持續20秒。",{"attributes":165,"type":167,"consume":169,"power":170},[166],"3",[168],"1","20","47",{"id":172,"type":138,"props":173},"91268609_31",{"id":174,"customKey":46,"icon":175,"iconStyle":64,"iconTitle":46,"descTitle":176,"descContent":177,"source":178},"91268609_32","/cdn/init/1019200_Skill_10300080_Icon.png","流水滾動","持續消耗體力並向前滾動撞擊目標，持續造成傷害並恢復體力，滾動結束時生成一個水灘，3秒內最多恢復一次體力。",{"attributes":179,"type":180,"consume":169,"power":181},[166],[168],"83",{"id":183,"title":184,"children":185},"91268609_33","固有技能",[186],{"id":187,"type":138,"props":188},"91268609_34",{"id":189,"customKey":46,"icon":190,"iconStyle":64,"iconTitle":46,"descTitle":191,"descContent":192,"source":193},"91268609_35","/cdn/init/1019200_Skill_10300000_Icon.png","攻擊","使用水元素能力，近距離攻擊目標。",{"attributes":194,"type":195,"consume":196,"power":197},[166],[168],"0","6",[199],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[201,212,222,232,244,254,264,276,286,296,306,317,327,338,348,359,370,380,390,400,410,420,430,441,451,461,471,481,491,501,511,521,531,541,551,561,571,582,592,602,612,622,632,642,652,662,672,682,692,702,712,722,732,739,743,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1131],{"id":202,"viewCount":58,"searchKey":203,"visible":14},"10003442",{"type":10,"entryId":204,"sortOrder":205,"name":206,"imageUrl":207,"description":208,"currentMorphology":9,"currentStage":168,"position":209,"attributes":210},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[211],"attributes-fire",{"id":213,"viewCount":58,"searchKey":214,"visible":14},"10003534",{"type":10,"entryId":215,"sortOrder":216,"name":217,"imageUrl":218,"description":219,"currentMorphology":9,"currentStage":21,"position":220,"attributes":221},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[211],{"id":223,"viewCount":58,"searchKey":224,"visible":14},"10003435",{"type":10,"entryId":225,"sortOrder":226,"name":227,"imageUrl":228,"description":229,"currentMorphology":9,"currentStage":166,"position":230,"attributes":231},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[23],[211],{"id":233,"viewCount":58,"searchKey":234,"visible":14},"10003428",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":9,"currentStage":166,"position":240,"attributes":242},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[241],"position-break",[211,243],"attributes-dark",{"id":245,"viewCount":58,"searchKey":246,"visible":14},"10003578",{"type":10,"entryId":247,"sortOrder":248,"name":249,"imageUrl":250,"description":251,"currentMorphology":9,"currentStage":168,"position":252,"attributes":253},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[243],{"id":255,"viewCount":58,"searchKey":256,"visible":14},"10003417",{"type":10,"entryId":257,"sortOrder":258,"name":259,"imageUrl":260,"description":261,"currentMorphology":9,"currentStage":166,"position":262,"attributes":263},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[243],{"id":265,"viewCount":58,"searchKey":266,"visible":14},"10003488",{"type":10,"entryId":267,"sortOrder":268,"name":269,"imageUrl":270,"description":271,"currentMorphology":9,"currentStage":168,"position":272,"attributes":274},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[273],"position-sup",[275],"attributes-wind",{"id":277,"viewCount":58,"searchKey":278,"visible":14},"10003548",{"type":10,"entryId":279,"sortOrder":280,"name":281,"imageUrl":282,"description":283,"currentMorphology":9,"currentStage":166,"position":284,"attributes":285},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[273],[275],{"id":287,"viewCount":58,"searchKey":288,"visible":14},"10003474",{"type":10,"entryId":289,"sortOrder":290,"name":291,"imageUrl":292,"description":293,"currentMorphology":9,"currentStage":166,"position":294,"attributes":295},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[275],{"id":297,"viewCount":58,"searchKey":298,"visible":14},"10003467",{"type":10,"entryId":299,"sortOrder":300,"name":301,"imageUrl":302,"description":303,"currentMorphology":9,"currentStage":166,"position":304,"attributes":305},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[241],[275],{"id":307,"viewCount":58,"searchKey":308,"visible":14},"10003392",{"type":10,"entryId":309,"sortOrder":310,"name":311,"imageUrl":312,"description":313,"currentMorphology":9,"currentStage":168,"position":314,"attributes":315},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[316],"attributes-grass",{"id":318,"viewCount":58,"searchKey":319,"visible":14},"10003510",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":166,"position":325,"attributes":326},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[316],{"id":328,"viewCount":58,"searchKey":329,"visible":14},"10003477",{"type":10,"entryId":330,"sortOrder":331,"name":332,"imageUrl":333,"description":334,"currentMorphology":9,"currentStage":168,"position":335,"attributes":337},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[336],"position-heal",[25],{"id":339,"viewCount":58,"searchKey":340,"visible":14},"10003569",{"type":10,"entryId":341,"sortOrder":342,"name":343,"imageUrl":344,"description":345,"currentMorphology":9,"currentStage":21,"position":346,"attributes":347},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[336],[25],{"id":349,"viewCount":58,"searchKey":350,"visible":14},"10003470",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":9,"currentStage":166,"position":356,"attributes":357},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[336],[25,358],"attributes-ice",{"id":360,"viewCount":58,"searchKey":361,"visible":14},"10003463",{"type":10,"entryId":362,"sortOrder":363,"name":364,"imageUrl":365,"description":366,"currentMorphology":9,"currentStage":166,"position":367,"attributes":369},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[368],"position-energy",[316,25],{"id":371,"viewCount":58,"searchKey":372,"visible":14},"10003468",{"type":10,"entryId":373,"sortOrder":374,"name":375,"imageUrl":376,"description":377,"currentMorphology":9,"currentStage":168,"position":378,"attributes":379},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[273],[275],{"id":381,"viewCount":58,"searchKey":382,"visible":14},"10003365",{"type":10,"entryId":383,"sortOrder":384,"name":385,"imageUrl":386,"description":387,"currentMorphology":9,"currentStage":166,"position":388,"attributes":389},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[273],[275],{"id":391,"viewCount":58,"searchKey":392,"visible":14},"10003461",{"type":10,"entryId":393,"sortOrder":394,"name":395,"imageUrl":396,"description":397,"currentMorphology":9,"currentStage":166,"position":398,"attributes":399},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[273],[243],{"id":401,"viewCount":58,"searchKey":402,"visible":14},"10003421",{"type":10,"entryId":403,"sortOrder":404,"name":405,"imageUrl":406,"description":407,"currentMorphology":9,"currentStage":168,"position":408,"attributes":409},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[241],[316],{"id":411,"viewCount":58,"searchKey":412,"visible":14},"10003414",{"type":10,"entryId":413,"sortOrder":414,"name":415,"imageUrl":416,"description":417,"currentMorphology":9,"currentStage":166,"position":418,"attributes":419},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[368],[243,316],{"id":421,"viewCount":58,"searchKey":422,"visible":14},"10003404",{"type":10,"entryId":423,"sortOrder":424,"name":425,"imageUrl":426,"description":427,"currentMorphology":9,"currentStage":166,"position":428,"attributes":429},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[241],[316],{"id":431,"viewCount":58,"searchKey":432,"visible":14},"10003567",{"type":10,"entryId":433,"sortOrder":434,"name":435,"imageUrl":436,"description":437,"currentMorphology":9,"currentStage":168,"position":438,"attributes":439},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[241],[440,316],"attributes-rock",{"id":442,"viewCount":58,"searchKey":443,"visible":14},"10003462",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":9,"currentStage":166,"position":449,"attributes":450},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[241],[440,316],{"id":452,"viewCount":58,"searchKey":453,"visible":14},"10003551",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":9,"currentStage":166,"position":459,"attributes":460},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[241],[358],{"id":462,"viewCount":58,"searchKey":463,"visible":14},"10003409",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":9,"currentStage":168,"position":469,"attributes":470},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[368],[211],{"id":472,"viewCount":58,"searchKey":473,"visible":14},"10003507",{"type":10,"entryId":474,"sortOrder":475,"name":476,"imageUrl":477,"description":478,"currentMorphology":9,"currentStage":166,"position":479,"attributes":480},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[368],[211],{"id":482,"viewCount":58,"searchKey":483,"visible":14},"10003542",{"type":10,"entryId":484,"sortOrder":485,"name":486,"imageUrl":487,"description":488,"currentMorphology":9,"currentStage":168,"position":489,"attributes":490},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[336],[275],{"id":492,"viewCount":58,"searchKey":493,"visible":14},"10003440",{"type":10,"entryId":494,"sortOrder":495,"name":496,"imageUrl":497,"description":498,"currentMorphology":9,"currentStage":166,"position":499,"attributes":500},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[336],[275],{"id":502,"viewCount":58,"searchKey":503,"visible":14},"10003563",{"type":10,"entryId":504,"sortOrder":505,"name":506,"imageUrl":507,"description":508,"currentMorphology":9,"currentStage":196,"position":509,"attributes":510},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[368],[275,316],{"id":512,"viewCount":58,"searchKey":513,"visible":14},"10003368",{"type":10,"entryId":514,"sortOrder":515,"name":516,"imageUrl":517,"description":518,"currentMorphology":9,"currentStage":168,"position":519,"attributes":520},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[273],[275],{"id":522,"viewCount":58,"searchKey":523,"visible":14},"10003363",{"type":10,"entryId":524,"sortOrder":525,"name":526,"imageUrl":527,"description":528,"currentMorphology":9,"currentStage":166,"position":529,"attributes":530},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[273],[275],{"id":532,"viewCount":58,"searchKey":533,"visible":14},"10003515",{"type":10,"entryId":534,"sortOrder":535,"name":536,"imageUrl":537,"description":538,"currentMorphology":9,"currentStage":168,"position":539,"attributes":540},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[316],{"id":542,"viewCount":58,"searchKey":543,"visible":14},"10003496",{"type":10,"entryId":544,"sortOrder":545,"name":546,"imageUrl":547,"description":548,"currentMorphology":9,"currentStage":166,"position":549,"attributes":550},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[316],{"id":552,"viewCount":58,"searchKey":553,"visible":14},"10003378",{"type":10,"entryId":554,"sortOrder":555,"name":556,"imageUrl":557,"description":558,"currentMorphology":9,"currentStage":166,"position":559,"attributes":560},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[273],[316],{"id":562,"viewCount":58,"searchKey":563,"visible":14},"10003456",{"type":10,"entryId":564,"sortOrder":565,"name":566,"imageUrl":567,"description":568,"currentMorphology":9,"currentStage":168,"position":569,"attributes":570},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[241],[316],{"id":572,"viewCount":58,"searchKey":573,"visible":14},"10003374",{"type":10,"entryId":574,"sortOrder":575,"name":576,"imageUrl":577,"description":578,"currentMorphology":9,"currentStage":166,"position":579,"attributes":580},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[273],[581],"attributes-electric",{"id":583,"viewCount":58,"searchKey":584,"visible":14},"10003443",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":9,"currentStage":166,"position":590,"attributes":591},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[241],[316],{"id":593,"viewCount":58,"searchKey":594,"visible":14},"10003503",{"type":10,"entryId":595,"sortOrder":596,"name":597,"imageUrl":598,"description":599,"currentMorphology":9,"currentStage":168,"position":600,"attributes":601},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[273],[243],{"id":603,"viewCount":58,"searchKey":604,"visible":14},"10003521",{"type":10,"entryId":605,"sortOrder":606,"name":607,"imageUrl":608,"description":609,"currentMorphology":9,"currentStage":166,"position":610,"attributes":611},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[273],[243],{"id":613,"viewCount":58,"searchKey":614,"visible":14},"10003508",{"type":10,"entryId":615,"sortOrder":616,"name":617,"imageUrl":618,"description":619,"currentMorphology":9,"currentStage":168,"position":620,"attributes":621},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[243],{"id":623,"viewCount":58,"searchKey":624,"visible":14},"10003369",{"type":10,"entryId":625,"sortOrder":626,"name":627,"imageUrl":628,"description":629,"currentMorphology":9,"currentStage":166,"position":630,"attributes":631},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[243],{"id":633,"viewCount":58,"searchKey":634,"visible":14},"10003501",{"type":10,"entryId":635,"sortOrder":636,"name":637,"imageUrl":638,"description":639,"currentMorphology":9,"currentStage":166,"position":640,"attributes":641},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[581],{"id":643,"viewCount":58,"searchKey":644,"visible":14},"10003422",{"type":10,"entryId":645,"sortOrder":646,"name":647,"imageUrl":648,"description":649,"currentMorphology":9,"currentStage":168,"position":650,"attributes":651},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[358],{"id":653,"viewCount":58,"searchKey":654,"visible":14},"10003575",{"type":10,"entryId":655,"sortOrder":656,"name":657,"imageUrl":658,"description":659,"currentMorphology":9,"currentStage":21,"position":660,"attributes":661},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[358],{"id":663,"viewCount":58,"searchKey":664,"visible":14},"10003415",{"type":10,"entryId":665,"sortOrder":666,"name":667,"imageUrl":668,"description":669,"currentMorphology":9,"currentStage":166,"position":670,"attributes":671},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[358],{"id":673,"viewCount":58,"searchKey":674,"visible":14},"10003524",{"type":10,"entryId":675,"sortOrder":676,"name":677,"imageUrl":678,"description":679,"currentMorphology":9,"currentStage":168,"position":680,"attributes":681},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[241],[581],{"id":683,"viewCount":58,"searchKey":684,"visible":14},"10003475",{"type":10,"entryId":685,"sortOrder":686,"name":687,"imageUrl":688,"description":689,"currentMorphology":9,"currentStage":166,"position":690,"attributes":691},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[241],[581],{"id":693,"viewCount":58,"searchKey":694,"visible":14},"10003523",{"type":10,"entryId":695,"sortOrder":696,"name":697,"imageUrl":698,"description":699,"currentMorphology":9,"currentStage":168,"position":700,"attributes":701},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[241],[25],{"id":703,"viewCount":58,"searchKey":704,"visible":14},"10003398",{"type":10,"entryId":705,"sortOrder":706,"name":707,"imageUrl":708,"description":709,"currentMorphology":9,"currentStage":21,"position":710,"attributes":711},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[241],[25],{"id":713,"viewCount":58,"searchKey":714,"visible":14},"10003516",{"type":10,"entryId":715,"sortOrder":716,"name":717,"imageUrl":718,"description":719,"currentMorphology":9,"currentStage":166,"position":720,"attributes":721},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[273],[25],{"id":723,"viewCount":58,"searchKey":724,"visible":14},"10003566",{"type":10,"entryId":725,"sortOrder":726,"name":727,"imageUrl":728,"description":729,"currentMorphology":9,"currentStage":166,"position":730,"attributes":731},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[241],[25],{"id":5,"viewCount":58,"searchKey":733,"visible":14},{"type":10,"entryId":8,"sortOrder":734,"name":74,"imageUrl":735,"description":736,"currentMorphology":9,"currentStage":168,"position":737,"attributes":738},1019100,"/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[25],{"id":4,"viewCount":58,"searchKey":740,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":741,"attributes":742},[23],[25],{"id":6,"viewCount":58,"searchKey":744,"visible":14},{"type":10,"entryId":12,"sortOrder":745,"name":87,"imageUrl":746,"description":747,"currentMorphology":9,"currentStage":166,"position":748,"attributes":749},1019400,"/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[25],{"id":751,"viewCount":58,"searchKey":752,"visible":14},"10003565",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":9,"currentStage":168,"position":758,"attributes":759},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[440],{"id":761,"viewCount":58,"searchKey":762,"visible":14},"10003476",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":9,"currentStage":166,"position":768,"attributes":769},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[440],{"id":771,"viewCount":58,"searchKey":772,"visible":14},"10003466",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":9,"currentStage":166,"position":778,"attributes":779},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[273],[440],{"id":781,"viewCount":58,"searchKey":782,"visible":14},"10003379",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":9,"currentStage":168,"position":788,"attributes":789},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[581],{"id":791,"viewCount":58,"searchKey":792,"visible":14},"10003376",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":9,"currentStage":166,"position":798,"attributes":799},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[581],{"id":801,"viewCount":58,"searchKey":802,"visible":14},"10003543",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":9,"currentStage":168,"position":808,"attributes":809},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[241],[243],{"id":811,"viewCount":58,"searchKey":812,"visible":14},"10003557",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":9,"currentStage":166,"position":818,"attributes":819},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[243],{"id":821,"viewCount":58,"searchKey":822,"visible":14},"10003522",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":9,"currentStage":166,"position":828,"attributes":829},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[241],[243],{"id":831,"viewCount":58,"searchKey":832,"visible":14},"10003579",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":9,"currentStage":168,"position":838,"attributes":839},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[241],[275],{"id":841,"viewCount":58,"searchKey":842,"visible":14},"10003389",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":9,"currentStage":21,"position":848,"attributes":849},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[241],[275],{"id":851,"viewCount":58,"searchKey":852,"visible":14},"10003536",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":9,"currentStage":166,"position":858,"attributes":859},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[241],[275],{"id":861,"viewCount":58,"searchKey":862,"visible":14},"10003529",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":9,"currentStage":166,"position":868,"attributes":869},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[211],{"id":871,"viewCount":58,"searchKey":872,"visible":14},"10003433",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":9,"currentStage":168,"position":878,"attributes":879},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[440],{"id":881,"viewCount":58,"searchKey":882,"visible":14},"10003427",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":9,"currentStage":166,"position":888,"attributes":889},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[440],{"id":891,"viewCount":58,"searchKey":892,"visible":14},"10003405",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":9,"currentStage":168,"position":898,"attributes":899},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[241],[440],{"id":901,"viewCount":58,"searchKey":902,"visible":14},"10003525",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":9,"currentStage":21,"position":908,"attributes":909},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[241],[211,440],{"id":911,"viewCount":58,"searchKey":912,"visible":14},"10003399",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":9,"currentStage":166,"position":918,"attributes":919},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[241],[211,440],{"id":921,"viewCount":58,"searchKey":922,"visible":14},"10003518",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":9,"currentStage":21,"position":928,"attributes":929},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[241],[440],{"id":931,"viewCount":58,"searchKey":932,"visible":14},"10003393",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":9,"currentStage":166,"position":938,"attributes":939},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[241],[440],{"id":941,"viewCount":58,"searchKey":942,"visible":14},"10003386",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":9,"currentStage":168,"position":948,"attributes":949},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[273],[440],{"id":951,"viewCount":58,"searchKey":952,"visible":14},"10003447",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":9,"currentStage":166,"position":958,"attributes":959},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[273],[440],{"id":961,"viewCount":58,"searchKey":962,"visible":14},"10003497",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":9,"currentStage":168,"position":968,"attributes":969},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[273],[581],{"id":971,"viewCount":58,"searchKey":972,"visible":14},"10003479",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":9,"currentStage":21,"position":978,"attributes":979},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[273],[581],{"id":981,"viewCount":58,"searchKey":982,"visible":14},"10003388",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":9,"currentStage":166,"position":988,"attributes":989},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[273],[581],{"id":991,"viewCount":58,"searchKey":992,"visible":14},"10003429",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":9,"currentStage":168,"position":998,"attributes":999},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[368],[25],{"id":1001,"viewCount":58,"searchKey":1002,"visible":14},"10003430",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":9,"currentStage":166,"position":1008,"attributes":1009},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[368],[25],{"id":1011,"viewCount":58,"searchKey":1012,"visible":14},"10003549",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":9,"currentStage":196,"position":1018,"attributes":1019},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[368],[581],{"id":1021,"viewCount":58,"searchKey":1022,"visible":14},"10003494",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":9,"currentStage":168,"position":1028,"attributes":1029},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[368],[440,25],{"id":1031,"viewCount":58,"searchKey":1032,"visible":14},"10003486",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":9,"currentStage":166,"position":1038,"attributes":1039},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[368],[440,25],{"id":1041,"viewCount":58,"searchKey":1042,"visible":14},"10003530",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":9,"currentStage":168,"position":1048,"attributes":1049},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[241],[358],{"id":1051,"viewCount":58,"searchKey":1052,"visible":14},"10003457",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":9,"currentStage":166,"position":1058,"attributes":1059},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[241],[358],{"id":1061,"viewCount":58,"searchKey":1062,"visible":14},"10003423",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":9,"currentStage":168,"position":1068,"attributes":1069},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[336],[316,25],{"id":1071,"viewCount":58,"searchKey":1072,"visible":14},"10003419",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":9,"currentStage":166,"position":1078,"attributes":1079},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[336],[316,25],{"id":1081,"viewCount":58,"searchKey":1082,"visible":14},"10003410",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":9,"currentStage":168,"position":1088,"attributes":1089},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[25],{"id":1091,"viewCount":58,"searchKey":1092,"visible":14},"10003509",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":9,"currentStage":166,"position":1098,"attributes":1099},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[25],{"id":1101,"viewCount":58,"searchKey":1102,"visible":14},"10003413",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":9,"currentStage":168,"position":1108,"attributes":1109},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[358],{"id":1111,"viewCount":58,"searchKey":1112,"visible":14},"10003407",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":9,"currentStage":166,"position":1118,"attributes":1119},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[358],{"id":1121,"viewCount":58,"searchKey":1122,"visible":14},"10003498",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":9,"currentStage":196,"position":1128,"attributes":1129},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1130],"attributes-holy",{"id":1132,"viewCount":58,"searchKey":1133,"visible":14},"10003375",{"type":10,"entryId":1134,"sortOrder":1135,"name":1136,"imageUrl":1137,"description":1138,"currentMorphology":9,"currentStage":196,"position":1139,"attributes":1140},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1130],[1142,1150,1155,1160,1165,1170,1175,1180,1184,1188,1193,1198,1203,1208,1213,1218,1223,1228,1231],{"id":1143,"parentId":1144,"tagType":1145,"tagKey":1146,"name":1147,"language":1148,"sort":1149},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1151,"parentId":1144,"tagType