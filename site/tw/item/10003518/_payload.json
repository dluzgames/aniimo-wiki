/1028400_Skill_9400091_Icon.png","鑽地","進入「縮地」狀態，持續消耗體力，可以免疫遠程攻擊，但是會被地震類型的技能擊飛。",{"attributes":148,"type":149,"consume":46,"power":46},[],[],{"id":151,"type":62,"props":152,"children":155},"91268549_24",{"title":153,"type":65,"id":154,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"伊莫特性","91268549_25",[156],{"id":157,"type":141,"props":158,"children":59},"91268549_26",{"id":159,"customKey":46,"icon":160,"iconStyle":65,"iconTitle":46,"descTitle":161,"descContent":162,"source":163},"91268549_27","/cdn/init/1028400_Feature_12812_Icon.png","大地親和","「縮地」狀態下，可以施放技能並且額外造成30%擊破。",{"attributes":164,"type":165,"consume":46,"power":46},[],[],{"id":167,"type":62,"props":168,"children":59},"91268549_28",{"title":169,"type":65,"id":170,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":171},"技能介紹","91268549_29",[172,201],{"id":173,"title":174,"children":175},"91268549_30","戰鬥技能",[176,189],{"id":177,"type":141,"props":178},"91268549_31",{"id":179,"customKey":46,"icon":180,"iconStyle":65,"iconTitle":46,"descTitle":181,"descContent":182,"source":183},"91268549_32","/cdn/init/1028400_Skill_10800140_Icon.png","地刺","向前方生成一道岩石地刺，穿刺路徑上的目標。",{"attributes":184,"type":186,"consume":187,"power":188},[185],"8",[123],"20","68",{"id":190,"type":141,"props":191},"91268549_33",{"id":192,"customKey":46,"icon":193,"iconStyle":65,"iconTitle":46,"descTitle":194,"descContent":195,"source":196},"91268549_34","/cdn/init/1028400_Skill_10800150_Icon.png","岩彈","發射一枚岩彈攻擊目標。",{"attributes":197,"type":198,"consume":199,"power":200},[185],[123],"10","33",{"id":202,"title":203,"children":204},"91268549_35","固有技能",[205],{"id":206,"type":141,"props":207},"91268549_36",{"id":208,"customKey":46,"icon":209,"iconStyle":65,"iconTitle":46,"descTitle":210,"descContent":211,"source":212},"91268549_37","/cdn/init/1028400_Skill_16600000_Icon.png","攻擊","擊破使用土元素能力，近距離攻擊目標。",{"attributes":213,"type":214,"consume":215,"power":216},[185],[123],"0","6",[218],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[220,232,242,253,264,274,284,296,306,316,326,337,347,359,369,380,391,401,411,421,431,441,451,461,471,481,491,501,511,521,531,541,551,561,571,581,591,602,612,622,632,642,652,662,672,682,692,702,712,722,732,742,752,762,772,782,792,802,812,822,832,842,852,862,872,882,892,902,912,922,931,940,948,952,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1139,1150],{"id":221,"viewCount":59,"searchKey":222,"visible":15},"10003442",{"type":10,"entryId":223,"sortOrder":224,"name":225,"imageUrl":226,"description":227,"currentMorphology":13,"currentStage":123,"position":228,"attributes":230},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[229],"position-dps",[231],"attributes-fire",{"id":233,"viewCount":59,"searchKey":234,"visible":15},"10003534",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":13,"currentStage":22,"position":240,"attributes":241},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[229],[231],{"id":243,"viewCount":59,"searchKey":244,"visible":15},"10003435",{"type":10,"entryId":245,"sortOrder":246,"name":247,"imageUrl":248,"description":249,"currentMorphology":13,"currentStage":250,"position":251,"attributes":252},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[229],[231],{"id":254,"viewCount":59,"searchKey":255,"visible":15},"10003428",{"type":10,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":13,"currentStage":250,"position":261,"attributes":262},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[24],[231,263],"attributes-dark",{"id":265,"viewCount":59,"searchKey":266,"visible":15},"10003578",{"type":10,"entryId":267,"sortOrder":268,"name":269,"imageUrl":270,"description":271,"currentMorphology":13,"currentStage":123,"position":272,"attributes":273},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[229],[263],{"id":275,"viewCount":59,"searchKey":276,"visible":15},"10003417",{"type":10,"entryId":277,"sortOrder":278,"name":279,"imageUrl":280,"description":281,"currentMorphology":13,"currentStage":250,"position":282,"attributes":283},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[229],[263],{"id":285,"viewCount":59,"searchKey":286,"visible":15},"10003488",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":13,"currentStage":123,"position":292,"attributes":294},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[293],"position-sup",[295],"attributes-wind",{"id":297,"viewCount":59,"searchKey":298,"visible":15},"10003548",{"type":10,"entryId":299,"sortOrder":300,"name":301,"imageUrl":302,"description":303,"currentMorphology":13,"currentStage":250,"position":304,"attributes":305},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[293],[295],{"id":307,"viewCount":59,"searchKey":308,"visible":15},"10003474",{"type":10,"entryId":309,"sortOrder":310,"name":311,"imageUrl":312,"description":313,"currentMorphology":13,"currentStage":250,"position":314,"attributes":315},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[229],[295],{"id":317,"viewCount":59,"searchKey":318,"visible":15},"10003467",{"type":10,"entryId":319,"sortOrder":320,"name":321,"imageUrl":322,"description":323,"currentMorphology":13,"currentStage":250,"position":324,"attributes":325},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[24],[295],{"id":327,"viewCount":59,"searchKey":328,"visible":15},"10003392",{"type":10,"entryId":329,"sortOrder":330,"name":331,"imageUrl":332,"description":333,"currentMorphology":13,"currentStage":123,"position":334,"attributes":335},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[229],[336],"attributes-grass",{"id":338,"viewCount":59,"searchKey":339,"visible":15},"10003510",{"type":10,"entryId":340,"sortOrder":341,"name":342,"imageUrl":343,"description":344,"currentMorphology":13,"currentStage":250,"position":345,"attributes":346},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[229],[336],{"id":348,"viewCount":59,"searchKey":349,"visible":15},"10003477",{"type":10,"entryId":350,"sortOrder":351,"name":352,"imageUrl":353,"description":354,"currentMorphology":13,"currentStage":123,"position":355,"attributes":357},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[356],"position-heal",[358],"attributes-water",{"id":360,"viewCount":59,"searchKey":361,"visible":15},"10003569",{"type":10,"entryId":362,"sortOrder":363,"name":364,"imageUrl":365,"description":366,"currentMorphology":13,"currentStage":22,"position":367,"attributes":368},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[356],[358],{"id":370,"viewCount":59,"searchKey":371,"visible":15},"10003470",{"type":10,"entryId":372,"sortOrder":373,"name":374,"imageUrl":375,"description":376,"currentMorphology":13,"currentStage":250,"position":377,"attributes":378},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[356],[358,379],"attributes-ice",{"id":381,"viewCount":59,"searchKey":382,"visible":15},"10003463",{"type":10,"entryId":383,"sortOrder":384,"name":385,"imageUrl":386,"description":387,"currentMorphology":13,"currentStage":250,"position":388,"attributes":390},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[389],"position-energy",[336,358],{"id":392,"viewCount":59,"searchKey":393,"visible":15},"10003468",{"type":10,"entryId":394,"sortOrder":395,"name":396,"imageUrl":397,"description":398,"currentMorphology":13,"currentStage":123,"position":399,"attributes":400},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[293],[295],{"id":402,"viewCount":59,"searchKey":403,"visible":15},"10003365",{"type":10,"entryId":404,"sortOrder":405,"name":406,"imageUrl":407,"description":408,"currentMorphology":13,"currentStage":250,"position":409,"attributes":410},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[293],[295],{"id":412,"viewCount":59,"searchKey":413,"visible":15},"10003461",{"type":10,"entryId":414,"sortOrder":415,"name":416,"imageUrl":417,"description":418,"currentMorphology":13,"currentStage":250,"position":419,"attributes":420},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[293],[263],{"id":422,"viewCount":59,"searchKey":423,"visible":15},"10003421",{"type":10,"entryId":424,"sortOrder":425,"name":426,"imageUrl":427,"description":428,"currentMorphology":13,"currentStage":123,"position":429,"attributes":430},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[24],[336],{"id":432,"viewCount":59,"searchKey":433,"visible":15},"10003414",{"type":10,"entryId":434,"sortOrder":435,"name":436,"imageUrl":437,"description":438,"currentMorphology":13,"currentStage":250,"position":439,"attributes":440},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[389],[263,336],{"id":442,"viewCount":59,"searchKey":443,"visible":15},"10003404",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":13,"currentStage":250,"position":449,"attributes":450},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[24],[336],{"id":452,"viewCount":59,"searchKey":453,"visible":15},"10003567",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":13,"currentStage":123,"position":459,"attributes":460},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[24],[26,336],{"id":462,"viewCount":59,"searchKey":463,"visible":15},"10003462",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":13,"currentStage":250,"position":469,"attributes":470},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[24],[26,336],{"id":472,"viewCount":59,"searchKey":473,"visible":15},"10003551",{"type":10,"entryId":474,"sortOrder":475,"name":476,"imageUrl":477,"description":478,"currentMorphology":13,"currentStage":250,"position":479,"attributes":480},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[24],[379],{"id":482,"viewCount":59,"searchKey":483,"visible":15},"10003409",{"type":10,"entryId":484,"sortOrder":485,"name":486,"imageUrl":487,"description":488,"currentMorphology":13,"currentStage":123,"position":489,"attributes":490},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[389],[231],{"id":492,"viewCount":59,"searchKey":493,"visible":15},"10003507",{"type":10,"entryId":494,"sortOrder":495,"name":496,"imageUrl":497,"description":498,"currentMorphology":13,"currentStage":250,"position":499,"attributes":500},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[389],[231],{"id":502,"viewCount":59,"searchKey":503,"visible":15},"10003542",{"type":10,"entryId":504,"sortOrder":505,"name":506,"imageUrl":507,"description":508,"currentMorphology":13,"currentStage":123,"position":509,"attributes":510},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[356],[295],{"id":512,"viewCount":59,"searchKey":513,"visible":15},"10003440",{"type":10,"entryId":514,"sortOrder":515,"name":516,"imageUrl":517,"description":518,"currentMorphology":13,"currentStage":250,"position":519,"attributes":520},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[356],[295],{"id":522,"viewCount":59,"searchKey":523,"visible":15},"10003563",{"type":10,"entryId":524,"sortOrder":525,"name":526,"imageUrl":527,"description":528,"currentMorphology":13,"currentStage":215,"position":529,"attributes":530},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[389],[295,336],{"id":532,"viewCount":59,"searchKey":533,"visible":15},"10003368",{"type":10,"entryId":534,"sortOrder":535,"name":536,"imageUrl":537,"description":538,"currentMorphology":13,"currentStage":123,"position":539,"attributes":540},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[293],[295],{"id":542,"viewCount":59,"searchKey":543,"visible":15},"10003363",{"type":10,"entryId":544,"sortOrder":545,"name":546,"imageUrl":547,"description":548,"currentMorphology":13,"currentStage":250,"position":549,"attributes":550},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[293],[295],{"id":552,"viewCount":59,"searchKey":553,"visible":15},"10003515",{"type":10,"entryId":554,"sortOrder":555,"name":556,"imageUrl":557,"description":558,"currentMorphology":13,"currentStage":123,"position":559,"attributes":560},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[229],[336],{"id":562,"viewCount":59,"searchKey":563,"visible":15},"10003496",{"type":10,"entryId":564,"sortOrder":565,"name":566,"imageUrl":567,"description":568,"currentMorphology":13,"currentStage":250,"position":569,"attributes":570},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[229],[336],{"id":572,"viewCount":59,"searchKey":573,"visible":15},"10003378",{"type":10,"entryId":574,"sortOrder":575,"name":576,"imageUrl":577,"description":578,"currentMorphology":13,"currentStage":250,"position":579,"attributes":580},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[293],[336],{"id":582,"viewCount":59,"searchKey":583,"visible":15},"10003456",{"type":10,"entryId":584,"sortOrder":585,"name":586,"imageUrl":587,"description":588,"currentMorphology":13,"currentStage":123,"position":589,"attributes":590},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[24],[336],{"id":592,"viewCount":59,"searchKey":593,"visible":15},"10003374",{"type":10,"entryId":594,"sortOrder":595,"name":596,"imageUrl":597,"description":598,"currentMorphology":13,"currentStage":250,"position":599,"attributes":600},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[293],[601],"attributes-electric",{"id":603,"viewCount":59,"searchKey":604,"visible":15},"10003443",{"type":10,"entryId":605,"sortOrder":606,"name":607,"imageUrl":608,"description":609,"currentMorphology":13,"currentStage":250,"position":610,"attributes":611},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[24],[336],{"id":613,"viewCount":59,"searchKey":614,"visible":15},"10003503",{"type":10,"entryId":615,"sortOrder":616,"name":617,"imageUrl":618,"description":619,"currentMorphology":13,"currentStage":123,"position":620,"attributes":621},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[293],[263],{"id":623,"viewCount":59,"searchKey":624,"visible":15},"10003521",{"type":10,"entryId":625,"sortOrder":626,"name":627,"imageUrl":628,"description":629,"currentMorphology":13,"currentStage":250,"position":630,"attributes":631},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[293],[263],{"id":633,"viewCount":59,"searchKey":634,"visible":15},"10003508",{"type":10,"entryId":635,"sortOrder":636,"name":637,"imageUrl":638,"description":639,"currentMorphology":13,"currentStage":123,"position":640,"attributes":641},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[229],[263],{"id":643,"viewCount":59,"searchKey":644,"visible":15},"10003369",{"type":10,"entryId":645,"sortOrder":646,"name":647,"imageUrl":648,"description":649,"currentMorphology":13,"currentStage":250,"position":650,"attributes":651},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[229],[263],{"id":653,"viewCount":59,"searchKey":654,"visible":15},"10003501",{"type":10,"entryId":655,"sortOrder":656,"name":657,"imageUrl":658,"description":659,"currentMorphology":13,"currentStage":250,"position":660,"attributes":661},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[229],[601],{"id":663,"viewCount":59,"searchKey":664,"visible":15},"10003422",{"type":10,"entryId":665,"sortOrder":666,"name":667,"imageUrl":668,"description":669,"currentMorphology":13,"currentStage":123,"position":670,"attributes":671},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[229],[379],{"id":673,"viewCount":59,"searchKey":674,"visible":15},"10003575",{"type":10,"entryId":675,"sortOrder":676,"name":677,"imageUrl":678,"description":679,"currentMorphology":13,"currentStage":22,"position":680,"attributes":681},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[229],[379],{"id":683,"viewCount":59,"searchKey":684,"visible":15},"10003415",{"type":10,"entryId":685,"sortOrder":686,"name":687,"imageUrl":688,"description":689,"currentMorphology":13,"currentStage":250,"position":690,"attributes":691},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[229],[379],{"id":693,"viewCount":59,"searchKey":694,"visible":15},"10003524",{"type":10,"entryId":695,"sortOrder":696,"name":697,"imageUrl":698,"description":699,"currentMorphology":13,"currentStage":123,"position":700,"attributes":701},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[24],[601],{"id":703,"viewCount":59,"searchKey":704,"visible":15},"10003475",{"type":10,"entryId":705,"sortOrder":706,"name":707,"imageUrl":708,"description":709,"currentMorphology":13,"currentStage":250,"position":710,"attributes":711},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[24],[601],{"id":713,"viewCount":59,"searchKey":714,"visible":15},"10003523",{"type":10,"entryId":715,"sortOrder":716,"name":717,"imageUrl":718,"description":719,"currentMorphology":13,"currentStage":123,"position":720,"attributes":721},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[24],[358],{"id":723,"viewCount":59,"searchKey":724,"visible":15},"10003398",{"type":10,"entryId":725,"sortOrder":726,"name":727,"imageUrl":728,"description":729,"currentMorphology":13,"currentStage":22,"position":730,"attributes":731},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[24],[358],{"id":733,"viewCount":59,"searchKey":734,"visible":15},"10003516",{"type":10,"entryId":735,"sortOrder":736,"name":737,"imageUrl":738,"description":739,"currentMorphology":13,"currentStage":250,"position":740,"attributes":741},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[293],[358],{"id":743,"viewCount":59,"searchKey":744,"visible":15},"10003566",{"type":10,"entryId":745,"sortOrder":746,"name":747,"imageUrl":748,"description":749,"currentMorphology":13,"currentStage":250,"position":750,"attributes":751},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[24],[358],{"id":753,"viewCount":59,"searchKey":754,"visible":15},"10003453",{"type":10,"entryId":755,"sortOrder":756,"name":757,"imageUrl":758,"description":759,"currentMorphology":13,"currentStage":123,"position":760,"attributes":761},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[229],[358],{"id":763,"viewCount":59,"searchKey":764,"visible":15},"10003577",{"type":10,"entryId":765,"sortOrder":766,"name":767,"imageUrl":768,"description":769,"currentMorphology":13,"currentStage":22,"position":770,"attributes":771},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[229],[358],{"id":773,"viewCount":59,"searchKey":774,"visible":15},"10003570",{"type":10,"entryId":775,"sortOrder":776,"name":777,"imageUrl":778,"description":779,"currentMorphology":13,"currentStage":250,"position":780,"attributes":781},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[229],[358],{"id":783,"viewCount":59,"searchKey":784,"visible":15},"10003565",{"type":10,"entryId":785,"sortOrder":786,"name":787,"imageUrl":788,"description":789,"currentMorphology":13,"currentStage":123,"position":790,"attributes":791},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[229],[26],{"id":793,"viewCount":59,"searchKey":794,"visible":15},"10003476",{"type":10,"entryId":795,"sortOrder":796,"name":797,"imageUrl":798,"description":799,"currentMorphology":13,"currentStage":250,"position":800,"attributes":801},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[229],[26],{"id":803,"viewCount":59,"searchKey":804,"visible":15},"10003466",{"type":10,"entryId":805,"sortOrder":806,"name":807,"imageUrl":808,"description":809,"currentMorphology":13,"currentStage":250,"position":810,"attributes":811},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[293],[26],{"id":813,"viewCount":59,"searchKey":814,"visible":15},"10003379",{"type":10,"entryId":815,"sortOrder":816,"name":817,"imageUrl":818,"description":819,"currentMorphology":13,"currentStage":123,"position":820,"attributes":821},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[229],[601],{"id":823,"viewCount":59,"searchKey":824,"visible":15},"10003376",{"type":10,"entryId":825,"sortOrder":826,"name":827,"imageUrl":828,"description":829,"currentMorphology":13,"currentStage":250,"position":830,"attributes":831},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[229],[601],{"id":833,"viewCount":59,"searchKey":834,"visible":15},"10003543",{"type":10,"entryId":835,"sortOrder":836,"name":837,"imageUrl":838,"description":839,"currentMorphology":13,"currentStage":123,"position":840,"attributes":841},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[24],[263],{"id":843,"viewCount":59,"searchKey":844,"visible":15},"10003557",{"type":10,"entryId":845,"sortOrder":846,"name":847,"imageUrl":848,"description":849,"currentMorphology":13,"currentStage":250,"position":850,"attributes":851},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[229],[263],{"id":853,"viewCount":59,"searchKey":854,"visible":15},"10003522",{"type":10,"entryId":855,"sortOrder":856,"name":857,"imageUrl":858,"description":859,"currentMorphology":13,"currentStage":250,"position":860,"attributes":861},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[24],[263],{"id":863,"viewCount":59,"searchKey":864,"visible":15},"10003579",{"type":10,"entryId":865,"sortOrder":866,"name":867,"imageUrl":868,"description":869,"currentMorphology":13,"currentStage":123,"position":870,"attributes":871},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[24],[295],{"id":873,"viewCount":59,"searchKey":874,"visible":15},"10003389",{"type":10,"entryId":875,"sortOrder":876,"name":877,"imageUrl":878,"description":879,"currentMorphology":13,"currentStage":22,"position":880,"attributes":881},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[24],[295],{"id":883,"viewCount":59,"searchKey":884,"visible":15},"10003536",{"type":10,"entryId":885,"sortOrder":886,"name":887,"imageUrl":888,"description":889,"currentMorphology":13,"currentStage":250,"position":890,"attributes":891},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[24],[295],{"id":893,"viewCount":59,"searchKey":894,"visible":15},"10003529",{"type":10,"entryId":895,"sortOrder":896,"name":897,"imageUrl":898,"description":899,"currentMorphology":13,"currentStage":250,"position":900,"attributes":901},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[229],[231],{"id":903,"viewCount":59,"searchKey":904,"visible":15},"10003433",{"type":10,"entryId":905,"sortOrder":906,"name":907,"imageUrl":908,"description":909,"currentMorphology":13,"currentStage":123,"position":910,"attributes":911},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[229],[26],{"id":913,"viewCount":59,"searchKey":914,"visible":15},"10003427",{"type":10,"entryId":915,"sortOrder":916,"name":917,"imageUrl":918,"description":919,"currentMorphology":13,"currentStage":250,"position":920,"attributes":921},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[229],[26],{"id":923,"viewCount":59,"searchKey":924,"visible":15},"10003405",{"type":10,"entryId":925,"sortOrder":926,"name":75,"imageUrl":927,"description":928,"currentMorphology":13,"currentStage":123,"position":929,"attributes":930},"071",1028100,"/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[24],[26],{"id":932,"viewCount":59,"searchKey":933,"visible":15},"10003525",{"type":10,"entryId":934,"sortOrder":935,"name":83,"imageUrl":936,"description":937,"currentMorphology":13,"currentStage":22,"position":938,"attributes":939},"072",1028200,"/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[24],[231,26],{"id":941,"viewCount":59,"searchKey":942,"visible":15},"10003399",{"type":10,"entryId":8,"sortOrder":943,"name":90,"imageUrl":944,"description":945,"currentMorphology":13,"currentStage":250,"position":946,"attributes":947},1028300,"/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[24],[231,26],{"id":4,"viewCount":59,"searchKey":949,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":950,"attributes":951},[24],[26],{"id":6,"viewCount":59,"searchKey":953,"visible":15},{"type":10,"entryId":12,"sortOrder":954,"name":104,"imageUrl":955,"description":956,"currentMorphology":13,"currentStage":250,"position":957,"attributes":958},1028500,"/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[24],[26],{"id":960,"viewCount":59,"searchKey":961,"visible":15},"10003386",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":13,"currentStage":123,"position":967,"attributes":968},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[293],[26],{"id":970,"viewCount":59,"searchKey":971,"visible":15},"10003447",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":13,"currentStage":250,"position":977,"attributes":978},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[293],[26],{"id":980,"viewCount":59,"searchKey":981,"visible":15},"10003497",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":13,"currentStage":123,"position":987,"attributes":988},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[293],[601],{"id":990,"viewCount":59,"searchKey":991,"visible":15},"10003479",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":13,"currentStage":22,"position":997,"attributes":998},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[293],[601],{"id":1000,"viewCount":59,"searchKey":1001,"visible":15},"10003388",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":13,"currentStage":250,"position":1007,"attributes":1008},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[293],[601],{"id":1010,"viewCount":59,"searchKey":1011,"visible":15},"10003429",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":13,"currentStage":123,"position":1017,"attributes":1018},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[389],[358],{"id":1020,"viewCount":59,"searchKey":1021,"visible":15},"10003430",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":13,"currentStage":250,"position":1027,"attributes":1028},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[389],[358],{"id":1030,"viewCount":59,"searchKey":1031,"visible":15},"10003549",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":13,"currentStage":215,"position":1037,"attributes":1038},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[389],[601],{"id":1040,"viewCount":59,"searchKey":1041,"visible":15},"10003494",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":13,"currentStage":123,"position":1047,"attributes":1048},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[389],[26,358],{"id":1050,"viewCount":59,"searchKey":1051,"visible":15},"10003486",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":13,"currentStage":250,"position":1057,"attributes":1058},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[389],[26,358],{"id":1060,"viewCount":59,"searchKey":1061,"visible":15},"10003530",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":13,"currentStage":123,"position":1067,"attributes":1068},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[24],[379],{"id":1070,"viewCount":59,"searchKey":1071,"visible":15},"10003457",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":13,"currentStage":250,"position":1077,"attributes":1078},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[24],[379],{"id":1080,"viewCount":59,"searchKey":1081,"visible":15},"10003423",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":13,"currentStage":123,"position":1087,"attributes":1088},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[356],[336,358],{"id":1090,"viewCount":59,"searchKey":1091,"visible":15},"10003419",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":13,"currentStage":250,"position":1097,"attributes":1098},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[356],[336,358],{"id":1100,"viewCount":59,"searchKey":1101,"visible":15},"10003410",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":13,"currentStage":123,"position":1107,"attributes":1108},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[229],[358],{"id":1110,"viewCount":59,"searchKey":1111,"visible":15},"10003509",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":13,"currentStage":250,"position":1117,"attributes":1118},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[229],[358],{"id":1120,"viewCount":59,"searchKey":1121,"visible":15},"10003413",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":13,"currentStage":123,"position":1127,"attributes":1128},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[229],[379],{"id":1130,"viewCount":59,"searchKey":1131,"visible":15},"10003407",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":13,"currentStage":250,"position":1137,"attributes":1138},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[229],[379],{"id":1140,"viewCount":59,"searchKey":1141,"visible":15},"10003498",{"type":10,"entryId":1142,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":13,"currentStage":215,"position":1147,"attributes":1148},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[229],[1149],"attributes-holy",{"id":1151,"viewCount":59,"search