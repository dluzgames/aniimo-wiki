",{"attributes":212,"type":214,"consume":215,"power":216},[213],"5",[201],"10","25",{"id":218,"type":140,"props":219},"91268399_37",{"id":220,"customKey":46,"icon":221,"iconStyle":65,"iconTitle":46,"descTitle":222,"descContent":223,"source":224},"91268399_38","/cdn/init/1003200_Skill_11200021_Icon.png","暗影突襲","攜帶暗影的力量衝撞目標。施放技能後，普攻傷害提高40%，持續10秒。",{"attributes":225,"type":226,"consume":215,"power":216},[199],[201],{"id":228,"type":140,"props":229},"91268399_39",{"id":230,"customKey":46,"icon":231,"iconStyle":65,"iconTitle":46,"descTitle":232,"descContent":233,"source":234},"91268399_40","/cdn/init/1003200_Skill_11200030_Icon.png","鐮影輪舞","旋轉揮砍，對周圍所有目標造成三次暗元素傷害。該技能每命中一次目標，自身傷害提高8%，最高32%，持續10秒。",{"attributes":235,"type":236,"consume":202,"power":237},[199],[201],"60",{"id":239,"type":140,"props":240},"91268399_41",{"id":241,"customKey":46,"icon":242,"iconStyle":65,"iconTitle":46,"descTitle":243,"descContent":244,"source":245},"91268399_42","/cdn/init/1003200_Skill_10600513_Icon.png","森影輪舞","旋轉揮砍，對周圍所有目標造成三次草元素傷害。該技能每命中一次目標，自身傷害提高8%，最高32%，持續10秒。",{"attributes":246,"type":248,"consume":202,"power":237},[247],"6",[201],{"id":250,"title":251,"children":252},"91268399_43","固有技能",[253,264],{"id":254,"type":140,"props":255},"91268399_44",{"id":256,"customKey":46,"icon":257,"iconStyle":65,"iconTitle":46,"descTitle":258,"descContent":259,"source":260},"91268399_45","/cdn/init/1003200_Skill_11200000_Icon.png","攻擊","使用暗元素能力，近距離攻擊目標。",{"attributes":261,"type":262,"consume":263,"power":247},[199],[201],"0",{"id":265,"type":140,"props":266},"91268399_46",{"id":267,"customKey":46,"icon":268,"iconStyle":65,"iconTitle":46,"descTitle":269,"descContent":270,"source":271},"91268399_47","/cdn/init/1003200_Skill_11200040_Icon.png","暗刃裂空","割裂空間，造成高額的物理傷害。",{"attributes":272,"type":273,"consume":263,"power":274},[199],[201],"170",[276,277,278,281,283],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":279,"entryId":12,"currentMorphology":280,"visible":15},"10003381","Prismana Form",{"id":282,"entryId":12,"currentMorphology":9,"visible":15},"10003383",{"id":284,"entryId":12,"currentMorphology":285,"visible":15},"10003586","Umbrabow Form",[287,298,309,319,330,340,350,362,372,382,392,403,413,425,435,446,457,467,477,487,497,507,517,528,538,548,558,568,578,588,598,608,618,628,638,648,658,669,679,689,699,707,711,720,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1130,1140,1150,1160,1170,1180,1190,1200,1210,1221],{"id":288,"viewCount":59,"searchKey":289,"visible":15},"10003442",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":21,"currentStage":201,"position":295,"attributes":296},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[297],"attributes-fire",{"id":299,"viewCount":59,"searchKey":300,"visible":15},"10003534",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":21,"currentStage":306,"position":307,"attributes":308},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[24],[297],{"id":310,"viewCount":59,"searchKey":311,"visible":15},"10003435",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":21,"currentStage":22,"position":317,"attributes":318},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[24],[297],{"id":320,"viewCount":59,"searchKey":321,"visible":15},"10003428",{"type":10,"entryId":322,"sortOrder":323,"name":324,"imageUrl":325,"description":326,"currentMorphology":21,"currentStage":22,"position":327,"attributes":329},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[328],"position-break",[297,26],{"id":331,"viewCount":59,"searchKey":332,"visible":15},"10003578",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":21,"currentStage":201,"position":338,"attributes":339},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[26],{"id":341,"viewCount":59,"searchKey":342,"visible":15},"10003417",{"type":10,"entryId":343,"sortOrder":344,"name":345,"imageUrl":346,"description":347,"currentMorphology":21,"currentStage":22,"position":348,"attributes":349},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[26],{"id":351,"viewCount":59,"searchKey":352,"visible":15},"10003488",{"type":10,"entryId":353,"sortOrder":354,"name":355,"imageUrl":356,"description":357,"currentMorphology":21,"currentStage":201,"position":358,"attributes":360},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[359],"position-sup",[361],"attributes-wind",{"id":363,"viewCount":59,"searchKey":364,"visible":15},"10003548",{"type":10,"entryId":365,"sortOrder":366,"name":367,"imageUrl":368,"description":369,"currentMorphology":21,"currentStage":22,"position":370,"attributes":371},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[359],[361],{"id":373,"viewCount":59,"searchKey":374,"visible":15},"10003474",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":21,"currentStage":22,"position":380,"attributes":381},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[361],{"id":383,"viewCount":59,"searchKey":384,"visible":15},"10003467",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":21,"currentStage":22,"position":390,"attributes":391},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[328],[361],{"id":393,"viewCount":59,"searchKey":394,"visible":15},"10003392",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":21,"currentStage":201,"position":400,"attributes":401},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[402],"attributes-grass",{"id":404,"viewCount":59,"searchKey":405,"visible":15},"10003510",{"type":10,"entryId":406,"sortOrder":407,"name":408,"imageUrl":409,"description":410,"currentMorphology":21,"currentStage":22,"position":411,"attributes":412},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[402],{"id":414,"viewCount":59,"searchKey":415,"visible":15},"10003477",{"type":10,"entryId":416,"sortOrder":417,"name":418,"imageUrl":419,"description":420,"currentMorphology":21,"currentStage":201,"position":421,"attributes":423},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[422],"position-heal",[424],"attributes-water",{"id":426,"viewCount":59,"searchKey":427,"visible":15},"10003569",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":21,"currentStage":306,"position":433,"attributes":434},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[422],[424],{"id":436,"viewCount":59,"searchKey":437,"visible":15},"10003470",{"type":10,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":21,"currentStage":22,"position":443,"attributes":444},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[422],[424,445],"attributes-ice",{"id":447,"viewCount":59,"searchKey":448,"visible":15},"10003463",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":21,"currentStage":22,"position":454,"attributes":456},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[455],"position-energy",[402,424],{"id":458,"viewCount":59,"searchKey":459,"visible":15},"10003468",{"type":10,"entryId":460,"sortOrder":461,"name":462,"imageUrl":463,"description":464,"currentMorphology":21,"currentStage":201,"position":465,"attributes":466},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[359],[361],{"id":468,"viewCount":59,"searchKey":469,"visible":15},"10003365",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":21,"currentStage":22,"position":475,"attributes":476},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[359],[361],{"id":478,"viewCount":59,"searchKey":479,"visible":15},"10003461",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":21,"currentStage":22,"position":485,"attributes":486},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[359],[26],{"id":488,"viewCount":59,"searchKey":489,"visible":15},"10003421",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":21,"currentStage":201,"position":495,"attributes":496},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[328],[402],{"id":498,"viewCount":59,"searchKey":499,"visible":15},"10003414",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":21,"currentStage":22,"position":505,"attributes":506},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[455],[26,402],{"id":508,"viewCount":59,"searchKey":509,"visible":15},"10003404",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":21,"currentStage":22,"position":515,"attributes":516},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[328],[402],{"id":518,"viewCount":59,"searchKey":519,"visible":15},"10003567",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":21,"currentStage":201,"position":525,"attributes":526},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[328],[527,402],"attributes-rock",{"id":529,"viewCount":59,"searchKey":530,"visible":15},"10003462",{"type":10,"entryId":531,"sortOrder":532,"name":533,"imageUrl":534,"description":535,"currentMorphology":21,"currentStage":22,"position":536,"attributes":537},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[328],[527,402],{"id":539,"viewCount":59,"searchKey":540,"visible":15},"10003551",{"type":10,"entryId":541,"sortOrder":542,"name":543,"imageUrl":544,"description":545,"currentMorphology":21,"currentStage":22,"position":546,"attributes":547},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[328],[445],{"id":549,"viewCount":59,"searchKey":550,"visible":15},"10003409",{"type":10,"entryId":551,"sortOrder":552,"name":553,"imageUrl":554,"description":555,"currentMorphology":21,"currentStage":201,"position":556,"attributes":557},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[455],[297],{"id":559,"viewCount":59,"searchKey":560,"visible":15},"10003507",{"type":10,"entryId":561,"sortOrder":562,"name":563,"imageUrl":564,"description":565,"currentMorphology":21,"currentStage":22,"position":566,"attributes":567},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[455],[297],{"id":569,"viewCount":59,"searchKey":570,"visible":15},"10003542",{"type":10,"entryId":571,"sortOrder":572,"name":573,"imageUrl":574,"description":575,"currentMorphology":21,"currentStage":201,"position":576,"attributes":577},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[422],[361],{"id":579,"viewCount":59,"searchKey":580,"visible":15},"10003440",{"type":10,"entryId":581,"sortOrder":582,"name":583,"imageUrl":584,"description":585,"currentMorphology":21,"currentStage":22,"position":586,"attributes":587},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[422],[361],{"id":589,"viewCount":59,"searchKey":590,"visible":15},"10003563",{"type":10,"entryId":591,"sortOrder":592,"name":593,"imageUrl":594,"description":595,"currentMorphology":21,"currentStage":263,"position":596,"attributes":597},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[455],[361,402],{"id":599,"viewCount":59,"searchKey":600,"visible":15},"10003368",{"type":10,"entryId":601,"sortOrder":602,"name":603,"imageUrl":604,"description":605,"currentMorphology":21,"currentStage":201,"position":606,"attributes":607},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[359],[361],{"id":609,"viewCount":59,"searchKey":610,"visible":15},"10003363",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":21,"currentStage":22,"position":616,"attributes":617},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[359],[361],{"id":619,"viewCount":59,"searchKey":620,"visible":15},"10003515",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":21,"currentStage":201,"position":626,"attributes":627},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[402],{"id":629,"viewCount":59,"searchKey":630,"visible":15},"10003496",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":21,"currentStage":22,"position":636,"attributes":637},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[24],[402],{"id":639,"viewCount":59,"searchKey":640,"visible":15},"10003378",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":21,"currentStage":22,"position":646,"attributes":647},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[359],[402],{"id":649,"viewCount":59,"searchKey":650,"visible":15},"10003456",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":21,"currentStage":201,"position":656,"attributes":657},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[328],[402],{"id":659,"viewCount":59,"searchKey":660,"visible":15},"10003374",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":21,"currentStage":22,"position":666,"attributes":667},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[359],[668],"attributes-electric",{"id":670,"viewCount":59,"searchKey":671,"visible":15},"10003443",{"type":10,"entryId":672,"sortOrder":673,"name":674,"imageUrl":675,"description":676,"currentMorphology":21,"currentStage":22,"position":677,"attributes":678},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[328],[402],{"id":680,"viewCount":59,"searchKey":681,"visible":15},"10003503",{"type":10,"entryId":682,"sortOrder":683,"name":684,"imageUrl":685,"description":686,"currentMorphology":21,"currentStage":201,"position":687,"attributes":688},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[359],[26],{"id":690,"viewCount":59,"searchKey":691,"visible":15},"10003521",{"type":10,"entryId":692,"sortOrder":693,"name":694,"imageUrl":695,"description":696,"currentMorphology":21,"currentStage":22,"position":697,"attributes":698},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[359],[26],{"id":700,"viewCount":59,"searchKey":701,"visible":15},"10003508",{"type":10,"entryId":8,"sortOrder":702,"name":75,"imageUrl":703,"description":704,"currentMorphology":21,"currentStage":201,"position":705,"attributes":706},1003100,"/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[26],{"id":4,"viewCount":59,"searchKey":708,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":709,"attributes":710},[24],[26],{"id":712,"viewCount":59,"searchKey":713,"visible":15},"10003501",{"type":10,"entryId":714,"sortOrder":715,"name":83,"imageUrl":716,"description":717,"currentMorphology":21,"currentStage":22,"position":718,"attributes":719},"044",1003300,"/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[668],{"id":721,"viewCount":59,"searchKey":722,"visible":15},"10003422",{"type":10,"entryId":723,"sortOrder":724,"name":725,"imageUrl":726,"description":727,"currentMorphology":21,"currentStage":201,"position":728,"attributes":729},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[445],{"id":731,"viewCount":59,"searchKey":732,"visible":15},"10003575",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":21,"currentStage":306,"position":738,"attributes":739},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[445],{"id":741,"viewCount":59,"searchKey":742,"visible":15},"10003415",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":21,"currentStage":22,"position":748,"attributes":749},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[24],[445],{"id":751,"viewCount":59,"searchKey":752,"visible":15},"10003524",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":21,"currentStage":201,"position":758,"attributes":759},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[328],[668],{"id":761,"viewCount":59,"searchKey":762,"visible":15},"10003475",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":21,"currentStage":22,"position":768,"attributes":769},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[328],[668],{"id":771,"viewCount":59,"searchKey":772,"visible":15},"10003523",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":21,"currentStage":201,"position":778,"attributes":779},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[328],[424],{"id":781,"viewCount":59,"searchKey":782,"visible":15},"10003398",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":21,"currentStage":306,"position":788,"attributes":789},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[328],[424],{"id":791,"viewCount":59,"searchKey":792,"visible":15},"10003516",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":21,"currentStage":22,"position":798,"attributes":799},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[359],[424],{"id":801,"viewCount":59,"searchKey":802,"visible":15},"10003566",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":21,"currentStage":22,"position":808,"attributes":809},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[328],[424],{"id":811,"viewCount":59,"searchKey":812,"visible":15},"10003453",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":21,"currentStage":201,"position":818,"attributes":819},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[24],[424],{"id":821,"viewCount":59,"searchKey":822,"visible":15},"10003577",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":21,"currentStage":306,"position":828,"attributes":829},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[424],{"id":831,"viewCount":59,"searchKey":832,"visible":15},"10003570",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":21,"currentStage":22,"position":838,"attributes":839},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[424],{"id":841,"viewCount":59,"searchKey":842,"visible":15},"10003565",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":21,"currentStage":201,"position":848,"attributes":849},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[24],[527],{"id":851,"viewCount":59,"searchKey":852,"visible":15},"10003476",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":21,"currentStage":22,"position":858,"attributes":859},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[527],{"id":861,"viewCount":59,"searchKey":862,"visible":15},"10003466",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":21,"currentStage":22,"position":868,"attributes":869},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[359],[527],{"id":871,"viewCount":59,"searchKey":872,"visible":15},"10003379",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":21,"currentStage":201,"position":878,"attributes":879},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[24],[668],{"id":881,"viewCount":59,"searchKey":882,"visible":15},"10003376",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":21,"currentStage":22,"position":888,"attributes":889},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[668],{"id":891,"viewCount":59,"searchKey":892,"visible":15},"10003543",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":21,"currentStage":201,"position":898,"attributes":899},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[328],[26],{"id":901,"viewCount":59,"searchKey":902,"visible":15},"10003557",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":21,"currentStage":22,"position":908,"attributes":909},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[26],{"id":911,"viewCount":59,"searchKey":912,"visible":15},"10003522",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":21,"currentStage":22,"position":918,"attributes":919},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[328],[26],{"id":921,"viewCount":59,"searchKey":922,"visible":15},"10003579",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":21,"currentStage":201,"position":928,"attributes":929},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[328],[361],{"id":931,"viewCount":59,"searchKey":932,"visible":15},"10003389",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":21,"currentStage":306,"position":938,"attributes":939},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[328],[361],{"id":941,"viewCount":59,"searchKey":942,"visible":15},"10003536",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":21,"currentStage":22,"position":948,"attributes":949},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[328],[361],{"id":951,"viewCount":59,"searchKey":952,"visible":15},"10003529",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":21,"currentStage":22,"position":958,"attributes":959},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[24],[297],{"id":961,"viewCount":59,"searchKey":962,"visible":15},"10003433",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":21,"currentStage":201,"position":968,"attributes":969},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[527],{"id":971,"viewCount":59,"searchKey":972,"visible":15},"10003427",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":21,"currentStage":22,"position":978,"attributes":979},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[527],{"id":981,"viewCount":59,"searchKey":982,"visible":15},"10003405",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":21,"currentStage":201,"position":988,"attributes":989},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[328],[527],{"id":991,"viewCount":59,"searchKey":992,"visible":15},"10003525",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":21,"currentStage":306,"position":998,"attributes":999},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[328],[297,527],{"id":1001,"viewCount":59,"searchKey":1002,"visible":15},"10003399",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":21,"currentStage":22,"position":1008,"attributes":1009},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[328],[297,527],{"id":1011,"viewCount":59,"searchKey":1012,"visible":15},"10003518",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":21,"currentStage":306,"position":1018,"attributes":1019},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[328],[527],{"id":1021,"viewCount":59,"searchKey":1022,"visible":15},"10003393",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":21,"currentStage":22,"position":1028,"attributes":1029},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[328],[527],{"id":1031,"viewCount":59,"searchKey":1032,"visible":15},"10003386",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":21,"currentStage":201,"position":1038,"attributes":1039},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[359],[527],{"id":1041,"viewCount":59,"searchKey":1042,"visible":15},"10003447",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":21,"currentStage":22,"position":1048,"attributes":1049},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[359],[527],{"id":1051,"viewCount":59,"searchKey":1052,"visible":15},"10003497",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":21,"currentStage":201,"position":1058,"attributes":1059},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[359],[668],{"id":1061,"viewCount":59,"searchKey":1062,"visible":15},"10003479",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":21,"currentStage":306,"position":1068,"attributes":1069},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[359],[668],{"id":1071,"viewCount":59,"searchKey":1072,"visible":15},"10003388",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":21,"currentStage":22,"position":1078,"attributes":1079},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[359],[668],{"id":1081,"viewCount":59,"searchKey":1082,"visible":15},"10003429",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":21,"currentStage":201,"position":1088,"attributes":1089},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[455],[424],{"id":1091,"viewCount":59,"searchKey":1092,"visible":15},"10003430",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":21,"currentStage":22,"position":1098,"attributes":1099},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[455],[424],{"id":1101,"viewCount":59,"searchKey":1102,"visible":15},"10003549",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":21,"currentStage":263,"position":1108,"attributes":1109},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[455],[668],{"id":1111,"viewCount":59,"searchKey":1112,"visible":15},"10003494",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":21,"currentStage":201,"position":1118,"attributes":1119},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[455],[527,424],{"id":1121,"viewCount":59,"searchKey":1122,"visible":15},"10003486",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":21,"currentStage":22,"position":1128,"attributes":1129},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[455],[527,424],{"id":1131,"viewCount":59,"searchKey":1132,"visible":15},"10003530",{"type":10,"entryId":1133,"sortOrder":1134,"name":1135,"imageUrl":1136,"description":1137,"currentMorphology":21,"currentStage":201,"position":1138,"attributes":1139},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[328],[445],{"id":1141,"viewCount":59,"searchKey":1142,"visible":15},"10003457",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":21,"currentStage":22,"position":1148,"attributes":1149},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[328],[445],{"id":1151,"viewCount":59,"searchKey":1152,"visible":15},"10003423",{"type":10,"entryId":1153,"sortOrder":1154,"name":1155,"imageUrl":1156,"description":1157,"currentMorphology":21,"currentStage":201,"position":1158,"attributes":1159},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[422],[402,424],{"id":1161,"viewCount":59,"searchKey":1162,"visible":15},"10003419",{"type":10,"entryId":1163,"sortOrder":1164,"name":1165,"imageUrl":1166,"description":1167,"currentMorphology":21,"currentStage":22,"position":1168,"attributes":1169},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[422],[402,424],{"id":1171,"viewCount":59,"searchKey":1172,"visible":15},"10003410",{"type":10,"entryId":1173,"sortOrder":1174,"name":1175,"imageUrl":1176,"description":1177,"currentMorphology":21,"currentStage":201,"position":1178,"attributes":1179},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[424],{"id":1181,"viewCount":59,"searchKey":1182,"visible":15},"10003509",{"type":10,"entryId":1183,"sortOrder":1184,"name":1185,"imageUrl":1186,"description":1187,"currentMorphology":21,"currentStage":22,"position":1188,"attributes":1189},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[424],{"id":1191,"viewCount":59,"searchKey":1192,"visible":15},"10003413",{"type":10,"entryId":1193,"sortOrder":1194,"name":1195,"imageUrl":1196,"description":1197,"currentMorphology":21,"currentStage":201,"position":1198,"attributes":1199},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[445],{"id":1201,"viewCount":59,"searchKey":1202,"visible":15},"10003407",{"type":10,"entryId":1203,"sortOrder":1204,"name":1205,"imageUrl":1206,"description":1207,"currentMorphology":21,"currentStage":22,"position":1208,"attributes":1209},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[445],{"id":1211,"viewCount":59,"searchKey":1212,"visible":15},"10003498",{"type":10,"entryId":1213,"sortOrder":1214,"name":1215,"imageUrl":1216,"description":1217,"currentMorphology":21,"currentStage":263,"position":1218,"attributes":1219},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1220],"attributes-holy",{"id":1222,"viewCount":59,"searchKey":1223,"visible":15},"10003375",{"type":10,"entryId":1224,"sortOrder":1225,"name":1226,"imageUrl":1227,"description":1228,"currentMorphology":21,"currentStage":263,"position":1229,"attributes":1230},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1220],[1232,1240,1244,1249,1254,1259,1264,1269,1273,1276,1281,1286,1290,1295,1300,1305,1309,1314,1317],{"id":1233,"parentId":1234,"tagType":1235,"tagKey":1236,"name":1237,"language":1238,"sort":1239},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1241,"parentId":1234,"tagType":1235,"tagKey":13,"name":1242,"language":1238,"sort":1243},"169975e83c7c7cc9196859ca36b9ab26","森林型態",8,{"id":1245,"parentId":1234,"tagType":1235,"tagKey":1246,"name":1247,"language":1238,"sort":1248},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1250,"parentId":1234,"tagType":1235,"tagKey":1251,"name":1252,"language":1238,"sort":1253},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1255,"parentId":1234,"tagType":1235,"tagKey":1256,"name":1257,"language":1238,"sort":1258},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1260,"parentId":1234,"tagType":1235,"tagKey":1261,"name":1262,"language":1238,"sort":1263},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1265,"parentId":1234,"tagType":1235,"tagKey":1266,"name":1267,"language":1238,"sort":1268},"568127bc77f184cd4308056381642df7","Snowfield Form","雪地型態",5,{"id":1270,"parentId":1234,"tagType":1235,"tagKey":1271,"name":1272,"language":1238,"sort":129},"5989c0c15477b85af6544dca43428cd7","Rainstorm Form","雨天型態",{"id":1274,"parentId":1234,"tagType":1235,"t