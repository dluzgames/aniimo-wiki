unt":57,"searchKey":205,"visible":15},"10003442",{"type":10,"entryId":206,"sortOrder":207,"name":208,"imageUrl":209,"description":210,"currentMorphology":21,"currentStage":22,"position":211,"attributes":213},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[212],"position-dps",[214],"attributes-fire",{"id":216,"viewCount":57,"searchKey":217,"visible":15},"10003534",{"type":10,"entryId":218,"sortOrder":219,"name":220,"imageUrl":221,"description":222,"currentMorphology":21,"currentStage":223,"position":224,"attributes":225},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[212],[214],{"id":227,"viewCount":57,"searchKey":228,"visible":15},"10003435",{"type":10,"entryId":229,"sortOrder":230,"name":231,"imageUrl":232,"description":233,"currentMorphology":21,"currentStage":234,"position":235,"attributes":236},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[212],[214],{"id":238,"viewCount":57,"searchKey":239,"visible":15},"10003428",{"type":10,"entryId":240,"sortOrder":241,"name":242,"imageUrl":243,"description":244,"currentMorphology":21,"currentStage":234,"position":245,"attributes":246},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[24],[214,247],"attributes-dark",{"id":249,"viewCount":57,"searchKey":250,"visible":15},"10003578",{"type":10,"entryId":251,"sortOrder":252,"name":253,"imageUrl":254,"description":255,"currentMorphology":21,"currentStage":22,"position":256,"attributes":257},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[212],[247],{"id":259,"viewCount":57,"searchKey":260,"visible":15},"10003417",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":21,"currentStage":234,"position":266,"attributes":267},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[212],[247],{"id":269,"viewCount":57,"searchKey":270,"visible":15},"10003488",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":21,"currentStage":22,"position":276,"attributes":278},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[277],"position-sup",[26],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10003548",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":21,"currentStage":234,"position":287,"attributes":288},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[277],[26],{"id":290,"viewCount":57,"searchKey":291,"visible":15},"10003474",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":21,"currentStage":234,"position":297,"attributes":298},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[212],[26],{"id":300,"viewCount":57,"searchKey":301,"visible":15},"10003467",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":21,"currentStage":234,"position":307,"attributes":308},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[24],[26],{"id":310,"viewCount":57,"searchKey":311,"visible":15},"10003392",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":21,"currentStage":22,"position":317,"attributes":318},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[212],[319],"attributes-grass",{"id":321,"viewCount":57,"searchKey":322,"visible":15},"10003510",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":21,"currentStage":234,"position":328,"attributes":329},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[212],[319],{"id":331,"viewCount":57,"searchKey":332,"visible":15},"10003477",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":21,"currentStage":22,"position":338,"attributes":340},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[339],"position-heal",[341],"attributes-water",{"id":343,"viewCount":57,"searchKey":344,"visible":15},"10003569",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":21,"currentStage":223,"position":350,"attributes":351},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[339],[341],{"id":353,"viewCount":57,"searchKey":354,"visible":15},"10003470",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":21,"currentStage":234,"position":360,"attributes":361},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[339],[341,362],"attributes-ice",{"id":364,"viewCount":57,"searchKey":365,"visible":15},"10003463",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":21,"currentStage":234,"position":371,"attributes":373},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[372],"position-energy",[319,341],{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10003468",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":21,"currentStage":22,"position":382,"attributes":383},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[277],[26],{"id":385,"viewCount":57,"searchKey":386,"visible":15},"10003365",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":21,"currentStage":234,"position":392,"attributes":393},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[277],[26],{"id":395,"viewCount":57,"searchKey":396,"visible":15},"10003461",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":21,"currentStage":234,"position":402,"attributes":403},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[277],[247],{"id":405,"viewCount":57,"searchKey":406,"visible":15},"10003421",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":21,"currentStage":22,"position":412,"attributes":413},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[24],[319],{"id":415,"viewCount":57,"searchKey":416,"visible":15},"10003414",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":21,"currentStage":234,"position":422,"attributes":423},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[372],[247,319],{"id":425,"viewCount":57,"searchKey":426,"visible":15},"10003404",{"type":10,"entryId":427,"sortOrder":428,"name":429,"imageUrl":430,"description":431,"currentMorphology":21,"currentStage":234,"position":432,"attributes":433},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[24],[319],{"id":435,"viewCount":57,"searchKey":436,"visible":15},"10003567",{"type":10,"entryId":437,"sortOrder":438,"name":439,"imageUrl":440,"description":441,"currentMorphology":21,"currentStage":22,"position":442,"attributes":443},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[24],[444,319],"attributes-rock",{"id":446,"viewCount":57,"searchKey":447,"visible":15},"10003462",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":21,"currentStage":234,"position":453,"attributes":454},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[24],[444,319],{"id":456,"viewCount":57,"searchKey":457,"visible":15},"10003551",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":21,"currentStage":234,"position":463,"attributes":464},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[24],[362],{"id":466,"viewCount":57,"searchKey":467,"visible":15},"10003409",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":21,"currentStage":22,"position":473,"attributes":474},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[372],[214],{"id":476,"viewCount":57,"searchKey":477,"visible":15},"10003507",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":21,"currentStage":234,"position":483,"attributes":484},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[372],[214],{"id":486,"viewCount":57,"searchKey":487,"visible":15},"10003542",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":21,"currentStage":22,"position":493,"attributes":494},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[339],[26],{"id":496,"viewCount":57,"searchKey":497,"visible":15},"10003440",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":21,"currentStage":234,"position":503,"attributes":504},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[339],[26],{"id":506,"viewCount":57,"searchKey":507,"visible":15},"10003563",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":21,"currentStage":197,"position":513,"attributes":514},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[372],[26,319],{"id":516,"viewCount":57,"searchKey":517,"visible":15},"10003368",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":21,"currentStage":22,"position":523,"attributes":524},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[277],[26],{"id":526,"viewCount":57,"searchKey":527,"visible":15},"10003363",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":21,"currentStage":234,"position":533,"attributes":534},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[277],[26],{"id":536,"viewCount":57,"searchKey":537,"visible":15},"10003515",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":21,"currentStage":22,"position":543,"attributes":544},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[212],[319],{"id":546,"viewCount":57,"searchKey":547,"visible":15},"10003496",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":21,"currentStage":234,"position":553,"attributes":554},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[212],[319],{"id":556,"viewCount":57,"searchKey":557,"visible":15},"10003378",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":21,"currentStage":234,"position":563,"attributes":564},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[277],[319],{"id":566,"viewCount":57,"searchKey":567,"visible":15},"10003456",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":21,"currentStage":22,"position":573,"attributes":574},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[24],[319],{"id":576,"viewCount":57,"searchKey":577,"visible":15},"10003374",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":21,"currentStage":234,"position":583,"attributes":584},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[277],[585],"attributes-electric",{"id":587,"viewCount":57,"searchKey":588,"visible":15},"10003443",{"type":10,"entryId":589,"sortOrder":590,"name":591,"imageUrl":592,"description":593,"currentMorphology":21,"currentStage":234,"position":594,"attributes":595},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[24],[319],{"id":597,"viewCount":57,"searchKey":598,"visible":15},"10003503",{"type":10,"entryId":599,"sortOrder":600,"name":601,"imageUrl":602,"description":603,"currentMorphology":21,"currentStage":22,"position":604,"attributes":605},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[277],[247],{"id":607,"viewCount":57,"searchKey":608,"visible":15},"10003521",{"type":10,"entryId":609,"sortOrder":610,"name":611,"imageUrl":612,"description":613,"currentMorphology":21,"currentStage":234,"position":614,"attributes":615},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[277],[247],{"id":617,"viewCount":57,"searchKey":618,"visible":15},"10003508",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":21,"currentStage":22,"position":624,"attributes":625},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[212],[247],{"id":627,"viewCount":57,"searchKey":628,"visible":15},"10003369",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":21,"currentStage":234,"position":634,"attributes":635},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[212],[247],{"id":637,"viewCount":57,"searchKey":638,"visible":15},"10003501",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":21,"currentStage":234,"position":644,"attributes":645},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[212],[585],{"id":647,"viewCount":57,"searchKey":648,"visible":15},"10003422",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":21,"currentStage":22,"position":654,"attributes":655},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[212],[362],{"id":657,"viewCount":57,"searchKey":658,"visible":15},"10003575",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":21,"currentStage":223,"position":664,"attributes":665},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[212],[362],{"id":667,"viewCount":57,"searchKey":668,"visible":15},"10003415",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":21,"currentStage":234,"position":674,"attributes":675},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[212],[362],{"id":677,"viewCount":57,"searchKey":678,"visible":15},"10003524",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":21,"currentStage":22,"position":684,"attributes":685},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[24],[585],{"id":687,"viewCount":57,"searchKey":688,"visible":15},"10003475",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":21,"currentStage":234,"position":694,"attributes":695},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[24],[585],{"id":697,"viewCount":57,"searchKey":698,"visible":15},"10003523",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":21,"currentStage":22,"position":704,"attributes":705},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[24],[341],{"id":707,"viewCount":57,"searchKey":708,"visible":15},"10003398",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":21,"currentStage":223,"position":714,"attributes":715},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[24],[341],{"id":717,"viewCount":57,"searchKey":718,"visible":15},"10003516",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":21,"currentStage":234,"position":724,"attributes":725},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[277],[341],{"id":727,"viewCount":57,"searchKey":728,"visible":15},"10003566",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":21,"currentStage":234,"position":734,"attributes":735},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[24],[341],{"id":737,"viewCount":57,"searchKey":738,"visible":15},"10003453",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":21,"currentStage":22,"position":744,"attributes":745},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[212],[341],{"id":747,"viewCount":57,"searchKey":748,"visible":15},"10003577",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":21,"currentStage":223,"position":754,"attributes":755},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[212],[341],{"id":757,"viewCount":57,"searchKey":758,"visible":15},"10003570",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":21,"currentStage":234,"position":764,"attributes":765},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[212],[341],{"id":767,"viewCount":57,"searchKey":768,"visible":15},"10003565",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":21,"currentStage":22,"position":774,"attributes":775},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[212],[444],{"id":777,"viewCount":57,"searchKey":778,"visible":15},"10003476",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":21,"currentStage":234,"position":784,"attributes":785},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[212],[444],{"id":787,"viewCount":57,"searchKey":788,"visible":15},"10003466",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":21,"currentStage":234,"position":794,"attributes":795},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[277],[444],{"id":797,"viewCount":57,"searchKey":798,"visible":15},"10003379",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":21,"currentStage":22,"position":804,"attributes":805},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[212],[585],{"id":807,"viewCount":57,"searchKey":808,"visible":15},"10003376",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":21,"currentStage":234,"position":814,"attributes":815},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[212],[585],{"id":817,"viewCount":57,"searchKey":818,"visible":15},"10003543",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":21,"currentStage":22,"position":824,"attributes":825},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[24],[247],{"id":827,"viewCount":57,"searchKey":828,"visible":15},"10003557",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":21,"currentStage":234,"position":834,"attributes":835},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[212],[247],{"id":837,"viewCount":57,"searchKey":838,"visible":15},"10003522",{"type":10,"entryId":8,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":21,"currentStage":234,"position":843,"attributes":844},1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[24],[247],{"id":4,"viewCount":57,"searchKey":846,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":847,"attributes":848},[24],[26],{"id":850,"viewCount":57,"searchKey":851,"visible":15},"10003389",{"type":10,"entryId":852,"sortOrder":853,"name":854,"imageUrl":855,"description":856,"currentMorphology":21,"currentStage":223,"position":857,"attributes":858},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[24],[26],{"id":860,"viewCount":57,"searchKey":861,"visible":15},"10003536",{"type":10,"entryId":862,"sortOrder":863,"name":864,"imageUrl":865,"description":866,"currentMorphology":21,"currentStage":234,"position":867,"attributes":868},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[24],[26],{"id":870,"viewCount":57,"searchKey":871,"visible":15},"10003529",{"type":10,"entryId":872,"sortOrder":873,"name":874,"imageUrl":875,"description":876,"currentMorphology":21,"currentStage":234,"position":877,"attributes":878},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[212],[214],{"id":880,"viewCount":57,"searchKey":881,"visible":15},"10003433",{"type":10,"entryId":882,"sortOrder":883,"name":884,"imageUrl":885,"description":886,"currentMorphology":21,"currentStage":22,"position":887,"attributes":888},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[212],[444],{"id":890,"viewCount":57,"searchKey":891,"visible":15},"10003427",{"type":10,"entryId":892,"sortOrder":893,"name":894,"imageUrl":895,"description":896,"currentMorphology":21,"currentStage":234,"position":897,"attributes":898},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[212],[444],{"id":900,"viewCount":57,"searchKey":901,"visible":15},"10003405",{"type":10,"entryId":902,"sortOrder":903,"name":904,"imageUrl":905,"description":906,"currentMorphology":21,"currentStage":22,"position":907,"attributes":908},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[24],[444],{"id":910,"viewCount":57,"searchKey":911,"visible":15},"10003525",{"type":10,"entryId":912,"sortOrder":913,"name":914,"imageUrl":915,"description":916,"currentMorphology":21,"currentStage":223,"position":917,"attributes":918},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[24],[214,444],{"id":920,"viewCount":57,"searchKey":921,"visible":15},"10003399",{"type":10,"entryId":922,"sortOrder":923,"name":924,"imageUrl":925,"description":926,"currentMorphology":21,"currentStage":234,"position":927,"attributes":928},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[24],[214,444],{"id":930,"viewCount":57,"searchKey":931,"visible":15},"10003518",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":21,"currentStage":223,"position":937,"attributes":938},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[24],[444],{"id":940,"viewCount":57,"searchKey":941,"visible":15},"10003393",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":21,"currentStage":234,"position":947,"attributes":948},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[24],[444],{"id":950,"viewCount":57,"searchKey":951,"visible":15},"10003386",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":21,"currentStage":22,"position":957,"attributes":958},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[277],[444],{"id":960,"viewCount":57,"searchKey":961,"visible":15},"10003447",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":21,"currentStage":234,"position":967,"attributes":968},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[277],[444],{"id":970,"viewCount":57,"searchKey":971,"visible":15},"10003497",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":21,"currentStage":22,"position":977,"attributes":978},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[277],[585],{"id":980,"viewCount":57,"searchKey":981,"visible":15},"10003479",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":21,"currentStage":223,"position":987,"attributes":988},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[277],[585],{"id":990,"viewCount":57,"searchKey":991,"visible":15},"10003388",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":21,"currentStage":234,"position":997,"attributes":998},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[277],[585],{"id":1000,"viewCount":57,"searchKey":1001,"visible":15},"10003429",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":21,"currentStage":22,"position":1007,"attributes":1008},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[372],[341],{"id":1010,"viewCount":57,"searchKey":1011,"visible":15},"10003430",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":21,"currentStage":234,"position":1017,"attributes":1018},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[372],[341],{"id":1020,"viewCount":57,"searchKey":1021,"visible":15},"10003549",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":21,"currentStage":197,"position":1027,"attributes":1028},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[372],[585],{"id":1030,"viewCount":57,"searchKey":1031,"visible":15},"10003494",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":21,"currentStage":22,"position":1037,"attributes":1038},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[372],[444,341],{"id":1040,"viewCount":57,"searchKey":1041,"visible":15},"10003486",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":21,"currentStage":234,"position":1047,"attributes":1048},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[372],[444,341],{"id":1050,"viewCount":57,"searchKey":1051,"visible":15},"10003530",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":21,"currentStage":22,"position":1057,"attributes":1058},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[24],[362],{"id":1060,"viewCount":57,"searchKey":1061,"visible":15},"10003457",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":21,"currentStage":234,"position":1067,"attributes":1068},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[24],[362],{"id":1070,"viewCount":57,"searchKey":1071,"visible":15},"10003423",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":21,"currentStage":22,"position":1077,"attributes":1078},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[339],[319,341],{"id":1080,"viewCount":57,"searchKey":1081,"visible":15},"10003419",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":21,"currentStage":234,"position":1087,"attributes":1088},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[339],[319,341],{"id":1090,"viewCount":57,"searchKey":1091,"visible":15},"10003410",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":21,"currentStage":22,"position":1097,"attributes":1098},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[212],[341],{"id":1100,"viewCount":57,"searchKey":1101,"visible":15},"10003509",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":21,"currentStage":234,"position":1107,"attributes":1108},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[212],[341],{"id":1110,"viewCount":57,"searchKey":1111,"visible":15},"10003413",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":21,"currentStage":22,"position":1117,"attributes":1118},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[212],[362],{"id":1120,"viewCount":57,"searchKey":1121,"visible":15},"10003407",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":21,"currentStage":234,"position":1127,"attributes":1128},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[212],[362],{"id":1130,"viewCount":57,"searchKey":1131,"visible":15},"10003498",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":21,"currentStage":197,"position":1137,"attributes":1138},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[212],[1139],"attributes-holy",{"id":1141,"viewCount":57,"searchKey":1142,"visible":15},"10003375",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":21,"currentStage":197,"position":1148,"attributes":1149},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[212],[1139],[1151,1158,1163,1168,1173,1178,1183,1188,1192,1197,1202,1207,1212,1216,1221,1226,1231,1236,1239],{"id":