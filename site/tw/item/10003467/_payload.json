dn/init/1018700_Feature_118701_Icon.png","勝利協奏","擁有護盾時，擊破效率提高40%。造成擊破時，吹響「協奏曲」，全隊體力消耗降低30%。當獲得3個樂章系列增益後，所有樂章效果提升30%。",{"attributes":149,"type":150,"consume":46,"power":46},[],[],{"id":152,"type":62,"props":153,"children":59},"91268497_25",{"title":154,"type":65,"id":155,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":156},"技能介紹","91268497_26",[157,220],{"id":158,"title":159,"children":160},"91268497_27","戰鬥技能",[161,175,188,198,208],{"id":162,"type":142,"props":163},"91268497_28",{"id":164,"customKey":46,"icon":165,"iconStyle":65,"iconTitle":46,"descTitle":166,"descContent":167,"source":168},"91268497_29","/cdn/init/1018700_Skill_10600600_Icon.png","飛葉龍捲","在目標位置施放飛葉氣旋，造成傷害並往中心吸入。",{"attributes":169,"type":171,"consume":173,"power":174},[170],"6",[172],"2","20","59",{"id":176,"type":142,"props":177},"91268497_30",{"id":178,"customKey":46,"icon":179,"iconStyle":65,"iconTitle":46,"descTitle":180,"descContent":181,"source":182},"91268497_31","/cdn/init/1018700_Skill_10900540_Icon.png","休止颶風","揮動翅膀，射出兩道弧線旋風，牽引目標沿著路徑移動，旋風交會時引發爆炸，造成範圍傷害。",{"attributes":183,"type":185,"consume":186,"power":187},[184],"9",[172],"15","48",{"id":189,"type":142,"props":190},"91268497_32",{"id":191,"customKey":46,"icon":192,"iconStyle":65,"iconTitle":46,"descTitle":193,"descContent":194,"source":195},"91268497_33","/cdn/init/1018700_Skill_10300220_Icon.png","流水龍捲","在目標處施放「流水氣旋」，造成傷害並吸附至中心。",{"attributes":196,"type":197,"consume":173,"power":174},[22],[172],{"id":199,"type":142,"props":200},"91268497_34",{"id":201,"customKey":46,"icon":202,"iconStyle":65,"iconTitle":46,"descTitle":203,"descContent":204,"source":205},"91268497_35","/cdn/init/1018700_Skill_10900041_Icon.png","龍捲風","在目標位置施放氣旋，造成傷害並往中心吸入。",{"attributes":206,"type":207,"consume":173,"power":174},[184],[172],{"id":209,"type":142,"props":210},"91268497_36",{"id":211,"customKey":46,"icon":212,"iconStyle":65,"iconTitle":46,"descTitle":213,"descContent":214,"source":215},"91268497_37","/cdn/init/1018700_Skill_10900161_Icon.png","化身成盾","進入防禦姿態，獲得20%減傷。防禦姿態結束後，獲得最大生命值10%的護盾，持續20秒。再次點擊技能可以提早結束。防禦姿態期間每受到一次傷害，護盾值會增加10%，最多增加100%。",{"attributes":216,"type":217,"consume":173,"power":219},[184],[218],"0","54",{"id":221,"title":222,"children":223},"91268497_38","固有技能",[224,234],{"id":225,"type":142,"props":226},"91268497_39",{"id":227,"customKey":46,"icon":228,"iconStyle":65,"iconTitle":46,"descTitle":229,"descContent":230,"source":231},"91268497_40","/cdn/init/1018700_Skill_10900170_Icon.png","偃旗息鼓","展開領域，在7秒內持續為範圍中的隊友提供35%傷害減免。",{"attributes":232,"type":233,"consume":218,"power":218},[184],[218],{"id":235,"type":142,"props":236},"91268497_41",{"id":237,"customKey":46,"icon":238,"iconStyle":65,"iconTitle":46,"descTitle":239,"descContent":240,"source":241},"91268497_42","/cdn/init/1018700_Skill_19700000_Icon.png","攻擊","擊破使用風元素能力，遠距離攻擊目標。",{"attributes":242,"type":243,"consume":218,"power":170},[184],[172],[245,246,247],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":248,"entryId":12,"currentMorphology":249,"visible":15},"10003448","Highland Form",[251,264,274,284,295,305,315,325,334,342,346,357,367,379,389,400,411,421,431,441,451,461,471,482,492,502,512,522,532,542,552,562,572,582,592,602,612,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,893,903,913,923,933,943,953,963,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1133,1143,1153,1163,1173,1184],{"id":252,"viewCount":59,"searchKey":253,"visible":15},"10003442",{"type":10,"entryId":254,"sortOrder":255,"name":256,"imageUrl":257,"description":258,"currentMorphology":21,"currentStage":259,"position":260,"attributes":262},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。","1",[261],"position-dps",[263],"attributes-fire",{"id":265,"viewCount":59,"searchKey":266,"visible":15},"10003534",{"type":10,"entryId":267,"sortOrder":268,"name":269,"imageUrl":270,"description":271,"currentMorphology":21,"currentStage":172,"position":272,"attributes":273},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[261],[263],{"id":275,"viewCount":59,"searchKey":276,"visible":15},"10003435",{"type":10,"entryId":277,"sortOrder":278,"name":279,"imageUrl":280,"description":281,"currentMorphology":21,"currentStage":22,"position":282,"attributes":283},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[261],[263],{"id":285,"viewCount":59,"searchKey":286,"visible":15},"10003428",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":21,"currentStage":22,"position":292,"attributes":293},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[24],[263,294],"attributes-dark",{"id":296,"viewCount":59,"searchKey":297,"visible":15},"10003578",{"type":10,"entryId":298,"sortOrder":299,"name":300,"imageUrl":301,"description":302,"currentMorphology":21,"currentStage":259,"position":303,"attributes":304},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[261],[294],{"id":306,"viewCount":59,"searchKey":307,"visible":15},"10003417",{"type":10,"entryId":308,"sortOrder":309,"name":310,"imageUrl":311,"description":312,"currentMorphology":21,"currentStage":22,"position":313,"attributes":314},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[261],[294],{"id":316,"viewCount":59,"searchKey":317,"visible":15},"10003488",{"type":10,"entryId":318,"sortOrder":319,"name":75,"imageUrl":320,"description":321,"currentMorphology":21,"currentStage":259,"position":322,"attributes":324},"007",1018100,"/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[323],"position-sup",[26],{"id":326,"viewCount":59,"searchKey":327,"visible":15},"10003548",{"type":10,"entryId":328,"sortOrder":329,"name":83,"imageUrl":330,"description":331,"currentMorphology":21,"currentStage":22,"position":332,"attributes":333},"008",1018400,"/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[323],[26],{"id":335,"viewCount":59,"searchKey":336,"visible":15},"10003474",{"type":10,"entryId":8,"sortOrder":337,"name":90,"imageUrl":338,"description":339,"currentMorphology":21,"currentStage":22,"position":340,"attributes":341},1018500,"/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[261],[26],{"id":4,"viewCount":59,"searchKey":343,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":344,"attributes":345},[24],[26],{"id":347,"viewCount":59,"searchKey":348,"visible":15},"10003392",{"type":10,"entryId":349,"sortOrder":350,"name":351,"imageUrl":352,"description":353,"currentMorphology":21,"currentStage":259,"position":354,"attributes":355},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[261],[356],"attributes-grass",{"id":358,"viewCount":59,"searchKey":359,"visible":15},"10003510",{"type":10,"entryId":360,"sortOrder":361,"name":362,"imageUrl":363,"description":364,"currentMorphology":21,"currentStage":22,"position":365,"attributes":366},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[261],[356],{"id":368,"viewCount":59,"searchKey":369,"visible":15},"10003477",{"type":10,"entryId":370,"sortOrder":371,"name":372,"imageUrl":373,"description":374,"currentMorphology":21,"currentStage":259,"position":375,"attributes":377},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[376],"position-heal",[378],"attributes-water",{"id":380,"viewCount":59,"searchKey":381,"visible":15},"10003569",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":21,"currentStage":172,"position":387,"attributes":388},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[376],[378],{"id":390,"viewCount":59,"searchKey":391,"visible":15},"10003470",{"type":10,"entryId":392,"sortOrder":393,"name":394,"imageUrl":395,"description":396,"currentMorphology":21,"currentStage":22,"position":397,"attributes":398},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[376],[378,399],"attributes-ice",{"id":401,"viewCount":59,"searchKey":402,"visible":15},"10003463",{"type":10,"entryId":403,"sortOrder":404,"name":405,"imageUrl":406,"description":407,"currentMorphology":21,"currentStage":22,"position":408,"attributes":410},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[409],"position-energy",[356,378],{"id":412,"viewCount":59,"searchKey":413,"visible":15},"10003468",{"type":10,"entryId":414,"sortOrder":415,"name":416,"imageUrl":417,"description":418,"currentMorphology":21,"currentStage":259,"position":419,"attributes":420},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[323],[26],{"id":422,"viewCount":59,"searchKey":423,"visible":15},"10003365",{"type":10,"entryId":424,"sortOrder":425,"name":426,"imageUrl":427,"description":428,"currentMorphology":21,"currentStage":22,"position":429,"attributes":430},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[323],[26],{"id":432,"viewCount":59,"searchKey":433,"visible":15},"10003461",{"type":10,"entryId":434,"sortOrder":435,"name":436,"imageUrl":437,"description":438,"currentMorphology":21,"currentStage":22,"position":439,"attributes":440},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[323],[294],{"id":442,"viewCount":59,"searchKey":443,"visible":15},"10003421",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":21,"currentStage":259,"position":449,"attributes":450},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[24],[356],{"id":452,"viewCount":59,"searchKey":453,"visible":15},"10003414",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":21,"currentStage":22,"position":459,"attributes":460},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[409],[294,356],{"id":462,"viewCount":59,"searchKey":463,"visible":15},"10003404",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":21,"currentStage":22,"position":469,"attributes":470},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[24],[356],{"id":472,"viewCount":59,"searchKey":473,"visible":15},"10003567",{"type":10,"entryId":474,"sortOrder":475,"name":476,"imageUrl":477,"description":478,"currentMorphology":21,"currentStage":259,"position":479,"attributes":480},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[24],[481,356],"attributes-rock",{"id":483,"viewCount":59,"searchKey":484,"visible":15},"10003462",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":21,"currentStage":22,"position":490,"attributes":491},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[24],[481,356],{"id":493,"viewCount":59,"searchKey":494,"visible":15},"10003551",{"type":10,"entryId":495,"sortOrder":496,"name":497,"imageUrl":498,"description":499,"currentMorphology":21,"currentStage":22,"position":500,"attributes":501},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[24],[399],{"id":503,"viewCount":59,"searchKey":504,"visible":15},"10003409",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":21,"currentStage":259,"position":510,"attributes":511},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[409],[263],{"id":513,"viewCount":59,"searchKey":514,"visible":15},"10003507",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":21,"currentStage":22,"position":520,"attributes":521},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[409],[263],{"id":523,"viewCount":59,"searchKey":524,"visible":15},"10003542",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":21,"currentStage":259,"position":530,"attributes":531},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[376],[26],{"id":533,"viewCount":59,"searchKey":534,"visible":15},"10003440",{"type":10,"entryId":535,"sortOrder":536,"name":537,"imageUrl":538,"description":539,"currentMorphology":21,"currentStage":22,"position":540,"attributes":541},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[376],[26],{"id":543,"viewCount":59,"searchKey":544,"visible":15},"10003563",{"type":10,"entryId":545,"sortOrder":546,"name":547,"imageUrl":548,"description":549,"currentMorphology":21,"currentStage":218,"position":550,"attributes":551},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[409],[26,356],{"id":553,"viewCount":59,"searchKey":554,"visible":15},"10003368",{"type":10,"entryId":555,"sortOrder":556,"name":557,"imageUrl":558,"description":559,"currentMorphology":21,"currentStage":259,"position":560,"attributes":561},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[323],[26],{"id":563,"viewCount":59,"searchKey":564,"visible":15},"10003363",{"type":10,"entryId":565,"sortOrder":566,"name":567,"imageUrl":568,"description":569,"currentMorphology":21,"currentStage":22,"position":570,"attributes":571},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[323],[26],{"id":573,"viewCount":59,"searchKey":574,"visible":15},"10003515",{"type":10,"entryId":575,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":21,"currentStage":259,"position":580,"attributes":581},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[261],[356],{"id":583,"viewCount":59,"searchKey":584,"visible":15},"10003496",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":21,"currentStage":22,"position":590,"attributes":591},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[261],[356],{"id":593,"viewCount":59,"searchKey":594,"visible":15},"10003378",{"type":10,"entryId":595,"sortOrder":596,"name":597,"imageUrl":598,"description":599,"currentMorphology":21,"currentStage":22,"position":600,"attributes":601},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[323],[356],{"id":603,"viewCount":59,"searchKey":604,"visible":15},"10003456",{"type":10,"entryId":605,"sortOrder":606,"name":607,"imageUrl":608,"description":609,"currentMorphology":21,"currentStage":259,"position":610,"attributes":611},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[24],[356],{"id":613,"viewCount":59,"searchKey":614,"visible":15},"10003374",{"type":10,"entryId":615,"sortOrder":616,"name":617,"imageUrl":618,"description":619,"currentMorphology":21,"currentStage":22,"position":620,"attributes":621},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[323],[622],"attributes-electric",{"id":624,"viewCount":59,"searchKey":625,"visible":15},"10003443",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":21,"currentStage":22,"position":631,"attributes":632},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[24],[356],{"id":634,"viewCount":59,"searchKey":635,"visible":15},"10003503",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":21,"currentStage":259,"position":641,"attributes":642},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[323],[294],{"id":644,"viewCount":59,"searchKey":645,"visible":15},"10003521",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":21,"currentStage":22,"position":651,"attributes":652},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[323],[294],{"id":654,"viewCount":59,"searchKey":655,"visible":15},"10003508",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":21,"currentStage":259,"position":661,"attributes":662},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[261],[294],{"id":664,"viewCount":59,"searchKey":665,"visible":15},"10003369",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":21,"currentStage":22,"position":671,"attributes":672},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[261],[294],{"id":674,"viewCount":59,"searchKey":675,"visible":15},"10003501",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":21,"currentStage":22,"position":681,"attributes":682},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[261],[622],{"id":684,"viewCount":59,"searchKey":685,"visible":15},"10003422",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":21,"currentStage":259,"position":691,"attributes":692},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[261],[399],{"id":694,"viewCount":59,"searchKey":695,"visible":15},"10003575",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":21,"currentStage":172,"position":701,"attributes":702},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[261],[399],{"id":704,"viewCount":59,"searchKey":705,"visible":15},"10003415",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":21,"currentStage":22,"position":711,"attributes":712},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[261],[399],{"id":714,"viewCount":59,"searchKey":715,"visible":15},"10003524",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":21,"currentStage":259,"position":721,"attributes":722},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[24],[622],{"id":724,"viewCount":59,"searchKey":725,"visible":15},"10003475",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":21,"currentStage":22,"position":731,"attributes":732},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[24],[622],{"id":734,"viewCount":59,"searchKey":735,"visible":15},"10003523",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":21,"currentStage":259,"position":741,"attributes":742},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[24],[378],{"id":744,"viewCount":59,"searchKey":745,"visible":15},"10003398",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":21,"currentStage":172,"position":751,"attributes":752},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[24],[378],{"id":754,"viewCount":59,"searchKey":755,"visible":15},"10003516",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":21,"currentStage":22,"position":761,"attributes":762},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[323],[378],{"id":764,"viewCount":59,"searchKey":765,"visible":15},"10003566",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":21,"currentStage":22,"position":771,"attributes":772},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[24],[378],{"id":774,"viewCount":59,"searchKey":775,"visible":15},"10003453",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":21,"currentStage":259,"position":781,"attributes":782},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[261],[378],{"id":784,"viewCount":59,"searchKey":785,"visible":15},"10003577",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":21,"currentStage":172,"position":791,"attributes":792},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[261],[378],{"id":794,"viewCount":59,"searchKey":795,"visible":15},"10003570",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":21,"currentStage":22,"position":801,"attributes":802},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[261],[378],{"id":804,"viewCount":59,"searchKey":805,"visible":15},"10003565",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":21,"currentStage":259,"position":811,"attributes":812},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[261],[481],{"id":814,"viewCount":59,"searchKey":815,"visible":15},"10003476",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":21,"currentStage":22,"position":821,"attributes":822},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[261],[481],{"id":824,"viewCount":59,"searchKey":825,"visible":15},"10003466",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":21,"currentStage":22,"position":831,"attributes":832},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[323],[481],{"id":834,"viewCount":59,"searchKey":835,"visible":15},"10003379",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":21,"currentStage":259,"position":841,"attributes":842},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[261],[622],{"id":844,"viewCount":59,"searchKey":845,"visible":15},"10003376",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":21,"currentStage":22,"position":851,"attributes":852},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[261],[622],{"id":854,"viewCount":59,"searchKey":855,"visible":15},"10003543",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":21,"currentStage":259,"position":861,"attributes":862},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[24],[294],{"id":864,"viewCount":59,"searchKey":865,"visible":15},"10003557",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":21,"currentStage":22,"position":871,"attributes":872},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[261],[294],{"id":874,"viewCount":59,"searchKey":875,"visible":15},"10003522",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":21,"currentStage":22,"position":881,"attributes":882},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[24],[294],{"id":884,"viewCount":59,"searchKey":885,"visible":15},"10003579",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":21,"currentStage":259,"position":891,"attributes":892},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[24],[26],{"id":894,"viewCount":59,"searchKey":895,"visible":15},"10003389",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":21,"currentStage":172,"position":901,"attributes":902},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[24],[26],{"id":904,"viewCount":59,"searchKey":905,"visible":15},"10003536",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":21,"currentStage":22,"position":911,"attributes":912},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[24],[26],{"id":914,"viewCount":59,"searchKey":915,"visible":15},"10003529",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":21,"currentStage":22,"position":921,"attributes":922},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[261],[263],{"id":924,"viewCount":59,"searchKey":925,"visible":15},"10003433",{"type":10,"entryId":926,"sortOrder":927,"name":928,"imageUrl":929,"description":930,"currentMorphology":21,"currentStage":259,"position":931,"attributes":932},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[261],[481],{"id":934,"viewCount":59,"searchKey":935,"visible":15},"10003427",{"type":10,"entryId":936,"sortOrder":937,"name":938,"imageUrl":939,"description":940,"currentMorphology":21,"currentStage":22,"position":941,"attributes":942},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[261],[481],{"id":944,"viewCount":59,"searchKey":945,"visible":15},"10003405",{"type":10,"entryId":946,"sortOrder":947,"name":948,"imageUrl":949,"description":950,"currentMorphology":21,"currentStage":259,"position":951,"attributes":952},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[24],[481],{"id":954,"viewCount":59,"searchKey":955,"visible":15},"10003525",{"type":10,"entryId":956,"sortOrder":957,"name":958,"imageUrl":959,"description":960,"currentMorphology":21,"currentStage":172,"position":961,"attributes":962},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[24],[263,481],{"id":964,"viewCount":59,"searchKey":965,"visible":15},"10003399",{"type":10,"entryId":966,"sortOrder":967,"name":968,"imageUrl":969,"description":970,"currentMorphology":21,"currentStage":22,"position":971,"attributes":972},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[24],[263,481],{"id":974,"viewCount":59,"searchKey":975,"visible":15},"10003518",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":21,"currentStage":172,"position":981,"attributes":982},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[24],[481],{"id":984,"viewCount":59,"searchKey":985,"visible":15},"10003393",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":21,"currentStage":22,"position":991,"attributes":992},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[24],[481],{"id":994,"viewCount":59,"searchKey":995,"visible":15},"10003386",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":21,"currentStage":259,"position":1001,"attributes":1002},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[323],[481],{"id":1004,"viewCount":59,"searchKey":1005,"visible":15},"10003447",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":21,"currentStage":22,"position":1011,"attributes":1012},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[323],[481],{"id":1014,"viewCount":59,"searchKey":1015,"visible":15},"10003497",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":21,"currentStage":259,"position":1021,"attributes":1022},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[323],[622],{"id":1024,"viewCount":59,"searchKey":1025,"visible":15},"10003479",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":21,"currentStage":172,"position":1031,"attributes":1032},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[323],[622],{"id":1034,"viewCount":59,"searchKey":1035,"visible":15},"10003388",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":21,"currentStage":22,"position":1041,"attributes":1042},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[323],[622],{"id":1044,"viewCount":59,"searchKey":1045,"visible":15},"10003429",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":21,"currentStage":259,"position":1051,"attributes":1052},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[409],[378],{"id":1054,"viewCount":59,"searchKey":1055,"visible":15},"10003430",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":21,"currentStage":22,"position":1061,"attributes":1062},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[409],[378],{"id":1064,"viewCount":59,"searchKey":1065,"visible":15},"10003549",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":21,"currentStage":218,"position":1071,"attributes":1072},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[409],[622],{"id":1074,"viewCount":59,"searchKey":1075,"visible":15},"10003494",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":21,"currentStage":259,"position":1081,"attributes":1082},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[409],[481,378],{"id":1084,"viewCount":59,"searchKey":1085,"visible":15},"10003486",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":21,"currentStage":22,"position":1091,"attributes":1092},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[409],[481,378],{"id":1094,"viewCount":59,"searchKey":1095,"visible":15},"10003530",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":21,"currentStage":259,"position":1101,"attributes":1102},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[24],[399],{"id":1104,"viewCount":59,"searchKey":1105,"visible":15},"10003457",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":21,"currentStage":22,"position":1111,"attributes":1112},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[24],[399],{"id":1114,"viewCount":59,"searchKey":1115,"visible":15},"10003423",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":21,"currentStage":259,"position":1121,"attributes":1122},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[376],[356,378],{"id":1124,"viewCount":59,"searchKey":1125,"visible":15},"10003419",{"type":10,"entryId":1126,"sortOrder":1127,"name":1128,"imageUrl":1129,"description":1130,"currentMorphology":21,"currentStage":22,"position":1131,"attributes":1132},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[376],[356,378],{"id":1134,"viewCount":59,"searchKey":1135,"visible":15},"10003410",{"type":10,"entryId":1136,"sortOrder":1137,"name":1138,"imageUrl":1139,"description":1140,"currentMorphology":21,"currentStage":259,"position":1141,"attributes":1142},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[261],[378],{"id":1144,"viewCount":59,"searchKey":1145,"visible":15},"10003509",{"type":10,"entryId":1146,"sortOrder":1147,"name":1148,"imageUrl":1149,"description":1150,"currentMorphology":21,"currentStage":22,"position":1151,"attributes":1152},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[261],[378],{"id":1154,"viewCount":59,"searchKey":1155,"visible":15},"10003413",{"type":10,"entryId":1156,"sortOrder":1157,"name":1158,"imageUrl":1159,"description":1160,"currentMorphology":21,"currentStage":259,"position":1161,"attributes":1162},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[261],[399],{"id":1164,"viewCount":59,"searchKey":1165,"visible":15},"10003407",{"type":10,"entryId":1166,"sortOrder":1167,"name":1168,"imageUrl":1169,"description":1170,"currentMorphology":21,"currentStage":22,"position":1171,"attributes":1172},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[261],[399],{"id":1174,"viewCount":59,"searchKey":1175,"visible":15},"10003498",{"type":10,"entryId":1176,"sortOrder":1177,"name":1178,"imageUrl":1179,"description":1180,"currentMorphology":21,"currentStage":218,"position":1181,"attributes":1182},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[261],[1183],"attributes-holy",{"id":1185,"viewCount":59,"searchKey":1186,"visible":15},"10003375",{"type":10,"entryId":1187,"sortOrder":1188,"name":1189,"imageUrl":1190,"description":1191,"currentMorphology":21,"currentStage":218,"position":1192,"attributes":1193},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[261],[1183],[1195,1203,1208,1213,1218,1223,1228,1233,1237,1241,1246,1250,1254,1259,1264,1269,1273,1278,1281],{"id":1196,"parentId":1197,"tagType":1198,"tagKey":1199,"name":1200,"language":1201,"sort":1202},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1204,"parentId":1197,"tagType":1198,"tagKey":1205,"name":1206,"language":1201,"sort":1207},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1209,"parentId":1197,"tagType":1198,"tagKey":1210,"name":1211,"language":1201,"sort":1212},"450da43bc6001e686491fef2c68f8615","