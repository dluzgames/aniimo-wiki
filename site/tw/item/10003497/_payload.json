2,282,293,303,313,323,334,344,356,366,377,388,398,408,418,428,438,448,459,469,479,489,499,509,519,529,539,549,559,569,579,589,599,609,619,629,639,649,659,669,679,689,699,709,719,729,739,749,759,769,779,789,799,809,819,829,839,849,859,869,879,889,899,909,919,929,939,949,959,969,979,987,991,998,1007,1017,1027,1037,1047,1057,1067,1077,1087,1097,1107,1117,1127,1137,1148],{"id":218,"viewCount":57,"searchKey":219,"visible":14},"10003442",{"type":10,"entryId":220,"sortOrder":221,"name":222,"imageUrl":223,"description":224,"currentMorphology":9,"currentStage":21,"position":225,"attributes":227},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[226],"position-dps",[228],"attributes-fire",{"id":230,"viewCount":57,"searchKey":231,"visible":14},"10003534",{"type":10,"entryId":232,"sortOrder":233,"name":234,"imageUrl":235,"description":236,"currentMorphology":9,"currentStage":184,"position":237,"attributes":238},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[226],[228],{"id":240,"viewCount":57,"searchKey":241,"visible":14},"10003435",{"type":10,"entryId":242,"sortOrder":243,"name":244,"imageUrl":245,"description":246,"currentMorphology":9,"currentStage":247,"position":248,"attributes":249},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[226],[228],{"id":251,"viewCount":57,"searchKey":252,"visible":14},"10003428",{"type":10,"entryId":253,"sortOrder":254,"name":255,"imageUrl":256,"description":257,"currentMorphology":9,"currentStage":247,"position":258,"attributes":260},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[259],"position-break",[228,261],"attributes-dark",{"id":263,"viewCount":57,"searchKey":264,"visible":14},"10003578",{"type":10,"entryId":265,"sortOrder":266,"name":267,"imageUrl":268,"description":269,"currentMorphology":9,"currentStage":21,"position":270,"attributes":271},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[226],[261],{"id":273,"viewCount":57,"searchKey":274,"visible":14},"10003417",{"type":10,"entryId":275,"sortOrder":276,"name":277,"imageUrl":278,"description":279,"currentMorphology":9,"currentStage":247,"position":280,"attributes":281},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[226],[261],{"id":283,"viewCount":57,"searchKey":284,"visible":14},"10003488",{"type":10,"entryId":285,"sortOrder":286,"name":287,"imageUrl":288,"description":289,"currentMorphology":9,"currentStage":21,"position":290,"attributes":291},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[23],[292],"attributes-wind",{"id":294,"viewCount":57,"searchKey":295,"visible":14},"10003548",{"type":10,"entryId":296,"sortOrder":297,"name":298,"imageUrl":299,"description":300,"currentMorphology":9,"currentStage":247,"position":301,"attributes":302},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[23],[292],{"id":304,"viewCount":57,"searchKey":305,"visible":14},"10003474",{"type":10,"entryId":306,"sortOrder":307,"name":308,"imageUrl":309,"description":310,"currentMorphology":9,"currentStage":247,"position":311,"attributes":312},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[226],[292],{"id":314,"viewCount":57,"searchKey":315,"visible":14},"10003467",{"type":10,"entryId":316,"sortOrder":317,"name":318,"imageUrl":319,"description":320,"currentMorphology":9,"currentStage":247,"position":321,"attributes":322},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[259],[292],{"id":324,"viewCount":57,"searchKey":325,"visible":14},"10003392",{"type":10,"entryId":326,"sortOrder":327,"name":328,"imageUrl":329,"description":330,"currentMorphology":9,"currentStage":21,"position":331,"attributes":332},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[226],[333],"attributes-grass",{"id":335,"viewCount":57,"searchKey":336,"visible":14},"10003510",{"type":10,"entryId":337,"sortOrder":338,"name":339,"imageUrl":340,"description":341,"currentMorphology":9,"currentStage":247,"position":342,"attributes":343},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[226],[333],{"id":345,"viewCount":57,"searchKey":346,"visible":14},"10003477",{"type":10,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":9,"currentStage":21,"position":352,"attributes":354},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[353],"position-heal",[355],"attributes-water",{"id":357,"viewCount":57,"searchKey":358,"visible":14},"10003569",{"type":10,"entryId":359,"sortOrder":360,"name":361,"imageUrl":362,"description":363,"currentMorphology":9,"currentStage":184,"position":364,"attributes":365},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[353],[355],{"id":367,"viewCount":57,"searchKey":368,"visible":14},"10003470",{"type":10,"entryId":369,"sortOrder":370,"name":371,"imageUrl":372,"description":373,"currentMorphology":9,"currentStage":247,"position":374,"attributes":375},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[353],[355,376],"attributes-ice",{"id":378,"viewCount":57,"searchKey":379,"visible":14},"10003463",{"type":10,"entryId":380,"sortOrder":381,"name":382,"imageUrl":383,"description":384,"currentMorphology":9,"currentStage":247,"position":385,"attributes":387},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[386],"position-energy",[333,355],{"id":389,"viewCount":57,"searchKey":390,"visible":14},"10003468",{"type":10,"entryId":391,"sortOrder":392,"name":393,"imageUrl":394,"description":395,"currentMorphology":9,"currentStage":21,"position":396,"attributes":397},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[23],[292],{"id":399,"viewCount":57,"searchKey":400,"visible":14},"10003365",{"type":10,"entryId":401,"sortOrder":402,"name":403,"imageUrl":404,"description":405,"currentMorphology":9,"currentStage":247,"position":406,"attributes":407},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[23],[292],{"id":409,"viewCount":57,"searchKey":410,"visible":14},"10003461",{"type":10,"entryId":411,"sortOrder":412,"name":413,"imageUrl":414,"description":415,"currentMorphology":9,"currentStage":247,"position":416,"attributes":417},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[23],[261],{"id":419,"viewCount":57,"searchKey":420,"visible":14},"10003421",{"type":10,"entryId":421,"sortOrder":422,"name":423,"imageUrl":424,"description":425,"currentMorphology":9,"currentStage":21,"position":426,"attributes":427},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[259],[333],{"id":429,"viewCount":57,"searchKey":430,"visible":14},"10003414",{"type":10,"entryId":431,"sortOrder":432,"name":433,"imageUrl":434,"description":435,"currentMorphology":9,"currentStage":247,"position":436,"attributes":437},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[386],[261,333],{"id":439,"viewCount":57,"searchKey":440,"visible":14},"10003404",{"type":10,"entryId":441,"sortOrder":442,"name":443,"imageUrl":444,"description":445,"currentMorphology":9,"currentStage":247,"position":446,"attributes":447},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[259],[333],{"id":449,"viewCount":57,"searchKey":450,"visible":14},"10003567",{"type":10,"entryId":451,"sortOrder":452,"name":453,"imageUrl":454,"description":455,"currentMorphology":9,"currentStage":21,"position":456,"attributes":457},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[259],[458,333],"attributes-rock",{"id":460,"viewCount":57,"searchKey":461,"visible":14},"10003462",{"type":10,"entryId":462,"sortOrder":463,"name":464,"imageUrl":465,"description":466,"currentMorphology":9,"currentStage":247,"position":467,"attributes":468},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[259],[458,333],{"id":470,"viewCount":57,"searchKey":471,"visible":14},"10003551",{"type":10,"entryId":472,"sortOrder":473,"name":474,"imageUrl":475,"description":476,"currentMorphology":9,"currentStage":247,"position":477,"attributes":478},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[259],[376],{"id":480,"viewCount":57,"searchKey":481,"visible":14},"10003409",{"type":10,"entryId":482,"sortOrder":483,"name":484,"imageUrl":485,"description":486,"currentMorphology":9,"currentStage":21,"position":487,"attributes":488},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[386],[228],{"id":490,"viewCount":57,"searchKey":491,"visible":14},"10003507",{"type":10,"entryId":492,"sortOrder":493,"name":494,"imageUrl":495,"description":496,"currentMorphology":9,"currentStage":247,"position":497,"attributes":498},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[386],[228],{"id":500,"viewCount":57,"searchKey":501,"visible":14},"10003542",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":9,"currentStage":21,"position":507,"attributes":508},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[353],[292],{"id":510,"viewCount":57,"searchKey":511,"visible":14},"10003440",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":9,"currentStage":247,"position":517,"attributes":518},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[353],[292],{"id":520,"viewCount":57,"searchKey":521,"visible":14},"10003563",{"type":10,"entryId":522,"sortOrder":523,"name":524,"imageUrl":525,"description":526,"currentMorphology":9,"currentStage":212,"position":527,"attributes":528},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[386],[292,333],{"id":530,"viewCount":57,"searchKey":531,"visible":14},"10003368",{"type":10,"entryId":532,"sortOrder":533,"name":534,"imageUrl":535,"description":536,"currentMorphology":9,"currentStage":21,"position":537,"attributes":538},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[23],[292],{"id":540,"viewCount":57,"searchKey":541,"visible":14},"10003363",{"type":10,"entryId":542,"sortOrder":543,"name":544,"imageUrl":545,"description":546,"currentMorphology":9,"currentStage":247,"position":547,"attributes":548},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[23],[292],{"id":550,"viewCount":57,"searchKey":551,"visible":14},"10003515",{"type":10,"entryId":552,"sortOrder":553,"name":554,"imageUrl":555,"description":556,"currentMorphology":9,"currentStage":21,"position":557,"attributes":558},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[226],[333],{"id":560,"viewCount":57,"searchKey":561,"visible":14},"10003496",{"type":10,"entryId":562,"sortOrder":563,"name":564,"imageUrl":565,"description":566,"currentMorphology":9,"currentStage":247,"position":567,"attributes":568},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[226],[333],{"id":570,"viewCount":57,"searchKey":571,"visible":14},"10003378",{"type":10,"entryId":572,"sortOrder":573,"name":574,"imageUrl":575,"description":576,"currentMorphology":9,"currentStage":247,"position":577,"attributes":578},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[23],[333],{"id":580,"viewCount":57,"searchKey":581,"visible":14},"10003456",{"type":10,"entryId":582,"sortOrder":583,"name":584,"imageUrl":585,"description":586,"currentMorphology":9,"currentStage":21,"position":587,"attributes":588},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[259],[333],{"id":590,"viewCount":57,"searchKey":591,"visible":14},"10003374",{"type":10,"entryId":592,"sortOrder":593,"name":594,"imageUrl":595,"description":596,"currentMorphology":9,"currentStage":247,"position":597,"attributes":598},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[23],[25],{"id":600,"viewCount":57,"searchKey":601,"visible":14},"10003443",{"type":10,"entryId":602,"sortOrder":603,"name":604,"imageUrl":605,"description":606,"currentMorphology":9,"currentStage":247,"position":607,"attributes":608},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[259],[333],{"id":610,"viewCount":57,"searchKey":611,"visible":14},"10003503",{"type":10,"entryId":612,"sortOrder":613,"name":614,"imageUrl":615,"description":616,"currentMorphology":9,"currentStage":21,"position":617,"attributes":618},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[23],[261],{"id":620,"viewCount":57,"searchKey":621,"visible":14},"10003521",{"type":10,"entryId":622,"sortOrder":623,"name":624,"imageUrl":625,"description":626,"currentMorphology":9,"currentStage":247,"position":627,"attributes":628},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[23],[261],{"id":630,"viewCount":57,"searchKey":631,"visible":14},"10003508",{"type":10,"entryId":632,"sortOrder":633,"name":634,"imageUrl":635,"description":636,"currentMorphology":9,"currentStage":21,"position":637,"attributes":638},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[226],[261],{"id":640,"viewCount":57,"searchKey":641,"visible":14},"10003369",{"type":10,"entryId":642,"sortOrder":643,"name":644,"imageUrl":645,"description":646,"currentMorphology":9,"currentStage":247,"position":647,"attributes":648},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[226],[261],{"id":650,"viewCount":57,"searchKey":651,"visible":14},"10003501",{"type":10,"entryId":652,"sortOrder":653,"name":654,"imageUrl":655,"description":656,"currentMorphology":9,"currentStage":247,"position":657,"attributes":658},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[226],[25],{"id":660,"viewCount":57,"searchKey":661,"visible":14},"10003422",{"type":10,"entryId":662,"sortOrder":663,"name":664,"imageUrl":665,"description":666,"currentMorphology":9,"currentStage":21,"position":667,"attributes":668},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[226],[376],{"id":670,"viewCount":57,"searchKey":671,"visible":14},"10003575",{"type":10,"entryId":672,"sortOrder":673,"name":674,"imageUrl":675,"description":676,"currentMorphology":9,"currentStage":184,"position":677,"attributes":678},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[226],[376],{"id":680,"viewCount":57,"searchKey":681,"visible":14},"10003415",{"type":10,"entryId":682,"sortOrder":683,"name":684,"imageUrl":685,"description":686,"currentMorphology":9,"currentStage":247,"position":687,"attributes":688},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[226],[376],{"id":690,"viewCount":57,"searchKey":691,"visible":14},"10003524",{"type":10,"entryId":692,"sortOrder":693,"name":694,"imageUrl":695,"description":696,"currentMorphology":9,"currentStage":21,"position":697,"attributes":698},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[259],[25],{"id":700,"viewCount":57,"searchKey":701,"visible":14},"10003475",{"type":10,"entryId":702,"sortOrder":703,"name":704,"imageUrl":705,"description":706,"currentMorphology":9,"currentStage":247,"position":707,"attributes":708},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[259],[25],{"id":710,"viewCount":57,"searchKey":711,"visible":14},"10003523",{"type":10,"entryId":712,"sortOrder":713,"name":714,"imageUrl":715,"description":716,"currentMorphology":9,"currentStage":21,"position":717,"attributes":718},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[259],[355],{"id":720,"viewCount":57,"searchKey":721,"visible":14},"10003398",{"type":10,"entryId":722,"sortOrder":723,"name":724,"imageUrl":725,"description":726,"currentMorphology":9,"currentStage":184,"position":727,"attributes":728},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[259],[355],{"id":730,"viewCount":57,"searchKey":731,"visible":14},"10003516",{"type":10,"entryId":732,"sortOrder":733,"name":734,"imageUrl":735,"description":736,"currentMorphology":9,"currentStage":247,"position":737,"attributes":738},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[23],[355],{"id":740,"viewCount":57,"searchKey":741,"visible":14},"10003566",{"type":10,"entryId":742,"sortOrder":743,"name":744,"imageUrl":745,"description":746,"currentMorphology":9,"currentStage":247,"position":747,"attributes":748},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[259],[355],{"id":750,"viewCount":57,"searchKey":751,"visible":14},"10003453",{"type":10,"entryId":752,"sortOrder":753,"name":754,"imageUrl":755,"description":756,"currentMorphology":9,"currentStage":21,"position":757,"attributes":758},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[226],[355],{"id":760,"viewCount":57,"searchKey":761,"visible":14},"10003577",{"type":10,"entryId":762,"sortOrder":763,"name":764,"imageUrl":765,"description":766,"currentMorphology":9,"currentStage":184,"position":767,"attributes":768},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[226],[355],{"id":770,"viewCount":57,"searchKey":771,"visible":14},"10003570",{"type":10,"entryId":772,"sortOrder":773,"name":774,"imageUrl":775,"description":776,"currentMorphology":9,"currentStage":247,"position":777,"attributes":778},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[226],[355],{"id":780,"viewCount":57,"searchKey":781,"visible":14},"10003565",{"type":10,"entryId":782,"sortOrder":783,"name":784,"imageUrl":785,"description":786,"currentMorphology":9,"currentStage":21,"position":787,"attributes":788},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[226],[458],{"id":790,"viewCount":57,"searchKey":791,"visible":14},"10003476",{"type":10,"entryId":792,"sortOrder":793,"name":794,"imageUrl":795,"description":796,"currentMorphology":9,"currentStage":247,"position":797,"attributes":798},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[226],[458],{"id":800,"viewCount":57,"searchKey":801,"visible":14},"10003466",{"type":10,"entryId":802,"sortOrder":803,"name":804,"imageUrl":805,"description":806,"currentMorphology":9,"currentStage":247,"position":807,"attributes":808},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[23],[458],{"id":810,"viewCount":57,"searchKey":811,"visible":14},"10003379",{"type":10,"entryId":812,"sortOrder":813,"name":814,"imageUrl":815,"description":816,"currentMorphology":9,"currentStage":21,"position":817,"attributes":818},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[226],[25],{"id":820,"viewCount":57,"searchKey":821,"visible":14},"10003376",{"type":10,"entryId":822,"sortOrder":823,"name":824,"imageUrl":825,"description":826,"currentMorphology":9,"currentStage":247,"position":827,"attributes":828},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[226],[25],{"id":830,"viewCount":57,"searchKey":831,"visible":14},"10003543",{"type":10,"entryId":832,"sortOrder":833,"name":834,"imageUrl":835,"description":836,"currentMorphology":9,"currentStage":21,"position":837,"attributes":838},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[259],[261],{"id":840,"viewCount":57,"searchKey":841,"visible":14},"10003557",{"type":10,"entryId":842,"sortOrder":843,"name":844,"imageUrl":845,"description":846,"currentMorphology":9,"currentStage":247,"position":847,"attributes":848},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[226],[261],{"id":850,"viewCount":57,"searchKey":851,"visible":14},"10003522",{"type":10,"entryId":852,"sortOrder":853,"name":854,"imageUrl":855,"description":856,"currentMorphology":9,"currentStage":247,"position":857,"attributes":858},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[259],[261],{"id":860,"viewCount":57,"searchKey":861,"visible":14},"10003579",{"type":10,"entryId":862,"sortOrder":863,"name":864,"imageUrl":865,"description":866,"currentMorphology":9,"currentStage":21,"position":867,"attributes":868},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[259],[292],{"id":870,"viewCount":57,"searchKey":871,"visible":14},"10003389",{"type":10,"entryId":872,"sortOrder":873,"name":874,"imageUrl":875,"description":876,"currentMorphology":9,"currentStage":184,"position":877,"attributes":878},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[259],[292],{"id":880,"viewCount":57,"searchKey":881,"visible":14},"10003536",{"type":10,"entryId":882,"sortOrder":883,"name":884,"imageUrl":885,"description":886,"currentMorphology":9,"currentStage":247,"position":887,"attributes":888},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[259],[292],{"id":890,"viewCount":57,"searchKey":891,"visible":14},"10003529",{"type":10,"entryId":892,"sortOrder":893,"name":894,"imageUrl":895,"description":896,"currentMorphology":9,"currentStage":247,"position":897,"attributes":898},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[226],[228],{"id":900,"viewCount":57,"searchKey":901,"visible":14},"10003433",{"type":10,"entryId":902,"sortOrder":903,"name":904,"imageUrl":905,"description":906,"currentMorphology":9,"currentStage":21,"position":907,"attributes":908},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[226],[458],{"id":910,"viewCount":57,"searchKey":911,"visible":14},"10003427",{"type":10,"entryId":912,"sortOrder":913,"name":914,"imageUrl":915,"description":916,"currentMorphology":9,"currentStage":247,"position":917,"attributes":918},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[226],[458],{"id":920,"viewCount":57,"searchKey":921,"visible":14},"10003405",{"type":10,"entryId":922,"sortOrder":923,"name":924,"imageUrl":925,"description":926,"currentMorphology":9,"currentStage":21,"position":927,"attributes":928},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[259],[458],{"id":930,"viewCount":57,"searchKey":931,"visible":14},"10003525",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":9,"currentStage":184,"position":937,"attributes":938},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[259],[228,458],{"id":940,"viewCount":57,"searchKey":941,"visible":14},"10003399",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":9,"currentStage":247,"position":947,"attributes":948},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[259],[228,458],{"id":950,"viewCount":57,"searchKey":951,"visible":14},"10003518",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":9,"currentStage":184,"position":957,"attributes":958},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[259],[458],{"id":960,"viewCount":57,"searchKey":961,"visible":14},"10003393",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":9,"currentStage":247,"position":967,"attributes":968},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[259],[458],{"id":970,"viewCount":57,"searchKey":971,"visible":14},"10003386",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":9,"currentStage":21,"position":977,"attributes":978},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[23],[458],{"id":5,"viewCount":57,"searchKey":980,"visible":14},{"type":10,"entryId":8,"sortOrder":981,"name":982,"imageUrl":983,"description":984,"currentMorphology":9,"currentStage":247,"position":985,"attributes":986},1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[23],[458],{"id":4,"viewCount":57,"searchKey":988,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":989,"attributes":990},[23],[25],{"id":6,"viewCount":57,"searchKey":992,"visible":14},{"type":10,"entryId":12,"sortOrder":993,"name":79,"imageUrl":994,"description":995,"currentMorphology":9,"currentStage":184,"position":996,"attributes":997},1014200,"/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[23],[25],{"id":999,"viewCount":57,"searchKey":1000,"visible":14},"10003388",{"type":10,"entryId":1001,"sortOrder":1002,"name":87,"imageUrl":1003,"description":1004,"currentMorphology":9,"currentStage":247,"position":1005,"attributes":1006},"080",1014300,"/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[23],[25],{"id":1008,"viewCount":57,"searchKey":1009,"visible":14},"10003429",{"type":10,"entryId":1010,"sortOrder":1011,"name":1012,"imageUrl":1013,"description":1014,"currentMorphology":9,"currentStage":21,"position":1015,"attributes":1016},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[386],[355],{"id":1018,"viewCount":57,"searchKey":1019,"visible":14},"10003430",{"type":10,"entryId":1020,"sortOrder":1021,"name":1022,"imageUrl":1023,"description":1024,"currentMorphology":9,"currentStage":247,"position":1025,"attributes":1026},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[386],[355],{"id":1028,"viewCount":57,"searchKey":1029,"visible":14},"10003549",{"type":10,"entryId":1030,"sortOrder":1031,"name":1032,"imageUrl":1033,"description":1034,"currentMorphology":9,"currentStage":212,"position":1035,"attributes":1036},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[386],[25],{"id":1038,"viewCount":57,"searchKey":1039,"visible":14},"10003494",{"type":10,"entryId":1040,"sortOrder":1041,"name":1042,"imageUrl":1043,"description":1044,"currentMorphology":9,"currentStage":21,"position":1045,"attributes":1046},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[386],[458,355],{"id":1048,"viewCount":57,"searchKey":1049,"visible":14},"10003486",{"type":10,"entryId":1050,"sortOrder":1051,"name":1052,"imageUrl":1053,"description":1054,"currentMorphology":9,"currentStage":247,"position":1055,"attributes":1056},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[386],[458,355],{"id":1058,"viewCount":57,"searchKey":1059,"visible":14},"10003530",{"type":10,"entryId":1060,"sortOrder":1061,"name":1062,"imageUrl":1063,"description":1064,"currentMorphology":9,"currentStage":21,"position":1065,"attributes":1066},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[259],[376],{"id":1068,"viewCount":57,"searchKey":1069,"visible":14},"10003457",{"type":10,"entryId":1070,"sortOrder":1071,"name":1072,"imageUrl":1073,"description":1074,"currentMorphology":9,"currentStage":247,"position":1075,"attributes":1076},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[259],[376],{"id":1078,"viewCount":57,"searchKey":1079,"visible":14},"10003423",{"type":10,"entryId":1080,"sortOrder":1081,"name":1082,"imageUrl":1083,"description":1084,"currentMorphology":9,"currentStage":21,"position":1085,"attributes":1086},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[353],[333,355],{"id":1088,"viewCount":57,"searchKey":1089,"visible":14},"10003419",{"type":10,"entryId":1090,"sortOrder":1091,"name":1092,"imageUrl":1093,"description":1094,"currentMorphology":9,"currentStage":247,"position":1095,"attributes":1096},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[353],[333,355],{"id":1098,"viewCount":57,"searchKey":1099,"visible":14},"10003410",{"type":10,"entryId":1100,"sortOrder":1101,"name":1102,"imageUrl":1103,"description":1104,"currentMorphology":9,"currentStage":21,"position":1105,"attributes":1106},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[226],[355],{"id":1108,"viewCount":57,"searchKey":1109,"visible":14},"10003509",{"type":10,"entryId":1110,"sortOrder":1111,"name":1112,"imageUrl":1113,"description":1114,"currentMorphology":9,"currentStage":247,"position":1115,"attributes":1116},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[226],[355],{"id":1118,"viewCount":57,"searchKey":1119,"visible":14},"10003413",{"type":10,"entryId":1120,"sortOrder":1121,"name":1122,"imageUrl":1123,"description":1124,"currentMorphology":9,"currentStage":21,"position":1125,"attributes":1126},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[226],[376],{"id":1128,"viewCount":57,"searchKey":1129,"visible":14},"10003407",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":9,"currentStage":247,"position":1135,"attributes":1136},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[226],[376],{"id":1138,"viewCount":57,"searchKey":1139,"visible":14},"10003498",{"type":10,"entryId":1140,"sortOrder":1141,"name":1142,"imageUrl":1143,"description":1144,"currentMorphology":9,"currentStage":212,"position":1145,"attributes":1146},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[226],[1147],"attributes-holy",{"id":1149,"viewCount":57,"searchKey":1150,"visible":14},"10003375",{"type":10,"entryId":1151,"sortOrder":1152,"name":1153,"imageUrl":1154,"description":1155,"currentMorphol