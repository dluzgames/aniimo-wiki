[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"header-aniimo-list-tw":3,"aniimo-detail-10003442-tw":966,"morphology-tags-tw":1201},[4,21,32,43,55,65,75,87,97,107,117,128,138,150,160,171,182,192,202,212,222,232,242,253,263,273,283,293,303,313,324,334,344,354,364,374,384,395,405,415,425,435,445,455,465,475,485,495,505,515,525,535,545,555,565,575,585,595,605,615,625,635,645,655,665,675,685,695,705,715,725,735,745,755,765,775,785,795,805,815,825,835,845,855,865,875,885,895,905,915,925,935,945,956],{"id":5,"viewCount":6,"searchKey":7,"visible":20},"10003442",null,{"type":8,"entryId":9,"sortOrder":10,"name":11,"imageUrl":12,"description":13,"currentMorphology":14,"currentStage":15,"position":16,"attributes":18},"ANIIMO","001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。","Basic Form","1",[17],"position-dps",[19],"attributes-fire",true,{"id":22,"viewCount":6,"searchKey":23,"visible":20},"10003534",{"type":8,"entryId":24,"sortOrder":25,"name":26,"imageUrl":27,"description":28,"currentMorphology":14,"currentStage":29,"position":30,"attributes":31},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[17],[19],{"id":33,"viewCount":6,"searchKey":34,"visible":20},"10003435",{"type":8,"entryId":35,"sortOrder":36,"name":37,"imageUrl":38,"description":39,"currentMorphology":14,"currentStage":40,"position":41,"attributes":42},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[17],[19],{"id":44,"viewCount":6,"searchKey":45,"visible":20},"10003428",{"type":8,"entryId":46,"sortOrder":47,"name":48,"imageUrl":49,"description":50,"currentMorphology":14,"currentStage":40,"position":51,"attributes":53},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[52],"position-break",[19,54],"attributes-dark",{"id":56,"viewCount":6,"searchKey":57,"visible":20},"10003578",{"type":8,"entryId":58,"sortOrder":59,"name":60,"imageUrl":61,"description":62,"currentMorphology":14,"currentStage":15,"position":63,"attributes":64},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[17],[54],{"id":66,"viewCount":6,"searchKey":67,"visible":20},"10003417",{"type":8,"entryId":68,"sortOrder":69,"name":70,"imageUrl":71,"description":72,"currentMorphology":14,"currentStage":40,"position":73,"attributes":74},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[17],[54],{"id":76,"viewCount":6,"searchKey":77,"visible":20},"10003488",{"type":8,"entryId":78,"sortOrder":79,"name":80,"imageUrl":81,"description":82,"currentMorphology":14,"currentStage":15,"position":83,"attributes":85},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[84],"position-sup",[86],"attributes-wind",{"id":88,"viewCount":6,"searchKey":89,"visible":20},"10003548",{"type":8,"entryId":90,"sortOrder":91,"name":92,"imageUrl":93,"description":94,"currentMorphology":14,"currentStage":40,"position":95,"attributes":96},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[84],[86],{"id":98,"viewCount":6,"searchKey":99,"visible":20},"10003474",{"type":8,"entryId":100,"sortOrder":101,"name":102,"imageUrl":103,"description":104,"currentMorphology":14,"currentStage":40,"position":105,"attributes":106},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[17],[86],{"id":108,"viewCount":6,"searchKey":109,"visible":20},"10003467",{"type":8,"entryId":110,"sortOrder":111,"name":112,"imageUrl":113,"description":114,"currentMorphology":14,"currentStage":40,"position":115,"attributes":116},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[52],[86],{"id":118,"viewCount":6,"searchKey":119,"visible":20},"10003392",{"type":8,"entryId":120,"sortOrder":121,"name":122,"imageUrl":123,"description":124,"currentMorphology":14,"currentStage":15,"position":125,"attributes":126},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[17],[127],"attributes-grass",{"id":129,"viewCount":6,"searchKey":130,"visible":20},"10003510",{"type":8,"entryId":131,"sortOrder":132,"name":133,"imageUrl":134,"description":135,"currentMorphology":14,"currentStage":40,"position":136,"attributes":137},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[17],[127],{"id":139,"viewCount":6,"searchKey":140,"visible":20},"10003477",{"type":8,"entryId":141,"sortOrder":142,"name":143,"imageUrl":144,"description":145,"currentMorphology":14,"currentStage":15,"position":146,"attributes":148},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[147],"position-heal",[149],"attributes-water",{"id":151,"viewCount":6,"searchKey":152,"visible":20},"10003569",{"type":8,"entryId":153,"sortOrder":154,"name":155,"imageUrl":156,"description":157,"currentMorphology":14,"currentStage":29,"position":158,"attributes":159},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[147],[149],{"id":161,"viewCount":6,"searchKey":162,"visible":20},"10003470",{"type":8,"entryId":163,"sortOrder":164,"name":165,"imageUrl":166,"description":167,"currentMorphology":14,"currentStage":40,"position":168,"attributes":169},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[147],[149,170],"attributes-ice",{"id":172,"viewCount":6,"searchKey":173,"visible":20},"10003463",{"type":8,"entryId":174,"sortOrder":175,"name":176,"imageUrl":177,"description":178,"currentMorphology":14,"currentStage":40,"position":179,"attributes":181},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[180],"position-energy",[127,149],{"id":183,"viewCount":6,"searchKey":184,"visible":20},"10003468",{"type":8,"entryId":185,"sortOrder":186,"name":187,"imageUrl":188,"description":189,"currentMorphology":14,"currentStage":15,"position":190,"attributes":191},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[84],[86],{"id":193,"viewCount":6,"searchKey":194,"visible":20},"10003365",{"type":8,"entryId":195,"sortOrder":196,"name":197,"imageUrl":198,"description":199,"currentMorphology":14,"currentStage":40,"position":200,"attributes":201},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[84],[86],{"id":203,"viewCount":6,"searchKey":204,"visible":20},"10003461",{"type":8,"entryId":205,"sortOrder":206,"name":207,"imageUrl":208,"description":209,"currentMorphology":14,"currentStage":40,"position":210,"attributes":211},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[84],[54],{"id":213,"viewCount":6,"searchKey":214,"visible":20},"10003421",{"type":8,"entryId":215,"sortOrder":216,"name":217,"imageUrl":218,"description":219,"currentMorphology":14,"currentStage":15,"position":220,"attributes":221},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[52],[127],{"id":223,"viewCount":6,"searchKey":224,"visible":20},"10003414",{"type":8,"entryId":225,"sortOrder":226,"name":227,"imageUrl":228,"description":229,"currentMorphology":14,"currentStage":40,"position":230,"attributes":231},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[180],[54,127],{"id":233,"viewCount":6,"searchKey":234,"visible":20},"10003404",{"type":8,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":14,"currentStage":40,"position":240,"attributes":241},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[52],[127],{"id":243,"viewCount":6,"searchKey":244,"visible":20},"10003567",{"type":8,"entryId":245,"sortOrder":246,"name":247,"imageUrl":248,"description":249,"currentMorphology":14,"currentStage":15,"position":250,"attributes":251},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[52],[252,127],"attributes-rock",{"id":254,"viewCount":6,"searchKey":255,"visible":20},"10003462",{"type":8,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":14,"currentStage":40,"position":261,"attributes":262},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[52],[252,127],{"id":264,"viewCount":6,"searchKey":265,"visible":20},"10003551",{"type":8,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":14,"currentStage":40,"position":271,"attributes":272},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[52],[170],{"id":274,"viewCount":6,"searchKey":275,"visible":20},"10003409",{"type":8,"entryId":276,"sortOrder":277,"name":278,"imageUrl":279,"description":280,"currentMorphology":14,"currentStage":15,"position":281,"attributes":282},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[180],[19],{"id":284,"viewCount":6,"searchKey":285,"visible":20},"10003507",{"type":8,"entryId":286,"sortOrder":287,"name":288,"imageUrl":289,"description":290,"currentMorphology":14,"currentStage":40,"position":291,"attributes":292},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[180],[19],{"id":294,"viewCount":6,"searchKey":295,"visible":20},"10003542",{"type":8,"entryId":296,"sortOrder":297,"name":298,"imageUrl":299,"description":300,"currentMorphology":14,"currentStage":15,"position":301,"attributes":302},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[147],[86],{"id":304,"viewCount":6,"searchKey":305,"visible":20},"10003440",{"type":8,"entryId":306,"sortOrder":307,"name":308,"imageUrl":309,"description":310,"currentMorphology":14,"currentStage":40,"position":311,"attributes":312},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[147],[86],{"id":314,"viewCount":6,"searchKey":315,"visible":20},"10003563",{"type":8,"entryId":316,"sortOrder":317,"name":318,"imageUrl":319,"description":320,"currentMorphology":14,"currentStage":321,"position":322,"attributes":323},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。","0",[180],[86,127],{"id":325,"viewCount":6,"searchKey":326,"visible":20},"10003368",{"type":8,"entryId":327,"sortOrder":328,"name":329,"imageUrl":330,"description":331,"currentMorphology":14,"currentStage":15,"position":332,"attributes":333},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[84],[86],{"id":335,"viewCount":6,"searchKey":336,"visible":20},"10003363",{"type":8,"entryId":337,"sortOrder":338,"name":339,"imageUrl":340,"description":341,"currentMorphology":14,"currentStage":40,"position":342,"attributes":343},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[84],[86],{"id":345,"viewCount":6,"searchKey":346,"visible":20},"10003515",{"type":8,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":14,"currentStage":15,"position":352,"attributes":353},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[17],[127],{"id":355,"viewCount":6,"searchKey":356,"visible":20},"10003496",{"type":8,"entryId":357,"sortOrder":358,"name":359,"imageUrl":360,"description":361,"currentMorphology":14,"currentStage":40,"position":362,"attributes":363},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[17],[127],{"id":365,"viewCount":6,"searchKey":366,"visible":20},"10003378",{"type":8,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":14,"currentStage":40,"position":372,"attributes":373},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[84],[127],{"id":375,"viewCount":6,"searchKey":376,"visible":20},"10003456",{"type":8,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":14,"currentStage":15,"position":382,"attributes":383},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[52],[127],{"id":385,"viewCount":6,"searchKey":386,"visible":20},"10003374",{"type":8,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":14,"currentStage":40,"position":392,"attributes":393},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[84],[394],"attributes-electric",{"id":396,"viewCount":6,"searchKey":397,"visible":20},"10003443",{"type":8,"entryId":398,"sortOrder":399,"name":400,"imageUrl":401,"description":402,"currentMorphology":14,"currentStage":40,"position":403,"attributes":404},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[52],[127],{"id":406,"viewCount":6,"searchKey":407,"visible":20},"10003503",{"type":8,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":14,"currentStage":15,"position":413,"attributes":414},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[84],[54],{"id":416,"viewCount":6,"searchKey":417,"visible":20},"10003521",{"type":8,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":14,"currentStage":40,"position":423,"attributes":424},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[84],[54],{"id":426,"viewCount":6,"searchKey":427,"visible":20},"10003508",{"type":8,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":14,"currentStage":15,"position":433,"attributes":434},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[17],[54],{"id":436,"viewCount":6,"searchKey":437,"visible":20},"10003369",{"type":8,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":14,"currentStage":40,"position":443,"attributes":444},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[17],[54],{"id":446,"viewCount":6,"searchKey":447,"visible":20},"10003501",{"type":8,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":14,"currentStage":40,"position":453,"attributes":454},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[17],[394],{"id":456,"viewCount":6,"searchKey":457,"visible":20},"10003422",{"type":8,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":14,"currentStage":15,"position":463,"attributes":464},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[17],[170],{"id":466,"viewCount":6,"searchKey":467,"visible":20},"10003575",{"type":8,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":14,"currentStage":29,"position":473,"attributes":474},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[17],[170],{"id":476,"viewCount":6,"searchKey":477,"visible":20},"10003415",{"type":8,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":14,"currentStage":40,"position":483,"attributes":484},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[17],[170],{"id":486,"viewCount":6,"searchKey":487,"visible":20},"10003524",{"type":8,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":14,"currentStage":15,"position":493,"attributes":494},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[52],[394],{"id":496,"viewCount":6,"searchKey":497,"visible":20},"10003475",{"type":8,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":14,"currentStage":40,"position":503,"attributes":504},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[52],[394],{"id":506,"viewCount":6,"searchKey":507,"visible":20},"10003523",{"type":8,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":14,"currentStage":15,"position":513,"attributes":514},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[52],[149],{"id":516,"viewCount":6,"searchKey":517,"visible":20},"10003398",{"type":8,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":14,"currentStage":29,"position":523,"attributes":524},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[52],[149],{"id":526,"viewCount":6,"searchKey":527,"visible":20},"10003516",{"type":8,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":14,"currentStage":40,"position":533,"attributes":534},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[84],[149],{"id":536,"viewCount":6,"searchKey":537,"visible":20},"10003566",{"type":8,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":14,"currentStage":40,"position":543,"attributes":544},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[52],[149],{"id":546,"viewCount":6,"searchKey":547,"visible":20},"10003453",{"type":8,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":14,"currentStage":15,"position":553,"attributes":554},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[17],[149],{"id":556,"viewCount":6,"searchKey":557,"visible":20},"10003577",{"type":8,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":14,"currentStage":29,"position":563,"attributes":564},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[17],[149],{"id":566,"viewCount":6,"searchKey":567,"visible":20},"10003570",{"type":8,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":14,"currentStage":40,"position":573,"attributes":574},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[17],[149],{"id":576,"viewCount":6,"searchKey":577,"visible":20},"10003565",{"type":8,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":14,"currentStage":15,"position":583,"attributes":584},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[17],[252],{"id":586,"viewCount":6,"searchKey":587,"visible":20},"10003476",{"type":8,"entryId":588,"sortOrder":589,"name":590,"imageUrl":591,"description":592,"currentMorphology":14,"currentStage":40,"position":593,"attributes":594},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[17],[252],{"id":596,"viewCount":6,"searchKey":597,"visible":20},"10003466",{"type":8,"entryId":598,"sortOrder":599,"name":600,"imageUrl":601,"description":602,"currentMorphology":14,"currentStage":40,"position":603,"attributes":604},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[84],[252],{"id":606,"viewCount":6,"searchKey":607,"visible":20},"10003379",{"type":8,"entryId":608,"sortOrder":609,"name":610,"imageUrl":611,"description":612,"currentMorphology":14,"currentStage":15,"position":613,"attributes":614},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[17],[394],{"id":616,"viewCount":6,"searchKey":617,"visible":20},"10003376",{"type":8,"entryId":618,"sortOrder":619,"name":620,"imageUrl":621,"description":622,"currentMorphology":14,"currentStage":40,"position":623,"attributes":624},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[17],[394],{"id":626,"viewCount":6,"searchKey":627,"visible":20},"10003543",{"type":8,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":14,"currentStage":15,"position":633,"attributes":634},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[52],[54],{"id":636,"viewCount":6,"searchKey":637,"visible":20},"10003557",{"type":8,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":14,"currentStage":40,"position":643,"attributes":644},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[17],[54],{"id":646,"viewCount":6,"searchKey":647,"visible":20},"10003522",{"type":8,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":14,"currentStage":40,"position":653,"attributes":654},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[52],[54],{"id":656,"viewCount":6,"searchKey":657,"visible":20},"10003579",{"type":8,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":14,"currentStage":15,"position":663,"attributes":664},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[52],[86],{"id":666,"viewCount":6,"searchKey":667,"visible":20},"10003389",{"type":8,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":14,"currentStage":29,"position":673,"attributes":674},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[52],[86],{"id":676,"viewCount":6,"searchKey":677,"visible":20},"10003536",{"type":8,"entryId":678,"sortOrder":679,"name":680,"imageUrl":681,"description":682,"currentMorphology":14,"currentStage":40,"position":683,"attributes":684},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[52],[86],{"id":686,"viewCount":6,"searchKey":687,"visible":20},"10003529",{"type":8,"entryId":688,"sortOrder":689,"name":690,"imageUrl":691,"description":692,"currentMorphology":14,"currentStage":40,"position":693,"attributes":694},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[17],[19],{"id":696,"viewCount":6,"searchKey":697,"visible":20},"10003433",{"type":8,"entryId":698,"sortOrder":699,"name":700,"imageUrl":701,"description":702,"currentMorphology":14,"currentStage":15,"position":703,"attributes":704},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[17],[252],{"id":706,"viewCount":6,"searchKey":707,"visible":20},"10003427",{"type":8,"entryId":708,"sortOrder":709,"name":710,"imageUrl":711,"description":712,"currentMorphology":14,"currentStage":40,"position":713,"attributes":714},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[17],[252],{"id":716,"viewCount":6,"searchKey":717,"visible":20},"10003405",{"type":8,"entryId":718,"sortOrder":719,"name":720,"imageUrl":721,"description":722,"currentMorphology":14,"currentStage":15,"position":723,"attributes":724},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[52],[252],{"id":726,"viewCount":6,"searchKey":727,"visible":20},"10003525",{"type":8,"entryId":728,"sortOrder":729,"name":730,"imageUrl":731,"description":732,"currentMorphology":14,"currentStage":29,"position":733,"attributes":734},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[52],[19,252],{"id":736,"viewCount":6,"searchKey":737,"visible":20},"10003399",{"type":8,"entryId":738,"sortOrder":739,"name":740,"imageUrl":741,"description":742,"currentMorphology":14,"currentStage":40,"position":743,"attributes":744},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[52],[19,252],{"id":746,"viewCount":6,"searchKey":747,"visible":20},"10003518",{"type":8,"entryId":748,"sortOrder":749,"name":750,"imageUrl":751,"description":752,"currentMorphology":14,"currentStage":29,"position":753,"attributes":754},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[52],[252],{"id":756,"viewCount":6,"searchKey":757,"visible":20},"10003393",{"type":8,"entryId":758,"sortOrder":759,"name":760,"imageUrl":761,"description":762,"currentMorphology":14,"currentStage":40,"position":763,"attributes":764},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[52],[252],{"id":766,"viewCount":6,"searchKey":767,"visible":20},"10003386",{"type":8,"entryId":768,"sortOrder":769,"name":770,"imageUrl":771,"description":772,"currentMorphology":14,"currentStage":15,"position":773,"attributes":774},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[84],[252],{"id":776,"viewCount":6,"searchKey":777,"visible":20},"10003447",{"type":8,"entryId":778,"sortOrder":779,"name":780,"imageUrl":781,"description":782,"currentMorphology":14,"currentStage":40,"position":783,"attributes":784},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[84],[252],{"id":786,"viewCount":6,"searchKey":787,"visible":20},"10003497",{"type":8,"entryId":788,"sortOrder":789,"name":790,"imageUrl":791,"description":792,"currentMorphology":14,"currentStage":15,"position":793,"attributes":794},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[84],[394],{"id":796,"viewCount":6,"searchKey":797,"visible":20},"10003479",{"type":8,"entryId":798,"sortOrder":799,"name":800,"imageUrl":801,"description":802,"currentMorphology":14,"currentStage":29,"position":803,"attributes":804},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[84],[394],{"id":806,"viewCount":6,"searchKey":807,"visible":20},"10003388",{"type":8,"entryId":808,"sortOrder":809,"name":810,"imageUrl":811,"description":812,"currentMorphology":14,"currentStage":40,"position":813,"attributes":814},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[84],[394],{"id":816,"viewCount":6,"searchKey":817,"visible":20},"10003429",{"type":8,"entryId":818,"sortOrder":819,"name":820,"imageUrl":821,"description":822,"currentMorphology":14,"currentStage":15,"position":823,"attributes":824},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[180],[149],{"id":826,"viewCount":6,"searchKey":827,"visible":20},"10003430",{"type":8,"entryId":828,"sortOrder":829,"name":830,"imageUrl":831,"description":832,"currentMorphology":14,"currentStage":40,"position":833,"attributes":834},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[180],[149],{"id":836,"viewCount":6,"searchKey":837,"visible":20},"10003549",{"type":8,"entryId":838,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":14,"currentStage":321,"position":843,"attributes":844},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[180],[394],{"id":846,"viewCount":6,"searchKey":847,"visible":20},"10003494",{"type":8,"entryId":848,"sortOrder":849,"name":850,"imageUrl":851,"description":852,"currentMorphology":14,"currentStage":15,"position":853,"attributes":854},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[180],[252,149],{"id":856,"viewCount":6,"searchKey":857,"visible":20},"10003486",{"type":8,"entryId":858,"sortOrder":859,"name":860,"imageUrl":861,"description":862,"currentMorphology":14,"currentStage":40,"position":863,"attributes":864},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[180],[252,149],{"id":866,"viewCount":6,"searchKey":867,"visible":20},"10003530",{"type":8,"entryId":868,"sortOrder":869,"name":870,"imageUrl":871,"description":872,"currentMorphology":14,"currentStage":15,"position":873,"attributes":874},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[52],[170],{"id":876,"viewCount":6,"searchKey":877,"visible":20},"10003457",{"type":8,"entryId":878,"sortOrder":879,"name":880,"imageUrl":881,"description":882,"currentMorphology":14,"currentStage":40,"position":883,"attributes":884},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[52],[170],{"id":886,"viewCount":6,"searchKey":887,"visible":20},"10003423",{"type":8,"entryId":888,"sortOrder":889,"name":890,"imageUrl":891,"description":892,"currentMorphology":14,"currentStage":15,"position":893,"attributes":894},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[147],[127,149],{"id":896,"viewCount":6,"searchKey":897,"visible":20},"10003419",{"type":8,"entryId":898,"sortOrder":899,"name":900,"imageUrl":901,"description":902,"currentMorphology":14,"currentStage":40,"position":903,"attributes":904},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[147],[127,149],{"id":906,"viewCount":6,"searchKey":907,"visible":20},"10003410",{"type":8,"entryId":908,"sortOrder":909,"name":910,"imageUrl":911,"description":912,"currentMorphology":14,"currentStage":15,"position":913,"attributes":914},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[17],[149],{"id":916,"viewCount":6,"searchKey":917,"visible":20},"10003509",{"type":8,"entryId":918,"sortOrder":919,"name":920,"imageUrl":921,"description":922,"currentMorphology":14,"currentStage":40,"position":923,"attributes":924},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[17],[149],{"id":926,"viewCount":6,"searchKey":927,"visible":20},"10003413",{"type":8,"entryId":928,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":14,"currentStage":15,"position":933,"attributes":934},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[17],[170],{"id":936,"viewCount":6,"searchKey":937,"visible":20},"10003407",{"type":8,"entryId":938,"sortOrder":939,"name":940,"imageUrl":941,"description":942,"currentMorphology":14,"currentStage":40,"position":943,"attributes":944},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[17],[170],{"id":946,"viewCount":6,"searchKey":947,"visible":20},"10003498",{"type":8,"entryId":948,"sortOrder":949,"name":950,"imageUrl":951,"description":952,"currentMorphology":14,"currentStage":321,"position":953,"attributes":954},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[17],[955],"attributes-holy",{"id":957,"viewCount":6,"searchKey":958,"visible":20},"10003375",{"type":8,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":14,"currentStage":321,"position":964,"attributes":965},"9998"