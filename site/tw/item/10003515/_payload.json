tomKey":46,"icon":146,"iconStyle":63,"iconTitle":46,"descTitle":147,"descContent":148,"source":149},"91268546_27","/cdn/init/1032100_Feature_132302_Icon.png","劍舞","每施放1次技能,自身施加1層「劍舞」，最多疊加4層，持續15秒。每段普攻會消耗1層「劍舞」，額外造成180%傷害。",{"attributes":150,"type":151,"consume":46,"power":46},[],[],{"id":153,"type":60,"props":154,"children":57},"91268546_28",{"title":155,"type":63,"id":156,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":65,"tabs":157},"技能介紹","91268546_29",[158,186],{"id":159,"title":160,"children":161},"91268546_30","戰鬥技能",[162,175],{"id":163,"type":143,"props":164},"91268546_31",{"id":165,"customKey":46,"icon":166,"iconStyle":63,"iconTitle":46,"descTitle":167,"descContent":168,"source":169},"91268546_32","/cdn/init/1032100_Skill_10600370_Icon.png","荊棘防守","進入防守姿態，受到傷害降低20%。期間受到攻擊，會反擊目標。如果在施放技能的瞬間受到攻擊，暴擊率提升30%，持續10秒。",{"attributes":170,"type":172,"consume":173,"power":174},[171],"6",[21],"20","75",{"id":176,"type":143,"props":177},"91268546_33",{"id":178,"customKey":46,"icon":179,"iconStyle":63,"iconTitle":46,"descTitle":180,"descContent":181,"source":182},"91268546_34","/cdn/init/1032100_Skill_10600390_Icon.png","荊棘衝擊","突刺衝向目標，命中目標後暴擊率提升15%，持續15秒。",{"attributes":183,"type":184,"consume":173,"power":185},[171],[21],"57",{"id":187,"title":188,"children":189},"91268546_35","固有技能",[190],{"id":191,"type":143,"props":192},"91268546_36",{"id":193,"customKey":46,"icon":194,"iconStyle":63,"iconTitle":46,"descTitle":195,"descContent":196,"source":197},"91268546_37","/cdn/init/1032100_Skill_10600000_Icon.png","攻擊","使用草元素能力，近距離攻擊目標。",{"attributes":198,"type":199,"consume":200,"power":171},[171],[21],"0",[202,203],{"id":4,"entryId":12,"currentMorphology":9,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},[205,216,227,238,250,260,270,282,292,302,312,322,332,344,354,365,376,386,396,406,416,426,436,447,457,467,477,487,497,507,517,527,535,539,548,557,567,578,588,598,608,618,628,638,648,658,668,678,688,698,708,718,728,738,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,908,918,928,938,948,958,968,978,988,998,1008,1018,1028,1038,1048,1058,1068,1078,1088,1098,1108,1118,1128,1139],{"id":206,"viewCount":57,"searchKey":207,"visible":15},"10003442",{"type":10,"entryId":208,"sortOrder":209,"name":210,"imageUrl":211,"description":212,"currentMorphology":9,"currentStage":21,"position":213,"attributes":214},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[215],"attributes-fire",{"id":217,"viewCount":57,"searchKey":218,"visible":15},"10003534",{"type":10,"entryId":219,"sortOrder":220,"name":221,"imageUrl":222,"description":223,"currentMorphology":9,"currentStage":224,"position":225,"attributes":226},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[23],[215],{"id":228,"viewCount":57,"searchKey":229,"visible":15},"10003435",{"type":10,"entryId":230,"sortOrder":231,"name":232,"imageUrl":233,"description":234,"currentMorphology":9,"currentStage":235,"position":236,"attributes":237},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[23],[215],{"id":239,"viewCount":57,"searchKey":240,"visible":15},"10003428",{"type":10,"entryId":241,"sortOrder":242,"name":243,"imageUrl":244,"description":245,"currentMorphology":9,"currentStage":235,"position":246,"attributes":248},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[247],"position-break",[215,249],"attributes-dark",{"id":251,"viewCount":57,"searchKey":252,"visible":15},"10003578",{"type":10,"entryId":253,"sortOrder":254,"name":255,"imageUrl":256,"description":257,"currentMorphology":9,"currentStage":21,"position":258,"attributes":259},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[249],{"id":261,"viewCount":57,"searchKey":262,"visible":15},"10003417",{"type":10,"entryId":263,"sortOrder":264,"name":265,"imageUrl":266,"description":267,"currentMorphology":9,"currentStage":235,"position":268,"attributes":269},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[249],{"id":271,"viewCount":57,"searchKey":272,"visible":15},"10003488",{"type":10,"entryId":273,"sortOrder":274,"name":275,"imageUrl":276,"description":277,"currentMorphology":9,"currentStage":21,"position":278,"attributes":280},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[279],"position-sup",[281],"attributes-wind",{"id":283,"viewCount":57,"searchKey":284,"visible":15},"10003548",{"type":10,"entryId":285,"sortOrder":286,"name":287,"imageUrl":288,"description":289,"currentMorphology":9,"currentStage":235,"position":290,"attributes":291},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[279],[281],{"id":293,"viewCount":57,"searchKey":294,"visible":15},"10003474",{"type":10,"entryId":295,"sortOrder":296,"name":297,"imageUrl":298,"description":299,"currentMorphology":9,"currentStage":235,"position":300,"attributes":301},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[281],{"id":303,"viewCount":57,"searchKey":304,"visible":15},"10003467",{"type":10,"entryId":305,"sortOrder":306,"name":307,"imageUrl":308,"description":309,"currentMorphology":9,"currentStage":235,"position":310,"attributes":311},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[247],[281],{"id":313,"viewCount":57,"searchKey":314,"visible":15},"10003392",{"type":10,"entryId":315,"sortOrder":316,"name":317,"imageUrl":318,"description":319,"currentMorphology":9,"currentStage":21,"position":320,"attributes":321},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[25],{"id":323,"viewCount":57,"searchKey":324,"visible":15},"10003510",{"type":10,"entryId":325,"sortOrder":326,"name":327,"imageUrl":328,"description":329,"currentMorphology":9,"currentStage":235,"position":330,"attributes":331},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[25],{"id":333,"viewCount":57,"searchKey":334,"visible":15},"10003477",{"type":10,"entryId":335,"sortOrder":336,"name":337,"imageUrl":338,"description":339,"currentMorphology":9,"currentStage":21,"position":340,"attributes":342},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[341],"position-heal",[343],"attributes-water",{"id":345,"viewCount":57,"searchKey":346,"visible":15},"10003569",{"type":10,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":9,"currentStage":224,"position":352,"attributes":353},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[341],[343],{"id":355,"viewCount":57,"searchKey":356,"visible":15},"10003470",{"type":10,"entryId":357,"sortOrder":358,"name":359,"imageUrl":360,"description":361,"currentMorphology":9,"currentStage":235,"position":362,"attributes":363},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[341],[343,364],"attributes-ice",{"id":366,"viewCount":57,"searchKey":367,"visible":15},"10003463",{"type":10,"entryId":368,"sortOrder":369,"name":370,"imageUrl":371,"description":372,"currentMorphology":9,"currentStage":235,"position":373,"attributes":375},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[374],"position-energy",[25,343],{"id":377,"viewCount":57,"searchKey":378,"visible":15},"10003468",{"type":10,"entryId":379,"sortOrder":380,"name":381,"imageUrl":382,"description":383,"currentMorphology":9,"currentStage":21,"position":384,"attributes":385},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[279],[281],{"id":387,"viewCount":57,"searchKey":388,"visible":15},"10003365",{"type":10,"entryId":389,"sortOrder":390,"name":391,"imageUrl":392,"description":393,"currentMorphology":9,"currentStage":235,"position":394,"attributes":395},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[279],[281],{"id":397,"viewCount":57,"searchKey":398,"visible":15},"10003461",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":9,"currentStage":235,"position":404,"attributes":405},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[279],[249],{"id":407,"viewCount":57,"searchKey":408,"visible":15},"10003421",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":9,"currentStage":21,"position":414,"attributes":415},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[247],[25],{"id":417,"viewCount":57,"searchKey":418,"visible":15},"10003414",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":9,"currentStage":235,"position":424,"attributes":425},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[374],[249,25],{"id":427,"viewCount":57,"searchKey":428,"visible":15},"10003404",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":9,"currentStage":235,"position":434,"attributes":435},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[247],[25],{"id":437,"viewCount":57,"searchKey":438,"visible":15},"10003567",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":9,"currentStage":21,"position":444,"attributes":445},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[247],[446,25],"attributes-rock",{"id":448,"viewCount":57,"searchKey":449,"visible":15},"10003462",{"type":10,"entryId":450,"sortOrder":451,"name":452,"imageUrl":453,"description":454,"currentMorphology":9,"currentStage":235,"position":455,"attributes":456},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[247],[446,25],{"id":458,"viewCount":57,"searchKey":459,"visible":15},"10003551",{"type":10,"entryId":460,"sortOrder":461,"name":462,"imageUrl":463,"description":464,"currentMorphology":9,"currentStage":235,"position":465,"attributes":466},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[247],[364],{"id":468,"viewCount":57,"searchKey":469,"visible":15},"10003409",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":9,"currentStage":21,"position":475,"attributes":476},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[374],[215],{"id":478,"viewCount":57,"searchKey":479,"visible":15},"10003507",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":9,"currentStage":235,"position":485,"attributes":486},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[374],[215],{"id":488,"viewCount":57,"searchKey":489,"visible":15},"10003542",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":9,"currentStage":21,"position":495,"attributes":496},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[341],[281],{"id":498,"viewCount":57,"searchKey":499,"visible":15},"10003440",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":9,"currentStage":235,"position":505,"attributes":506},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[341],[281],{"id":508,"viewCount":57,"searchKey":509,"visible":15},"10003563",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":9,"currentStage":200,"position":515,"attributes":516},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[374],[281,25],{"id":518,"viewCount":57,"searchKey":519,"visible":15},"10003368",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":9,"currentStage":21,"position":525,"attributes":526},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[279],[281],{"id":5,"viewCount":57,"searchKey":528,"visible":15},{"type":10,"entryId":8,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":9,"currentStage":235,"position":533,"attributes":534},1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[279],[281],{"id":4,"viewCount":57,"searchKey":536,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":537,"attributes":538},[23],[25],{"id":540,"viewCount":57,"searchKey":541,"visible":15},"10003496",{"type":10,"entryId":542,"sortOrder":543,"name":79,"imageUrl":544,"description":545,"currentMorphology":9,"currentStage":235,"position":546,"attributes":547},"035",1032300,"/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[25],{"id":549,"viewCount":57,"searchKey":550,"visible":15},"10003378",{"type":10,"entryId":551,"sortOrder":552,"name":87,"imageUrl":553,"description":554,"currentMorphology":9,"currentStage":235,"position":555,"attributes":556},"036",1032400,"/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[279],[25],{"id":558,"viewCount":57,"searchKey":559,"visible":15},"10003456",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":9,"currentStage":21,"position":565,"attributes":566},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[247],[25],{"id":568,"viewCount":57,"searchKey":569,"visible":15},"10003374",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":9,"currentStage":235,"position":575,"attributes":576},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[279],[577],"attributes-electric",{"id":579,"viewCount":57,"searchKey":580,"visible":15},"10003443",{"type":10,"entryId":581,"sortOrder":582,"name":583,"imageUrl":584,"description":585,"currentMorphology":9,"currentStage":235,"position":586,"attributes":587},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[247],[25],{"id":589,"viewCount":57,"searchKey":590,"visible":15},"10003503",{"type":10,"entryId":591,"sortOrder":592,"name":593,"imageUrl":594,"description":595,"currentMorphology":9,"currentStage":21,"position":596,"attributes":597},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[279],[249],{"id":599,"viewCount":57,"searchKey":600,"visible":15},"10003521",{"type":10,"entryId":601,"sortOrder":602,"name":603,"imageUrl":604,"description":605,"currentMorphology":9,"currentStage":235,"position":606,"attributes":607},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[279],[249],{"id":609,"viewCount":57,"searchKey":610,"visible":15},"10003508",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":9,"currentStage":21,"position":616,"attributes":617},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[249],{"id":619,"viewCount":57,"searchKey":620,"visible":15},"10003369",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":9,"currentStage":235,"position":626,"attributes":627},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[249],{"id":629,"viewCount":57,"searchKey":630,"visible":15},"10003501",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":9,"currentStage":235,"position":636,"attributes":637},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[577],{"id":639,"viewCount":57,"searchKey":640,"visible":15},"10003422",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":9,"currentStage":21,"position":646,"attributes":647},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[364],{"id":649,"viewCount":57,"searchKey":650,"visible":15},"10003575",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":9,"currentStage":224,"position":656,"attributes":657},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[364],{"id":659,"viewCount":57,"searchKey":660,"visible":15},"10003415",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":9,"currentStage":235,"position":666,"attributes":667},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[364],{"id":669,"viewCount":57,"searchKey":670,"visible":15},"10003524",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":9,"currentStage":21,"position":676,"attributes":677},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[247],[577],{"id":679,"viewCount":57,"searchKey":680,"visible":15},"10003475",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":9,"currentStage":235,"position":686,"attributes":687},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[247],[577],{"id":689,"viewCount":57,"searchKey":690,"visible":15},"10003523",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":9,"currentStage":21,"position":696,"attributes":697},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[247],[343],{"id":699,"viewCount":57,"searchKey":700,"visible":15},"10003398",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":9,"currentStage":224,"position":706,"attributes":707},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[247],[343],{"id":709,"viewCount":57,"searchKey":710,"visible":15},"10003516",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":9,"currentStage":235,"position":716,"attributes":717},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[279],[343],{"id":719,"viewCount":57,"searchKey":720,"visible":15},"10003566",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":9,"currentStage":235,"position":726,"attributes":727},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[247],[343],{"id":729,"viewCount":57,"searchKey":730,"visible":15},"10003453",{"type":10,"entryId":731,"sortOrder":732,"name":733,"imageUrl":734,"description":735,"currentMorphology":9,"currentStage":21,"position":736,"attributes":737},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[343],{"id":739,"viewCount":57,"searchKey":740,"visible":15},"10003577",{"type":10,"entryId":741,"sortOrder":742,"name":743,"imageUrl":744,"description":745,"currentMorphology":9,"currentStage":224,"position":746,"attributes":747},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[343],{"id":749,"viewCount":57,"searchKey":750,"visible":15},"10003570",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":9,"currentStage":235,"position":756,"attributes":757},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[343],{"id":759,"viewCount":57,"searchKey":760,"visible":15},"10003565",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":9,"currentStage":21,"position":766,"attributes":767},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[446],{"id":769,"viewCount":57,"searchKey":770,"visible":15},"10003476",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":9,"currentStage":235,"position":776,"attributes":777},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[446],{"id":779,"viewCount":57,"searchKey":780,"visible":15},"10003466",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":9,"currentStage":235,"position":786,"attributes":787},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[279],[446],{"id":789,"viewCount":57,"searchKey":790,"visible":15},"10003379",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":9,"currentStage":21,"position":796,"attributes":797},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[577],{"id":799,"viewCount":57,"searchKey":800,"visible":15},"10003376",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":9,"currentStage":235,"position":806,"attributes":807},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[577],{"id":809,"viewCount":57,"searchKey":810,"visible":15},"10003543",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":9,"currentStage":21,"position":816,"attributes":817},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[247],[249],{"id":819,"viewCount":57,"searchKey":820,"visible":15},"10003557",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":9,"currentStage":235,"position":826,"attributes":827},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[249],{"id":829,"viewCount":57,"searchKey":830,"visible":15},"10003522",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":9,"currentStage":235,"position":836,"attributes":837},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[247],[249],{"id":839,"viewCount":57,"searchKey":840,"visible":15},"10003579",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":9,"currentStage":21,"position":846,"attributes":847},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[247],[281],{"id":849,"viewCount":57,"searchKey":850,"visible":15},"10003389",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":9,"currentStage":224,"position":856,"attributes":857},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[247],[281],{"id":859,"viewCount":57,"searchKey":860,"visible":15},"10003536",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":9,"currentStage":235,"position":866,"attributes":867},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[247],[281],{"id":869,"viewCount":57,"searchKey":870,"visible":15},"10003529",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":9,"currentStage":235,"position":876,"attributes":877},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[215],{"id":879,"viewCount":57,"searchKey":880,"visible":15},"10003433",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":9,"currentStage":21,"position":886,"attributes":887},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[446],{"id":889,"viewCount":57,"searchKey":890,"visible":15},"10003427",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":9,"currentStage":235,"position":896,"attributes":897},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[446],{"id":899,"viewCount":57,"searchKey":900,"visible":15},"10003405",{"type":10,"entryId":901,"sortOrder":902,"name":903,"imageUrl":904,"description":905,"currentMorphology":9,"currentStage":21,"position":906,"attributes":907},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[247],[446],{"id":909,"viewCount":57,"searchKey":910,"visible":15},"10003525",{"type":10,"entryId":911,"sortOrder":912,"name":913,"imageUrl":914,"description":915,"currentMorphology":9,"currentStage":224,"position":916,"attributes":917},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[247],[215,446],{"id":919,"viewCount":57,"searchKey":920,"visible":15},"10003399",{"type":10,"entryId":921,"sortOrder":922,"name":923,"imageUrl":924,"description":925,"currentMorphology":9,"currentStage":235,"position":926,"attributes":927},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[247],[215,446],{"id":929,"viewCount":57,"searchKey":930,"visible":15},"10003518",{"type":10,"entryId":931,"sortOrder":932,"name":933,"imageUrl":934,"description":935,"currentMorphology":9,"currentStage":224,"position":936,"attributes":937},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[247],[446],{"id":939,"viewCount":57,"searchKey":940,"visible":15},"10003393",{"type":10,"entryId":941,"sortOrder":942,"name":943,"imageUrl":944,"description":945,"currentMorphology":9,"currentStage":235,"position":946,"attributes":947},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[247],[446],{"id":949,"viewCount":57,"searchKey":950,"visible":15},"10003386",{"type":10,"entryId":951,"sortOrder":952,"name":953,"imageUrl":954,"description":955,"currentMorphology":9,"currentStage":21,"position":956,"attributes":957},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[279],[446],{"id":959,"viewCount":57,"searchKey":960,"visible":15},"10003447",{"type":10,"entryId":961,"sortOrder":962,"name":963,"imageUrl":964,"description":965,"currentMorphology":9,"currentStage":235,"position":966,"attributes":967},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[279],[446],{"id":969,"viewCount":57,"searchKey":970,"visible":15},"10003497",{"type":10,"entryId":971,"sortOrder":972,"name":973,"imageUrl":974,"description":975,"currentMorphology":9,"currentStage":21,"position":976,"attributes":977},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[279],[577],{"id":979,"viewCount":57,"searchKey":980,"visible":15},"10003479",{"type":10,"entryId":981,"sortOrder":982,"name":983,"imageUrl":984,"description":985,"currentMorphology":9,"currentStage":224,"position":986,"attributes":987},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[279],[577],{"id":989,"viewCount":57,"searchKey":990,"visible":15},"10003388",{"type":10,"entryId":991,"sortOrder":992,"name":993,"imageUrl":994,"description":995,"currentMorphology":9,"currentStage":235,"position":996,"attributes":997},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[279],[577],{"id":999,"viewCount":57,"searchKey":1000,"visible":15},"10003429",{"type":10,"entryId":1001,"sortOrder":1002,"name":1003,"imageUrl":1004,"description":1005,"currentMorphology":9,"currentStage":21,"position":1006,"attributes":1007},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[374],[343],{"id":1009,"viewCount":57,"searchKey":1010,"visible":15},"10003430",{"type":10,"entryId":1011,"sortOrder":1012,"name":1013,"imageUrl":1014,"description":1015,"currentMorphology":9,"currentStage":235,"position":1016,"attributes":1017},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[374],[343],{"id":1019,"viewCount":57,"searchKey":1020,"visible":15},"10003549",{"type":10,"entryId":1021,"sortOrder":1022,"name":1023,"imageUrl":1024,"description":1025,"currentMorphology":9,"currentStage":200,"position":1026,"attributes":1027},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[374],[577],{"id":1029,"viewCount":57,"searchKey":1030,"visible":15},"10003494",{"type":10,"entryId":1031,"sortOrder":1032,"name":1033,"imageUrl":1034,"description":1035,"currentMorphology":9,"currentStage":21,"position":1036,"attributes":1037},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[374],[446,343],{"id":1039,"viewCount":57,"searchKey":1040,"visible":15},"10003486",{"type":10,"entryId":1041,"sortOrder":1042,"name":1043,"imageUrl":1044,"description":1045,"currentMorphology":9,"currentStage":235,"position":1046,"attributes":1047},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[374],[446,343],{"id":1049,"viewCount":57,"searchKey":1050,"visible":15},"10003530",{"type":10,"entryId":1051,"sortOrder":1052,"name":1053,"imageUrl":1054,"description":1055,"currentMorphology":9,"currentStage":21,"position":1056,"attributes":1057},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[247],[364],{"id":1059,"viewCount":57,"searchKey":1060,"visible":15},"10003457",{"type":10,"entryId":1061,"sortOrder":1062,"name":1063,"imageUrl":1064,"description":1065,"currentMorphology":9,"currentStage":235,"position":1066,"attributes":1067},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[247],[364],{"id":1069,"viewCount":57,"searchKey":1070,"visible":15},"10003423",{"type":10,"entryId":1071,"sortOrder":1072,"name":1073,"imageUrl":1074,"description":1075,"currentMorphology":9,"currentStage":21,"position":1076,"attributes":1077},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[341],[25,343],{"id":1079,"viewCount":57,"searchKey":1080,"visible":15},"10003419",{"type":10,"entryId":1081,"sortOrder":1082,"name":1083,"imageUrl":1084,"description":1085,"currentMorphology":9,"currentStage":235,"position":1086,"attributes":1087},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[341],[25,343],{"id":1089,"viewCount":57,"searchKey":1090,"visible":15},"10003410",{"type":10,"entryId":1091,"sortOrder":1092,"name":1093,"imageUrl":1094,"description":1095,"currentMorphology":9,"currentStage":21,"position":1096,"attributes":1097},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[343],{"id":1099,"viewCount":57,"searchKey":1100,"visible":15},"10003509",{"type":10,"entryId":1101,"sortOrder":1102,"name":1103,"imageUrl":1104,"description":1105,"currentMorphology":9,"currentStage":235,"position":1106,"attributes":1107},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[343],{"id":1109,"viewCount":57,"searchKey":1110,"visible":15},"10003413",{"type":10,"entryId":1111,"sortOrder":1112,"name":1113,"imageUrl":1114,"description":1115,"currentMorphology":9,"currentStage":21,"position":1116,"attributes":1117},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[364],{"id":1119,"viewCount":57,"searchKey":1120,"visible":15},"10003407",{"type":10,"entryId":1121,"sortOrder":1122,"name":1123,"imageUrl":1124,"description":1125,"currentMorphology":9,"currentStage":235,"position":1126,"attributes":1127},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[364],{"id":1129,"viewCount":57,"searchKey":1130,"visible":15},"10003498",{"type":10,"entryId":1131,"sortOrder":1132,"name":1133,"imageUrl":1134,"description":1135,"currentMorphology":9,"currentStage":200,"position":1136,"attributes":1137},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1138],"attributes-holy",{"id":1140,"viewCount":57,"searchKey":1141,"visible":15},"10003375",{"type":10,"entryId":1142,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":9,"currentStage":200,"position":1147,"attributes":1148},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1138],[1150,1158,1163,1168,1173,1178,1183,1188,1192,1196,1201,1206,1211,1216