11,"consume":199,"power":200},[210],"6",[21],{"id":213,"type":138,"props":214},"91268539_37",{"id":215,"customKey":46,"icon":216,"iconStyle":63,"iconTitle":46,"descTitle":217,"descContent":218,"source":219},"91268539_38","/cdn/init/1003100_Skill_11200021_Icon.png","暗影突襲","攜帶暗影的力量衝撞目標。施放技能後，普攻傷害提高40%，持續10秒。",{"attributes":220,"type":221,"consume":222,"power":223},[197],[21],"10","25",{"id":225,"title":226,"children":227},"91268539_39","固有技能",[228],{"id":229,"type":138,"props":230},"91268539_40",{"id":231,"customKey":46,"icon":232,"iconStyle":63,"iconTitle":46,"descTitle":233,"descContent":234,"source":235},"91268539_41","/cdn/init/1003100_Skill_11200000_Icon.png","攻擊","使用暗元素能力，近距離攻擊目標。",{"attributes":236,"type":237,"consume":238,"power":210},[197],[21],"0",[240,241,242],{"id":4,"entryId":12,"currentMorphology":9,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":243,"entryId":12,"currentMorphology":244,"visible":15},"10003560","Highland Form",[246,257,268,279,290,300,310,322,332,342,352,363,373,385,395,406,417,427,437,447,457,467,477,488,498,508,518,528,538,548,558,568,578,588,598,608,618,629,639,649,657,661,670,679,689,699,709,719,729,739,749,759,769,779,789,799,809,819,829,839,849,859,869,879,889,899,909,919,929,939,949,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1139,1149,1159,1169,1180],{"id":247,"viewCount":57,"searchKey":248,"visible":15},"10003442",{"type":10,"entryId":249,"sortOrder":250,"name":251,"imageUrl":252,"description":253,"currentMorphology":9,"currentStage":21,"position":254,"attributes":255},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[256],"attributes-fire",{"id":258,"viewCount":57,"searchKey":259,"visible":15},"10003534",{"type":10,"entryId":260,"sortOrder":261,"name":262,"imageUrl":263,"description":264,"currentMorphology":9,"currentStage":265,"position":266,"attributes":267},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[23],[256],{"id":269,"viewCount":57,"searchKey":270,"visible":15},"10003435",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":9,"currentStage":276,"position":277,"attributes":278},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[23],[256],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10003428",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":9,"currentStage":276,"position":287,"attributes":289},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[288],"position-break",[256,25],{"id":291,"viewCount":57,"searchKey":292,"visible":15},"10003578",{"type":10,"entryId":293,"sortOrder":294,"name":295,"imageUrl":296,"description":297,"currentMorphology":9,"currentStage":21,"position":298,"attributes":299},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[25],{"id":301,"viewCount":57,"searchKey":302,"visible":15},"10003417",{"type":10,"entryId":303,"sortOrder":304,"name":305,"imageUrl":306,"description":307,"currentMorphology":9,"currentStage":276,"position":308,"attributes":309},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[25],{"id":311,"viewCount":57,"searchKey":312,"visible":15},"10003488",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":9,"currentStage":21,"position":318,"attributes":320},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[319],"position-sup",[321],"attributes-wind",{"id":323,"viewCount":57,"searchKey":324,"visible":15},"10003548",{"type":10,"entryId":325,"sortOrder":326,"name":327,"imageUrl":328,"description":329,"currentMorphology":9,"currentStage":276,"position":330,"attributes":331},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[319],[321],{"id":333,"viewCount":57,"searchKey":334,"visible":15},"10003474",{"type":10,"entryId":335,"sortOrder":336,"name":337,"imageUrl":338,"description":339,"currentMorphology":9,"currentStage":276,"position":340,"attributes":341},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[321],{"id":343,"viewCount":57,"searchKey":344,"visible":15},"10003467",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":9,"currentStage":276,"position":350,"attributes":351},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[288],[321],{"id":353,"viewCount":57,"searchKey":354,"visible":15},"10003392",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":9,"currentStage":21,"position":360,"attributes":361},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[362],"attributes-grass",{"id":364,"viewCount":57,"searchKey":365,"visible":15},"10003510",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":9,"currentStage":276,"position":371,"attributes":372},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[362],{"id":374,"viewCount":57,"searchKey":375,"visible":15},"10003477",{"type":10,"entryId":376,"sortOrder":377,"name":378,"imageUrl":379,"description":380,"currentMorphology":9,"currentStage":21,"position":381,"attributes":383},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[382],"position-heal",[384],"attributes-water",{"id":386,"viewCount":57,"searchKey":387,"visible":15},"10003569",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":9,"currentStage":265,"position":393,"attributes":394},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[382],[384],{"id":396,"viewCount":57,"searchKey":397,"visible":15},"10003470",{"type":10,"entryId":398,"sortOrder":399,"name":400,"imageUrl":401,"description":402,"currentMorphology":9,"currentStage":276,"position":403,"attributes":404},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[382],[384,405],"attributes-ice",{"id":407,"viewCount":57,"searchKey":408,"visible":15},"10003463",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":9,"currentStage":276,"position":414,"attributes":416},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[415],"position-energy",[362,384],{"id":418,"viewCount":57,"searchKey":419,"visible":15},"10003468",{"type":10,"entryId":420,"sortOrder":421,"name":422,"imageUrl":423,"description":424,"currentMorphology":9,"currentStage":21,"position":425,"attributes":426},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[319],[321],{"id":428,"viewCount":57,"searchKey":429,"visible":15},"10003365",{"type":10,"entryId":430,"sortOrder":431,"name":432,"imageUrl":433,"description":434,"currentMorphology":9,"currentStage":276,"position":435,"attributes":436},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[319],[321],{"id":438,"viewCount":57,"searchKey":439,"visible":15},"10003461",{"type":10,"entryId":440,"sortOrder":441,"name":442,"imageUrl":443,"description":444,"currentMorphology":9,"currentStage":276,"position":445,"attributes":446},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[319],[25],{"id":448,"viewCount":57,"searchKey":449,"visible":15},"10003421",{"type":10,"entryId":450,"sortOrder":451,"name":452,"imageUrl":453,"description":454,"currentMorphology":9,"currentStage":21,"position":455,"attributes":456},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[288],[362],{"id":458,"viewCount":57,"searchKey":459,"visible":15},"10003414",{"type":10,"entryId":460,"sortOrder":461,"name":462,"imageUrl":463,"description":464,"currentMorphology":9,"currentStage":276,"position":465,"attributes":466},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[415],[25,362],{"id":468,"viewCount":57,"searchKey":469,"visible":15},"10003404",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":9,"currentStage":276,"position":475,"attributes":476},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[288],[362],{"id":478,"viewCount":57,"searchKey":479,"visible":15},"10003567",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":9,"currentStage":21,"position":485,"attributes":486},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[288],[487,362],"attributes-rock",{"id":489,"viewCount":57,"searchKey":490,"visible":15},"10003462",{"type":10,"entryId":491,"sortOrder":492,"name":493,"imageUrl":494,"description":495,"currentMorphology":9,"currentStage":276,"position":496,"attributes":497},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[288],[487,362],{"id":499,"viewCount":57,"searchKey":500,"visible":15},"10003551",{"type":10,"entryId":501,"sortOrder":502,"name":503,"imageUrl":504,"description":505,"currentMorphology":9,"currentStage":276,"position":506,"attributes":507},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[288],[405],{"id":509,"viewCount":57,"searchKey":510,"visible":15},"10003409",{"type":10,"entryId":511,"sortOrder":512,"name":513,"imageUrl":514,"description":515,"currentMorphology":9,"currentStage":21,"position":516,"attributes":517},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[415],[256],{"id":519,"viewCount":57,"searchKey":520,"visible":15},"10003507",{"type":10,"entryId":521,"sortOrder":522,"name":523,"imageUrl":524,"description":525,"currentMorphology":9,"currentStage":276,"position":526,"attributes":527},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[415],[256],{"id":529,"viewCount":57,"searchKey":530,"visible":15},"10003542",{"type":10,"entryId":531,"sortOrder":532,"name":533,"imageUrl":534,"description":535,"currentMorphology":9,"currentStage":21,"position":536,"attributes":537},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[382],[321],{"id":539,"viewCount":57,"searchKey":540,"visible":15},"10003440",{"type":10,"entryId":541,"sortOrder":542,"name":543,"imageUrl":544,"description":545,"currentMorphology":9,"currentStage":276,"position":546,"attributes":547},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[382],[321],{"id":549,"viewCount":57,"searchKey":550,"visible":15},"10003563",{"type":10,"entryId":551,"sortOrder":552,"name":553,"imageUrl":554,"description":555,"currentMorphology":9,"currentStage":238,"position":556,"attributes":557},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[415],[321,362],{"id":559,"viewCount":57,"searchKey":560,"visible":15},"10003368",{"type":10,"entryId":561,"sortOrder":562,"name":563,"imageUrl":564,"description":565,"currentMorphology":9,"currentStage":21,"position":566,"attributes":567},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[319],[321],{"id":569,"viewCount":57,"searchKey":570,"visible":15},"10003363",{"type":10,"entryId":571,"sortOrder":572,"name":573,"imageUrl":574,"description":575,"currentMorphology":9,"currentStage":276,"position":576,"attributes":577},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[319],[321],{"id":579,"viewCount":57,"searchKey":580,"visible":15},"10003515",{"type":10,"entryId":581,"sortOrder":582,"name":583,"imageUrl":584,"description":585,"currentMorphology":9,"currentStage":21,"position":586,"attributes":587},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[362],{"id":589,"viewCount":57,"searchKey":590,"visible":15},"10003496",{"type":10,"entryId":591,"sortOrder":592,"name":593,"imageUrl":594,"description":595,"currentMorphology":9,"currentStage":276,"position":596,"attributes":597},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[362],{"id":599,"viewCount":57,"searchKey":600,"visible":15},"10003378",{"type":10,"entryId":601,"sortOrder":602,"name":603,"imageUrl":604,"description":605,"currentMorphology":9,"currentStage":276,"position":606,"attributes":607},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[319],[362],{"id":609,"viewCount":57,"searchKey":610,"visible":15},"10003456",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":9,"currentStage":21,"position":616,"attributes":617},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[288],[362],{"id":619,"viewCount":57,"searchKey":620,"visible":15},"10003374",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":9,"currentStage":276,"position":626,"attributes":627},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[319],[628],"attributes-electric",{"id":630,"viewCount":57,"searchKey":631,"visible":15},"10003443",{"type":10,"entryId":632,"sortOrder":633,"name":634,"imageUrl":635,"description":636,"currentMorphology":9,"currentStage":276,"position":637,"attributes":638},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[288],[362],{"id":640,"viewCount":57,"searchKey":641,"visible":15},"10003503",{"type":10,"entryId":642,"sortOrder":643,"name":644,"imageUrl":645,"description":646,"currentMorphology":9,"currentStage":21,"position":647,"attributes":648},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[319],[25],{"id":5,"viewCount":57,"searchKey":650,"visible":15},{"type":10,"entryId":8,"sortOrder":651,"name":652,"imageUrl":653,"description":654,"currentMorphology":9,"currentStage":276,"position":655,"attributes":656},1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[319],[25],{"id":4,"viewCount":57,"searchKey":658,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":659,"attributes":660},[23],[25],{"id":662,"viewCount":57,"searchKey":663,"visible":15},"10003369",{"type":10,"entryId":664,"sortOrder":665,"name":87,"imageUrl":666,"description":667,"currentMorphology":9,"currentStage":276,"position":668,"attributes":669},"043",1003200,"/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[25],{"id":671,"viewCount":57,"searchKey":672,"visible":15},"10003501",{"type":10,"entryId":673,"sortOrder":674,"name":79,"imageUrl":675,"description":676,"currentMorphology":9,"currentStage":276,"position":677,"attributes":678},"044",1003300,"/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[628],{"id":680,"viewCount":57,"searchKey":681,"visible":15},"10003422",{"type":10,"entryId":682,"sortOrder":683,"name":684,"imageUrl":685,"description":686,"currentMorphology":9,"currentStage":21,"position":687,"attributes":688},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[405],{"id":690,"viewCount":57,"searchKey":691,"visible":15},"10003575",{"type":10,"entryId":692,"sortOrder":693,"name":694,"imageUrl":695,"description":696,"currentMorphology":9,"currentStage":265,"position":697,"attributes":698},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[405],{"id":700,"viewCount":57,"searchKey":701,"visible":15},"10003415",{"type":10,"entryId":702,"sortOrder":703,"name":704,"imageUrl":705,"description":706,"currentMorphology":9,"currentStage":276,"position":707,"attributes":708},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[405],{"id":710,"viewCount":57,"searchKey":711,"visible":15},"10003524",{"type":10,"entryId":712,"sortOrder":713,"name":714,"imageUrl":715,"description":716,"currentMorphology":9,"currentStage":21,"position":717,"attributes":718},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[288],[628],{"id":720,"viewCount":57,"searchKey":721,"visible":15},"10003475",{"type":10,"entryId":722,"sortOrder":723,"name":724,"imageUrl":725,"description":726,"currentMorphology":9,"currentStage":276,"position":727,"attributes":728},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[288],[628],{"id":730,"viewCount":57,"searchKey":731,"visible":15},"10003523",{"type":10,"entryId":732,"sortOrder":733,"name":734,"imageUrl":735,"description":736,"currentMorphology":9,"currentStage":21,"position":737,"attributes":738},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[288],[384],{"id":740,"viewCount":57,"searchKey":741,"visible":15},"10003398",{"type":10,"entryId":742,"sortOrder":743,"name":744,"imageUrl":745,"description":746,"currentMorphology":9,"currentStage":265,"position":747,"attributes":748},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[288],[384],{"id":750,"viewCount":57,"searchKey":751,"visible":15},"10003516",{"type":10,"entryId":752,"sortOrder":753,"name":754,"imageUrl":755,"description":756,"currentMorphology":9,"currentStage":276,"position":757,"attributes":758},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[319],[384],{"id":760,"viewCount":57,"searchKey":761,"visible":15},"10003566",{"type":10,"entryId":762,"sortOrder":763,"name":764,"imageUrl":765,"description":766,"currentMorphology":9,"currentStage":276,"position":767,"attributes":768},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[288],[384],{"id":770,"viewCount":57,"searchKey":771,"visible":15},"10003453",{"type":10,"entryId":772,"sortOrder":773,"name":774,"imageUrl":775,"description":776,"currentMorphology":9,"currentStage":21,"position":777,"attributes":778},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[384],{"id":780,"viewCount":57,"searchKey":781,"visible":15},"10003577",{"type":10,"entryId":782,"sortOrder":783,"name":784,"imageUrl":785,"description":786,"currentMorphology":9,"currentStage":265,"position":787,"attributes":788},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[384],{"id":790,"viewCount":57,"searchKey":791,"visible":15},"10003570",{"type":10,"entryId":792,"sortOrder":793,"name":794,"imageUrl":795,"description":796,"currentMorphology":9,"currentStage":276,"position":797,"attributes":798},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[384],{"id":800,"viewCount":57,"searchKey":801,"visible":15},"10003565",{"type":10,"entryId":802,"sortOrder":803,"name":804,"imageUrl":805,"description":806,"currentMorphology":9,"currentStage":21,"position":807,"attributes":808},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[487],{"id":810,"viewCount":57,"searchKey":811,"visible":15},"10003476",{"type":10,"entryId":812,"sortOrder":813,"name":814,"imageUrl":815,"description":816,"currentMorphology":9,"currentStage":276,"position":817,"attributes":818},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[487],{"id":820,"viewCount":57,"searchKey":821,"visible":15},"10003466",{"type":10,"entryId":822,"sortOrder":823,"name":824,"imageUrl":825,"description":826,"currentMorphology":9,"currentStage":276,"position":827,"attributes":828},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[319],[487],{"id":830,"viewCount":57,"searchKey":831,"visible":15},"10003379",{"type":10,"entryId":832,"sortOrder":833,"name":834,"imageUrl":835,"description":836,"currentMorphology":9,"currentStage":21,"position":837,"attributes":838},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[628],{"id":840,"viewCount":57,"searchKey":841,"visible":15},"10003376",{"type":10,"entryId":842,"sortOrder":843,"name":844,"imageUrl":845,"description":846,"currentMorphology":9,"currentStage":276,"position":847,"attributes":848},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[628],{"id":850,"viewCount":57,"searchKey":851,"visible":15},"10003543",{"type":10,"entryId":852,"sortOrder":853,"name":854,"imageUrl":855,"description":856,"currentMorphology":9,"currentStage":21,"position":857,"attributes":858},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[288],[25],{"id":860,"viewCount":57,"searchKey":861,"visible":15},"10003557",{"type":10,"entryId":862,"sortOrder":863,"name":864,"imageUrl":865,"description":866,"currentMorphology":9,"currentStage":276,"position":867,"attributes":868},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[25],{"id":870,"viewCount":57,"searchKey":871,"visible":15},"10003522",{"type":10,"entryId":872,"sortOrder":873,"name":874,"imageUrl":875,"description":876,"currentMorphology":9,"currentStage":276,"position":877,"attributes":878},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[288],[25],{"id":880,"viewCount":57,"searchKey":881,"visible":15},"10003579",{"type":10,"entryId":882,"sortOrder":883,"name":884,"imageUrl":885,"description":886,"currentMorphology":9,"currentStage":21,"position":887,"attributes":888},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[288],[321],{"id":890,"viewCount":57,"searchKey":891,"visible":15},"10003389",{"type":10,"entryId":892,"sortOrder":893,"name":894,"imageUrl":895,"description":896,"currentMorphology":9,"currentStage":265,"position":897,"attributes":898},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[288],[321],{"id":900,"viewCount":57,"searchKey":901,"visible":15},"10003536",{"type":10,"entryId":902,"sortOrder":903,"name":904,"imageUrl":905,"description":906,"currentMorphology":9,"currentStage":276,"position":907,"attributes":908},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[288],[321],{"id":910,"viewCount":57,"searchKey":911,"visible":15},"10003529",{"type":10,"entryId":912,"sortOrder":913,"name":914,"imageUrl":915,"description":916,"currentMorphology":9,"currentStage":276,"position":917,"attributes":918},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[256],{"id":920,"viewCount":57,"searchKey":921,"visible":15},"10003433",{"type":10,"entryId":922,"sortOrder":923,"name":924,"imageUrl":925,"description":926,"currentMorphology":9,"currentStage":21,"position":927,"attributes":928},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[487],{"id":930,"viewCount":57,"searchKey":931,"visible":15},"10003427",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":9,"currentStage":276,"position":937,"attributes":938},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[487],{"id":940,"viewCount":57,"searchKey":941,"visible":15},"10003405",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":9,"currentStage":21,"position":947,"attributes":948},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[288],[487],{"id":950,"viewCount":57,"searchKey":951,"visible":15},"10003525",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":9,"currentStage":265,"position":957,"attributes":958},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[288],[256,487],{"id":960,"viewCount":57,"searchKey":961,"visible":15},"10003399",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":9,"currentStage":276,"position":967,"attributes":968},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[288],[256,487],{"id":970,"viewCount":57,"searchKey":971,"visible":15},"10003518",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":9,"currentStage":265,"position":977,"attributes":978},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[288],[487],{"id":980,"viewCount":57,"searchKey":981,"visible":15},"10003393",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":9,"currentStage":276,"position":987,"attributes":988},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[288],[487],{"id":990,"viewCount":57,"searchKey":991,"visible":15},"10003386",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":9,"currentStage":21,"position":997,"attributes":998},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[319],[487],{"id":1000,"viewCount":57,"searchKey":1001,"visible":15},"10003447",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":9,"currentStage":276,"position":1007,"attributes":1008},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[319],[487],{"id":1010,"viewCount":57,"searchKey":1011,"visible":15},"10003497",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":9,"currentStage":21,"position":1017,"attributes":1018},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[319],[628],{"id":1020,"viewCount":57,"searchKey":1021,"visible":15},"10003479",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":9,"currentStage":265,"position":1027,"attributes":1028},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[319],[628],{"id":1030,"viewCount":57,"searchKey":1031,"visible":15},"10003388",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":9,"currentStage":276,"position":1037,"attributes":1038},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[319],[628],{"id":1040,"viewCount":57,"searchKey":1041,"visible":15},"10003429",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":9,"currentStage":21,"position":1047,"attributes":1048},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[415],[384],{"id":1050,"viewCount":57,"searchKey":1051,"visible":15},"10003430",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":9,"currentStage":276,"position":1057,"attributes":1058},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[415],[384],{"id":1060,"viewCount":57,"searchKey":1061,"visible":15},"10003549",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":9,"currentStage":238,"position":1067,"attributes":1068},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[415],[628],{"id":1070,"viewCount":57,"searchKey":1071,"visible":15},"10003494",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":9,"currentStage":21,"position":1077,"attributes":1078},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[415],[487,384],{"id":1080,"viewCount":57,"searchKey":1081,"visible":15},"10003486",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":9,"currentStage":276,"position":1087,"attributes":1088},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[415],[487,384],{"id":1090,"viewCount":57,"searchKey":1091,"visible":15},"10003530",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":9,"currentStage":21,"position":1097,"attributes":1098},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[288],[405],{"id":1100,"viewCount":57,"searchKey":1101,"visible":15},"10003457",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":9,"currentStage":276,"position":1107,"attributes":1108},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[288],[405],{"id":1110,"viewCount":57,"searchKey":1111,"visible":15},"10003423",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":9,"currentStage":21,"position":1117,"attributes":1118},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[382],[362,384],{"id":1120,"viewCount":57,"searchKey":1121,"visible":15},"10003419",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":9,"currentStage":276,"position":1127,"attributes":1128},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[382],[362,384],{"id":1130,"viewCount":57,"searchKey":1131,"visible":15},"10003410",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":9,"currentStage":21,"position":1137,"attributes":1138},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[384],{"id":1140,"viewCount":57,"searchKey":1141,"visible":15},"10003509",{"type":10,"entryId":1142,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":9,"currentStage":276,"position":1147,"attributes":1148},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[384],{"id":1150,"viewCount":57,"searchKey":1151,"visible":15},"10003413",{"type":10,"entryId":1152,"sortOrder":1153,"name":1154,"imageUrl":1155,"description":1156,"currentMorphology":9,"currentStage":21,"position":1157,"attributes":1158},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[405],{"id":1160,"viewCount":57,"searchKey":1161,"visible":15},"10003407",{"type":10,"entryId":1162,"sortOrder":1163,"name":1164,"imageUrl":1165,"description":1166,"currentMorphology":9,"currentStage":276,"position":1167,"attributes":1168},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[405],{"id":1170,"viewCount":57,"searchKey":1171,"visible":15},"10003498",{"type":10,"entryId":1172,"sortOrder":1173,"name":1174,"imageUrl":1175,"description":1176,"currentMorphology":9,"currentStage":238,"position":1177,"attributes":1178},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1179],"attributes-holy",{"id":1181,"viewCount":57,"searchKey":1182,"visible":15},"10003375",{"type":10,"entryId":1183,"sortOrder":1184,"name":1185,"imageUrl":1186,"description":1187,"currentMorphology":9,"currentStage":238,"position":1188,"attributes":1189},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1179],[1191,1199,1203,1208,1213,1218,1223,1228,1232,1236,1241,1246,1251,1256,1261,1266,1270,1275,1278],{"id":1192,"parentId":1193,"tagType":1194,"tagKey":1195,"name":1196,"language":1197,"sort":1198},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1200,"parentId":1193,"tagType":1194,"tagKey":13,"name":1201,"language":1197,"sort":1202},"169975e83c7c7cc9196859ca36b9ab26","森林型態",8,{"id":1204,"parentId":1193,"tagType":1194,"tagKey":1205,"name":1206,"language":1197,"sort":1207},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1209,"parentId":1193,"tagType":1194,"tagKey":1210,"name":1211,"language":1197,"sort":1212},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1214,"parentId":1193,"tagTyp