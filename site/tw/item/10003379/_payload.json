lackHeader":66},"探索技能","91268409_22",[146],{"id":147,"type":132,"props":148,"children":58},"91268409_23",{"id":149,"customKey":47,"icon":150,"iconStyle":91,"iconTitle":47,"descTitle":151,"descContent":152,"source":153},"91268409_24","/cdn/init/1029100_Skill_9400136_Icon.png","疾馳","快速向前移動一段距離",{"attributes":154,"type":155,"consume":47,"power":47},[],[],{"id":157,"type":61,"props":158,"children":161},"91268409_25",{"title":159,"type":64,"id":160,"isUse":15,"isEdit":15,"useTabs":66,"blackHeader":66},"伊莫特性","91268409_26",[162],{"id":163,"type":132,"props":164,"children":58},"91268409_27",{"id":165,"customKey":47,"icon":166,"iconStyle":64,"iconTitle":47,"descTitle":167,"descContent":168,"source":169},"91268409_28","/cdn/init/1029100_Feature_12932_Icon.png","空雷契約","攻擊命中目標時獲得1層「空雷契約」。疊加到30層後，下次施放技能或終結技能會進入「雷翼姿態」，持續10秒。",{"attributes":170,"type":171,"consume":47,"power":47},[],[],{"id":173,"type":61,"props":174,"children":58},"91268409_29",{"title":175,"type":64,"id":176,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":66,"tabs":177},"技能介紹","91268409_30",[178,206],{"id":179,"title":180,"children":181},"91268409_31","戰鬥技能",[182,195],{"id":183,"type":132,"props":184},"91268409_32",{"id":185,"customKey":47,"icon":186,"iconStyle":64,"iconTitle":47,"descTitle":187,"descContent":188,"source":189},"91268409_33","/cdn/init/1029100_Skill_10400360_Icon.png","雷電場","以目標為單位施放雷電場並持續跟隨目標，雷電場內目標受到電系攻擊時會額外附加一次電系攻擊並使目標「電元素異常」，雷電場持續8秒。",{"attributes":190,"type":192,"consume":194,"power":22},[191],"4",[193],"2","20",{"id":196,"type":132,"props":197},"91268409_34",{"id":198,"customKey":47,"icon":199,"iconStyle":64,"iconTitle":47,"descTitle":200,"descContent":201,"source":202},"91268409_35","/cdn/init/1029100_Skill_10400370_Icon.png","閃電鏢","向目標發射一道閃電鏢，持續對沿途的目標造成傷害，並持續吸附目標。",{"attributes":203,"type":204,"consume":194,"power":205},[191],[193],"50",{"id":207,"title":208,"children":209},"91268409_36","固有技能",[210],{"id":211,"type":132,"props":212},"91268409_37",{"id":213,"customKey":47,"icon":214,"iconStyle":64,"iconTitle":47,"descTitle":215,"descContent":216,"source":217},"91268409_38","/cdn/init/1029100_Skill_14000000_Icon.png","攻擊","使用電元素能力，遠距離攻擊目標。",{"attributes":218,"type":219,"consume":220,"power":221},[191],[193],"0","6",[223],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[225,236,246,257,269,279,289,301,311,321,331,342,352,364,374,385,396,406,416,426,436,446,456,467,477,487,497,507,517,527,537,547,557,567,577,587,597,607,617,627,637,647,657,667,677,687,697,707,717,727,737,747,757,767,777,787,797,807,816,820,827,837,847,857,867,877,887,897,907,917,927,937,947,957,967,977,987,997,1007,1017,1027,1037,1047,1057,1067,1077,1087,1097,1107,1117,1127,1137,1147,1158],{"id":226,"viewCount":58,"searchKey":227,"visible":15},"10003442",{"type":10,"entryId":228,"sortOrder":229,"name":230,"imageUrl":231,"description":232,"currentMorphology":13,"currentStage":22,"position":233,"attributes":234},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[235],"attributes-fire",{"id":237,"viewCount":58,"searchKey":238,"visible":15},"10003534",{"type":10,"entryId":239,"sortOrder":240,"name":241,"imageUrl":242,"description":243,"currentMorphology":13,"currentStage":193,"position":244,"attributes":245},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[24],[235],{"id":247,"viewCount":58,"searchKey":248,"visible":15},"10003435",{"type":10,"entryId":249,"sortOrder":250,"name":251,"imageUrl":252,"description":253,"currentMorphology":13,"currentStage":254,"position":255,"attributes":256},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[24],[235],{"id":258,"viewCount":58,"searchKey":259,"visible":15},"10003428",{"type":10,"entryId":260,"sortOrder":261,"name":262,"imageUrl":263,"description":264,"currentMorphology":13,"currentStage":254,"position":265,"attributes":267},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[266],"position-break",[235,268],"attributes-dark",{"id":270,"viewCount":58,"searchKey":271,"visible":15},"10003578",{"type":10,"entryId":272,"sortOrder":273,"name":274,"imageUrl":275,"description":276,"currentMorphology":13,"currentStage":22,"position":277,"attributes":278},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[268],{"id":280,"viewCount":58,"searchKey":281,"visible":15},"10003417",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":13,"currentStage":254,"position":287,"attributes":288},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[268],{"id":290,"viewCount":58,"searchKey":291,"visible":15},"10003488",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":13,"currentStage":22,"position":297,"attributes":299},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[298],"position-sup",[300],"attributes-wind",{"id":302,"viewCount":58,"searchKey":303,"visible":15},"10003548",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":13,"currentStage":254,"position":309,"attributes":310},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[298],[300],{"id":312,"viewCount":58,"searchKey":313,"visible":15},"10003474",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":13,"currentStage":254,"position":319,"attributes":320},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[300],{"id":322,"viewCount":58,"searchKey":323,"visible":15},"10003467",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":13,"currentStage":254,"position":329,"attributes":330},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[266],[300],{"id":332,"viewCount":58,"searchKey":333,"visible":15},"10003392",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":13,"currentStage":22,"position":339,"attributes":340},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[341],"attributes-grass",{"id":343,"viewCount":58,"searchKey":344,"visible":15},"10003510",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":13,"currentStage":254,"position":350,"attributes":351},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[341],{"id":353,"viewCount":58,"searchKey":354,"visible":15},"10003477",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":13,"currentStage":22,"position":360,"attributes":362},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[361],"position-heal",[363],"attributes-water",{"id":365,"viewCount":58,"searchKey":366,"visible":15},"10003569",{"type":10,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":13,"currentStage":193,"position":372,"attributes":373},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[361],[363],{"id":375,"viewCount":58,"searchKey":376,"visible":15},"10003470",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":13,"currentStage":254,"position":382,"attributes":383},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[361],[363,384],"attributes-ice",{"id":386,"viewCount":58,"searchKey":387,"visible":15},"10003463",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":13,"currentStage":254,"position":393,"attributes":395},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[394],"position-energy",[341,363],{"id":397,"viewCount":58,"searchKey":398,"visible":15},"10003468",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":13,"currentStage":22,"position":404,"attributes":405},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[298],[300],{"id":407,"viewCount":58,"searchKey":408,"visible":15},"10003365",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":13,"currentStage":254,"position":414,"attributes":415},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[298],[300],{"id":417,"viewCount":58,"searchKey":418,"visible":15},"10003461",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":13,"currentStage":254,"position":424,"attributes":425},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[298],[268],{"id":427,"viewCount":58,"searchKey":428,"visible":15},"10003421",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":13,"currentStage":22,"position":434,"attributes":435},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[266],[341],{"id":437,"viewCount":58,"searchKey":438,"visible":15},"10003414",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":13,"currentStage":254,"position":444,"attributes":445},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[394],[268,341],{"id":447,"viewCount":58,"searchKey":448,"visible":15},"10003404",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":13,"currentStage":254,"position":454,"attributes":455},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[266],[341],{"id":457,"viewCount":58,"searchKey":458,"visible":15},"10003567",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":13,"currentStage":22,"position":464,"attributes":465},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[266],[466,341],"attributes-rock",{"id":468,"viewCount":58,"searchKey":469,"visible":15},"10003462",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":13,"currentStage":254,"position":475,"attributes":476},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[266],[466,341],{"id":478,"viewCount":58,"searchKey":479,"visible":15},"10003551",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":13,"currentStage":254,"position":485,"attributes":486},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[266],[384],{"id":488,"viewCount":58,"searchKey":489,"visible":15},"10003409",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":13,"currentStage":22,"position":495,"attributes":496},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[394],[235],{"id":498,"viewCount":58,"searchKey":499,"visible":15},"10003507",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":13,"currentStage":254,"position":505,"attributes":506},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[394],[235],{"id":508,"viewCount":58,"searchKey":509,"visible":15},"10003542",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":13,"currentStage":22,"position":515,"attributes":516},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[361],[300],{"id":518,"viewCount":58,"searchKey":519,"visible":15},"10003440",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":13,"currentStage":254,"position":525,"attributes":526},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[361],[300],{"id":528,"viewCount":58,"searchKey":529,"visible":15},"10003563",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":13,"currentStage":220,"position":535,"attributes":536},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[394],[300,341],{"id":538,"viewCount":58,"searchKey":539,"visible":15},"10003368",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":13,"currentStage":22,"position":545,"attributes":546},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[298],[300],{"id":548,"viewCount":58,"searchKey":549,"visible":15},"10003363",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":13,"currentStage":254,"position":555,"attributes":556},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[298],[300],{"id":558,"viewCount":58,"searchKey":559,"visible":15},"10003515",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":13,"currentStage":22,"position":565,"attributes":566},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[341],{"id":568,"viewCount":58,"searchKey":569,"visible":15},"10003496",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":13,"currentStage":254,"position":575,"attributes":576},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[24],[341],{"id":578,"viewCount":58,"searchKey":579,"visible":15},"10003378",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":13,"currentStage":254,"position":585,"attributes":586},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[298],[341],{"id":588,"viewCount":58,"searchKey":589,"visible":15},"10003456",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":13,"currentStage":22,"position":595,"attributes":596},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[266],[341],{"id":598,"viewCount":58,"searchKey":599,"visible":15},"10003374",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":13,"currentStage":254,"position":605,"attributes":606},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[298],[26],{"id":608,"viewCount":58,"searchKey":609,"visible":15},"10003443",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":13,"currentStage":254,"position":615,"attributes":616},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[266],[341],{"id":618,"viewCount":58,"searchKey":619,"visible":15},"10003503",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":13,"currentStage":22,"position":625,"attributes":626},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[298],[268],{"id":628,"viewCount":58,"searchKey":629,"visible":15},"10003521",{"type":10,"entryId":630,"sortOrder":631,"name":632,"imageUrl":633,"description":634,"currentMorphology":13,"currentStage":254,"position":635,"attributes":636},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[298],[268],{"id":638,"viewCount":58,"searchKey":639,"visible":15},"10003508",{"type":10,"entryId":640,"sortOrder":641,"name":642,"imageUrl":643,"description":644,"currentMorphology":13,"currentStage":22,"position":645,"attributes":646},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[268],{"id":648,"viewCount":58,"searchKey":649,"visible":15},"10003369",{"type":10,"entryId":650,"sortOrder":651,"name":652,"imageUrl":653,"description":654,"currentMorphology":13,"currentStage":254,"position":655,"attributes":656},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[24],[268],{"id":658,"viewCount":58,"searchKey":659,"visible":15},"10003501",{"type":10,"entryId":660,"sortOrder":661,"name":662,"imageUrl":663,"description":664,"currentMorphology":13,"currentStage":254,"position":665,"attributes":666},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[26],{"id":668,"viewCount":58,"searchKey":669,"visible":15},"10003422",{"type":10,"entryId":670,"sortOrder":671,"name":672,"imageUrl":673,"description":674,"currentMorphology":13,"currentStage":22,"position":675,"attributes":676},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[384],{"id":678,"viewCount":58,"searchKey":679,"visible":15},"10003575",{"type":10,"entryId":680,"sortOrder":681,"name":682,"imageUrl":683,"description":684,"currentMorphology":13,"currentStage":193,"position":685,"attributes":686},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[384],{"id":688,"viewCount":58,"searchKey":689,"visible":15},"10003415",{"type":10,"entryId":690,"sortOrder":691,"name":692,"imageUrl":693,"description":694,"currentMorphology":13,"currentStage":254,"position":695,"attributes":696},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[24],[384],{"id":698,"viewCount":58,"searchKey":699,"visible":15},"10003524",{"type":10,"entryId":700,"sortOrder":701,"name":702,"imageUrl":703,"description":704,"currentMorphology":13,"currentStage":22,"position":705,"attributes":706},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[266],[26],{"id":708,"viewCount":58,"searchKey":709,"visible":15},"10003475",{"type":10,"entryId":710,"sortOrder":711,"name":712,"imageUrl":713,"description":714,"currentMorphology":13,"currentStage":254,"position":715,"attributes":716},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[266],[26],{"id":718,"viewCount":58,"searchKey":719,"visible":15},"10003523",{"type":10,"entryId":720,"sortOrder":721,"name":722,"imageUrl":723,"description":724,"currentMorphology":13,"currentStage":22,"position":725,"attributes":726},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[266],[363],{"id":728,"viewCount":58,"searchKey":729,"visible":15},"10003398",{"type":10,"entryId":730,"sortOrder":731,"name":732,"imageUrl":733,"description":734,"currentMorphology":13,"currentStage":193,"position":735,"attributes":736},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[266],[363],{"id":738,"viewCount":58,"searchKey":739,"visible":15},"10003516",{"type":10,"entryId":740,"sortOrder":741,"name":742,"imageUrl":743,"description":744,"currentMorphology":13,"currentStage":254,"position":745,"attributes":746},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[298],[363],{"id":748,"viewCount":58,"searchKey":749,"visible":15},"10003566",{"type":10,"entryId":750,"sortOrder":751,"name":752,"imageUrl":753,"description":754,"currentMorphology":13,"currentStage":254,"position":755,"attributes":756},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[266],[363],{"id":758,"viewCount":58,"searchKey":759,"visible":15},"10003453",{"type":10,"entryId":760,"sortOrder":761,"name":762,"imageUrl":763,"description":764,"currentMorphology":13,"currentStage":22,"position":765,"attributes":766},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[24],[363],{"id":768,"viewCount":58,"searchKey":769,"visible":15},"10003577",{"type":10,"entryId":770,"sortOrder":771,"name":772,"imageUrl":773,"description":774,"currentMorphology":13,"currentStage":193,"position":775,"attributes":776},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[363],{"id":778,"viewCount":58,"searchKey":779,"visible":15},"10003570",{"type":10,"entryId":780,"sortOrder":781,"name":782,"imageUrl":783,"description":784,"currentMorphology":13,"currentStage":254,"position":785,"attributes":786},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[363],{"id":788,"viewCount":58,"searchKey":789,"visible":15},"10003565",{"type":10,"entryId":790,"sortOrder":791,"name":792,"imageUrl":793,"description":794,"currentMorphology":13,"currentStage":22,"position":795,"attributes":796},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[24],[466],{"id":798,"viewCount":58,"searchKey":799,"visible":15},"10003476",{"type":10,"entryId":800,"sortOrder":801,"name":802,"imageUrl":803,"description":804,"currentMorphology":13,"currentStage":254,"position":805,"attributes":806},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[466],{"id":808,"viewCount":58,"searchKey":809,"visible":15},"10003466",{"type":10,"entryId":8,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":13,"currentStage":254,"position":814,"attributes":815},1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[298],[466],{"id":4,"viewCount":58,"searchKey":817,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":818,"attributes":819},[24],[26],{"id":6,"viewCount":58,"searchKey":821,"visible":15},{"type":10,"entryId":12,"sortOrder":822,"name":80,"imageUrl":823,"description":824,"currentMorphology":13,"currentStage":254,"position":825,"attributes":826},1029300,"/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[26],{"id":828,"viewCount":58,"searchKey":829,"visible":15},"10003543",{"type":10,"entryId":830,"sortOrder":831,"name":832,"imageUrl":833,"description":834,"currentMorphology":13,"currentStage":22,"position":835,"attributes":836},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[266],[268],{"id":838,"viewCount":58,"searchKey":839,"visible":15},"10003557",{"type":10,"entryId":840,"sortOrder":841,"name":842,"imageUrl":843,"description":844,"currentMorphology":13,"currentStage":254,"position":845,"attributes":846},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[268],{"id":848,"viewCount":58,"searchKey":849,"visible":15},"10003522",{"type":10,"entryId":850,"sortOrder":851,"name":852,"imageUrl":853,"description":854,"currentMorphology":13,"currentStage":254,"position":855,"attributes":856},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[266],[268],{"id":858,"viewCount":58,"searchKey":859,"visible":15},"10003579",{"type":10,"entryId":860,"sortOrder":861,"name":862,"imageUrl":863,"description":864,"currentMorphology":13,"currentStage":22,"position":865,"attributes":866},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[266],[300],{"id":868,"viewCount":58,"searchKey":869,"visible":15},"10003389",{"type":10,"entryId":870,"sortOrder":871,"name":872,"imageUrl":873,"description":874,"currentMorphology":13,"currentStage":193,"position":875,"attributes":876},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[266],[300],{"id":878,"viewCount":58,"searchKey":879,"visible":15},"10003536",{"type":10,"entryId":880,"sortOrder":881,"name":882,"imageUrl":883,"description":884,"currentMorphology":13,"currentStage":254,"position":885,"attributes":886},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[266],[300],{"id":888,"viewCount":58,"searchKey":889,"visible":15},"10003529",{"type":10,"entryId":890,"sortOrder":891,"name":892,"imageUrl":893,"description":894,"currentMorphology":13,"currentStage":254,"position":895,"attributes":896},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[24],[235],{"id":898,"viewCount":58,"searchKey":899,"visible":15},"10003433",{"type":10,"entryId":900,"sortOrder":901,"name":902,"imageUrl":903,"description":904,"currentMorphology":13,"currentStage":22,"position":905,"attributes":906},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[466],{"id":908,"viewCount":58,"searchKey":909,"visible":15},"10003427",{"type":10,"entryId":910,"sortOrder":911,"name":912,"imageUrl":913,"description":914,"currentMorphology":13,"currentStage":254,"position":915,"attributes":916},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[466],{"id":918,"viewCount":58,"searchKey":919,"visible":15},"10003405",{"type":10,"entryId":920,"sortOrder":921,"name":922,"imageUrl":923,"description":924,"currentMorphology":13,"currentStage":22,"position":925,"attributes":926},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[266],[466],{"id":928,"viewCount":58,"searchKey":929,"visible":15},"10003525",{"type":10,"entryId":930,"sortOrder":931,"name":932,"imageUrl":933,"description":934,"currentMorphology":13,"currentStage":193,"position":935,"attributes":936},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[266],[235,466],{"id":938,"viewCount":58,"searchKey":939,"visible":15},"10003399",{"type":10,"entryId":940,"sortOrder":941,"name":942,"imageUrl":943,"description":944,"currentMorphology":13,"currentStage":254,"position":945,"attributes":946},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[266],[235,466],{"id":948,"viewCount":58,"searchKey":949,"visible":15},"10003518",{"type":10,"entryId":950,"sortOrder":951,"name":952,"imageUrl":953,"description":954,"currentMorphology":13,"currentStage":193,"position":955,"attributes":956},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[266],[466],{"id":958,"viewCount":58,"searchKey":959,"visible":15},"10003393",{"type":10,"entryId":960,"sortOrder":961,"name":962,"imageUrl":963,"description":964,"currentMorphology":13,"currentStage":254,"position":965,"attributes":966},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[266],[466],{"id":968,"viewCount":58,"searchKey":969,"visible":15},"10003386",{"type":10,"entryId":970,"sortOrder":971,"name":972,"imageUrl":973,"description":974,"currentMorphology":13,"currentStage":22,"position":975,"attributes":976},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[298],[466],{"id":978,"viewCount":58,"searchKey":979,"visible":15},"10003447",{"type":10,"entryId":980,"sortOrder":981,"name":982,"imageUrl":983,"description":984,"currentMorphology":13,"currentStage":254,"position":985,"attributes":986},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[298],[466],{"id":988,"viewCount":58,"searchKey":989,"visible":15},"10003497",{"type":10,"entryId":990,"sortOrder":991,"name":992,"imageUrl":993,"description":994,"currentMorphology":13,"currentStage":22,"position":995,"attributes":996},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[298],[26],{"id":998,"viewCount":58,"searchKey":999,"visible":15},"10003479",{"type":10,"entryId":1000,"sortOrder":1001,"name":1002,"imageUrl":1003,"description":1004,"currentMorphology":13,"currentStage":193,"position":1005,"attributes":1006},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[298],[26],{"id":1008,"viewCount":58,"searchKey":1009,"visible":15},"10003388",{"type":10,"entryId":1010,"sortOrder":1011,"name":1012,"imageUrl":1013,"description":1014,"currentMorphology":13,"currentStage":254,"position":1015,"attributes":1016},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[298],[26],{"id":1018,"viewCount":58,"searchKey":1019,"visible":15},"10003429",{"type":10,"entryId":1020,"sortOrder":1021,"name":1022,"imageUrl":1023,"description":1024,"currentMorphology":13,"currentStage":22,"position":1025,"attributes":1026},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[394],[363],{"id":1028,"viewCount":58,"searchKey":1029,"visible":15},"10003430",{"type":10,"entryId":1030,"sortOrder":1031,"name":1032,"imageUrl":1033,"description":1034,"currentMorphology":13,"currentStage":254,"position":1035,"attributes":1036},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[394],[363],{"id":1038,"viewCount":58,"searchKey":1039,"visible":15},"10003549",{"type":10,"entryId":1040,"sortOrder":1041,"name":1042,"imageUrl":1043,"description":1044,"currentMorphology":13,"currentStage":220,"position":1045,"attributes":1046},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[394],[26],{"id":1048,"viewCount":58,"searchKey":1049,"visible":15},"10003494",{"type":10,"entryId":1050,"sortOrder":1051,"name":1052,"imageUrl":1053,"description":1054,"currentMorphology":13,"currentStage":22,"position":1055,"attributes":1056},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[394],[466,363],{"id":1058,"viewCount":58,"searchKey":1059,"visible":15},"10003486",{"type":10,"entryId":1060,"sortOrder":1061,"name":1062,"imageUrl":1063,"description":1064,"currentMorphology":13,"currentStage":254,"position":1065,"attributes":1066},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[394],[466,363],{"id":1068,"viewCount":58,"searchKey":1069,"visible":15},"10003530",{"type":10,"entryId":1070,"sortOrder":1071,"name":1072,"imageUrl":1073,"description":1074,"currentMorphology":13,"currentStage":22,"position":1075,"attributes":1076},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[266],[384],{"id":1078,"viewCount":58,"searchKey":1079,"visible":15},"10003457",{"type":10,"entryId":1080,"sortOrder":1081,"name":1082,"imageUrl":1083,"description":1084,"currentMorphology":13,"currentStage":254,"position":1085,"attributes":1086},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[266],[384],{"id":1088,"viewCount":58,"searchKey":1089,"visible":15},"10003423",{"type":10,"entryId":1090,"sortOrder":1091,"name":1092,"imageUrl":1093,"description":1094,"currentMorphology":13,"currentStage":22,"position":1095,"attributes":1096},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[361],[341,363],{"id":1098,"viewCount":58,"searchKey":1099,"visible":15},"10003419",{"type":10,"entryId":1100,"sortOrder":1101,"name":1102,"imageUrl":1103,"description":1104,"currentMorphology":13,"currentStage":254,"position":1105,"attributes":1106},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[361],[341,363],{"id":1108,"viewCount":58,"searchKey":1109,"visible":15},"10003410",{"type":10,"entryId":1110,"sortOrder":1111,"name":1112,"imageUrl":1113,"description":1114,"currentMorphology":13,"currentStage":22,"position":1115,"attributes":1116},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[363],{"id":1118,"viewCount":58,"searchKey":1119,"visible":15},"10003509",{"type":10,"entryId":1120,"sortOrder":1121,"name":1122,"imageUrl":1123,"description":1124,"currentMorphology":13,"currentStage":254,"position":1125,"attributes":1126},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[363],{"id":1128,"viewCount":58,"searchKey":1129,"visible":15},"10003413",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":13,"currentStage":22,"position":1135,"attributes":1136},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[384],{"id":1138,"viewCount":58,"searchKey":1139,"visible":15},"10003407",{"type":10,"entryId":1140,"sortOrder":1141,"name":1142,"imageUrl":1143,"description":1144,"currentMorphology":13,"currentStage":254,"position":1145,"attributes":1146},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[384],{"id":1148,"viewCount":58,"searchKey":1149,"visible":15},"10003498",{"type":10,"entryId":1150,"sortOrder":1151,"name":1152,"imageUrl":1153,"description":1154,"currentMorphology":13,"currentStage":220,"position":1155,"attributes":1156},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1157],"attributes-holy",{"id":1159,"viewCount":58,"searchKey":1160,"visible":15},"10003375",{"type":10,"entryId":1161,"sortOrder":1162,"name":1163,"imageUrl":1164,"description":1165,"currentMorphology":13,"currentStage":220,"position":1166,"attributes":1167},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1157],[1169,1177,1182,1187,1192,1197,1202,1206,1210,1214,1219,1224,1229,1234,1239,1244,1249,1254,1257],{"id":1170,"parentId":1171,"tagType":1172,"tagKey":1173,"name":1174,"language":1175,"sort":1176},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1178,"parentId":1171,"tagType":1172,"tagKey":1179,"name":1180,"language":1175,"sort":1181},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1183,"parentId":1171,"tagType":1172,"tagKey":1184,"name":1185,"language":1175,"sort":1186},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1188,"parentId":1171,"tagType":1172,"tagKey":1189,"name":1190,"language":1175,"sort":1191},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1193,"parentId":1171,"tagType":1172,"tagKey":1194,"name":1195,"language":1175,"sort":1196},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1198,"parentId":1171,"tagType":1172,"tagKey":1199,"name":1200,"language":1175,"sort":1201},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1203,"parentId":1171,"tagType":1172,"tagKey":9,"name":1204,"language":1175,"sort":1205},"568127bc77f184cd4308056381642df7","雪地型態",5,{"id":1207,"parentId":1171,"tagType":1172,"tagKey":1208,"name":1209,"language":1175,"sort":121},"5989c0c15477b85af6544dca43428cd7","Rainstorm Form","雨天型態",{"id":1211,"parentId":1171,"tagType"