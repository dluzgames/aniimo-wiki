:145,"consume":146,"power":147},[144],"2",[21],"10","33",{"id":149,"type":116,"props":150},"91268443_28",{"id":151,"customKey":45,"icon":152,"iconStyle":61,"iconTitle":45,"descTitle":153,"descContent":154,"source":155},"91268443_29","/cdn/init/1042100_Skill_10200340_Icon.png","鬼步","向目標突進發動攻擊，命中時回復5%最大生命值。",{"attributes":156,"type":157,"consume":146,"power":158},[144],[21],"13",{"id":160,"title":161,"children":162},"91268443_30","固有技能",[163],{"id":164,"type":116,"props":165},"91268443_31",{"id":166,"customKey":45,"icon":167,"iconStyle":61,"iconTitle":45,"descTitle":168,"descContent":169,"source":170},"91268443_32","/cdn/init/1042100_Skill_12800000_Icon.png","攻擊","使用冰元素能力，近距離攻擊目標。",{"attributes":171,"type":172,"consume":173,"power":174},[144],[144],"0","6",[176],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[178,189,199,210,222,232,242,254,264,274,284,295,305,317,327,337,348,358,368,378,388,398,408,419,429,439,449,459,469,479,489,499,509,519,529,539,549,560,570,580,590,600,610,620,630,640,650,660,670,680,690,700,710,720,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1088,1092,1099,1110],{"id":179,"viewCount":55,"searchKey":180,"visible":14},"10003442",{"type":10,"entryId":181,"sortOrder":182,"name":183,"imageUrl":184,"description":185,"currentMorphology":9,"currentStage":21,"position":186,"attributes":187},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[188],"attributes-fire",{"id":190,"viewCount":55,"searchKey":191,"visible":14},"10003534",{"type":10,"entryId":192,"sortOrder":193,"name":194,"imageUrl":195,"description":196,"currentMorphology":9,"currentStage":144,"position":197,"attributes":198},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[188],{"id":200,"viewCount":55,"searchKey":201,"visible":14},"10003435",{"type":10,"entryId":202,"sortOrder":203,"name":204,"imageUrl":205,"description":206,"currentMorphology":9,"currentStage":207,"position":208,"attributes":209},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[23],[188],{"id":211,"viewCount":55,"searchKey":212,"visible":14},"10003428",{"type":10,"entryId":213,"sortOrder":214,"name":215,"imageUrl":216,"description":217,"currentMorphology":9,"currentStage":207,"position":218,"attributes":220},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[219],"position-break",[188,221],"attributes-dark",{"id":223,"viewCount":55,"searchKey":224,"visible":14},"10003578",{"type":10,"entryId":225,"sortOrder":226,"name":227,"imageUrl":228,"description":229,"currentMorphology":9,"currentStage":21,"position":230,"attributes":231},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[221],{"id":233,"viewCount":55,"searchKey":234,"visible":14},"10003417",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":9,"currentStage":207,"position":240,"attributes":241},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[221],{"id":243,"viewCount":55,"searchKey":244,"visible":14},"10003488",{"type":10,"entryId":245,"sortOrder":246,"name":247,"imageUrl":248,"description":249,"currentMorphology":9,"currentStage":21,"position":250,"attributes":252},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[251],"position-sup",[253],"attributes-wind",{"id":255,"viewCount":55,"searchKey":256,"visible":14},"10003548",{"type":10,"entryId":257,"sortOrder":258,"name":259,"imageUrl":260,"description":261,"currentMorphology":9,"currentStage":207,"position":262,"attributes":263},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[251],[253],{"id":265,"viewCount":55,"searchKey":266,"visible":14},"10003474",{"type":10,"entryId":267,"sortOrder":268,"name":269,"imageUrl":270,"description":271,"currentMorphology":9,"currentStage":207,"position":272,"attributes":273},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[253],{"id":275,"viewCount":55,"searchKey":276,"visible":14},"10003467",{"type":10,"entryId":277,"sortOrder":278,"name":279,"imageUrl":280,"description":281,"currentMorphology":9,"currentStage":207,"position":282,"attributes":283},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[219],[253],{"id":285,"viewCount":55,"searchKey":286,"visible":14},"10003392",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":9,"currentStage":21,"position":292,"attributes":293},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[294],"attributes-grass",{"id":296,"viewCount":55,"searchKey":297,"visible":14},"10003510",{"type":10,"entryId":298,"sortOrder":299,"name":300,"imageUrl":301,"description":302,"currentMorphology":9,"currentStage":207,"position":303,"attributes":304},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[294],{"id":306,"viewCount":55,"searchKey":307,"visible":14},"10003477",{"type":10,"entryId":308,"sortOrder":309,"name":310,"imageUrl":311,"description":312,"currentMorphology":9,"currentStage":21,"position":313,"attributes":315},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[314],"position-heal",[316],"attributes-water",{"id":318,"viewCount":55,"searchKey":319,"visible":14},"10003569",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":144,"position":325,"attributes":326},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[314],[316],{"id":328,"viewCount":55,"searchKey":329,"visible":14},"10003470",{"type":10,"entryId":330,"sortOrder":331,"name":332,"imageUrl":333,"description":334,"currentMorphology":9,"currentStage":207,"position":335,"attributes":336},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[314],[316,25],{"id":338,"viewCount":55,"searchKey":339,"visible":14},"10003463",{"type":10,"entryId":340,"sortOrder":341,"name":342,"imageUrl":343,"description":344,"currentMorphology":9,"currentStage":207,"position":345,"attributes":347},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[346],"position-energy",[294,316],{"id":349,"viewCount":55,"searchKey":350,"visible":14},"10003468",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":9,"currentStage":21,"position":356,"attributes":357},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[251],[253],{"id":359,"viewCount":55,"searchKey":360,"visible":14},"10003365",{"type":10,"entryId":361,"sortOrder":362,"name":363,"imageUrl":364,"description":365,"currentMorphology":9,"currentStage":207,"position":366,"attributes":367},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[251],[253],{"id":369,"viewCount":55,"searchKey":370,"visible":14},"10003461",{"type":10,"entryId":371,"sortOrder":372,"name":373,"imageUrl":374,"description":375,"currentMorphology":9,"currentStage":207,"position":376,"attributes":377},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[251],[221],{"id":379,"viewCount":55,"searchKey":380,"visible":14},"10003421",{"type":10,"entryId":381,"sortOrder":382,"name":383,"imageUrl":384,"description":385,"currentMorphology":9,"currentStage":21,"position":386,"attributes":387},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[219],[294],{"id":389,"viewCount":55,"searchKey":390,"visible":14},"10003414",{"type":10,"entryId":391,"sortOrder":392,"name":393,"imageUrl":394,"description":395,"currentMorphology":9,"currentStage":207,"position":396,"attributes":397},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[346],[221,294],{"id":399,"viewCount":55,"searchKey":400,"visible":14},"10003404",{"type":10,"entryId":401,"sortOrder":402,"name":403,"imageUrl":404,"description":405,"currentMorphology":9,"currentStage":207,"position":406,"attributes":407},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[219],[294],{"id":409,"viewCount":55,"searchKey":410,"visible":14},"10003567",{"type":10,"entryId":411,"sortOrder":412,"name":413,"imageUrl":414,"description":415,"currentMorphology":9,"currentStage":21,"position":416,"attributes":417},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[219],[418,294],"attributes-rock",{"id":420,"viewCount":55,"searchKey":421,"visible":14},"10003462",{"type":10,"entryId":422,"sortOrder":423,"name":424,"imageUrl":425,"description":426,"currentMorphology":9,"currentStage":207,"position":427,"attributes":428},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[219],[418,294],{"id":430,"viewCount":55,"searchKey":431,"visible":14},"10003551",{"type":10,"entryId":432,"sortOrder":433,"name":434,"imageUrl":435,"description":436,"currentMorphology":9,"currentStage":207,"position":437,"attributes":438},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[219],[25],{"id":440,"viewCount":55,"searchKey":441,"visible":14},"10003409",{"type":10,"entryId":442,"sortOrder":443,"name":444,"imageUrl":445,"description":446,"currentMorphology":9,"currentStage":21,"position":447,"attributes":448},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[346],[188],{"id":450,"viewCount":55,"searchKey":451,"visible":14},"10003507",{"type":10,"entryId":452,"sortOrder":453,"name":454,"imageUrl":455,"description":456,"currentMorphology":9,"currentStage":207,"position":457,"attributes":458},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[346],[188],{"id":460,"viewCount":55,"searchKey":461,"visible":14},"10003542",{"type":10,"entryId":462,"sortOrder":463,"name":464,"imageUrl":465,"description":466,"currentMorphology":9,"currentStage":21,"position":467,"attributes":468},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[314],[253],{"id":470,"viewCount":55,"searchKey":471,"visible":14},"10003440",{"type":10,"entryId":472,"sortOrder":473,"name":474,"imageUrl":475,"description":476,"currentMorphology":9,"currentStage":207,"position":477,"attributes":478},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[314],[253],{"id":480,"viewCount":55,"searchKey":481,"visible":14},"10003563",{"type":10,"entryId":482,"sortOrder":483,"name":484,"imageUrl":485,"description":486,"currentMorphology":9,"currentStage":173,"position":487,"attributes":488},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[346],[253,294],{"id":490,"viewCount":55,"searchKey":491,"visible":14},"10003368",{"type":10,"entryId":492,"sortOrder":493,"name":494,"imageUrl":495,"description":496,"currentMorphology":9,"currentStage":21,"position":497,"attributes":498},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[251],[253],{"id":500,"viewCount":55,"searchKey":501,"visible":14},"10003363",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":9,"currentStage":207,"position":507,"attributes":508},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[251],[253],{"id":510,"viewCount":55,"searchKey":511,"visible":14},"10003515",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":9,"currentStage":21,"position":517,"attributes":518},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[294],{"id":520,"viewCount":55,"searchKey":521,"visible":14},"10003496",{"type":10,"entryId":522,"sortOrder":523,"name":524,"imageUrl":525,"description":526,"currentMorphology":9,"currentStage":207,"position":527,"attributes":528},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[294],{"id":530,"viewCount":55,"searchKey":531,"visible":14},"10003378",{"type":10,"entryId":532,"sortOrder":533,"name":534,"imageUrl":535,"description":536,"currentMorphology":9,"currentStage":207,"position":537,"attributes":538},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[251],[294],{"id":540,"viewCount":55,"searchKey":541,"visible":14},"10003456",{"type":10,"entryId":542,"sortOrder":543,"name":544,"imageUrl":545,"description":546,"currentMorphology":9,"currentStage":21,"position":547,"attributes":548},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[219],[294],{"id":550,"viewCount":55,"searchKey":551,"visible":14},"10003374",{"type":10,"entryId":552,"sortOrder":553,"name":554,"imageUrl":555,"description":556,"currentMorphology":9,"currentStage":207,"position":557,"attributes":558},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[251],[559],"attributes-electric",{"id":561,"viewCount":55,"searchKey":562,"visible":14},"10003443",{"type":10,"entryId":563,"sortOrder":564,"name":565,"imageUrl":566,"description":567,"currentMorphology":9,"currentStage":207,"position":568,"attributes":569},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[219],[294],{"id":571,"viewCount":55,"searchKey":572,"visible":14},"10003503",{"type":10,"entryId":573,"sortOrder":574,"name":575,"imageUrl":576,"description":577,"currentMorphology":9,"currentStage":21,"position":578,"attributes":579},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[251],[221],{"id":581,"viewCount":55,"searchKey":582,"visible":14},"10003521",{"type":10,"entryId":583,"sortOrder":584,"name":585,"imageUrl":586,"description":587,"currentMorphology":9,"currentStage":207,"position":588,"attributes":589},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[251],[221],{"id":591,"viewCount":55,"searchKey":592,"visible":14},"10003508",{"type":10,"entryId":593,"sortOrder":594,"name":595,"imageUrl":596,"description":597,"currentMorphology":9,"currentStage":21,"position":598,"attributes":599},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[221],{"id":601,"viewCount":55,"searchKey":602,"visible":14},"10003369",{"type":10,"entryId":603,"sortOrder":604,"name":605,"imageUrl":606,"description":607,"currentMorphology":9,"currentStage":207,"position":608,"attributes":609},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[221],{"id":611,"viewCount":55,"searchKey":612,"visible":14},"10003501",{"type":10,"entryId":613,"sortOrder":614,"name":615,"imageUrl":616,"description":617,"currentMorphology":9,"currentStage":207,"position":618,"attributes":619},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[559],{"id":621,"viewCount":55,"searchKey":622,"visible":14},"10003422",{"type":10,"entryId":623,"sortOrder":624,"name":625,"imageUrl":626,"description":627,"currentMorphology":9,"currentStage":21,"position":628,"attributes":629},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[25],{"id":631,"viewCount":55,"searchKey":632,"visible":14},"10003575",{"type":10,"entryId":633,"sortOrder":634,"name":635,"imageUrl":636,"description":637,"currentMorphology":9,"currentStage":144,"position":638,"attributes":639},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[25],{"id":641,"viewCount":55,"searchKey":642,"visible":14},"10003415",{"type":10,"entryId":643,"sortOrder":644,"name":645,"imageUrl":646,"description":647,"currentMorphology":9,"currentStage":207,"position":648,"attributes":649},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[25],{"id":651,"viewCount":55,"searchKey":652,"visible":14},"10003524",{"type":10,"entryId":653,"sortOrder":654,"name":655,"imageUrl":656,"description":657,"currentMorphology":9,"currentStage":21,"position":658,"attributes":659},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[219],[559],{"id":661,"viewCount":55,"searchKey":662,"visible":14},"10003475",{"type":10,"entryId":663,"sortOrder":664,"name":665,"imageUrl":666,"description":667,"currentMorphology":9,"currentStage":207,"position":668,"attributes":669},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[219],[559],{"id":671,"viewCount":55,"searchKey":672,"visible":14},"10003523",{"type":10,"entryId":673,"sortOrder":674,"name":675,"imageUrl":676,"description":677,"currentMorphology":9,"currentStage":21,"position":678,"attributes":679},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[219],[316],{"id":681,"viewCount":55,"searchKey":682,"visible":14},"10003398",{"type":10,"entryId":683,"sortOrder":684,"name":685,"imageUrl":686,"description":687,"currentMorphology":9,"currentStage":144,"position":688,"attributes":689},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[219],[316],{"id":691,"viewCount":55,"searchKey":692,"visible":14},"10003516",{"type":10,"entryId":693,"sortOrder":694,"name":695,"imageUrl":696,"description":697,"currentMorphology":9,"currentStage":207,"position":698,"attributes":699},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[251],[316],{"id":701,"viewCount":55,"searchKey":702,"visible":14},"10003566",{"type":10,"entryId":703,"sortOrder":704,"name":705,"imageUrl":706,"description":707,"currentMorphology":9,"currentStage":207,"position":708,"attributes":709},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[219],[316],{"id":711,"viewCount":55,"searchKey":712,"visible":14},"10003453",{"type":10,"entryId":713,"sortOrder":714,"name":715,"imageUrl":716,"description":717,"currentMorphology":9,"currentStage":21,"position":718,"attributes":719},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[316],{"id":721,"viewCount":55,"searchKey":722,"visible":14},"10003577",{"type":10,"entryId":723,"sortOrder":724,"name":725,"imageUrl":726,"description":727,"currentMorphology":9,"currentStage":144,"position":728,"attributes":729},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[316],{"id":731,"viewCount":55,"searchKey":732,"visible":14},"10003570",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":9,"currentStage":207,"position":738,"attributes":739},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[316],{"id":741,"viewCount":55,"searchKey":742,"visible":14},"10003565",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":9,"currentStage":21,"position":748,"attributes":749},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[418],{"id":751,"viewCount":55,"searchKey":752,"visible":14},"10003476",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":9,"currentStage":207,"position":758,"attributes":759},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[418],{"id":761,"viewCount":55,"searchKey":762,"visible":14},"10003466",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":9,"currentStage":207,"position":768,"attributes":769},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[251],[418],{"id":771,"viewCount":55,"searchKey":772,"visible":14},"10003379",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":9,"currentStage":21,"position":778,"attributes":779},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[559],{"id":781,"viewCount":55,"searchKey":782,"visible":14},"10003376",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":9,"currentStage":207,"position":788,"attributes":789},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[559],{"id":791,"viewCount":55,"searchKey":792,"visible":14},"10003543",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":9,"currentStage":21,"position":798,"attributes":799},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[219],[221],{"id":801,"viewCount":55,"searchKey":802,"visible":14},"10003557",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":9,"currentStage":207,"position":808,"attributes":809},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[221],{"id":811,"viewCount":55,"searchKey":812,"visible":14},"10003522",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":9,"currentStage":207,"position":818,"attributes":819},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[219],[221],{"id":821,"viewCount":55,"searchKey":822,"visible":14},"10003579",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":9,"currentStage":21,"position":828,"attributes":829},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[219],[253],{"id":831,"viewCount":55,"searchKey":832,"visible":14},"10003389",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":9,"currentStage":144,"position":838,"attributes":839},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[219],[253],{"id":841,"viewCount":55,"searchKey":842,"visible":14},"10003536",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":9,"currentStage":207,"position":848,"attributes":849},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[219],[253],{"id":851,"viewCount":55,"searchKey":852,"visible":14},"10003529",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":9,"currentStage":207,"position":858,"attributes":859},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[188],{"id":861,"viewCount":55,"searchKey":862,"visible":14},"10003433",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":9,"currentStage":21,"position":868,"attributes":869},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[418],{"id":871,"viewCount":55,"searchKey":872,"visible":14},"10003427",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":9,"currentStage":207,"position":878,"attributes":879},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[418],{"id":881,"viewCount":55,"searchKey":882,"visible":14},"10003405",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":9,"currentStage":21,"position":888,"attributes":889},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[219],[418],{"id":891,"viewCount":55,"searchKey":892,"visible":14},"10003525",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":9,"currentStage":144,"position":898,"attributes":899},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[219],[188,418],{"id":901,"viewCount":55,"searchKey":902,"visible":14},"10003399",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":9,"currentStage":207,"position":908,"attributes":909},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[219],[188,418],{"id":911,"viewCount":55,"searchKey":912,"visible":14},"10003518",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":9,"currentStage":144,"position":918,"attributes":919},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[219],[418],{"id":921,"viewCount":55,"searchKey":922,"visible":14},"10003393",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":9,"currentStage":207,"position":928,"attributes":929},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[219],[418],{"id":931,"viewCount":55,"searchKey":932,"visible":14},"10003386",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":9,"currentStage":21,"position":938,"attributes":939},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[251],[418],{"id":941,"viewCount":55,"searchKey":942,"visible":14},"10003447",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":9,"currentStage":207,"position":948,"attributes":949},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[251],[418],{"id":951,"viewCount":55,"searchKey":952,"visible":14},"10003497",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":9,"currentStage":21,"position":958,"attributes":959},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[251],[559],{"id":961,"viewCount":55,"searchKey":962,"visible":14},"10003479",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":9,"currentStage":144,"position":968,"attributes":969},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[251],[559],{"id":971,"viewCount":55,"searchKey":972,"visible":14},"10003388",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":9,"currentStage":207,"position":978,"attributes":979},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[251],[559],{"id":981,"viewCount":55,"searchKey":982,"visible":14},"10003429",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":9,"currentStage":21,"position":988,"attributes":989},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[346],[316],{"id":991,"viewCount":55,"searchKey":992,"visible":14},"10003430",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":9,"currentStage":207,"position":998,"attributes":999},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[346],[316],{"id":1001,"viewCount":55,"searchKey":1002,"visible":14},"10003549",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":9,"currentStage":173,"position":1008,"attributes":1009},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[346],[559],{"id":1011,"viewCount":55,"searchKey":1012,"visible":14},"10003494",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":9,"currentStage":21,"position":1018,"attributes":1019},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[346],[418,316],{"id":1021,"viewCount":55,"searchKey":1022,"visible":14},"10003486",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":9,"currentStage":207,"position":1028,"attributes":1029},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[346],[418,316],{"id":1031,"viewCount":55,"searchKey":1032,"visible":14},"10003530",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":9,"currentStage":21,"position":1038,"attributes":1039},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[219],[25],{"id":1041,"viewCount":55,"searchKey":1042,"visible":14},"10003457",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":9,"currentStage":207,"position":1048,"attributes":1049},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[219],[25],{"id":1051,"viewCount":55,"searchKey":1052,"visible":14},"10003423",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":9,"currentStage":21,"position":1058,"attributes":1059},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[314],[294,316],{"id":1061,"viewCount":55,"searchKey":1062,"visible":14},"10003419",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":9,"currentStage":207,"position":1068,"attributes":1069},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[314],[294,316],{"id":1071,"viewCount":55,"searchKey":1072,"visible":14},"10003410",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":9,"currentStage":21,"position":1078,"attributes":1079},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[316],{"id":5,"viewCount":55,"searchKey":1081,"visible":14},{"type":10,"entryId":8,"sortOrder":1082,"name":1083,"imageUrl":1084,"description":1085,"currentMorphology":9,"currentStage":207,"position":1086,"attributes":1087},1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[316],{"id":4,"viewCount":55,"searchKey":1089,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1090,"attributes":1091},[23],[25],{"id":6,"viewCount":55,"searchKey":1093,"visible":14},{"type":10,"entryId":12,"sortOrder":1094,"name":78,"imageUrl":1095,"description":1096,"currentMorphology":9,"currentStage":207,"position":1097,"attributes":1098},1042300,"/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[25],{"id":1100,"viewCount":55,"searchKey":1101,"visible":14},"10003498",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":9,"currentStage":173,"position":1107,"attributes":1108},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1109],"attributes-holy",{"id":1111,"viewCount":55,"searchKey":1112,"visible":14},"10003375",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":9,"currentStage":173,"position":1118,"attributes":1119},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1109],[1121,1129,1134,1139,1144,1149,1154,1159,1163,1167,1172,1177,1182,1187,1192,1197,1202,1207,1210],{"id":1122,"parentId":1123,"tagType":1124,"tagKey":1125,"name":1126,"language":1127,"sort":1128},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1130,"parentId":1123,"tagType":1124,"tagKey":1131,"name":1132,"language":1127,"sort":1133},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1135,"parentId":1123,"tagType":1124,"tagKey":1136,"name":1137,"language":1127,"sort":1138},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1140,"parentId":1123,"tagType":1124,"tagKey":1141,"name":1142,"language":1127,"sort":1143},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1145,"parentId":1123,"tagType":1124,"tagKey":1146,"name":1147,"language":1127,"sort":1148},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1150,"parentId":1123,"tagType":1124,"tagKey":1151,"name":1152,"language":1127,"sort":1153},"5264