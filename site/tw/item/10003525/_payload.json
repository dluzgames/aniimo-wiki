":60},"91268556_20",{"id":146,"customKey":147,"title":148,"icon":47,"bgColor":47,"fontColor":47,"type":137},"91268556_21","home-1100","1",{"id":59,"title":150,"components":151},"伊莫能力",[152,169],{"id":153,"type":63,"props":154,"children":157},"91268556_26",{"title":155,"type":66,"id":156,"isUse":14,"isEdit":14,"useTabs":68,"blackHeader":68},"伊莫特性","91268556_27",[158],{"id":159,"type":160,"props":161,"children":60},"91268556_28","circle",{"id":162,"customKey":47,"icon":163,"iconStyle":66,"iconTitle":47,"descTitle":164,"descContent":165,"source":166},"91268556_29","/cdn/init/1028200_Feature_128301_Icon.png","活性化","累積消耗50點能量後，獲得「活性化」效果，每2秒為周圍的目標附加一層「火元素異常」，持續10秒。",{"attributes":167,"type":168,"consume":47,"power":47},[],[],{"id":170,"type":63,"props":171,"children":60},"91268556_30",{"title":172,"type":66,"id":173,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":68,"tabs":174},"技能介紹","91268556_31",[175,204],{"id":176,"title":177,"children":178},"91268556_32","戰鬥技能",[179,192],{"id":180,"type":160,"props":181},"91268556_33",{"id":182,"customKey":47,"icon":183,"iconStyle":66,"iconTitle":47,"descTitle":184,"descContent":185,"source":186},"91268556_34","/cdn/init/1028200_Skill_10500450_Icon.png","火焰衝拳","衝刺出拳造成傷害並貫穿目標，同時清除目標所有「火元素異常」，每層「火元素異常」可以額外造成5%威力的傷害。",{"attributes":187,"type":189,"consume":190,"power":191},[188],"5",[148],"10","67",{"id":193,"type":160,"props":194},"91268556_35",{"id":195,"customKey":47,"icon":196,"iconStyle":66,"iconTitle":47,"descTitle":197,"descContent":198,"source":199},"91268556_36","/cdn/init/1028200_Skill_10500440_Icon.png","熔岩吐息","噴射火焰攻擊目標，持續造成傷害，並為命中的目標施加「火元素異常」。",{"attributes":200,"type":201,"consume":202,"power":203},[188],[148],"0","40",{"id":205,"title":206,"children":207},"91268556_37","固有技能",[208],{"id":209,"type":160,"props":210},"91268556_38",{"id":211,"customKey":47,"icon":212,"iconStyle":66,"iconTitle":47,"descTitle":213,"descContent":214,"source":215},"91268556_39","/cdn/init/1028200_Skill_16400000_Icon.png","攻擊","擊破使用火元素能力，近距離攻擊目標。",{"attributes":216,"type":217,"consume":202,"power":218},[188],[148],"6",[220],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[222,233,243,254,265,275,285,297,307,317,327,338,348,360,370,381,392,402,412,422,432,442,452,462,472,482,492,502,512,522,532,542,552,562,572,582,592,603,613,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,893,903,913,923,930,934,941,950,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1139,1150],{"id":223,"viewCount":60,"searchKey":224,"visible":14},"10003442",{"type":10,"entryId":225,"sortOrder":226,"name":227,"imageUrl":228,"description":229,"currentMorphology":9,"currentStage":148,"position":230,"attributes":232},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[231],"position-dps",[25],{"id":234,"viewCount":60,"searchKey":235,"visible":14},"10003534",{"type":10,"entryId":236,"sortOrder":237,"name":238,"imageUrl":239,"description":240,"currentMorphology":9,"currentStage":21,"position":241,"attributes":242},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[231],[25],{"id":244,"viewCount":60,"searchKey":245,"visible":14},"10003435",{"type":10,"entryId":246,"sortOrder":247,"name":248,"imageUrl":249,"description":250,"currentMorphology":9,"currentStage":251,"position":252,"attributes":253},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[231],[25],{"id":255,"viewCount":60,"searchKey":256,"visible":14},"10003428",{"type":10,"entryId":257,"sortOrder":258,"name":259,"imageUrl":260,"description":261,"currentMorphology":9,"currentStage":251,"position":262,"attributes":263},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[23],[25,264],"attributes-dark",{"id":266,"viewCount":60,"searchKey":267,"visible":14},"10003578",{"type":10,"entryId":268,"sortOrder":269,"name":270,"imageUrl":271,"description":272,"currentMorphology":9,"currentStage":148,"position":273,"attributes":274},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[231],[264],{"id":276,"viewCount":60,"searchKey":277,"visible":14},"10003417",{"type":10,"entryId":278,"sortOrder":279,"name":280,"imageUrl":281,"description":282,"currentMorphology":9,"currentStage":251,"position":283,"attributes":284},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[231],[264],{"id":286,"viewCount":60,"searchKey":287,"visible":14},"10003488",{"type":10,"entryId":288,"sortOrder":289,"name":290,"imageUrl":291,"description":292,"currentMorphology":9,"currentStage":148,"position":293,"attributes":295},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[294],"position-sup",[296],"attributes-wind",{"id":298,"viewCount":60,"searchKey":299,"visible":14},"10003548",{"type":10,"entryId":300,"sortOrder":301,"name":302,"imageUrl":303,"description":304,"currentMorphology":9,"currentStage":251,"position":305,"attributes":306},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[294],[296],{"id":308,"viewCount":60,"searchKey":309,"visible":14},"10003474",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":9,"currentStage":251,"position":315,"attributes":316},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[231],[296],{"id":318,"viewCount":60,"searchKey":319,"visible":14},"10003467",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":251,"position":325,"attributes":326},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[23],[296],{"id":328,"viewCount":60,"searchKey":329,"visible":14},"10003392",{"type":10,"entryId":330,"sortOrder":331,"name":332,"imageUrl":333,"description":334,"currentMorphology":9,"currentStage":148,"position":335,"attributes":336},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[231],[337],"attributes-grass",{"id":339,"viewCount":60,"searchKey":340,"visible":14},"10003510",{"type":10,"entryId":341,"sortOrder":342,"name":343,"imageUrl":344,"description":345,"currentMorphology":9,"currentStage":251,"position":346,"attributes":347},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[231],[337],{"id":349,"viewCount":60,"searchKey":350,"visible":14},"10003477",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":9,"currentStage":148,"position":356,"attributes":358},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[357],"position-heal",[359],"attributes-water",{"id":361,"viewCount":60,"searchKey":362,"visible":14},"10003569",{"type":10,"entryId":363,"sortOrder":364,"name":365,"imageUrl":366,"description":367,"currentMorphology":9,"currentStage":21,"position":368,"attributes":369},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[357],[359],{"id":371,"viewCount":60,"searchKey":372,"visible":14},"10003470",{"type":10,"entryId":373,"sortOrder":374,"name":375,"imageUrl":376,"description":377,"currentMorphology":9,"currentStage":251,"position":378,"attributes":379},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[357],[359,380],"attributes-ice",{"id":382,"viewCount":60,"searchKey":383,"visible":14},"10003463",{"type":10,"entryId":384,"sortOrder":385,"name":386,"imageUrl":387,"description":388,"currentMorphology":9,"currentStage":251,"position":389,"attributes":391},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[390],"position-energy",[337,359],{"id":393,"viewCount":60,"searchKey":394,"visible":14},"10003468",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":9,"currentStage":148,"position":400,"attributes":401},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[294],[296],{"id":403,"viewCount":60,"searchKey":404,"visible":14},"10003365",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":9,"currentStage":251,"position":410,"attributes":411},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[294],[296],{"id":413,"viewCount":60,"searchKey":414,"visible":14},"10003461",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":9,"currentStage":251,"position":420,"attributes":421},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[294],[264],{"id":423,"viewCount":60,"searchKey":424,"visible":14},"10003421",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":9,"currentStage":148,"position":430,"attributes":431},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[23],[337],{"id":433,"viewCount":60,"searchKey":434,"visible":14},"10003414",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":9,"currentStage":251,"position":440,"attributes":441},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[390],[264,337],{"id":443,"viewCount":60,"searchKey":444,"visible":14},"10003404",{"type":10,"entryId":445,"sortOrder":446,"name":447,"imageUrl":448,"description":449,"currentMorphology":9,"currentStage":251,"position":450,"attributes":451},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[23],[337],{"id":453,"viewCount":60,"searchKey":454,"visible":14},"10003567",{"type":10,"entryId":455,"sortOrder":456,"name":457,"imageUrl":458,"description":459,"currentMorphology":9,"currentStage":148,"position":460,"attributes":461},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[23],[26,337],{"id":463,"viewCount":60,"searchKey":464,"visible":14},"10003462",{"type":10,"entryId":465,"sortOrder":466,"name":467,"imageUrl":468,"description":469,"currentMorphology":9,"currentStage":251,"position":470,"attributes":471},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[23],[26,337],{"id":473,"viewCount":60,"searchKey":474,"visible":14},"10003551",{"type":10,"entryId":475,"sortOrder":476,"name":477,"imageUrl":478,"description":479,"currentMorphology":9,"currentStage":251,"position":480,"attributes":481},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[23],[380],{"id":483,"viewCount":60,"searchKey":484,"visible":14},"10003409",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":9,"currentStage":148,"position":490,"attributes":491},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[390],[25],{"id":493,"viewCount":60,"searchKey":494,"visible":14},"10003507",{"type":10,"entryId":495,"sortOrder":496,"name":497,"imageUrl":498,"description":499,"currentMorphology":9,"currentStage":251,"position":500,"attributes":501},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[390],[25],{"id":503,"viewCount":60,"searchKey":504,"visible":14},"10003542",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":9,"currentStage":148,"position":510,"attributes":511},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[357],[296],{"id":513,"viewCount":60,"searchKey":514,"visible":14},"10003440",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":9,"currentStage":251,"position":520,"attributes":521},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[357],[296],{"id":523,"viewCount":60,"searchKey":524,"visible":14},"10003563",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":9,"currentStage":202,"position":530,"attributes":531},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[390],[296,337],{"id":533,"viewCount":60,"searchKey":534,"visible":14},"10003368",{"type":10,"entryId":535,"sortOrder":536,"name":537,"imageUrl":538,"description":539,"currentMorphology":9,"currentStage":148,"position":540,"attributes":541},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[294],[296],{"id":543,"viewCount":60,"searchKey":544,"visible":14},"10003363",{"type":10,"entryId":545,"sortOrder":546,"name":547,"imageUrl":548,"description":549,"currentMorphology":9,"currentStage":251,"position":550,"attributes":551},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[294],[296],{"id":553,"viewCount":60,"searchKey":554,"visible":14},"10003515",{"type":10,"entryId":555,"sortOrder":556,"name":557,"imageUrl":558,"description":559,"currentMorphology":9,"currentStage":148,"position":560,"attributes":561},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[231],[337],{"id":563,"viewCount":60,"searchKey":564,"visible":14},"10003496",{"type":10,"entryId":565,"sortOrder":566,"name":567,"imageUrl":568,"description":569,"currentMorphology":9,"currentStage":251,"position":570,"attributes":571},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[231],[337],{"id":573,"viewCount":60,"searchKey":574,"visible":14},"10003378",{"type":10,"entryId":575,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":9,"currentStage":251,"position":580,"attributes":581},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[294],[337],{"id":583,"viewCount":60,"searchKey":584,"visible":14},"10003456",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":9,"currentStage":148,"position":590,"attributes":591},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[23],[337],{"id":593,"viewCount":60,"searchKey":594,"visible":14},"10003374",{"type":10,"entryId":595,"sortOrder":596,"name":597,"imageUrl":598,"description":599,"currentMorphology":9,"currentStage":251,"position":600,"attributes":601},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[294],[602],"attributes-electric",{"id":604,"viewCount":60,"searchKey":605,"visible":14},"10003443",{"type":10,"entryId":606,"sortOrder":607,"name":608,"imageUrl":609,"description":610,"currentMorphology":9,"currentStage":251,"position":611,"attributes":612},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[23],[337],{"id":614,"viewCount":60,"searchKey":615,"visible":14},"10003503",{"type":10,"entryId":616,"sortOrder":617,"name":618,"imageUrl":619,"description":620,"currentMorphology":9,"currentStage":148,"position":621,"attributes":622},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[294],[264],{"id":624,"viewCount":60,"searchKey":625,"visible":14},"10003521",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":9,"currentStage":251,"position":631,"attributes":632},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[294],[264],{"id":634,"viewCount":60,"searchKey":635,"visible":14},"10003508",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":9,"currentStage":148,"position":641,"attributes":642},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[231],[264],{"id":644,"viewCount":60,"searchKey":645,"visible":14},"10003369",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":9,"currentStage":251,"position":651,"attributes":652},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[231],[264],{"id":654,"viewCount":60,"searchKey":655,"visible":14},"10003501",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":9,"currentStage":251,"position":661,"attributes":662},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[231],[602],{"id":664,"viewCount":60,"searchKey":665,"visible":14},"10003422",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":9,"currentStage":148,"position":671,"attributes":672},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[231],[380],{"id":674,"viewCount":60,"searchKey":675,"visible":14},"10003575",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":9,"currentStage":21,"position":681,"attributes":682},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[231],[380],{"id":684,"viewCount":60,"searchKey":685,"visible":14},"10003415",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":9,"currentStage":251,"position":691,"attributes":692},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[231],[380],{"id":694,"viewCount":60,"searchKey":695,"visible":14},"10003524",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":9,"currentStage":148,"position":701,"attributes":702},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[23],[602],{"id":704,"viewCount":60,"searchKey":705,"visible":14},"10003475",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":9,"currentStage":251,"position":711,"attributes":712},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[23],[602],{"id":714,"viewCount":60,"searchKey":715,"visible":14},"10003523",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":9,"currentStage":148,"position":721,"attributes":722},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[23],[359],{"id":724,"viewCount":60,"searchKey":725,"visible":14},"10003398",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":9,"currentStage":21,"position":731,"attributes":732},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[23],[359],{"id":734,"viewCount":60,"searchKey":735,"visible":14},"10003516",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":9,"currentStage":251,"position":741,"attributes":742},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[294],[359],{"id":744,"viewCount":60,"searchKey":745,"visible":14},"10003566",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":9,"currentStage":251,"position":751,"attributes":752},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[23],[359],{"id":754,"viewCount":60,"searchKey":755,"visible":14},"10003453",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":9,"currentStage":148,"position":761,"attributes":762},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[231],[359],{"id":764,"viewCount":60,"searchKey":765,"visible":14},"10003577",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":9,"currentStage":21,"position":771,"attributes":772},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[231],[359],{"id":774,"viewCount":60,"searchKey":775,"visible":14},"10003570",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":9,"currentStage":251,"position":781,"attributes":782},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[231],[359],{"id":784,"viewCount":60,"searchKey":785,"visible":14},"10003565",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":9,"currentStage":148,"position":791,"attributes":792},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[231],[26],{"id":794,"viewCount":60,"searchKey":795,"visible":14},"10003476",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":9,"currentStage":251,"position":801,"attributes":802},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[231],[26],{"id":804,"viewCount":60,"searchKey":805,"visible":14},"10003466",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":9,"currentStage":251,"position":811,"attributes":812},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[294],[26],{"id":814,"viewCount":60,"searchKey":815,"visible":14},"10003379",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":9,"currentStage":148,"position":821,"attributes":822},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[231],[602],{"id":824,"viewCount":60,"searchKey":825,"visible":14},"10003376",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":9,"currentStage":251,"position":831,"attributes":832},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[231],[602],{"id":834,"viewCount":60,"searchKey":835,"visible":14},"10003543",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":9,"currentStage":148,"position":841,"attributes":842},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[23],[264],{"id":844,"viewCount":60,"searchKey":845,"visible":14},"10003557",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":9,"currentStage":251,"position":851,"attributes":852},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[231],[264],{"id":854,"viewCount":60,"searchKey":855,"visible":14},"10003522",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":9,"currentStage":251,"position":861,"attributes":862},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[23],[264],{"id":864,"viewCount":60,"searchKey":865,"visible":14},"10003579",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":9,"currentStage":148,"position":871,"attributes":872},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[23],[296],{"id":874,"viewCount":60,"searchKey":875,"visible":14},"10003389",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":9,"currentStage":21,"position":881,"attributes":882},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[23],[296],{"id":884,"viewCount":60,"searchKey":885,"visible":14},"10003536",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":9,"currentStage":251,"position":891,"attributes":892},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[23],[296],{"id":894,"viewCount":60,"searchKey":895,"visible":14},"10003529",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":9,"currentStage":251,"position":901,"attributes":902},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[231],[25],{"id":904,"viewCount":60,"searchKey":905,"visible":14},"10003433",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":9,"currentStage":148,"position":911,"attributes":912},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[231],[26],{"id":914,"viewCount":60,"searchKey":915,"visible":14},"10003427",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":9,"currentStage":251,"position":921,"attributes":922},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[231],[26],{"id":5,"viewCount":60,"searchKey":924,"visible":14},{"type":10,"entryId":8,"sortOrder":925,"name":76,"imageUrl":926,"description":927,"currentMorphology":9,"currentStage":148,"position":928,"attributes":929},1028100,"/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[23],[26],{"id":4,"viewCount":60,"searchKey":931,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":932,"attributes":933},[23],[25,26],{"id":6,"viewCount":60,"searchKey":935,"visible":14},{"type":10,"entryId":12,"sortOrder":936,"name":89,"imageUrl":937,"description":938,"currentMorphology":9,"currentStage":251,"position":939,"attributes":940},1028300,"/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[23],[25,26],{"id":942,"viewCount":60,"searchKey":943,"visible":14},"10003518",{"type":10,"entryId":944,"sortOrder":945,"name":97,"imageUrl":946,"description":947,"currentMorphology":9,"currentStage":21,"position":948,"attributes":949},"074",1028400,"/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[23],[26],{"id":951,"viewCount":60,"searchKey":952,"visible":14},"10003393",{"type":10,"entryId":953,"sortOrder":954,"name":104,"imageUrl":955,"description":956,"currentMorphology":9,"currentStage":251,"position":957,"attributes":958},"075",1028500,"/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[23],[26],{"id":960,"viewCount":60,"searchKey":961,"visible":14},"10003386",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":9,"currentStage":148,"position":967,"attributes":968},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[294],[26],{"id":970,"viewCount":60,"searchKey":971,"visible":14},"10003447",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":9,"currentStage":251,"position":977,"attributes":978},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[294],[26],{"id":980,"viewCount":60,"searchKey":981,"visible":14},"10003497",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":9,"currentStage":148,"position":987,"attributes":988},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[294],[602],{"id":990,"viewCount":60,"searchKey":991,"visible":14},"10003479",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":9,"currentStage":21,"position":997,"attributes":998},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[294],[602],{"id":1000,"viewCount":60,"searchKey":1001,"visible":14},"10003388",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":9,"currentStage":251,"position":1007,"attributes":1008},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[294],[602],{"id":1010,"viewCount":60,"searchKey":1011,"visible":14},"10003429",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":9,"currentStage":148,"position":1017,"attributes":1018},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[390],[359],{"id":1020,"viewCount":60,"searchKey":1021,"visible":14},"10003430",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":9,"currentStage":251,"position":1027,"attributes":1028},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[390],[359],{"id":1030,"viewCount":60,"searchKey":1031,"visible":14},"10003549",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":9,"currentStage":202,"position":1037,"attributes":1038},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[390],[602],{"id":1040,"viewCount":60,"searchKey":1041,"visible":14},"10003494",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":9,"currentStage":148,"position":1047,"attributes":1048},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[390],[26,359],{"id":1050,"viewCount":60,"searchKey":1051,"visible":14},"10003486",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":9,"currentStage":251,"position":1057,"attributes":1058},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[390],[26,359],{"id":1060,"viewCount":60,"searchKey":1061,"visible":14},"10003530",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":9,"currentStage":148,"position":1067,"attributes":1068},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[23],[380],{"id":1070,"viewCount":60,"searchKey":1071,"visible":14},"10003457",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":9,"currentStage":251,"position":1077,"attributes":1078},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[23],[380],{"id":1080,"viewCount":60,"searchKey":1081,"visible":14},"10003423",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":9,"currentStage":148,"position":1087,"attributes":1088},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[357],[337,359],{"id":1090,"viewCount":60,"searchKey":1091,"visible":14},"10003419",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":9,"currentStage":251,"position":1097,"attributes":1098},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[357],[337,359],{"id":1100,"viewCount":60,"searchKey":1101,"visible":14},"10003410",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":9,"currentStage":148,"position":1107,"attributes":1108},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[231],[359],{"id":1110,"viewCount":60,"searchKey":1111,"visible":14},"10003509",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":9,"currentStage":251,"position":1117,"attributes":1118},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[231],[359],{"id":1120,"viewCount":60,"searchKey":1121,"visible":14},"10003413",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":9,"currentStage":148,"position":1127,"attributes":1128},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[231],[380],{"id":1130,"viewCount":60,"searchKey":1131,"visible":14},"10003407",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":9,"currentStage":251,"position":1137,"attributes":1138},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[231],[380],{"id":1140,"viewCount":60,"searchKey":1141,"visible":14},"10003498",{"type":10,"entryId":1142,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":9,"currentStage":202,"position":1147,"attributes":1148},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[231],[1149],"attributes-holy",{"id":1151,"viewCount":60,"searchKey":1152,"visib