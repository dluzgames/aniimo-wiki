[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"aniimo-detail-10003378-tw":3,"header-aniimo-list-tw":221,"morphology-tags-tw":1164},{"id":4,"previousId":5,"nextId":6,"previousAnchor":7,"nextAnchor":11,"viewCount":14,"visible":15,"searchKey":16,"directories":27,"morphologyList":219},"10003378","10003511","10003456",{"entryId":8,"currentMorphology":9,"type":10},"035","Umbrabow Form","ANIIMO",{"entryId":12,"currentMorphology":13,"type":10},"037","Basic Form",561,true,{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":23,"attributes":25},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。","3",[24],"position-sup",[26],"attributes-grass",[28,127],{"id":29,"title":30,"components":31},1,"基本資訊",[32,60,94,110],{"id":33,"type":34,"props":35,"children":59},"91268408_0","aniimoInfo",{"id":36,"formData":37},"91268408_1",{"name":19,"sortOrder":29,"serialNumber":17,"heightMin":38,"heightMax":38,"weightMin":39,"weightMax":40,"attributes":41,"position":42,"gender":43,"desc":21,"maleImage":20,"femaleImage":20,"noGenderImage":20,"illustrationImage":46,"backgroundImage":47,"attributeValue":48,"hp":49,"magicAttack":50,"physicalAttack":51,"magicDefense":52,"haste":53,"physicalDefense":52,"displayNames":54,"currentMorphology":13,"currentStage":58,"femaleIllustrationImage":47,"maleIllustrationImage":47},0,23.4,34.93,[26],[24],[44,45],"male","female","/cdn/Vfx/1032400.mp4","",512,95,91,108,70,78,{"maleImage":55,"femaleImage":56,"illustrationImage":57,"backgroundImage":47,"noGenderImage":47},"Stellarys.png","Scorchhowl.png","evolutionarySpirit.png",3,null,{"id":61,"type":62,"props":63,"children":68},"91268408_2","crumbTitle",{"title":64,"type":65,"id":66,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"進化路線","big","91268408_3",false,[69],{"id":70,"type":71,"props":72,"children":59},"91268408_4","evolution",{"data":73,"id":93},{"id":74,"name":75,"label":75,"icon":