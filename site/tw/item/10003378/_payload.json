1層「玫瑰印記」，最多疊加10層。每層「玫瑰印記」使魅樂薇能量消耗降低3點。",{"attributes":146,"type":147,"consume":47,"power":47},[],[],{"id":149,"type":62,"props":150,"children":59},"91268408_26",{"title":151,"type":65,"id":152,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":153},"技能介紹","91268408_27",[154,194],{"id":155,"title":156,"children":157},"91268408_28","戰鬥技能",[158,172,184],{"id":159,"type":139,"props":160},"91268408_29",{"id":161,"customKey":47,"icon":162,"iconStyle":65,"iconTitle":47,"descTitle":163,"descContent":164,"source":165},"91268408_30","/cdn/init/1032400_Skill_10600560_Icon.png","荊棘之賜","為全隊附加「荊棘之賜」，對目標造成草元素暴擊傷害時，在其腳下生成棘刺造成傷害，每0.5秒最多觸發1次，持續14秒。",{"attributes":166,"type":168,"consume":170,"power":171},[167],"6",[169],"2","30","14",{"id":173,"type":139,"props":174},"91268408_31",{"id":175,"customKey":47,"icon":176,"iconStyle":65,"iconTitle":47,"descTitle":177,"descContent":178,"source":179},"91268408_32","/cdn/init/1032400_Skill_10600580_Icon.png","治癒薔薇","召喚玫瑰引發爆炸，並對目標施加「薔薇標記」。「薔薇標記」會在目標受到3次暴擊傷害後綻放，基於魅樂薇生命值的5%，治療附近所有友方單位。",{"attributes":180,"type":181,"consume":182,"power":183},[167],[169],"20","40",{"id":185,"type":139,"props":186},"91268408_33",{"id":187,"customKey":47,"icon":188,"iconStyle":65,"iconTitle":47,"descTitle":189,"descContent":190,"source":191},"91268408_34","/cdn/init/1032400_Skill_10600570_Icon.png","爆裂玫瑰","施放花瓣追蹤攻擊目標。技能擁有35%的額外暴擊率。",{"attributes":192,"type":193,"consume":182,"power":183},[167],[169],{"id":195,"title":196,"children":197},"91268408_35","固有技能",[198,209],{"id":199,"type":139,"props":200},"91268408_36",{"id":201,"customKey":47,"icon":202,"iconStyle":65,"iconTitle":47,"descTitle":203,"descContent":204,"source":205},"91268408_37","/cdn/init/1032400_Skill_10600590_Icon.png","玫瑰之庭","在腳下創造圓形魔法陣。範圍內友方的草元素暴擊傷害提高70%，持續30秒。",{"attributes":206,"type":207,"consume":208,"power":208},[167],[208],"0",{"id":210,"type":139,"props":211},"91268408_38",{"id":212,"customKey":47,"icon":213,"iconStyle":65,"iconTitle":47,"descTitle":214,"descContent":215,"source":216},"91268408_39","/cdn/init/1032400_Skill_14200000_Icon.png","攻擊","使用草元素能力，遠距離攻擊目標。",{"attributes":217,"type":218,"consume":208,"power":167},[167],[169],[220],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[222,235,245,255,267,277,287,298,308,318,328,338,348,360,370,381,392,402,412,422,432,442,452,463,473,483,493,503,513,523,533,543,553,562,570,574,582,593,603,613,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,893,903,913,923,933,943,953,963,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1133,1143,1154],{"id":223,"viewCount":59,"searchKey":224,"visible":15},"10003442",{"type":10,"entryId":225,"sortOrder":226,"name":227,"imageUrl":228,"description":229,"currentMorphology":13,"currentStage":230,"position":231,"attributes":233},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。","1",[232],"position-dps",[234],"attributes-fire",{"id":236,"viewCount":59,"searchKey":237,"visible":15},"10003534",{"type":10,"entryId":238,"sortOrder":239,"name":240,"imageUrl":241,"description":242,"currentMorphology":13,"currentStage":169,"position":243,"attributes":244},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[232],[234],{"id":246,"viewCount":59,"searchKey":247,"visible":15},"10003435",{"type":10,"entryId":248,"sortOrder":249,"name":250,"imageUrl":251,"description":252,"currentMorphology":13,"currentStage":22,"position":253,"attributes":254},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[232],[234],{"id":256,"viewCount":59,"searchKey":257,"visible":15},"10003428",{"type":10,"entryId":258,"sortOrder":259,"name":260,"imageUrl":261,"description":262,"currentMorphology":13,"currentStage":22,"position":263,"attributes":265},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[264],"position-break",[234,266],"attributes-dark",{"id":268,"viewCount":59,"searchKey":269,"visible":15},"10003578",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":13,"currentStage":230,"position":275,"attributes":276},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[232],[266],{"id":278,"viewCount":59,"searchKey":279,"visible":15},"10003417",{"type":10,"entryId":280,"sortOrder":281,"name":282,"imageUrl":283,"description":284,"currentMorphology":13,"currentStage":22,"position":285,"attributes":286},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[232],[266],{"id":288,"viewCount":59,"searchKey":289,"visible":15},"10003488",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":13,"currentStage":230,"position":295,"attributes":296},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[24],[297],"attributes-wind",{"id":299,"viewCount":59,"searchKey":300,"visible":15},"10003548",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":13,"currentStage":22,"position":306,"attributes":307},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[24],[297],{"id":309,"viewCount":59,"searchKey":310,"visible":15},"10003474",{"type":10,"entryId":311,"sortOrder":312,"name":313,"imageUrl":314,"description":315,"currentMorphology":13,"currentStage":22,"position":316,"attributes":317},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[232],[297],{"id":319,"viewCount":59,"searchKey":320,"visible":15},"10003467",{"type":10,"entryId":321,"sortOrder":322,"name":323,"imageUrl":324,"description":325,"currentMorphology":13,"currentStage":22,"position":326,"attributes":327},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[264],[297],{"id":329,"viewCount":59,"searchKey":330,"visible":15},"10003392",{"type":10,"entryId":331,"sortOrder":332,"name":333,"imageUrl":334,"description":335,"currentMorphology":13,"currentStage":230,"position":336,"attributes":337},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[232],[26],{"id":339,"viewCount":59,"searchKey":340,"visible":15},"10003510",{"type":10,"entryId":341,"sortOrder":342,"name":343,"imageUrl":344,"description":345,"currentMorphology":13,"currentStage":22,"position":346,"attributes":347},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[232],[26],{"id":349,"viewCount":59,"searchKey":350,"visible":15},"10003477",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":13,"currentStage":230,"position":356,"attributes":358},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[357],"position-heal",[359],"attributes-water",{"id":361,"viewCount":59,"searchKey":362,"visible":15},"10003569",{"type":10,"entryId":363,"sortOrder":364,"name":365,"imageUrl":366,"description":367,"currentMorphology":13,"currentStage":169,"position":368,"attributes":369},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[357],[359],{"id":371,"viewCount":59,"searchKey":372,"visible":15},"10003470",{"type":10,"entryId":373,"sortOrder":374,"name":375,"imageUrl":376,"description":377,"currentMorphology":13,"currentStage":22,"position":378,"attributes":379},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[357],[359,380],"attributes-ice",{"id":382,"viewCount":59,"searchKey":383,"visible":15},"10003463",{"type":10,"entryId":384,"sortOrder":385,"name":386,"imageUrl":387,"description":388,"currentMorphology":13,"currentStage":22,"position":389,"attributes":391},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[390],"position-energy",[26,359],{"id":393,"viewCount":59,"searchKey":394,"visible":15},"10003468",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":13,"currentStage":230,"position":400,"attributes":401},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[24],[297],{"id":403,"viewCount":59,"searchKey":404,"visible":15},"10003365",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":13,"currentStage":22,"position":410,"attributes":411},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[24],[297],{"id":413,"viewCount":59,"searchKey":414,"visible":15},"10003461",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":13,"currentStage":22,"position":420,"attributes":421},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[24],[266],{"id":423,"viewCount":59,"searchKey":424,"visible":15},"10003421",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":13,"currentStage":230,"position":430,"attributes":431},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[264],[26],{"id":433,"viewCount":59,"searchKey":434,"visible":15},"10003414",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":13,"currentStage":22,"position":440,"attributes":441},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[390],[266,26],{"id":443,"viewCount":59,"searchKey":444,"visible":15},"10003404",{"type":10,"entryId":445,"sortOrder":446,"name":447,"imageUrl":448,"description":449,"currentMorphology":13,"currentStage":22,"position":450,"attributes":451},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[264],[26],{"id":453,"viewCount":59,"searchKey":454,"visible":15},"10003567",{"type":10,"entryId":455,"sortOrder":456,"name":457,"imageUrl":458,"description":459,"currentMorphology":13,"currentStage":230,"position":460,"attributes":461},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[264],[462,26],"attributes-rock",{"id":464,"viewCount":59,"searchKey":465,"visible":15},"10003462",{"type":10,"entryId":466,"sortOrder":467,"name":468,"imageUrl":469,"description":470,"currentMorphology":13,"currentStage":22,"position":471,"attributes":472},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[264],[462,26],{"id":474,"viewCount":59,"searchKey":475,"visible":15},"10003551",{"type":10,"entryId":476,"sortOrder":477,"name":478,"imageUrl":479,"description":480,"currentMorphology":13,"currentStage":22,"position":481,"attributes":482},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[264],[380],{"id":484,"viewCount":59,"searchKey":485,"visible":15},"10003409",{"type":10,"entryId":486,"sortOrder":487,"name":488,"imageUrl":489,"description":490,"currentMorphology":13,"currentStage":230,"position":491,"attributes":492},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[390],[234],{"id":494,"viewCount":59,"searchKey":495,"visible":15},"10003507",{"type":10,"entryId":496,"sortOrder":497,"name":498,"imageUrl":499,"description":500,"currentMorphology":13,"currentStage":22,"position":501,"attributes":502},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[390],[234],{"id":504,"viewCount":59,"searchKey":505,"visible":15},"10003542",{"type":10,"entryId":506,"sortOrder":507,"name":508,"imageUrl":509,"description":510,"currentMorphology":13,"currentStage":230,"position":511,"attributes":512},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[357],[297],{"id":514,"viewCount":59,"searchKey":515,"visible":15},"10003440",{"type":10,"entryId":516,"sortOrder":517,"name":518,"imageUrl":519,"description":520,"currentMorphology":13,"currentStage":22,"position":521,"attributes":522},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[357],[297],{"id":524,"viewCount":59,"searchKey":525,"visible":15},"10003563",{"type":10,"entryId":526,"sortOrder":527,"name":528,"imageUrl":529,"description":530,"currentMorphology":13,"currentStage":208,"position":531,"attributes":532},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[390],[297,26],{"id":534,"viewCount":59,"searchKey":535,"visible":15},"10003368",{"type":10,"entryId":536,"sortOrder":537,"name":538,"imageUrl":539,"description":540,"currentMorphology":13,"currentStage":230,"position":541,"attributes":542},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[24],[297],{"id":544,"viewCount":59,"searchKey":545,"visible":15},"10003363",{"type":10,"entryId":546,"sortOrder":547,"name":548,"imageUrl":549,"description":550,"currentMorphology":13,"currentStage":22,"position":551,"attributes":552},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[24],[297],{"id":554,"viewCount":59,"searchKey":555,"visible":15},"10003515",{"type":10,"entryId":556,"sortOrder":557,"name":75,"imageUrl":558,"description":559,"currentMorphology":13,"currentStage":230,"position":560,"attributes":561},"034",1032100,"/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[232],[26],{"id":563,"viewCount":59,"searchKey":564,"visible":15},"10003496",{"type":10,"entryId":8,"sortOrder":565,"name":82,"imageUrl":566,"description":567,"currentMorphology":13,"currentStage":22,"position":568,"attributes":569},1032300,"/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[232],[26],{"id":4,"viewCount":59,"searchKey":571,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":572,"attributes":573},[24],[26],{"id":6,"viewCount":59,"searchKey":575,"visible":15},{"type":10,"entryId":12,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":13,"currentStage":230,"position":580,"attributes":581},1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[264],[26],{"id":583,"viewCount":59,"searchKey":584,"visible":15},"10003374",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":13,"currentStage":22,"position":590,"attributes":591},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[24],[592],"attributes-electric",{"id":594,"viewCount":59,"searchKey":595,"visible":15},"10003443",{"type":10,"entryId":596,"sortOrder":597,"name":598,"imageUrl":599,"description":600,"currentMorphology":13,"currentStage":22,"position":601,"attributes":602},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[264],[26],{"id":604,"viewCount":59,"searchKey":605,"visible":15},"10003503",{"type":10,"entryId":606,"sortOrder":607,"name":608,"imageUrl":609,"description":610,"currentMorphology":13,"currentStage":230,"position":611,"attributes":612},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[24],[266],{"id":614,"viewCount":59,"searchKey":615,"visible":15},"10003521",{"type":10,"entryId":616,"sortOrder":617,"name":618,"imageUrl":619,"description":620,"currentMorphology":13,"currentStage":22,"position":621,"attributes":622},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[24],[266],{"id":624,"viewCount":59,"searchKey":625,"visible":15},"10003508",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":13,"currentStage":230,"position":631,"attributes":632},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[232],[266],{"id":634,"viewCount":59,"searchKey":635,"visible":15},"10003369",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":13,"currentStage":22,"position":641,"attributes":642},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[232],[266],{"id":644,"viewCount":59,"searchKey":645,"visible":15},"10003501",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":13,"currentStage":22,"position":651,"attributes":652},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[232],[592],{"id":654,"viewCount":59,"searchKey":655,"visible":15},"10003422",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":13,"currentStage":230,"position":661,"attributes":662},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[232],[380],{"id":664,"viewCount":59,"searchKey":665,"visible":15},"10003575",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":13,"currentStage":169,"position":671,"attributes":672},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[232],[380],{"id":674,"viewCount":59,"searchKey":675,"visible":15},"10003415",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":13,"currentStage":22,"position":681,"attributes":682},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[232],[380],{"id":684,"viewCount":59,"searchKey":685,"visible":15},"10003524",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":13,"currentStage":230,"position":691,"attributes":692},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[264],[592],{"id":694,"viewCount":59,"searchKey":695,"visible":15},"10003475",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":13,"currentStage":22,"position":701,"attributes":702},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[264],[592],{"id":704,"viewCount":59,"searchKey":705,"visible":15},"10003523",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":13,"currentStage":230,"position":711,"attributes":712},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[264],[359],{"id":714,"viewCount":59,"searchKey":715,"visible":15},"10003398",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":13,"currentStage":169,"position":721,"attributes":722},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[264],[359],{"id":724,"viewCount":59,"searchKey":725,"visible":15},"10003516",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":13,"currentStage":22,"position":731,"attributes":732},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[24],[359],{"id":734,"viewCount":59,"searchKey":735,"visible":15},"10003566",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":13,"currentStage":22,"position":741,"attributes":742},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[264],[359],{"id":744,"viewCount":59,"searchKey":745,"visible":15},"10003453",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":13,"currentStage":230,"position":751,"attributes":752},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[232],[359],{"id":754,"viewCount":59,"searchKey":755,"visible":15},"10003577",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":13,"currentStage":169,"position":761,"attributes":762},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[232],[359],{"id":764,"viewCount":59,"searchKey":765,"visible":15},"10003570",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":13,"currentStage":22,"position":771,"attributes":772},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[232],[359],{"id":774,"viewCount":59,"searchKey":775,"visible":15},"10003565",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":13,"currentStage":230,"position":781,"attributes":782},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[232],[462],{"id":784,"viewCount":59,"searchKey":785,"visible":15},"10003476",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":13,"currentStage":22,"position":791,"attributes":792},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[232],[462],{"id":794,"viewCount":59,"searchKey":795,"visible":15},"10003466",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":13,"currentStage":22,"position":801,"attributes":802},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[24],[462],{"id":804,"viewCount":59,"searchKey":805,"visible":15},"10003379",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":13,"currentStage":230,"position":811,"attributes":812},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[232],[592],{"id":814,"viewCount":59,"searchKey":815,"visible":15},"10003376",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":13,"currentStage":22,"position":821,"attributes":822},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[232],[592],{"id":824,"viewCount":59,"searchKey":825,"visible":15},"10003543",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":13,"currentStage":230,"position":831,"attributes":832},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[264],[266],{"id":834,"viewCount":59,"searchKey":835,"visible":15},"10003557",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":13,"currentStage":22,"position":841,"attributes":842},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[232],[266],{"id":844,"viewCount":59,"searchKey":845,"visible":15},"10003522",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":13,"currentStage":22,"position":851,"attributes":852},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[264],[266],{"id":854,"viewCount":59,"searchKey":855,"visible":15},"10003579",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":13,"currentStage":230,"position":861,"attributes":862},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[264],[297],{"id":864,"viewCount":59,"searchKey":865,"visible":15},"10003389",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":13,"currentStage":169,"position":871,"attributes":872},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[264],[297],{"id":874,"viewCount":59,"searchKey":875,"visible":15},"10003536",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":13,"currentStage":22,"position":881,"attributes":882},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[264],[297],{"id":884,"viewCount":59,"searchKey":885,"visible":15},"10003529",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":13,"currentStage":22,"position":891,"attributes":892},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[232],[234],{"id":894,"viewCount":59,"searchKey":895,"visible":15},"10003433",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":13,"currentStage":230,"position":901,"attributes":902},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[232],[462],{"id":904,"viewCount":59,"searchKey":905,"visible":15},"10003427",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":13,"currentStage":22,"position":911,"attributes":912},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[232],[462],{"id":914,"viewCount":59,"searchKey":915,"visible":15},"10003405",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":13,"currentStage":230,"position":921,"attributes":922},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[264],[462],{"id":924,"viewCount":59,"searchKey":925,"visible":15},"10003525",{"type":10,"entryId":926,"sortOrder":927,"name":928,"imageUrl":929,"description":930,"currentMorphology":13,"currentStage":169,"position":931,"attributes":932},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[264],[234,462],{"id":934,"viewCount":59,"searchKey":935,"visible":15},"10003399",{"type":10,"entryId":936,"sortOrder":937,"name":938,"imageUrl":939,"description":940,"currentMorphology":13,"currentStage":22,"position":941,"attributes":942},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[264],[234,462],{"id":944,"viewCount":59,"searchKey":945,"visible":15},"10003518",{"type":10,"entryId":946,"sortOrder":947,"name":948,"imageUrl":949,"description":950,"currentMorphology":13,"currentStage":169,"position":951,"attributes":952},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[264],[462],{"id":954,"viewCount":59,"searchKey":955,"visible":15},"10003393",{"type":10,"entryId":956,"sortOrder":957,"name":958,"imageUrl":959,"description":960,"currentMorphology":13,"currentStage":22,"position":961,"attributes":962},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[264],[462],{"id":964,"viewCount":59,"searchKey":965,"visible":15},"10003386",{"type":10,"entryId":966,"sortOrder":967,"name":968,"imageUrl":969,"description":970,"currentMorphology":13,"currentStage":230,"position":971,"attributes":972},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[24],[462],{"id":974,"viewCount":59,"searchKey":975,"visible":15},"10003447",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":13,"currentStage":22,"position":981,"attributes":982},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[24],[462],{"id":984,"viewCount":59,"searchKey":985,"visible":15},"10003497",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":13,"currentStage":230,"position":991,"attributes":992},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[24],[592],{"id":994,"viewCount":59,"searchKey":995,"visible":15},"10003479",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":13,"currentStage":169,"position":1001,"attributes":1002},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[24],[592],{"id":1004,"viewCount":59,"searchKey":1005,"visible":15},"10003388",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":13,"currentStage":22,"position":1011,"attributes":1012},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[24],[592],{"id":1014,"viewCount":59,"searchKey":1015,"visible":15},"10003429",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":13,"currentStage":230,"position":1021,"attributes":1022},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[390],[359],{"id":1024,"viewCount":59,"searchKey":1025,"visible":15},"10003430",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":13,"currentStage":22,"position":1031,"attributes":1032},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[390],[359],{"id":1034,"viewCount":59,"searchKey":1035,"visible":15},"10003549",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":13,"currentStage":208,"position":1041,"attributes":1042},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[390],[592],{"id":1044,"viewCount":59,"searchKey":1045,"visible":15},"10003494",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":13,"currentStage":230,"position":1051,"attributes":1052},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[390],[462,359],{"id":1054,"viewCount":59,"searchKey":1055,"visible":15},"10003486",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":13,"currentStage":22,"position":1061,"attributes":1062},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[390],[462,359],{"id":1064,"viewCount":59,"searchKey":1065,"visible":15},"10003530",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":13,"currentStage":230,"position":1071,"attributes":1072},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[264],[380],{"id":1074,"viewCount":59,"searchKey":1075,"visible":15},"10003457",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":13,"currentStage":22,"position":1081,"attributes":1082},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[264],[380],{"id":1084,"viewCount":59,"searchKey":1085,"visible":15},"10003423",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":13,"currentStage":230,"position":1091,"attributes":1092},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[357],[26,359],{"id":1094,"viewCount":59,"searchKey":1095,"visible":15},"10003419",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":13,"currentStage":22,"position":1101,"attributes":1102},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[357],[26,359],{"id":1104,"viewCount":59,"searchKey":1105,"visible":15},"10003410",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":13,"currentStage":230,"position":1111,"attributes":1112},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[232],[359],{"id":1114,"viewCount":59,"searchKey":1115,"visible":15},"10003509",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":13,"currentStage":22,"position":1121,"attributes":1122},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[232],[359],{"id":1124,"viewCount":59,"searchKey":1125,"visible":15},"10003413",{"type":10,"entryId":1126,"sortOrder":1127,"name":1128,"imageUrl":1129,"description":1130,"currentMorphology":13,"currentStage":230,"position":1131,"attributes":1132},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[232],[380],{"id":1134,"viewCount":59,"searchKey":1135,"visible":15},"10003407",{"type":10,"entryId":1136,"sortOrder":1137,"name":1138,"imageUrl":1139,"description":1140,"currentMorphology":13,"currentStage":22,"position":1141,"attributes":1142},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[232],[380],{"id":1144,"viewCount":59,"searchKey":1145,"visible":15},"10003498",{"type":10,"entryId":1146,"sortOrder":1147,"name":1148,"imageUrl":1149,"description":1150,"currentMorphology":13,"currentStage":208,"position":1151,"attributes":1152},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[232],[1153],"attributes-holy",{"id":1155,"viewCount":59,"searchKey":1156,"visible":15},"10003375",{"type":10,"entryId":1157,"sortOrder":1158,"name":1159,"imageUrl":1160,"description":1161,"currentMorphology":13,"currentStage":208,"position":1162,"attributes":1163},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[232],[1153],[1165,1173,1178,1183,1188,1193,1198,1203,1207,1211,1216,1221,1225,1230,1235,1240,1245,1250,1253],{"id":1166,"parentId":1167,"tagType":1168,"tagKey":1169,"name":1170,"language":1171,"sort":1172},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1174,"parentId":1167,"tagType":1168,"tagKey":1175,"name":1176,"language":1171,"sort":1177},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1179,"parentId":1167,"tagType":1168,"tagKey":1180,"name":1181,"language":1171,"sort":1182},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1184,"parentId":1167,"tagType":1168,"tagKey":1185,"name":1186,"language":1171,"sort":1187},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1189,"parentId":1167,"tagType":1168,"tagKey":1190,"name":1191,"language":1171,"sort":1192},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1194,"parentId":1167,"tagType":1168,"tagKey":1195,"name":1196,"language":1171,"sort":1197},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1199,"parentId":1167,"tagType":1168,"tagKey":1200,"name":1201,"language":1171,"sort":1202},"568127bc77f184cd4308056381642df7","Snowfield Form","雪地型態",5,{"id":1204,"parentId":1167,"tagType":1168,"tagKey":1205,"name":1206,"language":1171,"sort":128},"5989c0c15477b85af6544dca43428cd7","Rainstorm Form","雨天型態",{"id":1208,"parentId":1167,"tagType":1168,"tagKey":1209,"name":1210,"language":1171,"sort":58},"5b0d9