g","疾行","進入「疾行」狀態，可以快速移動；持續消耗體力",{"attributes":146,"type":147,"consume":47,"power":47},[],[],{"id":149,"type":61,"props":150,"children":153},"91268597_24",{"title":151,"type":64,"id":152,"isUse":15,"isEdit":15,"useTabs":66,"blackHeader":66},"伊莫特性","91268597_25",[154],{"id":155,"type":139,"props":156,"children":58},"91268597_26",{"id":157,"customKey":47,"icon":158,"iconStyle":64,"iconTitle":47,"descTitle":159,"descContent":160,"source":161},"91268597_27","/cdn/init/1045100_Feature_145101_Icon.png","聚熱岩心","移動和使用技能時獲得「過載能量」，充滿「過載能量」後，下次施放技能期間獲得40%的傷害加成。",{"attributes":162,"type":163,"consume":47,"power":47},[],[],{"id":165,"type":61,"props":166,"children":58},"91268597_28",{"title":167,"type":64,"id":168,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":66,"tabs":169},"技能介紹","91268597_29",[170,209],{"id":171,"title":172,"children":173},"91268597_30","戰鬥技能",[174,187,198],{"id":175,"type":139,"props":176},"91268597_31",{"id":177,"customKey":47,"icon":178,"iconStyle":64,"iconTitle":47,"descTitle":179,"descContent":180,"source":181},"91268597_32","/cdn/init/1045100_Skill_10800250_Icon.png","岩球旋風","旋轉自身對前方範圍造成傷害，每次命中目標傷害提高8%，持續20秒，最多疊加4層。",{"attributes":182,"type":184,"consume":185,"power":186},[183],"8",[22],"20","61",{"id":188,"type":139,"props":189},"91268597_33",{"id":190,"customKey":47,"icon":191,"iconStyle":64,"iconTitle":47,"descTitle":192,"descContent":193,"source":194},"91268597_34","/cdn/init/1045100_Skill_10800240_Icon.png","岩球翻滾","將石球抬起並高速滾動，對前方目標造成傷害。",{"attributes":195,"type":196,"consume":185,"power":197},[183],[22],"67",{"id":199,"type":139,"props":200},"91268597_35",{"id":201,"customKey":47,"icon":202,"iconStyle":64,"iconTitle":47,"descTitle":203,"descContent":204,"source":205},"91268597_36","/cdn/init/1045100_Skill_10200286_Icon.png","冰球滾落","將冰球抬起並高速滾動，對前方目標造成傷害。",{"attributes":206,"type":208,"consume":185,"power":197},[207],"2",[22],{"id":210,"title":211,"children":212},"91268597_37","固有技能",[213],{"id":214,"type":139,"props":215},"91268597_38",{"id":216,"customKey":47,"icon":217,"iconStyle":64,"iconTitle":47,"descTitle":218,"descContent":219,"source":220},"91268597_39","/cdn/init/1045100_Skill_10800000_Icon.png","攻擊","使用土元素能力，近距離攻擊目標。",{"attributes":221,"type":222,"consume":223,"power":224},[183],[22],"0","6",[226,227],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},[229,240,250,261,273,283,293,305,315,325,335,346,356,368,378,389,400,410,420,430,440,450,460,470,480,490,500,510,520,530,540,550,560,570,580,590,600,611,621,631,641,651,661,671,681,691,701,711,721,731,741,751,761,771,781,790,794,803,812,822,832,842,852,862,872,882,892,902,912,922,932,942,952,962,972,982,992,1002,1012,1022,1032,1042,1052,1062,1072,1082,1092,1102,1112,1122,1132,1142,1152,1163],{"id":230,"viewCount":58,"searchKey":231,"visible":15},"10003442",{"type":10,"entryId":232,"sortOrder":233,"name":234,"imageUrl":235,"description":236,"currentMorphology":21,"currentStage":22,"position":237,"attributes":238},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[239],"attributes-fire",{"id":241,"viewCount":58,"searchKey":242,"visible":15},"10003534",{"type":10,"entryId":243,"sortOrder":244,"name":245,"imageUrl":246,"description":247,"currentMorphology":21,"currentStage":207,"position":248,"attributes":249},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[24],[239],{"id":251,"viewCount":58,"searchKey":252,"visible":15},"10003435",{"type":10,"entryId":253,"sortOrder":254,"name":255,"imageUrl":256,"description":257,"currentMorphology":21,"currentStage":258,"position":259,"attributes":260},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[24],[239],{"id":262,"viewCount":58,"searchKey":263,"visible":15},"10003428",{"type":10,"entryId":264,"sortOrder":265,"name":266,"imageUrl":267,"description":268,"currentMorphology":21,"currentStage":258,"position":269,"attributes":271},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[270],"position-break",[239,272],"attributes-dark",{"id":274,"viewCount":58,"searchKey":275,"visible":15},"10003578",{"type":10,"entryId":276,"sortOrder":277,"name":278,"imageUrl":279,"description":280,"currentMorphology":21,"currentStage":22,"position":281,"attributes":282},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[272],{"id":284,"viewCount":58,"searchKey":285,"visible":15},"10003417",{"type":10,"entryId":286,"sortOrder":287,"name":288,"imageUrl":289,"description":290,"currentMorphology":21,"currentStage":258,"position":291,"attributes":292},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[272],{"id":294,"viewCount":58,"searchKey":295,"visible":15},"10003488",{"type":10,"entryId":296,"sortOrder":297,"name":298,"imageUrl":299,"description":300,"currentMorphology":21,"currentStage":22,"position":301,"attributes":303},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[302],"position-sup",[304],"attributes-wind",{"id":306,"viewCount":58,"searchKey":307,"visible":15},"10003548",{"type":10,"entryId":308,"sortOrder":309,"name":310,"imageUrl":311,"description":312,"currentMorphology":21,"currentStage":258,"position":313,"attributes":314},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[302],[304],{"id":316,"viewCount":58,"searchKey":317,"visible":15},"10003474",{"type":10,"entryId":318,"sortOrder":319,"name":320,"imageUrl":321,"description":322,"currentMorphology":21,"currentStage":258,"position":323,"attributes":324},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[304],{"id":326,"viewCount":58,"searchKey":327,"visible":15},"10003467",{"type":10,"entryId":328,"sortOrder":329,"name":330,"imageUrl":331,"description":332,"currentMorphology":21,"currentStage":258,"position":333,"attributes":334},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[270],[304],{"id":336,"viewCount":58,"searchKey":337,"visible":15},"10003392",{"type":10,"entryId":338,"sortOrder":339,"name":340,"imageUrl":341,"description":342,"currentMorphology":21,"currentStage":22,"position":343,"attributes":344},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[345],"attributes-grass",{"id":347,"viewCount":58,"searchKey":348,"visible":15},"10003510",{"type":10,"entryId":349,"sortOrder":350,"name":351,"imageUrl":352,"description":353,"currentMorphology":21,"currentStage":258,"position":354,"attributes":355},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[345],{"id":357,"viewCount":58,"searchKey":358,"visible":15},"10003477",{"type":10,"entryId":359,"sortOrder":360,"name":361,"imageUrl":362,"description":363,"currentMorphology":21,"currentStage":22,"position":364,"attributes":366},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[365],"position-heal",[367],"attributes-water",{"id":369,"viewCount":58,"searchKey":370,"visible":15},"10003569",{"type":10,"entryId":371,"sortOrder":372,"name":373,"imageUrl":374,"description":375,"currentMorphology":21,"currentStage":207,"position":376,"attributes":377},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[365],[367],{"id":379,"viewCount":58,"searchKey":380,"visible":15},"10003470",{"type":10,"entryId":381,"sortOrder":382,"name":383,"imageUrl":384,"description":385,"currentMorphology":21,"currentStage":258,"position":386,"attributes":387},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[365],[367,388],"attributes-ice",{"id":390,"viewCount":58,"searchKey":391,"visible":15},"10003463",{"type":10,"entryId":392,"sortOrder":393,"name":394,"imageUrl":395,"description":396,"currentMorphology":21,"currentStage":258,"position":397,"attributes":399},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[398],"position-energy",[345,367],{"id":401,"viewCount":58,"searchKey":402,"visible":15},"10003468",{"type":10,"entryId":403,"sortOrder":404,"name":405,"imageUrl":406,"description":407,"currentMorphology":21,"currentStage":22,"position":408,"attributes":409},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[302],[304],{"id":411,"viewCount":58,"searchKey":412,"visible":15},"10003365",{"type":10,"entryId":413,"sortOrder":414,"name":415,"imageUrl":416,"description":417,"currentMorphology":21,"currentStage":258,"position":418,"attributes":419},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[302],[304],{"id":421,"viewCount":58,"searchKey":422,"visible":15},"10003461",{"type":10,"entryId":423,"sortOrder":424,"name":425,"imageUrl":426,"description":427,"currentMorphology":21,"currentStage":258,"position":428,"attributes":429},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[302],[272],{"id":431,"viewCount":58,"searchKey":432,"visible":15},"10003421",{"type":10,"entryId":433,"sortOrder":434,"name":435,"imageUrl":436,"description":437,"currentMorphology":21,"currentStage":22,"position":438,"attributes":439},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[270],[345],{"id":441,"viewCount":58,"searchKey":442,"visible":15},"10003414",{"type":10,"entryId":443,"sortOrder":444,"name":445,"imageUrl":446,"description":447,"currentMorphology":21,"currentStage":258,"position":448,"attributes":449},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[398],[272,345],{"id":451,"viewCount":58,"searchKey":452,"visible":15},"10003404",{"type":10,"entryId":453,"sortOrder":454,"name":455,"imageUrl":456,"description":457,"currentMorphology":21,"currentStage":258,"position":458,"attributes":459},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[270],[345],{"id":461,"viewCount":58,"searchKey":462,"visible":15},"10003567",{"type":10,"entryId":463,"sortOrder":464,"name":465,"imageUrl":466,"description":467,"currentMorphology":21,"currentStage":22,"position":468,"attributes":469},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[270],[26,345],{"id":471,"viewCount":58,"searchKey":472,"visible":15},"10003462",{"type":10,"entryId":473,"sortOrder":474,"name":475,"imageUrl":476,"description":477,"currentMorphology":21,"currentStage":258,"position":478,"attributes":479},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[270],[26,345],{"id":481,"viewCount":58,"searchKey":482,"visible":15},"10003551",{"type":10,"entryId":483,"sortOrder":484,"name":485,"imageUrl":486,"description":487,"currentMorphology":21,"currentStage":258,"position":488,"attributes":489},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[270],[388],{"id":491,"viewCount":58,"searchKey":492,"visible":15},"10003409",{"type":10,"entryId":493,"sortOrder":494,"name":495,"imageUrl":496,"description":497,"currentMorphology":21,"currentStage":22,"position":498,"attributes":499},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[398],[239],{"id":501,"viewCount":58,"searchKey":502,"visible":15},"10003507",{"type":10,"entryId":503,"sortOrder":504,"name":505,"imageUrl":506,"description":507,"currentMorphology":21,"currentStage":258,"position":508,"attributes":509},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[398],[239],{"id":511,"viewCount":58,"searchKey":512,"visible":15},"10003542",{"type":10,"entryId":513,"sortOrder":514,"name":515,"imageUrl":516,"description":517,"currentMorphology":21,"currentStage":22,"position":518,"attributes":519},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[365],[304],{"id":521,"viewCount":58,"searchKey":522,"visible":15},"10003440",{"type":10,"entryId":523,"sortOrder":524,"name":525,"imageUrl":526,"description":527,"currentMorphology":21,"currentStage":258,"position":528,"attributes":529},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[365],[304],{"id":531,"viewCount":58,"searchKey":532,"visible":15},"10003563",{"type":10,"entryId":533,"sortOrder":534,"name":535,"imageUrl":536,"description":537,"currentMorphology":21,"currentStage":223,"position":538,"attributes":539},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[398],[304,345],{"id":541,"viewCount":58,"searchKey":542,"visible":15},"10003368",{"type":10,"entryId":543,"sortOrder":544,"name":545,"imageUrl":546,"description":547,"currentMorphology":21,"currentStage":22,"position":548,"attributes":549},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[302],[304],{"id":551,"viewCount":58,"searchKey":552,"visible":15},"10003363",{"type":10,"entryId":553,"sortOrder":554,"name":555,"imageUrl":556,"description":557,"currentMorphology":21,"currentStage":258,"position":558,"attributes":559},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[302],[304],{"id":561,"viewCount":58,"searchKey":562,"visible":15},"10003515",{"type":10,"entryId":563,"sortOrder":564,"name":565,"imageUrl":566,"description":567,"currentMorphology":21,"currentStage":22,"position":568,"attributes":569},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[345],{"id":571,"viewCount":58,"searchKey":572,"visible":15},"10003496",{"type":10,"entryId":573,"sortOrder":574,"name":575,"imageUrl":576,"description":577,"currentMorphology":21,"currentStage":258,"position":578,"attributes":579},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[24],[345],{"id":581,"viewCount":58,"searchKey":582,"visible":15},"10003378",{"type":10,"entryId":583,"sortOrder":584,"name":585,"imageUrl":586,"description":587,"currentMorphology":21,"currentStage":258,"position":588,"attributes":589},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[302],[345],{"id":591,"viewCount":58,"searchKey":592,"visible":15},"10003456",{"type":10,"entryId":593,"sortOrder":594,"name":595,"imageUrl":596,"description":597,"currentMorphology":21,"currentStage":22,"position":598,"attributes":599},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[270],[345],{"id":601,"viewCount":58,"searchKey":602,"visible":15},"10003374",{"type":10,"entryId":603,"sortOrder":604,"name":605,"imageUrl":606,"description":607,"currentMorphology":21,"currentStage":258,"position":608,"attributes":609},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[302],[610],"attributes-electric",{"id":612,"viewCount":58,"searchKey":613,"visible":15},"10003443",{"type":10,"entryId":614,"sortOrder":615,"name":616,"imageUrl":617,"description":618,"currentMorphology":21,"currentStage":258,"position":619,"attributes":620},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[270],[345],{"id":622,"viewCount":58,"searchKey":623,"visible":15},"10003503",{"type":10,"entryId":624,"sortOrder":625,"name":626,"imageUrl":627,"description":628,"currentMorphology":21,"currentStage":22,"position":629,"attributes":630},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[302],[272],{"id":632,"viewCount":58,"searchKey":633,"visible":15},"10003521",{"type":10,"entryId":634,"sortOrder":635,"name":636,"imageUrl":637,"description":638,"currentMorphology":21,"currentStage":258,"position":639,"attributes":640},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[302],[272],{"id":642,"viewCount":58,"searchKey":643,"visible":15},"10003508",{"type":10,"entryId":644,"sortOrder":645,"name":646,"imageUrl":647,"description":648,"currentMorphology":21,"currentStage":22,"position":649,"attributes":650},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[272],{"id":652,"viewCount":58,"searchKey":653,"visible":15},"10003369",{"type":10,"entryId":654,"sortOrder":655,"name":656,"imageUrl":657,"description":658,"currentMorphology":21,"currentStage":258,"position":659,"attributes":660},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[24],[272],{"id":662,"viewCount":58,"searchKey":663,"visible":15},"10003501",{"type":10,"entryId":664,"sortOrder":665,"name":666,"imageUrl":667,"description":668,"currentMorphology":21,"currentStage":258,"position":669,"attributes":670},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[610],{"id":672,"viewCount":58,"searchKey":673,"visible":15},"10003422",{"type":10,"entryId":674,"sortOrder":675,"name":676,"imageUrl":677,"description":678,"currentMorphology":21,"currentStage":22,"position":679,"attributes":680},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[388],{"id":682,"viewCount":58,"searchKey":683,"visible":15},"10003575",{"type":10,"entryId":684,"sortOrder":685,"name":686,"imageUrl":687,"description":688,"currentMorphology":21,"currentStage":207,"position":689,"attributes":690},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[388],{"id":692,"viewCount":58,"searchKey":693,"visible":15},"10003415",{"type":10,"entryId":694,"sortOrder":695,"name":696,"imageUrl":697,"description":698,"currentMorphology":21,"currentStage":258,"position":699,"attributes":700},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[24],[388],{"id":702,"viewCount":58,"searchKey":703,"visible":15},"10003524",{"type":10,"entryId":704,"sortOrder":705,"name":706,"imageUrl":707,"description":708,"currentMorphology":21,"currentStage":22,"position":709,"attributes":710},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[270],[610],{"id":712,"viewCount":58,"searchKey":713,"visible":15},"10003475",{"type":10,"entryId":714,"sortOrder":715,"name":716,"imageUrl":717,"description":718,"currentMorphology":21,"currentStage":258,"position":719,"attributes":720},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[270],[610],{"id":722,"viewCount":58,"searchKey":723,"visible":15},"10003523",{"type":10,"entryId":724,"sortOrder":725,"name":726,"imageUrl":727,"description":728,"currentMorphology":21,"currentStage":22,"position":729,"attributes":730},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[270],[367],{"id":732,"viewCount":58,"searchKey":733,"visible":15},"10003398",{"type":10,"entryId":734,"sortOrder":735,"name":736,"imageUrl":737,"description":738,"currentMorphology":21,"currentStage":207,"position":739,"attributes":740},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[270],[367],{"id":742,"viewCount":58,"searchKey":743,"visible":15},"10003516",{"type":10,"entryId":744,"sortOrder":745,"name":746,"imageUrl":747,"description":748,"currentMorphology":21,"currentStage":258,"position":749,"attributes":750},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[302],[367],{"id":752,"viewCount":58,"searchKey":753,"visible":15},"10003566",{"type":10,"entryId":754,"sortOrder":755,"name":756,"imageUrl":757,"description":758,"currentMorphology":21,"currentStage":258,"position":759,"attributes":760},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[270],[367],{"id":762,"viewCount":58,"searchKey":763,"visible":15},"10003453",{"type":10,"entryId":764,"sortOrder":765,"name":766,"imageUrl":767,"description":768,"currentMorphology":21,"currentStage":22,"position":769,"attributes":770},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[24],[367],{"id":772,"viewCount":58,"searchKey":773,"visible":15},"10003577",{"type":10,"entryId":774,"sortOrder":775,"name":776,"imageUrl":777,"description":778,"currentMorphology":21,"currentStage":207,"position":779,"attributes":780},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[367],{"id":782,"viewCount":58,"searchKey":783,"visible":15},"10003570",{"type":10,"entryId":8,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":21,"currentStage":258,"position":788,"attributes":789},1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[367],{"id":4,"viewCount":58,"searchKey":791,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":792,"attributes":793},[24],[26],{"id":795,"viewCount":58,"searchKey":796,"visible":15},"10003476",{"type":10,"entryId":797,"sortOrder":798,"name":80,"imageUrl":799,"description":800,"currentMorphology":21,"currentStage":258,"position":801,"attributes":802},"058",1045300,"/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[26],{"id":804,"viewCount":58,"searchKey":805,"visible":15},"10003466",{"type":10,"entryId":806,"sortOrder":807,"name":88,"imageUrl":808,"description":809,"currentMorphology":21,"currentStage":258,"position":810,"attributes":811},"059",1045400,"/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[302],[26],{"id":813,"viewCount":58,"searchKey":814,"visible":15},"10003379",{"type":10,"entryId":815,"sortOrder":816,"name":817,"imageUrl":818,"description":819,"currentMorphology":21,"currentStage":22,"position":820,"attributes":821},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[24],[610],{"id":823,"viewCount":58,"searchKey":824,"visible":15},"10003376",{"type":10,"entryId":825,"sortOrder":826,"name":827,"imageUrl":828,"description":829,"currentMorphology":21,"currentStage":258,"position":830,"attributes":831},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[610],{"id":833,"viewCount":58,"searchKey":834,"visible":15},"10003543",{"type":10,"entryId":835,"sortOrder":836,"name":837,"imageUrl":838,"description":839,"currentMorphology":21,"currentStage":22,"position":840,"attributes":841},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[270],[272],{"id":843,"viewCount":58,"searchKey":844,"visible":15},"10003557",{"type":10,"entryId":845,"sortOrder":846,"name":847,"imageUrl":848,"description":849,"currentMorphology":21,"currentStage":258,"position":850,"attributes":851},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[272],{"id":853,"viewCount":58,"searchKey":854,"visible":15},"10003522",{"type":10,"entryId":855,"sortOrder":856,"name":857,"imageUrl":858,"description":859,"currentMorphology":21,"currentStage":258,"position":860,"attributes":861},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[270],[272],{"id":863,"viewCount":58,"searchKey":864,"visible":15},"10003579",{"type":10,"entryId":865,"sortOrder":866,"name":867,"imageUrl":868,"description":869,"currentMorphology":21,"currentStage":22,"position":870,"attributes":871},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[270],[304],{"id":873,"viewCount":58,"searchKey":874,"visible":15},"10003389",{"type":10,"entryId":875,"sortOrder":876,"name":877,"imageUrl":878,"description":879,"currentMorphology":21,"currentStage":207,"position":880,"attributes":881},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[270],[304],{"id":883,"viewCount":58,"searchKey":884,"visible":15},"10003536",{"type":10,"entryId":885,"sortOrder":886,"name":887,"imageUrl":888,"description":889,"currentMorphology":21,"currentStage":258,"position":890,"attributes":891},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[270],[304],{"id":893,"viewCount":58,"searchKey":894,"visible":15},"10003529",{"type":10,"entryId":895,"sortOrder":896,"name":897,"imageUrl":898,"description":899,"currentMorphology":21,"currentStage":258,"position":900,"attributes":901},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[24],[239],{"id":903,"viewCount":58,"searchKey":904,"visible":15},"10003433",{"type":10,"entryId":905,"sortOrder":906,"name":907,"imageUrl":908,"description":909,"currentMorphology":21,"currentStage":22,"position":910,"attributes":911},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[26],{"id":913,"viewCount":58,"searchKey":914,"visible":15},"10003427",{"type":10,"entryId":915,"sortOrder":916,"name":917,"imageUrl":918,"description":919,"currentMorphology":21,"currentStage":258,"position":920,"attributes":921},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[26],{"id":923,"viewCount":58,"searchKey":924,"visible":15},"10003405",{"type":10,"entryId":925,"sortOrder":926,"name":927,"imageUrl":928,"description":929,"currentMorphology":21,"currentStage":22,"position":930,"attributes":931},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[270],[26],{"id":933,"viewCount":58,"searchKey":934,"visible":15},"10003525",{"type":10,"entryId":935,"sortOrder":936,"name":937,"imageUrl":938,"description":939,"currentMorphology":21,"currentStage":207,"position":940,"attributes":941},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[270],[239,26],{"id":943,"viewCount":58,"searchKey":944,"visible":15},"10003399",{"type":10,"entryId":945,"sortOrder":946,"name":947,"imageUrl":948,"description":949,"currentMorphology":21,"currentStage":258,"position":950,"attributes":951},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[270],[239,26],{"id":953,"viewCount":58,"searchKey":954,"visible":15},"10003518",{"type":10,"entryId":955,"sortOrder":956,"name":957,"imageUrl":958,"description":959,"currentMorphology":21,"currentStage":207,"position":960,"attributes":961},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[270],[26],{"id":963,"viewCount":58,"searchKey":964,"visible":15},"10003393",{"type":10,"entryId":965,"sortOrder":966,"name":967,"imageUrl":968,"description":969,"currentMorphology":21,"currentStage":258,"position":970,"attributes":971},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[270],[26],{"id":973,"viewCount":58,"searchKey":974,"visible":15},"10003386",{"type":10,"entryId":975,"sortOrder":976,"name":977,"imageUrl":978,"description":979,"currentMorphology":21,"currentStage":22,"position":980,"attributes":981},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[302],[26],{"id":983,"viewCount":58,"searchKey":984,"visible":15},"10003447",{"type":10,"entryId":985,"sortOrder":986,"name":987,"imageUrl":988,"description":989,"currentMorphology":21,"currentStage":258,"position":990,"attributes":991},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[302],[26],{"id":993,"viewCount":58,"searchKey":994,"visible":15},"10003497",{"type":10,"entryId":995,"sortOrder":996,"name":997,"imageUrl":998,"description":999,"currentMorphology":21,"currentStage":22,"position":1000,"attributes":1001},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[302],[610],{"id":1003,"viewCount":58,"searchKey":1004,"visible":15},"10003479",{"type":10,"entryId":1005,"sortOrder":1006,"name":1007,"imageUrl":1008,"description":1009,"currentMorphology":21,"currentStage":207,"position":1010,"attributes":1011},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[302],[610],{"id":1013,"viewCount":58,"searchKey":1014,"visible":15},"10003388",{"type":10,"entryId":1015,"sortOrder":1016,"name":1017,"imageUrl":1018,"description":1019,"currentMorphology":21,"currentStage":258,"position":1020,"attributes":1021},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[302],[610],{"id":1023,"viewCount":58,"searchKey":1024,"visible":15},"10003429",{"type":10,"entryId":1025,"sortOrder":1026,"name":1027,"imageUrl":1028,"description":1029,"currentMorphology":21,"currentStage":22,"position":1030,"attributes":1031},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[398],[367],{"id":1033,"viewCount":58,"searchKey":1034,"visible":15},"10003430",{"type":10,"entryId":1035,"sortOrder":1036,"name":1037,"imageUrl":1038,"description":1039,"currentMorphology":21,"currentStage":258,"position":1040,"attributes":1041},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[398],[367],{"id":1043,"viewCount":58,"searchKey":1044,"visible":15},"10003549",{"type":10,"entryId":1045,"sortOrder":1046,"name":1047,"imageUrl":1048,"description":1049,"currentMorphology":21,"currentStage":223,"position":1050,"attributes":1051},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[398],[610],{"id":1053,"viewCount":58,"searchKey":1054,"visible":15},"10003494",{"type":10,"entryId":1055,"sortOrder":1056,"name":1057,"imageUrl":1058,"description":1059,"currentMorphology":21,"currentStage":22,"position":1060,"attributes":1061},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[398],[26,367],{"id":1063,"viewCount":58,"searchKey":1064,"visible":15},"10003486",{"type":10,"entryId":1065,"sortOrder":1066,"name":1067,"imageUrl":1068,"description":1069,"currentMorphology":21,"currentStage":258,"position":1070,"attributes":1071},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[398],[26,367],{"id":1073,"viewCount":58,"searchKey":1074,"visible":15},"10003530",{"type":10,"entryId":1075,"sortOrder":1076,"name":1077,"imageUrl":1078,"description":1079,"currentMorphology":21,"currentStage":22,"position":1080,"attributes":1081},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[270],[388],{"id":1083,"viewCount":58,"searchKey":1084,"visible":15},"10003457",{"type":10,"entryId":1085,"sortOrder":1086,"name":1087,"imageUrl":1088,"description":1089,"currentMorphology":21,"currentStage":258,"position":1090,"attributes":1091},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[270],[388],{"id":1093,"viewCount":58,"searchKey":1094,"visible":15},"10003423",{"type":10,"entryId":1095,"sortOrder":1096,"name":1097,"imageUrl":1098,"description":1099,"currentMorphology":21,"currentStage":22,"position":1100,"attributes":1101},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[365],[345,367],{"id":1103,"viewCount":58,"searchKey":1104,"visible":15},"10003419",{"type":10,"entryId":1105,"sortOrder":1106,"name":1107,"imageUrl":1108,"description":1109,"currentMorphology":21,"currentStage":258,"position":1110,"attributes":1111},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[365],[345,367],{"id":1113,"viewCount":58,"searchKey":1114,"visible":15},"10003410",{"type":10,"entryId":1115,"sortOrder":1116,"name":1117,"imageUrl":1118,"description":1119,"currentMorphology":21,"currentStage":22,"position":1120,"attributes":1121},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[367],{"id":1123,"viewCount":58,"searchKey":1124,"visible":15},"10003509",{"type":10,"entryId":1125,"sortOrder":1126,"name":1127,"imageUrl":1128,"description":1129,"currentMorphology":21,"currentStage":258,"position":1130,"attributes":1131},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[367],{"id":1133,"viewCount":58,"searchKey":1134,"visible":15},"10003413",{"type":10,"entryId":1135,"sortOrder":1136,"name":1137,"imageUrl":1138,"description":1139,"currentMorphology":21,"currentStage":22,"position":1140,"attributes":1141},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[388],{"id":1143,"viewCount":58,"searchKey":1144,"visible":15},"10003407",{"type":10,"entryId":1145,"sortOrder":1146,"name":1147,"imageUrl":1148,"description":1149,"currentMorphology":21,"currentStage":258,"position":1150,"attributes":1151},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[388],{"id":1153,"viewCount":58,"searchKey":1154,"visible":15},"10003498",{"type":10,"entryId":1155,"sortOrder":1156,"name":1157,"imageUrl":1158,"description":1159,"currentMorphology":21,"currentStage":223,"position":1160,"attributes":1161},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1162],"attributes-holy",{"id":1164,"viewCount":58,"searchKey":1165,"visible":15},"10003375",{"type":10,"entryId":1166,"sortOrder":1167,"name":1168,"imageUrl":1169,"description":1170,"currentMorphology":21,"currentStage":223,"position":1171,"attributes":1172},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1162],[1174,1182,1187,1192,1197,1202,1207,1211,1215,1219,1224,1229,1233,1238,1243,1248,1253,1258,1261],{"id":1175,"parentId":1176,"tagType":1177,"tagKey":1178,"name":1179,"language":1180,"sort":1181},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1183,"parentId":1176,"tagType":1177,"tagKey":1184,"name":1185,"language":1180,"sort":1186},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1188,"parentId":1176,"tagType":1177,"tagKey":1189,"name":1190,"language":1180,"sort":1191},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1193,"parentId":1176,"tagType":1177,"tagKey":1194,"name":1195,"language":1180,"sort":1196},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1198,"parentId":1176,"tagType":1177,"tagKey":1199,"name":1200,"language":1180,"sort":1201},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1203,"parentId":1176,"tagType":1177,"tagKey":1204,"name":1205,"language":1180,"sort":1206},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1208,"parentId":1176,"tagType":1177,"tagKey":13,"name":1209,"language":1180,"sort":1210},"568127bc77f184cd4308056381642df7","雪地型態",5,{"id":1212,"parentId":1176,"tagType":1177,"tagKey":1213,"name":1214,"language":1180,"sor