,"icon":148,"iconStyle":99,"iconTitle":47,"descTitle":149,"descContent":150,"source":151},"91268560_23","/cdn/init/1002500_Skill_9400051_Icon.png","雙側視野","進入特殊的雙側視野，可以看到不一樣的景色。",{"attributes":152,"type":153,"consume":47,"power":47},[],[],{"id":155,"type":63,"props":156,"children":159},"91268560_24",{"title":157,"type":66,"id":158,"isUse":15,"isEdit":15,"useTabs":68,"blackHeader":68},"伊莫特性","91268560_25",[160],{"id":161,"type":127,"props":162,"children":60},"91268560_26",{"id":163,"customKey":47,"icon":164,"iconStyle":66,"iconTitle":47,"descTitle":165,"descContent":166,"source":167},"91268560_27","/cdn/init/1002500_Feature_10252_Icon.png","火焰之力","對「火元素異常」大於5層的敵人，額外造成40%傷害。",{"attributes":168,"type":169,"consume":47,"power":47},[],[],{"id":171,"type":63,"props":172,"children":60},"91268560_28",{"title":173,"type":66,"id":174,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":68,"tabs":175},"技能介紹","91268560_29",[176,217],{"id":177,"title":178,"children":179},"91268560_30","戰鬥技能",[180,193,205],{"id":181,"type":127,"props":182},"91268560_31",{"id":183,"customKey":47,"icon":184,"iconStyle":66,"iconTitle":47,"descTitle":185,"descContent":186,"source":187},"91268560_32","/cdn/init/1002500_Skill_10500021_Icon.png","火焰衝鋒","衝向目標，造成傷害。在飛行狀態使用，會俯衝向目標並結束飛行狀態。命中目標後，獲得5%最大生命值的護盾，持續10秒。",{"attributes":188,"type":190,"consume":191,"power":192},[189],"5",[115],"20","60",{"id":194,"type":127,"props":195},"91268560_33",{"id":196,"customKey":47,"icon":197,"iconStyle":66,"iconTitle":47,"descTitle":198,"descContent":199,"source":200},"91268560_34","/cdn/init/1002500_Skill_10500380_Icon.png","火焰吐息","對前方施放橫掃吐息，攻擊目標並附加8層「火元素異常」。",{"attributes":201,"type":202,"consume":191,"power":204},[189],[203],"2","62",{"id":206,"type":127,"props":207},"91268560_35",{"id":208,"customKey":47,"icon":209,"iconStyle":66,"iconTitle":47,"descTitle":210,"descContent":211,"source":212},"91268560_36","/cdn/init/1002500_Skill_10500420_Icon.png","火焰爪擊","施放火焰爪擊攻擊目標。5秒內可以再次施放強力爪擊。2次爪擊都可以消耗目標2層「火元素異常」並額外造成30%威力的傷害。",{"attributes":213,"type":214,"consume":215,"power":216},[189],[115],"15","50",{"id":218,"title":219,"children":220},"91268560_37","固有技能",[221,233],{"id":222,"type":127,"props":223},"91268560_38",{"id":224,"customKey":47,"icon":225,"iconStyle":66,"iconTitle":47,"descTitle":226,"descContent":227,"source":228},"91268560_39","/cdn/init/1002500_Skill_10500390_Icon.png","灼熱龍息","從空中持續噴出強力的火焰吐息，攻擊前方大範圍的目標並附加8層「火元素異常」。",{"attributes":229,"type":230,"consume":231,"power":232},[189],[203],"0","156",{"id":234,"type":127,"props":235},"91268560_40",{"id":236,"customKey":47,"icon":237,"iconStyle":66,"iconTitle":47,"descTitle":238,"descContent":239,"source":240},"91268560_41","/cdn/init/1002500_Skill_10500000_Icon.png","攻擊","使用火元素能力，近距離攻擊目標。",{"attributes":241,"type":242,"consume":231,"power":243},[189],[115],"6",[245],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[247,257,267,277,289,299,309,321,331,341,351,362,372,384,394,405,416,426,436,446,456,466,476,487,497,507,517,527,537,547,557,567,577,587,597,607,617,628,638,648,658,668,678,688,698,708,718,728,738,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,907,915,919,927,937,947,957,967,977,987,997,1007,1017,1027,1037,1047,1057,1067,1077,1087,1097,1107,1117,1127,1137,1147,1157,1167,1178],{"id":248,"viewCount":60,"searchKey":249,"visible":15},"10003442",{"type":10,"entryId":250,"sortOrder":251,"name":252,"imageUrl":253,"description":254,"currentMorphology":13,"currentStage":115,"position":255,"attributes":256},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[26],{"id":258,"viewCount":60,"searchKey":259,"visible":15},"10003534",{"type":10,"entryId":260,"sortOrder":261,"name":262,"imageUrl":263,"description":264,"currentMorphology":13,"currentStage":203,"position":265,"attributes":266},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[24],[26],{"id":268,"viewCount":60,"searchKey":269,"visible":15},"10003435",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":13,"currentStage":22,"position":275,"attributes":276},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[24],[26],{"id":278,"viewCount":60,"searchKey":279,"visible":15},"10003428",{"type":10,"entryId":280,"sortOrder":281,"name":282,"imageUrl":283,"description":284,"currentMorphology":13,"currentStage":22,"position":285,"attributes":287},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[286],"position-break",[26,288],"attributes-dark",{"id":290,"viewCount":60,"searchKey":291,"visible":15},"10003578",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":13,"currentStage":115,"position":297,"attributes":298},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[288],{"id":300,"viewCount":60,"searchKey":301,"visible":15},"10003417",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":13,"currentStage":22,"position":307,"attributes":308},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[288],{"id":310,"viewCount":60,"searchKey":311,"visible":15},"10003488",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":13,"currentStage":115,"position":317,"attributes":319},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[318],"position-sup",[320],"attributes-wind",{"id":322,"viewCount":60,"searchKey":323,"visible":15},"10003548",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":13,"currentStage":22,"position":329,"attributes":330},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[318],[320],{"id":332,"viewCount":60,"searchKey":333,"visible":15},"10003474",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":13,"currentStage":22,"position":339,"attributes":340},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[320],{"id":342,"viewCount":60,"searchKey":343,"visible":15},"10003467",{"type":10,"entryId":344,"sortOrder":345,"name":346,"imageUrl":347,"description":348,"currentMorphology":13,"currentStage":22,"position":349,"attributes":350},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[286],[320],{"id":352,"viewCount":60,"searchKey":353,"visible":15},"10003392",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":13,"currentStage":115,"position":359,"attributes":360},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[361],"attributes-grass",{"id":363,"viewCount":60,"searchKey":364,"visible":15},"10003510",{"type":10,"entryId":365,"sortOrder":366,"name":367,"imageUrl":368,"description":369,"currentMorphology":13,"currentStage":22,"position":370,"attributes":371},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[361],{"id":373,"viewCount":60,"searchKey":374,"visible":15},"10003477",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":13,"currentStage":115,"position":380,"attributes":382},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[381],"position-heal",[383],"attributes-water",{"id":385,"viewCount":60,"searchKey":386,"visible":15},"10003569",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":13,"currentStage":203,"position":392,"attributes":393},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[381],[383],{"id":395,"viewCount":60,"searchKey":396,"visible":15},"10003470",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":13,"currentStage":22,"position":402,"attributes":403},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[381],[383,404],"attributes-ice",{"id":406,"viewCount":60,"searchKey":407,"visible":15},"10003463",{"type":10,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":13,"currentStage":22,"position":413,"attributes":415},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[414],"position-energy",[361,383],{"id":417,"viewCount":60,"searchKey":418,"visible":15},"10003468",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":13,"currentStage":115,"position":424,"attributes":425},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[318],[320],{"id":427,"viewCount":60,"searchKey":428,"visible":15},"10003365",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":13,"currentStage":22,"position":434,"attributes":435},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[318],[320],{"id":437,"viewCount":60,"searchKey":438,"visible":15},"10003461",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":13,"currentStage":22,"position":444,"attributes":445},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[318],[288],{"id":447,"viewCount":60,"searchKey":448,"visible":15},"10003421",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":13,"currentStage":115,"position":454,"attributes":455},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[286],[361],{"id":457,"viewCount":60,"searchKey":458,"visible":15},"10003414",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":13,"currentStage":22,"position":464,"attributes":465},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[414],[288,361],{"id":467,"viewCount":60,"searchKey":468,"visible":15},"10003404",{"type":10,"entryId":469,"sortOrder":470,"name":471,"imageUrl":472,"description":473,"currentMorphology":13,"currentStage":22,"position":474,"attributes":475},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[286],[361],{"id":477,"viewCount":60,"searchKey":478,"visible":15},"10003567",{"type":10,"entryId":479,"sortOrder":480,"name":481,"imageUrl":482,"description":483,"currentMorphology":13,"currentStage":115,"position":484,"attributes":485},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[286],[486,361],"attributes-rock",{"id":488,"viewCount":60,"searchKey":489,"visible":15},"10003462",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":13,"currentStage":22,"position":495,"attributes":496},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[286],[486,361],{"id":498,"viewCount":60,"searchKey":499,"visible":15},"10003551",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":13,"currentStage":22,"position":505,"attributes":506},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[286],[404],{"id":508,"viewCount":60,"searchKey":509,"visible":15},"10003409",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":13,"currentStage":115,"position":515,"attributes":516},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[414],[26],{"id":518,"viewCount":60,"searchKey":519,"visible":15},"10003507",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":13,"currentStage":22,"position":525,"attributes":526},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[414],[26],{"id":528,"viewCount":60,"searchKey":529,"visible":15},"10003542",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":13,"currentStage":115,"position":535,"attributes":536},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[381],[320],{"id":538,"viewCount":60,"searchKey":539,"visible":15},"10003440",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":13,"currentStage":22,"position":545,"attributes":546},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[381],[320],{"id":548,"viewCount":60,"searchKey":549,"visible":15},"10003563",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":13,"currentStage":231,"position":555,"attributes":556},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[414],[320,361],{"id":558,"viewCount":60,"searchKey":559,"visible":15},"10003368",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":13,"currentStage":115,"position":565,"attributes":566},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[318],[320],{"id":568,"viewCount":60,"searchKey":569,"visible":15},"10003363",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":13,"currentStage":22,"position":575,"attributes":576},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[318],[320],{"id":578,"viewCount":60,"searchKey":579,"visible":15},"10003515",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":13,"currentStage":115,"position":585,"attributes":586},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[361],{"id":588,"viewCount":60,"searchKey":589,"visible":15},"10003496",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":13,"currentStage":22,"position":595,"attributes":596},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[24],[361],{"id":598,"viewCount":60,"searchKey":599,"visible":15},"10003378",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":13,"currentStage":22,"position":605,"attributes":606},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[318],[361],{"id":608,"viewCount":60,"searchKey":609,"visible":15},"10003456",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":13,"currentStage":115,"position":615,"attributes":616},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[286],[361],{"id":618,"viewCount":60,"searchKey":619,"visible":15},"10003374",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":13,"currentStage":22,"position":625,"attributes":626},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[318],[627],"attributes-electric",{"id":629,"viewCount":60,"searchKey":630,"visible":15},"10003443",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":13,"currentStage":22,"position":636,"attributes":637},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[286],[361],{"id":639,"viewCount":60,"searchKey":640,"visible":15},"10003503",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":13,"currentStage":115,"position":646,"attributes":647},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[318],[288],{"id":649,"viewCount":60,"searchKey":650,"visible":15},"10003521",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":13,"currentStage":22,"position":656,"attributes":657},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[318],[288],{"id":659,"viewCount":60,"searchKey":660,"visible":15},"10003508",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":13,"currentStage":115,"position":666,"attributes":667},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[288],{"id":669,"viewCount":60,"searchKey":670,"visible":15},"10003369",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":13,"currentStage":22,"position":676,"attributes":677},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[24],[288],{"id":679,"viewCount":60,"searchKey":680,"visible":15},"10003501",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":13,"currentStage":22,"position":686,"attributes":687},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[627],{"id":689,"viewCount":60,"searchKey":690,"visible":15},"10003422",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":13,"currentStage":115,"position":696,"attributes":697},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[404],{"id":699,"viewCount":60,"searchKey":700,"visible":15},"10003575",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":13,"currentStage":203,"position":706,"attributes":707},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[404],{"id":709,"viewCount":60,"searchKey":710,"visible":15},"10003415",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":13,"currentStage":22,"position":716,"attributes":717},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[24],[404],{"id":719,"viewCount":60,"searchKey":720,"visible":15},"10003524",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":13,"currentStage":115,"position":726,"attributes":727},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[286],[627],{"id":729,"viewCount":60,"searchKey":730,"visible":15},"10003475",{"type":10,"entryId":731,"sortOrder":732,"name":733,"imageUrl":734,"description":735,"currentMorphology":13,"currentStage":22,"position":736,"attributes":737},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[286],[627],{"id":739,"viewCount":60,"searchKey":740,"visible":15},"10003523",{"type":10,"entryId":741,"sortOrder":742,"name":743,"imageUrl":744,"description":745,"currentMorphology":13,"currentStage":115,"position":746,"attributes":747},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[286],[383],{"id":749,"viewCount":60,"searchKey":750,"visible":15},"10003398",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":13,"currentStage":203,"position":756,"attributes":757},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[286],[383],{"id":759,"viewCount":60,"searchKey":760,"visible":15},"10003516",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":13,"currentStage":22,"position":766,"attributes":767},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[318],[383],{"id":769,"viewCount":60,"searchKey":770,"visible":15},"10003566",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":13,"currentStage":22,"position":776,"attributes":777},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[286],[383],{"id":779,"viewCount":60,"searchKey":780,"visible":15},"10003453",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":13,"currentStage":115,"position":786,"attributes":787},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[24],[383],{"id":789,"viewCount":60,"searchKey":790,"visible":15},"10003577",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":13,"currentStage":203,"position":796,"attributes":797},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[383],{"id":799,"viewCount":60,"searchKey":800,"visible":15},"10003570",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":13,"currentStage":22,"position":806,"attributes":807},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[383],{"id":809,"viewCount":60,"searchKey":810,"visible":15},"10003565",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":13,"currentStage":115,"position":816,"attributes":817},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[24],[486],{"id":819,"viewCount":60,"searchKey":820,"visible":15},"10003476",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":13,"currentStage":22,"position":826,"attributes":827},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[486],{"id":829,"viewCount":60,"searchKey":830,"visible":15},"10003466",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":13,"currentStage":22,"position":836,"attributes":837},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[318],[486],{"id":839,"viewCount":60,"searchKey":840,"visible":15},"10003379",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":13,"currentStage":115,"position":846,"attributes":847},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[24],[627],{"id":849,"viewCount":60,"searchKey":850,"visible":15},"10003376",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":13,"currentStage":22,"position":856,"attributes":857},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[627],{"id":859,"viewCount":60,"searchKey":860,"visible":15},"10003543",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":13,"currentStage":115,"position":866,"attributes":867},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[286],[288],{"id":869,"viewCount":60,"searchKey":870,"visible":15},"10003557",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":13,"currentStage":22,"position":876,"attributes":877},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[288],{"id":879,"viewCount":60,"searchKey":880,"visible":15},"10003522",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":13,"currentStage":22,"position":886,"attributes":887},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[286],[288],{"id":889,"viewCount":60,"searchKey":890,"visible":15},"10003579",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":13,"currentStage":115,"position":896,"attributes":897},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[286],[320],{"id":899,"viewCount":60,"searchKey":900,"visible":15},"10003389",{"type":10,"entryId":901,"sortOrder":902,"name":76,"imageUrl":903,"description":904,"currentMorphology":13,"currentStage":203,"position":905,"attributes":906},"066",1002200,"/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[286],[320],{"id":908,"viewCount":60,"searchKey":909,"visible":15},"10003536",{"type":10,"entryId":8,"sortOrder":910,"name":83,"imageUrl":911,"description":912,"currentMorphology":13,"currentStage":22,"position":913,"attributes":914},1002300,"/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[286],[320],{"id":4,"viewCount":60,"searchKey":916,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":917,"attributes":918},[24],[26],{"id":6,"viewCount":60,"searchKey":920,"visible":15},{"type":10,"entryId":12,"sortOrder":921,"name":922,"imageUrl":923,"description":924,"currentMorphology":13,"currentStage":115,"position":925,"attributes":926},1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[486],{"id":928,"viewCount":60,"searchKey":929,"visible":15},"10003427",{"type":10,"entryId":930,"sortOrder":931,"name":932,"imageUrl":933,"description":934,"currentMorphology":13,"currentStage":22,"position":935,"attributes":936},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[486],{"id":938,"viewCount":60,"searchKey":939,"visible":15},"10003405",{"type":10,"entryId":940,"sortOrder":941,"name":942,"imageUrl":943,"description":944,"currentMorphology":13,"currentStage":115,"position":945,"attributes":946},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[286],[486],{"id":948,"viewCount":60,"searchKey":949,"visible":15},"10003525",{"type":10,"entryId":950,"sortOrder":951,"name":952,"imageUrl":953,"description":954,"currentMorphology":13,"currentStage":203,"position":955,"attributes":956},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[286],[26,486],{"id":958,"viewCount":60,"searchKey":959,"visible":15},"10003399",{"type":10,"entryId":960,"sortOrder":961,"name":962,"imageUrl":963,"description":964,"currentMorphology":13,"currentStage":22,"position":965,"attributes":966},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[286],[26,486],{"id":968,"viewCount":60,"searchKey":969,"visible":15},"10003518",{"type":10,"entryId":970,"sortOrder":971,"name":972,"imageUrl":973,"description":974,"currentMorphology":13,"currentStage":203,"position":975,"attributes":976},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[286],[486],{"id":978,"viewCount":60,"searchKey":979,"visible":15},"10003393",{"type":10,"entryId":980,"sortOrder":981,"name":982,"imageUrl":983,"description":984,"currentMorphology":13,"currentStage":22,"position":985,"attributes":986},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[286],[486],{"id":988,"viewCount":60,"searchKey":989,"visible":15},"10003386",{"type":10,"entryId":990,"sortOrder":991,"name":992,"imageUrl":993,"description":994,"currentMorphology":13,"currentStage":115,"position":995,"attributes":996},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[318],[486],{"id":998,"viewCount":60,"searchKey":999,"visible":15},"10003447",{"type":10,"entryId":1000,"sortOrder":1001,"name":1002,"imageUrl":1003,"description":1004,"currentMorphology":13,"currentStage":22,"position":1005,"attributes":1006},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[318],[486],{"id":1008,"viewCount":60,"searchKey":1009,"visible":15},"10003497",{"type":10,"entryId":1010,"sortOrder":1011,"name":1012,"imageUrl":1013,"description":1014,"currentMorphology":13,"currentStage":115,"position":1015,"attributes":1016},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[318],[627],{"id":1018,"viewCount":60,"searchKey":1019,"visible":15},"10003479",{"type":10,"entryId":1020,"sortOrder":1021,"name":1022,"imageUrl":1023,"description":1024,"currentMorphology":13,"currentStage":203,"position":1025,"attributes":1026},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[318],[627],{"id":1028,"viewCount":60,"searchKey":1029,"visible":15},"10003388",{"type":10,"entryId":1030,"sortOrder":1031,"name":1032,"imageUrl":1033,"description":1034,"currentMorphology":13,"currentStage":22,"position":1035,"attributes":1036},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[318],[627],{"id":1038,"viewCount":60,"searchKey":1039,"visible":15},"10003429",{"type":10,"entryId":1040,"sortOrder":1041,"name":1042,"imageUrl":1043,"description":1044,"currentMorphology":13,"currentStage":115,"position":1045,"attributes":1046},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[414],[383],{"id":1048,"viewCount":60,"searchKey":1049,"visible":15},"10003430",{"type":10,"entryId":1050,"sortOrder":1051,"name":1052,"imageUrl":1053,"description":1054,"currentMorphology":13,"currentStage":22,"position":1055,"attributes":1056},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[414],[383],{"id":1058,"viewCount":60,"searchKey":1059,"visible":15},"10003549",{"type":10,"entryId":1060,"sortOrder":1061,"name":1062,"imageUrl":1063,"description":1064,"currentMorphology":13,"currentStage":231,"position":1065,"attributes":1066},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[414],[627],{"id":1068,"viewCount":60,"searchKey":1069,"visible":15},"10003494",{"type":10,"entryId":1070,"sortOrder":1071,"name":1072,"imageUrl":1073,"description":1074,"currentMorphology":13,"currentStage":115,"position":1075,"attributes":1076},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[414],[486,383],{"id":1078,"viewCount":60,"searchKey":1079,"visible":15},"10003486",{"type":10,"entryId":1080,"sortOrder":1081,"name":1082,"imageUrl":1083,"description":1084,"currentMorphology":13,"currentStage":22,"position":1085,"attributes":1086},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[414],[486,383],{"id":1088,"viewCount":60,"searchKey":1089,"visible":15},"10003530",{"type":10,"entryId":1090,"sortOrder":1091,"name":1092,"imageUrl":1093,"description":1094,"currentMorphology":13,"currentStage":115,"position":1095,"attributes":1096},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[286],[404],{"id":1098,"viewCount":60,"searchKey":1099,"visible":15},"10003457",{"type":10,"entryId":1100,"sortOrder":1101,"name":1102,"imageUrl":1103,"description":1104,"currentMorphology":13,"currentStage":22,"position":1105,"attributes":1106},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[286],[404],{"id":1108,"viewCount":60,"searchKey":1109,"visible":15},"10003423",{"type":10,"entryId":1110,"sortOrder":1111,"name":1112,"imageUrl":1113,"description":1114,"currentMorphology":13,"currentStage":115,"position":1115,"attributes":1116},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[381],[361,383],{"id":1118,"viewCount":60,"searchKey":1119,"visible":15},"10003419",{"type":10,"entryId":1120,"sortOrder":1121,"name":1122,"imageUrl":1123,"description":1124,"currentMorphology":13,"currentStage":22,"position":1125,"attributes":1126},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[381],[361,383],{"id":1128,"viewCount":60,"searchKey":1129,"visible":15},"10003410",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":13,"currentStage":115,"position":1135,"attributes":1136},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[383],{"id":1138,"viewCount":60,"searchKey":1139,"visible":15},"10003509",{"type":10,"entryId":1140,"sortOrder":1141,"name":1142,"imageUrl":1143,"description":1144,"currentMorphology":13,"currentStage":22,"position":1145,"attributes":1146},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[383],{"id":1148,"viewCount":60,"searchKey":1149,"visible":15},"10003413",{"type":10,"entryId":1150,"sortOrder":1151,"name":1152,"imageUrl":1153,"description":1154,"currentMorphology":13,"currentStage":115,"position":1155,"attributes":1156},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[404],{"id":1158,"viewCount":60,"searchKey":1159,"visible":15},"10003407",{"type":10,"entryId":1160,"sortOrder":1161,"name":1162,"imageUrl":1163,"description":1164,"currentMorphology":13,"currentStage":22,"position":1165,"attributes":1166},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[404],{"id":1168,"viewCount":60,"searchKey":1169,"visible":15},"10003498",{"type":10,"entryId":1170,"sortOrder":1171,"name":1172,"imageUrl":1173,"description":1174,"currentMorphology":13,"currentStage":231,"position":1175,"attributes":1176},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1177],"attributes-holy",{"id":1179,"viewCount":60,"searchKey":1180,"visible":15},"10003375",{"type":10,"entryId":1181,"sortOrder":1182,"name":1183,"imageUrl":1184,"description":1185,"currentMorphology":13,"currentStage":231,"position":1186,"attributes":1187},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1177],[1189,1197,1202,1207,1212,1217,1222,1227,1231,1235,1240,1245,1250,1254,1259,1264,1269,1274,1277],{"id":1190,"parentId":1191,"tagType":1192,"tagKey":1193,"name":1194,"language":1195,"sort":1196},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1198,"parentId":1191,"tagType":1192,"tagKey":1199,"name":1200,"language":1195,"sort":1201},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1203,"parentId":1191,"tagType":1192,"tagKey":1204,"name":1205,"language":1195,"sort":1206},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1208,"parentId":1191,"tagType":1192,"tagKey":1209,"name":1210,"language":1195,"sort":1211},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1213,"parentId":1191,"tagType":1192,"tagKey":1214,"name":1215,