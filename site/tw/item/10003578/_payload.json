Icon.png","星星滑翔","一邊飛行一邊掉落星星攻擊目標造成傷害。命中同一個目標3次，自身能量回復速度提高10%的，持續10秒。",{"attributes":212,"type":213,"consume":202,"power":214},[199],[201],"74",{"id":216,"title":217,"children":218},"91268611_42","固有技能",[219],{"id":220,"type":147,"props":221},"91268611_43",{"id":222,"customKey":46,"icon":223,"iconStyle":64,"iconTitle":46,"descTitle":224,"descContent":225,"source":226},"91268611_44","/cdn/init/1001100_Skill_14500000_Icon.png","攻擊","使用暗元素能力，遠距離攻擊目標。",{"attributes":227,"type":228,"consume":229,"power":230},[199],[201],"0","6",[232],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[234,245,255,266,275,279,286,298,308,318,328,339,349,361,371,382,393,403,413,423,433,443,453,464,474,484,494,504,514,524,534,544,554,564,574,584,594,605,615,625,635,645,655,665,675,685,695,705,715,725,735,745,755,765,775,785,795,805,815,825,835,845,855,865,875,885,895,905,915,925,935,945,955,965,975,985,995,1005,1015,1025,1035,1045,1055,1065,1075,1085,1095,1105,1115,1125,1135,1145,1155,1166],{"id":235,"viewCount":58,"searchKey":236,"visible":14},"10003442",{"type":10,"entryId":237,"sortOrder":238,"name":239,"imageUrl":240,"description":241,"currentMorphology":9,"currentStage":21,"position":242,"attributes":243},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[244],"attributes-fire",{"id":246,"viewCount":58,"searchKey":247,"visible":14},"10003534",{"type":10,"entryId":248,"sortOrder":249,"name":250,"imageUrl":251,"description":252,"currentMorphology":9,"currentStage":201,"position":253,"attributes":254},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[244],{"id":256,"viewCount":58,"searchKey":257,"visible":14},"10003435",{"type":10,"entryId":258,"sortOrder":259,"name":260,"imageUrl":261,"description":262,"currentMorphology":9,"currentStage":263,"position":264,"attributes":265},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[23],[244],{"id":5,"viewCount":58,"searchKey":267,"visible":14},{"type":10,"entryId":8,"sortOrder":268,"name":269,"imageUrl":270,"description":271,"currentMorphology":9,"currentStage":263,"position":272,"attributes":274},1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[273],"position-break",[244,25],{"id":4,"viewCount":58,"searchKey":276,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":277,"attributes":278},[23],[25],{"id":6,"viewCount":58,"searchKey":280,"visible":14},{"type":10,"entryId":12,"sortOrder":281,"name":80,"imageUrl":282,"description":283,"currentMorphology":9,"currentStage":263,"position":284,"attributes":285},1001200,"/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[25],{"id":287,"viewCount":58,"searchKey":288,"visible":14},"10003488",{"type":10,"entryId":289,"sortOrder":290,"name":291,"imageUrl":292,"description":293,"currentMorphology":9,"currentStage":21,"position":294,"attributes":296},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[295],"position-sup",[297],"attributes-wind",{"id":299,"viewCount":58,"searchKey":300,"visible":14},"10003548",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":9,"currentStage":263,"position":306,"attributes":307},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[295],[297],{"id":309,"viewCount":58,"searchKey":310,"visible":14},"10003474",{"type":10,"entryId":311,"sortOrder":312,"name":313,"imageUrl":314,"description":315,"currentMorphology":9,"currentStage":263,"position":316,"attributes":317},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[297],{"id":319,"viewCount":58,"searchKey":320,"visible":14},"10003467",{"type":10,"entryId":321,"sortOrder":322,"name":323,"imageUrl":324,"description":325,"currentMorphology":9,"currentStage":263,"position":326,"attributes":327},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[273],[297],{"id":329,"viewCount":58,"searchKey":330,"visible":14},"10003392",{"type":10,"entryId":331,"sortOrder":332,"name":333,"imageUrl":334,"description":335,"currentMorphology":9,"currentStage":21,"position":336,"attributes":337},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[338],"attributes-grass",{"id":340,"viewCount":58,"searchKey":341,"visible":14},"10003510",{"type":10,"entryId":342,"sortOrder":343,"name":344,"imageUrl":345,"description":346,"currentMorphology":9,"currentStage":263,"position":347,"attributes":348},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[338],{"id":350,"viewCount":58,"searchKey":351,"visible":14},"10003477",{"type":10,"entryId":352,"sortOrder":353,"name":354,"imageUrl":355,"description":356,"currentMorphology":9,"currentStage":21,"position":357,"attributes":359},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[358],"position-heal",[360],"attributes-water",{"id":362,"viewCount":58,"searchKey":363,"visible":14},"10003569",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":9,"currentStage":201,"position":369,"attributes":370},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[358],[360],{"id":372,"viewCount":58,"searchKey":373,"visible":14},"10003470",{"type":10,"entryId":374,"sortOrder":375,"name":376,"imageUrl":377,"description":378,"currentMorphology":9,"currentStage":263,"position":379,"attributes":380},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[358],[360,381],"attributes-ice",{"id":383,"viewCount":58,"searchKey":384,"visible":14},"10003463",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":9,"currentStage":263,"position":390,"attributes":392},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[391],"position-energy",[338,360],{"id":394,"viewCount":58,"searchKey":395,"visible":14},"10003468",{"type":10,"entryId":396,"sortOrder":397,"name":398,"imageUrl":399,"description":400,"currentMorphology":9,"currentStage":21,"position":401,"attributes":402},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[295],[297],{"id":404,"viewCount":58,"searchKey":405,"visible":14},"10003365",{"type":10,"entryId":406,"sortOrder":407,"name":408,"imageUrl":409,"description":410,"currentMorphology":9,"currentStage":263,"position":411,"attributes":412},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[295],[297],{"id":414,"viewCount":58,"searchKey":415,"visible":14},"10003461",{"type":10,"entryId":416,"sortOrder":417,"name":418,"imageUrl":419,"description":420,"currentMorphology":9,"currentStage":263,"position":421,"attributes":422},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[295],[25],{"id":424,"viewCount":58,"searchKey":425,"visible":14},"10003421",{"type":10,"entryId":426,"sortOrder":427,"name":428,"imageUrl":429,"description":430,"currentMorphology":9,"currentStage":21,"position":431,"attributes":432},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[273],[338],{"id":434,"viewCount":58,"searchKey":435,"visible":14},"10003414",{"type":10,"entryId":436,"sortOrder":437,"name":438,"imageUrl":439,"description":440,"currentMorphology":9,"currentStage":263,"position":441,"attributes":442},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[391],[25,338],{"id":444,"viewCount":58,"searchKey":445,"visible":14},"10003404",{"type":10,"entryId":446,"sortOrder":447,"name":448,"imageUrl":449,"description":450,"currentMorphology":9,"currentStage":263,"position":451,"attributes":452},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[273],[338],{"id":454,"viewCount":58,"searchKey":455,"visible":14},"10003567",{"type":10,"entryId":456,"sortOrder":457,"name":458,"imageUrl":459,"description":460,"currentMorphology":9,"currentStage":21,"position":461,"attributes":462},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[273],[463,338],"attributes-rock",{"id":465,"viewCount":58,"searchKey":466,"visible":14},"10003462",{"type":10,"entryId":467,"sortOrder":468,"name":469,"imageUrl":470,"description":471,"currentMorphology":9,"currentStage":263,"position":472,"attributes":473},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[273],[463,338],{"id":475,"viewCount":58,"searchKey":476,"visible":14},"10003551",{"type":10,"entryId":477,"sortOrder":478,"name":479,"imageUrl":480,"description":481,"currentMorphology":9,"currentStage":263,"position":482,"attributes":483},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[273],[381],{"id":485,"viewCount":58,"searchKey":486,"visible":14},"10003409",{"type":10,"entryId":487,"sortOrder":488,"name":489,"imageUrl":490,"description":491,"currentMorphology":9,"currentStage":21,"position":492,"attributes":493},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[391],[244],{"id":495,"viewCount":58,"searchKey":496,"visible":14},"10003507",{"type":10,"entryId":497,"sortOrder":498,"name":499,"imageUrl":500,"description":501,"currentMorphology":9,"currentStage":263,"position":502,"attributes":503},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[391],[244],{"id":505,"viewCount":58,"searchKey":506,"visible":14},"10003542",{"type":10,"entryId":507,"sortOrder":508,"name":509,"imageUrl":510,"description":511,"currentMorphology":9,"currentStage":21,"position":512,"attributes":513},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[358],[297],{"id":515,"viewCount":58,"searchKey":516,"visible":14},"10003440",{"type":10,"entryId":517,"sortOrder":518,"name":519,"imageUrl":520,"description":521,"currentMorphology":9,"currentStage":263,"position":522,"attributes":523},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[358],[297],{"id":525,"viewCount":58,"searchKey":526,"visible":14},"10003563",{"type":10,"entryId":527,"sortOrder":528,"name":529,"imageUrl":530,"description":531,"currentMorphology":9,"currentStage":229,"position":532,"attributes":533},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[391],[297,338],{"id":535,"viewCount":58,"searchKey":536,"visible":14},"10003368",{"type":10,"entryId":537,"sortOrder":538,"name":539,"imageUrl":540,"description":541,"currentMorphology":9,"currentStage":21,"position":542,"attributes":543},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[295],[297],{"id":545,"viewCount":58,"searchKey":546,"visible":14},"10003363",{"type":10,"entryId":547,"sortOrder":548,"name":549,"imageUrl":550,"description":551,"currentMorphology":9,"currentStage":263,"position":552,"attributes":553},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[295],[297],{"id":555,"viewCount":58,"searchKey":556,"visible":14},"10003515",{"type":10,"entryId":557,"sortOrder":558,"name":559,"imageUrl":560,"description":561,"currentMorphology":9,"currentStage":21,"position":562,"attributes":563},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[338],{"id":565,"viewCount":58,"searchKey":566,"visible":14},"10003496",{"type":10,"entryId":567,"sortOrder":568,"name":569,"imageUrl":570,"description":571,"currentMorphology":9,"currentStage":263,"position":572,"attributes":573},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[338],{"id":575,"viewCount":58,"searchKey":576,"visible":14},"10003378",{"type":10,"entryId":577,"sortOrder":578,"name":579,"imageUrl":580,"description":581,"currentMorphology":9,"currentStage":263,"position":582,"attributes":583},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[295],[338],{"id":585,"viewCount":58,"searchKey":586,"visible":14},"10003456",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":9,"currentStage":21,"position":592,"attributes":593},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[273],[338],{"id":595,"viewCount":58,"searchKey":596,"visible":14},"10003374",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":9,"currentStage":263,"position":602,"attributes":603},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[295],[604],"attributes-electric",{"id":606,"viewCount":58,"searchKey":607,"visible":14},"10003443",{"type":10,"entryId":608,"sortOrder":609,"name":610,"imageUrl":611,"description":612,"currentMorphology":9,"currentStage":263,"position":613,"attributes":614},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[273],[338],{"id":616,"viewCount":58,"searchKey":617,"visible":14},"10003503",{"type":10,"entryId":618,"sortOrder":619,"name":620,"imageUrl":621,"description":622,"currentMorphology":9,"currentStage":21,"position":623,"attributes":624},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[295],[25],{"id":626,"viewCount":58,"searchKey":627,"visible":14},"10003521",{"type":10,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":9,"currentStage":263,"position":633,"attributes":634},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[295],[25],{"id":636,"viewCount":58,"searchKey":637,"visible":14},"10003508",{"type":10,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":9,"currentStage":21,"position":643,"attributes":644},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[25],{"id":646,"viewCount":58,"searchKey":647,"visible":14},"10003369",{"type":10,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":9,"currentStage":263,"position":653,"attributes":654},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[25],{"id":656,"viewCount":58,"searchKey":657,"visible":14},"10003501",{"type":10,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":9,"currentStage":263,"position":663,"attributes":664},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[604],{"id":666,"viewCount":58,"searchKey":667,"visible":14},"10003422",{"type":10,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":9,"currentStage":21,"position":673,"attributes":674},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[381],{"id":676,"viewCount":58,"searchKey":677,"visible":14},"10003575",{"type":10,"entryId":678,"sortOrder":679,"name":680,"imageUrl":681,"description":682,"currentMorphology":9,"currentStage":201,"position":683,"attributes":684},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[381],{"id":686,"viewCount":58,"searchKey":687,"visible":14},"10003415",{"type":10,"entryId":688,"sortOrder":689,"name":690,"imageUrl":691,"description":692,"currentMorphology":9,"currentStage":263,"position":693,"attributes":694},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[381],{"id":696,"viewCount":58,"searchKey":697,"visible":14},"10003524",{"type":10,"entryId":698,"sortOrder":699,"name":700,"imageUrl":701,"description":702,"currentMorphology":9,"currentStage":21,"position":703,"attributes":704},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[273],[604],{"id":706,"viewCount":58,"searchKey":707,"visible":14},"10003475",{"type":10,"entryId":708,"sortOrder":709,"name":710,"imageUrl":711,"description":712,"currentMorphology":9,"currentStage":263,"position":713,"attributes":714},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[273],[604],{"id":716,"viewCount":58,"searchKey":717,"visible":14},"10003523",{"type":10,"entryId":718,"sortOrder":719,"name":720,"imageUrl":721,"description":722,"currentMorphology":9,"currentStage":21,"position":723,"attributes":724},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[273],[360],{"id":726,"viewCount":58,"searchKey":727,"visible":14},"10003398",{"type":10,"entryId":728,"sortOrder":729,"name":730,"imageUrl":731,"description":732,"currentMorphology":9,"currentStage":201,"position":733,"attributes":734},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[273],[360],{"id":736,"viewCount":58,"searchKey":737,"visible":14},"10003516",{"type":10,"entryId":738,"sortOrder":739,"name":740,"imageUrl":741,"description":742,"currentMorphology":9,"currentStage":263,"position":743,"attributes":744},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[295],[360],{"id":746,"viewCount":58,"searchKey":747,"visible":14},"10003566",{"type":10,"entryId":748,"sortOrder":749,"name":750,"imageUrl":751,"description":752,"currentMorphology":9,"currentStage":263,"position":753,"attributes":754},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[273],[360],{"id":756,"viewCount":58,"searchKey":757,"visible":14},"10003453",{"type":10,"entryId":758,"sortOrder":759,"name":760,"imageUrl":761,"description":762,"currentMorphology":9,"currentStage":21,"position":763,"attributes":764},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[360],{"id":766,"viewCount":58,"searchKey":767,"visible":14},"10003577",{"type":10,"entryId":768,"sortOrder":769,"name":770,"imageUrl":771,"description":772,"currentMorphology":9,"currentStage":201,"position":773,"attributes":774},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[360],{"id":776,"viewCount":58,"searchKey":777,"visible":14},"10003570",{"type":10,"entryId":778,"sortOrder":779,"name":780,"imageUrl":781,"description":782,"currentMorphology":9,"currentStage":263,"position":783,"attributes":784},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[360],{"id":786,"viewCount":58,"searchKey":787,"visible":14},"10003565",{"type":10,"entryId":788,"sortOrder":789,"name":790,"imageUrl":791,"description":792,"currentMorphology":9,"currentStage":21,"position":793,"attributes":794},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[463],{"id":796,"viewCount":58,"searchKey":797,"visible":14},"10003476",{"type":10,"entryId":798,"sortOrder":799,"name":800,"imageUrl":801,"description":802,"currentMorphology":9,"currentStage":263,"position":803,"attributes":804},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[463],{"id":806,"viewCount":58,"searchKey":807,"visible":14},"10003466",{"type":10,"entryId":808,"sortOrder":809,"name":810,"imageUrl":811,"description":812,"currentMorphology":9,"currentStage":263,"position":813,"attributes":814},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[295],[463],{"id":816,"viewCount":58,"searchKey":817,"visible":14},"10003379",{"type":10,"entryId":818,"sortOrder":819,"name":820,"imageUrl":821,"description":822,"currentMorphology":9,"currentStage":21,"position":823,"attributes":824},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[604],{"id":826,"viewCount":58,"searchKey":827,"visible":14},"10003376",{"type":10,"entryId":828,"sortOrder":829,"name":830,"imageUrl":831,"description":832,"currentMorphology":9,"currentStage":263,"position":833,"attributes":834},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[604],{"id":836,"viewCount":58,"searchKey":837,"visible":14},"10003543",{"type":10,"entryId":838,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":9,"currentStage":21,"position":843,"attributes":844},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[273],[25],{"id":846,"viewCount":58,"searchKey":847,"visible":14},"10003557",{"type":10,"entryId":848,"sortOrder":849,"name":850,"imageUrl":851,"description":852,"currentMorphology":9,"currentStage":263,"position":853,"attributes":854},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[25],{"id":856,"viewCount":58,"searchKey":857,"visible":14},"10003522",{"type":10,"entryId":858,"sortOrder":859,"name":860,"imageUrl":861,"description":862,"currentMorphology":9,"currentStage":263,"position":863,"attributes":864},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[273],[25],{"id":866,"viewCount":58,"searchKey":867,"visible":14},"10003579",{"type":10,"entryId":868,"sortOrder":869,"name":870,"imageUrl":871,"description":872,"currentMorphology":9,"currentStage":21,"position":873,"attributes":874},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[273],[297],{"id":876,"viewCount":58,"searchKey":877,"visible":14},"10003389",{"type":10,"entryId":878,"sortOrder":879,"name":880,"imageUrl":881,"description":882,"currentMorphology":9,"currentStage":201,"position":883,"attributes":884},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[273],[297],{"id":886,"viewCount":58,"searchKey":887,"visible":14},"10003536",{"type":10,"entryId":888,"sortOrder":889,"name":890,"imageUrl":891,"description":892,"currentMorphology":9,"currentStage":263,"position":893,"attributes":894},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[273],[297],{"id":896,"viewCount":58,"searchKey":897,"visible":14},"10003529",{"type":10,"entryId":898,"sortOrder":899,"name":900,"imageUrl":901,"description":902,"currentMorphology":9,"currentStage":263,"position":903,"attributes":904},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[244],{"id":906,"viewCount":58,"searchKey":907,"visible":14},"10003433",{"type":10,"entryId":908,"sortOrder":909,"name":910,"imageUrl":911,"description":912,"currentMorphology":9,"currentStage":21,"position":913,"attributes":914},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[463],{"id":916,"viewCount":58,"searchKey":917,"visible":14},"10003427",{"type":10,"entryId":918,"sortOrder":919,"name":920,"imageUrl":921,"description":922,"currentMorphology":9,"currentStage":263,"position":923,"attributes":924},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[463],{"id":926,"viewCount":58,"searchKey":927,"visible":14},"10003405",{"type":10,"entryId":928,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":9,"currentStage":21,"position":933,"attributes":934},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[273],[463],{"id":936,"viewCount":58,"searchKey":937,"visible":14},"10003525",{"type":10,"entryId":938,"sortOrder":939,"name":940,"imageUrl":941,"description":942,"currentMorphology":9,"currentStage":201,"position":943,"attributes":944},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[273],[244,463],{"id":946,"viewCount":58,"searchKey":947,"visible":14},"10003399",{"type":10,"entryId":948,"sortOrder":949,"name":950,"imageUrl":951,"description":952,"currentMorphology":9,"currentStage":263,"position":953,"attributes":954},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[273],[244,463],{"id":956,"viewCount":58,"searchKey":957,"visible":14},"10003518",{"type":10,"entryId":958,"sortOrder":959,"name":960,"imageUrl":961,"description":962,"currentMorphology":9,"currentStage":201,"position":963,"attributes":964},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[273],[463],{"id":966,"viewCount":58,"searchKey":967,"visible":14},"10003393",{"type":10,"entryId":968,"sortOrder":969,"name":970,"imageUrl":971,"description":972,"currentMorphology":9,"currentStage":263,"position":973,"attributes":974},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[273],[463],{"id":976,"viewCount":58,"searchKey":977,"visible":14},"10003386",{"type":10,"entryId":978,"sortOrder":979,"name":980,"imageUrl":981,"description":982,"currentMorphology":9,"currentStage":21,"position":983,"attributes":984},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[295],[463],{"id":986,"viewCount":58,"searchKey":987,"visible":14},"10003447",{"type":10,"entryId":988,"sortOrder":989,"name":990,"imageUrl":991,"description":992,"currentMorphology":9,"currentStage":263,"position":993,"attributes":994},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[295],[463],{"id":996,"viewCount":58,"searchKey":997,"visible":14},"10003497",{"type":10,"entryId":998,"sortOrder":999,"name":1000,"imageUrl":1001,"description":1002,"currentMorphology":9,"currentStage":21,"position":1003,"attributes":1004},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[295],[604],{"id":1006,"viewCount":58,"searchKey":1007,"visible":14},"10003479",{"type":10,"entryId":1008,"sortOrder":1009,"name":1010,"imageUrl":1011,"description":1012,"currentMorphology":9,"currentStage":201,"position":1013,"attributes":1014},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[295],[604],{"id":1016,"viewCount":58,"searchKey":1017,"visible":14},"10003388",{"type":10,"entryId":1018,"sortOrder":1019,"name":1020,"imageUrl":1021,"description":1022,"currentMorphology":9,"currentStage":263,"position":1023,"attributes":1024},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[295],[604],{"id":1026,"viewCount":58,"searchKey":1027,"visible":14},"10003429",{"type":10,"entryId":1028,"sortOrder":1029,"name":1030,"imageUrl":1031,"description":1032,"currentMorphology":9,"currentStage":21,"position":1033,"attributes":1034},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[391],[360],{"id":1036,"viewCount":58,"searchKey":1037,"visible":14},"10003430",{"type":10,"entryId":1038,"sortOrder":1039,"name":1040,"imageUrl":1041,"description":1042,"currentMorphology":9,"currentStage":263,"position":1043,"attributes":1044},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[391],[360],{"id":1046,"viewCount":58,"searchKey":1047,"visible":14},"10003549",{"type":10,"entryId":1048,"sortOrder":1049,"name":1050,"imageUrl":1051,"description":1052,"currentMorphology":9,"currentStage":229,"position":1053,"attributes":1054},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[391],[604],{"id":1056,"viewCount":58,"searchKey":1057,"visible":14},"10003494",{"type":10,"entryId":1058,"sortOrder":1059,"name":1060,"imageUrl":1061,"description":1062,"currentMorphology":9,"currentStage":21,"position":1063,"attributes":1064},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[391],[463,360],{"id":1066,"viewCount":58,"searchKey":1067,"visible":14},"10003486",{"type":10,"entryId":1068,"sortOrder":1069,"name":1070,"imageUrl":1071,"description":1072,"currentMorphology":9,"currentStage":263,"position":1073,"attributes":1074},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[391],[463,360],{"id":1076,"viewCount":58,"searchKey":1077,"visible":14},"10003530",{"type":10,"entryId":1078,"sortOrder":1079,"name":1080,"imageUrl":1081,"description":1082,"currentMorphology":9,"currentStage":21,"position":1083,"attributes":1084},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[273],[381],{"id":1086,"viewCount":58,"searchKey":1087,"visible":14},"10003457",{"type":10,"entryId":1088,"sortOrder":1089,"name":1090,"imageUrl":1091,"description":1092,"currentMorphology":9,"currentStage":263,"position":1093,"attributes":1094},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[273],[381],{"id":1096,"viewCount":58,"searchKey":1097,"visible":14},"10003423",{"type":10,"entryId":1098,"sortOrder":1099,"name":1100,"imageUrl":1101,"description":1102,"currentMorphology":9,"currentStage":21,"position":1103,"attributes":1104},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[358],[338,360],{"id":1106,"viewCount":58,"searchKey":1107,"visible":14},"10003419",{"type":10,"entryId":1108,"sortOrder":1109,"name":1110,"imageUrl":1111,"description":1112,"currentMorphology":9,"currentStage":263,"position":1113,"attributes":1114},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[358],[338,360],{"id":1116,"viewCount":58,"searchKey":1117,"visible":14},"10003410",{"type":10,"entryId":1118,"sortOrder":1119,"name":1120,"imageUrl":1121,"description":1122,"currentMorphology":9,"currentStage":21,"position":1123,"attributes":1124},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[360],{"id":1126,"viewCount":58,"searchKey":1127,"visible":14},"10003509",{"type":10,"entryId":1128,"sortOrder":1129,"name":1130,"imageUrl":1131,"description":1132,"currentMorphology":9,"currentStage":263,"position":1133,"attributes":1134},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[360],{"id":1136,"viewCount":58,"searchKey":1137,"visible":14},"10003413",{"type":10,"entryId":1138,"sortOrder":1139,"name":1140,"imageUrl":1141,"description":1142,"currentMorphology":9,"currentStage":21,"position":1143,"attributes":1144},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[381],{"id":1146,"viewCount":58,"searchKey":1147,"visible":14},"10003407",{"type":10,"entryId":1148,"sortOrder":1149,"name":1150,"imageUrl":1151,"description":1152,"currentMorphology":9,"currentStage":263,"position":1153,"attributes":1154},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[381],{"id":1156,"viewCount":58,"searchKey":1157,"visible":14},"10003498",{"type":10,"entryId":1158,"sortOrder":1159,"name":1160,"imageUrl":1161,"description":1162,"currentMorphology":9,"currentStage":229,"position":1163,"attributes":1164},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1165],"attributes-holy",{"id":1167,"viewCount":58,"searchKey":1168,"visible":14},"10003375",{"type":10,"entryId":1169,"sortOrder":1170,"name":1171,"imageUrl":1172,"description":1173,"currentMorphology":9,"currentStage":229,"position":1174,"attributes":1175},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1165],[1177,1185,1190,1195,1200,1205,1210,1215,1219,1223,1228,1233,1238,1243,1248,1253,1258,1263,1266],{"id":1178,"parentId":1179,"tagType":1180,"tagKey":1181,"name":1182,"language":1183,"sort":1184},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1186,"parentId":1179,"tagType":1180,"tagKey":1187,"name":1188,"language":1183,"sort":1189},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1191,"parentId":1179,"tagType":1180,"tagKey":1192,"name":1193,"language":1183,"sort":1194},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1196,"parentId":1179,"tagType":1180,"tagKey":1197,"name":1198,"language":1183,"sort":1199},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1201,"parentId":1179,"tagType":1180,"tagKey":1202,"name":1203,"language":1183,"sort":1204},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1206,"parentId":1179,"tagType":1180,"tagKey":1207,"name":1208,"language":1183,"sort":1209},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1211,"parentId":1179,"tagType":1180,"tagKey":1212,"name":1213,"language":1183,"sort":1214},"568127bc77f184cd4308056381642df7","Snowfield 