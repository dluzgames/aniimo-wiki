descContent":215,"source":216},"91268506_38","/cdn/init/1045300_Skill_10800260_Icon.png","砂暴大迴環","進入「高速旋轉」狀態，持續消耗能量值並造成傷害，對被擊破的目標額外造成20%傷害。轉速逐漸提高，在不提高消耗的情況下最多提高100%傷害頻率。",{"attributes":217,"type":218,"consume":219,"power":185},[196],[184],"10",{"id":221,"title":222,"children":223},"91268506_39","固有技能",[224,236],{"id":225,"type":138,"props":226},"91268506_40",{"id":227,"customKey":46,"icon":228,"iconStyle":64,"iconTitle":46,"descTitle":229,"descContent":230,"source":231},"91268506_41","/cdn/init/1045300_Skill_10800270_Icon.png","岩輪燼滅爆轟","向前方發射巨型的岩球，輾壓目標後發生爆炸。",{"attributes":232,"type":233,"consume":234,"power":235},[196],[184],"0","195",{"id":237,"type":138,"props":238},"91268506_42",{"id":239,"customKey":46,"icon":240,"iconStyle":64,"iconTitle":46,"descTitle":241,"descContent":242,"source":243},"91268506_43","/cdn/init/1045300_Skill_10800000_Icon.png","攻擊","使用土元素能力，近距離攻擊目標。",{"attributes":244,"type":245,"consume":234,"power":246},[196],[184],"6",[248,249],{"id":4,"entryId":12,"currentMorphology":20,"visible":14},{"id":6,"entryId":12,"currentMorphology":9,"visible":14},[251,262,272,282,294,304,314,326,336,346,356,367,377,389,399,410,421,431,441,451,461,471,481,491,501,511,521,531,541,551,561,571,581,591,601,611,621,632,642,652,662,672,682,692,702,712,722,732,742,752,762,772,782,792,802,812,820,824,833,843,853,863,873,883,893,903,913,923,933,943,953,963,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1133,1143,1153,1163,1173,1184],{"id":252,"viewCount":58,"searchKey":253,"visible":14},"10003442",{"type":10,"entryId":254,"sortOrder":255,"name":256,"imageUrl":257,"description":258,"currentMorphology":20,"currentStage":184,"position":259,"attributes":260},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[261],"attributes-fire",{"id":263,"viewCount":58,"searchKey":264,"visible":14},"10003534",{"type":10,"entryId":265,"sortOrder":266,"name":267,"imageUrl":268,"description":269,"currentMorphology":20,"currentStage":182,"position":270,"attributes":271},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[261],{"id":273,"viewCount":58,"searchKey":274,"visible":14},"10003435",{"type":10,"entryId":275,"sortOrder":276,"name":277,"imageUrl":278,"description":279,"currentMorphology":20,"currentStage":21,"position":280,"attributes":281},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[23],[261],{"id":283,"viewCount":58,"searchKey":284,"visible":14},"10003428",{"type":10,"entryId":285,"sortOrder":286,"name":287,"imageUrl":288,"description":289,"currentMorphology":20,"currentStage":21,"position":290,"attributes":292},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[291],"position-break",[261,293],"attributes-dark",{"id":295,"viewCount":58,"searchKey":296,"visible":14},"10003578",{"type":10,"entryId":297,"sortOrder":298,"name":299,"imageUrl":300,"description":301,"currentMorphology":20,"currentStage":184,"position":302,"attributes":303},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[293],{"id":305,"viewCount":58,"searchKey":306,"visible":14},"10003417",{"type":10,"entryId":307,"sortOrder":308,"name":309,"imageUrl":310,"description":311,"currentMorphology":20,"currentStage":21,"position":312,"attributes":313},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[293],{"id":315,"viewCount":58,"searchKey":316,"visible":14},"10003488",{"type":10,"entryId":317,"sortOrder":318,"name":319,"imageUrl":320,"description":321,"currentMorphology":20,"currentStage":184,"position":322,"attributes":324},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[323],"position-sup",[325],"attributes-wind",{"id":327,"viewCount":58,"searchKey":328,"visible":14},"10003548",{"type":10,"entryId":329,"sortOrder":330,"name":331,"imageUrl":332,"description":333,"currentMorphology":20,"currentStage":21,"position":334,"attributes":335},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[323],[325],{"id":337,"viewCount":58,"searchKey":338,"visible":14},"10003474",{"type":10,"entryId":339,"sortOrder":340,"name":341,"imageUrl":342,"description":343,"currentMorphology":20,"currentStage":21,"position":344,"attributes":345},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[325],{"id":347,"viewCount":58,"searchKey":348,"visible":14},"10003467",{"type":10,"entryId":349,"sortOrder":350,"name":351,"imageUrl":352,"description":353,"currentMorphology":20,"currentStage":21,"position":354,"attributes":355},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[291],[325],{"id":357,"viewCount":58,"searchKey":358,"visible":14},"10003392",{"type":10,"entryId":359,"sortOrder":360,"name":361,"imageUrl":362,"description":363,"currentMorphology":20,"currentStage":184,"position":364,"attributes":365},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[366],"attributes-grass",{"id":368,"viewCount":58,"searchKey":369,"visible":14},"10003510",{"type":10,"entryId":370,"sortOrder":371,"name":372,"imageUrl":373,"description":374,"currentMorphology":20,"currentStage":21,"position":375,"attributes":376},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[366],{"id":378,"viewCount":58,"searchKey":379,"visible":14},"10003477",{"type":10,"entryId":380,"sortOrder":381,"name":382,"imageUrl":383,"description":384,"currentMorphology":20,"currentStage":184,"position":385,"attributes":387},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[386],"position-heal",[388],"attributes-water",{"id":390,"viewCount":58,"searchKey":391,"visible":14},"10003569",{"type":10,"entryId":392,"sortOrder":393,"name":394,"imageUrl":395,"description":396,"currentMorphology":20,"currentStage":182,"position":397,"attributes":398},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[386],[388],{"id":400,"viewCount":58,"searchKey":401,"visible":14},"10003470",{"type":10,"entryId":402,"sortOrder":403,"name":404,"imageUrl":405,"description":406,"currentMorphology":20,"currentStage":21,"position":407,"attributes":408},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[386],[388,409],"attributes-ice",{"id":411,"viewCount":58,"searchKey":412,"visible":14},"10003463",{"type":10,"entryId":413,"sortOrder":414,"name":415,"imageUrl":416,"description":417,"currentMorphology":20,"currentStage":21,"position":418,"attributes":420},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[419],"position-energy",[366,388],{"id":422,"viewCount":58,"searchKey":423,"visible":14},"10003468",{"type":10,"entryId":424,"sortOrder":425,"name":426,"imageUrl":427,"description":428,"currentMorphology":20,"currentStage":184,"position":429,"attributes":430},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[323],[325],{"id":432,"viewCount":58,"searchKey":433,"visible":14},"10003365",{"type":10,"entryId":434,"sortOrder":435,"name":436,"imageUrl":437,"description":438,"currentMorphology":20,"currentStage":21,"position":439,"attributes":440},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[323],[325],{"id":442,"viewCount":58,"searchKey":443,"visible":14},"10003461",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":20,"currentStage":21,"position":449,"attributes":450},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[323],[293],{"id":452,"viewCount":58,"searchKey":453,"visible":14},"10003421",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":20,"currentStage":184,"position":459,"attributes":460},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[291],[366],{"id":462,"viewCount":58,"searchKey":463,"visible":14},"10003414",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":20,"currentStage":21,"position":469,"attributes":470},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[419],[293,366],{"id":472,"viewCount":58,"searchKey":473,"visible":14},"10003404",{"type":10,"entryId":474,"sortOrder":475,"name":476,"imageUrl":477,"description":478,"currentMorphology":20,"currentStage":21,"position":479,"attributes":480},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[291],[366],{"id":482,"viewCount":58,"searchKey":483,"visible":14},"10003567",{"type":10,"entryId":484,"sortOrder":485,"name":486,"imageUrl":487,"description":488,"currentMorphology":20,"currentStage":184,"position":489,"attributes":490},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[291],[25,366],{"id":492,"viewCount":58,"searchKey":493,"visible":14},"10003462",{"type":10,"entryId":494,"sortOrder":495,"name":496,"imageUrl":497,"description":498,"currentMorphology":20,"currentStage":21,"position":499,"attributes":500},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[291],[25,366],{"id":502,"viewCount":58,"searchKey":503,"visible":14},"10003551",{"type":10,"entryId":504,"sortOrder":505,"name":506,"imageUrl":507,"description":508,"currentMorphology":20,"currentStage":21,"position":509,"attributes":510},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[291],[409],{"id":512,"viewCount":58,"searchKey":513,"visible":14},"10003409",{"type":10,"entryId":514,"sortOrder":515,"name":516,"imageUrl":517,"description":518,"currentMorphology":20,"currentStage":184,"position":519,"attributes":520},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[419],[261],{"id":522,"viewCount":58,"searchKey":523,"visible":14},"10003507",{"type":10,"entryId":524,"sortOrder":525,"name":526,"imageUrl":527,"description":528,"currentMorphology":20,"currentStage":21,"position":529,"attributes":530},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[419],[261],{"id":532,"viewCount":58,"searchKey":533,"visible":14},"10003542",{"type":10,"entryId":534,"sortOrder":535,"name":536,"imageUrl":537,"description":538,"currentMorphology":20,"currentStage":184,"position":539,"attributes":540},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[386],[325],{"id":542,"viewCount":58,"searchKey":543,"visible":14},"10003440",{"type":10,"entryId":544,"sortOrder":545,"name":546,"imageUrl":547,"description":548,"currentMorphology":20,"currentStage":21,"position":549,"attributes":550},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[386],[325],{"id":552,"viewCount":58,"searchKey":553,"visible":14},"10003563",{"type":10,"entryId":554,"sortOrder":555,"name":556,"imageUrl":557,"description":558,"currentMorphology":20,"currentStage":234,"position":559,"attributes":560},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[419],[325,366],{"id":562,"viewCount":58,"searchKey":563,"visible":14},"10003368",{"type":10,"entryId":564,"sortOrder":565,"name":566,"imageUrl":567,"description":568,"currentMorphology":20,"currentStage":184,"position":569,"attributes":570},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[323],[325],{"id":572,"viewCount":58,"searchKey":573,"visible":14},"10003363",{"type":10,"entryId":574,"sortOrder":575,"name":576,"imageUrl":577,"description":578,"currentMorphology":20,"currentStage":21,"position":579,"attributes":580},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[323],[325],{"id":582,"viewCount":58,"searchKey":583,"visible":14},"10003515",{"type":10,"entryId":584,"sortOrder":585,"name":586,"imageUrl":587,"description":588,"currentMorphology":20,"currentStage":184,"position":589,"attributes":590},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[366],{"id":592,"viewCount":58,"searchKey":593,"visible":14},"10003496",{"type":10,"entryId":594,"sortOrder":595,"name":596,"imageUrl":597,"description":598,"currentMorphology":20,"currentStage":21,"position":599,"attributes":600},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[366],{"id":602,"viewCount":58,"searchKey":603,"visible":14},"10003378",{"type":10,"entryId":604,"sortOrder":605,"name":606,"imageUrl":607,"description":608,"currentMorphology":20,"currentStage":21,"position":609,"attributes":610},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[323],[366],{"id":612,"viewCount":58,"searchKey":613,"visible":14},"10003456",{"type":10,"entryId":614,"sortOrder":615,"name":616,"imageUrl":617,"description":618,"currentMorphology":20,"currentStage":184,"position":619,"attributes":620},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[291],[366],{"id":622,"viewCount":58,"searchKey":623,"visible":14},"10003374",{"type":10,"entryId":624,"sortOrder":625,"name":626,"imageUrl":627,"description":628,"currentMorphology":20,"currentStage":21,"position":629,"attributes":630},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[323],[631],"attributes-electric",{"id":633,"viewCount":58,"searchKey":634,"visible":14},"10003443",{"type":10,"entryId":635,"sortOrder":636,"name":637,"imageUrl":638,"description":639,"currentMorphology":20,"currentStage":21,"position":640,"attributes":641},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[291],[366],{"id":643,"viewCount":58,"searchKey":644,"visible":14},"10003503",{"type":10,"entryId":645,"sortOrder":646,"name":647,"imageUrl":648,"description":649,"currentMorphology":20,"currentStage":184,"position":650,"attributes":651},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[323],[293],{"id":653,"viewCount":58,"searchKey":654,"visible":14},"10003521",{"type":10,"entryId":655,"sortOrder":656,"name":657,"imageUrl":658,"description":659,"currentMorphology":20,"currentStage":21,"position":660,"attributes":661},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[323],[293],{"id":663,"viewCount":58,"searchKey":664,"visible":14},"10003508",{"type":10,"entryId":665,"sortOrder":666,"name":667,"imageUrl":668,"description":669,"currentMorphology":20,"currentStage":184,"position":670,"attributes":671},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[293],{"id":673,"viewCount":58,"searchKey":674,"visible":14},"10003369",{"type":10,"entryId":675,"sortOrder":676,"name":677,"imageUrl":678,"description":679,"currentMorphology":20,"currentStage":21,"position":680,"attributes":681},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[293],{"id":683,"viewCount":58,"searchKey":684,"visible":14},"10003501",{"type":10,"entryId":685,"sortOrder":686,"name":687,"imageUrl":688,"description":689,"currentMorphology":20,"currentStage":21,"position":690,"attributes":691},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[631],{"id":693,"viewCount":58,"searchKey":694,"visible":14},"10003422",{"type":10,"entryId":695,"sortOrder":696,"name":697,"imageUrl":698,"description":699,"currentMorphology":20,"currentStage":184,"position":700,"attributes":701},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[409],{"id":703,"viewCount":58,"searchKey":704,"visible":14},"10003575",{"type":10,"entryId":705,"sortOrder":706,"name":707,"imageUrl":708,"description":709,"currentMorphology":20,"currentStage":182,"position":710,"attributes":711},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[409],{"id":713,"viewCount":58,"searchKey":714,"visible":14},"10003415",{"type":10,"entryId":715,"sortOrder":716,"name":717,"imageUrl":718,"description":719,"currentMorphology":20,"currentStage":21,"position":720,"attributes":721},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[409],{"id":723,"viewCount":58,"searchKey":724,"visible":14},"10003524",{"type":10,"entryId":725,"sortOrder":726,"name":727,"imageUrl":728,"description":729,"currentMorphology":20,"currentStage":184,"position":730,"attributes":731},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[291],[631],{"id":733,"viewCount":58,"searchKey":734,"visible":14},"10003475",{"type":10,"entryId":735,"sortOrder":736,"name":737,"imageUrl":738,"description":739,"currentMorphology":20,"currentStage":21,"position":740,"attributes":741},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[291],[631],{"id":743,"viewCount":58,"searchKey":744,"visible":14},"10003523",{"type":10,"entryId":745,"sortOrder":746,"name":747,"imageUrl":748,"description":749,"currentMorphology":20,"currentStage":184,"position":750,"attributes":751},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[291],[388],{"id":753,"viewCount":58,"searchKey":754,"visible":14},"10003398",{"type":10,"entryId":755,"sortOrder":756,"name":757,"imageUrl":758,"description":759,"currentMorphology":20,"currentStage":182,"position":760,"attributes":761},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[291],[388],{"id":763,"viewCount":58,"searchKey":764,"visible":14},"10003516",{"type":10,"entryId":765,"sortOrder":766,"name":767,"imageUrl":768,"description":769,"currentMorphology":20,"currentStage":21,"position":770,"attributes":771},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[323],[388],{"id":773,"viewCount":58,"searchKey":774,"visible":14},"10003566",{"type":10,"entryId":775,"sortOrder":776,"name":777,"imageUrl":778,"description":779,"currentMorphology":20,"currentStage":21,"position":780,"attributes":781},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[291],[388],{"id":783,"viewCount":58,"searchKey":784,"visible":14},"10003453",{"type":10,"entryId":785,"sortOrder":786,"name":787,"imageUrl":788,"description":789,"currentMorphology":20,"currentStage":184,"position":790,"attributes":791},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[388],{"id":793,"viewCount":58,"searchKey":794,"visible":14},"10003577",{"type":10,"entryId":795,"sortOrder":796,"name":797,"imageUrl":798,"description":799,"currentMorphology":20,"currentStage":182,"position":800,"attributes":801},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[388],{"id":803,"viewCount":58,"searchKey":804,"visible":14},"10003570",{"type":10,"entryId":805,"sortOrder":806,"name":807,"imageUrl":808,"description":809,"currentMorphology":20,"currentStage":21,"position":810,"attributes":811},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[388],{"id":813,"viewCount":58,"searchKey":814,"visible":14},"10003565",{"type":10,"entryId":8,"sortOrder":815,"name":74,"imageUrl":816,"description":817,"currentMorphology":20,"currentStage":184,"position":818,"attributes":819},1045100,"/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[25],{"id":4,"viewCount":58,"searchKey":821,"visible":14},{"type":10,"entryId":12,"sortOrder":16,"name":17,"imageUrl":18,"description":19,"currentMorphology":20,"currentStage":21,"position":822,"attributes":823},[23],[25],{"id":825,"viewCount":58,"searchKey":826,"visible":14},"10003466",{"type":10,"entryId":827,"sortOrder":828,"name":87,"imageUrl":829,"description":830,"currentMorphology":20,"currentStage":21,"position":831,"attributes":832},"059",1045400,"/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[323],[25],{"id":834,"viewCount":58,"searchKey":835,"visible":14},"10003379",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":20,"currentStage":184,"position":841,"attributes":842},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[631],{"id":844,"viewCount":58,"searchKey":845,"visible":14},"10003376",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":20,"currentStage":21,"position":851,"attributes":852},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[631],{"id":854,"viewCount":58,"searchKey":855,"visible":14},"10003543",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":20,"currentStage":184,"position":861,"attributes":862},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[291],[293],{"id":864,"viewCount":58,"searchKey":865,"visible":14},"10003557",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":20,"currentStage":21,"position":871,"attributes":872},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[293],{"id":874,"viewCount":58,"searchKey":875,"visible":14},"10003522",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":20,"currentStage":21,"position":881,"attributes":882},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[291],[293],{"id":884,"viewCount":58,"searchKey":885,"visible":14},"10003579",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":20,"currentStage":184,"position":891,"attributes":892},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[291],[325],{"id":894,"viewCount":58,"searchKey":895,"visible":14},"10003389",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":20,"currentStage":182,"position":901,"attributes":902},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[291],[325],{"id":904,"viewCount":58,"searchKey":905,"visible":14},"10003536",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":20,"currentStage":21,"position":911,"attributes":912},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[291],[325],{"id":914,"viewCount":58,"searchKey":915,"visible":14},"10003529",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":20,"currentStage":21,"position":921,"attributes":922},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[261],{"id":924,"viewCount":58,"searchKey":925,"visible":14},"10003433",{"type":10,"entryId":926,"sortOrder":927,"name":928,"imageUrl":929,"description":930,"currentMorphology":20,"currentStage":184,"position":931,"attributes":932},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[25],{"id":934,"viewCount":58,"searchKey":935,"visible":14},"10003427",{"type":10,"entryId":936,"sortOrder":937,"name":938,"imageUrl":939,"description":940,"currentMorphology":20,"currentStage":21,"position":941,"attributes":942},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[25],{"id":944,"viewCount":58,"searchKey":945,"visible":14},"10003405",{"type":10,"entryId":946,"sortOrder":947,"name":948,"imageUrl":949,"description":950,"currentMorphology":20,"currentStage":184,"position":951,"attributes":952},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[291],[25],{"id":954,"viewCount":58,"searchKey":955,"visible":14},"10003525",{"type":10,"entryId":956,"sortOrder":957,"name":958,"imageUrl":959,"description":960,"currentMorphology":20,"currentStage":182,"position":961,"attributes":962},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[291],[261,25],{"id":964,"viewCount":58,"searchKey":965,"visible":14},"10003399",{"type":10,"entryId":966,"sortOrder":967,"name":968,"imageUrl":969,"description":970,"currentMorphology":20,"currentStage":21,"position":971,"attributes":972},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[291],[261,25],{"id":974,"viewCount":58,"searchKey":975,"visible":14},"10003518",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":20,"currentStage":182,"position":981,"attributes":982},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[291],[25],{"id":984,"viewCount":58,"searchKey":985,"visible":14},"10003393",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":20,"currentStage":21,"position":991,"attributes":992},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[291],[25],{"id":994,"viewCount":58,"searchKey":995,"visible":14},"10003386",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":20,"currentStage":184,"position":1001,"attributes":1002},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[323],[25],{"id":1004,"viewCount":58,"searchKey":1005,"visible":14},"10003447",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":20,"currentStage":21,"position":1011,"attributes":1012},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[323],[25],{"id":1014,"viewCount":58,"searchKey":1015,"visible":14},"10003497",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":20,"currentStage":184,"position":1021,"attributes":1022},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[323],[631],{"id":1024,"viewCount":58,"searchKey":1025,"visible":14},"10003479",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":20,"currentStage":182,"position":1031,"attributes":1032},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[323],[631],{"id":1034,"viewCount":58,"searchKey":1035,"visible":14},"10003388",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":20,"currentStage":21,"position":1041,"attributes":1042},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[323],[631],{"id":1044,"viewCount":58,"searchKey":1045,"visible":14},"10003429",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":20,"currentStage":184,"position":1051,"attributes":1052},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[419],[388],{"id":1054,"viewCount":58,"searchKey":1055,"visible":14},"10003430",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":20,"currentStage":21,"position":1061,"attributes":1062},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[419],[388],{"id":1064,"viewCount":58,"searchKey":1065,"visible":14},"10003549",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":20,"currentStage":234,"position":1071,"attributes":1072},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[419],[631],{"id":1074,"viewCount":58,"searchKey":1075,"visible":14},"10003494",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":20,"currentStage":184,"position":1081,"attributes":1082},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[419],[25,388],{"id":1084,"viewCount":58,"searchKey":1085,"visible":14},"10003486",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":20,"currentStage":21,"position":1091,"attributes":1092},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[419],[25,388],{"id":1094,"viewCount":58,"searchKey":1095,"visible":14},"10003530",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":20,"currentStage":184,"position":1101,"attributes":1102},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[291],[409],{"id":1104,"viewCount":58,"searchKey":1105,"visible":14},"10003457",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":20,"currentStage":21,"position":1111,"attributes":1112},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[291],[409],{"id":1114,"viewCount":58,"searchKey":1115,"visible":14},"10003423",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":20,"currentStage":184,"position":1121,"attributes":1122},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[386],[366,388],{"id":1124,"viewCount":58,"searchKey":1125,"visible":14},"10003419",{"type":10,"entryId":1126,"sortOrder":1127,"name":1128,"imageUrl":1129,"description":1130,"currentMorphology":20,"currentStage":21,"position":1131,"attributes":1132},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[386],[366,388],{"id":1134,"viewCount":58,"searchKey":1135,"visible":14},"10003410",{"type":10,"entryId":1136,"sortOrder":1137,"name":1138,"imageUrl":1139,"description":1140,"currentMorphology":20,"currentStage":184,"position":1141,"attributes":1142},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[388],{"id":1144,"viewCount":58,"searchKey":1145,"visible":14},"10003509",{"type":10,"entryId":1146,"sortOrder":1147,"name":1148,"imageUrl":1149,"description":1150,"currentMorphology":20,"currentStage":21,"position":1151,"attributes":1152},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[388],{"id":1154,"viewCount":58,"searchKey":1155,"visible":14},"10003413",{"type":10,"entryId":1156,"sortOrder":1157,"name":1158,"imageUrl":1159,"description":1160,"currentMorphology":20,"currentStage":184,"position":1161,"attributes":1162},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[409],{"id":1164,"viewCount":58,"searchKey":1165,"visible":14},"10003407",{"type":10,"entryId":1166,"sortOrder":1167,"name":1168,"imageUrl":1169,"description":1170,"currentMorphology":20,"currentStage":21,"position":1171,"attributes":1172},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[409],{"id":1174,"viewCount":58,"searchKey":1175,"visible":14},"10003498",{"type":10,"entryId":1176,"sortOrder":1177,"name":1178,"imageUrl":1179,"description":1180,"currentMorphology":20,"currentStage":234,"position":1181,"attributes":1182},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1183],"attributes-holy",{"id":1185,"viewCount":58,"searchKey":1186,"visible":14},"10003375",{"type":10,"entryId":1187,"sortOrder":1188,"name":1189,"imageUrl":1190,"description":1191,"currentMorphology":20,"currentStage":234,"position":1192,"attributes":1193},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1183],[1195,1203,1208,1213,1218,1223,1228,1232,1236,1240,1245,1250,1255,1260,1265,1270,1275,1280,1283],{"id":1196,"parentId":1197,"tagType":1198,"tagKey":1199,"name":1200,"language":1201,"sort":1202},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1204,"parentId":1197,"tagType":1198,"tagKey":1205,"name":1206,"language":1201,"sort":1207},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1209,"parentId":1197,"tagType":1198,"tagKey":1210,"name":1211,"language":1201,"sort":1212},"450da43bc6001e686491fef2c68f8615","Grassland F