","探查視野","進入特殊的探查視野，可以看到周圍的金屬物品和隱身的伊莫。",{"attributes":146,"type":147,"consume":47,"power":47},[],[],{"id":149,"type":62,"props":150,"children":153},"91268553_24",{"title":151,"type":65,"id":152,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"伊莫特性","91268553_25",[154],{"id":155,"type":139,"props":156,"children":59},"91268553_26",{"id":157,"customKey":47,"icon":158,"iconStyle":65,"iconTitle":47,"descTitle":159,"descContent":160,"source":161},"91268553_27","/cdn/init/1002700_Feature_102101_Icon.png","防破共鳴","自身擊破提升0。",{"attributes":162,"type":163,"consume":47,"power":47},[],[],{"id":165,"type":62,"props":166,"children":59},"91268553_28",{"title":167,"type":65,"id":168,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":169},"技能介紹","91268553_29",[170,221],{"id":171,"title":172,"children":173},"91268553_30","戰鬥技能",[174,188,200,211],{"id":175,"type":139,"props":176},"91268553_31",{"id":177,"customKey":47,"icon":178,"iconStyle":65,"iconTitle":47,"descTitle":179,"descContent":180,"source":181},"91268553_32","/cdn/init/1002700_Skill_11200260_Icon.png","破防猛擊","跳起後猛力砸擊目標，造成傷害，最多連續施放3次。第3次砸擊會暈眩目標1秒。",{"attributes":182,"type":184,"consume":186,"power":187},[183],"12",[185],"1","15","45",{"id":189,"type":139,"props":190},"91268553_33",{"id":191,"customKey":47,"icon":192,"iconStyle":65,"iconTitle":47,"descTitle":193,"descContent":194,"source":195},"91268553_34","/cdn/init/1002700_Skill_11200202_Icon.png","彈射彈弓","原地蓄力將自己發射出去，對命中目標造成傷害，並使目標受到擊破傷害提升15%，持續15秒。如果命中後附近有其他目標，則會向其彈射，最多{4}次。彈射目標可以是隊友。",{"attributes":196,"type":197,"consume":198,"power":199},[183],[185],"20","55",{"id":201,"type":139,"props":202},"91268553_35",{"id":203,"customKey":47,"icon":204,"iconStyle":65,"iconTitle":47,"descTitle":205,"descContent":206,"source":207},"91268553_36","/cdn/init/1002700_Skill_10700350_Icon.png","立體防禦","變成球高高躍起，對落點的目標造成傷害。進入「立體防禦」狀態，自身受傷減免提升20%，受到攻擊時，會對周圍產生震盪波，造成10威力傷害。",{"attributes":208,"type":209,"consume":198,"power":210},[183],[185],"52",{"id":212,"type":139,"props":213},"91268553_37",{"id":214,"customKey":47,"icon":215,"iconStyle":65,"iconTitle":47,"descTitle":216,"descContent":180,"source":217},"91268553_38","/cdn/init/1002700_Skill_10200270_Icon.png","破防冰擊",{"attributes":218,"type":220,"consume":186,"power":187},[219],"2",[185],{"id":222,"title":223,"children":224},"91268553_39","固有技能",[225,237],{"id":226,"type":139,"props":227},"91268553_40",{"id":228,"customKey":47,"icon":229,"iconStyle":65,"iconTitle":47,"descTitle":230,"descContent":231,"source":232},"91268553_41","/cdn/init/1002700_Skill_16800000_Icon.png","攻擊","擊破使用暗元素能力，近距離攻擊目標。",{"attributes":233,"type":234,"consume":235,"power":236},[183],[185],"0","6",{"id":238,"type":139,"props":239},"91268553_42",{"id":240,"customKey":47,"icon":241,"iconStyle":65,"iconTitle":47,"descTitle":242,"descContent":243,"source":244},"91268553_43","/cdn/init/1002700_Skill_11200220_Icon.png","重錘猛擊","雙手巨大化之後，猛力地砸向地面，對周圍造成傷害。",{"attributes":245,"type":246,"consume":235,"power":247},[183],[185],"196",[249,250,251],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":252,"entryId":12,"currentMorphology":253,"visible":15},"10003484","Mountain Woods Form",[255,267,277,287,297,307,317,329,339,349,359,370,380,392,402,413,424,434,444,454,464,474,484,495,505,515,525,535,545,555,565,575,585,595,605,615,625,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,846,856,866,875,883,887,897,907,917,927,937,947,957,967,977,987,997,1007,1017,1027,1037,1047,1057,1067,1077,1087,1097,1107,1117,1127,1137,1147,1157,1167,1177,1188],{"id":256,"viewCount":59,"searchKey":257,"visible":15},"10003442",{"type":10,"entryId":258,"sortOrder":259,"name":260,"imageUrl":261,"description":262,"currentMorphology":21,"currentStage":185,"position":263,"attributes":265},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[264],"position-dps",[266],"attributes-fire",{"id":268,"viewCount":59,"searchKey":269,"visible":15},"10003534",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":21,"currentStage":219,"position":275,"attributes":276},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[264],[266],{"id":278,"viewCount":59,"searchKey":279,"visible":15},"10003435",{"type":10,"entryId":280,"sortOrder":281,"name":282,"imageUrl":283,"description":284,"currentMorphology":21,"currentStage":22,"position":285,"attributes":286},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[264],[266],{"id":288,"viewCount":59,"searchKey":289,"visible":15},"10003428",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":21,"currentStage":22,"position":295,"attributes":296},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[24],[266,26],{"id":298,"viewCount":59,"searchKey":299,"visible":15},"10003578",{"type":10,"entryId":300,"sortOrder":301,"name":302,"imageUrl":303,"description":304,"currentMorphology":21,"currentStage":185,"position":305,"attributes":306},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[264],[26],{"id":308,"viewCount":59,"searchKey":309,"visible":15},"10003417",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":21,"currentStage":22,"position":315,"attributes":316},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[264],[26],{"id":318,"viewCount":59,"searchKey":319,"visible":15},"10003488",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":21,"currentStage":185,"position":325,"attributes":327},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[326],"position-sup",[328],"attributes-wind",{"id":330,"viewCount":59,"searchKey":331,"visible":15},"10003548",{"type":10,"entryId":332,"sortOrder":333,"name":334,"imageUrl":335,"description":336,"currentMorphology":21,"currentStage":22,"position":337,"attributes":338},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[326],[328],{"id":340,"viewCount":59,"searchKey":341,"visible":15},"10003474",{"type":10,"entryId":342,"sortOrder":343,"name":344,"imageUrl":345,"description":346,"currentMorphology":21,"currentStage":22,"position":347,"attributes":348},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[264],[328],{"id":350,"viewCount":59,"searchKey":351,"visible":15},"10003467",{"type":10,"entryId":352,"sortOrder":353,"name":354,"imageUrl":355,"description":356,"currentMorphology":21,"currentStage":22,"position":357,"attributes":358},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[24],[328],{"id":360,"viewCount":59,"searchKey":361,"visible":15},"10003392",{"type":10,"entryId":362,"sortOrder":363,"name":364,"imageUrl":365,"description":366,"currentMorphology":21,"currentStage":185,"position":367,"attributes":368},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[264],[369],"attributes-grass",{"id":371,"viewCount":59,"searchKey":372,"visible":15},"10003510",{"type":10,"entryId":373,"sortOrder":374,"name":375,"imageUrl":376,"description":377,"currentMorphology":21,"currentStage":22,"position":378,"attributes":379},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[264],[369],{"id":381,"viewCount":59,"searchKey":382,"visible":15},"10003477",{"type":10,"entryId":383,"sortOrder":384,"name":385,"imageUrl":386,"description":387,"currentMorphology":21,"currentStage":185,"position":388,"attributes":390},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[389],"position-heal",[391],"attributes-water",{"id":393,"viewCount":59,"searchKey":394,"visible":15},"10003569",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":21,"currentStage":219,"position":400,"attributes":401},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[389],[391],{"id":403,"viewCount":59,"searchKey":404,"visible":15},"10003470",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":21,"currentStage":22,"position":410,"attributes":411},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[389],[391,412],"attributes-ice",{"id":414,"viewCount":59,"searchKey":415,"visible":15},"10003463",{"type":10,"entryId":416,"sortOrder":417,"name":418,"imageUrl":419,"description":420,"currentMorphology":21,"currentStage":22,"position":421,"attributes":423},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[422],"position-energy",[369,391],{"id":425,"viewCount":59,"searchKey":426,"visible":15},"10003468",{"type":10,"entryId":427,"sortOrder":428,"name":429,"imageUrl":430,"description":431,"currentMorphology":21,"currentStage":185,"position":432,"attributes":433},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[326],[328],{"id":435,"viewCount":59,"searchKey":436,"visible":15},"10003365",{"type":10,"entryId":437,"sortOrder":438,"name":439,"imageUrl":440,"description":441,"currentMorphology":21,"currentStage":22,"position":442,"attributes":443},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[326],[328],{"id":445,"viewCount":59,"searchKey":446,"visible":15},"10003461",{"type":10,"entryId":447,"sortOrder":448,"name":449,"imageUrl":450,"description":451,"currentMorphology":21,"currentStage":22,"position":452,"attributes":453},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[326],[26],{"id":455,"viewCount":59,"searchKey":456,"visible":15},"10003421",{"type":10,"entryId":457,"sortOrder":458,"name":459,"imageUrl":460,"description":461,"currentMorphology":21,"currentStage":185,"position":462,"attributes":463},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[24],[369],{"id":465,"viewCount":59,"searchKey":466,"visible":15},"10003414",{"type":10,"entryId":467,"sortOrder":468,"name":469,"imageUrl":470,"description":471,"currentMorphology":21,"currentStage":22,"position":472,"attributes":473},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[422],[26,369],{"id":475,"viewCount":59,"searchKey":476,"visible":15},"10003404",{"type":10,"entryId":477,"sortOrder":478,"name":479,"imageUrl":480,"description":481,"currentMorphology":21,"currentStage":22,"position":482,"attributes":483},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[24],[369],{"id":485,"viewCount":59,"searchKey":486,"visible":15},"10003567",{"type":10,"entryId":487,"sortOrder":488,"name":489,"imageUrl":490,"description":491,"currentMorphology":21,"currentStage":185,"position":492,"attributes":493},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[24],[494,369],"attributes-rock",{"id":496,"viewCount":59,"searchKey":497,"visible":15},"10003462",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":21,"currentStage":22,"position":503,"attributes":504},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[24],[494,369],{"id":506,"viewCount":59,"searchKey":507,"visible":15},"10003551",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":21,"currentStage":22,"position":513,"attributes":514},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[24],[412],{"id":516,"viewCount":59,"searchKey":517,"visible":15},"10003409",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":21,"currentStage":185,"position":523,"attributes":524},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[422],[266],{"id":526,"viewCount":59,"searchKey":527,"visible":15},"10003507",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":21,"currentStage":22,"position":533,"attributes":534},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[422],[266],{"id":536,"viewCount":59,"searchKey":537,"visible":15},"10003542",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":21,"currentStage":185,"position":543,"attributes":544},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[389],[328],{"id":546,"viewCount":59,"searchKey":547,"visible":15},"10003440",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":21,"currentStage":22,"position":553,"attributes":554},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[389],[328],{"id":556,"viewCount":59,"searchKey":557,"visible":15},"10003563",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":21,"currentStage":235,"position":563,"attributes":564},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[422],[328,369],{"id":566,"viewCount":59,"searchKey":567,"visible":15},"10003368",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":21,"currentStage":185,"position":573,"attributes":574},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[326],[328],{"id":576,"viewCount":59,"searchKey":577,"visible":15},"10003363",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":21,"currentStage":22,"position":583,"attributes":584},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[326],[328],{"id":586,"viewCount":59,"searchKey":587,"visible":15},"10003515",{"type":10,"entryId":588,"sortOrder":589,"name":590,"imageUrl":591,"description":592,"currentMorphology":21,"currentStage":185,"position":593,"attributes":594},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[264],[369],{"id":596,"viewCount":59,"searchKey":597,"visible":15},"10003496",{"type":10,"entryId":598,"sortOrder":599,"name":600,"imageUrl":601,"description":602,"currentMorphology":21,"currentStage":22,"position":603,"attributes":604},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[264],[369],{"id":606,"viewCount":59,"searchKey":607,"visible":15},"10003378",{"type":10,"entryId":608,"sortOrder":609,"name":610,"imageUrl":611,"description":612,"currentMorphology":21,"currentStage":22,"position":613,"attributes":614},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[326],[369],{"id":616,"viewCount":59,"searchKey":617,"visible":15},"10003456",{"type":10,"entryId":618,"sortOrder":619,"name":620,"imageUrl":621,"description":622,"currentMorphology":21,"currentStage":185,"position":623,"attributes":624},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[24],[369],{"id":626,"viewCount":59,"searchKey":627,"visible":15},"10003374",{"type":10,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":21,"currentStage":22,"position":633,"attributes":634},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[326],[635],"attributes-electric",{"id":637,"viewCount":59,"searchKey":638,"visible":15},"10003443",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":21,"currentStage":22,"position":644,"attributes":645},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[24],[369],{"id":647,"viewCount":59,"searchKey":648,"visible":15},"10003503",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":21,"currentStage":185,"position":654,"attributes":655},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[326],[26],{"id":657,"viewCount":59,"searchKey":658,"visible":15},"10003521",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":21,"currentStage":22,"position":664,"attributes":665},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[326],[26],{"id":667,"viewCount":59,"searchKey":668,"visible":15},"10003508",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":21,"currentStage":185,"position":674,"attributes":675},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[264],[26],{"id":677,"viewCount":59,"searchKey":678,"visible":15},"10003369",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":21,"currentStage":22,"position":684,"attributes":685},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[264],[26],{"id":687,"viewCount":59,"searchKey":688,"visible":15},"10003501",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":21,"currentStage":22,"position":694,"attributes":695},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[264],[635],{"id":697,"viewCount":59,"searchKey":698,"visible":15},"10003422",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":21,"currentStage":185,"position":704,"attributes":705},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[264],[412],{"id":707,"viewCount":59,"searchKey":708,"visible":15},"10003575",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":21,"currentStage":219,"position":714,"attributes":715},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[264],[412],{"id":717,"viewCount":59,"searchKey":718,"visible":15},"10003415",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":21,"currentStage":22,"position":724,"attributes":725},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[264],[412],{"id":727,"viewCount":59,"searchKey":728,"visible":15},"10003524",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":21,"currentStage":185,"position":734,"attributes":735},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[24],[635],{"id":737,"viewCount":59,"searchKey":738,"visible":15},"10003475",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":21,"currentStage":22,"position":744,"attributes":745},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[24],[635],{"id":747,"viewCount":59,"searchKey":748,"visible":15},"10003523",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":21,"currentStage":185,"position":754,"attributes":755},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[24],[391],{"id":757,"viewCount":59,"searchKey":758,"visible":15},"10003398",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":21,"currentStage":219,"position":764,"attributes":765},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[24],[391],{"id":767,"viewCount":59,"searchKey":768,"visible":15},"10003516",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":21,"currentStage":22,"position":774,"attributes":775},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[326],[391],{"id":777,"viewCount":59,"searchKey":778,"visible":15},"10003566",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":21,"currentStage":22,"position":784,"attributes":785},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[24],[391],{"id":787,"viewCount":59,"searchKey":788,"visible":15},"10003453",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":21,"currentStage":185,"position":794,"attributes":795},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[264],[391],{"id":797,"viewCount":59,"searchKey":798,"visible":15},"10003577",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":21,"currentStage":219,"position":804,"attributes":805},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[264],[391],{"id":807,"viewCount":59,"searchKey":808,"visible":15},"10003570",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":21,"currentStage":22,"position":814,"attributes":815},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[264],[391],{"id":817,"viewCount":59,"searchKey":818,"visible":15},"10003565",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":21,"currentStage":185,"position":824,"attributes":825},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[264],[494],{"id":827,"viewCount":59,"searchKey":828,"visible":15},"10003476",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":21,"currentStage":22,"position":834,"attributes":835},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[264],[494],{"id":837,"viewCount":59,"searchKey":838,"visible":15},"10003466",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":21,"currentStage":22,"position":844,"attributes":845},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[326],[494],{"id":847,"viewCount":59,"searchKey":848,"visible":15},"10003379",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":21,"currentStage":185,"position":854,"attributes":855},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[264],[635],{"id":857,"viewCount":59,"searchKey":858,"visible":15},"10003376",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":21,"currentStage":22,"position":864,"attributes":865},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[264],[635],{"id":867,"viewCount":59,"searchKey":868,"visible":15},"10003543",{"type":10,"entryId":869,"sortOrder":870,"name":75,"imageUrl":871,"description":872,"currentMorphology":21,"currentStage":185,"position":873,"attributes":874},"062",1002100,"/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[24],[26],{"id":876,"viewCount":59,"searchKey":877,"visible":15},"10003557",{"type":10,"entryId":8,"sortOrder":878,"name":83,"imageUrl":879,"description":880,"currentMorphology":21,"currentStage":22,"position":881,"attributes":882},1002600,"/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[264],[26],{"id":4,"viewCount":59,"searchKey":884,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":885,"attributes":886},[24],[26],{"id":888,"viewCount":59,"searchKey":889,"visible":15},"10003579",{"type":10,"entryId":890,"sortOrder":891,"name":892,"imageUrl":893,"description":894,"currentMorphology":21,"currentStage":185,"position":895,"attributes":896},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[24],[328],{"id":898,"viewCount":59,"searchKey":899,"visible":15},"10003389",{"type":10,"entryId":900,"sortOrder":901,"name":902,"imageUrl":903,"description":904,"currentMorphology":21,"currentStage":219,"position":905,"attributes":906},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[24],[328],{"id":908,"viewCount":59,"searchKey":909,"visible":15},"10003536",{"type":10,"entryId":910,"sortOrder":911,"name":912,"imageUrl":913,"description":914,"currentMorphology":21,"currentStage":22,"position":915,"attributes":916},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[24],[328],{"id":918,"viewCount":59,"searchKey":919,"visible":15},"10003529",{"type":10,"entryId":920,"sortOrder":921,"name":922,"imageUrl":923,"description":924,"currentMorphology":21,"currentStage":22,"position":925,"attributes":926},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[264],[266],{"id":928,"viewCount":59,"searchKey":929,"visible":15},"10003433",{"type":10,"entryId":930,"sortOrder":931,"name":932,"imageUrl":933,"description":934,"currentMorphology":21,"currentStage":185,"position":935,"attributes":936},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[264],[494],{"id":938,"viewCount":59,"searchKey":939,"visible":15},"10003427",{"type":10,"entryId":940,"sortOrder":941,"name":942,"imageUrl":943,"description":944,"currentMorphology":21,"currentStage":22,"position":945,"attributes":946},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[264],[494],{"id":948,"viewCount":59,"searchKey":949,"visible":15},"10003405",{"type":10,"entryId":950,"sortOrder":951,"name":952,"imageUrl":953,"description":954,"currentMorphology":21,"currentStage":185,"position":955,"attributes":956},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[24],[494],{"id":958,"viewCount":59,"searchKey":959,"visible":15},"10003525",{"type":10,"entryId":960,"sortOrder":961,"name":962,"imageUrl":963,"description":964,"currentMorphology":21,"currentStage":219,"position":965,"attributes":966},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[24],[266,494],{"id":968,"viewCount":59,"searchKey":969,"visible":15},"10003399",{"type":10,"entryId":970,"sortOrder":971,"name":972,"imageUrl":973,"description":974,"currentMorphology":21,"currentStage":22,"position":975,"attributes":976},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[24],[266,494],{"id":978,"viewCount":59,"searchKey":979,"visible":15},"10003518",{"type":10,"entryId":980,"sortOrder":981,"name":982,"imageUrl":983,"description":984,"currentMorphology":21,"currentStage":219,"position":985,"attributes":986},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[24],[494],{"id":988,"viewCount":59,"searchKey":989,"visible":15},"10003393",{"type":10,"entryId":990,"sortOrder":991,"name":992,"imageUrl":993,"description":994,"currentMorphology":21,"currentStage":22,"position":995,"attributes":996},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[24],[494],{"id":998,"viewCount":59,"searchKey":999,"visible":15},"10003386",{"type":10,"entryId":1000,"sortOrder":1001,"name":1002,"imageUrl":1003,"description":1004,"currentMorphology":21,"currentStage":185,"position":1005,"attributes":1006},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[326],[494],{"id":1008,"viewCount":59,"searchKey":1009,"visible":15},"10003447",{"type":10,"entryId":1010,"sortOrder":1011,"name":1012,"imageUrl":1013,"description":1014,"currentMorphology":21,"currentStage":22,"position":1015,"attributes":1016},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[326],[494],{"id":1018,"viewCount":59,"searchKey":1019,"visible":15},"10003497",{"type":10,"entryId":1020,"sortOrder":1021,"name":1022,"imageUrl":1023,"description":1024,"currentMorphology":21,"currentStage":185,"position":1025,"attributes":1026},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[326],[635],{"id":1028,"viewCount":59,"searchKey":1029,"visible":15},"10003479",{"type":10,"entryId":1030,"sortOrder":1031,"name":1032,"imageUrl":1033,"description":1034,"currentMorphology":21,"currentStage":219,"position":1035,"attributes":1036},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[326],[635],{"id":1038,"viewCount":59,"searchKey":1039,"visible":15},"10003388",{"type":10,"entryId":1040,"sortOrder":1041,"name":1042,"imageUrl":1043,"description":1044,"currentMorphology":21,"currentStage":22,"position":1045,"attributes":1046},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[326],[635],{"id":1048,"viewCount":59,"searchKey":1049,"visible":15},"10003429",{"type":10,"entryId":1050,"sortOrder":1051,"name":1052,"imageUrl":1053,"description":1054,"currentMorphology":21,"currentStage":185,"position":1055,"attributes":1056},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[422],[391],{"id":1058,"viewCount":59,"searchKey":1059,"visible":15},"10003430",{"type":10,"entryId":1060,"sortOrder":1061,"name":1062,"imageUrl":1063,"description":1064,"currentMorphology":21,"currentStage":22,"position":1065,"attributes":1066},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[422],[391],{"id":1068,"viewCount":59,"searchKey":1069,"visible":15},"10003549",{"type":10,"entryId":1070,"sortOrder":1071,"name":1072,"imageUrl":1073,"description":1074,"currentMorphology":21,"currentStage":235,"position":1075,"attributes":1076},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[422],[635],{"id":1078,"viewCount":59,"searchKey":1079,"visible":15},"10003494",{"type":10,"entryId":1080,"sortOrder":1081,"name":1082,"imageUrl":1083,"description":1084,"currentMorphology":21,"currentStage":185,"position":1085,"attributes":1086},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[422],[494,391],{"id":1088,"viewCount":59,"searchKey":1089,"visible":15},"10003486",{"type":10,"entryId":1090,"sortOrder":1091,"name":1092,"imageUrl":1093,"description":1094,"currentMorphology":21,"currentStage":22,"position":1095,"attributes":1096},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[422],[494,391],{"id":1098,"viewCount":59,"searchKey":1099,"visible":15},"10003530",{"type":10,"entryId":1100,"sortOrder":1101,"name":1102,"imageUrl":1103,"description":1104,"currentMorphology":21,"currentStage":185,"position":1105,"attributes":1106},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[24],[412],{"id":1108,"viewCount":59,"searchKey":1109,"visible":15},"10003457",{"type":10,"entryId":1110,"sortOrder":1111,"name":1112,"imageUrl":1113,"description":1114,"currentMorphology":21,"currentStage":22,"position":1115,"attributes":1116},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[24],[412],{"id":1118,"viewCount":59,"searchKey":1119,"visible":15},"10003423",{"type":10,"entryId":1120,"sortOrder":1121,"name":1122,"imageUrl":1123,"description":1124,"currentMorphology":21,"currentStage":185,"position":1125,"attributes":1126},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[389],[369,391],{"id":1128,"viewCount":59,"searchKey":1129,"visible":15},"10003419",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":21,"currentStage":22,"position":1135,"attributes":1136},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[389],[369,391],{"id":1138,"viewCount":59,"searchKey":1139,"visible":15},"10003410",{"type":10,"entryId":1140,"sortOrder":1141,"name":1142,"imageUrl":1143,"description":1144,"currentMorphology":21,"currentStage":185,"position":1145,"attributes":1146},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[264],[391],{"id":1148,"viewCount":59,"searchKey":1149,"visible":15},"10003509",{"type":10,"entryId":1150,"sortOrder":1151,"name":1152,"imageUrl":1153,"description":1154,"currentMorphology":21,"currentStage":22,"position":1155,"attributes":1156},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[264],[391],{"id":1158,"viewCount":59,"searchKey":1159,"visible":15},"10003413",{"type":10,"entryId":1160,"sortOrder":1161,"name":1162,"imageUrl":1163,"description":1164,"currentMorphology":21,"currentStage":185,"position":1165,"attributes":1166},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[264],[412],{"id":1168,"viewCount":59,"searchKey":1169,"visible":15},"10003407",{"type":10,"entryId":1170,"sortOrder":1171,"name":1172,"imageUrl":1173,"description":1174,"currentMorphology":21,"currentStage":22,"position":1175,"attributes":1176},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[264],[412],{"id":1178,"viewCount":59,"searchKey":1179,"visible":15},"10003498",{"type":10,"entryId":1180,"sortOrder":1181,"name":1182,"imageUrl":1183,"description":1184,"currentMorphology":21,"currentStage":235,"position":1185,"attributes":1186},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[264],[1187],"attributes-holy",{"id":1189,"viewCount":59,"searchKey":1190,"visible":15},"10003375",{"type":10,"entryId":1191,"sortOrder":1192,"name":1193,"imageUrl":1194,"description":1195,"currentMorphology":21,"currentStage":235,"position":1196,"attributes":1197},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[264],[1187],[1199,1206,1211,1216,1221,1226,1231,1235,1239,1243,1248,1253,1257,1262,1267,1272,1277,1282,1285],{"id":1200,"parentId":1201,"tagType":1202,"tagKey":253,"name":1203,"language":1204,"sort":1205},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","山林型態","zh-TW",6,{"id":1207,"parentId":1201,"tagType":1202,"tagKey":1208,"name":1209,"language":1204,"sort":1210},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1212,"parentId":1201,"tagType"