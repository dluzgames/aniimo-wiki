tion":37,"stageStrength":28,"condition":74,"children":76},"root","/cdn/init/Wiki_PetHead_10501.png",{"isVariant":65,"list":75},[],[77],{"id":78,"name":79,"label":79,"icon":80,"stage":81,"position":28,"stageStrength":81,"condition":82,"children":84},"91268463_6","暴睡熊","/cdn/init/Wiki_PetHead_10503.png",3,{"isVariant":65,"list":83},[],[],"91268463_5",{"id":87,"type":60,"props":88,"children":92},"91268463_7",{"title":89,"type":90,"id":91,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"出現地區","small","91268463_8",[93],{"id":94,"type":95,"props":96,"children":57},"91268463_9","capsule",{"id":97,"customKey":46,"title":98,"icon":46,"bgColor":99,"fontColor":100,"type":101},"91268463_10","玫瑰塔林","#dee2ec","#60606e","normal",{"id":103,"type":60,"props":104,"children":107},"91268463_11",{"title":105,"type":90,"id":106,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"家園能力","91268463_12",[108,114],{"id":109,"type":95,"props":110,"children":57},"91268463_13",{"id":111,"customKey":112,"title":21,"icon":46,"bgColor":46,"fontColor":46,"type":113},"91268463_14","home-1100","spritePic",{"id":115,"type":95,"props":116,"children":57},"91268463_15",{"id":117,"customKey":118,"title":21,"icon":46,"bgColor":46,"fontColor":46,"type":113},"91268463_16","home-1003",{"id":120,"title":121,"components":122},2,"伊莫能力",[123,140,156],{"id":124,"type":60,"props":125,"children":128},"91268463_19",{"title":126,"type":90,"id":127,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"探索技能","91268463_20",[129],{"id":130,"type":131,"props":132,"children":57},"91268463_21","circle",{"id":133,"customKey":46,"icon":134,"iconStyle":90,"iconTitle":46,"descTitle":135,"descContent":136,"source":137},"91268463_22","/cdn/init/1050100_Skill_9400137_Icon.png","頭錘","用頭撞擊，造成衝擊",{"attributes":138,"type":139,"consume":46,"power":46},[],[],{"id":141,"type":60,"props":142,"children":145},"91268463_23",{"title":143,"type":63,"id":144,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"伊莫特性","91268463_24",[146],{"id":147,"type":131,"props":148,"children":57},"91268463_25",{"id":149,"customKey":46,"icon":150,"iconStyle":63,"iconTitle":46,"descTitle":151,"descContent":152,"source":153},"91268463_26","/cdn/init/1050100_Feature_150102_Icon.png","怒氣狂暴","戰鬥中持續累積「怒氣值」，普攻獲得2點，每10點技能能量消耗獲得10點，受到攻擊時獲得2點，擁有100點「怒氣值」時進入「狂暴」狀態。「狂暴」狀態下自身攻擊速度和技能傷害提升30%，能量回復速度速度提升25%，期間無法累積「怒氣值」，持續20秒。",{"attributes":154,"type":155,"consume":46,"power":46},[],[],{"id":157,"type":60,"props":158,"children":57},"91268463_27",{"title":159,"type":63,"id":160,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":65,"tabs":161},"技能介紹","91268463_28",[162,191],{"id":163,"title":164,"children":165},"91268463_29","戰鬥技能",[166,179],{"id":167,"type":131,"props":168},"91268463_30",{"id":169,"customKey":46,"icon":170,"iconStyle":63,"iconTitle":46,"descTitle":171,"descContent":172,"source":173},"91268463_31","/cdn/init/1050100_Skill_10800340_Icon.png","瘋狂爪擊","對目標進行爪擊攻擊，最多連續施放4次，第四段命中目標後，下一次技能獲得的「怒氣值」翻倍。「狂暴狀態」下，每次分別對目標施加2/2/2/6層「爪印」效果，最多疊加12層。",{"attributes":174,"type":176,"consume":177,"power":178},[175],"8",[21],"10","40",{"id":180,"type":131,"props":181},"91268463_32",{"id":182,"customKey":46,"icon":183,"iconStyle":63,"iconTitle":46,"descTitle":184,"descContent":185,"source":186},"91268463_33","/cdn/init/1050100_Skill_10800350_Icon.png","大地震撼","踩踏地面震擊前方目標造成傷害，同時清除目標所有「爪印」效果，每層「爪印」可以額外造成5%威力的傷害，並造成1.5秒暈眩。",{"attributes":187,"type":188,"consume":189,"power":190},[175],[21],"20","53",{"id":192,"title":193,"children":194},"91268463_34","固有技能",[195],{"id":196,"type":131,"props":197},"91268463_35",{"id":198,"customKey":46,"icon":199,"iconStyle":63,"iconTitle":46,"descTitle":200,"descContent":201,"source":202},"91268463_36","/cdn/init/1050100_Skill_10800000_Icon.png","攻擊","使用土元素能力，近距離攻擊目標。",{"attributes":203,"type":204,"consume":205,"power":206},[175],[21],"0","6",[208],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[210,221,232,243,255,265,275,287,297,307,317,328,338,350,360,371,382,392,402,412,422,432,442,452,462,472,482,492,502,512,522,532,542,552,562,572,582,593,603,613,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,891,895,902,912,922,932,942,952,962,972,982,992,1002,1012,1022,1032,1042,1052,1062,1072,1082,1092,1102,1112,1122,1132,1143],{"id":211,"viewCount":57,"searchKey":212,"visible":14},"10003442",{"type":10,"entryId":213,"sortOrder":214,"name":215,"imageUrl":216,"description":217,"currentMorphology":9,"currentStage":21,"position":218,"attributes":219},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[220],"attributes-fire",{"id":222,"viewCount":57,"searchKey":223,"visible":14},"10003534",{"type":10,"entryId":224,"sortOrder":225,"name":226,"imageUrl":227,"description":228,"currentMorphology":9,"currentStage":229,"position":230,"attributes":231},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[23],[220],{"id":233,"viewCount":57,"searchKey":234,"visible":14},"10003435",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":9,"currentStage":240,"position":241,"attributes":242},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[23],[220],{"id":244,"viewCount":57,"searchKey":245,"visible":14},"10003428",{"type":10,"entryId":246,"sortOrder":247,"name":248,"imageUrl":249,"description":250,"currentMorphology":9,"currentStage":240,"position":251,"attributes":253},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[252],"position-break",[220,254],"attributes-dark",{"id":256,"viewCount":57,"searchKey":257,"visible":14},"10003578",{"type":10,"entryId":258,"sortOrder":259,"name":260,"imageUrl":261,"description":262,"currentMorphology":9,"currentStage":21,"position":263,"attributes":264},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[254],{"id":266,"viewCount":57,"searchKey":267,"visible":14},"10003417",{"type":10,"entryId":268,"sortOrder":269,"name":270,"imageUrl":271,"description":272,"currentMorphology":9,"currentStage":240,"position":273,"attributes":274},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[254],{"id":276,"viewCount":57,"searchKey":277,"visible":14},"10003488",{"type":10,"entryId":278,"sortOrder":279,"name":280,"imageUrl":281,"description":282,"currentMorphology":9,"currentStage":21,"position":283,"attributes":285},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[284],"position-sup",[286],"attributes-wind",{"id":288,"viewCount":57,"searchKey":289,"visible":14},"10003548",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":9,"currentStage":240,"position":295,"attributes":296},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[284],[286],{"id":298,"viewCount":57,"searchKey":299,"visible":14},"10003474",{"type":10,"entryId":300,"sortOrder":301,"name":302,"imageUrl":303,"description":304,"currentMorphology":9,"currentStage":240,"position":305,"attributes":306},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[286],{"id":308,"viewCount":57,"searchKey":309,"visible":14},"10003467",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":9,"currentStage":240,"position":315,"attributes":316},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[252],[286],{"id":318,"viewCount":57,"searchKey":319,"visible":14},"10003392",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":21,"position":325,"attributes":326},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[327],"attributes-grass",{"id":329,"viewCount":57,"searchKey":330,"visible":14},"10003510",{"type":10,"entryId":331,"sortOrder":332,"name":333,"imageUrl":334,"description":335,"currentMorphology":9,"currentStage":240,"position":336,"attributes":337},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[327],{"id":339,"viewCount":57,"searchKey":340,"visible":14},"10003477",{"type":10,"entryId":341,"sortOrder":342,"name":343,"imageUrl":344,"description":345,"currentMorphology":9,"currentStage":21,"position":346,"attributes":348},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[347],"position-heal",[349],"attributes-water",{"id":351,"viewCount":57,"searchKey":352,"visible":14},"10003569",{"type":10,"entryId":353,"sortOrder":354,"name":355,"imageUrl":356,"description":357,"currentMorphology":9,"currentStage":229,"position":358,"attributes":359},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[347],[349],{"id":361,"viewCount":57,"searchKey":362,"visible":14},"10003470",{"type":10,"entryId":363,"sortOrder":364,"name":365,"imageUrl":366,"description":367,"currentMorphology":9,"currentStage":240,"position":368,"attributes":369},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[347],[349,370],"attributes-ice",{"id":372,"viewCount":57,"searchKey":373,"visible":14},"10003463",{"type":10,"entryId":374,"sortOrder":375,"name":376,"imageUrl":377,"description":378,"currentMorphology":9,"currentStage":240,"position":379,"attributes":381},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[380],"position-energy",[327,349],{"id":383,"viewCount":57,"searchKey":384,"visible":14},"10003468",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":9,"currentStage":21,"position":390,"attributes":391},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[284],[286],{"id":393,"viewCount":57,"searchKey":394,"visible":14},"10003365",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":9,"currentStage":240,"position":400,"attributes":401},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[284],[286],{"id":403,"viewCount":57,"searchKey":404,"visible":14},"10003461",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":9,"currentStage":240,"position":410,"attributes":411},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[284],[254],{"id":413,"viewCount":57,"searchKey":414,"visible":14},"10003421",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":9,"currentStage":21,"position":420,"attributes":421},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[252],[327],{"id":423,"viewCount":57,"searchKey":424,"visible":14},"10003414",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":9,"currentStage":240,"position":430,"attributes":431},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[380],[254,327],{"id":433,"viewCount":57,"searchKey":434,"visible":14},"10003404",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":9,"currentStage":240,"position":440,"attributes":441},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[252],[327],{"id":443,"viewCount":57,"searchKey":444,"visible":14},"10003567",{"type":10,"entryId":445,"sortOrder":446,"name":447,"imageUrl":448,"description":449,"currentMorphology":9,"currentStage":21,"position":450,"attributes":451},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[252],[25,327],{"id":453,"viewCount":57,"searchKey":454,"visible":14},"10003462",{"type":10,"entryId":455,"sortOrder":456,"name":457,"imageUrl":458,"description":459,"currentMorphology":9,"currentStage":240,"position":460,"attributes":461},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[252],[25,327],{"id":463,"viewCount":57,"searchKey":464,"visible":14},"10003551",{"type":10,"entryId":465,"sortOrder":466,"name":467,"imageUrl":468,"description":469,"currentMorphology":9,"currentStage":240,"position":470,"attributes":471},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[252],[370],{"id":473,"viewCount":57,"searchKey":474,"visible":14},"10003409",{"type":10,"entryId":475,"sortOrder":476,"name":477,"imageUrl":478,"description":479,"currentMorphology":9,"currentStage":21,"position":480,"attributes":481},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[380],[220],{"id":483,"viewCount":57,"searchKey":484,"visible":14},"10003507",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":9,"currentStage":240,"position":490,"attributes":491},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[380],[220],{"id":493,"viewCount":57,"searchKey":494,"visible":14},"10003542",{"type":10,"entryId":495,"sortOrder":496,"name":497,"imageUrl":498,"description":499,"currentMorphology":9,"currentStage":21,"position":500,"attributes":501},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[347],[286],{"id":503,"viewCount":57,"searchKey":504,"visible":14},"10003440",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":9,"currentStage":240,"position":510,"attributes":511},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[347],[286],{"id":513,"viewCount":57,"searchKey":514,"visible":14},"10003563",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":9,"currentStage":205,"position":520,"attributes":521},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[380],[286,327],{"id":523,"viewCount":57,"searchKey":524,"visible":14},"10003368",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":9,"currentStage":21,"position":530,"attributes":531},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[284],[286],{"id":533,"viewCount":57,"searchKey":534,"visible":14},"10003363",{"type":10,"entryId":535,"sortOrder":536,"name":537,"imageUrl":538,"description":539,"currentMorphology":9,"currentStage":240,"position":540,"attributes":541},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[284],[286],{"id":543,"viewCount":57,"searchKey":544,"visible":14},"10003515",{"type":10,"entryId":545,"sortOrder":546,"name":547,"imageUrl":548,"description":549,"currentMorphology":9,"currentStage":21,"position":550,"attributes":551},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[327],{"id":553,"viewCount":57,"searchKey":554,"visible":14},"10003496",{"type":10,"entryId":555,"sortOrder":556,"name":557,"imageUrl":558,"description":559,"currentMorphology":9,"currentStage":240,"position":560,"attributes":561},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[327],{"id":563,"viewCount":57,"searchKey":564,"visible":14},"10003378",{"type":10,"entryId":565,"sortOrder":566,"name":567,"imageUrl":568,"description":569,"currentMorphology":9,"currentStage":240,"position":570,"attributes":571},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[284],[327],{"id":573,"viewCount":57,"searchKey":574,"visible":14},"10003456",{"type":10,"entryId":575,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":9,"currentStage":21,"position":580,"attributes":581},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[252],[327],{"id":583,"viewCount":57,"searchKey":584,"visible":14},"10003374",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":9,"currentStage":240,"position":590,"attributes":591},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[284],[592],"attributes-electric",{"id":594,"viewCount":57,"searchKey":595,"visible":14},"10003443",{"type":10,"entryId":596,"sortOrder":597,"name":598,"imageUrl":599,"description":600,"currentMorphology":9,"currentStage":240,"position":601,"attributes":602},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[252],[327],{"id":604,"viewCount":57,"searchKey":605,"visible":14},"10003503",{"type":10,"entryId":606,"sortOrder":607,"name":608,"imageUrl":609,"description":610,"currentMorphology":9,"currentStage":21,"position":611,"attributes":612},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[284],[254],{"id":614,"viewCount":57,"searchKey":615,"visible":14},"10003521",{"type":10,"entryId":616,"sortOrder":617,"name":618,"imageUrl":619,"description":620,"currentMorphology":9,"currentStage":240,"position":621,"attributes":622},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[284],[254],{"id":624,"viewCount":57,"searchKey":625,"visible":14},"10003508",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":9,"currentStage":21,"position":631,"attributes":632},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[254],{"id":634,"viewCount":57,"searchKey":635,"visible":14},"10003369",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":9,"currentStage":240,"position":641,"attributes":642},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[254],{"id":644,"viewCount":57,"searchKey":645,"visible":14},"10003501",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":9,"currentStage":240,"position":651,"attributes":652},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[592],{"id":654,"viewCount":57,"searchKey":655,"visible":14},"10003422",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":9,"currentStage":21,"position":661,"attributes":662},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[370],{"id":664,"viewCount":57,"searchKey":665,"visible":14},"10003575",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":9,"currentStage":229,"position":671,"attributes":672},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[370],{"id":674,"viewCount":57,"searchKey":675,"visible":14},"10003415",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":9,"currentStage":240,"position":681,"attributes":682},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[370],{"id":684,"viewCount":57,"searchKey":685,"visible":14},"10003524",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":9,"currentStage":21,"position":691,"attributes":692},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[252],[592],{"id":694,"viewCount":57,"searchKey":695,"visible":14},"10003475",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":9,"currentStage":240,"position":701,"attributes":702},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[252],[592],{"id":704,"viewCount":57,"searchKey":705,"visible":14},"10003523",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":9,"currentStage":21,"position":711,"attributes":712},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[252],[349],{"id":714,"viewCount":57,"searchKey":715,"visible":14},"10003398",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":9,"currentStage":229,"position":721,"attributes":722},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[252],[349],{"id":724,"viewCount":57,"searchKey":725,"visible":14},"10003516",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":9,"currentStage":240,"position":731,"attributes":732},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[284],[349],{"id":734,"viewCount":57,"searchKey":735,"visible":14},"10003566",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":9,"currentStage":240,"position":741,"attributes":742},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[252],[349],{"id":744,"viewCount":57,"searchKey":745,"visible":14},"10003453",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":9,"currentStage":21,"position":751,"attributes":752},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[349],{"id":754,"viewCount":57,"searchKey":755,"visible":14},"10003577",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":9,"currentStage":229,"position":761,"attributes":762},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[349],{"id":764,"viewCount":57,"searchKey":765,"visible":14},"10003570",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":9,"currentStage":240,"position":771,"attributes":772},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[349],{"id":774,"viewCount":57,"searchKey":775,"visible":14},"10003565",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":9,"currentStage":21,"position":781,"attributes":782},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[25],{"id":784,"viewCount":57,"searchKey":785,"visible":14},"10003476",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":9,"currentStage":240,"position":791,"attributes":792},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[25],{"id":794,"viewCount":57,"searchKey":795,"visible":14},"10003466",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":9,"currentStage":240,"position":801,"attributes":802},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[284],[25],{"id":804,"viewCount":57,"searchKey":805,"visible":14},"10003379",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":9,"currentStage":21,"position":811,"attributes":812},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[592],{"id":814,"viewCount":57,"searchKey":815,"visible":14},"10003376",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":9,"currentStage":240,"position":821,"attributes":822},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[592],{"id":824,"viewCount":57,"searchKey":825,"visible":14},"10003543",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":9,"currentStage":21,"position":831,"attributes":832},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[252],[254],{"id":834,"viewCount":57,"searchKey":835,"visible":14},"10003557",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":9,"currentStage":240,"position":841,"attributes":842},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[254],{"id":844,"viewCount":57,"searchKey":845,"visible":14},"10003522",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":9,"currentStage":240,"position":851,"attributes":852},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[252],[254],{"id":854,"viewCount":57,"searchKey":855,"visible":14},"10003579",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":9,"currentStage":21,"position":861,"attributes":862},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[252],[286],{"id":864,"viewCount":57,"searchKey":865,"visible":14},"10003389",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":9,"currentStage":229,"position":871,"attributes":872},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[252],[286],{"id":874,"viewCount":57,"searchKey":875,"visible":14},"10003536",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":9,"currentStage":240,"position":881,"attributes":882},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[252],[286],{"id":5,"viewCount":57,"searchKey":884,"visible":14},{"type":10,"entryId":8,"sortOrder":885,"name":886,"imageUrl":887,"description":888,"currentMorphology":9,"currentStage":240,"position":889,"attributes":890},1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[220],{"id":4,"viewCount":57,"searchKey":892,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":893,"attributes":894},[23],[25],{"id":6,"viewCount":57,"searchKey":896,"visible":14},{"type":10,"entryId":12,"sortOrder":897,"name":79,"imageUrl":898,"description":899,"currentMorphology":9,"currentStage":240,"position":900,"attributes":901},1050300,"/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[25],{"id":903,"viewCount":57,"searchKey":904,"visible":14},"10003405",{"type":10,"entryId":905,"sortOrder":906,"name":907,"imageUrl":908,"description":909,"currentMorphology":9,"currentStage":21,"position":910,"attributes":911},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[252],[25],{"id":913,"viewCount":57,"searchKey":914,"visible":14},"10003525",{"type":10,"entryId":915,"sortOrder":916,"name":917,"imageUrl":918,"description":919,"currentMorphology":9,"currentStage":229,"position":920,"attributes":921},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[252],[220,25],{"id":923,"viewCount":57,"searchKey":924,"visible":14},"10003399",{"type":10,"entryId":925,"sortOrder":926,"name":927,"imageUrl":928,"description":929,"currentMorphology":9,"currentStage":240,"position":930,"attributes":931},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[252],[220,25],{"id":933,"viewCount":57,"searchKey":934,"visible":14},"10003518",{"type":10,"entryId":935,"sortOrder":936,"name":937,"imageUrl":938,"description":939,"currentMorphology":9,"currentStage":229,"position":940,"attributes":941},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[252],[25],{"id":943,"viewCount":57,"searchKey":944,"visible":14},"10003393",{"type":10,"entryId":945,"sortOrder":946,"name":947,"imageUrl":948,"description":949,"currentMorphology":9,"currentStage":240,"position":950,"attributes":951},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[252],[25],{"id":953,"viewCount":57,"searchKey":954,"visible":14},"10003386",{"type":10,"entryId":955,"sortOrder":956,"name":957,"imageUrl":958,"description":959,"currentMorphology":9,"currentStage":21,"position":960,"attributes":961},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[284],[25],{"id":963,"viewCount":57,"searchKey":964,"visible":14},"10003447",{"type":10,"entryId":965,"sortOrder":966,"name":967,"imageUrl":968,"description":969,"currentMorphology":9,"currentStage":240,"position":970,"attributes":971},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[284],[25],{"id":973,"viewCount":57,"searchKey":974,"visible":14},"10003497",{"type":10,"entryId":975,"sortOrder":976,"name":977,"imageUrl":978,"description":979,"currentMorphology":9,"currentStage":21,"position":980,"attributes":981},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[284],[592],{"id":983,"viewCount":57,"searchKey":984,"visible":14},"10003479",{"type":10,"entryId":985,"sortOrder":986,"name":987,"imageUrl":988,"description":989,"currentMorphology":9,"currentStage":229,"position":990,"attributes":991},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[284],[592],{"id":993,"viewCount":57,"searchKey":994,"visible":14},"10003388",{"type":10,"entryId":995,"sortOrder":996,"name":997,"imageUrl":998,"description":999,"currentMorphology":9,"currentStage":240,"position":1000,"attributes":1001},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[284],[592],{"id":1003,"viewCount":57,"searchKey":1004,"visible":14},"10003429",{"type":10,"entryId":1005,"sortOrder":1006,"name":1007,"imageUrl":1008,"description":1009,"currentMorphology":9,"currentStage":21,"position":1010,"attributes":1011},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[380],[349],{"id":1013,"viewCount":57,"searchKey":1014,"visible":14},"10003430",{"type":10,"entryId":1015,"sortOrder":1016,"name":1017,"imageUrl":1018,"description":1019,"currentMorphology":9,"currentStage":240,"position":1020,"attributes":1021},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[380],[349],{"id":1023,"viewCount":57,"searchKey":1024,"visible":14},"10003549",{"type":10,"entryId":1025,"sortOrder":1026,"name":1027,"imageUrl":1028,"description":1029,"currentMorphology":9,"currentStage":205,"position":1030,"attributes":1031},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[380],[592],{"id":1033,"viewCount":57,"searchKey":1034,"visible":14},"10003494",{"type":10,"entryId":1035,"sortOrder":1036,"name":1037,"imageUrl":1038,"description":1039,"currentMorphology":9,"currentStage":21,"position":1040,"attributes":1041},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[380],[25,349],{"id":1043,"viewCount":57,"searchKey":1044,"visible":14},"10003486",{"type":10,"entryId":1045,"sortOrder":1046,"name":1047,"imageUrl":1048,"description":1049,"currentMorphology":9,"currentStage":240,"position":1050,"attributes":1051},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[380],[25,349],{"id":1053,"viewCount":57,"searchKey":1054,"visible":14},"10003530",{"type":10,"entryId":1055,"sortOrder":1056,"name":1057,"imageUrl":1058,"description":1059,"currentMorphology":9,"currentStage":21,"position":1060,"attributes":1061},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[252],[370],{"id":1063,"viewCount":57,"searchKey":1064,"visible":14},"10003457",{"type":10,"entryId":1065,"sortOrder":1066,"name":1067,"imageUrl":1068,"description":1069,"currentMorphology":9,"currentStage":240,"position":1070,"attributes":1071},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[252],[370],{"id":1073,"viewCount":57,"searchKey":1074,"visible":14},"10003423",{"type":10,"entryId":1075,"sortOrder":1076,"name":1077,"imageUrl":1078,"description":1079,"currentMorphology":9,"currentStage":21,"position":1080,"attributes":1081},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[347],[327,349],{"id":1083,"viewCount":57,"searchKey":1084,"visible":14},"10003419",{"type":10,"entryId":1085,"sortOrder":1086,"name":1087,"imageUrl":1088,"description":1089,"currentMorphology":9,"currentStage":240,"position":1090,"attributes":1091},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[347],[327,349],{"id":1093,"viewCount":57,"searchKey":1094,"visible":14},"10003410",{"type":10,"entryId":1095,"sortOrder":1096,"name":1097,"imageUrl":1098,"description":1099,"currentMorphology":9,"currentStage":21,"position":1100,"attributes":1101},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[349],{"id":1103,"viewCount":57,"searchKey":1104,"visible":14},"10003509",{"type":10,"entryId":1105,"sortOrder":1106,"name":1107,"imageUrl":1108,"description":1109,"currentMorphology":9,"currentStage":240,"position":1110,"attributes":1111},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[349],{"id":1113,"viewCount":57,"searchKey":1114,"visible":14},"10003413",{"type":10,"entryId":1115,"sortOrder":1116,"name":1117,"imageUrl":1118,"description":1119,"currentMorphology":9,"currentStage":21,"position":1120,"attributes":1121},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[370],{"id":1123,"viewCount":57,"searchKey":1124,"visible":14},"10003407",{"type":10,"entryId":1125,"sortOrder":1126,"name":1127,"imageUrl":1128,"description":1129,"currentMorphology":9,"currentStage":240,"position":1130,"attributes":1131},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[370],{"id":1133,"viewCount":57,"searchKey":1134,"visible":14},"10003498",{"type":10,"entryId":1135,"sortOrder":1136,"name":1137,"imageUrl":1138,"description":1139,"currentMorphology":9,"currentStage":205,"position":1140,"attributes":1141},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1142],"attributes-holy",{"id":1144,"viewCount":57,"searchKey":1145,"visible":14},"10003375",{"type":10,"entryId":1146,"sortOrder":1147,"name":1148,"imageUrl":1149,"description":1150,"currentMorphology":9,"currentStage":205,"position":1151,"attributes":1152},"9998",1036100,"日耀獅","/cdn/i