g","疾行","進入「疾行」狀態，可以快速移動；持續消耗體力",{"attributes":147,"type":148,"consume":46,"power":46},[],[],{"id":150,"type":62,"props":151,"children":154},"91268445_24",{"title":152,"type":65,"id":153,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"伊莫特性","91268445_25",[155],{"id":156,"type":140,"props":157,"children":59},"91268445_26",{"id":158,"customKey":46,"icon":159,"iconStyle":65,"iconTitle":46,"descTitle":160,"descContent":161,"source":162},"91268445_27","/cdn/init/1013300_Feature_11372_Icon.png","蝕骨霜風","對「冰元素異常」大於5層的目標造成傷害時，傷害額外附加15%暴擊率。",{"attributes":163,"type":164,"consume":46,"power":46},[],[],{"id":166,"type":62,"props":167,"children":59},"91268445_28",{"title":168,"type":65,"id":169,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":170},"技能介紹","91268445_29",[171,235],{"id":172,"title":173,"children":174},"91268445_30","戰鬥技能",[175,189,201,213,224],{"id":176,"type":140,"props":177},"91268445_31",{"id":178,"customKey":46,"icon":179,"iconStyle":65,"iconTitle":46,"descTitle":180,"descContent":181,"source":182},"91268445_32","/cdn/init/1013300_Skill_10200100_Icon.png","霜刺尾擊","前空翻衝向目標，甩尾砸擊地面，對目標造成傷害。可消耗10層「冰元素異常」，額外造成85%傷害。",{"attributes":183,"type":185,"consume":187,"power":188},[184],"2",[186],"1","15","60",{"id":190,"type":140,"props":191},"91268445_33",{"id":192,"customKey":46,"icon":193,"iconStyle":65,"iconTitle":46,"descTitle":194,"descContent":195,"source":196},"91268445_34","/cdn/init/1013300_Skill_10200061_Icon.png","迴旋冰刃","向前丟出冰刃，對範圍內的目標造成傷害並附加「冰元素異常」。冰刃旋轉期間會持續消耗能量，再次按下技能鍵可召回冰刃。",{"attributes":197,"type":198,"consume":199,"power":200},[184],[186],"20","39",{"id":202,"type":140,"props":203},"91268445_35",{"id":204,"customKey":46,"icon":205,"iconStyle":65,"iconTitle":46,"descTitle":206,"descContent":207,"source":208},"91268445_36","/cdn/init/1013300_Skill_11300100_Icon.png","虹光斬","向前跨步，旋轉身體攻擊一次並創造法術場發出3道光刃攻擊三次，造成傷害。",{"attributes":209,"type":211,"consume":199,"power":212},[210],"13",[186],"75",{"id":214,"type":140,"props":215},"91268445_37",{"id":216,"customKey":46,"icon":217,"iconStyle":65,"iconTitle":46,"descTitle":218,"descContent":219,"source":220},"91268445_38","/cdn/init/1013300_Skill_10200081_Icon.png","冰刃三連斬","向前跨步，旋轉身體攻擊一次並創造法術場發出3道冰刃攻擊三次，造成傷害並附加5層「冰元素異常」。",{"attributes":221,"type":222,"consume":199,"power":223},[184],[186],"55",{"id":225,"type":140,"props":226},"91268445_39",{"id":227,"customKey":46,"icon":228,"iconStyle":65,"iconTitle":46,"descTitle":229,"descContent":230,"source":231},"91268445_40","/cdn/init/1013300_Skill_11200286_Icon.png","夜魔斬","向前跨出一步，旋轉身體，發出3道暗影刀刃，造成傷害。",{"attributes":232,"type":234,"consume":199,"power":223},[233],"12",[186],{"id":236,"title":237,"children":238},"91268445_41","固有技能",[239,251],{"id":240,"type":140,"props":241},"91268445_42",{"id":242,"customKey":46,"icon":243,"iconStyle":65,"iconTitle":46,"descTitle":244,"descContent":245,"source":246},"91268445_43","/cdn/init/1013300_Skill_10200090_Icon.png","冰封龍捲","化身為一道冰龍捲，持續地衝擊並攻擊目標。",{"attributes":247,"type":248,"consume":249,"power":250},[184],[186],"0","155",{"id":252,"type":140,"props":253},"91268445_44",{"id":254,"customKey":46,"icon":255,"iconStyle":65,"iconTitle":46,"descTitle":256,"descContent":257,"source":258},"91268445_45","/cdn/init/1013300_Skill_10200000_Icon.png","攻擊","使用冰元素能力，近距離攻擊目標。",{"attributes":259,"type":260,"consume":249,"power":261},[184],[186],"6",[263,264,265],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":266,"entryId":12,"currentMorphology":9,"visible":15},"10003385",[268,279,289,299,311,321,331,343,353,363,373,384,394,406,416,426,437,447,457,467,477,487,497,508,518,528,538,548,558,568,578,588,598,608,618,628,638,649,659,669,679,689,699,709,718,726,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1130,1140,1150,1160,1170,1180,1190,1201],{"id":269,"viewCount":59,"searchKey":270,"visible":15},"10003442",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":21,"currentStage":186,"position":276,"attributes":277},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[278],"attributes-fire",{"id":280,"viewCount":59,"searchKey":281,"visible":15},"10003534",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":21,"currentStage":184,"position":287,"attributes":288},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[24],[278],{"id":290,"viewCount":59,"searchKey":291,"visible":15},"10003435",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":21,"currentStage":22,"position":297,"attributes":298},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[24],[278],{"id":300,"viewCount":59,"searchKey":301,"visible":15},"10003428",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":21,"currentStage":22,"position":307,"attributes":309},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[308],"position-break",[278,310],"attributes-dark",{"id":312,"viewCount":59,"searchKey":313,"visible":15},"10003578",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":21,"currentStage":186,"position":319,"attributes":320},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[310],{"id":322,"viewCount":59,"searchKey":323,"visible":15},"10003417",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":21,"currentStage":22,"position":329,"attributes":330},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[310],{"id":332,"viewCount":59,"searchKey":333,"visible":15},"10003488",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":21,"currentStage":186,"position":339,"attributes":341},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[340],"position-sup",[342],"attributes-wind",{"id":344,"viewCount":59,"searchKey":345,"visible":15},"10003548",{"type":10,"entryId":346,"sortOrder":347,"name":348,"imageUrl":349,"description":350,"currentMorphology":21,"currentStage":22,"position":351,"attributes":352},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[340],[342],{"id":354,"viewCount":59,"searchKey":355,"visible":15},"10003474",{"type":10,"entryId":356,"sortOrder":357,"name":358,"imageUrl":359,"description":360,"currentMorphology":21,"currentStage":22,"position":361,"attributes":362},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[342],{"id":364,"viewCount":59,"searchKey":365,"visible":15},"10003467",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":21,"currentStage":22,"position":371,"attributes":372},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[308],[342],{"id":374,"viewCount":59,"searchKey":375,"visible":15},"10003392",{"type":10,"entryId":376,"sortOrder":377,"name":378,"imageUrl":379,"description":380,"currentMorphology":21,"currentStage":186,"position":381,"attributes":382},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[383],"attributes-grass",{"id":385,"viewCount":59,"searchKey":386,"visible":15},"10003510",{"type":10,"entryId":387,"sortOrder":388,"name":389,"imageUrl":390,"description":391,"currentMorphology":21,"currentStage":22,"position":392,"attributes":393},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[383],{"id":395,"viewCount":59,"searchKey":396,"visible":15},"10003477",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":21,"currentStage":186,"position":402,"attributes":404},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[403],"position-heal",[405],"attributes-water",{"id":407,"viewCount":59,"searchKey":408,"visible":15},"10003569",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":21,"currentStage":184,"position":414,"attributes":415},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[403],[405],{"id":417,"viewCount":59,"searchKey":418,"visible":15},"10003470",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":21,"currentStage":22,"position":424,"attributes":425},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[403],[405,26],{"id":427,"viewCount":59,"searchKey":428,"visible":15},"10003463",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":21,"currentStage":22,"position":434,"attributes":436},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[435],"position-energy",[383,405],{"id":438,"viewCount":59,"searchKey":439,"visible":15},"10003468",{"type":10,"entryId":440,"sortOrder":441,"name":442,"imageUrl":443,"description":444,"currentMorphology":21,"currentStage":186,"position":445,"attributes":446},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[340],[342],{"id":448,"viewCount":59,"searchKey":449,"visible":15},"10003365",{"type":10,"entryId":450,"sortOrder":451,"name":452,"imageUrl":453,"description":454,"currentMorphology":21,"currentStage":22,"position":455,"attributes":456},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[340],[342],{"id":458,"viewCount":59,"searchKey":459,"visible":15},"10003461",{"type":10,"entryId":460,"sortOrder":461,"name":462,"imageUrl":463,"description":464,"currentMorphology":21,"currentStage":22,"position":465,"attributes":466},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[340],[310],{"id":468,"viewCount":59,"searchKey":469,"visible":15},"10003421",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":21,"currentStage":186,"position":475,"attributes":476},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[308],[383],{"id":478,"viewCount":59,"searchKey":479,"visible":15},"10003414",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":21,"currentStage":22,"position":485,"attributes":486},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[435],[310,383],{"id":488,"viewCount":59,"searchKey":489,"visible":15},"10003404",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":21,"currentStage":22,"position":495,"attributes":496},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[308],[383],{"id":498,"viewCount":59,"searchKey":499,"visible":15},"10003567",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":21,"currentStage":186,"position":505,"attributes":506},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[308],[507,383],"attributes-rock",{"id":509,"viewCount":59,"searchKey":510,"visible":15},"10003462",{"type":10,"entryId":511,"sortOrder":512,"name":513,"imageUrl":514,"description":515,"currentMorphology":21,"currentStage":22,"position":516,"attributes":517},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[308],[507,383],{"id":519,"viewCount":59,"searchKey":520,"visible":15},"10003551",{"type":10,"entryId":521,"sortOrder":522,"name":523,"imageUrl":524,"description":525,"currentMorphology":21,"currentStage":22,"position":526,"attributes":527},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[308],[26],{"id":529,"viewCount":59,"searchKey":530,"visible":15},"10003409",{"type":10,"entryId":531,"sortOrder":532,"name":533,"imageUrl":534,"description":535,"currentMorphology":21,"currentStage":186,"position":536,"attributes":537},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[435],[278],{"id":539,"viewCount":59,"searchKey":540,"visible":15},"10003507",{"type":10,"entryId":541,"sortOrder":542,"name":543,"imageUrl":544,"description":545,"currentMorphology":21,"currentStage":22,"position":546,"attributes":547},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[435],[278],{"id":549,"viewCount":59,"searchKey":550,"visible":15},"10003542",{"type":10,"entryId":551,"sortOrder":552,"name":553,"imageUrl":554,"description":555,"currentMorphology":21,"currentStage":186,"position":556,"attributes":557},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[403],[342],{"id":559,"viewCount":59,"searchKey":560,"visible":15},"10003440",{"type":10,"entryId":561,"sortOrder":562,"name":563,"imageUrl":564,"description":565,"currentMorphology":21,"currentStage":22,"position":566,"attributes":567},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[403],[342],{"id":569,"viewCount":59,"searchKey":570,"visible":15},"10003563",{"type":10,"entryId":571,"sortOrder":572,"name":573,"imageUrl":574,"description":575,"currentMorphology":21,"currentStage":249,"position":576,"attributes":577},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[435],[342,383],{"id":579,"viewCount":59,"searchKey":580,"visible":15},"10003368",{"type":10,"entryId":581,"sortOrder":582,"name":583,"imageUrl":584,"description":585,"currentMorphology":21,"currentStage":186,"position":586,"attributes":587},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[340],[342],{"id":589,"viewCount":59,"searchKey":590,"visible":15},"10003363",{"type":10,"entryId":591,"sortOrder":592,"name":593,"imageUrl":594,"description":595,"currentMorphology":21,"currentStage":22,"position":596,"attributes":597},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[340],[342],{"id":599,"viewCount":59,"searchKey":600,"visible":15},"10003515",{"type":10,"entryId":601,"sortOrder":602,"name":603,"imageUrl":604,"description":605,"currentMorphology":21,"currentStage":186,"position":606,"attributes":607},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[383],{"id":609,"viewCount":59,"searchKey":610,"visible":15},"10003496",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":21,"currentStage":22,"position":616,"attributes":617},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[24],[383],{"id":619,"viewCount":59,"searchKey":620,"visible":15},"10003378",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":21,"currentStage":22,"position":626,"attributes":627},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[340],[383],{"id":629,"viewCount":59,"searchKey":630,"visible":15},"10003456",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":21,"currentStage":186,"position":636,"attributes":637},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[308],[383],{"id":639,"viewCount":59,"searchKey":640,"visible":15},"10003374",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":21,"currentStage":22,"position":646,"attributes":647},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[340],[648],"attributes-electric",{"id":650,"viewCount":59,"searchKey":651,"visible":15},"10003443",{"type":10,"entryId":652,"sortOrder":653,"name":654,"imageUrl":655,"description":656,"currentMorphology":21,"currentStage":22,"position":657,"attributes":658},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[308],[383],{"id":660,"viewCount":59,"searchKey":661,"visible":15},"10003503",{"type":10,"entryId":662,"sortOrder":663,"name":664,"imageUrl":665,"description":666,"currentMorphology":21,"currentStage":186,"position":667,"attributes":668},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[340],[310],{"id":670,"viewCount":59,"searchKey":671,"visible":15},"10003521",{"type":10,"entryId":672,"sortOrder":673,"name":674,"imageUrl":675,"description":676,"currentMorphology":21,"currentStage":22,"position":677,"attributes":678},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[340],[310],{"id":680,"viewCount":59,"searchKey":681,"visible":15},"10003508",{"type":10,"entryId":682,"sortOrder":683,"name":684,"imageUrl":685,"description":686,"currentMorphology":21,"currentStage":186,"position":687,"attributes":688},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[310],{"id":690,"viewCount":59,"searchKey":691,"visible":15},"10003369",{"type":10,"entryId":692,"sortOrder":693,"name":694,"imageUrl":695,"description":696,"currentMorphology":21,"currentStage":22,"position":697,"attributes":698},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[24],[310],{"id":700,"viewCount":59,"searchKey":701,"visible":15},"10003501",{"type":10,"entryId":702,"sortOrder":703,"name":704,"imageUrl":705,"description":706,"currentMorphology":21,"currentStage":22,"position":707,"attributes":708},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[648],{"id":710,"viewCount":59,"searchKey":711,"visible":15},"10003422",{"type":10,"entryId":712,"sortOrder":713,"name":75,"imageUrl":714,"description":715,"currentMorphology":21,"currentStage":186,"position":716,"attributes":717},"045",1013100,"/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[26],{"id":719,"viewCount":59,"searchKey":720,"visible":15},"10003575",{"type":10,"entryId":8,"sortOrder":721,"name":83,"imageUrl":722,"description":723,"currentMorphology":21,"currentStage":184,"position":724,"attributes":725},1013200,"/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[26],{"id":4,"viewCount":59,"searchKey":727,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":728,"attributes":729},[24],[26],{"id":731,"viewCount":59,"searchKey":732,"visible":15},"10003524",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":21,"currentStage":186,"position":738,"attributes":739},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[308],[648],{"id":741,"viewCount":59,"searchKey":742,"visible":15},"10003475",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":21,"currentStage":22,"position":748,"attributes":749},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[308],[648],{"id":751,"viewCount":59,"searchKey":752,"visible":15},"10003523",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":21,"currentStage":186,"position":758,"attributes":759},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[308],[405],{"id":761,"viewCount":59,"searchKey":762,"visible":15},"10003398",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":21,"currentStage":184,"position":768,"attributes":769},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[308],[405],{"id":771,"viewCount":59,"searchKey":772,"visible":15},"10003516",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":21,"currentStage":22,"position":778,"attributes":779},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[340],[405],{"id":781,"viewCount":59,"searchKey":782,"visible":15},"10003566",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":21,"currentStage":22,"position":788,"attributes":789},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[308],[405],{"id":791,"viewCount":59,"searchKey":792,"visible":15},"10003453",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":21,"currentStage":186,"position":798,"attributes":799},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[24],[405],{"id":801,"viewCount":59,"searchKey":802,"visible":15},"10003577",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":21,"currentStage":184,"position":808,"attributes":809},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[405],{"id":811,"viewCount":59,"searchKey":812,"visible":15},"10003570",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":21,"currentStage":22,"position":818,"attributes":819},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[405],{"id":821,"viewCount":59,"searchKey":822,"visible":15},"10003565",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":21,"currentStage":186,"position":828,"attributes":829},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[24],[507],{"id":831,"viewCount":59,"searchKey":832,"visible":15},"10003476",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":21,"currentStage":22,"position":838,"attributes":839},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[507],{"id":841,"viewCount":59,"searchKey":842,"visible":15},"10003466",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":21,"currentStage":22,"position":848,"attributes":849},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[340],[507],{"id":851,"viewCount":59,"searchKey":852,"visible":15},"10003379",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":21,"currentStage":186,"position":858,"attributes":859},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[24],[648],{"id":861,"viewCount":59,"searchKey":862,"visible":15},"10003376",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":21,"currentStage":22,"position":868,"attributes":869},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[648],{"id":871,"viewCount":59,"searchKey":872,"visible":15},"10003543",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":21,"currentStage":186,"position":878,"attributes":879},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[308],[310],{"id":881,"viewCount":59,"searchKey":882,"visible":15},"10003557",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":21,"currentStage":22,"position":888,"attributes":889},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[310],{"id":891,"viewCount":59,"searchKey":892,"visible":15},"10003522",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":21,"currentStage":22,"position":898,"attributes":899},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[308],[310],{"id":901,"viewCount":59,"searchKey":902,"visible":15},"10003579",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":21,"currentStage":186,"position":908,"attributes":909},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[308],[342],{"id":911,"viewCount":59,"searchKey":912,"visible":15},"10003389",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":21,"currentStage":184,"position":918,"attributes":919},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[308],[342],{"id":921,"viewCount":59,"searchKey":922,"visible":15},"10003536",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":21,"currentStage":22,"position":928,"attributes":929},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[308],[342],{"id":931,"viewCount":59,"searchKey":932,"visible":15},"10003529",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":21,"currentStage":22,"position":938,"attributes":939},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[24],[278],{"id":941,"viewCount":59,"searchKey":942,"visible":15},"10003433",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":21,"currentStage":186,"position":948,"attributes":949},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[507],{"id":951,"viewCount":59,"searchKey":952,"visible":15},"10003427",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":21,"currentStage":22,"position":958,"attributes":959},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[507],{"id":961,"viewCount":59,"searchKey":962,"visible":15},"10003405",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":21,"currentStage":186,"position":968,"attributes":969},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[308],[507],{"id":971,"viewCount":59,"searchKey":972,"visible":15},"10003525",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":21,"currentStage":184,"position":978,"attributes":979},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[308],[278,507],{"id":981,"viewCount":59,"searchKey":982,"visible":15},"10003399",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":21,"currentStage":22,"position":988,"attributes":989},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[308],[278,507],{"id":991,"viewCount":59,"searchKey":992,"visible":15},"10003518",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":21,"currentStage":184,"position":998,"attributes":999},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[308],[507],{"id":1001,"viewCount":59,"searchKey":1002,"visible":15},"10003393",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":21,"currentStage":22,"position":1008,"attributes":1009},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[308],[507],{"id":1011,"viewCount":59,"searchKey":1012,"visible":15},"10003386",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":21,"currentStage":186,"position":1018,"attributes":1019},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[340],[507],{"id":1021,"viewCount":59,"searchKey":1022,"visible":15},"10003447",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":21,"currentStage":22,"position":1028,"attributes":1029},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[340],[507],{"id":1031,"viewCount":59,"searchKey":1032,"visible":15},"10003497",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":21,"currentStage":186,"position":1038,"attributes":1039},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[340],[648],{"id":1041,"viewCount":59,"searchKey":1042,"visible":15},"10003479",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":21,"currentStage":184,"position":1048,"attributes":1049},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[340],[648],{"id":1051,"viewCount":59,"searchKey":1052,"visible":15},"10003388",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":21,"currentStage":22,"position":1058,"attributes":1059},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[340],[648],{"id":1061,"viewCount":59,"searchKey":1062,"visible":15},"10003429",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":21,"currentStage":186,"position":1068,"attributes":1069},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[435],[405],{"id":1071,"viewCount":59,"searchKey":1072,"visible":15},"10003430",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":21,"currentStage":22,"position":1078,"attributes":1079},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[435],[405],{"id":1081,"viewCount":59,"searchKey":1082,"visible":15},"10003549",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":21,"currentStage":249,"position":1088,"attributes":1089},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[435],[648],{"id":1091,"viewCount":59,"searchKey":1092,"visible":15},"10003494",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":21,"currentStage":186,"position":1098,"attributes":1099},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[435],[507,405],{"id":1101,"viewCount":59,"searchKey":1102,"visible":15},"10003486",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":21,"currentStage":22,"position":1108,"attributes":1109},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[435],[507,405],{"id":1111,"viewCount":59,"searchKey":1112,"visible":15},"10003530",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":21,"currentStage":186,"position":1118,"attributes":1119},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[308],[26],{"id":1121,"viewCount":59,"searchKey":1122,"visible":15},"10003457",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":21,"currentStage":22,"position":1128,"attributes":1129},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[308],[26],{"id":1131,"viewCount":59,"searchKey":1132,"visible":15},"10003423",{"type":10,"entryId":1133,"sortOrder":1134,"name":1135,"imageUrl":1136,"description":1137,"currentMorphology":21,"currentStage":186,"position":1138,"attributes":1139},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[403],[383,405],{"id":1141,"viewCount":59,"searchKey":1142,"visible":15},"10003419",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":21,"currentStage":22,"position":1148,"attributes":1149},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[403],[383,405],{"id":1151,"viewCount":59,"searchKey":1152,"visible":15},"10003410",{"type":10,"entryId":1153,"sortOrder":1154,"name":1155,"imageUrl":1156,"description":1157,"currentMorphology":21,"currentStage":186,"position":1158,"attributes":1159},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[405],{"id":1161,"viewCount":59,"searchKey":1162,"visible":15},"10003509",{"type":10,"entryId":1163,"sortOrder":1164,"name":1165,"imageUrl":1166,"description":1167,"currentMorphology":21,"currentStage":22,"position":1168,"attributes":1169},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[405],{"id":1171,"viewCount":59,"searchKey":1172,"visible":15},"10003413",{"type":10,"entryId":1173,"sortOrder":1174,"name":1175,"imageUrl":1176,"description":1177,"currentMorphology":21,"currentStage":186,"position":1178,"attributes":1179},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[26],{"id":1181,"viewCount":59,"searchKey":1182,"visible":15},"10003407",{"type":10,"entryId":1183,"sortOrder":1184,"name":1185,"imageUrl":1186,"description":1187,"currentMorphology":21,"currentStage":22,"position":1188,"attributes":1189},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[26],{"id":1191,"viewCount":59,"searchKey":1192,"visible":15},"10003498",{"type":10,"entryId":1193,"sortOrder":1194,"name":1195,"imageUrl":1196,"description":1197,"currentMorphology":21,"currentStage":249,"position":1198,"attributes":1199},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1200],"attributes-holy",{"id":1202,"viewCount":59,"searchKey":1203,"visible":15},"10003375",{"type":10,"entryId":1204,"sortOrder":1205,"name":1206,"imageUrl":1207,"description":1208,"currentMorphology":21,"currentStage":249,"position":1209,"attributes":1210},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1200],[1212,1220,1225,1230,1235,1240,1245,1250,1254,1257,1261,1266,1271,1276,1281,1286,1291,1296,1299],{"id":1213,"parentId":12