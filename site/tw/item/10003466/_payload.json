":75,"icon":76,"stage":28,"position":37,"stageStrength":28,"condition":77,"children":79},"root","滾滾郎","/cdn/init/Wiki_PetHead_10451.png",{"isVariant":67,"list":78},[],[80,87],{"id":81,"name":82,"label":82,"icon":83,"stage":58,"position":37,"stageStrength":58,"condition":84,"children":86},"91268496_6","機車郎","/cdn/init/Wiki_PetHead_10453.png",{"isVariant":67,"list":85},[],[],{"id":88,"name":17,"label":17,"icon":89,"stage":58,"position":28,"stageStrength":58,"condition":90,"children":92},"91268496_7","/cdn/init/Wiki_PetHead_10454.png",{"isVariant":67,"list":91},[],[],"91268496_5",{"id":95,"type":62,"props":96,"children":100},"91268496_8",{"title":97,"type":98,"id":99,"isUse":14,"isEdit":14,"useTabs":67,"blackHeader":67},"出現地區","small","91268496_9",[101],{"id":102,"type":103,"props":104,"children":59},"91268496_10","capsule",{"id":105,"customKey":46,"title":106,"icon":46,"bgColor":107,"fontColor":108,"type":109},"91268496_11","青石台","#dee2ec","#60606e","normal",{"id":111,"type":62,"props":112,"children":115},"91268496_12",{"title":113,"type":98,"id":114,"isUse":14,"isEdit":14,"useTabs":67,"blackHeader":67},"家園能力","91268496_13",[116,122],{"id":117,"type":103,"props":118,"children":59},"91268496_14",{"id":119,"customKey":120,"title":21,"icon":46,"bgColor":46,"fontColor":46,"type":121},"91268496_15","home-1102","spritePic",{"id":123,"type":103,"props":124,"children":59},"91268496_16",{"id":125,"customKey":126,"title":21,"icon":46,"bgColor":46,"fontColor":46,"type":121},"91268496_17","home-1003",{"id":128,"title":129,"components":130},2,"伊莫能力",[131,148],{"id":132,"type":62,"props":133,"children":136},"91268496_22",{"title":134,"type":65,"id":135,"isUse":14,"isEdit":14,"useTabs":67,"blackHeader":67},"伊莫特性","91268496_23",[137],{"id":138,"type":139,"props":140,"children":59},"91268496_24","circle",{"id":141,"customKey":46,"icon":142,"iconStyle":65,"iconTitle":46,"descTitle":143,"descContent":144,"source":145},"91268496_25","/cdn/init/1045400_Feature_145402_Icon.png","岩石賦能","岩球郎創造的「岩石堆」可以被機車郎的「岩球旋風」技能摧毀並施放衝擊波，對目標附加「瓦解」效果。「瓦解」：每層使土元素抗性降低3%%，移動速度降低5%，持續20秒，最多疊加6層。",{"attributes":146,"type":147,"consume":46,"power":46},[],[],{"id":149,"type":62,"props":150,"children":59},"91268496_26",{"title":151,"type":65,"id":152,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":67,"tabs":153},"技能介紹","91268496_27",[154,204],{"id":155,"title":156,"children":157},"91268496_28","戰鬥技能",[158,172,184,195],{"id":159,"type":139,"props":160},"91268496_29",{"id":161,"customKey":46,"icon":162,"iconStyle":65,"iconTitle":46,"descTitle":163,"descContent":164,"source":165},"91268496_30","/cdn/init/1045400_Skill_10800480_Icon.png","黏土球","向面朝的方向丟出沿直線發射的黏土球，擊中目標會造成傷害並附加「瓦解」效果。",{"attributes":166,"type":168,"consume":170,"power":171},[167],"8",[169],"1","10","40",{"id":173,"type":139,"props":174},"91268496_31",{"id":175,"customKey":46,"icon":176,"iconStyle":65,"iconTitle":46,"descTitle":177,"descContent":178,"source":179},"91268496_32","/cdn/init/1045400_Skill_10800460_Icon.png","岩突撞擊","原地蓄力一小段後衝向目標，使用身體撞擊目標，對目標造成傷害，並在目標周圍生成4個「岩石堆」。",{"attributes":180,"type":181,"consume":182,"power":183},[167],[169],"0","30",{"id":185,"type":139,"props":186},"91268496_33",{"id":187,"customKey":46,"icon":188,"iconStyle":65,"iconTitle":46,"descTitle":189,"descContent":190,"source":191},"91268496_34","/cdn/init/1045400_Skill_10200370_Icon.png","冰滾球","變成一個球自動前進，可以調整方向，撞擊目標會造成傷害，碰到牆體會反彈並對周圍造成15威力的範圍傷害，持續15秒。「滾滾球」型態下可以進行跳躍，落下時會對周圍的目標造成20威力範圍傷害，跳躍冷卻時間5秒。",{"attributes":192,"type":194,"consume":171,"power":170},[193],"2",[169],{"id":196,"type":139,"props":197},"91268496_35",{"id":198,"customKey":46,"icon":199,"iconStyle":65,"iconTitle":46,"descTitle":200,"descContent":190,"source":201},"91268496_36","/cdn/init/1045400_Skill_10800470_Icon.png","滾滾球",{"attributes":202,"type":203,"consume":171,"power":170},[167],[169],{"id":205,"title":206,"children":207},"91268496_37","固有技能",[208,219],{"id":209,"type":139,"props":210},"91268496_38",{"id":211,"customKey":46,"icon":212,"iconStyle":65,"iconTitle":46,"descTitle":213,"descContent":214,"source":215},"91268496_39","/cdn/init/1045400_Skill_10800522_Icon.png","爆炸岩球","在地面橫向高速旋轉，產生吸力吸收周圍的碎石，蓄力爆炸，爆炸後對周圍的敵人造成傷害並在岩球郎周圍產生6個「岩石堆」。",{"attributes":216,"type":217,"consume":182,"power":218},[167],[169],"175",{"id":220,"type":139,"props":221},"91268496_40",{"id":222,"customKey":46,"icon":223,"iconStyle":65,"iconTitle":46,"descTitle":224,"descContent":225,"source":226},"91268496_41","/cdn/init/1045400_Skill_10800000_Icon.png","攻擊","使用土元素能力，近距離攻擊目標。",{"attributes":227,"type":228,"consume":182,"power":229},[167],[169],"6",[231,232],{"id":4,"entryId":12,"currentMorphology":20,"visible":14},{"id":6,"entryId":12,"currentMorphology":9,"visible":14},[234,246,256,266,278,288,298,309,319,329,339,350,360,372,382,393,404,414,424,434,444,454,464,474,484,494,504,514,524,534,544,554,564,574,584,594,604,615,625,635,645,655,665,675,685,695,705,715,725,735,745,755,765,775,785,795,804,812,816,826,836,846,856,866,876,886,896,906,916,926,936,946,956,966,976,986,996,1006,1016,1026,1036,1046,1056,1066,1076,1086,1096,1106,1116,1126,1136,1146,1156,1167],{"id":235,"viewCount":59,"searchKey":236,"visible":14},"10003442",{"type":10,"entryId":237,"sortOrder":238,"name":239,"imageUrl":240,"description":241,"currentMorphology":20,"currentStage":169,"position":242,"attributes":244},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[243],"position-dps",[245],"attributes-fire",{"id":247,"viewCount":59,"searchKey":248,"visible":14},"10003534",{"type":10,"entryId":249,"sortOrder":250,"name":251,"imageUrl":252,"description":253,"currentMorphology":20,"currentStage":193,"position":254,"attributes":255},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[243],[245],{"id":257,"viewCount":59,"searchKey":258,"visible":14},"10003435",{"type":10,"entryId":259,"sortOrder":260,"name":261,"imageUrl":262,"description":263,"currentMorphology":20,"currentStage":21,"position":264,"attributes":265},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[243],[245],{"id":267,"viewCount":59,"searchKey":268,"visible":14},"10003428",{"type":10,"entryId":269,"sortOrder":270,"name":271,"imageUrl":272,"description":273,"currentMorphology":20,"currentStage":21,"position":274,"attributes":276},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[275],"position-break",[245,277],"attributes-dark",{"id":279,"viewCount":59,"searchKey":280,"visible":14},"10003578",{"type":10,"entryId":281,"sortOrder":282,"name":283,"imageUrl":284,"description":285,"currentMorphology":20,"currentStage":169,"position":286,"attributes":287},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[243],[277],{"id":289,"viewCount":59,"searchKey":290,"visible":14},"10003417",{"type":10,"entryId":291,"sortOrder":292,"name":293,"imageUrl":294,"description":295,"currentMorphology":20,"currentStage":21,"position":296,"attributes":297},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[243],[277],{"id":299,"viewCount":59,"searchKey":300,"visible":14},"10003488",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":20,"currentStage":169,"position":306,"attributes":307},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[23],[308],"attributes-wind",{"id":310,"viewCount":59,"searchKey":311,"visible":14},"10003548",{"type":10,"entryId":312,"sortOrder":313,"name":314,"imageUrl":315,"description":316,"currentMorphology":20,"currentStage":21,"position":317,"attributes":318},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[23],[308],{"id":320,"viewCount":59,"searchKey":321,"visible":14},"10003474",{"type":10,"entryId":322,"sortOrder":323,"name":324,"imageUrl":325,"description":326,"currentMorphology":20,"currentStage":21,"position":327,"attributes":328},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[243],[308],{"id":330,"viewCount":59,"searchKey":331,"visible":14},"10003467",{"type":10,"entryId":332,"sortOrder":333,"name":334,"imageUrl":335,"description":336,"currentMorphology":20,"currentStage":21,"position":337,"attributes":338},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[275],[308],{"id":340,"viewCount":59,"searchKey":341,"visible":14},"10003392",{"type":10,"entryId":342,"sortOrder":343,"name":344,"imageUrl":345,"description":346,"currentMorphology":20,"currentStage":169,"position":347,"attributes":348},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[243],[349],"attributes-grass",{"id":351,"viewCount":59,"searchKey":352,"visible":14},"10003510",{"type":10,"entryId":353,"sortOrder":354,"name":355,"imageUrl":356,"description":357,"currentMorphology":20,"currentStage":21,"position":358,"attributes":359},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[243],[349],{"id":361,"viewCount":59,"searchKey":362,"visible":14},"10003477",{"type":10,"entryId":363,"sortOrder":364,"name":365,"imageUrl":366,"description":367,"currentMorphology":20,"currentStage":169,"position":368,"attributes":370},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[369],"position-heal",[371],"attributes-water",{"id":373,"viewCount":59,"searchKey":374,"visible":14},"10003569",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":20,"currentStage":193,"position":380,"attributes":381},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[369],[371],{"id":383,"viewCount":59,"searchKey":384,"visible":14},"10003470",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":20,"currentStage":21,"position":390,"attributes":391},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[369],[371,392],"attributes-ice",{"id":394,"viewCount":59,"searchKey":395,"visible":14},"10003463",{"type":10,"entryId":396,"sortOrder":397,"name":398,"imageUrl":399,"description":400,"currentMorphology":20,"currentStage":21,"position":401,"attributes":403},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[402],"position-energy",[349,371],{"id":405,"viewCount":59,"searchKey":406,"visible":14},"10003468",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":20,"currentStage":169,"position":412,"attributes":413},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[23],[308],{"id":415,"viewCount":59,"searchKey":416,"visible":14},"10003365",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":20,"currentStage":21,"position":422,"attributes":423},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[23],[308],{"id":425,"viewCount":59,"searchKey":426,"visible":14},"10003461",{"type":10,"entryId":427,"sortOrder":428,"name":429,"imageUrl":430,"description":431,"currentMorphology":20,"currentStage":21,"position":432,"attributes":433},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[23],[277],{"id":435,"viewCount":59,"searchKey":436,"visible":14},"10003421",{"type":10,"entryId":437,"sortOrder":438,"name":439,"imageUrl":440,"description":441,"currentMorphology":20,"currentStage":169,"position":442,"attributes":443},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[275],[349],{"id":445,"viewCount":59,"searchKey":446,"visible":14},"10003414",{"type":10,"entryId":447,"sortOrder":448,"name":449,"imageUrl":450,"description":451,"currentMorphology":20,"currentStage":21,"position":452,"attributes":453},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[402],[277,349],{"id":455,"viewCount":59,"searchKey":456,"visible":14},"10003404",{"type":10,"entryId":457,"sortOrder":458,"name":459,"imageUrl":460,"description":461,"currentMorphology":20,"currentStage":21,"position":462,"attributes":463},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[275],[349],{"id":465,"viewCount":59,"searchKey":466,"visible":14},"10003567",{"type":10,"entryId":467,"sortOrder":468,"name":469,"imageUrl":470,"description":471,"currentMorphology":20,"currentStage":169,"position":472,"attributes":473},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[275],[25,349],{"id":475,"viewCount":59,"searchKey":476,"visible":14},"10003462",{"type":10,"entryId":477,"sortOrder":478,"name":479,"imageUrl":480,"description":481,"currentMorphology":20,"currentStage":21,"position":482,"attributes":483},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[275],[25,349],{"id":485,"viewCount":59,"searchKey":486,"visible":14},"10003551",{"type":10,"entryId":487,"sortOrder":488,"name":489,"imageUrl":490,"description":491,"currentMorphology":20,"currentStage":21,"position":492,"attributes":493},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[275],[392],{"id":495,"viewCount":59,"searchKey":496,"visible":14},"10003409",{"type":10,"entryId":497,"sortOrder":498,"name":499,"imageUrl":500,"description":501,"currentMorphology":20,"currentStage":169,"position":502,"attributes":503},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[402],[245],{"id":505,"viewCount":59,"searchKey":506,"visible":14},"10003507",{"type":10,"entryId":507,"sortOrder":508,"name":509,"imageUrl":510,"description":511,"currentMorphology":20,"currentStage":21,"position":512,"attributes":513},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[402],[245],{"id":515,"viewCount":59,"searchKey":516,"visible":14},"10003542",{"type":10,"entryId":517,"sortOrder":518,"name":519,"imageUrl":520,"description":521,"currentMorphology":20,"currentStage":169,"position":522,"attributes":523},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[369],[308],{"id":525,"viewCount":59,"searchKey":526,"visible":14},"10003440",{"type":10,"entryId":527,"sortOrder":528,"name":529,"imageUrl":530,"description":531,"currentMorphology":20,"currentStage":21,"position":532,"attributes":533},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[369],[308],{"id":535,"viewCount":59,"searchKey":536,"visible":14},"10003563",{"type":10,"entryId":537,"sortOrder":538,"name":539,"imageUrl":540,"description":541,"currentMorphology":20,"currentStage":182,"position":542,"attributes":543},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[402],[308,349],{"id":545,"viewCount":59,"searchKey":546,"visible":14},"10003368",{"type":10,"entryId":547,"sortOrder":548,"name":549,"imageUrl":550,"description":551,"currentMorphology":20,"currentStage":169,"position":552,"attributes":553},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[23],[308],{"id":555,"viewCount":59,"searchKey":556,"visible":14},"10003363",{"type":10,"entryId":557,"sortOrder":558,"name":559,"imageUrl":560,"description":561,"currentMorphology":20,"currentStage":21,"position":562,"attributes":563},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[23],[308],{"id":565,"viewCount":59,"searchKey":566,"visible":14},"10003515",{"type":10,"entryId":567,"sortOrder":568,"name":569,"imageUrl":570,"description":571,"currentMorphology":20,"currentStage":169,"position":572,"attributes":573},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[243],[349],{"id":575,"viewCount":59,"searchKey":576,"visible":14},"10003496",{"type":10,"entryId":577,"sortOrder":578,"name":579,"imageUrl":580,"description":581,"currentMorphology":20,"currentStage":21,"position":582,"attributes":583},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[243],[349],{"id":585,"viewCount":59,"searchKey":586,"visible":14},"10003378",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":20,"currentStage":21,"position":592,"attributes":593},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[23],[349],{"id":595,"viewCount":59,"searchKey":596,"visible":14},"10003456",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":20,"currentStage":169,"position":602,"attributes":603},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[275],[349],{"id":605,"viewCount":59,"searchKey":606,"visible":14},"10003374",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":20,"currentStage":21,"position":612,"attributes":613},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[23],[614],"attributes-electric",{"id":616,"viewCount":59,"searchKey":617,"visible":14},"10003443",{"type":10,"entryId":618,"sortOrder":619,"name":620,"imageUrl":621,"description":622,"currentMorphology":20,"currentStage":21,"position":623,"attributes":624},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[275],[349],{"id":626,"viewCount":59,"searchKey":627,"visible":14},"10003503",{"type":10,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":20,"currentStage":169,"position":633,"attributes":634},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[23],[277],{"id":636,"viewCount":59,"searchKey":637,"visible":14},"10003521",{"type":10,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":20,"currentStage":21,"position":643,"attributes":644},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[23],[277],{"id":646,"viewCount":59,"searchKey":647,"visible":14},"10003508",{"type":10,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":20,"currentStage":169,"position":653,"attributes":654},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[243],[277],{"id":656,"viewCount":59,"searchKey":657,"visible":14},"10003369",{"type":10,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":20,"currentStage":21,"position":663,"attributes":664},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[243],[277],{"id":666,"viewCount":59,"searchKey":667,"visible":14},"10003501",{"type":10,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":20,"currentStage":21,"position":673,"attributes":674},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[243],[614],{"id":676,"viewCount":59,"searchKey":677,"visible":14},"10003422",{"type":10,"entryId":678,"sortOrder":679,"name":680,"imageUrl":681,"description":682,"currentMorphology":20,"currentStage":169,"position":683,"attributes":684},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[243],[392],{"id":686,"viewCount":59,"searchKey":687,"visible":14},"10003575",{"type":10,"entryId":688,"sortOrder":689,"name":690,"imageUrl":691,"description":692,"currentMorphology":20,"currentStage":193,"position":693,"attributes":694},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[243],[392],{"id":696,"viewCount":59,"searchKey":697,"visible":14},"10003415",{"type":10,"entryId":698,"sortOrder":699,"name":700,"imageUrl":701,"description":702,"currentMorphology":20,"currentStage":21,"position":703,"attributes":704},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[243],[392],{"id":706,"viewCount":59,"searchKey":707,"visible":14},"10003524",{"type":10,"entryId":708,"sortOrder":709,"name":710,"imageUrl":711,"description":712,"currentMorphology":20,"currentStage":169,"position":713,"attributes":714},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[275],[614],{"id":716,"viewCount":59,"searchKey":717,"visible":14},"10003475",{"type":10,"entryId":718,"sortOrder":719,"name":720,"imageUrl":721,"description":722,"currentMorphology":20,"currentStage":21,"position":723,"attributes":724},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[275],[614],{"id":726,"viewCount":59,"searchKey":727,"visible":14},"10003523",{"type":10,"entryId":728,"sortOrder":729,"name":730,"imageUrl":731,"description":732,"currentMorphology":20,"currentStage":169,"position":733,"attributes":734},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[275],[371],{"id":736,"viewCount":59,"searchKey":737,"visible":14},"10003398",{"type":10,"entryId":738,"sortOrder":739,"name":740,"imageUrl":741,"description":742,"currentMorphology":20,"currentStage":193,"position":743,"attributes":744},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[275],[371],{"id":746,"viewCount":59,"searchKey":747,"visible":14},"10003516",{"type":10,"entryId":748,"sortOrder":749,"name":750,"imageUrl":751,"description":752,"currentMorphology":20,"currentStage":21,"position":753,"attributes":754},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[23],[371],{"id":756,"viewCount":59,"searchKey":757,"visible":14},"10003566",{"type":10,"entryId":758,"sortOrder":759,"name":760,"imageUrl":761,"description":762,"currentMorphology":20,"currentStage":21,"position":763,"attributes":764},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[275],[371],{"id":766,"viewCount":59,"searchKey":767,"visible":14},"10003453",{"type":10,"entryId":768,"sortOrder":769,"name":770,"imageUrl":771,"description":772,"currentMorphology":20,"currentStage":169,"position":773,"attributes":774},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[243],[371],{"id":776,"viewCount":59,"searchKey":777,"visible":14},"10003577",{"type":10,"entryId":778,"sortOrder":779,"name":780,"imageUrl":781,"description":782,"currentMorphology":20,"currentStage":193,"position":783,"attributes":784},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[243],[371],{"id":786,"viewCount":59,"searchKey":787,"visible":14},"10003570",{"type":10,"entryId":788,"sortOrder":789,"name":790,"imageUrl":791,"description":792,"currentMorphology":20,"currentStage":21,"position":793,"attributes":794},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[243],[371],{"id":796,"viewCount":59,"searchKey":797,"visible":14},"10003565",{"type":10,"entryId":798,"sortOrder":799,"name":75,"imageUrl":800,"description":801,"currentMorphology":20,"currentStage":169,"position":802,"attributes":803},"057",1045100,"/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[243],[25],{"id":805,"viewCount":59,"searchKey":806,"visible":14},"10003476",{"type":10,"entryId":8,"sortOrder":807,"name":82,"imageUrl":808,"description":809,"currentMorphology":20,"currentStage":21,"position":810,"attributes":811},1045300,"/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[243],[25],{"id":4,"viewCount":59,"searchKey":813,"visible":14},{"type":10,"entryId":12,"sortOrder":16,"name":17,"imageUrl":18,"description":19,"currentMorphology":20,"currentStage":21,"position":814,"attributes":815},[23],[25],{"id":817,"viewCount":59,"searchKey":818,"visible":14},"10003379",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":20,"currentStage":169,"position":824,"attributes":825},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[243],[614],{"id":827,"viewCount":59,"searchKey":828,"visible":14},"10003376",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":20,"currentStage":21,"position":834,"attributes":835},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[243],[614],{"id":837,"viewCount":59,"searchKey":838,"visible":14},"10003543",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":20,"currentStage":169,"position":844,"attributes":845},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[275],[277],{"id":847,"viewCount":59,"searchKey":848,"visible":14},"10003557",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":20,"currentStage":21,"position":854,"attributes":855},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[243],[277],{"id":857,"viewCount":59,"searchKey":858,"visible":14},"10003522",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":20,"currentStage":21,"position":864,"attributes":865},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[275],[277],{"id":867,"viewCount":59,"searchKey":868,"visible":14},"10003579",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":20,"currentStage":169,"position":874,"attributes":875},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[275],[308],{"id":877,"viewCount":59,"searchKey":878,"visible":14},"10003389",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":20,"currentStage":193,"position":884,"attributes":885},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[275],[308],{"id":887,"viewCount":59,"searchKey":888,"visible":14},"10003536",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":20,"currentStage":21,"position":894,"attributes":895},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[275],[308],{"id":897,"viewCount":59,"searchKey":898,"visible":14},"10003529",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":20,"currentStage":21,"position":904,"attributes":905},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[243],[245],{"id":907,"viewCount":59,"searchKey":908,"visible":14},"10003433",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":20,"currentStage":169,"position":914,"attributes":915},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[243],[25],{"id":917,"viewCount":59,"searchKey":918,"visible":14},"10003427",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":20,"currentStage":21,"position":924,"attributes":925},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[243],[25],{"id":927,"viewCount":59,"searchKey":928,"visible":14},"10003405",{"type":10,"entryId":929,"sortOrder":930,"name":931,"imageUrl":932,"description":933,"currentMorphology":20,"currentStage":169,"position":934,"attributes":935},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[275],[25],{"id":937,"viewCount":59,"searchKey":938,"visible":14},"10003525",{"type":10,"entryId":939,"sortOrder":940,"name":941,"imageUrl":942,"description":943,"currentMorphology":20,"currentStage":193,"position":944,"attributes":945},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[275],[245,25],{"id":947,"viewCount":59,"searchKey":948,"visible":14},"10003399",{"type":10,"entryId":949,"sortOrder":950,"name":951,"imageUrl":952,"description":953,"currentMorphology":20,"currentStage":21,"position":954,"attributes":955},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[275],[245,25],{"id":957,"viewCount":59,"searchKey":958,"visible":14},"10003518",{"type":10,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":20,"currentStage":193,"position":964,"attributes":965},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[275],[25],{"id":967,"viewCount":59,"searchKey":968,"visible":14},"10003393",{"type":10,"entryId":969,"sortOrder":970,"name":971,"imageUrl":972,"description":973,"currentMorphology":20,"currentStage":21,"position":974,"attributes":975},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[275],[25],{"id":977,"viewCount":59,"searchKey":978,"visible":14},"10003386",{"type":10,"entryId":979,"sortOrder":980,"name":981,"imageUrl":982,"description":983,"currentMorphology":20,"currentStage":169,"position":984,"attributes":985},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[23],[25],{"id":987,"viewCount":59,"searchKey":988,"visible":14},"10003447",{"type":10,"entryId":989,"sortOrder":990,"name":991,"imageUrl":992,"description":993,"currentMorphology":20,"currentStage":21,"position":994,"attributes":995},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[23],[25],{"id":997,"viewCount":59,"searchKey":998,"visible":14},"10003497",{"type":10,"entryId":999,"sortOrder":1000,"name":1001,"imageUrl":1002,"description":1003,"currentMorphology":20,"currentStage":169,"position":1004,"attributes":1005},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[23],[614],{"id":1007,"viewCount":59,"searchKey":1008,"visible":14},"10003479",{"type":10,"entryId":1009,"sortOrder":1010,"name":1011,"imageUrl":1012,"description":1013,"currentMorphology":20,"currentStage":193,"position":1014,"attributes":1015},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[23],[614],{"id":1017,"viewCount":59,"searchKey":1018,"visible":14},"10003388",{"type":10,"entryId":1019,"sortOrder":1020,"name":1021,"imageUrl":1022,"description":1023,"currentMorphology":20,"currentStage":21,"position":1024,"attributes":1025},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[23],[614],{"id":1027,"viewCount":59,"searchKey":1028,"visible":14},"10003429",{"type":10,"entryId":1029,"sortOrder":1030,"name":1031,"imageUrl":1032,"description":1033,"currentMorphology":20,"currentStage":169,"position":1034,"attributes":1035},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[402],[371],{"id":1037,"viewCount":59,"searchKey":1038,"visible":14},"10003430",{"type":10,"entryId":1039,"sortOrder":1040,"name":1041,"imageUrl":1042,"description":1043,"currentMorphology":20,"currentStage":21,"position":1044,"attributes":1045},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[402],[371],{"id":1047,"viewCount":59,"searchKey":1048,"visible":14},"10003549",{"type":10,"entryId":1049,"sortOrder":1050,"name":1051,"imageUrl":1052,"description":1053,"currentMorphology":20,"currentStage":182,"position":1054,"attributes":1055},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[402],[614],{"id":1057,"viewCount":59,"searchKey":1058,"visible":14},"10003494",{"type":10,"entryId":1059,"sortOrder":1060,"name":1061,"imageUrl":1062,"description":1063,"currentMorphology":20,"currentStage":169,"position":1064,"attributes":1065},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[402],[25,371],{"id":1067,"viewCount":59,"searchKey":1068,"visible":14},"10003486",{"type":10,"entryId":1069,"sortOrder":1070,"name":1071,"imageUrl":1072,"description":1073,"currentMorphology":20,"currentStage":21,"position":1074,"attributes":1075},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[402],[25,371],{"id":1077,"viewCount":59,"searchKey":1078,"visible":14},"10003530",{"type":10,"entryId":1079,"sortOrder":1080,"name":1081,"imageUrl":1082,"description":1083,"currentMorphology":20,"currentStage":169,"position":1084,"attributes":1085},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[275],[392],{"id":1087,"viewCount":59,"searchKey":1088,"visible":14},"10003457",{"type":10,"entryId":1089,"sortOrder":1090,"name":1091,"imageUrl":1092,"description":1093,"currentMorphology":20,"currentStage":21,"position":1094,"attributes":1095},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[275],[392],{"id":1097,"viewCount":59,"searchKey":1098,"visible":14},"10003423",{"type":10,"entryId":1099,"sortOrder":1100,"name":1101,"imageUrl":1102,"description":1103,"currentMorphology":20,"currentStage":169,"position":1104,"attributes":1105},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[369],[349,371],{"id":1107,"viewCount":59,"searchKey":1108,"visible":14},"10003419",{"type":10,"entryId":1109,"sortOrder":1110,"name":1111,"imageUrl":1112,"description":1113,"currentMorphology":20,"currentStage":21,"position":1114,"attributes":1115},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[369],[349,371],{"id":1117,"viewCount":59,"searchKey":1118,"visible":14},"10003410",{"type":10,"entryId":1119,"sortOrder":1120,"name":1121,"imageUrl":1122,"description":1123,"currentMorphology":20,"currentStage":169,"position":1124,"attributes":1125},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[243],[371],{"id":1127,"viewCount":59,"searchKey":1128,"visible":14},"10003509",{"type":10,"entryId":1129,"sortOrder":1130,"name":1131,"imageUrl":1132,"description":1133,"currentMorphology":20,"currentStage":21,"position":1134,"attributes":1135},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[243],[371],{"id":1137,"viewCount":59,"searchKey":1138,"visible":14},"10003413",{"type":10,"entryId":1139,"sortOrder":1140,"name":1141,"imageUrl":1142,"description":1143,"currentMorphology":20,"currentStage":169,"position":1144,"attributes":1145},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[243],[392],{"id":1147,"viewCount":59,"searchKey":1148,"visible":14},"10003407",{"type":10,"entryId":1149,"sortOrder":1150,"name":1151,"imageUrl":1152,"description":1153,"currentMorphology":20,"currentStage":21,"position":1154,"attributes":1155},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[243],[392],{"id":1157,"viewCount":59,"searchKey":1158,"visible":14},"10003498",{"type":10,"entryId":1159,"sortOrder":1160,"name":1161,"imageUrl":1162,"description":1163,"currentMorphology":20,"currentStage":182,"position":1164,"attributes":1165},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[243],[1166],"attributes-holy",{"id":1168,"viewCount":59,"searchKey":1169,"visible":14},"10003375",{"type":10,"entryId":1170,"sortOrder":1171,"name":1172,"imageUrl":1173,"description":1174,"currentMorphology":20,"currentStage":182,"position":1175,"attributes":1176},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[243],[1166],[1178,1186,1191,1196,1201,1206,1211,1215,1219,1223,1228,1233,1238,1243,1248,1253,1258,1263,1266],{"id":1179,"parentId":1180,"tagType":1181,"tagKey":1182,"name":1183,"language":1184,"sort":1185},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1187,"parentId":1180,"tagType":1181,"tagKey":1188,"name":1189,"language":1184,"sort":1190},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1192,"parentId":1180,"tagType":1181,"tagKey":1193,"name":1194,"language":1184,"sort":1195},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1197,"parentId":1180,"tagType":1181,"tagKey":1198,"name":1199,"language":1184,"sort":1200},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1202,"parentId":1180,"tagType":1181,"tagKey":1203,"name":1204,"language":1184,"sort":1205},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1207,"parentId":1180,"tagType":1181,"tagKey":1208,"name":1209,"language":1184,"s