6,"customKey":47,"icon":147,"iconStyle":64,"iconTitle":47,"descTitle":148,"descContent":149,"source":150},"91268483_27","/cdn/init/1019100_Feature_119103_Icon.png","逐浪之心","處於水環境中或吸水後，水元素傷害提升20%，持續10秒。",{"attributes":151,"type":152,"consume":47,"power":47},[],[],{"id":154,"type":61,"props":155,"children":58},"91268483_28",{"title":156,"type":64,"id":157,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":66,"tabs":158},"技能介紹","91268483_29",[159,187],{"id":160,"title":161,"children":162},"91268483_30","戰鬥技能",[163,176],{"id":164,"type":144,"props":165},"91268483_31",{"id":166,"customKey":47,"icon":167,"iconStyle":64,"iconTitle":47,"descTitle":168,"descContent":169,"source":170},"91268483_32","/cdn/init/1019100_Skill_10300090_Icon.png","流水猛擊","用貝殼砸向目標，如果附近有水灘，會激發命中範圍內的水灘額外造成30%原威力的傷害，並水元素強化提高15%，持續20秒。",{"attributes":171,"type":173,"consume":174,"power":175},[172],"3",[22],"20","47",{"id":177,"type":144,"props":178},"91268483_33",{"id":179,"customKey":47,"icon":180,"iconStyle":64,"iconTitle":47,"descTitle":181,"descContent":182,"source":183},"91268483_34","/cdn/init/1019100_Skill_10300080_Icon.png","流水滾動","持續消耗體力並向前滾動撞擊目標，持續造成傷害並恢復體力，滾動結束時生成一個水灘，3秒內最多恢復一次體力。",{"attributes":184,"type":185,"consume":174,"power":186},[172],[22],"83",{"id":188,"title":189,"children":190},"91268483_35","固有技能",[191],{"id":192,"type":144,"props":193},"91268483_36",{"id":194,"customKey":47,"icon":195,"iconStyle":64,"iconTitle":47,"descTitle":196,"descContent":197,"source":198},"91268483_37","/cdn/init/1019100_Skill_10300000_Icon.png","攻擊","使用水元素能力，近距離攻擊目標。",{"attributes":199,"type":200,"consume":201,"power":202},[172],[22],"0","6",[204],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[206,217,228,238,250,260,270,282,292,302,312,323,333,344,354,365,376,386,396,406,416,426,436,447,457,467,477,487,497,507,517,527,537,547,557,567,577,588,598,608,618,628,638,648,658,668,678,688,698,708,718,728,737,741,748,757,767,777,787,797,807,817,827,837,847,857,867,877,887,897,907,917,927,937,947,957,967,977,987,997,1007,1017,1027,1037,1047,1057,1067,1077,1087,1097,1107,1117,1127,1138],{"id":207,"viewCount":58,"searchKey":208,"visible":15},"10003442",{"type":10,"entryId":209,"sortOrder":210,"name":211,"imageUrl":212,"description":213,"currentMorphology":13,"currentStage":22,"position":214,"attributes":215},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[216],"attributes-fire",{"id":218,"viewCount":58,"searchKey":219,"visible":15},"10003534",{"type":10,"entryId":220,"sortOrder":221,"name":222,"imageUrl":223,"description":224,"currentMorphology":13,"currentStage":225,"position":226,"attributes":227},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[24],[216],{"id":229,"viewCount":58,"searchKey":230,"visible":15},"10003435",{"type":10,"entryId":231,"sortOrder":232,"name":233,"imageUrl":234,"description":235,"currentMorphology":13,"currentStage":172,"position":236,"attributes":237},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[24],[216],{"id":239,"viewCount":58,"searchKey":240,"visible":15},"10003428",{"type":10,"entryId":241,"sortOrder":242,"name":243,"imageUrl":244,"description":245,"currentMorphology":13,"currentStage":172,"position":246,"attributes":248},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[247],"position-break",[216,249],"attributes-dark",{"id":251,"viewCount":58,"searchKey":252,"visible":15},"10003578",{"type":10,"entryId":253,"sortOrder":254,"name":255,"imageUrl":256,"description":257,"currentMorphology":13,"currentStage":22,"position":258,"attributes":259},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[249],{"id":261,"viewCount":58,"searchKey":262,"visible":15},"10003417",{"type":10,"entryId":263,"sortOrder":264,"name":265,"imageUrl":266,"description":267,"currentMorphology":13,"currentStage":172,"position":268,"attributes":269},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[249],{"id":271,"viewCount":58,"searchKey":272,"visible":15},"10003488",{"type":10,"entryId":273,"sortOrder":274,"name":275,"imageUrl":276,"description":277,"currentMorphology":13,"currentStage":22,"position":278,"attributes":280},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[279],"position-sup",[281],"attributes-wind",{"id":283,"viewCount":58,"searchKey":284,"visible":15},"10003548",{"type":10,"entryId":285,"sortOrder":286,"name":287,"imageUrl":288,"description":289,"currentMorphology":13,"currentStage":172,"position":290,"attributes":291},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[279],[281],{"id":293,"viewCount":58,"searchKey":294,"visible":15},"10003474",{"type":10,"entryId":295,"sortOrder":296,"name":297,"imageUrl":298,"description":299,"currentMorphology":13,"currentStage":172,"position":300,"attributes":301},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[281],{"id":303,"viewCount":58,"searchKey":304,"visible":15},"10003467",{"type":10,"entryId":305,"sortOrder":306,"name":307,"imageUrl":308,"description":309,"currentMorphology":13,"currentStage":172,"position":310,"attributes":311},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[247],[281],{"id":313,"viewCount":58,"searchKey":314,"visible":15},"10003392",{"type":10,"entryId":315,"sortOrder":316,"name":317,"imageUrl":318,"description":319,"currentMorphology":13,"currentStage":22,"position":320,"attributes":321},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[322],"attributes-grass",{"id":324,"viewCount":58,"searchKey":325,"visible":15},"10003510",{"type":10,"entryId":326,"sortOrder":327,"name":328,"imageUrl":329,"description":330,"currentMorphology":13,"currentStage":172,"position":331,"attributes":332},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[322],{"id":334,"viewCount":58,"searchKey":335,"visible":15},"10003477",{"type":10,"entryId":336,"sortOrder":337,"name":338,"imageUrl":339,"description":340,"currentMorphology":13,"currentStage":22,"position":341,"attributes":343},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[342],"position-heal",[26],{"id":345,"viewCount":58,"searchKey":346,"visible":15},"10003569",{"type":10,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":13,"currentStage":225,"position":352,"attributes":353},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[342],[26],{"id":355,"viewCount":58,"searchKey":356,"visible":15},"10003470",{"type":10,"entryId":357,"sortOrder":358,"name":359,"imageUrl":360,"description":361,"currentMorphology":13,"currentStage":172,"position":362,"attributes":363},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[342],[26,364],"attributes-ice",{"id":366,"viewCount":58,"searchKey":367,"visible":15},"10003463",{"type":10,"entryId":368,"sortOrder":369,"name":370,"imageUrl":371,"description":372,"currentMorphology":13,"currentStage":172,"position":373,"attributes":375},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[374],"position-energy",[322,26],{"id":377,"viewCount":58,"searchKey":378,"visible":15},"10003468",{"type":10,"entryId":379,"sortOrder":380,"name":381,"imageUrl":382,"description":383,"currentMorphology":13,"currentStage":22,"position":384,"attributes":385},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[279],[281],{"id":387,"viewCount":58,"searchKey":388,"visible":15},"10003365",{"type":10,"entryId":389,"sortOrder":390,"name":391,"imageUrl":392,"description":393,"currentMorphology":13,"currentStage":172,"position":394,"attributes":395},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[279],[281],{"id":397,"viewCount":58,"searchKey":398,"visible":15},"10003461",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":13,"currentStage":172,"position":404,"attributes":405},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[279],[249],{"id":407,"viewCount":58,"searchKey":408,"visible":15},"10003421",{"type":10,"entryId":409,"sortOrder":410,"name":411,"imageUrl":412,"description":413,"currentMorphology":13,"currentStage":22,"position":414,"attributes":415},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[247],[322],{"id":417,"viewCount":58,"searchKey":418,"visible":15},"10003414",{"type":10,"entryId":419,"sortOrder":420,"name":421,"imageUrl":422,"description":423,"currentMorphology":13,"currentStage":172,"position":424,"attributes":425},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[374],[249,322],{"id":427,"viewCount":58,"searchKey":428,"visible":15},"10003404",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":13,"currentStage":172,"position":434,"attributes":435},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[247],[322],{"id":437,"viewCount":58,"searchKey":438,"visible":15},"10003567",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":13,"currentStage":22,"position":444,"attributes":445},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[247],[446,322],"attributes-rock",{"id":448,"viewCount":58,"searchKey":449,"visible":15},"10003462",{"type":10,"entryId":450,"sortOrder":451,"name":452,"imageUrl":453,"description":454,"currentMorphology":13,"currentStage":172,"position":455,"attributes":456},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[247],[446,322],{"id":458,"viewCount":58,"searchKey":459,"visible":15},"10003551",{"type":10,"entryId":460,"sortOrder":461,"name":462,"imageUrl":463,"description":464,"currentMorphology":13,"currentStage":172,"position":465,"attributes":466},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[247],[364],{"id":468,"viewCount":58,"searchKey":469,"visible":15},"10003409",{"type":10,"entryId":470,"sortOrder":471,"name":472,"imageUrl":473,"description":474,"currentMorphology":13,"currentStage":22,"position":475,"attributes":476},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[374],[216],{"id":478,"viewCount":58,"searchKey":479,"visible":15},"10003507",{"type":10,"entryId":480,"sortOrder":481,"name":482,"imageUrl":483,"description":484,"currentMorphology":13,"currentStage":172,"position":485,"attributes":486},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[374],[216],{"id":488,"viewCount":58,"searchKey":489,"visible":15},"10003542",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":13,"currentStage":22,"position":495,"attributes":496},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[342],[281],{"id":498,"viewCount":58,"searchKey":499,"visible":15},"10003440",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":13,"currentStage":172,"position":505,"attributes":506},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[342],[281],{"id":508,"viewCount":58,"searchKey":509,"visible":15},"10003563",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":13,"currentStage":201,"position":515,"attributes":516},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[374],[281,322],{"id":518,"viewCount":58,"searchKey":519,"visible":15},"10003368",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":13,"currentStage":22,"position":525,"attributes":526},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[279],[281],{"id":528,"viewCount":58,"searchKey":529,"visible":15},"10003363",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":13,"currentStage":172,"position":535,"attributes":536},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[279],[281],{"id":538,"viewCount":58,"searchKey":539,"visible":15},"10003515",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":13,"currentStage":22,"position":545,"attributes":546},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[322],{"id":548,"viewCount":58,"searchKey":549,"visible":15},"10003496",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":13,"currentStage":172,"position":555,"attributes":556},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[24],[322],{"id":558,"viewCount":58,"searchKey":559,"visible":15},"10003378",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":13,"currentStage":172,"position":565,"attributes":566},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[279],[322],{"id":568,"viewCount":58,"searchKey":569,"visible":15},"10003456",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":13,"currentStage":22,"position":575,"attributes":576},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[247],[322],{"id":578,"viewCount":58,"searchKey":579,"visible":15},"10003374",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":13,"currentStage":172,"position":585,"attributes":586},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[279],[587],"attributes-electric",{"id":589,"viewCount":58,"searchKey":590,"visible":15},"10003443",{"type":10,"entryId":591,"sortOrder":592,"name":593,"imageUrl":594,"description":595,"currentMorphology":13,"currentStage":172,"position":596,"attributes":597},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[247],[322],{"id":599,"viewCount":58,"searchKey":600,"visible":15},"10003503",{"type":10,"entryId":601,"sortOrder":602,"name":603,"imageUrl":604,"description":605,"currentMorphology":13,"currentStage":22,"position":606,"attributes":607},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[279],[249],{"id":609,"viewCount":58,"searchKey":610,"visible":15},"10003521",{"type":10,"entryId":611,"sortOrder":612,"name":613,"imageUrl":614,"description":615,"currentMorphology":13,"currentStage":172,"position":616,"attributes":617},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[279],[249],{"id":619,"viewCount":58,"searchKey":620,"visible":15},"10003508",{"type":10,"entryId":621,"sortOrder":622,"name":623,"imageUrl":624,"description":625,"currentMorphology":13,"currentStage":22,"position":626,"attributes":627},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[249],{"id":629,"viewCount":58,"searchKey":630,"visible":15},"10003369",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":13,"currentStage":172,"position":636,"attributes":637},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[24],[249],{"id":639,"viewCount":58,"searchKey":640,"visible":15},"10003501",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":13,"currentStage":172,"position":646,"attributes":647},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[587],{"id":649,"viewCount":58,"searchKey":650,"visible":15},"10003422",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":13,"currentStage":22,"position":656,"attributes":657},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[364],{"id":659,"viewCount":58,"searchKey":660,"visible":15},"10003575",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":13,"currentStage":225,"position":666,"attributes":667},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[364],{"id":669,"viewCount":58,"searchKey":670,"visible":15},"10003415",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":13,"currentStage":172,"position":676,"attributes":677},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[24],[364],{"id":679,"viewCount":58,"searchKey":680,"visible":15},"10003524",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":13,"currentStage":22,"position":686,"attributes":687},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[247],[587],{"id":689,"viewCount":58,"searchKey":690,"visible":15},"10003475",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":13,"currentStage":172,"position":696,"attributes":697},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[247],[587],{"id":699,"viewCount":58,"searchKey":700,"visible":15},"10003523",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":13,"currentStage":22,"position":706,"attributes":707},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[247],[26],{"id":709,"viewCount":58,"searchKey":710,"visible":15},"10003398",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":13,"currentStage":225,"position":716,"attributes":717},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[247],[26],{"id":719,"viewCount":58,"searchKey":720,"visible":15},"10003516",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":13,"currentStage":172,"position":726,"attributes":727},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[279],[26],{"id":729,"viewCount":58,"searchKey":730,"visible":15},"10003566",{"type":10,"entryId":8,"sortOrder":731,"name":732,"imageUrl":733,"description":734,"currentMorphology":13,"currentStage":172,"position":735,"attributes":736},1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[247],[26],{"id":4,"viewCount":58,"searchKey":738,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":739,"attributes":740},[24],[26],{"id":6,"viewCount":58,"searchKey":742,"visible":15},{"type":10,"entryId":12,"sortOrder":743,"name":80,"imageUrl":744,"description":745,"currentMorphology":13,"currentStage":225,"position":746,"attributes":747},1019200,"/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[26],{"id":749,"viewCount":58,"searchKey":750,"visible":15},"10003570",{"type":10,"entryId":751,"sortOrder":752,"name":88,"imageUrl":753,"description":754,"currentMorphology":13,"currentStage":172,"position":755,"attributes":756},"056",1019400,"/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[26],{"id":758,"viewCount":58,"searchKey":759,"visible":15},"10003565",{"type":10,"entryId":760,"sortOrder":761,"name":762,"imageUrl":763,"description":764,"currentMorphology":13,"currentStage":22,"position":765,"attributes":766},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[24],[446],{"id":768,"viewCount":58,"searchKey":769,"visible":15},"10003476",{"type":10,"entryId":770,"sortOrder":771,"name":772,"imageUrl":773,"description":774,"currentMorphology":13,"currentStage":172,"position":775,"attributes":776},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[446],{"id":778,"viewCount":58,"searchKey":779,"visible":15},"10003466",{"type":10,"entryId":780,"sortOrder":781,"name":782,"imageUrl":783,"description":784,"currentMorphology":13,"currentStage":172,"position":785,"attributes":786},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[279],[446],{"id":788,"viewCount":58,"searchKey":789,"visible":15},"10003379",{"type":10,"entryId":790,"sortOrder":791,"name":792,"imageUrl":793,"description":794,"currentMorphology":13,"currentStage":22,"position":795,"attributes":796},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[24],[587],{"id":798,"viewCount":58,"searchKey":799,"visible":15},"10003376",{"type":10,"entryId":800,"sortOrder":801,"name":802,"imageUrl":803,"description":804,"currentMorphology":13,"currentStage":172,"position":805,"attributes":806},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[587],{"id":808,"viewCount":58,"searchKey":809,"visible":15},"10003543",{"type":10,"entryId":810,"sortOrder":811,"name":812,"imageUrl":813,"description":814,"currentMorphology":13,"currentStage":22,"position":815,"attributes":816},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[247],[249],{"id":818,"viewCount":58,"searchKey":819,"visible":15},"10003557",{"type":10,"entryId":820,"sortOrder":821,"name":822,"imageUrl":823,"description":824,"currentMorphology":13,"currentStage":172,"position":825,"attributes":826},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[249],{"id":828,"viewCount":58,"searchKey":829,"visible":15},"10003522",{"type":10,"entryId":830,"sortOrder":831,"name":832,"imageUrl":833,"description":834,"currentMorphology":13,"currentStage":172,"position":835,"attributes":836},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[247],[249],{"id":838,"viewCount":58,"searchKey":839,"visible":15},"10003579",{"type":10,"entryId":840,"sortOrder":841,"name":842,"imageUrl":843,"description":844,"currentMorphology":13,"currentStage":22,"position":845,"attributes":846},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[247],[281],{"id":848,"viewCount":58,"searchKey":849,"visible":15},"10003389",{"type":10,"entryId":850,"sortOrder":851,"name":852,"imageUrl":853,"description":854,"currentMorphology":13,"currentStage":225,"position":855,"attributes":856},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[247],[281],{"id":858,"viewCount":58,"searchKey":859,"visible":15},"10003536",{"type":10,"entryId":860,"sortOrder":861,"name":862,"imageUrl":863,"description":864,"currentMorphology":13,"currentStage":172,"position":865,"attributes":866},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[247],[281],{"id":868,"viewCount":58,"searchKey":869,"visible":15},"10003529",{"type":10,"entryId":870,"sortOrder":871,"name":872,"imageUrl":873,"description":874,"currentMorphology":13,"currentStage":172,"position":875,"attributes":876},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[24],[216],{"id":878,"viewCount":58,"searchKey":879,"visible":15},"10003433",{"type":10,"entryId":880,"sortOrder":881,"name":882,"imageUrl":883,"description":884,"currentMorphology":13,"currentStage":22,"position":885,"attributes":886},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[446],{"id":888,"viewCount":58,"searchKey":889,"visible":15},"10003427",{"type":10,"entryId":890,"sortOrder":891,"name":892,"imageUrl":893,"description":894,"currentMorphology":13,"currentStage":172,"position":895,"attributes":896},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[446],{"id":898,"viewCount":58,"searchKey":899,"visible":15},"10003405",{"type":10,"entryId":900,"sortOrder":901,"name":902,"imageUrl":903,"description":904,"currentMorphology":13,"currentStage":22,"position":905,"attributes":906},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[247],[446],{"id":908,"viewCount":58,"searchKey":909,"visible":15},"10003525",{"type":10,"entryId":910,"sortOrder":911,"name":912,"imageUrl":913,"description":914,"currentMorphology":13,"currentStage":225,"position":915,"attributes":916},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[247],[216,446],{"id":918,"viewCount":58,"searchKey":919,"visible":15},"10003399",{"type":10,"entryId":920,"sortOrder":921,"name":922,"imageUrl":923,"description":924,"currentMorphology":13,"currentStage":172,"position":925,"attributes":926},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[247],[216,446],{"id":928,"viewCount":58,"searchKey":929,"visible":15},"10003518",{"type":10,"entryId":930,"sortOrder":931,"name":932,"imageUrl":933,"description":934,"currentMorphology":13,"currentStage":225,"position":935,"attributes":936},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[247],[446],{"id":938,"viewCount":58,"searchKey":939,"visible":15},"10003393",{"type":10,"entryId":940,"sortOrder":941,"name":942,"imageUrl":943,"description":944,"currentMorphology":13,"currentStage":172,"position":945,"attributes":946},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[247],[446],{"id":948,"viewCount":58,"searchKey":949,"visible":15},"10003386",{"type":10,"entryId":950,"sortOrder":951,"name":952,"imageUrl":953,"description":954,"currentMorphology":13,"currentStage":22,"position":955,"attributes":956},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[279],[446],{"id":958,"viewCount":58,"searchKey":959,"visible":15},"10003447",{"type":10,"entryId":960,"sortOrder":961,"name":962,"imageUrl":963,"description":964,"currentMorphology":13,"currentStage":172,"position":965,"attributes":966},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[279],[446],{"id":968,"viewCount":58,"searchKey":969,"visible":15},"10003497",{"type":10,"entryId":970,"sortOrder":971,"name":972,"imageUrl":973,"description":974,"currentMorphology":13,"currentStage":22,"position":975,"attributes":976},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[279],[587],{"id":978,"viewCount":58,"searchKey":979,"visible":15},"10003479",{"type":10,"entryId":980,"sortOrder":981,"name":982,"imageUrl":983,"description":984,"currentMorphology":13,"currentStage":225,"position":985,"attributes":986},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[279],[587],{"id":988,"viewCount":58,"searchKey":989,"visible":15},"10003388",{"type":10,"entryId":990,"sortOrder":991,"name":992,"imageUrl":993,"description":994,"currentMorphology":13,"currentStage":172,"position":995,"attributes":996},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[279],[587],{"id":998,"viewCount":58,"searchKey":999,"visible":15},"10003429",{"type":10,"entryId":1000,"sortOrder":1001,"name":1002,"imageUrl":1003,"description":1004,"currentMorphology":13,"currentStage":22,"position":1005,"attributes":1006},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[374],[26],{"id":1008,"viewCount":58,"searchKey":1009,"visible":15},"10003430",{"type":10,"entryId":1010,"sortOrder":1011,"name":1012,"imageUrl":1013,"description":1014,"currentMorphology":13,"currentStage":172,"position":1015,"attributes":1016},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[374],[26],{"id":1018,"viewCount":58,"searchKey":1019,"visible":15},"10003549",{"type":10,"entryId":1020,"sortOrder":1021,"name":1022,"imageUrl":1023,"description":1024,"currentMorphology":13,"currentStage":201,"position":1025,"attributes":1026},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[374],[587],{"id":1028,"viewCount":58,"searchKey":1029,"visible":15},"10003494",{"type":10,"entryId":1030,"sortOrder":1031,"name":1032,"imageUrl":1033,"description":1034,"currentMorphology":13,"currentStage":22,"position":1035,"attributes":1036},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[374],[446,26],{"id":1038,"viewCount":58,"searchKey":1039,"visible":15},"10003486",{"type":10,"entryId":1040,"sortOrder":1041,"name":1042,"imageUrl":1043,"description":1044,"currentMorphology":13,"currentStage":172,"position":1045,"attributes":1046},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[374],[446,26],{"id":1048,"viewCount":58,"searchKey":1049,"visible":15},"10003530",{"type":10,"entryId":1050,"sortOrder":1051,"name":1052,"imageUrl":1053,"description":1054,"currentMorphology":13,"currentStage":22,"position":1055,"attributes":1056},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[247],[364],{"id":1058,"viewCount":58,"searchKey":1059,"visible":15},"10003457",{"type":10,"entryId":1060,"sortOrder":1061,"name":1062,"imageUrl":1063,"description":1064,"currentMorphology":13,"currentStage":172,"position":1065,"attributes":1066},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[247],[364],{"id":1068,"viewCount":58,"searchKey":1069,"visible":15},"10003423",{"type":10,"entryId":1070,"sortOrder":1071,"name":1072,"imageUrl":1073,"description":1074,"currentMorphology":13,"currentStage":22,"position":1075,"attributes":1076},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[342],[322,26],{"id":1078,"viewCount":58,"searchKey":1079,"visible":15},"10003419",{"type":10,"entryId":1080,"sortOrder":1081,"name":1082,"imageUrl":1083,"description":1084,"currentMorphology":13,"currentStage":172,"position":1085,"attributes":1086},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[342],[322,26],{"id":1088,"viewCount":58,"searchKey":1089,"visible":15},"10003410",{"type":10,"entryId":1090,"sortOrder":1091,"name":1092,"imageUrl":1093,"description":1094,"currentMorphology":13,"currentStage":22,"position":1095,"attributes":1096},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[26],{"id":1098,"viewCount":58,"searchKey":1099,"visible":15},"10003509",{"type":10,"entryId":1100,"sortOrder":1101,"name":1102,"imageUrl":1103,"description":1104,"currentMorphology":13,"currentStage":172,"position":1105,"attributes":1106},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[26],{"id":1108,"viewCount":58,"searchKey":1109,"visible":15},"10003413",{"type":10,"entryId":1110,"sortOrder":1111,"name":1112,"imageUrl":1113,"description":1114,"currentMorphology":13,"currentStage":22,"position":1115,"attributes":1116},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[364],{"id":1118,"viewCount":58,"searchKey":1119,"visible":15},"10003407",{"type":10,"entryId":1120,"sortOrder":1121,"name":1122,"imageUrl":1123,"description":1124,"currentMorphology":13,"currentStage":172,"position":1125,"attributes":1126},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[364],{"id":1128,"viewCount":58,"searchKey":1129,"visible":15},"10003498",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":13,"currentStage":201,"position":1135,"attributes":1136},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1137],"attributes-holy",{"id":1139,"viewCount":58,"searchKey":1140,"visible":15},"10003375",{"type":10,"entryId":1141,"sortOrder":1142,"name":1143,"imageUrl":1144,"description":1145,"currentMorphology":13,"currentStage":201,"position":1146,"attributes":1147},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1137],[1149,1157,1162,1167,1172,1177,1182,1187,1191