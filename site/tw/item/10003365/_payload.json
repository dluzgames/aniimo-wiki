成員提升6%%，持續15秒。若處於「雲霧繚繞」狀態，則為附近所有隊友施加效果，並使增益效果提升至11%%。",{"attributes":212,"type":214,"consume":202,"power":203},[213],"12",[201],{"id":216,"type":140,"props":217},"91268395_37",{"id":218,"customKey":46,"icon":219,"iconStyle":65,"iconTitle":46,"descTitle":220,"descContent":221,"source":222},"91268395_38","/cdn/init/1026200_Skill_10900250_Icon.png","雲彈","投擲雲凝聚成的飛彈攻擊目標，若自身處於「雲霧繚繞」狀態，則飛彈在命中目標後造成更大範圍的爆炸，造成250%威力的傷害。",{"attributes":223,"type":224,"consume":202,"power":203},[199],[201],{"id":226,"type":140,"props":227},"91268395_39",{"id":228,"customKey":46,"icon":229,"iconStyle":65,"iconTitle":46,"descTitle":230,"descContent":231,"source":232},"91268395_40","/cdn/init/1026200_Skill_10400290_Icon.png","雷彈","投擲由雷雲凝聚成的飛彈攻擊目標，若自身處於「雲霧繚繞」，則飛彈在命中目標後造成更大範圍的爆炸，造成250%威力的傷害。",{"attributes":233,"type":235,"consume":202,"power":203},[234],"4",[201],{"id":237,"type":140,"props":238},"91268395_41",{"id":239,"customKey":46,"icon":240,"iconStyle":65,"iconTitle":46,"descTitle":241,"descContent":242,"source":243},"91268395_42","/cdn/init/1026200_Skill_10900160_Icon.png","雲盾","施放雲盾保護自己，最多抵消15%最大生命值的傷害，並使體力消耗降低15%，持續20秒。若處於「雲霧繚繞」，護盾量提高至18%最大生命值，體力消耗降低至18%，持續30秒。",{"attributes":244,"type":245,"consume":247,"power":246},[199],[246],"0","20",{"id":249,"title":250,"children":251},"91268395_43","固有技能",[252,262],{"id":253,"type":140,"props":254},"91268395_44",{"id":255,"customKey":46,"icon":256,"iconStyle":65,"iconTitle":46,"descTitle":257,"descContent":258,"source":259},"91268395_45","/cdn/init/1026200_Skill_10900270_Icon.png","藏品大派送","蓬蓬羊打了個噴嚏，把羊毛裡的7個藏品抖出來，撿起藏品回復自身7%的生命值。",{"attributes":260,"type":261,"consume":246,"power":246},[199],[246],{"id":263,"type":140,"props":264},"91268395_46",{"id":265,"customKey":46,"icon":266,"iconStyle":65,"iconTitle":46,"descTitle":267,"descContent":268,"source":269},"91268395_47","/cdn/init/1026200_Skill_14400000_Icon.png","攻擊","使用風元素能力，遠距離攻擊目標。",{"attributes":270,"type":271,"consume":246,"power":272},[199],[201],"6",[274,275,276,279,282,284],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":277,"entryId":12,"currentMorphology":278,"visible":15},"10003568","Cloudmist Form",{"id":280,"entryId":12,"currentMorphology":281,"visible":15},"10003576","Prismana Form",{"id":283,"entryId":12,"currentMorphology":9,"visible":15},"10003572",{"id":285,"entryId":12,"currentMorphology":286,"visible":15},"10003552","Umbrabow Form",[288,301,311,321,333,343,353,363,373,383,393,404,414,426,436,447,458,466,470,479,489,499,509,520,530,540,550,560,570,580,590,600,610,620,630,640,650,661,671,681,691,701,711,721,731,741,751,761,771,781,791,801,811,821,831,841,851,861,871,881,891,901,911,921,931,941,951,961,971,981,991,1001,1011,1021,1031,1041,1051,1061,1071,1081,1091,1101,1111,1121,1131,1141,1151,1161,1171,1181,1191,1201,1211,1222],{"id":289,"viewCount":59,"searchKey":290,"visible":15},"10003442",{"type":10,"entryId":291,"sortOrder":292,"name":293,"imageUrl":294,"description":295,"currentMorphology":21,"currentStage":296,"position":297,"attributes":299},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。","1",[298],"position-dps",[300],"attributes-fire",{"id":302,"viewCount":59,"searchKey":303,"visible":15},"10003534",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":21,"currentStage":201,"position":309,"attributes":310},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[298],[300],{"id":312,"viewCount":59,"searchKey":313,"visible":15},"10003435",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":21,"currentStage":22,"position":319,"attributes":320},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[298],[300],{"id":322,"viewCount":59,"searchKey":323,"visible":15},"10003428",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":21,"currentStage":22,"position":329,"attributes":331},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[330],"position-break",[300,332],"attributes-dark",{"id":334,"viewCount":59,"searchKey":335,"visible":15},"10003578",{"type":10,"entryId":336,"sortOrder":337,"name":338,"imageUrl":339,"description":340,"currentMorphology":21,"currentStage":296,"position":341,"attributes":342},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[298],[332],{"id":344,"viewCount":59,"searchKey":345,"visible":15},"10003417",{"type":10,"entryId":346,"sortOrder":347,"name":348,"imageUrl":349,"description":350,"currentMorphology":21,"currentStage":22,"position":351,"attributes":352},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[298],[332],{"id":354,"viewCount":59,"searchKey":355,"visible":15},"10003488",{"type":10,"entryId":356,"sortOrder":357,"name":358,"imageUrl":359,"description":360,"currentMorphology":21,"currentStage":296,"position":361,"attributes":362},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[24],[26],{"id":364,"viewCount":59,"searchKey":365,"visible":15},"10003548",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":21,"currentStage":22,"position":371,"attributes":372},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[24],[26],{"id":374,"viewCount":59,"searchKey":375,"visible":15},"10003474",{"type":10,"entryId":376,"sortOrder":377,"name":378,"imageUrl":379,"description":380,"currentMorphology":21,"currentStage":22,"position":381,"attributes":382},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[298],[26],{"id":384,"viewCount":59,"searchKey":385,"visible":15},"10003467",{"type":10,"entryId":386,"sortOrder":387,"name":388,"imageUrl":389,"description":390,"currentMorphology":21,"currentStage":22,"position":391,"attributes":392},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[330],[26],{"id":394,"viewCount":59,"searchKey":395,"visible":15},"10003392",{"type":10,"entryId":396,"sortOrder":397,"name":398,"imageUrl":399,"description":400,"currentMorphology":21,"currentStage":296,"position":401,"attributes":402},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[298],[403],"attributes-grass",{"id":405,"viewCount":59,"searchKey":406,"visible":15},"10003510",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":21,"currentStage":22,"position":412,"attributes":413},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[298],[403],{"id":415,"viewCount":59,"searchKey":416,"visible":15},"10003477",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":21,"currentStage":296,"position":422,"attributes":424},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[423],"position-heal",[425],"attributes-water",{"id":427,"viewCount":59,"searchKey":428,"visible":15},"10003569",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":21,"currentStage":201,"position":434,"attributes":435},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[423],[425],{"id":437,"viewCount":59,"searchKey":438,"visible":15},"10003470",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":21,"currentStage":22,"position":444,"attributes":445},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[423],[425,446],"attributes-ice",{"id":448,"viewCount":59,"searchKey":449,"visible":15},"10003463",{"type":10,"entryId":450,"sortOrder":451,"name":452,"imageUrl":453,"description":454,"currentMorphology":21,"currentStage":22,"position":455,"attributes":457},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[456],"position-energy",[403,425],{"id":459,"viewCount":59,"searchKey":460,"visible":15},"10003468",{"type":10,"entryId":8,"sortOrder":461,"name":75,"imageUrl":462,"description":463,"currentMorphology":21,"currentStage":296,"position":464,"attributes":465},1026100,"/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[24],[26],{"id":4,"viewCount":59,"searchKey":467,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":468,"attributes":469},[24],[26],{"id":471,"viewCount":59,"searchKey":472,"visible":15},"10003461",{"type":10,"entryId":473,"sortOrder":474,"name":83,"imageUrl":475,"description":476,"currentMorphology":21,"currentStage":22,"position":477,"attributes":478},"020",1026300,"/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[24],[332],{"id":480,"viewCount":59,"searchKey":481,"visible":15},"10003421",{"type":10,"entryId":482,"sortOrder":483,"name":484,"imageUrl":485,"description":486,"currentMorphology":21,"currentStage":296,"position":487,"attributes":488},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[330],[403],{"id":490,"viewCount":59,"searchKey":491,"visible":15},"10003414",{"type":10,"entryId":492,"sortOrder":493,"name":494,"imageUrl":495,"description":496,"currentMorphology":21,"currentStage":22,"position":497,"attributes":498},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[456],[332,403],{"id":500,"viewCount":59,"searchKey":501,"visible":15},"10003404",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":21,"currentStage":22,"position":507,"attributes":508},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[330],[403],{"id":510,"viewCount":59,"searchKey":511,"visible":15},"10003567",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":21,"currentStage":296,"position":517,"attributes":518},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[330],[519,403],"attributes-rock",{"id":521,"viewCount":59,"searchKey":522,"visible":15},"10003462",{"type":10,"entryId":523,"sortOrder":524,"name":525,"imageUrl":526,"description":527,"currentMorphology":21,"currentStage":22,"position":528,"attributes":529},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[330],[519,403],{"id":531,"viewCount":59,"searchKey":532,"visible":15},"10003551",{"type":10,"entryId":533,"sortOrder":534,"name":535,"imageUrl":536,"description":537,"currentMorphology":21,"currentStage":22,"position":538,"attributes":539},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[330],[446],{"id":541,"viewCount":59,"searchKey":542,"visible":15},"10003409",{"type":10,"entryId":543,"sortOrder":544,"name":545,"imageUrl":546,"description":547,"currentMorphology":21,"currentStage":296,"position":548,"attributes":549},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[456],[300],{"id":551,"viewCount":59,"searchKey":552,"visible":15},"10003507",{"type":10,"entryId":553,"sortOrder":554,"name":555,"imageUrl":556,"description":557,"currentMorphology":21,"currentStage":22,"position":558,"attributes":559},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[456],[300],{"id":561,"viewCount":59,"searchKey":562,"visible":15},"10003542",{"type":10,"entryId":563,"sortOrder":564,"name":565,"imageUrl":566,"description":567,"currentMorphology":21,"currentStage":296,"position":568,"attributes":569},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[423],[26],{"id":571,"viewCount":59,"searchKey":572,"visible":15},"10003440",{"type":10,"entryId":573,"sortOrder":574,"name":575,"imageUrl":576,"description":577,"currentMorphology":21,"currentStage":22,"position":578,"attributes":579},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[423],[26],{"id":581,"viewCount":59,"searchKey":582,"visible":15},"10003563",{"type":10,"entryId":583,"sortOrder":584,"name":585,"imageUrl":586,"description":587,"currentMorphology":21,"currentStage":246,"position":588,"attributes":589},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[456],[26,403],{"id":591,"viewCount":59,"searchKey":592,"visible":15},"10003368",{"type":10,"entryId":593,"sortOrder":594,"name":595,"imageUrl":596,"description":597,"currentMorphology":21,"currentStage":296,"position":598,"attributes":599},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[24],[26],{"id":601,"viewCount":59,"searchKey":602,"visible":15},"10003363",{"type":10,"entryId":603,"sortOrder":604,"name":605,"imageUrl":606,"description":607,"currentMorphology":21,"currentStage":22,"position":608,"attributes":609},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[24],[26],{"id":611,"viewCount":59,"searchKey":612,"visible":15},"10003515",{"type":10,"entryId":613,"sortOrder":614,"name":615,"imageUrl":616,"description":617,"currentMorphology":21,"currentStage":296,"position":618,"attributes":619},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[298],[403],{"id":621,"viewCount":59,"searchKey":622,"visible":15},"10003496",{"type":10,"entryId":623,"sortOrder":624,"name":625,"imageUrl":626,"description":627,"currentMorphology":21,"currentStage":22,"position":628,"attributes":629},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[298],[403],{"id":631,"viewCount":59,"searchKey":632,"visible":15},"10003378",{"type":10,"entryId":633,"sortOrder":634,"name":635,"imageUrl":636,"description":637,"currentMorphology":21,"currentStage":22,"position":638,"attributes":639},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[24],[403],{"id":641,"viewCount":59,"searchKey":642,"visible":15},"10003456",{"type":10,"entryId":643,"sortOrder":644,"name":645,"imageUrl":646,"description":647,"currentMorphology":21,"currentStage":296,"position":648,"attributes":649},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[330],[403],{"id":651,"viewCount":59,"searchKey":652,"visible":15},"10003374",{"type":10,"entryId":653,"sortOrder":654,"name":655,"imageUrl":656,"description":657,"currentMorphology":21,"currentStage":22,"position":658,"attributes":659},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[24],[660],"attributes-electric",{"id":662,"viewCount":59,"searchKey":663,"visible":15},"10003443",{"type":10,"entryId":664,"sortOrder":665,"name":666,"imageUrl":667,"description":668,"currentMorphology":21,"currentStage":22,"position":669,"attributes":670},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[330],[403],{"id":672,"viewCount":59,"searchKey":673,"visible":15},"10003503",{"type":10,"entryId":674,"sortOrder":675,"name":676,"imageUrl":677,"description":678,"currentMorphology":21,"currentStage":296,"position":679,"attributes":680},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[24],[332],{"id":682,"viewCount":59,"searchKey":683,"visible":15},"10003521",{"type":10,"entryId":684,"sortOrder":685,"name":686,"imageUrl":687,"description":688,"currentMorphology":21,"currentStage":22,"position":689,"attributes":690},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[24],[332],{"id":692,"viewCount":59,"searchKey":693,"visible":15},"10003508",{"type":10,"entryId":694,"sortOrder":695,"name":696,"imageUrl":697,"description":698,"currentMorphology":21,"currentStage":296,"position":699,"attributes":700},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[298],[332],{"id":702,"viewCount":59,"searchKey":703,"visible":15},"10003369",{"type":10,"entryId":704,"sortOrder":705,"name":706,"imageUrl":707,"description":708,"currentMorphology":21,"currentStage":22,"position":709,"attributes":710},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[298],[332],{"id":712,"viewCount":59,"searchKey":713,"visible":15},"10003501",{"type":10,"entryId":714,"sortOrder":715,"name":716,"imageUrl":717,"description":718,"currentMorphology":21,"currentStage":22,"position":719,"attributes":720},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[298],[660],{"id":722,"viewCount":59,"searchKey":723,"visible":15},"10003422",{"type":10,"entryId":724,"sortOrder":725,"name":726,"imageUrl":727,"description":728,"currentMorphology":21,"currentStage":296,"position":729,"attributes":730},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[298],[446],{"id":732,"viewCount":59,"searchKey":733,"visible":15},"10003575",{"type":10,"entryId":734,"sortOrder":735,"name":736,"imageUrl":737,"description":738,"currentMorphology":21,"currentStage":201,"position":739,"attributes":740},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[298],[446],{"id":742,"viewCount":59,"searchKey":743,"visible":15},"10003415",{"type":10,"entryId":744,"sortOrder":745,"name":746,"imageUrl":747,"description":748,"currentMorphology":21,"currentStage":22,"position":749,"attributes":750},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[298],[446],{"id":752,"viewCount":59,"searchKey":753,"visible":15},"10003524",{"type":10,"entryId":754,"sortOrder":755,"name":756,"imageUrl":757,"description":758,"currentMorphology":21,"currentStage":296,"position":759,"attributes":760},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[330],[660],{"id":762,"viewCount":59,"searchKey":763,"visible":15},"10003475",{"type":10,"entryId":764,"sortOrder":765,"name":766,"imageUrl":767,"description":768,"currentMorphology":21,"currentStage":22,"position":769,"attributes":770},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[330],[660],{"id":772,"viewCount":59,"searchKey":773,"visible":15},"10003523",{"type":10,"entryId":774,"sortOrder":775,"name":776,"imageUrl":777,"description":778,"currentMorphology":21,"currentStage":296,"position":779,"attributes":780},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[330],[425],{"id":782,"viewCount":59,"searchKey":783,"visible":15},"10003398",{"type":10,"entryId":784,"sortOrder":785,"name":786,"imageUrl":787,"description":788,"currentMorphology":21,"currentStage":201,"position":789,"attributes":790},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[330],[425],{"id":792,"viewCount":59,"searchKey":793,"visible":15},"10003516",{"type":10,"entryId":794,"sortOrder":795,"name":796,"imageUrl":797,"description":798,"currentMorphology":21,"currentStage":22,"position":799,"attributes":800},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[24],[425],{"id":802,"viewCount":59,"searchKey":803,"visible":15},"10003566",{"type":10,"entryId":804,"sortOrder":805,"name":806,"imageUrl":807,"description":808,"currentMorphology":21,"currentStage":22,"position":809,"attributes":810},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[330],[425],{"id":812,"viewCount":59,"searchKey":813,"visible":15},"10003453",{"type":10,"entryId":814,"sortOrder":815,"name":816,"imageUrl":817,"description":818,"currentMorphology":21,"currentStage":296,"position":819,"attributes":820},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[298],[425],{"id":822,"viewCount":59,"searchKey":823,"visible":15},"10003577",{"type":10,"entryId":824,"sortOrder":825,"name":826,"imageUrl":827,"description":828,"currentMorphology":21,"currentStage":201,"position":829,"attributes":830},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[298],[425],{"id":832,"viewCount":59,"searchKey":833,"visible":15},"10003570",{"type":10,"entryId":834,"sortOrder":835,"name":836,"imageUrl":837,"description":838,"currentMorphology":21,"currentStage":22,"position":839,"attributes":840},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[298],[425],{"id":842,"viewCount":59,"searchKey":843,"visible":15},"10003565",{"type":10,"entryId":844,"sortOrder":845,"name":846,"imageUrl":847,"description":848,"currentMorphology":21,"currentStage":296,"position":849,"attributes":850},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[298],[519],{"id":852,"viewCount":59,"searchKey":853,"visible":15},"10003476",{"type":10,"entryId":854,"sortOrder":855,"name":856,"imageUrl":857,"description":858,"currentMorphology":21,"currentStage":22,"position":859,"attributes":860},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[298],[519],{"id":862,"viewCount":59,"searchKey":863,"visible":15},"10003466",{"type":10,"entryId":864,"sortOrder":865,"name":866,"imageUrl":867,"description":868,"currentMorphology":21,"currentStage":22,"position":869,"attributes":870},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[24],[519],{"id":872,"viewCount":59,"searchKey":873,"visible":15},"10003379",{"type":10,"entryId":874,"sortOrder":875,"name":876,"imageUrl":877,"description":878,"currentMorphology":21,"currentStage":296,"position":879,"attributes":880},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[298],[660],{"id":882,"viewCount":59,"searchKey":883,"visible":15},"10003376",{"type":10,"entryId":884,"sortOrder":885,"name":886,"imageUrl":887,"description":888,"currentMorphology":21,"currentStage":22,"position":889,"attributes":890},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[298],[660],{"id":892,"viewCount":59,"searchKey":893,"visible":15},"10003543",{"type":10,"entryId":894,"sortOrder":895,"name":896,"imageUrl":897,"description":898,"currentMorphology":21,"currentStage":296,"position":899,"attributes":900},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[330],[332],{"id":902,"viewCount":59,"searchKey":903,"visible":15},"10003557",{"type":10,"entryId":904,"sortOrder":905,"name":906,"imageUrl":907,"description":908,"currentMorphology":21,"currentStage":22,"position":909,"attributes":910},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[298],[332],{"id":912,"viewCount":59,"searchKey":913,"visible":15},"10003522",{"type":10,"entryId":914,"sortOrder":915,"name":916,"imageUrl":917,"description":918,"currentMorphology":21,"currentStage":22,"position":919,"attributes":920},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[330],[332],{"id":922,"viewCount":59,"searchKey":923,"visible":15},"10003579",{"type":10,"entryId":924,"sortOrder":925,"name":926,"imageUrl":927,"description":928,"currentMorphology":21,"currentStage":296,"position":929,"attributes":930},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[330],[26],{"id":932,"viewCount":59,"searchKey":933,"visible":15},"10003389",{"type":10,"entryId":934,"sortOrder":935,"name":936,"imageUrl":937,"description":938,"currentMorphology":21,"currentStage":201,"position":939,"attributes":940},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[330],[26],{"id":942,"viewCount":59,"searchKey":943,"visible":15},"10003536",{"type":10,"entryId":944,"sortOrder":945,"name":946,"imageUrl":947,"description":948,"currentMorphology":21,"currentStage":22,"position":949,"attributes":950},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[330],[26],{"id":952,"viewCount":59,"searchKey":953,"visible":15},"10003529",{"type":10,"entryId":954,"sortOrder":955,"name":956,"imageUrl":957,"description":958,"currentMorphology":21,"currentStage":22,"position":959,"attributes":960},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[298],[300],{"id":962,"viewCount":59,"searchKey":963,"visible":15},"10003433",{"type":10,"entryId":964,"sortOrder":965,"name":966,"imageUrl":967,"description":968,"currentMorphology":21,"currentStage":296,"position":969,"attributes":970},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[298],[519],{"id":972,"viewCount":59,"searchKey":973,"visible":15},"10003427",{"type":10,"entryId":974,"sortOrder":975,"name":976,"imageUrl":977,"description":978,"currentMorphology":21,"currentStage":22,"position":979,"attributes":980},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[298],[519],{"id":982,"viewCount":59,"searchKey":983,"visible":15},"10003405",{"type":10,"entryId":984,"sortOrder":985,"name":986,"imageUrl":987,"description":988,"currentMorphology":21,"currentStage":296,"position":989,"attributes":990},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[330],[519],{"id":992,"viewCount":59,"searchKey":993,"visible":15},"10003525",{"type":10,"entryId":994,"sortOrder":995,"name":996,"imageUrl":997,"description":998,"currentMorphology":21,"currentStage":201,"position":999,"attributes":1000},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[330],[300,519],{"id":1002,"viewCount":59,"searchKey":1003,"visible":15},"10003399",{"type":10,"entryId":1004,"sortOrder":1005,"name":1006,"imageUrl":1007,"description":1008,"currentMorphology":21,"currentStage":22,"position":1009,"attributes":1010},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[330],[300,519],{"id":1012,"viewCount":59,"searchKey":1013,"visible":15},"10003518",{"type":10,"entryId":1014,"sortOrder":1015,"name":1016,"imageUrl":1017,"description":1018,"currentMorphology":21,"currentStage":201,"position":1019,"attributes":1020},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[330],[519],{"id":1022,"viewCount":59,"searchKey":1023,"visible":15},"10003393",{"type":10,"entryId":1024,"sortOrder":1025,"name":1026,"imageUrl":1027,"description":1028,"currentMorphology":21,"currentStage":22,"position":1029,"attributes":1030},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[330],[519],{"id":1032,"viewCount":59,"searchKey":1033,"visible":15},"10003386",{"type":10,"entryId":1034,"sortOrder":1035,"name":1036,"imageUrl":1037,"description":1038,"currentMorphology":21,"currentStage":296,"position":1039,"attributes":1040},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[24],[519],{"id":1042,"viewCount":59,"searchKey":1043,"visible":15},"10003447",{"type":10,"entryId":1044,"sortOrder":1045,"name":1046,"imageUrl":1047,"description":1048,"currentMorphology":21,"currentStage":22,"position":1049,"attributes":1050},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[24],[519],{"id":1052,"viewCount":59,"searchKey":1053,"visible":15},"10003497",{"type":10,"entryId":1054,"sortOrder":1055,"name":1056,"imageUrl":1057,"description":1058,"currentMorphology":21,"currentStage":296,"position":1059,"attributes":1060},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[24],[660],{"id":1062,"viewCount":59,"searchKey":1063,"visible":15},"10003479",{"type":10,"entryId":1064,"sortOrder":1065,"name":1066,"imageUrl":1067,"description":1068,"currentMorphology":21,"currentStage":201,"position":1069,"attributes":1070},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[24],[660],{"id":1072,"viewCount":59,"searchKey":1073,"visible":15},"10003388",{"type":10,"entryId":1074,"sortOrder":1075,"name":1076,"imageUrl":1077,"description":1078,"currentMorphology":21,"currentStage":22,"position":1079,"attributes":1080},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[24],[660],{"id":1082,"viewCount":59,"searchKey":1083,"visible":15},"10003429",{"type":10,"entryId":1084,"sortOrder":1085,"name":1086,"imageUrl":1087,"description":1088,"currentMorphology":21,"currentStage":296,"position":1089,"attributes":1090},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[456],[425],{"id":1092,"viewCount":59,"searchKey":1093,"visible":15},"10003430",{"type":10,"entryId":1094,"sortOrder":1095,"name":1096,"imageUrl":1097,"description":1098,"currentMorphology":21,"currentStage":22,"position":1099,"attributes":1100},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[456],[425],{"id":1102,"viewCount":59,"searchKey":1103,"visible":15},"10003549",{"type":10,"entryId":1104,"sortOrder":1105,"name":1106,"imageUrl":1107,"description":1108,"currentMorphology":21,"currentStage":246,"position":1109,"attributes":1110},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[456],[660],{"id":1112,"viewCount":59,"searchKey":1113,"visible":15},"10003494",{"type":10,"entryId":1114,"sortOrder":1115,"name":1116,"imageUrl":1117,"description":1118,"currentMorphology":21,"currentStage":296,"position":1119,"attributes":1120},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[456],[519,425],{"id":1122,"viewCount":59,"searchKey":1123,"visible":15},"10003486",{"type":10,"entryId":1124,"sortOrder":1125,"name":1126,"imageUrl":1127,"description":1128,"currentMorphology":21,"currentStage":22,"position":1129,"attributes":1130},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[456],[519,425],{"id":1132,"viewCount":59,"searchKey":1133,"visible":15},"10003530",{"type":10,"entryId":1134,"sortOrder":1135,"name":1136,"imageUrl":1137,"description":1138,"currentMorphology":21,"currentStage":296,"position":1139,"attributes":1140},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[330],[446],{"id":1142,"viewCount":59,"searchKey":1143,"visible":15},"10003457",{"type":10,"entryId":1144,"sortOrder":1145,"name":1146,"imageUrl":1147,"description":1148,"currentMorphology":21,"currentStage":22,"position":1149,"attributes":1150},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[330],[446],{"id":1152,"viewCount":59,"searchKey":1153,"visible":15},"10003423",{"type":10,"entryId":1154,"sortOrder":1155,"name":1156,"imageUrl":1157,"description":1158,"currentMorphology":21,"currentStage":296,"position":1159,"attributes":1160},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[423],[403,425],{"id":1162,"viewCount":59,"searchKey":1163,"visible":15},"10003419",{"type":10,"entryId":1164,"sortOrder":1165,"name":1166,"imageUrl":1167,"description":1168,"currentMorphology":21,"currentStage":22,"position":1169,"attributes":1170},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[423],[403,425],{"id":1172,"viewCount":59,"searchKey":1173,"visible":15},"10003410",{"type":10,"entryId":1174,"sortOrder":1175,"name":1176,"imageUrl":1177,"description":1178,"currentMorphology":21,"currentStage":296,"position":1179,"attributes":1180},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[298],[425],{"id":1182,"viewCount":59,"searchKey":1183,"visible":15},"10003509",{"type":10,"entryId":1184,"sortOrder":1185,"name":1186,"imageUrl":1187,"description":1188,"currentMorphology":21,"currentStage":22,"position":1189,"attributes":1190},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[298],[425],{"id":1192,"viewCount":59,"searchKey":1193,"visible":15},"10003413",{"type":10,"entryId":1194,"sortOrder":1195,"name":1196,"imageUrl":1197,"description":1198,"currentMorphology":21,"currentStage":296,"position":1199,"attributes":1200},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[298],[446],{"id":1202,"viewCount":59,"searchKey":1203,"visible":15},"10003407",{"type":10,"entryId":1204,"sortOrder":1205,"name":1206,"imageUrl":1207,"description":1208,"currentMorphology":21,"currentStage":22,"position":1209,"attributes":1210},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[298],[446],{"id":1212,"viewCount":59,"searchKey":1213,"visible":15},"10003498",{"type":10,"entryId":1214,"sortOrder":1215,"name":1216,"imageUrl":1217,"description":1218,"currentMorphology":21,"currentStage":246,"position":1219,"attributes":1220},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[298],[1221],"attributes-holy",{"id":1223,"viewCount":59,"searchKey":1224,"visible":15},"10003375",{"type":10,"entryId":1225,"sortOrder":1226,"name":1227,"imageUrl":1228,"description":1229,"currentMorphology":21,"currentStage":246,"position":1230,"attributes":1231},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[298],[1221],[1233,1241,1246,1251,1255,1260,1264,1269,1272,1275,1280,1285,1289,1294,1299,1304,1309,1314,1317],{"id":1234,"parentId":1235,"tagType":1236,"tagKey":1237,"name":1238,"language":1239,"sort":1240},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1242,"parentId":1235,"tagType":1236,"tagKey":1243,"name":1244,"language":1239,"sort":1245},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1247,"parentId":1235,"tagType":1236,"tagKey":1248,"name":1249,"language":1239,"sort":1250},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1252,"parentId":1235,"tagType":1236,"tagKey":278,"name":1253,"language":1239,"sort":1254},"48eb29eb0654bfdfc12604830648a909","雲海型態",18,{"id":1256,"parentId":1235,"tagType":1236,"tagKey":1257,"name":1258,"language":1239,"sort":1259},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1261,"parentId":1235,"tagType":1236,"tagKey":9,"name":1262,"language":1239,"sort":1263},"5264fcf4157b04e2ba108f70d7b10d07","高原型態",17,{"id":1265,"parentId":1235,"tagType":1236,"tagKey":1266,"name":1267,"language":1239,"sort":1268},"568127bc77f184cd4308056381642df7","Snowfield Form