特性","91268447_24",[145],{"id":146,"type":131,"props":147,"children":57},"91268447_25",{"id":148,"customKey":45,"icon":149,"iconStyle":63,"iconTitle":45,"descTitle":150,"descContent":151,"source":152},"91268447_26","/cdn/init/1001200_Feature_10175_Icon.png","雙重打擊","施放技能結束後的5秒內，普攻命中目標時，額外造成一次5威力的傷害。",{"attributes":153,"type":154,"consume":45,"power":45},[],[],{"id":156,"type":60,"props":157,"children":57},"91268447_27",{"title":158,"type":63,"id":159,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":65,"tabs":160},"技能介紹","91268447_28",[161,221],{"id":162,"title":163,"children":164},"91268447_29","戰鬥技能",[165,178,190,200,211],{"id":166,"type":131,"props":167},"91268447_30",{"id":168,"customKey":45,"icon":169,"iconStyle":63,"iconTitle":45,"descTitle":170,"descContent":171,"source":172},"91268447_31","/cdn/init/1001200_Skill_11100040_Icon.png","分身戲碼","立即解控，快速後撤和目標拉開距離，同時在原地留下分身，持續20秒。分身無法被攻擊並會模仿本體的普攻和技能，造成本體20%的傷害。再次施放技能本體會和分身互換位置，本體與分身距離超過20米後分身銷毀。",{"attributes":173,"type":175,"consume":177,"power":176},[174],"12",[176],"0","20",{"id":179,"type":131,"props":180},"91268447_32",{"id":181,"customKey":45,"icon":182,"iconStyle":63,"iconTitle":45,"descTitle":183,"descContent":184,"source":185},"91268447_33","/cdn/init/1001200_Skill_10200250_Icon.png","冰星滑翔","一邊飛行一邊掉落冰元素星星攻擊目標造成傷害。命中同一個目標3次，自身能量回復速度提升10%，持續10秒。使用技能後4秒內可以邊移動邊發動攻擊。",{"attributes":186,"type":188,"consume":177,"power":189},[187],"2",[187],"74",{"id":191,"type":131,"props":192},"91268447_34",{"id":193,"customKey":45,"icon":194,"iconStyle":63,"iconTitle":45,"descTitle":195,"descContent":196,"source":197},"91268447_35","/cdn/init/1001200_Skill_11100024_Icon.png","流星滑翔","一邊飛行一邊掉落星星攻擊目標造成傷害。命中同一個目標3次，自身能量回復速度提升10%，持續10秒。使用技能4秒後可以在移動中發動攻擊。",{"attributes":198,"type":199,"consume":177,"power":189},[174],[187],{"id":201,"type":131,"props":202},"91268447_36",{"id":203,"customKey":45,"icon":204,"iconStyle":63,"iconTitle":45,"descTitle":205,"descContent":206,"source":207},"91268447_37","/cdn/init/1001200_Skill_11100030_Icon.png","飛星","發射3顆會追蹤的星星，每顆星星對目標造成傷害時，獲得1%增傷，最多疊加15層。",{"attributes":208,"type":209,"consume":177,"power":210},[174],[187],"40",{"id":212,"type":131,"props":213},"91268447_38",{"id":214,"customKey":45,"icon":215,"iconStyle":63,"iconTitle":45,"descTitle":216,"descContent":217,"source":218},"91268447_39","/cdn/init/1001200_Skill_10301020_Icon.png","水星滑翔","一邊飛行一邊掉落水元素星星攻擊目標造成傷害。命中同一個目標3次，自身能量回復速度提高10%，持續10秒。使用技能後4秒內可以邊移動邊發動攻擊。",{"attributes":219,"type":220,"consume":177,"power":189},[21],[187],{"id":222,"title":223,"children":224},"91268447_40","固有技能",[225,236],{"id":226,"type":131,"props":227},"91268447_41",{"id":228,"customKey":45,"icon":229,"iconStyle":63,"iconTitle":45,"descTitle":230,"descContent":231,"source":232},"91268447_42","/cdn/init/1001200_Skill_11100070_Icon.png","金色隕星","召喚大量的彗星從天而降，攻擊目標，造成高額傷害。",{"attributes":233,"type":234,"consume":176,"power":235},[174],[187],"166",{"id":237,"type":131,"props":238},"91268447_43",{"id":239,"customKey":45,"icon":240,"iconStyle":63,"iconTitle":45,"descTitle":241,"descContent":242,"source":243},"91268447_44","/cdn/init/1001200_Skill_14500000_Icon.png","攻擊","使用暗元素能力，遠距離攻擊目標。",{"attributes":244,"type":245,"consume":176,"power":246},[174],[187],"6",[248,249,250,253],{"id":4,"entryId":12,"currentMorphology":9,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":251,"entryId":12,"currentMorphology":252,"visible":15},"10003441","Prismana Form",{"id":254,"entryId":12,"currentMorphology":255,"visible":15},"10003445","Umbrabow Form",[257,269,279,289,300,307,311,323,333,343,353,364,374,386,396,407,418,428,438,448,458,468,478,489,499,509,519,529,539,549,559,569,579,589,599,609,619,630,640,650,660,670,680,690,700,710,720,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1130,1140,1150,1160,1170,1180,1191],{"id":258,"viewCount":57,"searchKey":259,"visible":15},"10003442",{"type":10,"entryId":260,"sortOrder":261,"name":262,"imageUrl":263,"description":264,"currentMorphology":9,"currentStage":265,"position":266,"attributes":267},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。","1",[23],[268],"attributes-fire",{"id":270,"viewCount":57,"searchKey":271,"visible":15},"10003534",{"type":10,"entryId":272,"sortOrder":273,"name":274,"imageUrl":275,"description":276,"currentMorphology":9,"currentStage":187,"position":277,"attributes":278},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[268],{"id":280,"viewCount":57,"searchKey":281,"visible":15},"10003435",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":9,"currentStage":21,"position":287,"attributes":288},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[23],[268],{"id":290,"viewCount":57,"searchKey":291,"visible":15},"10003428",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":9,"currentStage":21,"position":297,"attributes":299},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[298],"position-break",[268,25],{"id":5,"viewCount":57,"searchKey":301,"visible":15},{"type":10,"entryId":8,"sortOrder":302,"name":73,"imageUrl":303,"description":304,"currentMorphology":9,"currentStage":265,"position":305,"attributes":306},1001100,"/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[25],{"id":4,"viewCount":57,"searchKey":308,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":309,"attributes":310},[23],[25],{"id":312,"viewCount":57,"searchKey":313,"visible":15},"10003488",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":9,"currentStage":265,"position":319,"attributes":321},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[320],"position-sup",[322],"attributes-wind",{"id":324,"viewCount":57,"searchKey":325,"visible":15},"10003548",{"type":10,"entryId":326,"sortOrder":327,"name":328,"imageUrl":329,"description":330,"currentMorphology":9,"currentStage":21,"position":331,"attributes":332},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[320],[322],{"id":334,"viewCount":57,"searchKey":335,"visible":15},"10003474",{"type":10,"entryId":336,"sortOrder":337,"name":338,"imageUrl":339,"description":340,"currentMorphology":9,"currentStage":21,"position":341,"attributes":342},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[322],{"id":344,"viewCount":57,"searchKey":345,"visible":15},"10003467",{"type":10,"entryId":346,"sortOrder":347,"name":348,"imageUrl":349,"description":350,"currentMorphology":9,"currentStage":21,"position":351,"attributes":352},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[298],[322],{"id":354,"viewCount":57,"searchKey":355,"visible":15},"10003392",{"type":10,"entryId":356,"sortOrder":357,"name":358,"imageUrl":359,"description":360,"currentMorphology":9,"currentStage":265,"position":361,"attributes":362},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[363],"attributes-grass",{"id":365,"viewCount":57,"searchKey":366,"visible":15},"10003510",{"type":10,"entryId":367,"sortOrder":368,"name":369,"imageUrl":370,"description":371,"currentMorphology":9,"currentStage":21,"position":372,"attributes":373},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[363],{"id":375,"viewCount":57,"searchKey":376,"visible":15},"10003477",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":9,"currentStage":265,"position":382,"attributes":384},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[383],"position-heal",[385],"attributes-water",{"id":387,"viewCount":57,"searchKey":388,"visible":15},"10003569",{"type":10,"entryId":389,"sortOrder":390,"name":391,"imageUrl":392,"description":393,"currentMorphology":9,"currentStage":187,"position":394,"attributes":395},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[383],[385],{"id":397,"viewCount":57,"searchKey":398,"visible":15},"10003470",{"type":10,"entryId":399,"sortOrder":400,"name":401,"imageUrl":402,"description":403,"currentMorphology":9,"currentStage":21,"position":404,"attributes":405},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[383],[385,406],"attributes-ice",{"id":408,"viewCount":57,"searchKey":409,"visible":15},"10003463",{"type":10,"entryId":410,"sortOrder":411,"name":412,"imageUrl":413,"description":414,"currentMorphology":9,"currentStage":21,"position":415,"attributes":417},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[416],"position-energy",[363,385],{"id":419,"viewCount":57,"searchKey":420,"visible":15},"10003468",{"type":10,"entryId":421,"sortOrder":422,"name":423,"imageUrl":424,"description":425,"currentMorphology":9,"currentStage":265,"position":426,"attributes":427},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[320],[322],{"id":429,"viewCount":57,"searchKey":430,"visible":15},"10003365",{"type":10,"entryId":431,"sortOrder":432,"name":433,"imageUrl":434,"description":435,"currentMorphology":9,"currentStage":21,"position":436,"attributes":437},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[320],[322],{"id":439,"viewCount":57,"searchKey":440,"visible":15},"10003461",{"type":10,"entryId":441,"sortOrder":442,"name":443,"imageUrl":444,"description":445,"currentMorphology":9,"currentStage":21,"position":446,"attributes":447},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[320],[25],{"id":449,"viewCount":57,"searchKey":450,"visible":15},"10003421",{"type":10,"entryId":451,"sortOrder":452,"name":453,"imageUrl":454,"description":455,"currentMorphology":9,"currentStage":265,"position":456,"attributes":457},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[298],[363],{"id":459,"viewCount":57,"searchKey":460,"visible":15},"10003414",{"type":10,"entryId":461,"sortOrder":462,"name":463,"imageUrl":464,"description":465,"currentMorphology":9,"currentStage":21,"position":466,"attributes":467},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[416],[25,363],{"id":469,"viewCount":57,"searchKey":470,"visible":15},"10003404",{"type":10,"entryId":471,"sortOrder":472,"name":473,"imageUrl":474,"description":475,"currentMorphology":9,"currentStage":21,"position":476,"attributes":477},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[298],[363],{"id":479,"viewCount":57,"searchKey":480,"visible":15},"10003567",{"type":10,"entryId":481,"sortOrder":482,"name":483,"imageUrl":484,"description":485,"currentMorphology":9,"currentStage":265,"position":486,"attributes":487},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[298],[488,363],"attributes-rock",{"id":490,"viewCount":57,"searchKey":491,"visible":15},"10003462",{"type":10,"entryId":492,"sortOrder":493,"name":494,"imageUrl":495,"description":496,"currentMorphology":9,"currentStage":21,"position":497,"attributes":498},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[298],[488,363],{"id":500,"viewCount":57,"searchKey":501,"visible":15},"10003551",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":9,"currentStage":21,"position":507,"attributes":508},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[298],[406],{"id":510,"viewCount":57,"searchKey":511,"visible":15},"10003409",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":9,"currentStage":265,"position":517,"attributes":518},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[416],[268],{"id":520,"viewCount":57,"searchKey":521,"visible":15},"10003507",{"type":10,"entryId":522,"sortOrder":523,"name":524,"imageUrl":525,"description":526,"currentMorphology":9,"currentStage":21,"position":527,"attributes":528},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[416],[268],{"id":530,"viewCount":57,"searchKey":531,"visible":15},"10003542",{"type":10,"entryId":532,"sortOrder":533,"name":534,"imageUrl":535,"description":536,"currentMorphology":9,"currentStage":265,"position":537,"attributes":538},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[383],[322],{"id":540,"viewCount":57,"searchKey":541,"visible":15},"10003440",{"type":10,"entryId":542,"sortOrder":543,"name":544,"imageUrl":545,"description":546,"currentMorphology":9,"currentStage":21,"position":547,"attributes":548},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[383],[322],{"id":550,"viewCount":57,"searchKey":551,"visible":15},"10003563",{"type":10,"entryId":552,"sortOrder":553,"name":554,"imageUrl":555,"description":556,"currentMorphology":9,"currentStage":176,"position":557,"attributes":558},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[416],[322,363],{"id":560,"viewCount":57,"searchKey":561,"visible":15},"10003368",{"type":10,"entryId":562,"sortOrder":563,"name":564,"imageUrl":565,"description":566,"currentMorphology":9,"currentStage":265,"position":567,"attributes":568},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[320],[322],{"id":570,"viewCount":57,"searchKey":571,"visible":15},"10003363",{"type":10,"entryId":572,"sortOrder":573,"name":574,"imageUrl":575,"description":576,"currentMorphology":9,"currentStage":21,"position":577,"attributes":578},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[320],[322],{"id":580,"viewCount":57,"searchKey":581,"visible":15},"10003515",{"type":10,"entryId":582,"sortOrder":583,"name":584,"imageUrl":585,"description":586,"currentMorphology":9,"currentStage":265,"position":587,"attributes":588},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[363],{"id":590,"viewCount":57,"searchKey":591,"visible":15},"10003496",{"type":10,"entryId":592,"sortOrder":593,"name":594,"imageUrl":595,"description":596,"currentMorphology":9,"currentStage":21,"position":597,"attributes":598},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[363],{"id":600,"viewCount":57,"searchKey":601,"visible":15},"10003378",{"type":10,"entryId":602,"sortOrder":603,"name":604,"imageUrl":605,"description":606,"currentMorphology":9,"currentStage":21,"position":607,"attributes":608},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[320],[363],{"id":610,"viewCount":57,"searchKey":611,"visible":15},"10003456",{"type":10,"entryId":612,"sortOrder":613,"name":614,"imageUrl":615,"description":616,"currentMorphology":9,"currentStage":265,"position":617,"attributes":618},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[298],[363],{"id":620,"viewCount":57,"searchKey":621,"visible":15},"10003374",{"type":10,"entryId":622,"sortOrder":623,"name":624,"imageUrl":625,"description":626,"currentMorphology":9,"currentStage":21,"position":627,"attributes":628},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[320],[629],"attributes-electric",{"id":631,"viewCount":57,"searchKey":632,"visible":15},"10003443",{"type":10,"entryId":633,"sortOrder":634,"name":635,"imageUrl":636,"description":637,"currentMorphology":9,"currentStage":21,"position":638,"attributes":639},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[298],[363],{"id":641,"viewCount":57,"searchKey":642,"visible":15},"10003503",{"type":10,"entryId":643,"sortOrder":644,"name":645,"imageUrl":646,"description":647,"currentMorphology":9,"currentStage":265,"position":648,"attributes":649},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[320],[25],{"id":651,"viewCount":57,"searchKey":652,"visible":15},"10003521",{"type":10,"entryId":653,"sortOrder":654,"name":655,"imageUrl":656,"description":657,"currentMorphology":9,"currentStage":21,"position":658,"attributes":659},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[320],[25],{"id":661,"viewCount":57,"searchKey":662,"visible":15},"10003508",{"type":10,"entryId":663,"sortOrder":664,"name":665,"imageUrl":666,"description":667,"currentMorphology":9,"currentStage":265,"position":668,"attributes":669},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[25],{"id":671,"viewCount":57,"searchKey":672,"visible":15},"10003369",{"type":10,"entryId":673,"sortOrder":674,"name":675,"imageUrl":676,"description":677,"currentMorphology":9,"currentStage":21,"position":678,"attributes":679},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[25],{"id":681,"viewCount":57,"searchKey":682,"visible":15},"10003501",{"type":10,"entryId":683,"sortOrder":684,"name":685,"imageUrl":686,"description":687,"currentMorphology":9,"currentStage":21,"position":688,"attributes":689},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[629],{"id":691,"viewCount":57,"searchKey":692,"visible":15},"10003422",{"type":10,"entryId":693,"sortOrder":694,"name":695,"imageUrl":696,"description":697,"currentMorphology":9,"currentStage":265,"position":698,"attributes":699},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[406],{"id":701,"viewCount":57,"searchKey":702,"visible":15},"10003575",{"type":10,"entryId":703,"sortOrder":704,"name":705,"imageUrl":706,"description":707,"currentMorphology":9,"currentStage":187,"position":708,"attributes":709},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[406],{"id":711,"viewCount":57,"searchKey":712,"visible":15},"10003415",{"type":10,"entryId":713,"sortOrder":714,"name":715,"imageUrl":716,"description":717,"currentMorphology":9,"currentStage":21,"position":718,"attributes":719},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[406],{"id":721,"viewCount":57,"searchKey":722,"visible":15},"10003524",{"type":10,"entryId":723,"sortOrder":724,"name":725,"imageUrl":726,"description":727,"currentMorphology":9,"currentStage":265,"position":728,"attributes":729},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[298],[629],{"id":731,"viewCount":57,"searchKey":732,"visible":15},"10003475",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":9,"currentStage":21,"position":738,"attributes":739},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[298],[629],{"id":741,"viewCount":57,"searchKey":742,"visible":15},"10003523",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":9,"currentStage":265,"position":748,"attributes":749},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[298],[385],{"id":751,"viewCount":57,"searchKey":752,"visible":15},"10003398",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":9,"currentStage":187,"position":758,"attributes":759},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[298],[385],{"id":761,"viewCount":57,"searchKey":762,"visible":15},"10003516",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":9,"currentStage":21,"position":768,"attributes":769},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[320],[385],{"id":771,"viewCount":57,"searchKey":772,"visible":15},"10003566",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":9,"currentStage":21,"position":778,"attributes":779},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[298],[385],{"id":781,"viewCount":57,"searchKey":782,"visible":15},"10003453",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":9,"currentStage":265,"position":788,"attributes":789},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[385],{"id":791,"viewCount":57,"searchKey":792,"visible":15},"10003577",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":9,"currentStage":187,"position":798,"attributes":799},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[385],{"id":801,"viewCount":57,"searchKey":802,"visible":15},"10003570",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":9,"currentStage":21,"position":808,"attributes":809},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[385],{"id":811,"viewCount":57,"searchKey":812,"visible":15},"10003565",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":9,"currentStage":265,"position":818,"attributes":819},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[488],{"id":821,"viewCount":57,"searchKey":822,"visible":15},"10003476",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":9,"currentStage":21,"position":828,"attributes":829},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[488],{"id":831,"viewCount":57,"searchKey":832,"visible":15},"10003466",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":9,"currentStage":21,"position":838,"attributes":839},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[320],[488],{"id":841,"viewCount":57,"searchKey":842,"visible":15},"10003379",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":9,"currentStage":265,"position":848,"attributes":849},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[629],{"id":851,"viewCount":57,"searchKey":852,"visible":15},"10003376",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":9,"currentStage":21,"position":858,"attributes":859},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[629],{"id":861,"viewCount":57,"searchKey":862,"visible":15},"10003543",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":9,"currentStage":265,"position":868,"attributes":869},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[298],[25],{"id":871,"viewCount":57,"searchKey":872,"visible":15},"10003557",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":9,"currentStage":21,"position":878,"attributes":879},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[25],{"id":881,"viewCount":57,"searchKey":882,"visible":15},"10003522",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":9,"currentStage":21,"position":888,"attributes":889},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[298],[25],{"id":891,"viewCount":57,"searchKey":892,"visible":15},"10003579",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":9,"currentStage":265,"position":898,"attributes":899},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[298],[322],{"id":901,"viewCount":57,"searchKey":902,"visible":15},"10003389",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":9,"currentStage":187,"position":908,"attributes":909},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[298],[322],{"id":911,"viewCount":57,"searchKey":912,"visible":15},"10003536",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":9,"currentStage":21,"position":918,"attributes":919},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[298],[322],{"id":921,"viewCount":57,"searchKey":922,"visible":15},"10003529",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":9,"currentStage":21,"position":928,"attributes":929},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[268],{"id":931,"viewCount":57,"searchKey":932,"visible":15},"10003433",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":9,"currentStage":265,"position":938,"attributes":939},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[488],{"id":941,"viewCount":57,"searchKey":942,"visible":15},"10003427",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":9,"currentStage":21,"position":948,"attributes":949},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[488],{"id":951,"viewCount":57,"searchKey":952,"visible":15},"10003405",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":9,"currentStage":265,"position":958,"attributes":959},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[298],[488],{"id":961,"viewCount":57,"searchKey":962,"visible":15},"10003525",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":9,"currentStage":187,"position":968,"attributes":969},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[298],[268,488],{"id":971,"viewCount":57,"searchKey":972,"visible":15},"10003399",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":9,"currentStage":21,"position":978,"attributes":979},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[298],[268,488],{"id":981,"viewCount":57,"searchKey":982,"visible":15},"10003518",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":9,"currentStage":187,"position":988,"attributes":989},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[298],[488],{"id":991,"viewCount":57,"searchKey":992,"visible":15},"10003393",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":9,"currentStage":21,"position":998,"attributes":999},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[298],[488],{"id":1001,"viewCount":57,"searchKey":1002,"visible":15},"10003386",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":9,"currentStage":265,"position":1008,"attributes":1009},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[320],[488],{"id":1011,"viewCount":57,"searchKey":1012,"visible":15},"10003447",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":9,"currentStage":21,"position":1018,"attributes":1019},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[320],[488],{"id":1021,"viewCount":57,"searchKey":1022,"visible":15},"10003497",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":9,"currentStage":265,"position":1028,"attributes":1029},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[320],[629],{"id":1031,"viewCount":57,"searchKey":1032,"visible":15},"10003479",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":9,"currentStage":187,"position":1038,"attributes":1039},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[320],[629],{"id":1041,"viewCount":57,"searchKey":1042,"visible":15},"10003388",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":9,"currentStage":21,"position":1048,"attributes":1049},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[320],[629],{"id":1051,"viewCount":57,"searchKey":1052,"visible":15},"10003429",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":9,"currentStage":265,"position":1058,"attributes":1059},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[416],[385],{"id":1061,"viewCount":57,"searchKey":1062,"visible":15},"10003430",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":9,"currentStage":21,"position":1068,"attributes":1069},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[416],[385],{"id":1071,"viewCount":57,"searchKey":1072,"visible":15},"10003549",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":9,"currentStage":176,"position":1078,"attributes":1079},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[416],[629],{"id":1081,"viewCount":57,"searchKey":1082,"visible":15},"10003494",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":9,"currentStage":265,"position":1088,"attributes":1089},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[416],[488,385],{"id":1091,"viewCount":57,"searchKey":1092,"visible":15},"10003486",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":9,"currentStage":21,"position":1098,"attributes":1099},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[416],[488,385],{"id":1101,"viewCount":57,"searchKey":1102,"visible":15},"10003530",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":9,"currentStage":265,"position":1108,"attributes":1109},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[298],[406],{"id":1111,"viewCount":57,"searchKey":1112,"visible":15},"10003457",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":9,"currentStage":21,"position":1118,"attributes":1119},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[298],[406],{"id":1121,"viewCount":57,"searchKey":1122,"visible":15},"10003423",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":9,"currentStage":265,"position":1128,"attributes":1129},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[383],[363,385],{"id":1131,"viewCount":57,"searchKey":1132,"visible":15},"10003419",{"type":10,"entryId":1133,"sortOrder":1134,"name":1135,"imageUrl":1136,"description":1137,"currentMorphology":9,"currentStage":21,"position":1138,"attributes":1139},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[383],[363,385],{"id":1141,"viewCount":57,"searchKey":1142,"visible":15},"10003410",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":9,"currentStage":265,"position":1148,"attributes":1149},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[385],{"id":1151,"viewCount":57,"searchKey":1152,"visible":15},"10003509",{"type":10,"entryId":1153,"sortOrder":1154,"name":1155,"imageUrl":1156,"description":1157,"currentMorphology":9,"currentStage":21,"position":1158,"attributes":1159},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[385],{"id":1161,"viewCount":57,"searchKey":1162,"visible":15},"10003413",{"type":10,"entryId":1163,"sortOrder":1164,"name":1165,"imageUrl":1166,"description":1167,"currentMorphology":9,"currentStage":265,"position":1168,"attributes":1169},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[406],{"id":1171,"viewCount":57,"searchKey":1172,"visible":15},"10003407",{"type":10,"entryId":1173,"sortOrder":1174,"name":1175,"imageUrl":1176,"description":1177,"currentMorphology":9,"currentStage":21,"position":1178,"attributes":1179},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[406],{"id":1181,"viewCount":57,"searchKey":1182,"visible":15},"10003498",{"type":10,"entryId":1183,"sortOrder":1184,"name":1185,"imageUrl":1186,"description":1187,"currentMorphology":9,"currentStage":176,"position":1188,"attributes":1189},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1190],"attributes-holy",{"id":1192,"viewCount":57,"searchKey":1193,"visible":15},"10003375",{"type":10,"entryId":1194,"sortOrder":1195,"name":1196,"imageUrl":1197,"description":1198,"currentMorphology":9,"currentStage":176,"position":1199,"attributes":1200},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1190],[1202,1210,1215,1220,1225,1230,1235,1240,1243,1246,1251,1256,1260,1265,1270,1275,1280,1285,1288],{"id":1203,"parentId":1204,"tagType":1205,"tagKey":1206,"name":1207,"language":1208,"sort":1209},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","M