ume":211,"power":212},[196],[198],"10","38",{"id":214,"type":137,"props":215},"91268552_38",{"id":216,"customKey":46,"icon":217,"iconStyle":65,"iconTitle":46,"descTitle":218,"descContent":219,"source":220},"91268552_39","/cdn/init/1035200_Skill_11201190_Icon.png","暗滅刻印","對前方範圍的目標造成傷害並施加標記「暗滅」，持續15秒。標記存在時，暗元素的普攻會對其造成25%額外傷害。",{"attributes":221,"type":222,"consume":223,"power":224},[196],[198],"0","30",{"id":226,"title":227,"children":228},"91268552_40","固有技能",[229,239],{"id":230,"type":137,"props":231},"91268552_41",{"id":232,"customKey":46,"icon":233,"iconStyle":65,"iconTitle":46,"descTitle":234,"descContent":235,"source":236},"91268552_42","/cdn/init/1035200_Skill_11200240_Icon.png","蝶香魅惑","振翅散發香氣，所有隊伍成員暗元素強化提升10%，持續30秒。同時魅惑一定範圍內的目標，使其短暫迷失。",{"attributes":237,"type":238,"consume":223,"power":223},[196],[223],{"id":240,"type":137,"props":241},"91268552_43",{"id":242,"customKey":46,"icon":243,"iconStyle":65,"iconTitle":46,"descTitle":244,"descContent":245,"source":246},"91268552_44","/cdn/init/1035200_Skill_11200000_Icon.png","攻擊","使用暗元素能力，近距離攻擊目標。",{"attributes":247,"type":248,"consume":223,"power":250},[196],[249],"1","6",[252],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[254,266,276,286,297,307,317,328,338,348,358,369,379,391,401,412,423,433,443,453,463,473,483,494,504,514,524,534,544,554,564,574,584,594,604,614,624,635,645,652,656,664,674,684,694,704,714,724,734,744,754,764,774,784,794,804,814,824,834,844,854,864,874,884,894,904,914,924,934,944,954,964,974,984,994,1004,1014,1024,1034,1044,1054,1064,1074,1084,1094,1104,1114,1124,1134,1144,1154,1164,1174,1185],{"id":255,"viewCount":59,"searchKey":256,"visible":14},"10003442",{"type":10,"entryId":257,"sortOrder":258,"name":259,"imageUrl":260,"description":261,"currentMorphology":9,"currentStage":249,"position":262,"attributes":264},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[263],"position-dps",[265],"attributes-fire",{"id":267,"viewCount":59,"searchKey":268,"visible":14},"10003534",{"type":10,"entryId":269,"sortOrder":270,"name":271,"imageUrl":272,"description":273,"currentMorphology":9,"currentStage":198,"position":274,"attributes":275},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[263],[265],{"id":277,"viewCount":59,"searchKey":278,"visible":14},"10003435",{"type":10,"entryId":279,"sortOrder":280,"name":281,"imageUrl":282,"description":283,"currentMorphology":9,"currentStage":21,"position":284,"attributes":285},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[263],[265],{"id":287,"viewCount":59,"searchKey":288,"visible":14},"10003428",{"type":10,"entryId":289,"sortOrder":290,"name":291,"imageUrl":292,"description":293,"currentMorphology":9,"currentStage":21,"position":294,"attributes":296},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[295],"position-break",[265,25],{"id":298,"viewCount":59,"searchKey":299,"visible":14},"10003578",{"type":10,"entryId":300,"sortOrder":301,"name":302,"imageUrl":303,"description":304,"currentMorphology":9,"currentStage":249,"position":305,"attributes":306},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[263],[25],{"id":308,"viewCount":59,"searchKey":309,"visible":14},"10003417",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":9,"currentStage":21,"position":315,"attributes":316},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[263],[25],{"id":318,"viewCount":59,"searchKey":319,"visible":14},"10003488",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":249,"position":325,"attributes":326},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[23],[327],"attributes-wind",{"id":329,"viewCount":59,"searchKey":330,"visible":14},"10003548",{"type":10,"entryId":331,"sortOrder":332,"name":333,"imageUrl":334,"description":335,"currentMorphology":9,"currentStage":21,"position":336,"attributes":337},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[23],[327],{"id":339,"viewCount":59,"searchKey":340,"visible":14},"10003474",{"type":10,"entryId":341,"sortOrder":342,"name":343,"imageUrl":344,"description":345,"currentMorphology":9,"currentStage":21,"position":346,"attributes":347},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[263],[327],{"id":349,"viewCount":59,"searchKey":350,"visible":14},"10003467",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":9,"currentStage":21,"position":356,"attributes":357},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[295],[327],{"id":359,"viewCount":59,"searchKey":360,"visible":14},"10003392",{"type":10,"entryId":361,"sortOrder":362,"name":363,"imageUrl":364,"description":365,"currentMorphology":9,"currentStage":249,"position":366,"attributes":367},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[263],[368],"attributes-grass",{"id":370,"viewCount":59,"searchKey":371,"visible":14},"10003510",{"type":10,"entryId":372,"sortOrder":373,"name":374,"imageUrl":375,"description":376,"currentMorphology":9,"currentStage":21,"position":377,"attributes":378},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[263],[368],{"id":380,"viewCount":59,"searchKey":381,"visible":14},"10003477",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":9,"currentStage":249,"position":387,"attributes":389},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[388],"position-heal",[390],"attributes-water",{"id":392,"viewCount":59,"searchKey":393,"visible":14},"10003569",{"type":10,"entryId":394,"sortOrder":395,"name":396,"imageUrl":397,"description":398,"currentMorphology":9,"currentStage":198,"position":399,"attributes":400},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[388],[390],{"id":402,"viewCount":59,"searchKey":403,"visible":14},"10003470",{"type":10,"entryId":404,"sortOrder":405,"name":406,"imageUrl":407,"description":408,"currentMorphology":9,"currentStage":21,"position":409,"attributes":410},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[388],[390,411],"attributes-ice",{"id":413,"viewCount":59,"searchKey":414,"visible":14},"10003463",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":9,"currentStage":21,"position":420,"attributes":422},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[421],"position-energy",[368,390],{"id":424,"viewCount":59,"searchKey":425,"visible":14},"10003468",{"type":10,"entryId":426,"sortOrder":427,"name":428,"imageUrl":429,"description":430,"currentMorphology":9,"currentStage":249,"position":431,"attributes":432},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[23],[327],{"id":434,"viewCount":59,"searchKey":435,"visible":14},"10003365",{"type":10,"entryId":436,"sortOrder":437,"name":438,"imageUrl":439,"description":440,"currentMorphology":9,"currentStage":21,"position":441,"attributes":442},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[23],[327],{"id":444,"viewCount":59,"searchKey":445,"visible":14},"10003461",{"type":10,"entryId":446,"sortOrder":447,"name":448,"imageUrl":449,"description":450,"currentMorphology":9,"currentStage":21,"position":451,"attributes":452},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[23],[25],{"id":454,"viewCount":59,"searchKey":455,"visible":14},"10003421",{"type":10,"entryId":456,"sortOrder":457,"name":458,"imageUrl":459,"description":460,"currentMorphology":9,"currentStage":249,"position":461,"attributes":462},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[295],[368],{"id":464,"viewCount":59,"searchKey":465,"visible":14},"10003414",{"type":10,"entryId":466,"sortOrder":467,"name":468,"imageUrl":469,"description":470,"currentMorphology":9,"currentStage":21,"position":471,"attributes":472},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[421],[25,368],{"id":474,"viewCount":59,"searchKey":475,"visible":14},"10003404",{"type":10,"entryId":476,"sortOrder":477,"name":478,"imageUrl":479,"description":480,"currentMorphology":9,"currentStage":21,"position":481,"attributes":482},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[295],[368],{"id":484,"viewCount":59,"searchKey":485,"visible":14},"10003567",{"type":10,"entryId":486,"sortOrder":487,"name":488,"imageUrl":489,"description":490,"currentMorphology":9,"currentStage":249,"position":491,"attributes":492},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[295],[493,368],"attributes-rock",{"id":495,"viewCount":59,"searchKey":496,"visible":14},"10003462",{"type":10,"entryId":497,"sortOrder":498,"name":499,"imageUrl":500,"description":501,"currentMorphology":9,"currentStage":21,"position":502,"attributes":503},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[295],[493,368],{"id":505,"viewCount":59,"searchKey":506,"visible":14},"10003551",{"type":10,"entryId":507,"sortOrder":508,"name":509,"imageUrl":510,"description":511,"currentMorphology":9,"currentStage":21,"position":512,"attributes":513},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[295],[411],{"id":515,"viewCount":59,"searchKey":516,"visible":14},"10003409",{"type":10,"entryId":517,"sortOrder":518,"name":519,"imageUrl":520,"description":521,"currentMorphology":9,"currentStage":249,"position":522,"attributes":523},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[421],[265],{"id":525,"viewCount":59,"searchKey":526,"visible":14},"10003507",{"type":10,"entryId":527,"sortOrder":528,"name":529,"imageUrl":530,"description":531,"currentMorphology":9,"currentStage":21,"position":532,"attributes":533},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[421],[265],{"id":535,"viewCount":59,"searchKey":536,"visible":14},"10003542",{"type":10,"entryId":537,"sortOrder":538,"name":539,"imageUrl":540,"description":541,"currentMorphology":9,"currentStage":249,"position":542,"attributes":543},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[388],[327],{"id":545,"viewCount":59,"searchKey":546,"visible":14},"10003440",{"type":10,"entryId":547,"sortOrder":548,"name":549,"imageUrl":550,"description":551,"currentMorphology":9,"currentStage":21,"position":552,"attributes":553},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[388],[327],{"id":555,"viewCount":59,"searchKey":556,"visible":14},"10003563",{"type":10,"entryId":557,"sortOrder":558,"name":559,"imageUrl":560,"description":561,"currentMorphology":9,"currentStage":223,"position":562,"attributes":563},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[421],[327,368],{"id":565,"viewCount":59,"searchKey":566,"visible":14},"10003368",{"type":10,"entryId":567,"sortOrder":568,"name":569,"imageUrl":570,"description":571,"currentMorphology":9,"currentStage":249,"position":572,"attributes":573},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[23],[327],{"id":575,"viewCount":59,"searchKey":576,"visible":14},"10003363",{"type":10,"entryId":577,"sortOrder":578,"name":579,"imageUrl":580,"description":581,"currentMorphology":9,"currentStage":21,"position":582,"attributes":583},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[23],[327],{"id":585,"viewCount":59,"searchKey":586,"visible":14},"10003515",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":9,"currentStage":249,"position":592,"attributes":593},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[263],[368],{"id":595,"viewCount":59,"searchKey":596,"visible":14},"10003496",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":9,"currentStage":21,"position":602,"attributes":603},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[263],[368],{"id":605,"viewCount":59,"searchKey":606,"visible":14},"10003378",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":9,"currentStage":21,"position":612,"attributes":613},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[23],[368],{"id":615,"viewCount":59,"searchKey":616,"visible":14},"10003456",{"type":10,"entryId":617,"sortOrder":618,"name":619,"imageUrl":620,"description":621,"currentMorphology":9,"currentStage":249,"position":622,"attributes":623},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[295],[368],{"id":625,"viewCount":59,"searchKey":626,"visible":14},"10003374",{"type":10,"entryId":627,"sortOrder":628,"name":629,"imageUrl":630,"description":631,"currentMorphology":9,"currentStage":21,"position":632,"attributes":633},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[23],[634],"attributes-electric",{"id":636,"viewCount":59,"searchKey":637,"visible":14},"10003443",{"type":10,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":9,"currentStage":21,"position":643,"attributes":644},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[295],[368],{"id":5,"viewCount":59,"searchKey":646,"visible":14},{"type":10,"entryId":8,"sortOrder":647,"name":75,"imageUrl":648,"description":649,"currentMorphology":9,"currentStage":249,"position":650,"attributes":651},1035100,"/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[23],[25],{"id":4,"viewCount":59,"searchKey":653,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":654,"attributes":655},[23],[25],{"id":6,"viewCount":59,"searchKey":657,"visible":14},{"type":10,"entryId":12,"sortOrder":658,"name":659,"imageUrl":660,"description":661,"currentMorphology":9,"currentStage":249,"position":662,"attributes":663},1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[263],[25],{"id":665,"viewCount":59,"searchKey":666,"visible":14},"10003369",{"type":10,"entryId":667,"sortOrder":668,"name":669,"imageUrl":670,"description":671,"currentMorphology":9,"currentStage":21,"position":672,"attributes":673},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[263],[25],{"id":675,"viewCount":59,"searchKey":676,"visible":14},"10003501",{"type":10,"entryId":677,"sortOrder":678,"name":679,"imageUrl":680,"description":681,"currentMorphology":9,"currentStage":21,"position":682,"attributes":683},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[263],[634],{"id":685,"viewCount":59,"searchKey":686,"visible":14},"10003422",{"type":10,"entryId":687,"sortOrder":688,"name":689,"imageUrl":690,"description":691,"currentMorphology":9,"currentStage":249,"position":692,"attributes":693},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[263],[411],{"id":695,"viewCount":59,"searchKey":696,"visible":14},"10003575",{"type":10,"entryId":697,"sortOrder":698,"name":699,"imageUrl":700,"description":701,"currentMorphology":9,"currentStage":198,"position":702,"attributes":703},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[263],[411],{"id":705,"viewCount":59,"searchKey":706,"visible":14},"10003415",{"type":10,"entryId":707,"sortOrder":708,"name":709,"imageUrl":710,"description":711,"currentMorphology":9,"currentStage":21,"position":712,"attributes":713},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[263],[411],{"id":715,"viewCount":59,"searchKey":716,"visible":14},"10003524",{"type":10,"entryId":717,"sortOrder":718,"name":719,"imageUrl":720,"description":721,"currentMorphology":9,"currentStage":249,"position":722,"attributes":723},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[295],[634],{"id":725,"viewCount":59,"searchKey":726,"visible":14},"10003475",{"type":10,"entryId":727,"sortOrder":728,"name":729,"imageUrl":730,"description":731,"currentMorphology":9,"currentStage":21,"position":732,"attributes":733},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[295],[634],{"id":735,"viewCount":59,"searchKey":736,"visible":14},"10003523",{"type":10,"entryId":737,"sortOrder":738,"name":739,"imageUrl":740,"description":741,"currentMorphology":9,"currentStage":249,"position":742,"attributes":743},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[295],[390],{"id":745,"viewCount":59,"searchKey":746,"visible":14},"10003398",{"type":10,"entryId":747,"sortOrder":748,"name":749,"imageUrl":750,"description":751,"currentMorphology":9,"currentStage":198,"position":752,"attributes":753},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[295],[390],{"id":755,"viewCount":59,"searchKey":756,"visible":14},"10003516",{"type":10,"entryId":757,"sortOrder":758,"name":759,"imageUrl":760,"description":761,"currentMorphology":9,"currentStage":21,"position":762,"attributes":763},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[23],[390],{"id":765,"viewCount":59,"searchKey":766,"visible":14},"10003566",{"type":10,"entryId":767,"sortOrder":768,"name":769,"imageUrl":770,"description":771,"currentMorphology":9,"currentStage":21,"position":772,"attributes":773},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[295],[390],{"id":775,"viewCount":59,"searchKey":776,"visible":14},"10003453",{"type":10,"entryId":777,"sortOrder":778,"name":779,"imageUrl":780,"description":781,"currentMorphology":9,"currentStage":249,"position":782,"attributes":783},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[263],[390],{"id":785,"viewCount":59,"searchKey":786,"visible":14},"10003577",{"type":10,"entryId":787,"sortOrder":788,"name":789,"imageUrl":790,"description":791,"currentMorphology":9,"currentStage":198,"position":792,"attributes":793},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[263],[390],{"id":795,"viewCount":59,"searchKey":796,"visible":14},"10003570",{"type":10,"entryId":797,"sortOrder":798,"name":799,"imageUrl":800,"description":801,"currentMorphology":9,"currentStage":21,"position":802,"attributes":803},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[263],[390],{"id":805,"viewCount":59,"searchKey":806,"visible":14},"10003565",{"type":10,"entryId":807,"sortOrder":808,"name":809,"imageUrl":810,"description":811,"currentMorphology":9,"currentStage":249,"position":812,"attributes":813},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[263],[493],{"id":815,"viewCount":59,"searchKey":816,"visible":14},"10003476",{"type":10,"entryId":817,"sortOrder":818,"name":819,"imageUrl":820,"description":821,"currentMorphology":9,"currentStage":21,"position":822,"attributes":823},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[263],[493],{"id":825,"viewCount":59,"searchKey":826,"visible":14},"10003466",{"type":10,"entryId":827,"sortOrder":828,"name":829,"imageUrl":830,"description":831,"currentMorphology":9,"currentStage":21,"position":832,"attributes":833},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[23],[493],{"id":835,"viewCount":59,"searchKey":836,"visible":14},"10003379",{"type":10,"entryId":837,"sortOrder":838,"name":839,"imageUrl":840,"description":841,"currentMorphology":9,"currentStage":249,"position":842,"attributes":843},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[263],[634],{"id":845,"viewCount":59,"searchKey":846,"visible":14},"10003376",{"type":10,"entryId":847,"sortOrder":848,"name":849,"imageUrl":850,"description":851,"currentMorphology":9,"currentStage":21,"position":852,"attributes":853},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[263],[634],{"id":855,"viewCount":59,"searchKey":856,"visible":14},"10003543",{"type":10,"entryId":857,"sortOrder":858,"name":859,"imageUrl":860,"description":861,"currentMorphology":9,"currentStage":249,"position":862,"attributes":863},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[295],[25],{"id":865,"viewCount":59,"searchKey":866,"visible":14},"10003557",{"type":10,"entryId":867,"sortOrder":868,"name":869,"imageUrl":870,"description":871,"currentMorphology":9,"currentStage":21,"position":872,"attributes":873},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[263],[25],{"id":875,"viewCount":59,"searchKey":876,"visible":14},"10003522",{"type":10,"entryId":877,"sortOrder":878,"name":879,"imageUrl":880,"description":881,"currentMorphology":9,"currentStage":21,"position":882,"attributes":883},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[295],[25],{"id":885,"viewCount":59,"searchKey":886,"visible":14},"10003579",{"type":10,"entryId":887,"sortOrder":888,"name":889,"imageUrl":890,"description":891,"currentMorphology":9,"currentStage":249,"position":892,"attributes":893},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[295],[327],{"id":895,"viewCount":59,"searchKey":896,"visible":14},"10003389",{"type":10,"entryId":897,"sortOrder":898,"name":899,"imageUrl":900,"description":901,"currentMorphology":9,"currentStage":198,"position":902,"attributes":903},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[295],[327],{"id":905,"viewCount":59,"searchKey":906,"visible":14},"10003536",{"type":10,"entryId":907,"sortOrder":908,"name":909,"imageUrl":910,"description":911,"currentMorphology":9,"currentStage":21,"position":912,"attributes":913},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[295],[327],{"id":915,"viewCount":59,"searchKey":916,"visible":14},"10003529",{"type":10,"entryId":917,"sortOrder":918,"name":919,"imageUrl":920,"description":921,"currentMorphology":9,"currentStage":21,"position":922,"attributes":923},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[263],[265],{"id":925,"viewCount":59,"searchKey":926,"visible":14},"10003433",{"type":10,"entryId":927,"sortOrder":928,"name":929,"imageUrl":930,"description":931,"currentMorphology":9,"currentStage":249,"position":932,"attributes":933},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[263],[493],{"id":935,"viewCount":59,"searchKey":936,"visible":14},"10003427",{"type":10,"entryId":937,"sortOrder":938,"name":939,"imageUrl":940,"description":941,"currentMorphology":9,"currentStage":21,"position":942,"attributes":943},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[263],[493],{"id":945,"viewCount":59,"searchKey":946,"visible":14},"10003405",{"type":10,"entryId":947,"sortOrder":948,"name":949,"imageUrl":950,"description":951,"currentMorphology":9,"currentStage":249,"position":952,"attributes":953},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[295],[493],{"id":955,"viewCount":59,"searchKey":956,"visible":14},"10003525",{"type":10,"entryId":957,"sortOrder":958,"name":959,"imageUrl":960,"description":961,"currentMorphology":9,"currentStage":198,"position":962,"attributes":963},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[295],[265,493],{"id":965,"viewCount":59,"searchKey":966,"visible":14},"10003399",{"type":10,"entryId":967,"sortOrder":968,"name":969,"imageUrl":970,"description":971,"currentMorphology":9,"currentStage":21,"position":972,"attributes":973},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[295],[265,493],{"id":975,"viewCount":59,"searchKey":976,"visible":14},"10003518",{"type":10,"entryId":977,"sortOrder":978,"name":979,"imageUrl":980,"description":981,"currentMorphology":9,"currentStage":198,"position":982,"attributes":983},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[295],[493],{"id":985,"viewCount":59,"searchKey":986,"visible":14},"10003393",{"type":10,"entryId":987,"sortOrder":988,"name":989,"imageUrl":990,"description":991,"currentMorphology":9,"currentStage":21,"position":992,"attributes":993},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[295],[493],{"id":995,"viewCount":59,"searchKey":996,"visible":14},"10003386",{"type":10,"entryId":997,"sortOrder":998,"name":999,"imageUrl":1000,"description":1001,"currentMorphology":9,"currentStage":249,"position":1002,"attributes":1003},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[23],[493],{"id":1005,"viewCount":59,"searchKey":1006,"visible":14},"10003447",{"type":10,"entryId":1007,"sortOrder":1008,"name":1009,"imageUrl":1010,"description":1011,"currentMorphology":9,"currentStage":21,"position":1012,"attributes":1013},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[23],[493],{"id":1015,"viewCount":59,"searchKey":1016,"visible":14},"10003497",{"type":10,"entryId":1017,"sortOrder":1018,"name":1019,"imageUrl":1020,"description":1021,"currentMorphology":9,"currentStage":249,"position":1022,"attributes":1023},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[23],[634],{"id":1025,"viewCount":59,"searchKey":1026,"visible":14},"10003479",{"type":10,"entryId":1027,"sortOrder":1028,"name":1029,"imageUrl":1030,"description":1031,"currentMorphology":9,"currentStage":198,"position":1032,"attributes":1033},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[23],[634],{"id":1035,"viewCount":59,"searchKey":1036,"visible":14},"10003388",{"type":10,"entryId":1037,"sortOrder":1038,"name":1039,"imageUrl":1040,"description":1041,"currentMorphology":9,"currentStage":21,"position":1042,"attributes":1043},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[23],[634],{"id":1045,"viewCount":59,"searchKey":1046,"visible":14},"10003429",{"type":10,"entryId":1047,"sortOrder":1048,"name":1049,"imageUrl":1050,"description":1051,"currentMorphology":9,"currentStage":249,"position":1052,"attributes":1053},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[421],[390],{"id":1055,"viewCount":59,"searchKey":1056,"visible":14},"10003430",{"type":10,"entryId":1057,"sortOrder":1058,"name":1059,"imageUrl":1060,"description":1061,"currentMorphology":9,"currentStage":21,"position":1062,"attributes":1063},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[421],[390],{"id":1065,"viewCount":59,"searchKey":1066,"visible":14},"10003549",{"type":10,"entryId":1067,"sortOrder":1068,"name":1069,"imageUrl":1070,"description":1071,"currentMorphology":9,"currentStage":223,"position":1072,"attributes":1073},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[421],[634],{"id":1075,"viewCount":59,"searchKey":1076,"visible":14},"10003494",{"type":10,"entryId":1077,"sortOrder":1078,"name":1079,"imageUrl":1080,"description":1081,"currentMorphology":9,"currentStage":249,"position":1082,"attributes":1083},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[421],[493,390],{"id":1085,"viewCount":59,"searchKey":1086,"visible":14},"10003486",{"type":10,"entryId":1087,"sortOrder":1088,"name":1089,"imageUrl":1090,"description":1091,"currentMorphology":9,"currentStage":21,"position":1092,"attributes":1093},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[421],[493,390],{"id":1095,"viewCount":59,"searchKey":1096,"visible":14},"10003530",{"type":10,"entryId":1097,"sortOrder":1098,"name":1099,"imageUrl":1100,"description":1101,"currentMorphology":9,"currentStage":249,"position":1102,"attributes":1103},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[295],[411],{"id":1105,"viewCount":59,"searchKey":1106,"visible":14},"10003457",{"type":10,"entryId":1107,"sortOrder":1108,"name":1109,"imageUrl":1110,"description":1111,"currentMorphology":9,"currentStage":21,"position":1112,"attributes":1113},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[295],[411],{"id":1115,"viewCount":59,"searchKey":1116,"visible":14},"10003423",{"type":10,"entryId":1117,"sortOrder":1118,"name":1119,"imageUrl":1120,"description":1121,"currentMorphology":9,"currentStage":249,"position":1122,"attributes":1123},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[388],[368,390],{"id":1125,"viewCount":59,"searchKey":1126,"visible":14},"10003419",{"type":10,"entryId":1127,"sortOrder":1128,"name":1129,"imageUrl":1130,"description":1131,"currentMorphology":9,"currentStage":21,"position":1132,"attributes":1133},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[388],[368,390],{"id":1135,"viewCount":59,"searchKey":1136,"visible":14},"10003410",{"type":10,"entryId":1137,"sortOrder":1138,"name":1139,"imageUrl":1140,"description":1141,"currentMorphology":9,"currentStage":249,"position":1142,"attributes":1143},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[263],[390],{"id":1145,"viewCount":59,"searchKey":1146,"visible":14},"10003509",{"type":10,"entryId":1147,"sortOrder":1148,"name":1149,"imageUrl":1150,"description":1151,"currentMorphology":9,"currentStage":21,"position":1152,"attributes":1153},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[263],[390],{"id":1155,"viewCount":59,"searchKey":1156,"visible":14},"10003413",{"type":10,"entryId":1157,"sortOrder":1158,"name":1159,"imageUrl":1160,"description":1161,"currentMorphology":9,"currentStage":249,"position":1162,"attributes":1163},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[263],[411],{"id":1165,"viewCount":59,"searchKey":1166,"visible":14},"10003407",{"type":10,"entryId":1167,"sortOrder":1168,"name":1169,"imageUrl":1170,"description":1171,"currentMorphology":9,"currentStage":21,"position":1172,"attributes":1173},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[263],[411],{"id":1175,"viewCount":59,"searchKey":1176,"visible":14},"10003498",{"type":10,"entryId":1177,"sortOrder":1178,"name":1179,"imageUrl":1180,"description":1181,"currentMorphology":9,"currentStage":223,"position":1182,"attributes":1183},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[263],[1184],"attributes-holy",{"id":1186,"viewCount":59,"searchKey":1187,"visible":14},"10003375",{"type":10,"entryId":1188,"sortOrder":1189,"name":1190,"imageUrl":1191,"description":1192,"currentMorphology":9,"currentStage":223,"position":1193,"attributes":1194},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[263],[1184],[1196,1204,1209,1214,1219,1224,1229,1234,1238,1242,1247,1252,1257,1262,1267,1272,1277,1282,1285],{"id":1197,"parentId":1198,"tagType":1199,"tagKey":1200,"name":1201,"language":1202,"sort":1203},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1205,"parentId":1198,"tagType":1199,"tagKey":1206,"name":1207,"language":1202,"sort":1208},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1210,"parentId":1198,"tagType":1199,"tagKey":1211,"name":1212,"language":1202,"sort":1213},"450da43bc6001e686491fef2c68f8615",