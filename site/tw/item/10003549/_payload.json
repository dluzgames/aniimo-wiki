position-dps",[205],"attributes-fire",{"id":207,"viewCount":57,"searchKey":208,"visible":14},"10003534",{"type":10,"entryId":209,"sortOrder":210,"name":211,"imageUrl":212,"description":213,"currentMorphology":9,"currentStage":140,"position":214,"attributes":215},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[203],[205],{"id":217,"viewCount":57,"searchKey":218,"visible":14},"10003435",{"type":10,"entryId":219,"sortOrder":220,"name":221,"imageUrl":222,"description":223,"currentMorphology":9,"currentStage":224,"position":225,"attributes":226},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[203],[205],{"id":228,"viewCount":57,"searchKey":229,"visible":14},"10003428",{"type":10,"entryId":230,"sortOrder":231,"name":232,"imageUrl":233,"description":234,"currentMorphology":9,"currentStage":224,"position":235,"attributes":237},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[236],"position-break",[205,238],"attributes-dark",{"id":240,"viewCount":57,"searchKey":241,"visible":14},"10003578",{"type":10,"entryId":242,"sortOrder":243,"name":244,"imageUrl":245,"description":246,"currentMorphology":9,"currentStage":91,"position":247,"attributes":248},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[203],[238],{"id":250,"viewCount":57,"searchKey":251,"visible":14},"10003417",{"type":10,"entryId":252,"sortOrder":253,"name":254,"imageUrl":255,"description":256,"currentMorphology":9,"currentStage":224,"position":257,"attributes":258},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[203],[238],{"id":260,"viewCount":57,"searchKey":261,"visible":14},"10003488",{"type":10,"entryId":262,"sortOrder":263,"name":264,"imageUrl":265,"description":266,"currentMorphology":9,"currentStage":91,"position":267,"attributes":269},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[268],"position-sup",[270],"attributes-wind",{"id":272,"viewCount":57,"searchKey":273,"visible":14},"10003548",{"type":10,"entryId":274,"sortOrder":275,"name":276,"imageUrl":277,"description":278,"currentMorphology":9,"currentStage":224,"position":279,"attributes":280},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[268],[270],{"id":282,"viewCount":57,"searchKey":283,"visible":14},"10003474",{"type":10,"entryId":284,"sortOrder":285,"name":286,"imageUrl":287,"description":288,"currentMorphology":9,"currentStage":224,"position":289,"attributes":290},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[203],[270],{"id":292,"viewCount":57,"searchKey":293,"visible":14},"10003467",{"type":10,"entryId":294,"sortOrder":295,"name":296,"imageUrl":297,"description":298,"currentMorphology":9,"currentStage":224,"position":299,"attributes":300},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[236],[270],{"id":302,"viewCount":57,"searchKey":303,"visible":14},"10003392",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":9,"currentStage":91,"position":309,"attributes":310},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[203],[311],"attributes-grass",{"id":313,"viewCount":57,"searchKey":314,"visible":14},"10003510",{"type":10,"entryId":315,"sortOrder":316,"name":317,"imageUrl":318,"description":319,"currentMorphology":9,"currentStage":224,"position":320,"attributes":321},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[203],[311],{"id":323,"viewCount":57,"searchKey":324,"visible":14},"10003477",{"type":10,"entryId":325,"sortOrder":326,"name":327,"imageUrl":328,"description":329,"currentMorphology":9,"currentStage":91,"position":330,"attributes":332},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[331],"position-heal",[333],"attributes-water",{"id":335,"viewCount":57,"searchKey":336,"visible":14},"10003569",{"type":10,"entryId":337,"sortOrder":338,"name":339,"imageUrl":340,"description":341,"currentMorphology":9,"currentStage":140,"position":342,"attributes":343},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[331],[333],{"id":345,"viewCount":57,"searchKey":346,"visible":14},"10003470",{"type":10,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":9,"currentStage":224,"position":352,"attributes":353},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[331],[333,354],"attributes-ice",{"id":356,"viewCount":57,"searchKey":357,"visible":14},"10003463",{"type":10,"entryId":358,"sortOrder":359,"name":360,"imageUrl":361,"description":362,"currentMorphology":9,"currentStage":224,"position":363,"attributes":364},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[23],[311,333],{"id":366,"viewCount":57,"searchKey":367,"visible":14},"10003468",{"type":10,"entryId":368,"sortOrder":369,"name":370,"imageUrl":371,"description":372,"currentMorphology":9,"currentStage":91,"position":373,"attributes":374},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[268],[270],{"id":376,"viewCount":57,"searchKey":377,"visible":14},"10003365",{"type":10,"entryId":378,"sortOrder":379,"name":380,"imageUrl":381,"description":382,"currentMorphology":9,"currentStage":224,"position":383,"attributes":384},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[268],[270],{"id":386,"viewCount":57,"searchKey":387,"visible":14},"10003461",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":9,"currentStage":224,"position":393,"attributes":394},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[268],[238],{"id":396,"viewCount":57,"searchKey":397,"visible":14},"10003421",{"type":10,"entryId":398,"sortOrder":399,"name":400,"imageUrl":401,"description":402,"currentMorphology":9,"currentStage":91,"position":403,"attributes":404},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[236],[311],{"id":406,"viewCount":57,"searchKey":407,"visible":14},"10003414",{"type":10,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":9,"currentStage":224,"position":413,"attributes":414},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[23],[238,311],{"id":416,"viewCount":57,"searchKey":417,"visible":14},"10003404",{"type":10,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":9,"currentStage":224,"position":423,"attributes":424},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[236],[311],{"id":426,"viewCount":57,"searchKey":427,"visible":14},"10003567",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":9,"currentStage":91,"position":433,"attributes":434},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[236],[435,311],"attributes-rock",{"id":437,"viewCount":57,"searchKey":438,"visible":14},"10003462",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":9,"currentStage":224,"position":444,"attributes":445},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[236],[435,311],{"id":447,"viewCount":57,"searchKey":448,"visible":14},"10003551",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":9,"currentStage":224,"position":454,"attributes":455},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[236],[354],{"id":457,"viewCount":57,"searchKey":458,"visible":14},"10003409",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":9,"currentStage":91,"position":464,"attributes":465},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[23],[205],{"id":467,"viewCount":57,"searchKey":468,"visible":14},"10003507",{"type":10,"entryId":469,"sortOrder":470,"name":471,"imageUrl":472,"description":473,"currentMorphology":9,"currentStage":224,"position":474,"attributes":475},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[23],[205],{"id":477,"viewCount":57,"searchKey":478,"visible":14},"10003542",{"type":10,"entryId":479,"sortOrder":480,"name":481,"imageUrl":482,"description":483,"currentMorphology":9,"currentStage":91,"position":484,"attributes":485},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[331],[270],{"id":487,"viewCount":57,"searchKey":488,"visible":14},"10003440",{"type":10,"entryId":489,"sortOrder":490,"name":491,"imageUrl":492,"description":493,"currentMorphology":9,"currentStage":224,"position":494,"attributes":495},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[331],[270],{"id":497,"viewCount":57,"searchKey":498,"visible":14},"10003563",{"type":10,"entryId":499,"sortOrder":500,"name":501,"imageUrl":502,"description":503,"currentMorphology":9,"currentStage":21,"position":504,"attributes":505},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[23],[270,311],{"id":507,"viewCount":57,"searchKey":508,"visible":14},"10003368",{"type":10,"entryId":509,"sortOrder":510,"name":511,"imageUrl":512,"description":513,"currentMorphology":9,"currentStage":91,"position":514,"attributes":515},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[268],[270],{"id":517,"viewCount":57,"searchKey":518,"visible":14},"10003363",{"type":10,"entryId":519,"sortOrder":520,"name":521,"imageUrl":522,"description":523,"currentMorphology":9,"currentStage":224,"position":524,"attributes":525},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[268],[270],{"id":527,"viewCount":57,"searchKey":528,"visible":14},"10003515",{"type":10,"entryId":529,"sortOrder":530,"name":531,"imageUrl":532,"description":533,"currentMorphology":9,"currentStage":91,"position":534,"attributes":535},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[203],[311],{"id":537,"viewCount":57,"searchKey":538,"visible":14},"10003496",{"type":10,"entryId":539,"sortOrder":540,"name":541,"imageUrl":542,"description":543,"currentMorphology":9,"currentStage":224,"position":544,"attributes":545},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[203],[311],{"id":547,"viewCount":57,"searchKey":548,"visible":14},"10003378",{"type":10,"entryId":549,"sortOrder":550,"name":551,"imageUrl":552,"description":553,"currentMorphology":9,"currentStage":224,"position":554,"attributes":555},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[268],[311],{"id":557,"viewCount":57,"searchKey":558,"visible":14},"10003456",{"type":10,"entryId":559,"sortOrder":560,"name":561,"imageUrl":562,"description":563,"currentMorphology":9,"currentStage":91,"position":564,"attributes":565},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[236],[311],{"id":567,"viewCount":57,"searchKey":568,"visible":14},"10003374",{"type":10,"entryId":569,"sortOrder":570,"name":571,"imageUrl":572,"description":573,"currentMorphology":9,"currentStage":224,"position":574,"attributes":575},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[268],[25],{"id":577,"viewCount":57,"searchKey":578,"visible":14},"10003443",{"type":10,"entryId":579,"sortOrder":580,"name":581,"imageUrl":582,"description":583,"currentMorphology":9,"currentStage":224,"position":584,"attributes":585},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[236],[311],{"id":587,"viewCount":57,"searchKey":588,"visible":14},"10003503",{"type":10,"entryId":589,"sortOrder":590,"name":591,"imageUrl":592,"description":593,"currentMorphology":9,"currentStage":91,"position":594,"attributes":595},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[268],[238],{"id":597,"viewCount":57,"searchKey":598,"visible":14},"10003521",{"type":10,"entryId":599,"sortOrder":600,"name":601,"imageUrl":602,"description":603,"currentMorphology":9,"currentStage":224,"position":604,"attributes":605},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[268],[238],{"id":607,"viewCount":57,"searchKey":608,"visible":14},"10003508",{"type":10,"entryId":609,"sortOrder":610,"name":611,"imageUrl":612,"description":613,"currentMorphology":9,"currentStage":91,"position":614,"attributes":615},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[203],[238],{"id":617,"viewCount":57,"searchKey":618,"visible":14},"10003369",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":9,"currentStage":224,"position":624,"attributes":625},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[203],[238],{"id":627,"viewCount":57,"searchKey":628,"visible":14},"10003501",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":9,"currentStage":224,"position":634,"attributes":635},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[203],[25],{"id":637,"viewCount":57,"searchKey":638,"visible":14},"10003422",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":9,"currentStage":91,"position":644,"attributes":645},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[203],[354],{"id":647,"viewCount":57,"searchKey":648,"visible":14},"10003575",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":9,"currentStage":140,"position":654,"attributes":655},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[203],[354],{"id":657,"viewCount":57,"searchKey":658,"visible":14},"10003415",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":9,"currentStage":224,"position":664,"attributes":665},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[203],[354],{"id":667,"viewCount":57,"searchKey":668,"visible":14},"10003524",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":9,"currentStage":91,"position":674,"attributes":675},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[236],[25],{"id":677,"viewCount":57,"searchKey":678,"visible":14},"10003475",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":9,"currentStage":224,"position":684,"attributes":685},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[236],[25],{"id":687,"viewCount":57,"searchKey":688,"visible":14},"10003523",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":9,"currentStage":91,"position":694,"attributes":695},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[236],[333],{"id":697,"viewCount":57,"searchKey":698,"visible":14},"10003398",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":9,"currentStage":140,"position":704,"attributes":705},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[236],[333],{"id":707,"viewCount":57,"searchKey":708,"visible":14},"10003516",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":9,"currentStage":224,"position":714,"attributes":715},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[268],[333],{"id":717,"viewCount":57,"searchKey":718,"visible":14},"10003566",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":9,"currentStage":224,"position":724,"attributes":725},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[236],[333],{"id":727,"viewCount":57,"searchKey":728,"visible":14},"10003453",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":9,"currentStage":91,"position":734,"attributes":735},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[203],[333],{"id":737,"viewCount":57,"searchKey":738,"visible":14},"10003577",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":9,"currentStage":140,"position":744,"attributes":745},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[203],[333],{"id":747,"viewCount":57,"searchKey":748,"visible":14},"10003570",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":9,"currentStage":224,"position":754,"attributes":755},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[203],[333],{"id":757,"viewCount":57,"searchKey":758,"visible":14},"10003565",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":9,"currentStage":91,"position":764,"attributes":765},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[203],[435],{"id":767,"viewCount":57,"searchKey":768,"visible":14},"10003476",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":9,"currentStage":224,"position":774,"attributes":775},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[203],[435],{"id":777,"viewCount":57,"searchKey":778,"visible":14},"10003466",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":9,"currentStage":224,"position":784,"attributes":785},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[268],[435],{"id":787,"viewCount":57,"searchKey":788,"visible":14},"10003379",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":9,"currentStage":91,"position":794,"attributes":795},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[203],[25],{"id":797,"viewCount":57,"searchKey":798,"visible":14},"10003376",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":9,"currentStage":224,"position":804,"attributes":805},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[203],[25],{"id":807,"viewCount":57,"searchKey":808,"visible":14},"10003543",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":9,"currentStage":91,"position":814,"attributes":815},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[236],[238],{"id":817,"viewCount":57,"searchKey":818,"visible":14},"10003557",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":9,"currentStage":224,"position":824,"attributes":825},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[203],[238],{"id":827,"viewCount":57,"searchKey":828,"visible":14},"10003522",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":9,"currentStage":224,"position":834,"attributes":835},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[236],[238],{"id":837,"viewCount":57,"searchKey":838,"visible":14},"10003579",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":9,"currentStage":91,"position":844,"attributes":845},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[236],[270],{"id":847,"viewCount":57,"searchKey":848,"visible":14},"10003389",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":9,"currentStage":140,"position":854,"attributes":855},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[236],[270],{"id":857,"viewCount":57,"searchKey":858,"visible":14},"10003536",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":9,"currentStage":224,"position":864,"attributes":865},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[236],[270],{"id":867,"viewCount":57,"searchKey":868,"visible":14},"10003529",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":9,"currentStage":224,"position":874,"attributes":875},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[203],[205],{"id":877,"viewCount":57,"searchKey":878,"visible":14},"10003433",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":9,"currentStage":91,"position":884,"attributes":885},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[203],[435],{"id":887,"viewCount":57,"searchKey":888,"visible":14},"10003427",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":9,"currentStage":224,"position":894,"attributes":895},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[203],[435],{"id":897,"viewCount":57,"searchKey":898,"visible":14},"10003405",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":9,"currentStage":91,"position":904,"attributes":905},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[236],[435],{"id":907,"viewCount":57,"searchKey":908,"visible":14},"10003525",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":9,"currentStage":140,"position":914,"attributes":915},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[236],[205,435],{"id":917,"viewCount":57,"searchKey":918,"visible":14},"10003399",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":9,"currentStage":224,"position":924,"attributes":925},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[236],[205,435],{"id":927,"viewCount":57,"searchKey":928,"visible":14},"10003518",{"type":10,"entryId":929,"sortOrder":930,"name":931,"imageUrl":932,"description":933,"currentMorphology":9,"currentStage":140,"position":934,"attributes":935},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[236],[435],{"id":937,"viewCount":57,"searchKey":938,"visible":14},"10003393",{"type":10,"entryId":939,"sortOrder":940,"name":941,"imageUrl":942,"description":943,"currentMorphology":9,"currentStage":224,"position":944,"attributes":945},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[236],[435],{"id":947,"viewCount":57,"searchKey":948,"visible":14},"10003386",{"type":10,"entryId":949,"sortOrder":950,"name":951,"imageUrl":952,"description":953,"currentMorphology":9,"currentStage":91,"position":954,"attributes":955},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[268],[435],{"id":957,"viewCount":57,"searchKey":958,"visible":14},"10003447",{"type":10,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":9,"currentStage":224,"position":964,"attributes":965},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[268],[435],{"id":967,"viewCount":57,"searchKey":968,"visible":14},"10003497",{"type":10,"entryId":969,"sortOrder":970,"name":971,"imageUrl":972,"description":973,"currentMorphology":9,"currentStage":91,"position":974,"attributes":975},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[268],[25],{"id":977,"viewCount":57,"searchKey":978,"visible":14},"10003479",{"type":10,"entryId":979,"sortOrder":980,"name":981,"imageUrl":982,"description":983,"currentMorphology":9,"currentStage":140,"position":984,"attributes":985},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[268],[25],{"id":987,"viewCount":57,"searchKey":988,"visible":14},"10003388",{"type":10,"entryId":989,"sortOrder":990,"name":991,"imageUrl":992,"description":993,"currentMorphology":9,"currentStage":224,"position":994,"attributes":995},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[268],[25],{"id":997,"viewCount":57,"searchKey":998,"visible":14},"10003429",{"type":10,"entryId":999,"sortOrder":1000,"name":1001,"imageUrl":1002,"description":1003,"currentMorphology":9,"currentStage":91,"position":1004,"attributes":1005},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[23],[333],{"id":5,"viewCount":57,"searchKey":1007,"visible":14},{"type":10,"entryId":8,"sortOrder":1008,"name":1009,"imageUrl":1010,"description":1011,"currentMorphology":9,"currentStage":224,"position":1012,"attributes":1013},1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[23],[333],{"id":4,"viewCount":57,"searchKey":1015,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1016,"attributes":1017},[23],[25],{"id":6,"viewCount":57,"searchKey":1019,"visible":14},{"type":10,"entryId":12,"sortOrder":1020,"name":1021,"imageUrl":1022,"description":1023,"currentMorphology":9,"currentStage":91,"position":1024,"attributes":1025},1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[23],[435,333],{"id":1027,"viewCount":57,"searchKey":1028,"visible":14},"10003486",{"type":10,"entryId":1029,"sortOrder":1030,"name":1031,"imageUrl":1032,"description":1033,"currentMorphology":9,"currentStage":224,"position":1034,"attributes":1035},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[23],[435,333],{"id":1037,"viewCount":57,"searchKey":1038,"visible":14},"10003530",{"type":10,"entryId":1039,"sortOrder":1040,"name":1041,"imageUrl":1042,"description":1043,"currentMorphology":9,"currentStage":91,"position":1044,"attributes":1045},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[236],[354],{"id":1047,"viewCount":57,"searchKey":1048,"visible":14},"10003457",{"type":10,"entryId":1049,"sortOrder":1050,"name":1051,"imageUrl":1052,"description":1053,"currentMorphology":9,"currentStage":224,"position":1054,"attributes":1055},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[236],[354],{"id":1057,"viewCount":57,"searchKey":1058,"visible":14},"10003423",{"type":10,"entryId":1059,"sortOrder":1060,"name":1061,"imageUrl":1062,"description":1063,"currentMorphology":9,"currentStage":91,"position":1064,"attributes":1065},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[331],[311,333],{"id":1067,"viewCount":57,"searchKey":1068,"visible":14},"10003419",{"type":10,"entryId":1069,"sortOrder":1070,"name":1071,"imageUrl":1072,"description":1073,"currentMorphology":9,"currentStage":224,"position":1074,"attributes":1075},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[331],[311,333],{"id":1077,"viewCount":57,"searchKey":1078,"visible":14},"10003410",{"type":10,"entryId":1079,"sortOrder":1080,"name":1081,"imageUrl":1082,"description":1083,"currentMorphology":9,"currentStage":91,"position":1084,"attributes":1085},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[203],[333],{"id":1087,"viewCount":57,"searchKey":1088,"visible":14},"10003509",{"type":10,"entryId":1089,"sortOrder":1090,"name":1091,"imageUrl":1092,"description":1093,"currentMorphology":9,"currentStage":224,"position":1094,"attributes":1095},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[203],[333],{"id":1097,"viewCount":57,"searchKey":1098,"visible":14},"10003413",{"type":10,"entryId":1099,"sortOrder":1100,"name":1101,"imageUrl":1102,"description":1103,"currentMorphology":9,"currentStage":91,"position":1104,"attributes":1105},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[203],[354],{"id":1107,"viewCount":57,"searchKey":1108,"visible":14},"10003407",{"type":10,"entryId":1109,"sortOrder":1110,"name":1111,"imageUrl":1112,"description":1113,"currentMorphology":9,"currentStage":224,"position":1114,"attributes":1115},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[203],[354],{"id":1117,"viewCount":57,"searchKey":1118,"visible":14},"10003498",{"type":10,"entryId":1119,"sortOrder":1120,"name":1121,"imageUrl":1122,"description":1123,"currentMorphology":9,"currentStage":21,"position":1124,"attributes":1125},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[203],[1126],"attributes-holy",{"id":1128,"viewCount":57,"searchKey":1129,"visible":14},"10003375",{"type":10,"entryId":1130,"sortOrder":1131,"name":1132,"imageUrl":1133,"description":1134,"currentMorphology":9,"currentStage":21,"position":1135,"attributes":1136},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[203],[1126],[1138,1146,1151,1156,1161,1166,1171,1176,1180,1185,1190,1195,1200,1205,1210,1215,1220,1225,1228],{"id":1139,"parentId":1140,"tagType":1141,"tagKey":1142,"name":1143,"language":1144,"sort":1145},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1147,"parentId":1140,"tagType":1141,"tagKey":1148,"name":1149,"language":1144,"sort":1150},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1152,"parentId":1140,"tagType":1141,"tagKey":1153,"name":1154,"language":1144,"sort":1155