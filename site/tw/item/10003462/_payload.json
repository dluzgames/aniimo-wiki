children":61},"91268492_24","circle",{"id":149,"customKey":48,"icon":150,"iconStyle":100,"iconTitle":48,"descTitle":151,"descContent":152,"source":153},"91268492_25","/cdn/init/1016200_Skill_9400091_Icon.png","鑽地","進入「縮地」狀態，持續消耗體力，可以免疫遠程攻擊，但是會被地震類型的技能擊飛。",{"attributes":154,"type":155,"consume":48,"power":48},[],[],{"id":157,"type":64,"props":158,"children":161},"91268492_26",{"title":159,"type":67,"id":160,"isUse":15,"isEdit":15,"useTabs":69,"blackHeader":69},"伊莫特性","91268492_27",[162],{"id":163,"type":147,"props":164,"children":61},"91268492_28",{"id":165,"customKey":48,"icon":166,"iconStyle":67,"iconTitle":48,"descTitle":167,"descContent":168,"source":169},"91268492_29","/cdn/init/1016200_Feature_116101_Icon.png","蟄伏","技能造成傷害時累積「氣勢」，最多6層，縮地期間效率翻倍。滿層時擊破效率提升30%，持續15秒。",{"attributes":170,"type":171,"consume":48,"power":48},[],[],{"id":173,"type":64,"props":174,"children":61},"91268492_30",{"title":175,"type":67,"id":176,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":69,"tabs":177},"技能介紹","91268492_31",[178,232],{"id":179,"title":180,"children":181},"91268492_32","戰鬥技能",[182,196,208,220],{"id":183,"type":147,"props":184},"91268492_33",{"id":185,"customKey":48,"icon":186,"iconStyle":67,"iconTitle":48,"descTitle":187,"descContent":188,"source":189},"91268492_34","/cdn/init/1016200_Skill_10800320_Icon.png","砂礫旋舞","讓砂礫圍著身體旋轉，持續造成傷害並附加「土元素異常」，持續6秒。",{"attributes":190,"type":192,"consume":194,"power":195},[191],"8",[193],"2","10","35",{"id":197,"type":147,"props":198},"91268492_35",{"id":199,"customKey":48,"icon":200,"iconStyle":67,"iconTitle":48,"descTitle":201,"descContent":202,"source":203},"91268492_36","/cdn/init/1016200_Skill_10800051_Icon.png","蓄勢重擊","舉起鉗子開始蓄力，蓄力完畢或是再次施放技能時進行兩次快速揮擊，攻擊並短暫暈眩目標。可消耗3層「土元素異常」，並額外造成20%威力的效果。蓄力期間可以移動。",{"attributes":204,"type":205,"consume":206,"power":207},[191],[134],"30","75",{"id":209,"type":147,"props":210},"91268492_37",{"id":211,"customKey":48,"icon":212,"iconStyle":67,"iconTitle":48,"descTitle":213,"descContent":214,"source":215},"91268492_38","/cdn/init/1016200_Skill_10600060_Icon.png","飛葉舞","讓葉片圍繞身體旋轉，持續造成傷害，持續6秒。",{"attributes":216,"type":218,"consume":194,"power":219},[217],"6",[193],"40",{"id":221,"type":147,"props":222},"91268492_39",{"id":223,"customKey":48,"icon":224,"iconStyle":67,"iconTitle":48,"descTitle":225,"descContent":226,"source":227},"91268492_40","/cdn/init/1016200_Skill_10600520_Icon.png","綠意光束","朝向鏡頭方向發射能量光束，持續對範圍內的敵人造成傷害。連續命中會逐漸提升威力。",{"attributes":228,"type":229,"consume":230,"power":231},[217],[193],"20","66",{"id":233,"title":234,"children":235},"91268492_41","固有技能",[236,248],{"id":237,"type":147,"props":238},"91268492_42",{"id":239,"customKey":48,"icon":240,"iconStyle":67,"iconTitle":48,"descTitle":241,"descContent":242,"source":243},"91268492_43","/cdn/init/1016200_Skill_10800070_Icon.png","裂地衝擊","猛力震裂地面，造成大範圍的衝擊波。",{"attributes":244,"type":245,"consume":246,"power":247},[191],[134],"0","173",{"id":249,"type":147,"props":250},"91268492_44",{"id":251,"customKey":48,"icon":252,"iconStyle":67,"iconTitle":48,"descTitle":253,"descContent":254,"source":255},"91268492_45","/cdn/init/1016200_Skill_16600000_Icon.png","攻擊","擊破使用土元素能力，近距離攻擊目標。",{"attributes":256,"type":257,"consume":246,"power":217},[191],[134],[259,260,261,264],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":262,"entryId":12,"currentMorphology":263,"visible":15},"10003502","Beach Form",{"id":265,"entryId":12,"currentMorphology":9,"visible":15},"10003408",[267,279,289,299,310,320,330,342,352,362,372,382,392,404,414,425,436,446,456,466,476,486,496,504,508,517,527,537,547,557,567,577,587,597,607,617,627,638,648,658,668,678,688,698,708,718,728,738,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,908,918,928,938,948,958,968,978,988,998,1008,1018,1028,1038,1048,1058,1068,1078,1088,1098,1108,1118,1128,1138,1148,1158,1168,1178,1188,1199],{"id":268,"viewCount":61,"searchKey":269,"visible":15},"10003442",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":21,"currentStage":134,"position":275,"attributes":277},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[276],"position-dps",[278],"attributes-fire",{"id":280,"viewCount":61,"searchKey":281,"visible":15},"10003534",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":21,"currentStage":193,"position":287,"attributes":288},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[276],[278],{"id":290,"viewCount":61,"searchKey":291,"visible":15},"10003435",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":21,"currentStage":22,"position":297,"attributes":298},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[276],[278],{"id":300,"viewCount":61,"searchKey":301,"visible":15},"10003428",{"type":10,"entryId":302,"sortOrder":303,"name":304,"imageUrl":305,"description":306,"currentMorphology":21,"currentStage":22,"position":307,"attributes":308},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[24],[278,309],"attributes-dark",{"id":311,"viewCount":61,"searchKey":312,"visible":15},"10003578",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":21,"currentStage":134,"position":318,"attributes":319},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[276],[309],{"id":321,"viewCount":61,"searchKey":322,"visible":15},"10003417",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":21,"currentStage":22,"position":328,"attributes":329},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[276],[309],{"id":331,"viewCount":61,"searchKey":332,"visible":15},"10003488",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":21,"currentStage":134,"position":338,"attributes":340},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[339],"position-sup",[341],"attributes-wind",{"id":343,"viewCount":61,"searchKey":344,"visible":15},"10003548",{"type":10,"entryId":345,"sortOrder":346,"name":347,"imageUrl":348,"description":349,"currentMorphology":21,"currentStage":22,"position":350,"attributes":351},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[339],[341],{"id":353,"viewCount":61,"searchKey":354,"visible":15},"10003474",{"type":10,"entryId":355,"sortOrder":356,"name":357,"imageUrl":358,"description":359,"currentMorphology":21,"currentStage":22,"position":360,"attributes":361},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[276],[341],{"id":363,"viewCount":61,"searchKey":364,"visible":15},"10003467",{"type":10,"entryId":365,"sortOrder":366,"name":367,"imageUrl":368,"description":369,"currentMorphology":21,"currentStage":22,"position":370,"attributes":371},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[24],[341],{"id":373,"viewCount":61,"searchKey":374,"visible":15},"10003392",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":21,"currentStage":134,"position":380,"attributes":381},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[276],[27],{"id":383,"viewCount":61,"searchKey":384,"visible":15},"10003510",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":21,"currentStage":22,"position":390,"attributes":391},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[276],[27],{"id":393,"viewCount":61,"searchKey":394,"visible":15},"10003477",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":21,"currentStage":134,"position":400,"attributes":402},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[401],"position-heal",[403],"attributes-water",{"id":405,"viewCount":61,"searchKey":406,"visible":15},"10003569",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":21,"currentStage":193,"position":412,"attributes":413},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[401],[403],{"id":415,"viewCount":61,"searchKey":416,"visible":15},"10003470",{"type":10,"entryId":417,"sortOrder":418,"name":419,"imageUrl":420,"description":421,"currentMorphology":21,"currentStage":22,"position":422,"attributes":423},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[401],[403,424],"attributes-ice",{"id":426,"viewCount":61,"searchKey":427,"visible":15},"10003463",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":21,"currentStage":22,"position":433,"attributes":435},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[434],"position-energy",[27,403],{"id":437,"viewCount":61,"searchKey":438,"visible":15},"10003468",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":21,"currentStage":134,"position":444,"attributes":445},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[339],[341],{"id":447,"viewCount":61,"searchKey":448,"visible":15},"10003365",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":21,"currentStage":22,"position":454,"attributes":455},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[339],[341],{"id":457,"viewCount":61,"searchKey":458,"visible":15},"10003461",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":21,"currentStage":22,"position":464,"attributes":465},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[339],[309],{"id":467,"viewCount":61,"searchKey":468,"visible":15},"10003421",{"type":10,"entryId":469,"sortOrder":470,"name":471,"imageUrl":472,"description":473,"currentMorphology":21,"currentStage":134,"position":474,"attributes":475},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[24],[27],{"id":477,"viewCount":61,"searchKey":478,"visible":15},"10003414",{"type":10,"entryId":479,"sortOrder":480,"name":481,"imageUrl":482,"description":483,"currentMorphology":21,"currentStage":22,"position":484,"attributes":485},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[434],[309,27],{"id":487,"viewCount":61,"searchKey":488,"visible":15},"10003404",{"type":10,"entryId":489,"sortOrder":490,"name":491,"imageUrl":492,"description":493,"currentMorphology":21,"currentStage":22,"position":494,"attributes":495},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[24],[27],{"id":497,"viewCount":61,"searchKey":498,"visible":15},"10003567",{"type":10,"entryId":8,"sortOrder":499,"name":77,"imageUrl":500,"description":501,"currentMorphology":21,"currentStage":134,"position":502,"attributes":503},1016100,"/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[24],[26,27],{"id":4,"viewCount":61,"searchKey":505,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":506,"attributes":507},[24],[26,27],{"id":509,"viewCount":61,"searchKey":510,"visible":15},"10003551",{"type":10,"entryId":511,"sortOrder":512,"name":84,"imageUrl":513,"description":514,"currentMorphology":21,"currentStage":22,"position":515,"attributes":516},"026",1016300,"/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[24],[424],{"id":518,"viewCount":61,"searchKey":519,"visible":15},"10003409",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":21,"currentStage":134,"position":525,"attributes":526},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[434],[278],{"id":528,"viewCount":61,"searchKey":529,"visible":15},"10003507",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":21,"currentStage":22,"position":535,"attributes":536},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[434],[278],{"id":538,"viewCount":61,"searchKey":539,"visible":15},"10003542",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":21,"currentStage":134,"position":545,"attributes":546},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[401],[341],{"id":548,"viewCount":61,"searchKey":549,"visible":15},"10003440",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":21,"currentStage":22,"position":555,"attributes":556},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[401],[341],{"id":558,"viewCount":61,"searchKey":559,"visible":15},"10003563",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":21,"currentStage":246,"position":565,"attributes":566},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[434],[341,27],{"id":568,"viewCount":61,"searchKey":569,"visible":15},"10003368",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":21,"currentStage":134,"position":575,"attributes":576},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[339],[341],{"id":578,"viewCount":61,"searchKey":579,"visible":15},"10003363",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":21,"currentStage":22,"position":585,"attributes":586},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[339],[341],{"id":588,"viewCount":61,"searchKey":589,"visible":15},"10003515",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":21,"currentStage":134,"position":595,"attributes":596},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[276],[27],{"id":598,"viewCount":61,"searchKey":599,"visible":15},"10003496",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":21,"currentStage":22,"position":605,"attributes":606},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[276],[27],{"id":608,"viewCount":61,"searchKey":609,"visible":15},"10003378",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":21,"currentStage":22,"position":615,"attributes":616},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[339],[27],{"id":618,"viewCount":61,"searchKey":619,"visible":15},"10003456",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":21,"currentStage":134,"position":625,"attributes":626},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[24],[27],{"id":628,"viewCount":61,"searchKey":629,"visible":15},"10003374",{"type":10,"entryId":630,"sortOrder":631,"name":632,"imageUrl":633,"description":634,"currentMorphology":21,"currentStage":22,"position":635,"attributes":636},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[339],[637],"attributes-electric",{"id":639,"viewCount":61,"searchKey":640,"visible":15},"10003443",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":21,"currentStage":22,"position":646,"attributes":647},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[24],[27],{"id":649,"viewCount":61,"searchKey":650,"visible":15},"10003503",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":21,"currentStage":134,"position":656,"attributes":657},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[339],[309],{"id":659,"viewCount":61,"searchKey":660,"visible":15},"10003521",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":21,"currentStage":22,"position":666,"attributes":667},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[339],[309],{"id":669,"viewCount":61,"searchKey":670,"visible":15},"10003508",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":21,"currentStage":134,"position":676,"attributes":677},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[276],[309],{"id":679,"viewCount":61,"searchKey":680,"visible":15},"10003369",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":21,"currentStage":22,"position":686,"attributes":687},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[276],[309],{"id":689,"viewCount":61,"searchKey":690,"visible":15},"10003501",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":21,"currentStage":22,"position":696,"attributes":697},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[276],[637],{"id":699,"viewCount":61,"searchKey":700,"visible":15},"10003422",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":21,"currentStage":134,"position":706,"attributes":707},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[276],[424],{"id":709,"viewCount":61,"searchKey":710,"visible":15},"10003575",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":21,"currentStage":193,"position":716,"attributes":717},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[276],[424],{"id":719,"viewCount":61,"searchKey":720,"visible":15},"10003415",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":21,"currentStage":22,"position":726,"attributes":727},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[276],[424],{"id":729,"viewCount":61,"searchKey":730,"visible":15},"10003524",{"type":10,"entryId":731,"sortOrder":732,"name":733,"imageUrl":734,"description":735,"currentMorphology":21,"currentStage":134,"position":736,"attributes":737},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[24],[637],{"id":739,"viewCount":61,"searchKey":740,"visible":15},"10003475",{"type":10,"entryId":741,"sortOrder":742,"name":743,"imageUrl":744,"description":745,"currentMorphology":21,"currentStage":22,"position":746,"attributes":747},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[24],[637],{"id":749,"viewCount":61,"searchKey":750,"visible":15},"10003523",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":21,"currentStage":134,"position":756,"attributes":757},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[24],[403],{"id":759,"viewCount":61,"searchKey":760,"visible":15},"10003398",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":21,"currentStage":193,"position":766,"attributes":767},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[24],[403],{"id":769,"viewCount":61,"searchKey":770,"visible":15},"10003516",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":21,"currentStage":22,"position":776,"attributes":777},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[339],[403],{"id":779,"viewCount":61,"searchKey":780,"visible":15},"10003566",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":21,"currentStage":22,"position":786,"attributes":787},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[24],[403],{"id":789,"viewCount":61,"searchKey":790,"visible":15},"10003453",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":21,"currentStage":134,"position":796,"attributes":797},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[276],[403],{"id":799,"viewCount":61,"searchKey":800,"visible":15},"10003577",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":21,"currentStage":193,"position":806,"attributes":807},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[276],[403],{"id":809,"viewCount":61,"searchKey":810,"visible":15},"10003570",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":21,"currentStage":22,"position":816,"attributes":817},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[276],[403],{"id":819,"viewCount":61,"searchKey":820,"visible":15},"10003565",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":21,"currentStage":134,"position":826,"attributes":827},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[276],[26],{"id":829,"viewCount":61,"searchKey":830,"visible":15},"10003476",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":21,"currentStage":22,"position":836,"attributes":837},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[276],[26],{"id":839,"viewCount":61,"searchKey":840,"visible":15},"10003466",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":21,"currentStage":22,"position":846,"attributes":847},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[339],[26],{"id":849,"viewCount":61,"searchKey":850,"visible":15},"10003379",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":21,"currentStage":134,"position":856,"attributes":857},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[276],[637],{"id":859,"viewCount":61,"searchKey":860,"visible":15},"10003376",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":21,"currentStage":22,"position":866,"attributes":867},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[276],[637],{"id":869,"viewCount":61,"searchKey":870,"visible":15},"10003543",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":21,"currentStage":134,"position":876,"attributes":877},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[24],[309],{"id":879,"viewCount":61,"searchKey":880,"visible":15},"10003557",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":21,"currentStage":22,"position":886,"attributes":887},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[276],[309],{"id":889,"viewCount":61,"searchKey":890,"visible":15},"10003522",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":21,"currentStage":22,"position":896,"attributes":897},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[24],[309],{"id":899,"viewCount":61,"searchKey":900,"visible":15},"10003579",{"type":10,"entryId":901,"sortOrder":902,"name":903,"imageUrl":904,"description":905,"currentMorphology":21,"currentStage":134,"position":906,"attributes":907},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[24],[341],{"id":909,"viewCount":61,"searchKey":910,"visible":15},"10003389",{"type":10,"entryId":911,"sortOrder":912,"name":913,"imageUrl":914,"description":915,"currentMorphology":21,"currentStage":193,"position":916,"attributes":917},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[24],[341],{"id":919,"viewCount":61,"searchKey":920,"visible":15},"10003536",{"type":10,"entryId":921,"sortOrder":922,"name":923,"imageUrl":924,"description":925,"currentMorphology":21,"currentStage":22,"position":926,"attributes":927},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[24],[341],{"id":929,"viewCount":61,"searchKey":930,"visible":15},"10003529",{"type":10,"entryId":931,"sortOrder":932,"name":933,"imageUrl":934,"description":935,"currentMorphology":21,"currentStage":22,"position":936,"attributes":937},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[276],[278],{"id":939,"viewCount":61,"searchKey":940,"visible":15},"10003433",{"type":10,"entryId":941,"sortOrder":942,"name":943,"imageUrl":944,"description":945,"currentMorphology":21,"currentStage":134,"position":946,"attributes":947},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[276],[26],{"id":949,"viewCount":61,"searchKey":950,"visible":15},"10003427",{"type":10,"entryId":951,"sortOrder":952,"name":953,"imageUrl":954,"description":955,"currentMorphology":21,"currentStage":22,"position":956,"attributes":957},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[276],[26],{"id":959,"viewCount":61,"searchKey":960,"visible":15},"10003405",{"type":10,"entryId":961,"sortOrder":962,"name":963,"imageUrl":964,"description":965,"currentMorphology":21,"currentStage":134,"position":966,"attributes":967},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[24],[26],{"id":969,"viewCount":61,"searchKey":970,"visible":15},"10003525",{"type":10,"entryId":971,"sortOrder":972,"name":973,"imageUrl":974,"description":975,"currentMorphology":21,"currentStage":193,"position":976,"attributes":977},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[24],[278,26],{"id":979,"viewCount":61,"searchKey":980,"visible":15},"10003399",{"type":10,"entryId":981,"sortOrder":982,"name":983,"imageUrl":984,"description":985,"currentMorphology":21,"currentStage":22,"position":986,"attributes":987},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[24],[278,26],{"id":989,"viewCount":61,"searchKey":990,"visible":15},"10003518",{"type":10,"entryId":991,"sortOrder":992,"name":993,"imageUrl":994,"description":995,"currentMorphology":21,"currentStage":193,"position":996,"attributes":997},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[24],[26],{"id":999,"viewCount":61,"searchKey":1000,"visible":15},"10003393",{"type":10,"entryId":1001,"sortOrder":1002,"name":1003,"imageUrl":1004,"description":1005,"currentMorphology":21,"currentStage":22,"position":1006,"attributes":1007},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[24],[26],{"id":1009,"viewCount":61,"searchKey":1010,"visible":15},"10003386",{"type":10,"entryId":1011,"sortOrder":1012,"name":1013,"imageUrl":1014,"description":1015,"currentMorphology":21,"currentStage":134,"position":1016,"attributes":1017},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[339],[26],{"id":1019,"viewCount":61,"searchKey":1020,"visible":15},"10003447",{"type":10,"entryId":1021,"sortOrder":1022,"name":1023,"imageUrl":1024,"description":1025,"currentMorphology":21,"currentStage":22,"position":1026,"attributes":1027},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[339],[26],{"id":1029,"viewCount":61,"searchKey":1030,"visible":15},"10003497",{"type":10,"entryId":1031,"sortOrder":1032,"name":1033,"imageUrl":1034,"description":1035,"currentMorphology":21,"currentStage":134,"position":1036,"attributes":1037},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[339],[637],{"id":1039,"viewCount":61,"searchKey":1040,"visible":15},"10003479",{"type":10,"entryId":1041,"sortOrder":1042,"name":1043,"imageUrl":1044,"description":1045,"currentMorphology":21,"currentStage":193,"position":1046,"attributes":1047},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[339],[637],{"id":1049,"viewCount":61,"searchKey":1050,"visible":15},"10003388",{"type":10,"entryId":1051,"sortOrder":1052,"name":1053,"imageUrl":1054,"description":1055,"currentMorphology":21,"currentStage":22,"position":1056,"attributes":1057},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[339],[637],{"id":1059,"viewCount":61,"searchKey":1060,"visible":15},"10003429",{"type":10,"entryId":1061,"sortOrder":1062,"name":1063,"imageUrl":1064,"description":1065,"currentMorphology":21,"currentStage":134,"position":1066,"attributes":1067},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[434],[403],{"id":1069,"viewCount":61,"searchKey":1070,"visible":15},"10003430",{"type":10,"entryId":1071,"sortOrder":1072,"name":1073,"imageUrl":1074,"description":1075,"currentMorphology":21,"currentStage":22,"position":1076,"attributes":1077},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[434],[403],{"id":1079,"viewCount":61,"searchKey":1080,"visible":15},"10003549",{"type":10,"entryId":1081,"sortOrder":1082,"name":1083,"imageUrl":1084,"description":1085,"currentMorphology":21,"currentStage":246,"position":1086,"attributes":1087},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[434],[637],{"id":1089,"viewCount":61,"searchKey":1090,"visible":15},"10003494",{"type":10,"entryId":1091,"sortOrder":1092,"name":1093,"imageUrl":1094,"description":1095,"currentMorphology":21,"currentStage":134,"position":1096,"attributes":1097},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[434],[26,403],{"id":1099,"viewCount":61,"searchKey":1100,"visible":15},"10003486",{"type":10,"entryId":1101,"sortOrder":1102,"name":1103,"imageUrl":1104,"description":1105,"currentMorphology":21,"currentStage":22,"position":1106,"attributes":1107},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[434],[26,403],{"id":1109,"viewCount":61,"searchKey":1110,"visible":15},"10003530",{"type":10,"entryId":1111,"sortOrder":1112,"name":1113,"imageUrl":1114,"description":1115,"currentMorphology":21,"currentStage":134,"position":1116,"attributes":1117},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[24],[424],{"id":1119,"viewCount":61,"searchKey":1120,"visible":15},"10003457",{"type":10,"entryId":1121,"sortOrder":1122,"name":1123,"imageUrl":1124,"description":1125,"currentMorphology":21,"currentStage":22,"position":1126,"attributes":1127},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[24],[424],{"id":1129,"viewCount":61,"searchKey":1130,"visible":15},"10003423",{"type":10,"entryId":1131,"sortOrder":1132,"name":1133,"imageUrl":1134,"description":1135,"currentMorphology":21,"currentStage":134,"position":1136,"attributes":1137},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[401],[27,403],{"id":1139,"viewCount":61,"searchKey":1140,"visible":15},"10003419",{"type":10,"entryId":1141,"sortOrder":1142,"name":1143,"imageUrl":1144,"description":1145,"currentMorphology":21,"currentStage":22,"position":1146,"attributes":1147},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[401],[27,403],{"id":1149,"viewCount":61,"searchKey":1150,"visible":15},"10003410",{"type":10,"entryId":1151,"sortOrder":1152,"name":1153,"imageUrl":1154,"description":1155,"currentMorphology":21,"currentStage":134,"position":1156,"attributes":1157},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[276],[403],{"id":1159,"viewCount":61,"searchKey":1160,"visible":15},"10003509",{"type":10,"entryId":1161,"sortOrder":1162,"name":1163,"imageUrl":1164,"description":1165,"currentMorphology":21,"currentStage":22,"position":1166,"attributes":1167},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[276],[403],{"id":1169,"viewCount":61,"searchKey":1170,"visible":15},"10003413",{"type":10,"entryId":1171,"sortOrder":1172,"name":1173,"imageUrl":1174,"description":1175,"currentMorphology":21,"currentStage":134,"position":1176,"attributes":1177},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[276],[424],{"id":1179,"viewCount":61,"searchKey":1180,"visible":15},"10003407",{"type":10,"entryId":1181,"sortOrder":1182,"name":1183,"imageUrl":1184,"description":1185,"currentMorphology":21,"currentStage":22,"position":1186,"attributes":1187},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[276],[424],{"id":1189,"viewCount":61,"searchKey":1190,"visible":15},"10003498",{"type":10,"entryId":1191,"sortOrder":1192,"name":1193,"imageUrl":1194,"description":1195,"currentMorphology":21,"currentStage":246,"position":1196,"attributes":1197},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[276],[1198],"attributes-holy",{"id":1200,"viewCount":61,"searchKey":1201,"visible":15},"10003375",{"type":10,"entryId":1202,"sortOrder":1203,"name":1204,"imageUrl":1205,"description":1206,"currentMorphology":21,"currentStage":246,"position":1207,"attributes":1208},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[276],[1198],[1210,1218,1223,1228,1233,1237,1242,1247,1251,1255,1260,1264,1269,1274,1279,1284,1289,1294,1297],{"id":1211,"parentId":1212,"tagType":1213,"tagKey":1214,"name":1215,"language":1216,"sor