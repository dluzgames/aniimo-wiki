2},"91268610_11","home-1008","3","spritePic",{"id":74,"type":67,"props":75,"children":55},"91268610_12",{"id":76,"customKey":77,"title":71,"icon":43,"bgColor":43,"fontColor":43,"type":72},"91268610_13","home-1101",{"id":79,"title":80,"components":81},2,"伊莫能力",[82,99,116],{"id":83,"type":58,"props":84,"children":87},"91268610_16",{"title":85,"type":61,"id":86,"isUse":14,"isEdit":14,"useTabs":63,"blackHeader":63},"探索技能","91268610_17",[88],{"id":89,"type":90,"props":91,"children":55},"91268610_18","circle",{"id":92,"customKey":43,"icon":93,"iconStyle":61,"iconTitle":43,"descTitle":94,"descContent":95,"source":96},"91268610_19","/cdn/init/1037300_Skill_9400107_Icon.png","疾行","進入「疾行」狀態，可以快速移動；持續消耗體力",{"attributes":97,"type":98,"consume":43,"power":43},[],[],{"id":100,"type":58,"props":101,"children":105},"91268610_20",{"title":102,"type":103,"id":104,"isUse":14,"isEdit":14,"useTabs":63,"blackHeader":63},"伊莫特性","big","91268610_21",[106],{"id":107,"type":90,"props":108,"children":55},"91268610_22",{"id":109,"customKey":43,"icon":110,"iconStyle":103,"iconTitle":43,"descTitle":111,"descContent":112,"source":113},"91268610_23","/cdn/init/1037300_Feature_13711_Icon.png","月之力","未存在元素剋制時，最終傷害額外提升20%。施放技能或終結技時會獲得4層「銀月之印」，每段普攻會消耗1層並額外造成100%傷害，同時回復自身0.5%生命值。",{"attributes":114,"type":115,"consume":43,"power":43},[],[],{"id":117,"type":58,"props":118,"children":55},"91268610_24",{"title":119,"type":103,"id":120,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":63,"tabs":121},"技能介紹","91268610_25",[122,172],{"id":123,"title":124,"children":125},"91268610_26","戰鬥技能",[126,140,149,161],{"id":127,"type":90,"props":128},"91268610_27",{"id":129,"customKey":43,"icon":130,"iconStyle":103,"iconTitle":43,"descTitle":131,"descContent":132,"source":133},"91268610_28","/cdn/init/1037100_Skill_11300080_Icon.png","圓月衝擊","向目標投下圓月引發爆炸，造成傷害。若命中擁有「狐之印」目標，以目標為中心額外造成10%的小範圍傷害。",{"attributes":134,"type":136,"consume":138,"power":139},[135],"13",[137],"2","15","45",{"id":141,"type":90,"props":142},"91268610_29",{"id":143,"customKey":43,"icon":43,"iconStyle":103,"iconTitle":43,"descTitle":144,"descContent":145,"source":146},"91268610_30","輝月洗禮","沐浴月亮光輝回復20點能量。",{"attributes":147,"type":148,"consume":21,"power":21},[135],[21],{"id":150,"type":90,"props":151},"91268610_31",{"id":152,"customKey":43,"icon":153,"iconStyle":103,"iconTitle":43,"descTitle":154,"descContent":155,"source":156},"91268610_32","/cdn/init/1037100_Skill_11300061_Icon.png","月蝕","對目標傾瀉月光之力，額外造成大量擊破傷害。",{"attributes":157,"type":158,"consume":159,"power":160},[135],[137],"20","60",{"id":162,"type":90,"props":163},"91268610_33",{"id":164,"customKey":43,"icon":165,"iconStyle":103,"iconTitle":43,"descTitle":166,"descContent":167,"source":168},"91268610_34","/cdn/init/1037100_Skill_11300071_Icon.png","輝光連彈","發出三個光元素飛彈攻擊敵人，優先攻擊不同目標。為命中目標附加【狐之印】：降低目標%光元素抗性，最多疊加3層，持續10秒。",{"attributes":169,"type":170,"consume":159,"power":171},[135],[137],"55",{"id":173,"title":174,"children":175},"91268610_35","固有技能",[176,187],{"id":177,"type":90,"props":178},"91268610_36",{"id":179,"customKey":43,"icon":180,"iconStyle":103,"iconTitle":43,"descTitle":181,"descContent":182,"source":183},"91268610_37","/cdn/init/1037100_Skill_14600000_Icon.png","攻擊","使用光元素能力，遠距離攻擊目標。",{"attributes":184,"type":185,"consume":21,"power":186},[135],[137],"6",{"id":188,"type":90,"props":189},"91268610_38",{"id":190,"customKey":43,"icon":191,"iconStyle":103,"iconTitle":43,"descTitle":192,"descContent":193,"source":194},"91268610_39","/cdn/init/1037100_Skill_11300091_Icon.png","聖月裁決","對周圍的目標進行「聖月裁決」，造成大量傷害，自身進化為「朧月狐」，同時自身傷害加深提升15%，持續至脫離戰鬥。並獲得4層「銀月之印」。",{"attributes":195,"type":196,"consume":21,"power":197},[135],[137],"167",[199],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[201,213,223,233,245,255,265,277,287,297,307,318,328,340,350,361,372,382,392,402,412,422,432,443,453,463,473,483,493,503,513,523,533,543,553,563,573,584,594,604,614,624,634,644,654,664,674,684,694,704,714,724,734,744,754,764,774,784,794,804,814,824,834,844,854,864,874,884,894,904,914,924,934,944,954,964,974,984,994,1004,1014,1024,1034,1044,1054,1064,1074,1084,1094,1104,1114,1124,1132,1136],{"id":202,"viewCount":55,"searchKey":203,"visible":14},"10003442",{"type":10,"entryId":204,"sortOrder":205,"name":206,"imageUrl":207,"description":208,"currentMorphology":9,"currentStage":209,"position":210,"attributes":211},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。","1",[23],[212],"attributes-fire",{"id":214,"viewCount":55,"searchKey":215,"visible":14},"10003534",{"type":10,"entryId":216,"sortOrder":217,"name":218,"imageUrl":219,"description":220,"currentMorphology":9,"currentStage":137,"position":221,"attributes":222},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[212],{"id":224,"viewCount":55,"searchKey":225,"visible":14},"10003435",{"type":10,"entryId":226,"sortOrder":227,"name":228,"imageUrl":229,"description":230,"currentMorphology":9,"currentStage":71,"position":231,"attributes":232},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[23],[212],{"id":234,"viewCount":55,"searchKey":235,"visible":14},"10003428",{"type":10,"entryId":236,"sortOrder":237,"name":238,"imageUrl":239,"description":240,"currentMorphology":9,"currentStage":71,"position":241,"attributes":243},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[242],"position-break",[212,244],"attributes-dark",{"id":246,"viewCount":55,"searchKey":247,"visible":14},"10003578",{"type":10,"entryId":248,"sortOrder":249,"name":250,"imageUrl":251,"description":252,"currentMorphology":9,"currentStage":209,"position":253,"attributes":254},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[244],{"id":256,"viewCount":55,"searchKey":257,"visible":14},"10003417",{"type":10,"entryId":258,"sortOrder":259,"name":260,"imageUrl":261,"description":262,"currentMorphology":9,"currentStage":71,"position":263,"attributes":264},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[244],{"id":266,"viewCount":55,"searchKey":267,"visible":14},"10003488",{"type":10,"entryId":268,"sortOrder":269,"name":270,"imageUrl":271,"description":272,"currentMorphology":9,"currentStage":209,"position":273,"attributes":275},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[274],"position-sup",[276],"attributes-wind",{"id":278,"viewCount":55,"searchKey":279,"visible":14},"10003548",{"type":10,"entryId":280,"sortOrder":281,"name":282,"imageUrl":283,"description":284,"currentMorphology":9,"currentStage":71,"position":285,"attributes":286},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[274],[276],{"id":288,"viewCount":55,"searchKey":289,"visible":14},"10003474",{"type":10,"entryId":290,"sortOrder":291,"name":292,"imageUrl":293,"description":294,"currentMorphology":9,"currentStage":71,"position":295,"attributes":296},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[276],{"id":298,"viewCount":55,"searchKey":299,"visible":14},"10003467",{"type":10,"entryId":300,"sortOrder":301,"name":302,"imageUrl":303,"description":304,"currentMorphology":9,"currentStage":71,"position":305,"attributes":306},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[242],[276],{"id":308,"viewCount":55,"searchKey":309,"visible":14},"10003392",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":9,"currentStage":209,"position":315,"attributes":316},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[317],"attributes-grass",{"id":319,"viewCount":55,"searchKey":320,"visible":14},"10003510",{"type":10,"entryId":321,"sortOrder":322,"name":323,"imageUrl":324,"description":325,"currentMorphology":9,"currentStage":71,"position":326,"attributes":327},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[317],{"id":329,"viewCount":55,"searchKey":330,"visible":14},"10003477",{"type":10,"entryId":331,"sortOrder":332,"name":333,"imageUrl":334,"description":335,"currentMorphology":9,"currentStage":209,"position":336,"attributes":338},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[337],"position-heal",[339],"attributes-water",{"id":341,"viewCount":55,"searchKey":342,"visible":14},"10003569",{"type":10,"entryId":343,"sortOrder":344,"name":345,"imageUrl":346,"description":347,"currentMorphology":9,"currentStage":137,"position":348,"attributes":349},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[337],[339],{"id":351,"viewCount":55,"searchKey":352,"visible":14},"10003470",{"type":10,"entryId":353,"sortOrder":354,"name":355,"imageUrl":356,"description":357,"currentMorphology":9,"currentStage":71,"position":358,"attributes":359},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[337],[339,360],"attributes-ice",{"id":362,"viewCount":55,"searchKey":363,"visible":14},"10003463",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":9,"currentStage":71,"position":369,"attributes":371},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[370],"position-energy",[317,339],{"id":373,"viewCount":55,"searchKey":374,"visible":14},"10003468",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":9,"currentStage":209,"position":380,"attributes":381},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[274],[276],{"id":383,"viewCount":55,"searchKey":384,"visible":14},"10003365",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":9,"currentStage":71,"position":390,"attributes":391},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[274],[276],{"id":393,"viewCount":55,"searchKey":394,"visible":14},"10003461",{"type":10,"entryId":395,"sortOrder":396,"name":397,"imageUrl":398,"description":399,"currentMorphology":9,"currentStage":71,"position":400,"attributes":401},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[274],[244],{"id":403,"viewCount":55,"searchKey":404,"visible":14},"10003421",{"type":10,"entryId":405,"sortOrder":406,"name":407,"imageUrl":408,"description":409,"currentMorphology":9,"currentStage":209,"position":410,"attributes":411},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[242],[317],{"id":413,"viewCount":55,"searchKey":414,"visible":14},"10003414",{"type":10,"entryId":415,"sortOrder":416,"name":417,"imageUrl":418,"description":419,"currentMorphology":9,"currentStage":71,"position":420,"attributes":421},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[370],[244,317],{"id":423,"viewCount":55,"searchKey":424,"visible":14},"10003404",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":9,"currentStage":71,"position":430,"attributes":431},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[242],[317],{"id":433,"viewCount":55,"searchKey":434,"visible":14},"10003567",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":9,"currentStage":209,"position":440,"attributes":441},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[242],[442,317],"attributes-rock",{"id":444,"viewCount":55,"searchKey":445,"visible":14},"10003462",{"type":10,"entryId":446,"sortOrder":447,"name":448,"imageUrl":449,"description":450,"currentMorphology":9,"currentStage":71,"position":451,"attributes":452},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[242],[442,317],{"id":454,"viewCount":55,"searchKey":455,"visible":14},"10003551",{"type":10,"entryId":456,"sortOrder":457,"name":458,"imageUrl":459,"description":460,"currentMorphology":9,"currentStage":71,"position":461,"attributes":462},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[242],[360],{"id":464,"viewCount":55,"searchKey":465,"visible":14},"10003409",{"type":10,"entryId":466,"sortOrder":467,"name":468,"imageUrl":469,"description":470,"currentMorphology":9,"currentStage":209,"position":471,"attributes":472},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[370],[212],{"id":474,"viewCount":55,"searchKey":475,"visible":14},"10003507",{"type":10,"entryId":476,"sortOrder":477,"name":478,"imageUrl":479,"description":480,"currentMorphology":9,"currentStage":71,"position":481,"attributes":482},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[370],[212],{"id":484,"viewCount":55,"searchKey":485,"visible":14},"10003542",{"type":10,"entryId":486,"sortOrder":487,"name":488,"imageUrl":489,"description":490,"currentMorphology":9,"currentStage":209,"position":491,"attributes":492},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[337],[276],{"id":494,"viewCount":55,"searchKey":495,"visible":14},"10003440",{"type":10,"entryId":496,"sortOrder":497,"name":498,"imageUrl":499,"description":500,"currentMorphology":9,"currentStage":71,"position":501,"attributes":502},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[337],[276],{"id":504,"viewCount":55,"searchKey":505,"visible":14},"10003563",{"type":10,"entryId":506,"sortOrder":507,"name":508,"imageUrl":509,"description":510,"currentMorphology":9,"currentStage":21,"position":511,"attributes":512},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[370],[276,317],{"id":514,"viewCount":55,"searchKey":515,"visible":14},"10003368",{"type":10,"entryId":516,"sortOrder":517,"name":518,"imageUrl":519,"description":520,"currentMorphology":9,"currentStage":209,"position":521,"attributes":522},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[274],[276],{"id":524,"viewCount":55,"searchKey":525,"visible":14},"10003363",{"type":10,"entryId":526,"sortOrder":527,"name":528,"imageUrl":529,"description":530,"currentMorphology":9,"currentStage":71,"position":531,"attributes":532},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[274],[276],{"id":534,"viewCount":55,"searchKey":535,"visible":14},"10003515",{"type":10,"entryId":536,"sortOrder":537,"name":538,"imageUrl":539,"description":540,"currentMorphology":9,"currentStage":209,"position":541,"attributes":542},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[317],{"id":544,"viewCount":55,"searchKey":545,"visible":14},"10003496",{"type":10,"entryId":546,"sortOrder":547,"name":548,"imageUrl":549,"description":550,"currentMorphology":9,"currentStage":71,"position":551,"attributes":552},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[317],{"id":554,"viewCount":55,"searchKey":555,"visible":14},"10003378",{"type":10,"entryId":556,"sortOrder":557,"name":558,"imageUrl":559,"description":560,"currentMorphology":9,"currentStage":71,"position":561,"attributes":562},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[274],[317],{"id":564,"viewCount":55,"searchKey":565,"visible":14},"10003456",{"type":10,"entryId":566,"sortOrder":567,"name":568,"imageUrl":569,"description":570,"currentMorphology":9,"currentStage":209,"position":571,"attributes":572},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[242],[317],{"id":574,"viewCount":55,"searchKey":575,"visible":14},"10003374",{"type":10,"entryId":576,"sortOrder":577,"name":578,"imageUrl":579,"description":580,"currentMorphology":9,"currentStage":71,"position":581,"attributes":582},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[274],[583],"attributes-electric",{"id":585,"viewCount":55,"searchKey":586,"visible":14},"10003443",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":9,"currentStage":71,"position":592,"attributes":593},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[242],[317],{"id":595,"viewCount":55,"searchKey":596,"visible":14},"10003503",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":9,"currentStage":209,"position":602,"attributes":603},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[274],[244],{"id":605,"viewCount":55,"searchKey":606,"visible":14},"10003521",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":9,"currentStage":71,"position":612,"attributes":613},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[274],[244],{"id":615,"viewCount":55,"searchKey":616,"visible":14},"10003508",{"type":10,"entryId":617,"sortOrder":618,"name":619,"imageUrl":620,"description":621,"currentMorphology":9,"currentStage":209,"position":622,"attributes":623},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[244],{"id":625,"viewCount":55,"searchKey":626,"visible":14},"10003369",{"type":10,"entryId":627,"sortOrder":628,"name":629,"imageUrl":630,"description":631,"currentMorphology":9,"currentStage":71,"position":632,"attributes":633},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[244],{"id":635,"viewCount":55,"searchKey":636,"visible":14},"10003501",{"type":10,"entryId":637,"sortOrder":638,"name":639,"imageUrl":640,"description":641,"currentMorphology":9,"currentStage":71,"position":642,"attributes":643},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[583],{"id":645,"viewCount":55,"searchKey":646,"visible":14},"10003422",{"type":10,"entryId":647,"sortOrder":648,"name":649,"imageUrl":650,"description":651,"currentMorphology":9,"currentStage":209,"position":652,"attributes":653},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[360],{"id":655,"viewCount":55,"searchKey":656,"visible":14},"10003575",{"type":10,"entryId":657,"sortOrder":658,"name":659,"imageUrl":660,"description":661,"currentMorphology":9,"currentStage":137,"position":662,"attributes":663},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[360],{"id":665,"viewCount":55,"searchKey":666,"visible":14},"10003415",{"type":10,"entryId":667,"sortOrder":668,"name":669,"imageUrl":670,"description":671,"currentMorphology":9,"currentStage":71,"position":672,"attributes":673},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[360],{"id":675,"viewCount":55,"searchKey":676,"visible":14},"10003524",{"type":10,"entryId":677,"sortOrder":678,"name":679,"imageUrl":680,"description":681,"currentMorphology":9,"currentStage":209,"position":682,"attributes":683},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[242],[583],{"id":685,"viewCount":55,"searchKey":686,"visible":14},"10003475",{"type":10,"entryId":687,"sortOrder":688,"name":689,"imageUrl":690,"description":691,"currentMorphology":9,"currentStage":71,"position":692,"attributes":693},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[242],[583],{"id":695,"viewCount":55,"searchKey":696,"visible":14},"10003523",{"type":10,"entryId":697,"sortOrder":698,"name":699,"imageUrl":700,"description":701,"currentMorphology":9,"currentStage":209,"position":702,"attributes":703},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[242],[339],{"id":705,"viewCount":55,"searchKey":706,"visible":14},"10003398",{"type":10,"entryId":707,"sortOrder":708,"name":709,"imageUrl":710,"description":711,"currentMorphology":9,"currentStage":137,"position":712,"attributes":713},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[242],[339],{"id":715,"viewCount":55,"searchKey":716,"visible":14},"10003516",{"type":10,"entryId":717,"sortOrder":718,"name":719,"imageUrl":720,"description":721,"currentMorphology":9,"currentStage":71,"position":722,"attributes":723},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[274],[339],{"id":725,"viewCount":55,"searchKey":726,"visible":14},"10003566",{"type":10,"entryId":727,"sortOrder":728,"name":729,"imageUrl":730,"description":731,"currentMorphology":9,"currentStage":71,"position":732,"attributes":733},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[242],[339],{"id":735,"viewCount":55,"searchKey":736,"visible":14},"10003453",{"type":10,"entryId":737,"sortOrder":738,"name":739,"imageUrl":740,"description":741,"currentMorphology":9,"currentStage":209,"position":742,"attributes":743},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[339],{"id":745,"viewCount":55,"searchKey":746,"visible":14},"10003577",{"type":10,"entryId":747,"sortOrder":748,"name":749,"imageUrl":750,"description":751,"currentMorphology":9,"currentStage":137,"position":752,"attributes":753},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[339],{"id":755,"viewCount":55,"searchKey":756,"visible":14},"10003570",{"type":10,"entryId":757,"sortOrder":758,"name":759,"imageUrl":760,"description":761,"currentMorphology":9,"currentStage":71,"position":762,"attributes":763},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[339],{"id":765,"viewCount":55,"searchKey":766,"visible":14},"10003565",{"type":10,"entryId":767,"sortOrder":768,"name":769,"imageUrl":770,"description":771,"currentMorphology":9,"currentStage":209,"position":772,"attributes":773},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[442],{"id":775,"viewCount":55,"searchKey":776,"visible":14},"10003476",{"type":10,"entryId":777,"sortOrder":778,"name":779,"imageUrl":780,"description":781,"currentMorphology":9,"currentStage":71,"position":782,"attributes":783},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[442],{"id":785,"viewCount":55,"searchKey":786,"visible":14},"10003466",{"type":10,"entryId":787,"sortOrder":788,"name":789,"imageUrl":790,"description":791,"currentMorphology":9,"currentStage":71,"position":792,"attributes":793},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[274],[442],{"id":795,"viewCount":55,"searchKey":796,"visible":14},"10003379",{"type":10,"entryId":797,"sortOrder":798,"name":799,"imageUrl":800,"description":801,"currentMorphology":9,"currentStage":209,"position":802,"attributes":803},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[583],{"id":805,"viewCount":55,"searchKey":806,"visible":14},"10003376",{"type":10,"entryId":807,"sortOrder":808,"name":809,"imageUrl":810,"description":811,"currentMorphology":9,"currentStage":71,"position":812,"attributes":813},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[583],{"id":815,"viewCount":55,"searchKey":816,"visible":14},"10003543",{"type":10,"entryId":817,"sortOrder":818,"name":819,"imageUrl":820,"description":821,"currentMorphology":9,"currentStage":209,"position":822,"attributes":823},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[242],[244],{"id":825,"viewCount":55,"searchKey":826,"visible":14},"10003557",{"type":10,"entryId":827,"sortOrder":828,"name":829,"imageUrl":830,"description":831,"currentMorphology":9,"currentStage":71,"position":832,"attributes":833},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[244],{"id":835,"viewCount":55,"searchKey":836,"visible":14},"10003522",{"type":10,"entryId":837,"sortOrder":838,"name":839,"imageUrl":840,"description":841,"currentMorphology":9,"currentStage":71,"position":842,"attributes":843},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[242],[244],{"id":845,"viewCount":55,"searchKey":846,"visible":14},"10003579",{"type":10,"entryId":847,"sortOrder":848,"name":849,"imageUrl":850,"description":851,"currentMorphology":9,"currentStage":209,"position":852,"attributes":853},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[242],[276],{"id":855,"viewCount":55,"searchKey":856,"visible":14},"10003389",{"type":10,"entryId":857,"sortOrder":858,"name":859,"imageUrl":860,"description":861,"currentMorphology":9,"currentStage":137,"position":862,"attributes":863},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[242],[276],{"id":865,"viewCount":55,"searchKey":866,"visible":14},"10003536",{"type":10,"entryId":867,"sortOrder":868,"name":869,"imageUrl":870,"description":871,"currentMorphology":9,"currentStage":71,"position":872,"attributes":873},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[242],[276],{"id":875,"viewCount":55,"searchKey":876,"visible":14},"10003529",{"type":10,"entryId":877,"sortOrder":878,"name":879,"imageUrl":880,"description":881,"currentMorphology":9,"currentStage":71,"position":882,"attributes":883},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[212],{"id":885,"viewCount":55,"searchKey":886,"visible":14},"10003433",{"type":10,"entryId":887,"sortOrder":888,"name":889,"imageUrl":890,"description":891,"currentMorphology":9,"currentStage":209,"position":892,"attributes":893},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[442],{"id":895,"viewCount":55,"searchKey":896,"visible":14},"10003427",{"type":10,"entryId":897,"sortOrder":898,"name":899,"imageUrl":900,"description":901,"currentMorphology":9,"currentStage":71,"position":902,"attributes":903},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[442],{"id":905,"viewCount":55,"searchKey":906,"visible":14},"10003405",{"type":10,"entryId":907,"sortOrder":908,"name":909,"imageUrl":910,"description":911,"currentMorphology":9,"currentStage":209,"position":912,"attributes":913},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[242],[442],{"id":915,"viewCount":55,"searchKey":916,"visible":14},"10003525",{"type":10,"entryId":917,"sortOrder":918,"name":919,"imageUrl":920,"description":921,"currentMorphology":9,"currentStage":137,"position":922,"attributes":923},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[242],[212,442],{"id":925,"viewCount":55,"searchKey":926,"visible":14},"10003399",{"type":10,"entryId":927,"sortOrder":928,"name":929,"imageUrl":930,"description":931,"currentMorphology":9,"currentStage":71,"position":932,"attributes":933},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[242],[212,442],{"id":935,"viewCount":55,"searchKey":936,"visible":14},"10003518",{"type":10,"entryId":937,"sortOrder":938,"name":939,"imageUrl":940,"description":941,"currentMorphology":9,"currentStage":137,"position":942,"attributes":943},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[242],[442],{"id":945,"viewCount":55,"searchKey":946,"visible":14},"10003393",{"type":10,"entryId":947,"sortOrder":948,"name":949,"imageUrl":950,"description":951,"currentMorphology":9,"currentStage":71,"position":952,"attributes":953},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[242],[442],{"id":955,"viewCount":55,"searchKey":956,"visible":14},"10003386",{"type":10,"entryId":957,"sortOrder":958,"name":959,"imageUrl":960,"description":961,"currentMorphology":9,"currentStage":209,"position":962,"attributes":963},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[274],[442],{"id":965,"viewCount":55,"searchKey":966,"visible":14},"10003447",{"type":10,"entryId":967,"sortOrder":968,"name":969,"imageUrl":970,"description":971,"currentMorphology":9,"currentStage":71,"position":972,"attributes":973},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[274],[442],{"id":975,"viewCount":55,"searchKey":976,"visible":14},"10003497",{"type":10,"entryId":977,"sortOrder":978,"name":979,"imageUrl":980,"description":981,"currentMorphology":9,"currentStage":209,"position":982,"attributes":983},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[274],[583],{"id":985,"viewCount":55,"searchKey":986,"visible":14},"10003479",{"type":10,"entryId":987,"sortOrder":988,"name":989,"imageUrl":990,"description":991,"currentMorphology":9,"currentStage":137,"position":992,"attributes":993},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[274],[583],{"id":995,"viewCount":55,"searchKey":996,"visible":14},"10003388",{"type":10,"entryId":997,"sortOrder":998,"name":999,"imageUrl":1000,"description":1001,"currentMorphology":9,"currentStage":71,"position":1002,"attributes":1003},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[274],[583],{"id":1005,"viewCount":55,"searchKey":1006,"visible":14},"10003429",{"type":10,"entryId":1007,"sortOrder":1008,"name":1009,"imageUrl":1010,"description":1011,"currentMorphology":9,"currentStage":209,"position":1012,"attributes":1013},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[370],[339],{"id":1015,"viewCount":55,"searchKey":1016,"visible":14},"10003430",{"type":10,"entryId":1017,"sortOrder":1018,"name":1019,"imageUrl":1020,"description":1021,"currentMorphology":9,"currentStage":71,"position":1022,"attributes":1023},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[370],[339],{"id":1025,"viewCount":55,"searchKey":1026,"visible":14},"10003549",{"type":10,"entryId":1027,"sortOrder":1028,"name":1029,"imageUrl":1030,"description":1031,"currentMorphology":9,"currentStage":21,"position":1032,"attributes":1033},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[370],[583],{"id":1035,"viewCount":55,"searchKey":1036,"visible":14},"10003494",{"type":10,"entryId":1037,"sortOrder":1038,"name":1039,"imageUrl":1040,"description":1041,"currentMorphology":9,"currentStage":209,"position":1042,"attributes":1043},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[370],[442,339],{"id":1045,"viewCount":55,"searchKey":1046,"visible":14},"10003486",{"type":10,"entryId":1047,"sortOrder":1048,"name":1049,"imageUrl":1050,"description":1051,"currentMorphology":9,"currentStage":71,"position":1052,"attributes":1053},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[370],[442,339],{"id":1055,"viewCount":55,"searchKey":1056,"visible":14},"10003530",{"type":10,"entryId":1057,"sortOrder":1058,"name":1059,"imageUrl":1060,"description":1061,"currentMorphology":9,"currentStage":209,"position":1062,"attributes":1063},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[242],[360],{"id":1065,"viewCount":55,"searchKey":1066,"visible":14},"10003457",{"type":10,"entryId":1067,"sortOrder":1068,"name":1069,"imageUrl":1070,"description":1071,"currentMorphology":9,"currentStage":71,"position":1072,"attributes":1073},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[242],[360],{"id":1075,"viewCount":55,"searchKey":1076,"visible":14},"10003423",{"type":10,"entryId":1077,"sortOrder":1078,"name":1079,"imageUrl":1080,"description":1081,"currentMorphology":9,"currentStage":209,"position":1082,"attributes":1083},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[337],[317,339],{"id":1085,"viewCount":55,"searchKey":1086,"visible":14},"10003419",{"type":10,"entryId":1087,"sortOrder":1088,"name":1089,"imageUrl":1090,"description":1091,"currentMorphology":9,"currentStage":71,"position":1092,"attributes":1093},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[337],[317,339],{"id":1095,"viewCount":55,"searchKey":1096,"visible":14},"10003410",{"type":10,"entryId":1097,"sortOrder":1098,"name":1099,"imageUrl":1100,"description":1101,"currentMorphology":9,"currentStage":209,"position":1102,"attributes":1103},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[339],{"id":1105,"viewCount":55,"searchKey":1106,"visible":14},"10003509",{"type":10,"entryId":1107,"sortOrder":1108,"name":1109,"imageUrl":1110,"description":1111,"currentMorphology":9,"currentStage":71,"position":1112,"attributes":1113},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[339],{"id":1115,"viewCount":55,"searchKey":1116,"visible":14},"10003413",{"type":10,"entryId":1117,"sortOrder":1118,"name":1119,"imageUrl":1120,"description":1121,"currentMorphology":9,"currentStage":209,"position":1122,"attributes":1123},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[360],{"id":5,"viewCount":55,"searchKey":1125,"visible":14},{"type":10,"entryId":8,"sortOrder":1126,"name":1127,"imageUrl":1128,"description":1129,"currentMorphology":9,"currentStage":71,"position":1130,"attributes":1131},1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[360],{"id":4,"viewCount":55,"searchKey":1133,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1134,"attributes":1135},[23],[25],{"id":6,"viewCount":55,"searchKey":1137,"visible":14},{"type":10,"entryId":12,"sortOrder":1138,"name":1139,"imageUrl":1140,"description":1141,"currentMorphology":9,"currentStage":21,"position":1142,"attributes":1143},1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[25],[1145,1153,1158,1163,1168,1173,1178,1183,1187,1192,1197,1202,1207,1212,1217,1222,1227,1232,1235],{"id":1146,"parentId"