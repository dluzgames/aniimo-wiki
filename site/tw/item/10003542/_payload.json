descTitle":208,"descContent":209,"source":210},"91268573_41","/cdn/init/1023100_Skill_11200270_Icon.png","幻影蝶舞","淨化自己身上的負面狀態。未上場時，幻翼蝶會自動出現並淨化上場隊友的負面狀態。",{"attributes":211,"type":213,"consume":192,"power":191},[212],"12",[191],{"id":215,"type":146,"props":216},"91268573_42",{"id":217,"customKey":46,"icon":218,"iconStyle":63,"iconTitle":46,"descTitle":219,"descContent":220,"source":221},"91268573_43","/cdn/init/1023100_Skill_10900221_Icon.png","復甦之風","在腳下創造出暖風區域，持續為全隊提供生命回復，8秒內回復量等同於施放者9%的最大生命值，風元素伊莫額外回復3%。",{"attributes":222,"type":224,"consume":192,"power":191},[223],"9",[191],{"id":226,"type":146,"props":227},"91268573_44",{"id":228,"customKey":46,"icon":229,"iconStyle":63,"iconTitle":46,"descTitle":230,"descContent":231,"source":232},"91268573_45","/cdn/init/1023100_Skill_10800450_Icon.png","息壤之風","在腳下創造出暖風區域，持續為全隊提供生命回復，8秒內回復量等同於施放者9%的最大生命值，土元素伊莫額外回復3%。",{"attributes":233,"type":235,"consume":192,"power":191},[234],"8",[191],{"id":237,"title":238,"children":239},"91268573_46","固有技能",[240],{"id":241,"type":146,"props":242},"91268573_47",{"id":243,"customKey":46,"icon":244,"iconStyle":63,"iconTitle":46,"descTitle":245,"descContent":246,"source":247},"91268573_48","/cdn/init/1023100_Skill_14400000_Icon.png","攻擊","使用風元素能力，遠距離攻擊目標。",{"attributes":248,"type":249,"consume":191,"power":189},[223],[250],"2",[252,253,254,257],{"id":4,"entryId":12,"currentMorphology":20,"visible":14},{"id":6,"entryId":12,"currentMorphology":9,"visible":14},{"id":255,"entryId":12,"currentMorphology":256,"visible":14},"10003537","Nighttime Form",{"id":258,"entryId":12,"currentMorphology":259,"visible":14},"10003533","Mountain Woods Form",[261,273,283,294,306,316,326,337,347,357,367,378,388,399,409,420,431,441,451,461,471,481,491,502,512,522,532,541,545,554,564,574,584,594,604,614,624,635,645,655,665,675,685,695,705,715,725,735,745,755,765,775,785,795,805,815,825,835,845,855,865,875,885,895,905,915,925,935,945,955,965,975,985,995,1005,1015,1025,1035,1045,1055,1065,1075,1085,1095,1105,1115,1125,1135,1145,1155,1165,1175,1185,1196],{"id":262,"viewCount":57,"searchKey":263,"visible":14},"10003442",{"type":10,"entryId":264,"sortOrder":265,"name":266,"imageUrl":267,"description":268,"currentMorphology":20,"currentStage":21,"position":269,"attributes":271},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[270],"position-dps",[272],"attributes-fire",{"id":274,"viewCount":57,"searchKey":275,"visible":14},"10003534",{"type":10,"entryId":276,"sortOrder":277,"name":278,"imageUrl":279,"description":280,"currentMorphology":20,"currentStage":250,"position":281,"attributes":282},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[270],[272],{"id":284,"viewCount":57,"searchKey":285,"visible":14},"10003435",{"type":10,"entryId":286,"sortOrder":287,"name":288,"imageUrl":289,"description":290,"currentMorphology":20,"currentStage":291,"position":292,"attributes":293},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[270],[272],{"id":295,"viewCount":57,"searchKey":296,"visible":14},"10003428",{"type":10,"entryId":297,"sortOrder":298,"name":299,"imageUrl":300,"description":301,"currentMorphology":20,"currentStage":291,"position":302,"attributes":304},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[303],"position-break",[272,305],"attributes-dark",{"id":307,"viewCount":57,"searchKey":308,"visible":14},"10003578",{"type":10,"entryId":309,"sortOrder":310,"name":311,"imageUrl":312,"description":313,"currentMorphology":20,"currentStage":21,"position":314,"attributes":315},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[270],[305],{"id":317,"viewCount":57,"searchKey":318,"visible":14},"10003417",{"type":10,"entryId":319,"sortOrder":320,"name":321,"imageUrl":322,"description":323,"currentMorphology":20,"currentStage":291,"position":324,"attributes":325},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[270],[305],{"id":327,"viewCount":57,"searchKey":328,"visible":14},"10003488",{"type":10,"entryId":329,"sortOrder":330,"name":331,"imageUrl":332,"description":333,"currentMorphology":20,"currentStage":21,"position":334,"attributes":336},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[335],"position-sup",[25],{"id":338,"viewCount":57,"searchKey":339,"visible":14},"10003548",{"type":10,"entryId":340,"sortOrder":341,"name":342,"imageUrl":343,"description":344,"currentMorphology":20,"currentStage":291,"position":345,"attributes":346},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[335],[25],{"id":348,"viewCount":57,"searchKey":349,"visible":14},"10003474",{"type":10,"entryId":350,"sortOrder":351,"name":352,"imageUrl":353,"description":354,"currentMorphology":20,"currentStage":291,"position":355,"attributes":356},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[270],[25],{"id":358,"viewCount":57,"searchKey":359,"visible":14},"10003467",{"type":10,"entryId":360,"sortOrder":361,"name":362,"imageUrl":363,"description":364,"currentMorphology":20,"currentStage":291,"position":365,"attributes":366},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[303],[25],{"id":368,"viewCount":57,"searchKey":369,"visible":14},"10003392",{"type":10,"entryId":370,"sortOrder":371,"name":372,"imageUrl":373,"description":374,"currentMorphology":20,"currentStage":21,"position":375,"attributes":376},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[270],[377],"attributes-grass",{"id":379,"viewCount":57,"searchKey":380,"visible":14},"10003510",{"type":10,"entryId":381,"sortOrder":382,"name":383,"imageUrl":384,"description":385,"currentMorphology":20,"currentStage":291,"position":386,"attributes":387},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[270],[377],{"id":389,"viewCount":57,"searchKey":390,"visible":14},"10003477",{"type":10,"entryId":391,"sortOrder":392,"name":393,"imageUrl":394,"description":395,"currentMorphology":20,"currentStage":21,"position":396,"attributes":397},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[23],[398],"attributes-water",{"id":400,"viewCount":57,"searchKey":401,"visible":14},"10003569",{"type":10,"entryId":402,"sortOrder":403,"name":404,"imageUrl":405,"description":406,"currentMorphology":20,"currentStage":250,"position":407,"attributes":408},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[23],[398],{"id":410,"viewCount":57,"searchKey":411,"visible":14},"10003470",{"type":10,"entryId":412,"sortOrder":413,"name":414,"imageUrl":415,"description":416,"currentMorphology":20,"currentStage":291,"position":417,"attributes":418},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[23],[398,419],"attributes-ice",{"id":421,"viewCount":57,"searchKey":422,"visible":14},"10003463",{"type":10,"entryId":423,"sortOrder":424,"name":425,"imageUrl":426,"description":427,"currentMorphology":20,"currentStage":291,"position":428,"attributes":430},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[429],"position-energy",[377,398],{"id":432,"viewCount":57,"searchKey":433,"visible":14},"10003468",{"type":10,"entryId":434,"sortOrder":435,"name":436,"imageUrl":437,"description":438,"currentMorphology":20,"currentStage":21,"position":439,"attributes":440},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[335],[25],{"id":442,"viewCount":57,"searchKey":443,"visible":14},"10003365",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":20,"currentStage":291,"position":449,"attributes":450},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[335],[25],{"id":452,"viewCount":57,"searchKey":453,"visible":14},"10003461",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":20,"currentStage":291,"position":459,"attributes":460},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[335],[305],{"id":462,"viewCount":57,"searchKey":463,"visible":14},"10003421",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":20,"currentStage":21,"position":469,"attributes":470},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[303],[377],{"id":472,"viewCount":57,"searchKey":473,"visible":14},"10003414",{"type":10,"entryId":474,"sortOrder":475,"name":476,"imageUrl":477,"description":478,"currentMorphology":20,"currentStage":291,"position":479,"attributes":480},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[429],[305,377],{"id":482,"viewCount":57,"searchKey":483,"visible":14},"10003404",{"type":10,"entryId":484,"sortOrder":485,"name":486,"imageUrl":487,"description":488,"currentMorphology":20,"currentStage":291,"position":489,"attributes":490},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[303],[377],{"id":492,"viewCount":57,"searchKey":493,"visible":14},"10003567",{"type":10,"entryId":494,"sortOrder":495,"name":496,"imageUrl":497,"description":498,"currentMorphology":20,"currentStage":21,"position":499,"attributes":500},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[303],[501,377],"attributes-rock",{"id":503,"viewCount":57,"searchKey":504,"visible":14},"10003462",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":20,"currentStage":291,"position":510,"attributes":511},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[303],[501,377],{"id":513,"viewCount":57,"searchKey":514,"visible":14},"10003551",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":20,"currentStage":291,"position":520,"attributes":521},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[303],[419],{"id":523,"viewCount":57,"searchKey":524,"visible":14},"10003409",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":20,"currentStage":21,"position":530,"attributes":531},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[429],[272],{"id":533,"viewCount":57,"searchKey":534,"visible":14},"10003507",{"type":10,"entryId":8,"sortOrder":535,"name":536,"imageUrl":537,"description":538,"currentMorphology":20,"currentStage":291,"position":539,"attributes":540},1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[429],[272],{"id":4,"viewCount":57,"searchKey":542,"visible":14},{"type":10,"entryId":12,"sortOrder":16,"name":17,"imageUrl":18,"description":19,"currentMorphology":20,"currentStage":21,"position":543,"attributes":544},[23],[25],{"id":546,"viewCount":57,"searchKey":547,"visible":14},"10003440",{"type":10,"entryId":548,"sortOrder":549,"name":79,"imageUrl":550,"description":551,"currentMorphology":20,"currentStage":291,"position":552,"attributes":553},"030",1023200,"/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[23],[25],{"id":555,"viewCount":57,"searchKey":556,"visible":14},"10003563",{"type":10,"entryId":557,"sortOrder":558,"name":559,"imageUrl":560,"description":561,"currentMorphology":20,"currentStage":191,"position":562,"attributes":563},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[429],[25,377],{"id":565,"viewCount":57,"searchKey":566,"visible":14},"10003368",{"type":10,"entryId":567,"sortOrder":568,"name":569,"imageUrl":570,"description":571,"currentMorphology":20,"currentStage":21,"position":572,"attributes":573},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[335],[25],{"id":575,"viewCount":57,"searchKey":576,"visible":14},"10003363",{"type":10,"entryId":577,"sortOrder":578,"name":579,"imageUrl":580,"description":581,"currentMorphology":20,"currentStage":291,"position":582,"attributes":583},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[335],[25],{"id":585,"viewCount":57,"searchKey":586,"visible":14},"10003515",{"type":10,"entryId":587,"sortOrder":588,"name":589,"imageUrl":590,"description":591,"currentMorphology":20,"currentStage":21,"position":592,"attributes":593},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[270],[377],{"id":595,"viewCount":57,"searchKey":596,"visible":14},"10003496",{"type":10,"entryId":597,"sortOrder":598,"name":599,"imageUrl":600,"description":601,"currentMorphology":20,"currentStage":291,"position":602,"attributes":603},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[270],[377],{"id":605,"viewCount":57,"searchKey":606,"visible":14},"10003378",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":20,"currentStage":291,"position":612,"attributes":613},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[335],[377],{"id":615,"viewCount":57,"searchKey":616,"visible":14},"10003456",{"type":10,"entryId":617,"sortOrder":618,"name":619,"imageUrl":620,"description":621,"currentMorphology":20,"currentStage":21,"position":622,"attributes":623},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[303],[377],{"id":625,"viewCount":57,"searchKey":626,"visible":14},"10003374",{"type":10,"entryId":627,"sortOrder":628,"name":629,"imageUrl":630,"description":631,"currentMorphology":20,"currentStage":291,"position":632,"attributes":633},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[335],[634],"attributes-electric",{"id":636,"viewCount":57,"searchKey":637,"visible":14},"10003443",{"type":10,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":20,"currentStage":291,"position":643,"attributes":644},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[303],[377],{"id":646,"viewCount":57,"searchKey":647,"visible":14},"10003503",{"type":10,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":20,"currentStage":21,"position":653,"attributes":654},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[335],[305],{"id":656,"viewCount":57,"searchKey":657,"visible":14},"10003521",{"type":10,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":20,"currentStage":291,"position":663,"attributes":664},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[335],[305],{"id":666,"viewCount":57,"searchKey":667,"visible":14},"10003508",{"type":10,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":20,"currentStage":21,"position":673,"attributes":674},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[270],[305],{"id":676,"viewCount":57,"searchKey":677,"visible":14},"10003369",{"type":10,"entryId":678,"sortOrder":679,"name":680,"imageUrl":681,"description":682,"currentMorphology":20,"currentStage":291,"position":683,"attributes":684},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[270],[305],{"id":686,"viewCount":57,"searchKey":687,"visible":14},"10003501",{"type":10,"entryId":688,"sortOrder":689,"name":690,"imageUrl":691,"description":692,"currentMorphology":20,"currentStage":291,"position":693,"attributes":694},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[270],[634],{"id":696,"viewCount":57,"searchKey":697,"visible":14},"10003422",{"type":10,"entryId":698,"sortOrder":699,"name":700,"imageUrl":701,"description":702,"currentMorphology":20,"currentStage":21,"position":703,"attributes":704},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[270],[419],{"id":706,"viewCount":57,"searchKey":707,"visible":14},"10003575",{"type":10,"entryId":708,"sortOrder":709,"name":710,"imageUrl":711,"description":712,"currentMorphology":20,"currentStage":250,"position":713,"attributes":714},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[270],[419],{"id":716,"viewCount":57,"searchKey":717,"visible":14},"10003415",{"type":10,"entryId":718,"sortOrder":719,"name":720,"imageUrl":721,"description":722,"currentMorphology":20,"currentStage":291,"position":723,"attributes":724},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[270],[419],{"id":726,"viewCount":57,"searchKey":727,"visible":14},"10003524",{"type":10,"entryId":728,"sortOrder":729,"name":730,"imageUrl":731,"description":732,"currentMorphology":20,"currentStage":21,"position":733,"attributes":734},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[303],[634],{"id":736,"viewCount":57,"searchKey":737,"visible":14},"10003475",{"type":10,"entryId":738,"sortOrder":739,"name":740,"imageUrl":741,"description":742,"currentMorphology":20,"currentStage":291,"position":743,"attributes":744},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[303],[634],{"id":746,"viewCount":57,"searchKey":747,"visible":14},"10003523",{"type":10,"entryId":748,"sortOrder":749,"name":750,"imageUrl":751,"description":752,"currentMorphology":20,"currentStage":21,"position":753,"attributes":754},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[303],[398],{"id":756,"viewCount":57,"searchKey":757,"visible":14},"10003398",{"type":10,"entryId":758,"sortOrder":759,"name":760,"imageUrl":761,"description":762,"currentMorphology":20,"currentStage":250,"position":763,"attributes":764},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[303],[398],{"id":766,"viewCount":57,"searchKey":767,"visible":14},"10003516",{"type":10,"entryId":768,"sortOrder":769,"name":770,"imageUrl":771,"description":772,"currentMorphology":20,"currentStage":291,"position":773,"attributes":774},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[335],[398],{"id":776,"viewCount":57,"searchKey":777,"visible":14},"10003566",{"type":10,"entryId":778,"sortOrder":779,"name":780,"imageUrl":781,"description":782,"currentMorphology":20,"currentStage":291,"position":783,"attributes":784},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[303],[398],{"id":786,"viewCount":57,"searchKey":787,"visible":14},"10003453",{"type":10,"entryId":788,"sortOrder":789,"name":790,"imageUrl":791,"description":792,"currentMorphology":20,"currentStage":21,"position":793,"attributes":794},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[270],[398],{"id":796,"viewCount":57,"searchKey":797,"visible":14},"10003577",{"type":10,"entryId":798,"sortOrder":799,"name":800,"imageUrl":801,"description":802,"currentMorphology":20,"currentStage":250,"position":803,"attributes":804},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[270],[398],{"id":806,"viewCount":57,"searchKey":807,"visible":14},"10003570",{"type":10,"entryId":808,"sortOrder":809,"name":810,"imageUrl":811,"description":812,"currentMorphology":20,"currentStage":291,"position":813,"attributes":814},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[270],[398],{"id":816,"viewCount":57,"searchKey":817,"visible":14},"10003565",{"type":10,"entryId":818,"sortOrder":819,"name":820,"imageUrl":821,"description":822,"currentMorphology":20,"currentStage":21,"position":823,"attributes":824},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[270],[501],{"id":826,"viewCount":57,"searchKey":827,"visible":14},"10003476",{"type":10,"entryId":828,"sortOrder":829,"name":830,"imageUrl":831,"description":832,"currentMorphology":20,"currentStage":291,"position":833,"attributes":834},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[270],[501],{"id":836,"viewCount":57,"searchKey":837,"visible":14},"10003466",{"type":10,"entryId":838,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":20,"currentStage":291,"position":843,"attributes":844},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[335],[501],{"id":846,"viewCount":57,"searchKey":847,"visible":14},"10003379",{"type":10,"entryId":848,"sortOrder":849,"name":850,"imageUrl":851,"description":852,"currentMorphology":20,"currentStage":21,"position":853,"attributes":854},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[270],[634],{"id":856,"viewCount":57,"searchKey":857,"visible":14},"10003376",{"type":10,"entryId":858,"sortOrder":859,"name":860,"imageUrl":861,"description":862,"currentMorphology":20,"currentStage":291,"position":863,"attributes":864},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[270],[634],{"id":866,"viewCount":57,"searchKey":867,"visible":14},"10003543",{"type":10,"entryId":868,"sortOrder":869,"name":870,"imageUrl":871,"description":872,"currentMorphology":20,"currentStage":21,"position":873,"attributes":874},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[303],[305],{"id":876,"viewCount":57,"searchKey":877,"visible":14},"10003557",{"type":10,"entryId":878,"sortOrder":879,"name":880,"imageUrl":881,"description":882,"currentMorphology":20,"currentStage":291,"position":883,"attributes":884},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[270],[305],{"id":886,"viewCount":57,"searchKey":887,"visible":14},"10003522",{"type":10,"entryId":888,"sortOrder":889,"name":890,"imageUrl":891,"description":892,"currentMorphology":20,"currentStage":291,"position":893,"attributes":894},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[303],[305],{"id":896,"viewCount":57,"searchKey":897,"visible":14},"10003579",{"type":10,"entryId":898,"sortOrder":899,"name":900,"imageUrl":901,"description":902,"currentMorphology":20,"currentStage":21,"position":903,"attributes":904},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[303],[25],{"id":906,"viewCount":57,"searchKey":907,"visible":14},"10003389",{"type":10,"entryId":908,"sortOrder":909,"name":910,"imageUrl":911,"description":912,"currentMorphology":20,"currentStage":250,"position":913,"attributes":914},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[303],[25],{"id":916,"viewCount":57,"searchKey":917,"visible":14},"10003536",{"type":10,"entryId":918,"sortOrder":919,"name":920,"imageUrl":921,"description":922,"currentMorphology":20,"currentStage":291,"position":923,"attributes":924},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[303],[25],{"id":926,"viewCount":57,"searchKey":927,"visible":14},"10003529",{"type":10,"entryId":928,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":20,"currentStage":291,"position":933,"attributes":934},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[270],[272],{"id":936,"viewCount":57,"searchKey":937,"visible":14},"10003433",{"type":10,"entryId":938,"sortOrder":939,"name":940,"imageUrl":941,"description":942,"currentMorphology":20,"currentStage":21,"position":943,"attributes":944},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[270],[501],{"id":946,"viewCount":57,"searchKey":947,"visible":14},"10003427",{"type":10,"entryId":948,"sortOrder":949,"name":950,"imageUrl":951,"description":952,"currentMorphology":20,"currentStage":291,"position":953,"attributes":954},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[270],[501],{"id":956,"viewCount":57,"searchKey":957,"visible":14},"10003405",{"type":10,"entryId":958,"sortOrder":959,"name":960,"imageUrl":961,"description":962,"currentMorphology":20,"currentStage":21,"position":963,"attributes":964},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[303],[501],{"id":966,"viewCount":57,"searchKey":967,"visible":14},"10003525",{"type":10,"entryId":968,"sortOrder":969,"name":970,"imageUrl":971,"description":972,"currentMorphology":20,"currentStage":250,"position":973,"attributes":974},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[303],[272,501],{"id":976,"viewCount":57,"searchKey":977,"visible":14},"10003399",{"type":10,"entryId":978,"sortOrder":979,"name":980,"imageUrl":981,"description":982,"currentMorphology":20,"currentStage":291,"position":983,"attributes":984},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[303],[272,501],{"id":986,"viewCount":57,"searchKey":987,"visible":14},"10003518",{"type":10,"entryId":988,"sortOrder":989,"name":990,"imageUrl":991,"description":992,"currentMorphology":20,"currentStage":250,"position":993,"attributes":994},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[303],[501],{"id":996,"viewCount":57,"searchKey":997,"visible":14},"10003393",{"type":10,"entryId":998,"sortOrder":999,"name":1000,"imageUrl":1001,"description":1002,"currentMorphology":20,"currentStage":291,"position":1003,"attributes":1004},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[303],[501],{"id":1006,"viewCount":57,"searchKey":1007,"visible":14},"10003386",{"type":10,"entryId":1008,"sortOrder":1009,"name":1010,"imageUrl":1011,"description":1012,"currentMorphology":20,"currentStage":21,"position":1013,"attributes":1014},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[335],[501],{"id":1016,"viewCount":57,"searchKey":1017,"visible":14},"10003447",{"type":10,"entryId":1018,"sortOrder":1019,"name":1020,"imageUrl":1021,"description":1022,"currentMorphology":20,"currentStage":291,"position":1023,"attributes":1024},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[335],[501],{"id":1026,"viewCount":57,"searchKey":1027,"visible":14},"10003497",{"type":10,"entryId":1028,"sortOrder":1029,"name":1030,"imageUrl":1031,"description":1032,"currentMorphology":20,"currentStage":21,"position":1033,"attributes":1034},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[335],[634],{"id":1036,"viewCount":57,"searchKey":1037,"visible":14},"10003479",{"type":10,"entryId":1038,"sortOrder":1039,"name":1040,"imageUrl":1041,"description":1042,"currentMorphology":20,"currentStage":250,"position":1043,"attributes":1044},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[335],[634],{"id":1046,"viewCount":57,"searchKey":1047,"visible":14},"10003388",{"type":10,"entryId":1048,"sortOrder":1049,"name":1050,"imageUrl":1051,"description":1052,"currentMorphology":20,"currentStage":291,"position":1053,"attributes":1054},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[335],[634],{"id":1056,"viewCount":57,"searchKey":1057,"visible":14},"10003429",{"type":10,"entryId":1058,"sortOrder":1059,"name":1060,"imageUrl":1061,"description":1062,"currentMorphology":20,"currentStage":21,"position":1063,"attributes":1064},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[429],[398],{"id":1066,"viewCount":57,"searchKey":1067,"visible":14},"10003430",{"type":10,"entryId":1068,"sortOrder":1069,"name":1070,"imageUrl":1071,"description":1072,"currentMorphology":20,"currentStage":291,"position":1073,"attributes":1074},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[429],[398],{"id":1076,"viewCount":57,"searchKey":1077,"visible":14},"10003549",{"type":10,"entryId":1078,"sortOrder":1079,"name":1080,"imageUrl":1081,"description":1082,"currentMorphology":20,"currentStage":191,"position":1083,"attributes":1084},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[429],[634],{"id":1086,"viewCount":57,"searchKey":1087,"visible":14},"10003494",{"type":10,"entryId":1088,"sortOrder":1089,"name":1090,"imageUrl":1091,"description":1092,"currentMorphology":20,"currentStage":21,"position":1093,"attributes":1094},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[429],[501,398],{"id":1096,"viewCount":57,"searchKey":1097,"visible":14},"10003486",{"type":10,"entryId":1098,"sortOrder":1099,"name":1100,"imageUrl":1101,"description":1102,"currentMorphology":20,"currentStage":291,"position":1103,"attributes":1104},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[429],[501,398],{"id":1106,"viewCount":57,"searchKey":1107,"visible":14},"10003530",{"type":10,"entryId":1108,"sortOrder":1109,"name":1110,"imageUrl":1111,"description":1112,"currentMorphology":20,"currentStage":21,"position":1113,"attributes":1114},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[303],[419],{"id":1116,"viewCount":57,"searchKey":1117,"visible":14},"10003457",{"type":10,"entryId":1118,"sortOrder":1119,"name":1120,"imageUrl":1121,"description":1122,"currentMorphology":20,"currentStage":291,"position":1123,"attributes":1124},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[303],[419],{"id":1126,"viewCount":57,"searchKey":1127,"visible":14},"10003423",{"type":10,"entryId":1128,"sortOrder":1129,"name":1130,"imageUrl":1131,"description":1132,"currentMorphology":20,"currentStage":21,"position":1133,"attributes":1134},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[23],[377,398],{"id":1136,"viewCount":57,"searchKey":1137,"visible":14},"10003419",{"type":10,"entryId":1138,"sortOrder":1139,"name":1140,"imageUrl":1141,"description":1142,"currentMorphology":20,"currentStage":291,"position":1143,"attributes":1144},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[23],[377,398],{"id":1146,"viewCount":57,"searchKey":1147,"visible":14},"10003410",{"type":10,"entryId":1148,"sortOrder":1149,"name":1150,"imageUrl":1151,"description":1152,"currentMorphology":20,"currentStage":21,"position":1153,"attributes":1154},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[270],[398],{"id":1156,"viewCount":57,"searchKey":1157,"visible":14},"10003509",{"type":10,"entryId":1158,"sortOrder":1159,"name":1160,"imageUrl":1161,"description":1162,"currentMorphology":20,"currentStage":291,"position":1163,"attributes":1164},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[270],[398],{"id":1166,"viewCount":57,"searchKey":1167,"visible":14},"10003413",{"type":10,"entryId":1168,"sortOrder":1169,"name":1170,"imageUrl":1171,"description":1172,"currentMorphology":20,"currentStage":21,"position":1173,"attributes":1174},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[270],[419],{"id":1176,"viewCount":57,"searchKey":1177,"visible":14},"10003407",{"type":10,"entryId":1178,"sortOrder":1179,"name":1180,"imageUrl":1181,"description":1182,"currentMorphology":20,"currentStage":291,"position":1183,"attributes":1184},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[270],[419],{"id":1186,"viewCount":57,"searchKey":1187,"visible":14},"10003498",{"type":10,"entryId":1188,"sortOrder":1189,"name":1190,"imageUrl":1191,"description":1192,"currentMorphology":20,"currentStage":191,"position":1193,"attributes":1194},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[270],[1195],"attributes-holy",{"id":1197,"viewCount":57,"searchKey":1198,"visible":14},"10003375",{"type":10,"entryId":1199,"sortOrder":1200,"name":1201,"imageUrl":1202,"description":1203,"currentMorphology":20,"currentStage":191,"position":1204,"attributes":1205},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[270],[1195],[1207,1214,1219,1224,1229,1234,1239,1244,1248,1252,1256,1261,1266,1271,1276,1281,1286,1290,1293],{"id":1208,"parentId":1209,"tagType":1210,"tagKey":259,"name":1211,"language":1212,"sort":1213},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","山林型態","zh-TW",6,{"id":1215,"parentId":1209,"tagType":1210,"tagKey":1216,"name":1217,"language":1212,"sort":1218},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1220,"parentId":1209,"tagType":1210,"tagKey":1221,"name":1222,"language":1212,"sort":1223},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1225,"parentId":1209,"tagType":1210,"tagKey":1226,"name":1227,"language":1212,"sort":1228},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1230,"parentId":1209,"tagType":1210,"tagKey":1231,"name":1232,"language":1212,"sort":1233},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1235,"parentId":1209,"tagType":1210,"tagKey":1236,"name":1237,"language":1212,"sort":1238},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1240,"parentId":1209,"tagType":1210,"tagKey":1241,"name":1242,"language":1212,"sort":1243},"568127bc77f184cd4308056381642df7","Snowfield Form","雪地型態",5,{"id":1245,"parentId":1209,"tagType":1210,"tagKey":1246,"name":1247,"language":1212,"sort":135},"5989c0c15477b85af6544dca43428cd7","Rainstorm Form","雨天型態",{"id":1249,"parentId":1209,"tagType":1210,"tagKey":1250,"name":1251,"language":1212,"sort":81},"5b0d9a845ca8bccea70f5ed4fade58e7","Prismana Form","虹彩型態",{"id":1253,"parentId":1209,"tagType":1210,"tagKey":256,"name":1254,"language":1212,"sort":1255},"8239aa22e7eae42c436efbcda46bbb9e","夜間型態",12,{"id":1257,"parentId":1209,"tagType":1210,"tagKey":1258,"name":1259,"language":1212,"sort":1260},"8d1170ae789fe68dacb5164201cbe4a0","Beach Form","沙灘型態",14,{"id":1262,"parentId":1209,"tagType":1210,"tagKey":1263,"name":1264,"language":1212,"sort":1265},"919c62ba9a7fafdc1adc9d4a2baa5c49","Umbrabow Form","黯虹型態",4