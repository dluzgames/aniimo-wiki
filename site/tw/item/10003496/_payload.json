png","劍舞","每施放1次技能,自身施加1層「劍舞」，最多疊加4層，持續15秒。每段普攻會消耗1層「劍舞」，額外造成180%傷害。",{"attributes":146,"type":147,"consume":47,"power":47},[],[],{"id":149,"type":62,"props":150,"children":59},"91268526_26",{"title":151,"type":65,"id":152,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":153},"技能介紹","91268526_27",[154,214],{"id":155,"title":156,"children":157},"91268526_28","戰鬥技能",[158,172,181,192,202],{"id":159,"type":139,"props":160},"91268526_29",{"id":161,"customKey":47,"icon":162,"iconStyle":65,"iconTitle":47,"descTitle":163,"descContent":164,"source":165},"91268526_30","/cdn/init/1032300_Skill_10600370_Icon.png","荊棘防守","進入防守姿態，受到傷害降低20%。期間受到攻擊，會反擊目標。如果在施放技能的瞬間受到攻擊，暴擊率提升30%，持續10秒。",{"attributes":166,"type":168,"consume":170,"power":171},[167],"6",[169],"1","20","75",{"id":173,"type":139,"props":174},"91268526_31",{"id":175,"customKey":47,"icon":176,"iconStyle":65,"iconTitle":47,"descTitle":177,"descContent":164,"source":178},"91268526_32","/cdn/init/1032300_Skill_10301030_Icon.png","流水防守",{"attributes":179,"type":180,"consume":170,"power":171},[22],[169],{"id":182,"type":139,"props":183},"91268526_33",{"id":184,"customKey":47,"icon":185,"iconStyle":65,"iconTitle":47,"descTitle":186,"descContent":187,"source":188},"91268526_34","/cdn/init/1032300_Skill_10600390_Icon.png","荊棘衝擊","突刺衝向目標，命中目標後暴擊率提升15%，持續15秒。",{"attributes":189,"type":190,"consume":170,"power":191},[167],[169],"57",{"id":193,"type":139,"props":194},"91268526_35",{"id":195,"customKey":47,"icon":196,"iconStyle":65,"iconTitle":47,"descTitle":197,"descContent":187,"source":198},"91268526_36","/cdn/init/1032300_Skill_10400280_Icon.png","電光衝擊",{"attributes":199,"type":201,"consume":170,"power":191},[200],"4",[169],{"id":203,"type":139,"props":204},"91268526_37",{"id":205,"customKey":47,"icon":206,"iconStyle":65,"iconTitle":47,"descTitle":207,"descContent":208,"source":209},"91268526_38","/cdn/init/1032300_Skill_10600400_Icon.png","荊棘之雨","用刺劍快速攻擊目標，最多連續施放3次。",{"attributes":210,"type":211,"consume":212,"power":213},[167],[169],"10","30",{"id":215,"title":216,"children":217},"91268526_39","固有技能",[218,230],{"id":219,"type":139,"props":220},"91268526_40",{"id":221,"customKey":47,"icon":222,"iconStyle":65,"iconTitle":47,"descTitle":223,"descContent":224,"source":225},"91268526_41","/cdn/init/1032300_Skill_10600410_Icon.png","浪漫華爾滋","快速用刺劍對目標進行多段攻擊。",{"attributes":226,"type":227,"consume":228,"power":229},[167],[169],"0","172",{"id":231,"type":139,"props":232},"91268526_42",{"id":233,"customKey":47,"icon":234,"iconStyle":65,"iconTitle":47,"descTitle":235,"descContent":236,"source":237},"91268526_43","/cdn/init/1032300_Skill_10600000_Icon.png","攻擊","使用草元素能力，近距離攻擊目標。",{"attributes":238,"type":239,"consume":228,"power":167},[167],[169],[241,242,243,246,248],{"id":4,"entryId":12,"currentMorphology":21,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":244,"entryId":12,"currentMorphology":245,"visible":15},"10003513","Prismana Form",{"id":247,"entryId":12,"currentMorphology":9,"visible":15},"10003493",{"id":249,"entryId":12,"currentMorphology":250,"visible":15},"10003511","Umbrabow Form",[252,263,274,284,296,306,316,328,338,348,358,368,378,390,400,411,422,432,442,452,462,472,482,493,503,513,523,533,543,553,563,573,583,591,595,604,614,625,635,645,655,665,675,685,695,705,715,725,735,745,755,765,775,785,795,805,815,825,835,845,855,865,875,885,895,905,915,925,935,945,955,965,975,985,995,1005,1015,1025,1035,1045,1055,1065,1075,1085,1095,1105,1115,1125,1135,1145,1155,1165,1175,1186],{"id":253,"viewCount":59,"searchKey":254,"visible":15},"10003442",{"type":10,"entryId":255,"sortOrder":256,"name":257,"imageUrl":258,"description":259,"currentMorphology":21,"currentStage":169,"position":260,"attributes":261},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[24],[262],"attributes-fire",{"id":264,"viewCount":59,"searchKey":265,"visible":15},"10003534",{"type":10,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":21,"currentStage":271,"position":272,"attributes":273},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[24],[262],{"id":275,"viewCount":59,"searchKey":276,"visible":15},"10003435",{"type":10,"entryId":277,"sortOrder":278,"name":279,"imageUrl":280,"description":281,"currentMorphology":21,"currentStage":22,"position":282,"attributes":283},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[24],[262],{"id":285,"viewCount":59,"searchKey":286,"visible":15},"10003428",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":21,"currentStage":22,"position":292,"attributes":294},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[293],"position-break",[262,295],"attributes-dark",{"id":297,"viewCount":59,"searchKey":298,"visible":15},"10003578",{"type":10,"entryId":299,"sortOrder":300,"name":301,"imageUrl":302,"description":303,"currentMorphology":21,"currentStage":169,"position":304,"attributes":305},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[24],[295],{"id":307,"viewCount":59,"searchKey":308,"visible":15},"10003417",{"type":10,"entryId":309,"sortOrder":310,"name":311,"imageUrl":312,"description":313,"currentMorphology":21,"currentStage":22,"position":314,"attributes":315},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[24],[295],{"id":317,"viewCount":59,"searchKey":318,"visible":15},"10003488",{"type":10,"entryId":319,"sortOrder":320,"name":321,"imageUrl":322,"description":323,"currentMorphology":21,"currentStage":169,"position":324,"attributes":326},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[325],"position-sup",[327],"attributes-wind",{"id":329,"viewCount":59,"searchKey":330,"visible":15},"10003548",{"type":10,"entryId":331,"sortOrder":332,"name":333,"imageUrl":334,"description":335,"currentMorphology":21,"currentStage":22,"position":336,"attributes":337},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[325],[327],{"id":339,"viewCount":59,"searchKey":340,"visible":15},"10003474",{"type":10,"entryId":341,"sortOrder":342,"name":343,"imageUrl":344,"description":345,"currentMorphology":21,"currentStage":22,"position":346,"attributes":347},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[24],[327],{"id":349,"viewCount":59,"searchKey":350,"visible":15},"10003467",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":21,"currentStage":22,"position":356,"attributes":357},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[293],[327],{"id":359,"viewCount":59,"searchKey":360,"visible":15},"10003392",{"type":10,"entryId":361,"sortOrder":362,"name":363,"imageUrl":364,"description":365,"currentMorphology":21,"currentStage":169,"position":366,"attributes":367},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[24],[26],{"id":369,"viewCount":59,"searchKey":370,"visible":15},"10003510",{"type":10,"entryId":371,"sortOrder":372,"name":373,"imageUrl":374,"description":375,"currentMorphology":21,"currentStage":22,"position":376,"attributes":377},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[24],[26],{"id":379,"viewCount":59,"searchKey":380,"visible":15},"10003477",{"type":10,"entryId":381,"sortOrder":382,"name":383,"imageUrl":384,"description":385,"currentMorphology":21,"currentStage":169,"position":386,"attributes":388},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[387],"position-heal",[389],"attributes-water",{"id":391,"viewCount":59,"searchKey":392,"visible":15},"10003569",{"type":10,"entryId":393,"sortOrder":394,"name":395,"imageUrl":396,"description":397,"currentMorphology":21,"currentStage":271,"position":398,"attributes":399},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[387],[389],{"id":401,"viewCount":59,"searchKey":402,"visible":15},"10003470",{"type":10,"entryId":403,"sortOrder":404,"name":405,"imageUrl":406,"description":407,"currentMorphology":21,"currentStage":22,"position":408,"attributes":409},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[387],[389,410],"attributes-ice",{"id":412,"viewCount":59,"searchKey":413,"visible":15},"10003463",{"type":10,"entryId":414,"sortOrder":415,"name":416,"imageUrl":417,"description":418,"currentMorphology":21,"currentStage":22,"position":419,"attributes":421},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[420],"position-energy",[26,389],{"id":423,"viewCount":59,"searchKey":424,"visible":15},"10003468",{"type":10,"entryId":425,"sortOrder":426,"name":427,"imageUrl":428,"description":429,"currentMorphology":21,"currentStage":169,"position":430,"attributes":431},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[325],[327],{"id":433,"viewCount":59,"searchKey":434,"visible":15},"10003365",{"type":10,"entryId":435,"sortOrder":436,"name":437,"imageUrl":438,"description":439,"currentMorphology":21,"currentStage":22,"position":440,"attributes":441},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[325],[327],{"id":443,"viewCount":59,"searchKey":444,"visible":15},"10003461",{"type":10,"entryId":445,"sortOrder":446,"name":447,"imageUrl":448,"description":449,"currentMorphology":21,"currentStage":22,"position":450,"attributes":451},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[325],[295],{"id":453,"viewCount":59,"searchKey":454,"visible":15},"10003421",{"type":10,"entryId":455,"sortOrder":456,"name":457,"imageUrl":458,"description":459,"currentMorphology":21,"currentStage":169,"position":460,"attributes":461},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[293],[26],{"id":463,"viewCount":59,"searchKey":464,"visible":15},"10003414",{"type":10,"entryId":465,"sortOrder":466,"name":467,"imageUrl":468,"description":469,"currentMorphology":21,"currentStage":22,"position":470,"attributes":471},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[420],[295,26],{"id":473,"viewCount":59,"searchKey":474,"visible":15},"10003404",{"type":10,"entryId":475,"sortOrder":476,"name":477,"imageUrl":478,"description":479,"currentMorphology":21,"currentStage":22,"position":480,"attributes":481},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[293],[26],{"id":483,"viewCount":59,"searchKey":484,"visible":15},"10003567",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":21,"currentStage":169,"position":490,"attributes":491},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[293],[492,26],"attributes-rock",{"id":494,"viewCount":59,"searchKey":495,"visible":15},"10003462",{"type":10,"entryId":496,"sortOrder":497,"name":498,"imageUrl":499,"description":500,"currentMorphology":21,"currentStage":22,"position":501,"attributes":502},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[293],[492,26],{"id":504,"viewCount":59,"searchKey":505,"visible":15},"10003551",{"type":10,"entryId":506,"sortOrder":507,"name":508,"imageUrl":509,"description":510,"currentMorphology":21,"currentStage":22,"position":511,"attributes":512},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[293],[410],{"id":514,"viewCount":59,"searchKey":515,"visible":15},"10003409",{"type":10,"entryId":516,"sortOrder":517,"name":518,"imageUrl":519,"description":520,"currentMorphology":21,"currentStage":169,"position":521,"attributes":522},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[420],[262],{"id":524,"viewCount":59,"searchKey":525,"visible":15},"10003507",{"type":10,"entryId":526,"sortOrder":527,"name":528,"imageUrl":529,"description":530,"currentMorphology":21,"currentStage":22,"position":531,"attributes":532},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[420],[262],{"id":534,"viewCount":59,"searchKey":535,"visible":15},"10003542",{"type":10,"entryId":536,"sortOrder":537,"name":538,"imageUrl":539,"description":540,"currentMorphology":21,"currentStage":169,"position":541,"attributes":542},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[387],[327],{"id":544,"viewCount":59,"searchKey":545,"visible":15},"10003440",{"type":10,"entryId":546,"sortOrder":547,"name":548,"imageUrl":549,"description":550,"currentMorphology":21,"currentStage":22,"position":551,"attributes":552},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[387],[327],{"id":554,"viewCount":59,"searchKey":555,"visible":15},"10003563",{"type":10,"entryId":556,"sortOrder":557,"name":558,"imageUrl":559,"description":560,"currentMorphology":21,"currentStage":228,"position":561,"attributes":562},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[420],[327,26],{"id":564,"viewCount":59,"searchKey":565,"visible":15},"10003368",{"type":10,"entryId":566,"sortOrder":567,"name":568,"imageUrl":569,"description":570,"currentMorphology":21,"currentStage":169,"position":571,"attributes":572},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[325],[327],{"id":574,"viewCount":59,"searchKey":575,"visible":15},"10003363",{"type":10,"entryId":576,"sortOrder":577,"name":578,"imageUrl":579,"description":580,"currentMorphology":21,"currentStage":22,"position":581,"attributes":582},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[325],[327],{"id":584,"viewCount":59,"searchKey":585,"visible":15},"10003515",{"type":10,"entryId":8,"sortOrder":586,"name":75,"imageUrl":587,"description":588,"currentMorphology":21,"currentStage":169,"position":589,"attributes":590},1032100,"/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[24],[26],{"id":4,"viewCount":59,"searchKey":592,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":21,"currentStage":22,"position":593,"attributes":594},[24],[26],{"id":596,"viewCount":59,"searchKey":597,"visible":15},"10003378",{"type":10,"entryId":598,"sortOrder":599,"name":88,"imageUrl":600,"description":601,"currentMorphology":21,"currentStage":22,"position":602,"attributes":603},"036",1032400,"/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[325],[26],{"id":605,"viewCount":59,"searchKey":606,"visible":15},"10003456",{"type":10,"entryId":607,"sortOrder":608,"name":609,"imageUrl":610,"description":611,"currentMorphology":21,"currentStage":169,"position":612,"attributes":613},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[293],[26],{"id":615,"viewCount":59,"searchKey":616,"visible":15},"10003374",{"type":10,"entryId":617,"sortOrder":618,"name":619,"imageUrl":620,"description":621,"currentMorphology":21,"currentStage":22,"position":622,"attributes":623},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[325],[624],"attributes-electric",{"id":626,"viewCount":59,"searchKey":627,"visible":15},"10003443",{"type":10,"entryId":628,"sortOrder":629,"name":630,"imageUrl":631,"description":632,"currentMorphology":21,"currentStage":22,"position":633,"attributes":634},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[293],[26],{"id":636,"viewCount":59,"searchKey":637,"visible":15},"10003503",{"type":10,"entryId":638,"sortOrder":639,"name":640,"imageUrl":641,"description":642,"currentMorphology":21,"currentStage":169,"position":643,"attributes":644},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[325],[295],{"id":646,"viewCount":59,"searchKey":647,"visible":15},"10003521",{"type":10,"entryId":648,"sortOrder":649,"name":650,"imageUrl":651,"description":652,"currentMorphology":21,"currentStage":22,"position":653,"attributes":654},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[325],[295],{"id":656,"viewCount":59,"searchKey":657,"visible":15},"10003508",{"type":10,"entryId":658,"sortOrder":659,"name":660,"imageUrl":661,"description":662,"currentMorphology":21,"currentStage":169,"position":663,"attributes":664},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[24],[295],{"id":666,"viewCount":59,"searchKey":667,"visible":15},"10003369",{"type":10,"entryId":668,"sortOrder":669,"name":670,"imageUrl":671,"description":672,"currentMorphology":21,"currentStage":22,"position":673,"attributes":674},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[24],[295],{"id":676,"viewCount":59,"searchKey":677,"visible":15},"10003501",{"type":10,"entryId":678,"sortOrder":679,"name":680,"imageUrl":681,"description":682,"currentMorphology":21,"currentStage":22,"position":683,"attributes":684},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[24],[624],{"id":686,"viewCount":59,"searchKey":687,"visible":15},"10003422",{"type":10,"entryId":688,"sortOrder":689,"name":690,"imageUrl":691,"description":692,"currentMorphology":21,"currentStage":169,"position":693,"attributes":694},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[24],[410],{"id":696,"viewCount":59,"searchKey":697,"visible":15},"10003575",{"type":10,"entryId":698,"sortOrder":699,"name":700,"imageUrl":701,"description":702,"currentMorphology":21,"currentStage":271,"position":703,"attributes":704},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[24],[410],{"id":706,"viewCount":59,"searchKey":707,"visible":15},"10003415",{"type":10,"entryId":708,"sortOrder":709,"name":710,"imageUrl":711,"description":712,"currentMorphology":21,"currentStage":22,"position":713,"attributes":714},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[24],[410],{"id":716,"viewCount":59,"searchKey":717,"visible":15},"10003524",{"type":10,"entryId":718,"sortOrder":719,"name":720,"imageUrl":721,"description":722,"currentMorphology":21,"currentStage":169,"position":723,"attributes":724},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[293],[624],{"id":726,"viewCount":59,"searchKey":727,"visible":15},"10003475",{"type":10,"entryId":728,"sortOrder":729,"name":730,"imageUrl":731,"description":732,"currentMorphology":21,"currentStage":22,"position":733,"attributes":734},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[293],[624],{"id":736,"viewCount":59,"searchKey":737,"visible":15},"10003523",{"type":10,"entryId":738,"sortOrder":739,"name":740,"imageUrl":741,"description":742,"currentMorphology":21,"currentStage":169,"position":743,"attributes":744},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[293],[389],{"id":746,"viewCount":59,"searchKey":747,"visible":15},"10003398",{"type":10,"entryId":748,"sortOrder":749,"name":750,"imageUrl":751,"description":752,"currentMorphology":21,"currentStage":271,"position":753,"attributes":754},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[293],[389],{"id":756,"viewCount":59,"searchKey":757,"visible":15},"10003516",{"type":10,"entryId":758,"sortOrder":759,"name":760,"imageUrl":761,"description":762,"currentMorphology":21,"currentStage":22,"position":763,"attributes":764},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[325],[389],{"id":766,"viewCount":59,"searchKey":767,"visible":15},"10003566",{"type":10,"entryId":768,"sortOrder":769,"name":770,"imageUrl":771,"description":772,"currentMorphology":21,"currentStage":22,"position":773,"attributes":774},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[293],[389],{"id":776,"viewCount":59,"searchKey":777,"visible":15},"10003453",{"type":10,"entryId":778,"sortOrder":779,"name":780,"imageUrl":781,"description":782,"currentMorphology":21,"currentStage":169,"position":783,"attributes":784},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[24],[389],{"id":786,"viewCount":59,"searchKey":787,"visible":15},"10003577",{"type":10,"entryId":788,"sortOrder":789,"name":790,"imageUrl":791,"description":792,"currentMorphology":21,"currentStage":271,"position":793,"attributes":794},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[24],[389],{"id":796,"viewCount":59,"searchKey":797,"visible":15},"10003570",{"type":10,"entryId":798,"sortOrder":799,"name":800,"imageUrl":801,"description":802,"currentMorphology":21,"currentStage":22,"position":803,"attributes":804},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[24],[389],{"id":806,"viewCount":59,"searchKey":807,"visible":15},"10003565",{"type":10,"entryId":808,"sortOrder":809,"name":810,"imageUrl":811,"description":812,"currentMorphology":21,"currentStage":169,"position":813,"attributes":814},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[24],[492],{"id":816,"viewCount":59,"searchKey":817,"visible":15},"10003476",{"type":10,"entryId":818,"sortOrder":819,"name":820,"imageUrl":821,"description":822,"currentMorphology":21,"currentStage":22,"position":823,"attributes":824},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[24],[492],{"id":826,"viewCount":59,"searchKey":827,"visible":15},"10003466",{"type":10,"entryId":828,"sortOrder":829,"name":830,"imageUrl":831,"description":832,"currentMorphology":21,"currentStage":22,"position":833,"attributes":834},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[325],[492],{"id":836,"viewCount":59,"searchKey":837,"visible":15},"10003379",{"type":10,"entryId":838,"sortOrder":839,"name":840,"imageUrl":841,"description":842,"currentMorphology":21,"currentStage":169,"position":843,"attributes":844},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[24],[624],{"id":846,"viewCount":59,"searchKey":847,"visible":15},"10003376",{"type":10,"entryId":848,"sortOrder":849,"name":850,"imageUrl":851,"description":852,"currentMorphology":21,"currentStage":22,"position":853,"attributes":854},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[24],[624],{"id":856,"viewCount":59,"searchKey":857,"visible":15},"10003543",{"type":10,"entryId":858,"sortOrder":859,"name":860,"imageUrl":861,"description":862,"currentMorphology":21,"currentStage":169,"position":863,"attributes":864},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[293],[295],{"id":866,"viewCount":59,"searchKey":867,"visible":15},"10003557",{"type":10,"entryId":868,"sortOrder":869,"name":870,"imageUrl":871,"description":872,"currentMorphology":21,"currentStage":22,"position":873,"attributes":874},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[24],[295],{"id":876,"viewCount":59,"searchKey":877,"visible":15},"10003522",{"type":10,"entryId":878,"sortOrder":879,"name":880,"imageUrl":881,"description":882,"currentMorphology":21,"currentStage":22,"position":883,"attributes":884},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[293],[295],{"id":886,"viewCount":59,"searchKey":887,"visible":15},"10003579",{"type":10,"entryId":888,"sortOrder":889,"name":890,"imageUrl":891,"description":892,"currentMorphology":21,"currentStage":169,"position":893,"attributes":894},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[293],[327],{"id":896,"viewCount":59,"searchKey":897,"visible":15},"10003389",{"type":10,"entryId":898,"sortOrder":899,"name":900,"imageUrl":901,"description":902,"currentMorphology":21,"currentStage":271,"position":903,"attributes":904},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[293],[327],{"id":906,"viewCount":59,"searchKey":907,"visible":15},"10003536",{"type":10,"entryId":908,"sortOrder":909,"name":910,"imageUrl":911,"description":912,"currentMorphology":21,"currentStage":22,"position":913,"attributes":914},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[293],[327],{"id":916,"viewCount":59,"searchKey":917,"visible":15},"10003529",{"type":10,"entryId":918,"sortOrder":919,"name":920,"imageUrl":921,"description":922,"currentMorphology":21,"currentStage":22,"position":923,"attributes":924},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[24],[262],{"id":926,"viewCount":59,"searchKey":927,"visible":15},"10003433",{"type":10,"entryId":928,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":21,"currentStage":169,"position":933,"attributes":934},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[24],[492],{"id":936,"viewCount":59,"searchKey":937,"visible":15},"10003427",{"type":10,"entryId":938,"sortOrder":939,"name":940,"imageUrl":941,"description":942,"currentMorphology":21,"currentStage":22,"position":943,"attributes":944},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[24],[492],{"id":946,"viewCount":59,"searchKey":947,"visible":15},"10003405",{"type":10,"entryId":948,"sortOrder":949,"name":950,"imageUrl":951,"description":952,"currentMorphology":21,"currentStage":169,"position":953,"attributes":954},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[293],[492],{"id":956,"viewCount":59,"searchKey":957,"visible":15},"10003525",{"type":10,"entryId":958,"sortOrder":959,"name":960,"imageUrl":961,"description":962,"currentMorphology":21,"currentStage":271,"position":963,"attributes":964},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[293],[262,492],{"id":966,"viewCount":59,"searchKey":967,"visible":15},"10003399",{"type":10,"entryId":968,"sortOrder":969,"name":970,"imageUrl":971,"description":972,"currentMorphology":21,"currentStage":22,"position":973,"attributes":974},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[293],[262,492],{"id":976,"viewCount":59,"searchKey":977,"visible":15},"10003518",{"type":10,"entryId":978,"sortOrder":979,"name":980,"imageUrl":981,"description":982,"currentMorphology":21,"currentStage":271,"position":983,"attributes":984},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[293],[492],{"id":986,"viewCount":59,"searchKey":987,"visible":15},"10003393",{"type":10,"entryId":988,"sortOrder":989,"name":990,"imageUrl":991,"description":992,"currentMorphology":21,"currentStage":22,"position":993,"attributes":994},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[293],[492],{"id":996,"viewCount":59,"searchKey":997,"visible":15},"10003386",{"type":10,"entryId":998,"sortOrder":999,"name":1000,"imageUrl":1001,"description":1002,"currentMorphology":21,"currentStage":169,"position":1003,"attributes":1004},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[325],[492],{"id":1006,"viewCount":59,"searchKey":1007,"visible":15},"10003447",{"type":10,"entryId":1008,"sortOrder":1009,"name":1010,"imageUrl":1011,"description":1012,"currentMorphology":21,"currentStage":22,"position":1013,"attributes":1014},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[325],[492],{"id":1016,"viewCount":59,"searchKey":1017,"visible":15},"10003497",{"type":10,"entryId":1018,"sortOrder":1019,"name":1020,"imageUrl":1021,"description":1022,"currentMorphology":21,"currentStage":169,"position":1023,"attributes":1024},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[325],[624],{"id":1026,"viewCount":59,"searchKey":1027,"visible":15},"10003479",{"type":10,"entryId":1028,"sortOrder":1029,"name":1030,"imageUrl":1031,"description":1032,"currentMorphology":21,"currentStage":271,"position":1033,"attributes":1034},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[325],[624],{"id":1036,"viewCount":59,"searchKey":1037,"visible":15},"10003388",{"type":10,"entryId":1038,"sortOrder":1039,"name":1040,"imageUrl":1041,"description":1042,"currentMorphology":21,"currentStage":22,"position":1043,"attributes":1044},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[325],[624],{"id":1046,"viewCount":59,"searchKey":1047,"visible":15},"10003429",{"type":10,"entryId":1048,"sortOrder":1049,"name":1050,"imageUrl":1051,"description":1052,"currentMorphology":21,"currentStage":169,"position":1053,"attributes":1054},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[420],[389],{"id":1056,"viewCount":59,"searchKey":1057,"visible":15},"10003430",{"type":10,"entryId":1058,"sortOrder":1059,"name":1060,"imageUrl":1061,"description":1062,"currentMorphology":21,"currentStage":22,"position":1063,"attributes":1064},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[420],[389],{"id":1066,"viewCount":59,"searchKey":1067,"visible":15},"10003549",{"type":10,"entryId":1068,"sortOrder":1069,"name":1070,"imageUrl":1071,"description":1072,"currentMorphology":21,"currentStage":228,"position":1073,"attributes":1074},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[420],[624],{"id":1076,"viewCount":59,"searchKey":1077,"visible":15},"10003494",{"type":10,"entryId":1078,"sortOrder":1079,"name":1080,"imageUrl":1081,"description":1082,"currentMorphology":21,"currentStage":169,"position":1083,"attributes":1084},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[420],[492,389],{"id":1086,"viewCount":59,"searchKey":1087,"visible":15},"10003486",{"type":10,"entryId":1088,"sortOrder":1089,"name":1090,"imageUrl":1091,"description":1092,"currentMorphology":21,"currentStage":22,"position":1093,"attributes":1094},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[420],[492,389],{"id":1096,"viewCount":59,"searchKey":1097,"visible":15},"10003530",{"type":10,"entryId":1098,"sortOrder":1099,"name":1100,"imageUrl":1101,"description":1102,"currentMorphology":21,"currentStage":169,"position":1103,"attributes":1104},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[293],[410],{"id":1106,"viewCount":59,"searchKey":1107,"visible":15},"10003457",{"type":10,"entryId":1108,"sortOrder":1109,"name":1110,"imageUrl":1111,"description":1112,"currentMorphology":21,"currentStage":22,"position":1113,"attributes":1114},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[293],[410],{"id":1116,"viewCount":59,"searchKey":1117,"visible":15},"10003423",{"type":10,"entryId":1118,"sortOrder":1119,"name":1120,"imageUrl":1121,"description":1122,"currentMorphology":21,"currentStage":169,"position":1123,"attributes":1124},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[387],[26,389],{"id":1126,"viewCount":59,"searchKey":1127,"visible":15},"10003419",{"type":10,"entryId":1128,"sortOrder":1129,"name":1130,"imageUrl":1131,"description":1132,"currentMorphology":21,"currentStage":22,"position":1133,"attributes":1134},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[387],[26,389],{"id":1136,"viewCount":59,"searchKey":1137,"visible":15},"10003410",{"type":10,"entryId":1138,"sortOrder":1139,"name":1140,"imageUrl":1141,"description":1142,"currentMorphology":21,"currentStage":169,"position":1143,"attributes":1144},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[24],[389],{"id":1146,"viewCount":59,"searchKey":1147,"visible":15},"10003509",{"type":10,"entryId":1148,"sortOrder":1149,"name":1150,"imageUrl":1151,"description":1152,"currentMorphology":21,"currentStage":22,"position":1153,"attributes":1154},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[24],[389],{"id":1156,"viewCount":59,"searchKey":1157,"visible":15},"10003413",{"type":10,"entryId":1158,"sortOrder":1159,"name":1160,"imageUrl":1161,"description":1162,"currentMorphology":21,"currentStage":169,"position":1163,"attributes":1164},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[24],[410],{"id":1166,"viewCount":59,"searchKey":1167,"visible":15},"10003407",{"type":10,"entryId":1168,"sortOrder":1169,"name":1170,"imageUrl":1171,"description":1172,"currentMorphology":21,"currentStage":22,"position":1173,"attributes":1174},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[24],[410],{"id":1176,"viewCount":59,"searchKey":1177,"visible":15},"10003498",{"type":10,"entryId":1178,"sortOrder":1179,"name":1180,"imageUrl":1181,"description":1182,"currentMorphology":21,"currentStage":228,"position":1183,"attributes":1184},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[24],[1185],"attributes-holy",{"id":1187,"viewCount":59,"searchKey":1188,"visible":15},"10003375",{"type":10,"entryId":1189,"sortOrder":1190,"name":1191,"imageUrl":1192,"description":1193,"currentMorphology":21,"currentStage":228,"position":1194,"attributes":1195},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[24],[1185],[1197,1205,1210,1215,1220,1225,1230,1235,1238,1241,1246,1251,1255,1260,1265,1269,1274,1279,1282],{"id":1198,"parentId":1199,"tagType":1200,"tagKey":1201,"name":1202,"language":1203,"sort":1204},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1206,"parentId":1199,"tagType":1200,"tagKey":1207,"name":1208,"language":1203,"sort":1209},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1211,"parentId":1199,"tagType":1200,"tagKey":1212,"name":1213,"language":1203,"sort":1214},"450da43bc6001e686491fef