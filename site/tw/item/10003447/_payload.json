ader":66,"tabs":146},"技能介紹","91268477_26",[147,186],{"id":148,"title":149,"children":150},"91268477_27","戰鬥技能",[151,164,176],{"id":152,"type":132,"props":153},"91268477_28",{"id":154,"customKey":46,"icon":155,"iconStyle":64,"iconTitle":46,"descTitle":156,"descContent":157,"source":158},"91268477_29","/cdn/init/1043300_Skill_10800360_Icon.png","護身煙幕","放出煙幕遮擋視野，無法隔著煙幕進行瞄準。",{"attributes":159,"type":161,"consume":163,"power":162},[160],"8",[162],"0","10",{"id":165,"type":132,"props":166},"91268477_30",{"id":167,"customKey":46,"icon":168,"iconStyle":64,"iconTitle":46,"descTitle":169,"descContent":170,"source":171},"91268477_31","/cdn/init/1043300_Skill_10800370_Icon.png","砲台模式","底盤落地，抓牢地面，持續期間普攻替換為砲擊，消耗能量造成範圍傷害。",{"attributes":172,"type":173,"consume":162,"power":175},[160],[174],"2","35",{"id":177,"type":132,"props":178},"91268477_32",{"id":179,"customKey":46,"icon":180,"iconStyle":64,"iconTitle":46,"descTitle":181,"descContent":182,"source":183},"91268477_33","/cdn/init/1043300_Skill_10800380_Icon.png","蟻巢哨衛","將蟻煙囪發射而出，在周身懸停，隊伍施放技能或終結技時進行協同攻擊，持續15秒。",{"attributes":184,"type":185,"consume":163,"power":163},[160],[174],{"id":187,"title":188,"children":189},"91268477_34","固有技能",[190,201],{"id":191,"type":132,"props":192},"91268477_35",{"id":193,"customKey":46,"icon":194,"iconStyle":64,"iconTitle":46,"descTitle":195,"descContent":196,"source":197},"91268477_36","/cdn/init/1043300_Skill_14300000_Icon.png","攻擊","使用土元素能力，遠距離攻擊目標。",{"attributes":198,"type":199,"consume":162,"power":200},[160],[174],"6",{"id":202,"type":132,"props":203},"91268477_37",{"id":204,"customKey":46,"icon":205,"iconStyle":64,"iconTitle":46,"descTitle":206,"descContent":207,"source":208},"91268477_38","/cdn/init/1043300_Skill_10800410_Icon.png","毀滅砲擊","發動毀滅的一擊，溢出的能量會留在彈坑處，持續造成傷害。",{"attributes":209,"type":210,"consume":162,"power":211},[160],[174],"165",[213],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[215,227,237,247,259,269,279,290,300,310,320,331,341,353,363,374,385,395,405,415,425,435,445,455,465,475,485,495,505,515,525,535,545,555,565,575,585,596,606,616,626,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,846,856,866,876,886,896,906,916,926,936,946,956,966,973,977,985,995,1005,1015,1025,1035,1045,1055,1065,1075,1085,1095,1105,1115,1125,1135,1146],{"id":216,"viewCount":58,"searchKey":217,"visible":14},"10003442",{"type":10,"entryId":218,"sortOrder":219,"name":220,"imageUrl":221,"description":222,"currentMorphology":9,"currentStage":113,"position":223,"attributes":225},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[224],"position-dps",[226],"attributes-fire",{"id":228,"viewCount":58,"searchKey":229,"visible":14},"10003534",{"type":10,"entryId":230,"sortOrder":231,"name":232,"imageUrl":233,"description":234,"currentMorphology":9,"currentStage":174,"position":235,"attributes":236},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[224],[226],{"id":238,"viewCount":58,"searchKey":239,"visible":14},"10003435",{"type":10,"entryId":240,"sortOrder":241,"name":242,"imageUrl":243,"description":244,"currentMorphology":9,"currentStage":21,"position":245,"attributes":246},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[224],[226],{"id":248,"viewCount":58,"searchKey":249,"visible":14},"10003428",{"type":10,"entryId":250,"sortOrder":251,"name":252,"imageUrl":253,"description":254,"currentMorphology":9,"currentStage":21,"position":255,"attributes":257},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[256],"position-break",[226,258],"attributes-dark",{"id":260,"viewCount":58,"searchKey":261,"visible":14},"10003578",{"type":10,"entryId":262,"sortOrder":263,"name":264,"imageUrl":265,"description":266,"currentMorphology":9,"currentStage":113,"position":267,"attributes":268},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[224],[258],{"id":270,"viewCount":58,"searchKey":271,"visible":14},"10003417",{"type":10,"entryId":272,"sortOrder":273,"name":274,"imageUrl":275,"description":276,"currentMorphology":9,"currentStage":21,"position":277,"attributes":278},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[224],[258],{"id":280,"viewCount":58,"searchKey":281,"visible":14},"10003488",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":9,"currentStage":113,"position":287,"attributes":288},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[23],[289],"attributes-wind",{"id":291,"viewCount":58,"searchKey":292,"visible":14},"10003548",{"type":10,"entryId":293,"sortOrder":294,"name":295,"imageUrl":296,"description":297,"currentMorphology":9,"currentStage":21,"position":298,"attributes":299},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[23],[289],{"id":301,"viewCount":58,"searchKey":302,"visible":14},"10003474",{"type":10,"entryId":303,"sortOrder":304,"name":305,"imageUrl":306,"description":307,"currentMorphology":9,"currentStage":21,"position":308,"attributes":309},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[224],[289],{"id":311,"viewCount":58,"searchKey":312,"visible":14},"10003467",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":9,"currentStage":21,"position":318,"attributes":319},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[256],[289],{"id":321,"viewCount":58,"searchKey":322,"visible":14},"10003392",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":9,"currentStage":113,"position":328,"attributes":329},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[224],[330],"attributes-grass",{"id":332,"viewCount":58,"searchKey":333,"visible":14},"10003510",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":9,"currentStage":21,"position":339,"attributes":340},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[224],[330],{"id":342,"viewCount":58,"searchKey":343,"visible":14},"10003477",{"type":10,"entryId":344,"sortOrder":345,"name":346,"imageUrl":347,"description":348,"currentMorphology":9,"currentStage":113,"position":349,"attributes":351},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[350],"position-heal",[352],"attributes-water",{"id":354,"viewCount":58,"searchKey":355,"visible":14},"10003569",{"type":10,"entryId":356,"sortOrder":357,"name":358,"imageUrl":359,"description":360,"currentMorphology":9,"currentStage":174,"position":361,"attributes":362},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[350],[352],{"id":364,"viewCount":58,"searchKey":365,"visible":14},"10003470",{"type":10,"entryId":366,"sortOrder":367,"name":368,"imageUrl":369,"description":370,"currentMorphology":9,"currentStage":21,"position":371,"attributes":372},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[350],[352,373],"attributes-ice",{"id":375,"viewCount":58,"searchKey":376,"visible":14},"10003463",{"type":10,"entryId":377,"sortOrder":378,"name":379,"imageUrl":380,"description":381,"currentMorphology":9,"currentStage":21,"position":382,"attributes":384},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[383],"position-energy",[330,352],{"id":386,"viewCount":58,"searchKey":387,"visible":14},"10003468",{"type":10,"entryId":388,"sortOrder":389,"name":390,"imageUrl":391,"description":392,"currentMorphology":9,"currentStage":113,"position":393,"attributes":394},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[23],[289],{"id":396,"viewCount":58,"searchKey":397,"visible":14},"10003365",{"type":10,"entryId":398,"sortOrder":399,"name":400,"imageUrl":401,"description":402,"currentMorphology":9,"currentStage":21,"position":403,"attributes":404},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[23],[289],{"id":406,"viewCount":58,"searchKey":407,"visible":14},"10003461",{"type":10,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":9,"currentStage":21,"position":413,"attributes":414},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[23],[258],{"id":416,"viewCount":58,"searchKey":417,"visible":14},"10003421",{"type":10,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":9,"currentStage":113,"position":423,"attributes":424},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[256],[330],{"id":426,"viewCount":58,"searchKey":427,"visible":14},"10003414",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":9,"currentStage":21,"position":433,"attributes":434},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[383],[258,330],{"id":436,"viewCount":58,"searchKey":437,"visible":14},"10003404",{"type":10,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":9,"currentStage":21,"position":443,"attributes":444},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[256],[330],{"id":446,"viewCount":58,"searchKey":447,"visible":14},"10003567",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":9,"currentStage":113,"position":453,"attributes":454},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[256],[25,330],{"id":456,"viewCount":58,"searchKey":457,"visible":14},"10003462",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":9,"currentStage":21,"position":463,"attributes":464},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[256],[25,330],{"id":466,"viewCount":58,"searchKey":467,"visible":14},"10003551",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":9,"currentStage":21,"position":473,"attributes":474},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[256],[373],{"id":476,"viewCount":58,"searchKey":477,"visible":14},"10003409",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":9,"currentStage":113,"position":483,"attributes":484},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[383],[226],{"id":486,"viewCount":58,"searchKey":487,"visible":14},"10003507",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":9,"currentStage":21,"position":493,"attributes":494},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[383],[226],{"id":496,"viewCount":58,"searchKey":497,"visible":14},"10003542",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":9,"currentStage":113,"position":503,"attributes":504},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[350],[289],{"id":506,"viewCount":58,"searchKey":507,"visible":14},"10003440",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":9,"currentStage":21,"position":513,"attributes":514},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[350],[289],{"id":516,"viewCount":58,"searchKey":517,"visible":14},"10003563",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":9,"currentStage":162,"position":523,"attributes":524},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[383],[289,330],{"id":526,"viewCount":58,"searchKey":527,"visible":14},"10003368",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":9,"currentStage":113,"position":533,"attributes":534},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[23],[289],{"id":536,"viewCount":58,"searchKey":537,"visible":14},"10003363",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":9,"currentStage":21,"position":543,"attributes":544},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[23],[289],{"id":546,"viewCount":58,"searchKey":547,"visible":14},"10003515",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":9,"currentStage":113,"position":553,"attributes":554},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[224],[330],{"id":556,"viewCount":58,"searchKey":557,"visible":14},"10003496",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":9,"currentStage":21,"position":563,"attributes":564},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[224],[330],{"id":566,"viewCount":58,"searchKey":567,"visible":14},"10003378",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":9,"currentStage":21,"position":573,"attributes":574},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[23],[330],{"id":576,"viewCount":58,"searchKey":577,"visible":14},"10003456",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":9,"currentStage":113,"position":583,"attributes":584},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[256],[330],{"id":586,"viewCount":58,"searchKey":587,"visible":14},"10003374",{"type":10,"entryId":588,"sortOrder":589,"name":590,"imageUrl":591,"description":592,"currentMorphology":9,"currentStage":21,"position":593,"attributes":594},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[23],[595],"attributes-electric",{"id":597,"viewCount":58,"searchKey":598,"visible":14},"10003443",{"type":10,"entryId":599,"sortOrder":600,"name":601,"imageUrl":602,"description":603,"currentMorphology":9,"currentStage":21,"position":604,"attributes":605},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[256],[330],{"id":607,"viewCount":58,"searchKey":608,"visible":14},"10003503",{"type":10,"entryId":609,"sortOrder":610,"name":611,"imageUrl":612,"description":613,"currentMorphology":9,"currentStage":113,"position":614,"attributes":615},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[23],[258],{"id":617,"viewCount":58,"searchKey":618,"visible":14},"10003521",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":9,"currentStage":21,"position":624,"attributes":625},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[23],[258],{"id":627,"viewCount":58,"searchKey":628,"visible":14},"10003508",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":9,"currentStage":113,"position":634,"attributes":635},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[224],[258],{"id":637,"viewCount":58,"searchKey":638,"visible":14},"10003369",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":9,"currentStage":21,"position":644,"attributes":645},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[224],[258],{"id":647,"viewCount":58,"searchKey":648,"visible":14},"10003501",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":9,"currentStage":21,"position":654,"attributes":655},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[224],[595],{"id":657,"viewCount":58,"searchKey":658,"visible":14},"10003422",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":9,"currentStage":113,"position":664,"attributes":665},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[224],[373],{"id":667,"viewCount":58,"searchKey":668,"visible":14},"10003575",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":9,"currentStage":174,"position":674,"attributes":675},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[224],[373],{"id":677,"viewCount":58,"searchKey":678,"visible":14},"10003415",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":9,"currentStage":21,"position":684,"attributes":685},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[224],[373],{"id":687,"viewCount":58,"searchKey":688,"visible":14},"10003524",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":9,"currentStage":113,"position":694,"attributes":695},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[256],[595],{"id":697,"viewCount":58,"searchKey":698,"visible":14},"10003475",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":9,"currentStage":21,"position":704,"attributes":705},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[256],[595],{"id":707,"viewCount":58,"searchKey":708,"visible":14},"10003523",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":9,"currentStage":113,"position":714,"attributes":715},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[256],[352],{"id":717,"viewCount":58,"searchKey":718,"visible":14},"10003398",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":9,"currentStage":174,"position":724,"attributes":725},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[256],[352],{"id":727,"viewCount":58,"searchKey":728,"visible":14},"10003516",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":9,"currentStage":21,"position":734,"attributes":735},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[23],[352],{"id":737,"viewCount":58,"searchKey":738,"visible":14},"10003566",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":9,"currentStage":21,"position":744,"attributes":745},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[256],[352],{"id":747,"viewCount":58,"searchKey":748,"visible":14},"10003453",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":9,"currentStage":113,"position":754,"attributes":755},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[224],[352],{"id":757,"viewCount":58,"searchKey":758,"visible":14},"10003577",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":9,"currentStage":174,"position":764,"attributes":765},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[224],[352],{"id":767,"viewCount":58,"searchKey":768,"visible":14},"10003570",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":9,"currentStage":21,"position":774,"attributes":775},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[224],[352],{"id":777,"viewCount":58,"searchKey":778,"visible":14},"10003565",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":9,"currentStage":113,"position":784,"attributes":785},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[224],[25],{"id":787,"viewCount":58,"searchKey":788,"visible":14},"10003476",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":9,"currentStage":21,"position":794,"attributes":795},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[224],[25],{"id":797,"viewCount":58,"searchKey":798,"visible":14},"10003466",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":9,"currentStage":21,"position":804,"attributes":805},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[23],[25],{"id":807,"viewCount":58,"searchKey":808,"visible":14},"10003379",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":9,"currentStage":113,"position":814,"attributes":815},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[224],[595],{"id":817,"viewCount":58,"searchKey":818,"visible":14},"10003376",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":9,"currentStage":21,"position":824,"attributes":825},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[224],[595],{"id":827,"viewCount":58,"searchKey":828,"visible":14},"10003543",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":9,"currentStage":113,"position":834,"attributes":835},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[256],[258],{"id":837,"viewCount":58,"searchKey":838,"visible":14},"10003557",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":9,"currentStage":21,"position":844,"attributes":845},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[224],[258],{"id":847,"viewCount":58,"searchKey":848,"visible":14},"10003522",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":9,"currentStage":21,"position":854,"attributes":855},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[256],[258],{"id":857,"viewCount":58,"searchKey":858,"visible":14},"10003579",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":9,"currentStage":113,"position":864,"attributes":865},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[256],[289],{"id":867,"viewCount":58,"searchKey":868,"visible":14},"10003389",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":9,"currentStage":174,"position":874,"attributes":875},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[256],[289],{"id":877,"viewCount":58,"searchKey":878,"visible":14},"10003536",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":9,"currentStage":21,"position":884,"attributes":885},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[256],[289],{"id":887,"viewCount":58,"searchKey":888,"visible":14},"10003529",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":9,"currentStage":21,"position":894,"attributes":895},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[224],[226],{"id":897,"viewCount":58,"searchKey":898,"visible":14},"10003433",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":9,"currentStage":113,"position":904,"attributes":905},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[224],[25],{"id":907,"viewCount":58,"searchKey":908,"visible":14},"10003427",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":9,"currentStage":21,"position":914,"attributes":915},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[224],[25],{"id":917,"viewCount":58,"searchKey":918,"visible":14},"10003405",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":9,"currentStage":113,"position":924,"attributes":925},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[256],[25],{"id":927,"viewCount":58,"searchKey":928,"visible":14},"10003525",{"type":10,"entryId":929,"sortOrder":930,"name":931,"imageUrl":932,"description":933,"currentMorphology":9,"currentStage":174,"position":934,"attributes":935},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[256],[226,25],{"id":937,"viewCount":58,"searchKey":938,"visible":14},"10003399",{"type":10,"entryId":939,"sortOrder":940,"name":941,"imageUrl":942,"description":943,"currentMorphology":9,"currentStage":21,"position":944,"attributes":945},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[256],[226,25],{"id":947,"viewCount":58,"searchKey":948,"visible":14},"10003518",{"type":10,"entryId":949,"sortOrder":950,"name":951,"imageUrl":952,"description":953,"currentMorphology":9,"currentStage":174,"position":954,"attributes":955},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[256],[25],{"id":957,"viewCount":58,"searchKey":958,"visible":14},"10003393",{"type":10,"entryId":959,"sortOrder":960,"name":961,"imageUrl":962,"description":963,"currentMorphology":9,"currentStage":21,"position":964,"attributes":965},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[256],[25],{"id":5,"viewCount":58,"searchKey":967,"visible":14},{"type":10,"entryId":8,"sortOrder":968,"name":74,"imageUrl":969,"description":970,"currentMorphology":9,"currentStage":113,"position":971,"attributes":972},1043100,"/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[23],[25],{"id":4,"viewCount":58,"searchKey":974,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":975,"attributes":976},[23],[25],{"id":6,"viewCount":58,"searchKey":978,"visible":14},{"type":10,"entryId":12,"sortOrder":979,"name":980,"imageUrl":981,"description":982,"currentMorphology":9,"currentStage":113,"position":983,"attributes":984},1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[23],[595],{"id":986,"viewCount":58,"searchKey":987,"visible":14},"10003479",{"type":10,"entryId":988,"sortOrder":989,"name":990,"imageUrl":991,"description":992,"currentMorphology":9,"currentStage":174,"position":993,"attributes":994},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[23],[595],{"id":996,"viewCount":58,"searchKey":997,"visible":14},"10003388",{"type":10,"entryId":998,"sortOrder":999,"name":1000,"imageUrl":1001,"description":1002,"currentMorphology":9,"currentStage":21,"position":1003,"attributes":1004},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[23],[595],{"id":1006,"viewCount":58,"searchKey":1007,"visible":14},"10003429",{"type":10,"entryId":1008,"sortOrder":1009,"name":1010,"imageUrl":1011,"description":1012,"currentMorphology":9,"currentStage":113,"position":1013,"attributes":1014},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[383],[352],{"id":1016,"viewCount":58,"searchKey":1017,"visible":14},"10003430",{"type":10,"entryId":1018,"sortOrder":1019,"name":1020,"imageUrl":1021,"description":1022,"currentMorphology":9,"currentStage":21,"position":1023,"attributes":1024},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[383],[352],{"id":1026,"viewCount":58,"searchKey":1027,"visible":14},"10003549",{"type":10,"entryId":1028,"sortOrder":1029,"name":1030,"imageUrl":1031,"description":1032,"currentMorphology":9,"currentStage":162,"position":1033,"attributes":1034},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[383],[595],{"id":1036,"viewCount":58,"searchKey":1037,"visible":14},"10003494",{"type":10,"entryId":1038,"sortOrder":1039,"name":1040,"imageUrl":1041,"description":1042,"currentMorphology":9,"currentStage":113,"position":1043,"attributes":1044},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[383],[25,352],{"id":1046,"viewCount":58,"searchKey":1047,"visible":14},"10003486",{"type":10,"entryId":1048,"sortOrder":1049,"name":1050,"imageUrl":1051,"description":1052,"currentMorphology":9,"currentStage":21,"position":1053,"attributes":1054},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[383],[25,352],{"id":1056,"viewCount":58,"searchKey":1057,"visible":14},"10003530",{"type":10,"entryId":1058,"sortOrder":1059,"name":1060,"imageUrl":1061,"description":1062,"currentMorphology":9,"currentStage":113,"position":1063,"attributes":1064},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[256],[373],{"id":1066,"viewCount":58,"searchKey":1067,"visible":14},"10003457",{"type":10,"entryId":1068,"sortOrder":1069,"name":1070,"imageUrl":1071,"description":1072,"currentMorphology":9,"currentStage":21,"position":1073,"attributes":1074},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[256],[373],{"id":1076,"viewCount":58,"searchKey":1077,"visible":14},"10003423",{"type":10,"entryId":1078,"sortOrder":1079,"name":1080,"imageUrl":1081,"description":1082,"currentMorphology":9,"currentStage":113,"position":1083,"attributes":1084},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[350],[330,352],{"id":1086,"viewCount":58,"searchKey":1087,"visible":14},"10003419",{"type":10,"entryId":1088,"sortOrder":1089,"name":1090,"imageUrl":1091,"description":1092,"currentMorphology":9,"currentStage":21,"position":1093,"attributes":1094},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[350],[330,352],{"id":1096,"viewCount":58,"searchKey":1097,"visible":14},"10003410",{"type":10,"entryId":1098,"sortOrder":1099,"name":1100,"imageUrl":1101,"description":1102,"currentMorphology":9,"currentStage":113,"position":1103,"attributes":1104},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[224],[352],{"id":1106,"viewCount":58,"searchKey":1107,"visible":14},"10003509",{"type":10,"entryId":1108,"sortOrder":1109,"name":1110,"imageUrl":1111,"description":1112,"currentMorphology":9,"currentStage":21,"position":1113,"attributes":1114},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[224],[352],{"id":1116,"viewCount":58,"searchKey":1117,"visible":14},"10003413",{"type":10,"entryId":1118,"sortOrder":1119,"name":1120,"imageUrl":1121,"description":1122,"currentMorphology":9,"currentStage":113,"position":1123,"attributes":1124},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[224],[373],{"id":1126,"viewCount":58,"searchKey":1127,"visible":14},"10003407",{"type":10,"entryId":1128,"sortOrder":1129,"name":1130,"imageUrl":1131,"description":1132,"currentMorphology":9,"currentStage":21,"position":1133,"attributes":1134},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[224],[373],{"id":1136,"viewCount":58,"searchKey":1137,"visible":14},"10003498",{"type":10,"entryId":1138,"sortOrder":1139,"name":1140,"imageUrl":1141,"description":1142,"currentMorphology":9,"currentStage":162,"position":1143,"attributes":1144},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[224],[1145],"attributes-holy",{"id":1147,"viewCount":58,"searchKey":1148,"visible":14},"10003375",{"type":10,"entryId":1149,"sortOrder":1150,"name":1151,"imageUrl":1152,"description":1153,"currentMorphology":9,"currentStage":162,"position":1154,"attributes":1155},"9998",1036100,"日耀獅",