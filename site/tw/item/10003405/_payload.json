"id":147,"type":62,"props":148,"children":151},"91268435_22",{"title":149,"type":114,"id":150,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"探索技能","91268435_23",[152],{"id":153,"type":154,"props":155,"children":59},"91268435_24","circle",{"id":156,"customKey":47,"icon":157,"iconStyle":114,"iconTitle":47,"descTitle":158,"descContent":159,"source":160},"91268435_25","/cdn/init/1028100_Skill_9400091_Icon.png","鑽地","進入「縮地」狀態，持續消耗體力，可以免疫遠程攻擊，但是會被地震類型的技能擊飛。",{"attributes":161,"type":162,"consume":47,"power":47},[],[],{"id":164,"type":62,"props":165,"children":168},"91268435_26",{"title":166,"type":65,"id":167,"isUse":15,"isEdit":15,"useTabs":67,"blackHeader":67},"伊莫特性","91268435_27",[169],{"id":170,"type":154,"props":171,"children":59},"91268435_28",{"id":172,"customKey":47,"icon":173,"iconStyle":65,"iconTitle":47,"descTitle":174,"descContent":175,"source":176},"91268435_29","/cdn/init/1028100_Feature_12812_Icon.png","大地親和","「縮地」狀態下，可以施放技能並且額外造成30%擊破。",{"attributes":177,"type":178,"consume":47,"power":47},[],[],{"id":180,"type":62,"props":181,"children":59},"91268435_30",{"title":182,"type":65,"id":183,"isUse":15,"isEdit":15,"useTabs":15,"blackHeader":67,"tabs":184},"技能介紹","91268435_31",[185,214],{"id":186,"title":187,"children":188},"91268435_32","戰鬥技能",[189,202],{"id":190,"type":154,"props":191},"91268435_33",{"id":192,"customKey":47,"icon":193,"iconStyle":65,"iconTitle":47,"descTitle":194,"descContent":195,"source":196},"91268435_34","/cdn/init/1028100_Skill_10800140_Icon.png","地刺","向前方生成一道岩石地刺，穿刺路徑上的目標。",{"attributes":197,"type":199,"consume":200,"power":201},[198],"8",[22],"20","68",{"id":203,"type":154,"props":204},"91268435_35",{"id":205,"customKey":47,"icon":206,"iconStyle":65,"iconTitle":47,"descTitle":207,"descContent":208,"source":209},"91268435_36","/cdn/init/1028100_Skill_10800150_Icon.png","岩彈","發射一枚岩彈攻擊目標。",{"attributes":210,"type":211,"consume":212,"power":213},[198],[22],"10","33",{"id":215,"title":216,"children":217},"91268435_37","固有技能",[218],{"id":219,"type":154,"props":220},"91268435_38",{"id":221,"customKey":47,"icon":222,"iconStyle":65,"iconTitle":47,"descTitle":223,"descContent":224,"source":225},"91268435_39","/cdn/init/1028100_Skill_16600000_Icon.png","攻擊","擊破使用土元素能力，近距離攻擊目標。",{"attributes":226,"type":227,"consume":228,"power":229},[198],[22],"0","6",[231],{"id":4,"entryId":17,"currentMorphology":13,"visible":15},[233,245,256,267,278,288,298,310,320,330,340,351,361,373,383,394,405,415,425,435,445,455,465,475,485,495,505,515,525,535,545,555,565,575,585,595,605,616,626,636,646,656,666,676,686,696,706,716,726,736,746,756,766,776,786,796,806,816,826,836,846,856,866,876,886,896,906,916,926,935,939,946,955,964,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1133,1143,1153,1164],{"id":234,"viewCount":59,"searchKey":235,"visible":15},"10003442",{"type":10,"entryId":236,"sortOrder":237,"name":238,"imageUrl":239,"description":240,"currentMorphology":13,"currentStage":22,"position":241,"attributes":243},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[242],"position-dps",[244],"attributes-fire",{"id":246,"viewCount":59,"searchKey":247,"visible":15},"10003534",{"type":10,"entryId":248,"sortOrder":249,"name":250,"imageUrl":251,"description":252,"currentMorphology":13,"currentStage":253,"position":254,"attributes":255},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[242],[244],{"id":257,"viewCount":59,"searchKey":258,"visible":15},"10003435",{"type":10,"entryId":259,"sortOrder":260,"name":261,"imageUrl":262,"description":263,"currentMorphology":13,"currentStage":264,"position":265,"attributes":266},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[242],[244],{"id":268,"viewCount":59,"searchKey":269,"visible":15},"10003428",{"type":10,"entryId":270,"sortOrder":271,"name":272,"imageUrl":273,"description":274,"currentMorphology":13,"currentStage":264,"position":275,"attributes":276},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[24],[244,277],"attributes-dark",{"id":279,"viewCount":59,"searchKey":280,"visible":15},"10003578",{"type":10,"entryId":281,"sortOrder":282,"name":283,"imageUrl":284,"description":285,"currentMorphology":13,"currentStage":22,"position":286,"attributes":287},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[242],[277],{"id":289,"viewCount":59,"searchKey":290,"visible":15},"10003417",{"type":10,"entryId":291,"sortOrder":292,"name":293,"imageUrl":294,"description":295,"currentMorphology":13,"currentStage":264,"position":296,"attributes":297},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[242],[277],{"id":299,"viewCount":59,"searchKey":300,"visible":15},"10003488",{"type":10,"entryId":301,"sortOrder":302,"name":303,"imageUrl":304,"description":305,"currentMorphology":13,"currentStage":22,"position":306,"attributes":308},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[307],"position-sup",[309],"attributes-wind",{"id":311,"viewCount":59,"searchKey":312,"visible":15},"10003548",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":13,"currentStage":264,"position":318,"attributes":319},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[307],[309],{"id":321,"viewCount":59,"searchKey":322,"visible":15},"10003474",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":13,"currentStage":264,"position":328,"attributes":329},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[242],[309],{"id":331,"viewCount":59,"searchKey":332,"visible":15},"10003467",{"type":10,"entryId":333,"sortOrder":334,"name":335,"imageUrl":336,"description":337,"currentMorphology":13,"currentStage":264,"position":338,"attributes":339},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[24],[309],{"id":341,"viewCount":59,"searchKey":342,"visible":15},"10003392",{"type":10,"entryId":343,"sortOrder":344,"name":345,"imageUrl":346,"description":347,"currentMorphology":13,"currentStage":22,"position":348,"attributes":349},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[242],[350],"attributes-grass",{"id":352,"viewCount":59,"searchKey":353,"visible":15},"10003510",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":13,"currentStage":264,"position":359,"attributes":360},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[242],[350],{"id":362,"viewCount":59,"searchKey":363,"visible":15},"10003477",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":13,"currentStage":22,"position":369,"attributes":371},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[370],"position-heal",[372],"attributes-water",{"id":374,"viewCount":59,"searchKey":375,"visible":15},"10003569",{"type":10,"entryId":376,"sortOrder":377,"name":378,"imageUrl":379,"description":380,"currentMorphology":13,"currentStage":253,"position":381,"attributes":382},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[370],[372],{"id":384,"viewCount":59,"searchKey":385,"visible":15},"10003470",{"type":10,"entryId":386,"sortOrder":387,"name":388,"imageUrl":389,"description":390,"currentMorphology":13,"currentStage":264,"position":391,"attributes":392},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[370],[372,393],"attributes-ice",{"id":395,"viewCount":59,"searchKey":396,"visible":15},"10003463",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":13,"currentStage":264,"position":402,"attributes":404},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[403],"position-energy",[350,372],{"id":406,"viewCount":59,"searchKey":407,"visible":15},"10003468",{"type":10,"entryId":408,"sortOrder":409,"name":410,"imageUrl":411,"description":412,"currentMorphology":13,"currentStage":22,"position":413,"attributes":414},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[307],[309],{"id":416,"viewCount":59,"searchKey":417,"visible":15},"10003365",{"type":10,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":13,"currentStage":264,"position":423,"attributes":424},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[307],[309],{"id":426,"viewCount":59,"searchKey":427,"visible":15},"10003461",{"type":10,"entryId":428,"sortOrder":429,"name":430,"imageUrl":431,"description":432,"currentMorphology":13,"currentStage":264,"position":433,"attributes":434},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[307],[277],{"id":436,"viewCount":59,"searchKey":437,"visible":15},"10003421",{"type":10,"entryId":438,"sortOrder":439,"name":440,"imageUrl":441,"description":442,"currentMorphology":13,"currentStage":22,"position":443,"attributes":444},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[24],[350],{"id":446,"viewCount":59,"searchKey":447,"visible":15},"10003414",{"type":10,"entryId":448,"sortOrder":449,"name":450,"imageUrl":451,"description":452,"currentMorphology":13,"currentStage":264,"position":453,"attributes":454},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[403],[277,350],{"id":456,"viewCount":59,"searchKey":457,"visible":15},"10003404",{"type":10,"entryId":458,"sortOrder":459,"name":460,"imageUrl":461,"description":462,"currentMorphology":13,"currentStage":264,"position":463,"attributes":464},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[24],[350],{"id":466,"viewCount":59,"searchKey":467,"visible":15},"10003567",{"type":10,"entryId":468,"sortOrder":469,"name":470,"imageUrl":471,"description":472,"currentMorphology":13,"currentStage":22,"position":473,"attributes":474},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[24],[26,350],{"id":476,"viewCount":59,"searchKey":477,"visible":15},"10003462",{"type":10,"entryId":478,"sortOrder":479,"name":480,"imageUrl":481,"description":482,"currentMorphology":13,"currentStage":264,"position":483,"attributes":484},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[24],[26,350],{"id":486,"viewCount":59,"searchKey":487,"visible":15},"10003551",{"type":10,"entryId":488,"sortOrder":489,"name":490,"imageUrl":491,"description":492,"currentMorphology":13,"currentStage":264,"position":493,"attributes":494},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[24],[393],{"id":496,"viewCount":59,"searchKey":497,"visible":15},"10003409",{"type":10,"entryId":498,"sortOrder":499,"name":500,"imageUrl":501,"description":502,"currentMorphology":13,"currentStage":22,"position":503,"attributes":504},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[403],[244],{"id":506,"viewCount":59,"searchKey":507,"visible":15},"10003507",{"type":10,"entryId":508,"sortOrder":509,"name":510,"imageUrl":511,"description":512,"currentMorphology":13,"currentStage":264,"position":513,"attributes":514},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[403],[244],{"id":516,"viewCount":59,"searchKey":517,"visible":15},"10003542",{"type":10,"entryId":518,"sortOrder":519,"name":520,"imageUrl":521,"description":522,"currentMorphology":13,"currentStage":22,"position":523,"attributes":524},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[370],[309],{"id":526,"viewCount":59,"searchKey":527,"visible":15},"10003440",{"type":10,"entryId":528,"sortOrder":529,"name":530,"imageUrl":531,"description":532,"currentMorphology":13,"currentStage":264,"position":533,"attributes":534},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[370],[309],{"id":536,"viewCount":59,"searchKey":537,"visible":15},"10003563",{"type":10,"entryId":538,"sortOrder":539,"name":540,"imageUrl":541,"description":542,"currentMorphology":13,"currentStage":228,"position":543,"attributes":544},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[403],[309,350],{"id":546,"viewCount":59,"searchKey":547,"visible":15},"10003368",{"type":10,"entryId":548,"sortOrder":549,"name":550,"imageUrl":551,"description":552,"currentMorphology":13,"currentStage":22,"position":553,"attributes":554},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[307],[309],{"id":556,"viewCount":59,"searchKey":557,"visible":15},"10003363",{"type":10,"entryId":558,"sortOrder":559,"name":560,"imageUrl":561,"description":562,"currentMorphology":13,"currentStage":264,"position":563,"attributes":564},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[307],[309],{"id":566,"viewCount":59,"searchKey":567,"visible":15},"10003515",{"type":10,"entryId":568,"sortOrder":569,"name":570,"imageUrl":571,"description":572,"currentMorphology":13,"currentStage":22,"position":573,"attributes":574},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[242],[350],{"id":576,"viewCount":59,"searchKey":577,"visible":15},"10003496",{"type":10,"entryId":578,"sortOrder":579,"name":580,"imageUrl":581,"description":582,"currentMorphology":13,"currentStage":264,"position":583,"attributes":584},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[242],[350],{"id":586,"viewCount":59,"searchKey":587,"visible":15},"10003378",{"type":10,"entryId":588,"sortOrder":589,"name":590,"imageUrl":591,"description":592,"currentMorphology":13,"currentStage":264,"position":593,"attributes":594},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[307],[350],{"id":596,"viewCount":59,"searchKey":597,"visible":15},"10003456",{"type":10,"entryId":598,"sortOrder":599,"name":600,"imageUrl":601,"description":602,"currentMorphology":13,"currentStage":22,"position":603,"attributes":604},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[24],[350],{"id":606,"viewCount":59,"searchKey":607,"visible":15},"10003374",{"type":10,"entryId":608,"sortOrder":609,"name":610,"imageUrl":611,"description":612,"currentMorphology":13,"currentStage":264,"position":613,"attributes":614},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[307],[615],"attributes-electric",{"id":617,"viewCount":59,"searchKey":618,"visible":15},"10003443",{"type":10,"entryId":619,"sortOrder":620,"name":621,"imageUrl":622,"description":623,"currentMorphology":13,"currentStage":264,"position":624,"attributes":625},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[24],[350],{"id":627,"viewCount":59,"searchKey":628,"visible":15},"10003503",{"type":10,"entryId":629,"sortOrder":630,"name":631,"imageUrl":632,"description":633,"currentMorphology":13,"currentStage":22,"position":634,"attributes":635},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[307],[277],{"id":637,"viewCount":59,"searchKey":638,"visible":15},"10003521",{"type":10,"entryId":639,"sortOrder":640,"name":641,"imageUrl":642,"description":643,"currentMorphology":13,"currentStage":264,"position":644,"attributes":645},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[307],[277],{"id":647,"viewCount":59,"searchKey":648,"visible":15},"10003508",{"type":10,"entryId":649,"sortOrder":650,"name":651,"imageUrl":652,"description":653,"currentMorphology":13,"currentStage":22,"position":654,"attributes":655},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[242],[277],{"id":657,"viewCount":59,"searchKey":658,"visible":15},"10003369",{"type":10,"entryId":659,"sortOrder":660,"name":661,"imageUrl":662,"description":663,"currentMorphology":13,"currentStage":264,"position":664,"attributes":665},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[242],[277],{"id":667,"viewCount":59,"searchKey":668,"visible":15},"10003501",{"type":10,"entryId":669,"sortOrder":670,"name":671,"imageUrl":672,"description":673,"currentMorphology":13,"currentStage":264,"position":674,"attributes":675},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[242],[615],{"id":677,"viewCount":59,"searchKey":678,"visible":15},"10003422",{"type":10,"entryId":679,"sortOrder":680,"name":681,"imageUrl":682,"description":683,"currentMorphology":13,"currentStage":22,"position":684,"attributes":685},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[242],[393],{"id":687,"viewCount":59,"searchKey":688,"visible":15},"10003575",{"type":10,"entryId":689,"sortOrder":690,"name":691,"imageUrl":692,"description":693,"currentMorphology":13,"currentStage":253,"position":694,"attributes":695},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[242],[393],{"id":697,"viewCount":59,"searchKey":698,"visible":15},"10003415",{"type":10,"entryId":699,"sortOrder":700,"name":701,"imageUrl":702,"description":703,"currentMorphology":13,"currentStage":264,"position":704,"attributes":705},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[242],[393],{"id":707,"viewCount":59,"searchKey":708,"visible":15},"10003524",{"type":10,"entryId":709,"sortOrder":710,"name":711,"imageUrl":712,"description":713,"currentMorphology":13,"currentStage":22,"position":714,"attributes":715},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[24],[615],{"id":717,"viewCount":59,"searchKey":718,"visible":15},"10003475",{"type":10,"entryId":719,"sortOrder":720,"name":721,"imageUrl":722,"description":723,"currentMorphology":13,"currentStage":264,"position":724,"attributes":725},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[24],[615],{"id":727,"viewCount":59,"searchKey":728,"visible":15},"10003523",{"type":10,"entryId":729,"sortOrder":730,"name":731,"imageUrl":732,"description":733,"currentMorphology":13,"currentStage":22,"position":734,"attributes":735},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[24],[372],{"id":737,"viewCount":59,"searchKey":738,"visible":15},"10003398",{"type":10,"entryId":739,"sortOrder":740,"name":741,"imageUrl":742,"description":743,"currentMorphology":13,"currentStage":253,"position":744,"attributes":745},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[24],[372],{"id":747,"viewCount":59,"searchKey":748,"visible":15},"10003516",{"type":10,"entryId":749,"sortOrder":750,"name":751,"imageUrl":752,"description":753,"currentMorphology":13,"currentStage":264,"position":754,"attributes":755},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[307],[372],{"id":757,"viewCount":59,"searchKey":758,"visible":15},"10003566",{"type":10,"entryId":759,"sortOrder":760,"name":761,"imageUrl":762,"description":763,"currentMorphology":13,"currentStage":264,"position":764,"attributes":765},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[24],[372],{"id":767,"viewCount":59,"searchKey":768,"visible":15},"10003453",{"type":10,"entryId":769,"sortOrder":770,"name":771,"imageUrl":772,"description":773,"currentMorphology":13,"currentStage":22,"position":774,"attributes":775},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[242],[372],{"id":777,"viewCount":59,"searchKey":778,"visible":15},"10003577",{"type":10,"entryId":779,"sortOrder":780,"name":781,"imageUrl":782,"description":783,"currentMorphology":13,"currentStage":253,"position":784,"attributes":785},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[242],[372],{"id":787,"viewCount":59,"searchKey":788,"visible":15},"10003570",{"type":10,"entryId":789,"sortOrder":790,"name":791,"imageUrl":792,"description":793,"currentMorphology":13,"currentStage":264,"position":794,"attributes":795},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[242],[372],{"id":797,"viewCount":59,"searchKey":798,"visible":15},"10003565",{"type":10,"entryId":799,"sortOrder":800,"name":801,"imageUrl":802,"description":803,"currentMorphology":13,"currentStage":22,"position":804,"attributes":805},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[242],[26],{"id":807,"viewCount":59,"searchKey":808,"visible":15},"10003476",{"type":10,"entryId":809,"sortOrder":810,"name":811,"imageUrl":812,"description":813,"currentMorphology":13,"currentStage":264,"position":814,"attributes":815},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[242],[26],{"id":817,"viewCount":59,"searchKey":818,"visible":15},"10003466",{"type":10,"entryId":819,"sortOrder":820,"name":821,"imageUrl":822,"description":823,"currentMorphology":13,"currentStage":264,"position":824,"attributes":825},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[307],[26],{"id":827,"viewCount":59,"searchKey":828,"visible":15},"10003379",{"type":10,"entryId":829,"sortOrder":830,"name":831,"imageUrl":832,"description":833,"currentMorphology":13,"currentStage":22,"position":834,"attributes":835},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[242],[615],{"id":837,"viewCount":59,"searchKey":838,"visible":15},"10003376",{"type":10,"entryId":839,"sortOrder":840,"name":841,"imageUrl":842,"description":843,"currentMorphology":13,"currentStage":264,"position":844,"attributes":845},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[242],[615],{"id":847,"viewCount":59,"searchKey":848,"visible":15},"10003543",{"type":10,"entryId":849,"sortOrder":850,"name":851,"imageUrl":852,"description":853,"currentMorphology":13,"currentStage":22,"position":854,"attributes":855},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[24],[277],{"id":857,"viewCount":59,"searchKey":858,"visible":15},"10003557",{"type":10,"entryId":859,"sortOrder":860,"name":861,"imageUrl":862,"description":863,"currentMorphology":13,"currentStage":264,"position":864,"attributes":865},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[242],[277],{"id":867,"viewCount":59,"searchKey":868,"visible":15},"10003522",{"type":10,"entryId":869,"sortOrder":870,"name":871,"imageUrl":872,"description":873,"currentMorphology":13,"currentStage":264,"position":874,"attributes":875},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[24],[277],{"id":877,"viewCount":59,"searchKey":878,"visible":15},"10003579",{"type":10,"entryId":879,"sortOrder":880,"name":881,"imageUrl":882,"description":883,"currentMorphology":13,"currentStage":22,"position":884,"attributes":885},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[24],[309],{"id":887,"viewCount":59,"searchKey":888,"visible":15},"10003389",{"type":10,"entryId":889,"sortOrder":890,"name":891,"imageUrl":892,"description":893,"currentMorphology":13,"currentStage":253,"position":894,"attributes":895},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[24],[309],{"id":897,"viewCount":59,"searchKey":898,"visible":15},"10003536",{"type":10,"entryId":899,"sortOrder":900,"name":901,"imageUrl":902,"description":903,"currentMorphology":13,"currentStage":264,"position":904,"attributes":905},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[24],[309],{"id":907,"viewCount":59,"searchKey":908,"visible":15},"10003529",{"type":10,"entryId":909,"sortOrder":910,"name":911,"imageUrl":912,"description":913,"currentMorphology":13,"currentStage":264,"position":914,"attributes":915},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[242],[244],{"id":917,"viewCount":59,"searchKey":918,"visible":15},"10003433",{"type":10,"entryId":919,"sortOrder":920,"name":921,"imageUrl":922,"description":923,"currentMorphology":13,"currentStage":22,"position":924,"attributes":925},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[242],[26],{"id":927,"viewCount":59,"searchKey":928,"visible":15},"10003427",{"type":10,"entryId":8,"sortOrder":929,"name":930,"imageUrl":931,"description":932,"currentMorphology":13,"currentStage":264,"position":933,"attributes":934},1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[242],[26],{"id":4,"viewCount":59,"searchKey":936,"visible":15},{"type":10,"entryId":17,"sortOrder":18,"name":19,"imageUrl":20,"description":21,"currentMorphology":13,"currentStage":22,"position":937,"attributes":938},[24],[26],{"id":6,"viewCount":59,"searchKey":940,"visible":15},{"type":10,"entryId":12,"sortOrder":941,"name":81,"imageUrl":942,"description":943,"currentMorphology":13,"currentStage":253,"position":944,"attributes":945},1028200,"/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[24],[244,26],{"id":947,"viewCount":59,"searchKey":948,"visible":15},"10003399",{"type":10,"entryId":949,"sortOrder":950,"name":89,"imageUrl":951,"description":952,"currentMorphology":13,"currentStage":264,"position":953,"attributes":954},"073",1028300,"/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[24],[244,26],{"id":956,"viewCount":59,"searchKey":957,"visible":15},"10003518",{"type":10,"entryId":958,"sortOrder":959,"name":97,"imageUrl":960,"description":961,"currentMorphology":13,"currentStage":253,"position":962,"attributes":963},"074",1028400,"/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[24],[26],{"id":965,"viewCount":59,"searchKey":966,"visible":15},"10003393",{"type":10,"entryId":967,"sortOrder":968,"name":104,"imageUrl":969,"description":970,"currentMorphology":13,"currentStage":264,"position":971,"attributes":972},"075",1028500,"/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[24],[26],{"id":974,"viewCount":59,"searchKey":975,"visible":15},"10003386",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":13,"currentStage":22,"position":981,"attributes":982},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[307],[26],{"id":984,"viewCount":59,"searchKey":985,"visible":15},"10003447",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":13,"currentStage":264,"position":991,"attributes":992},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[307],[26],{"id":994,"viewCount":59,"searchKey":995,"visible":15},"10003497",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":13,"currentStage":22,"position":1001,"attributes":1002},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[307],[615],{"id":1004,"viewCount":59,"searchKey":1005,"visible":15},"10003479",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":13,"currentStage":253,"position":1011,"attributes":1012},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[307],[615],{"id":1014,"viewCount":59,"searchKey":1015,"visible":15},"10003388",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":13,"currentStage":264,"position":1021,"attributes":1022},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[307],[615],{"id":1024,"viewCount":59,"searchKey":1025,"visible":15},"10003429",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":13,"currentStage":22,"position":1031,"attributes":1032},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[403],[372],{"id":1034,"viewCount":59,"searchKey":1035,"visible":15},"10003430",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":13,"currentStage":264,"position":1041,"attributes":1042},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[403],[372],{"id":1044,"viewCount":59,"searchKey":1045,"visible":15},"10003549",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":13,"currentStage":228,"position":1051,"attributes":1052},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[403],[615],{"id":1054,"viewCount":59,"searchKey":1055,"visible":15},"10003494",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":13,"currentStage":22,"position":1061,"attributes":1062},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[403],[26,372],{"id":1064,"viewCount":59,"searchKey":1065,"visible":15},"10003486",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":13,"currentStage":264,"position":1071,"attributes":1072},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[403],[26,372],{"id":1074,"viewCount":59,"searchKey":1075,"visible":15},"10003530",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":13,"currentStage":22,"position":1081,"attributes":1082},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[24],[393],{"id":1084,"viewCount":59,"searchKey":1085,"visible":15},"10003457",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":13,"currentStage":264,"position":1091,"attributes":1092},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[24],[393],{"id":1094,"viewCount":59,"searchKey":1095,"visible":15},"10003423",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":13,"currentStage":22,"position":1101,"attributes":1102},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[370],[350,372],{"id":1104,"viewCount":59,"searchKey":1105,"visible":15},"10003419",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":13,"currentStage":264,"position":1111,"attributes":1112},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[370],[350,372],{"id":1114,"viewCount":59,"searchKey":1115,"visible":15},"10003410",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":13,"currentStage":22,"position":1121,"attributes":1122},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[242],[372],{"id":1124,"viewCount":59,"searchKey":1125,"visible":15},"10003509",{"type":10,"entryId":1126,"sortOrder":1127,"name":1128,"imageUrl":1129,"description":1130,"currentMorphology":13,"currentStage":264,"position":1131,"attributes":1132},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[242],[372],{"id":1134,"viewCount":59,"searchKey":1135,"visible":15},"10003413",{"type":10,"entryId":1136,"sortOrder":1137,"name":1138,"imageUrl":1139,"description":1140,"currentMorphology":13,"currentStage":22,"position":1141,"attributes":1142},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[242],[393],{"id":1144,"viewCount":59,"searchKey":1145,"visible":15},"10003407",{"type":10,"entryId":1146,"sortOrder":1147,"name":1148,"imageUrl":1149,"description":1150,"currentMorphology":13,"currentStage":264,"position":1151,"attributes":1152},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[242],[393],{"id":1154,"viewCount":59,"searchKey":1155,"visible":15},"10003498",{"type":10,"entryId":1156,"sortOrder":1157,"name":1158,"imageUrl":1159,"description":1160,"currentMorphology":13,"currentStage":228,"position":1161,"attributes":1162},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[242],[1163],"attributes-holy",{"id":1165,"viewCount":59,"searchKey":1166,"visible":15},"10003375",{"type":10,"entryId":1167,"sortOrder":1168,"name":1169,"imageUrl":1170,"description":1171,"currentMorphology":13,"currentStage":228,"position":1172,"attributes":1173},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[242],[1163],[1175,1183,1188,1193,1198,1203,1208,1213,1217,1220,1225,1230,1235,1240,1245,1250,1255,1260,1263],{"id":1176,"parentId":1177,"tagType":1178,"tagKey":1179,"name":1180,"language":1181,"sort":1182},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1184,"parentId":1177,"tagType":1178,"tagKey":1185,"name":1186,"language":1181,"sort":1187},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1189,"parentId":1177,"tagType":1178,"tagKey":1190,"name":1191,"language":1181,"sort":1192},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1194,"parentId":1177,"tagType":1178,"tagKey":1195,"name":1196,"language":1181,"sort":1197},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1199,"parentId":1177,"tagType":1178,"tagKey":1200,"name":1201,"language":1181,"sort":1202},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1204,"parentId":1177,"tagType":1178,"tagKey":1205,"name":1206,"language":1181,"sort":1207},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1209,"parentId":1177,"tagType":1178,"tagKey":1210,"name":1211,"language":1181,"sort":1212},"568127bc77f184cd4308056381642df7","Snowfield Form","雪地型態",5,{"id":1214,"parentId":1177,"tagType":1178,"tagKey":1215,"name":1216,"language":1181,"sort