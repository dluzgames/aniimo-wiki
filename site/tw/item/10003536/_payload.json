10,"type":211,"consume":212,"power":213},[198],[121],"20","69",{"id":215,"type":139,"props":216},"91268567_37",{"id":217,"customKey":46,"icon":218,"iconStyle":65,"iconTitle":46,"descTitle":219,"descContent":220,"source":221},"91268567_38","/cdn/init/1002300_Skill_10700180_Icon.png","擊破爪擊","揮爪對目標造成攻擊。",{"attributes":222,"type":223,"consume":212,"power":224},[198],[121],"68",{"id":226,"title":227,"children":228},"91268567_39","固有技能",[229,241],{"id":230,"type":139,"props":231},"91268567_40",{"id":232,"customKey":46,"icon":233,"iconStyle":65,"iconTitle":46,"descTitle":234,"descContent":235,"source":236},"91268567_41","/cdn/init/1002300_Skill_10700020_Icon.png","天墜","飛到高空後俯衝撞擊地面，造成巨額傷害。",{"attributes":237,"type":238,"consume":239,"power":240},[198],[121],"0","175",{"id":242,"type":139,"props":243},"91268567_42",{"id":244,"customKey":46,"icon":245,"iconStyle":65,"iconTitle":46,"descTitle":246,"descContent":247,"source":248},"91268567_43","/cdn/init/1002300_Skill_16700000_Icon.png","攻擊","擊破使用風元素能力，近距離攻擊目標。",{"attributes":249,"type":250,"consume":239,"power":251},[198],[121],"6",[253,254],{"id":4,"entryId":12,"currentMorphology":20,"visible":14},{"id":6,"entryId":12,"currentMorphology":9,"visible":14},[256,268,279,289,300,310,320,331,341,351,361,372,382,394,404,415,426,436,446,456,466,476,486,497,507,517,527,537,547,557,567,577,587,597,607,617,627,638,648,658,668,678,688,698,708,718,728,738,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,908,916,920,929,939,949,959,969,979,989,999,1009,1019,1029,1039,1049,1059,1069,1079,1089,1099,1109,1119,1129,1139,1149,1159,1169,1179,1190],{"id":257,"viewCount":59,"searchKey":258,"visible":14},"10003442",{"type":10,"entryId":259,"sortOrder":260,"name":261,"imageUrl":262,"description":263,"currentMorphology":20,"currentStage":121,"position":264,"attributes":266},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[265],"position-dps",[267],"attributes-fire",{"id":269,"viewCount":59,"searchKey":270,"visible":14},"10003534",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":20,"currentStage":276,"position":277,"attributes":278},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。","2",[265],[267],{"id":280,"viewCount":59,"searchKey":281,"visible":14},"10003435",{"type":10,"entryId":282,"sortOrder":283,"name":284,"imageUrl":285,"description":286,"currentMorphology":20,"currentStage":21,"position":287,"attributes":288},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[265],[267],{"id":290,"viewCount":59,"searchKey":291,"visible":14},"10003428",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":20,"currentStage":21,"position":297,"attributes":298},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[23],[267,299],"attributes-dark",{"id":301,"viewCount":59,"searchKey":302,"visible":14},"10003578",{"type":10,"entryId":303,"sortOrder":304,"name":305,"imageUrl":306,"description":307,"currentMorphology":20,"currentStage":121,"position":308,"attributes":309},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[265],[299],{"id":311,"viewCount":59,"searchKey":312,"visible":14},"10003417",{"type":10,"entryId":313,"sortOrder":314,"name":315,"imageUrl":316,"description":317,"currentMorphology":20,"currentStage":21,"position":318,"attributes":319},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[265],[299],{"id":321,"viewCount":59,"searchKey":322,"visible":14},"10003488",{"type":10,"entryId":323,"sortOrder":324,"name":325,"imageUrl":326,"description":327,"currentMorphology":20,"currentStage":121,"position":328,"attributes":330},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[329],"position-sup",[25],{"id":332,"viewCount":59,"searchKey":333,"visible":14},"10003548",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":20,"currentStage":21,"position":339,"attributes":340},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[329],[25],{"id":342,"viewCount":59,"searchKey":343,"visible":14},"10003474",{"type":10,"entryId":344,"sortOrder":345,"name":346,"imageUrl":347,"description":348,"currentMorphology":20,"currentStage":21,"position":349,"attributes":350},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[265],[25],{"id":352,"viewCount":59,"searchKey":353,"visible":14},"10003467",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":20,"currentStage":21,"position":359,"attributes":360},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[23],[25],{"id":362,"viewCount":59,"searchKey":363,"visible":14},"10003392",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":20,"currentStage":121,"position":369,"attributes":370},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[265],[371],"attributes-grass",{"id":373,"viewCount":59,"searchKey":374,"visible":14},"10003510",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":20,"currentStage":21,"position":380,"attributes":381},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[265],[371],{"id":383,"viewCount":59,"searchKey":384,"visible":14},"10003477",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":20,"currentStage":121,"position":390,"attributes":392},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[391],"position-heal",[393],"attributes-water",{"id":395,"viewCount":59,"searchKey":396,"visible":14},"10003569",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":20,"currentStage":276,"position":402,"attributes":403},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[391],[393],{"id":405,"viewCount":59,"searchKey":406,"visible":14},"10003470",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":20,"currentStage":21,"position":412,"attributes":413},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[391],[393,414],"attributes-ice",{"id":416,"viewCount":59,"searchKey":417,"visible":14},"10003463",{"type":10,"entryId":418,"sortOrder":419,"name":420,"imageUrl":421,"description":422,"currentMorphology":20,"currentStage":21,"position":423,"attributes":425},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[424],"position-energy",[371,393],{"id":427,"viewCount":59,"searchKey":428,"visible":14},"10003468",{"type":10,"entryId":429,"sortOrder":430,"name":431,"imageUrl":432,"description":433,"currentMorphology":20,"currentStage":121,"position":434,"attributes":435},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[329],[25],{"id":437,"viewCount":59,"searchKey":438,"visible":14},"10003365",{"type":10,"entryId":439,"sortOrder":440,"name":441,"imageUrl":442,"description":443,"currentMorphology":20,"currentStage":21,"position":444,"attributes":445},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[329],[25],{"id":447,"viewCount":59,"searchKey":448,"visible":14},"10003461",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":20,"currentStage":21,"position":454,"attributes":455},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[329],[299],{"id":457,"viewCount":59,"searchKey":458,"visible":14},"10003421",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":20,"currentStage":121,"position":464,"attributes":465},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[23],[371],{"id":467,"viewCount":59,"searchKey":468,"visible":14},"10003414",{"type":10,"entryId":469,"sortOrder":470,"name":471,"imageUrl":472,"description":473,"currentMorphology":20,"currentStage":21,"position":474,"attributes":475},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[424],[299,371],{"id":477,"viewCount":59,"searchKey":478,"visible":14},"10003404",{"type":10,"entryId":479,"sortOrder":480,"name":481,"imageUrl":482,"description":483,"currentMorphology":20,"currentStage":21,"position":484,"attributes":485},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[23],[371],{"id":487,"viewCount":59,"searchKey":488,"visible":14},"10003567",{"type":10,"entryId":489,"sortOrder":490,"name":491,"imageUrl":492,"description":493,"currentMorphology":20,"currentStage":121,"position":494,"attributes":495},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[23],[496,371],"attributes-rock",{"id":498,"viewCount":59,"searchKey":499,"visible":14},"10003462",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":20,"currentStage":21,"position":505,"attributes":506},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[23],[496,371],{"id":508,"viewCount":59,"searchKey":509,"visible":14},"10003551",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":20,"currentStage":21,"position":515,"attributes":516},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[23],[414],{"id":518,"viewCount":59,"searchKey":519,"visible":14},"10003409",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":20,"currentStage":121,"position":525,"attributes":526},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[424],[267],{"id":528,"viewCount":59,"searchKey":529,"visible":14},"10003507",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":20,"currentStage":21,"position":535,"attributes":536},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[424],[267],{"id":538,"viewCount":59,"searchKey":539,"visible":14},"10003542",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":20,"currentStage":121,"position":545,"attributes":546},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[391],[25],{"id":548,"viewCount":59,"searchKey":549,"visible":14},"10003440",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":20,"currentStage":21,"position":555,"attributes":556},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[391],[25],{"id":558,"viewCount":59,"searchKey":559,"visible":14},"10003563",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":20,"currentStage":239,"position":565,"attributes":566},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[424],[25,371],{"id":568,"viewCount":59,"searchKey":569,"visible":14},"10003368",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":20,"currentStage":121,"position":575,"attributes":576},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[329],[25],{"id":578,"viewCount":59,"searchKey":579,"visible":14},"10003363",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":20,"currentStage":21,"position":585,"attributes":586},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[329],[25],{"id":588,"viewCount":59,"searchKey":589,"visible":14},"10003515",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":20,"currentStage":121,"position":595,"attributes":596},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[265],[371],{"id":598,"viewCount":59,"searchKey":599,"visible":14},"10003496",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":20,"currentStage":21,"position":605,"attributes":606},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[265],[371],{"id":608,"viewCount":59,"searchKey":609,"visible":14},"10003378",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":20,"currentStage":21,"position":615,"attributes":616},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[329],[371],{"id":618,"viewCount":59,"searchKey":619,"visible":14},"10003456",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":20,"currentStage":121,"position":625,"attributes":626},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[23],[371],{"id":628,"viewCount":59,"searchKey":629,"visible":14},"10003374",{"type":10,"entryId":630,"sortOrder":631,"name":632,"imageUrl":633,"description":634,"currentMorphology":20,"currentStage":21,"position":635,"attributes":636},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[329],[637],"attributes-electric",{"id":639,"viewCount":59,"searchKey":640,"visible":14},"10003443",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":20,"currentStage":21,"position":646,"attributes":647},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[23],[371],{"id":649,"viewCount":59,"searchKey":650,"visible":14},"10003503",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":20,"currentStage":121,"position":656,"attributes":657},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[329],[299],{"id":659,"viewCount":59,"searchKey":660,"visible":14},"10003521",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":20,"currentStage":21,"position":666,"attributes":667},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[329],[299],{"id":669,"viewCount":59,"searchKey":670,"visible":14},"10003508",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":20,"currentStage":121,"position":676,"attributes":677},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[265],[299],{"id":679,"viewCount":59,"searchKey":680,"visible":14},"10003369",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":20,"currentStage":21,"position":686,"attributes":687},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[265],[299],{"id":689,"viewCount":59,"searchKey":690,"visible":14},"10003501",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":20,"currentStage":21,"position":696,"attributes":697},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[265],[637],{"id":699,"viewCount":59,"searchKey":700,"visible":14},"10003422",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":20,"currentStage":121,"position":706,"attributes":707},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[265],[414],{"id":709,"viewCount":59,"searchKey":710,"visible":14},"10003575",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":20,"currentStage":276,"position":716,"attributes":717},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[265],[414],{"id":719,"viewCount":59,"searchKey":720,"visible":14},"10003415",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":20,"currentStage":21,"position":726,"attributes":727},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[265],[414],{"id":729,"viewCount":59,"searchKey":730,"visible":14},"10003524",{"type":10,"entryId":731,"sortOrder":732,"name":733,"imageUrl":734,"description":735,"currentMorphology":20,"currentStage":121,"position":736,"attributes":737},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[23],[637],{"id":739,"viewCount":59,"searchKey":740,"visible":14},"10003475",{"type":10,"entryId":741,"sortOrder":742,"name":743,"imageUrl":744,"description":745,"currentMorphology":20,"currentStage":21,"position":746,"attributes":747},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[23],[637],{"id":749,"viewCount":59,"searchKey":750,"visible":14},"10003523",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":20,"currentStage":121,"position":756,"attributes":757},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[23],[393],{"id":759,"viewCount":59,"searchKey":760,"visible":14},"10003398",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":20,"currentStage":276,"position":766,"attributes":767},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[23],[393],{"id":769,"viewCount":59,"searchKey":770,"visible":14},"10003516",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":20,"currentStage":21,"position":776,"attributes":777},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[329],[393],{"id":779,"viewCount":59,"searchKey":780,"visible":14},"10003566",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":20,"currentStage":21,"position":786,"attributes":787},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[23],[393],{"id":789,"viewCount":59,"searchKey":790,"visible":14},"10003453",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":20,"currentStage":121,"position":796,"attributes":797},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[265],[393],{"id":799,"viewCount":59,"searchKey":800,"visible":14},"10003577",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":20,"currentStage":276,"position":806,"attributes":807},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[265],[393],{"id":809,"viewCount":59,"searchKey":810,"visible":14},"10003570",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":20,"currentStage":21,"position":816,"attributes":817},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[265],[393],{"id":819,"viewCount":59,"searchKey":820,"visible":14},"10003565",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":20,"currentStage":121,"position":826,"attributes":827},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[265],[496],{"id":829,"viewCount":59,"searchKey":830,"visible":14},"10003476",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":20,"currentStage":21,"position":836,"attributes":837},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[265],[496],{"id":839,"viewCount":59,"searchKey":840,"visible":14},"10003466",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":20,"currentStage":21,"position":846,"attributes":847},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[329],[496],{"id":849,"viewCount":59,"searchKey":850,"visible":14},"10003379",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":20,"currentStage":121,"position":856,"attributes":857},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[265],[637],{"id":859,"viewCount":59,"searchKey":860,"visible":14},"10003376",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":20,"currentStage":21,"position":866,"attributes":867},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[265],[637],{"id":869,"viewCount":59,"searchKey":870,"visible":14},"10003543",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":20,"currentStage":121,"position":876,"attributes":877},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[23],[299],{"id":879,"viewCount":59,"searchKey":880,"visible":14},"10003557",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":20,"currentStage":21,"position":886,"attributes":887},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[265],[299],{"id":889,"viewCount":59,"searchKey":890,"visible":14},"10003522",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":20,"currentStage":21,"position":896,"attributes":897},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[23],[299],{"id":899,"viewCount":59,"searchKey":900,"visible":14},"10003579",{"type":10,"entryId":901,"sortOrder":902,"name":903,"imageUrl":904,"description":905,"currentMorphology":20,"currentStage":121,"position":906,"attributes":907},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[23],[25],{"id":909,"viewCount":59,"searchKey":910,"visible":14},"10003389",{"type":10,"entryId":8,"sortOrder":911,"name":75,"imageUrl":912,"description":913,"currentMorphology":20,"currentStage":276,"position":914,"attributes":915},1002200,"/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[23],[25],{"id":4,"viewCount":59,"searchKey":917,"visible":14},{"type":10,"entryId":12,"sortOrder":16,"name":17,"imageUrl":18,"description":19,"currentMorphology":20,"currentStage":21,"position":918,"attributes":919},[23],[25],{"id":921,"viewCount":59,"searchKey":922,"visible":14},"10003529",{"type":10,"entryId":923,"sortOrder":924,"name":88,"imageUrl":925,"description":926,"currentMorphology":20,"currentStage":21,"position":927,"attributes":928},"068",1002500,"/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[265],[267],{"id":930,"viewCount":59,"searchKey":931,"visible":14},"10003433",{"type":10,"entryId":932,"sortOrder":933,"name":934,"imageUrl":935,"description":936,"currentMorphology":20,"currentStage":121,"position":937,"attributes":938},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[265],[496],{"id":940,"viewCount":59,"searchKey":941,"visible":14},"10003427",{"type":10,"entryId":942,"sortOrder":943,"name":944,"imageUrl":945,"description":946,"currentMorphology":20,"currentStage":21,"position":947,"attributes":948},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[265],[496],{"id":950,"viewCount":59,"searchKey":951,"visible":14},"10003405",{"type":10,"entryId":952,"sortOrder":953,"name":954,"imageUrl":955,"description":956,"currentMorphology":20,"currentStage":121,"position":957,"attributes":958},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[23],[496],{"id":960,"viewCount":59,"searchKey":961,"visible":14},"10003525",{"type":10,"entryId":962,"sortOrder":963,"name":964,"imageUrl":965,"description":966,"currentMorphology":20,"currentStage":276,"position":967,"attributes":968},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[23],[267,496],{"id":970,"viewCount":59,"searchKey":971,"visible":14},"10003399",{"type":10,"entryId":972,"sortOrder":973,"name":974,"imageUrl":975,"description":976,"currentMorphology":20,"currentStage":21,"position":977,"attributes":978},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[23],[267,496],{"id":980,"viewCount":59,"searchKey":981,"visible":14},"10003518",{"type":10,"entryId":982,"sortOrder":983,"name":984,"imageUrl":985,"description":986,"currentMorphology":20,"currentStage":276,"position":987,"attributes":988},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[23],[496],{"id":990,"viewCount":59,"searchKey":991,"visible":14},"10003393",{"type":10,"entryId":992,"sortOrder":993,"name":994,"imageUrl":995,"description":996,"currentMorphology":20,"currentStage":21,"position":997,"attributes":998},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[23],[496],{"id":1000,"viewCount":59,"searchKey":1001,"visible":14},"10003386",{"type":10,"entryId":1002,"sortOrder":1003,"name":1004,"imageUrl":1005,"description":1006,"currentMorphology":20,"currentStage":121,"position":1007,"attributes":1008},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[329],[496],{"id":1010,"viewCount":59,"searchKey":1011,"visible":14},"10003447",{"type":10,"entryId":1012,"sortOrder":1013,"name":1014,"imageUrl":1015,"description":1016,"currentMorphology":20,"currentStage":21,"position":1017,"attributes":1018},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[329],[496],{"id":1020,"viewCount":59,"searchKey":1021,"visible":14},"10003497",{"type":10,"entryId":1022,"sortOrder":1023,"name":1024,"imageUrl":1025,"description":1026,"currentMorphology":20,"currentStage":121,"position":1027,"attributes":1028},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[329],[637],{"id":1030,"viewCount":59,"searchKey":1031,"visible":14},"10003479",{"type":10,"entryId":1032,"sortOrder":1033,"name":1034,"imageUrl":1035,"description":1036,"currentMorphology":20,"currentStage":276,"position":1037,"attributes":1038},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[329],[637],{"id":1040,"viewCount":59,"searchKey":1041,"visible":14},"10003388",{"type":10,"entryId":1042,"sortOrder":1043,"name":1044,"imageUrl":1045,"description":1046,"currentMorphology":20,"currentStage":21,"position":1047,"attributes":1048},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[329],[637],{"id":1050,"viewCount":59,"searchKey":1051,"visible":14},"10003429",{"type":10,"entryId":1052,"sortOrder":1053,"name":1054,"imageUrl":1055,"description":1056,"currentMorphology":20,"currentStage":121,"position":1057,"attributes":1058},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[424],[393],{"id":1060,"viewCount":59,"searchKey":1061,"visible":14},"10003430",{"type":10,"entryId":1062,"sortOrder":1063,"name":1064,"imageUrl":1065,"description":1066,"currentMorphology":20,"currentStage":21,"position":1067,"attributes":1068},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[424],[393],{"id":1070,"viewCount":59,"searchKey":1071,"visible":14},"10003549",{"type":10,"entryId":1072,"sortOrder":1073,"name":1074,"imageUrl":1075,"description":1076,"currentMorphology":20,"currentStage":239,"position":1077,"attributes":1078},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[424],[637],{"id":1080,"viewCount":59,"searchKey":1081,"visible":14},"10003494",{"type":10,"entryId":1082,"sortOrder":1083,"name":1084,"imageUrl":1085,"description":1086,"currentMorphology":20,"currentStage":121,"position":1087,"attributes":1088},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[424],[496,393],{"id":1090,"viewCount":59,"searchKey":1091,"visible":14},"10003486",{"type":10,"entryId":1092,"sortOrder":1093,"name":1094,"imageUrl":1095,"description":1096,"currentMorphology":20,"currentStage":21,"position":1097,"attributes":1098},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[424],[496,393],{"id":1100,"viewCount":59,"searchKey":1101,"visible":14},"10003530",{"type":10,"entryId":1102,"sortOrder":1103,"name":1104,"imageUrl":1105,"description":1106,"currentMorphology":20,"currentStage":121,"position":1107,"attributes":1108},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[23],[414],{"id":1110,"viewCount":59,"searchKey":1111,"visible":14},"10003457",{"type":10,"entryId":1112,"sortOrder":1113,"name":1114,"imageUrl":1115,"description":1116,"currentMorphology":20,"currentStage":21,"position":1117,"attributes":1118},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[23],[414],{"id":1120,"viewCount":59,"searchKey":1121,"visible":14},"10003423",{"type":10,"entryId":1122,"sortOrder":1123,"name":1124,"imageUrl":1125,"description":1126,"currentMorphology":20,"currentStage":121,"position":1127,"attributes":1128},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[391],[371,393],{"id":1130,"viewCount":59,"searchKey":1131,"visible":14},"10003419",{"type":10,"entryId":1132,"sortOrder":1133,"name":1134,"imageUrl":1135,"description":1136,"currentMorphology":20,"currentStage":21,"position":1137,"attributes":1138},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[391],[371,393],{"id":1140,"viewCount":59,"searchKey":1141,"visible":14},"10003410",{"type":10,"entryId":1142,"sortOrder":1143,"name":1144,"imageUrl":1145,"description":1146,"currentMorphology":20,"currentStage":121,"position":1147,"attributes":1148},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[265],[393],{"id":1150,"viewCount":59,"searchKey":1151,"visible":14},"10003509",{"type":10,"entryId":1152,"sortOrder":1153,"name":1154,"imageUrl":1155,"description":1156,"currentMorphology":20,"currentStage":21,"position":1157,"attributes":1158},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[265],[393],{"id":1160,"viewCount":59,"searchKey":1161,"visible":14},"10003413",{"type":10,"entryId":1162,"sortOrder":1163,"name":1164,"imageUrl":1165,"description":1166,"currentMorphology":20,"currentStage":121,"position":1167,"attributes":1168},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[265],[414],{"id":1170,"viewCount":59,"searchKey":1171,"visible":14},"10003407",{"type":10,"entryId":1172,"sortOrder":1173,"name":1174,"imageUrl":1175,"description":1176,"currentMorphology":20,"currentStage":21,"position":1177,"attributes":1178},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[265],[414],{"id":1180,"viewCount":59,"searchKey":1181,"visible":14},"10003498",{"type":10,"entryId":1182,"sortOrder":1183,"name":1184,"imageUrl":1185,"description":1186,"currentMorphology":20,"currentStage":239,"position":1187,"attributes":1188},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[265],[1189],"attributes-holy",{"id":1191,"viewCount":59,"searchKey":1192,"visible":14},"10003375",{"type":10,"entryId":1193,"sortOrder":1194,"name":1195,"imageUrl":1196,"description":1197,"currentMorphology":20,"currentStage":239,"position":1198,"attributes":1199},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[265],[1189],[1201,1209,1214,1219,1224,1229,1234,1239,1243,1247,1252,1257,1262,1266,1271,1276,1281,1286,1289],{"id":1202,"parentId":1203,"tagType":1204,"tagKey":1205,"name":1206,"language":1207,"sort":1208},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1210,"parentId":1203,"tagType":1204,"tagKey":1211,"name":1212,"language":1207,"sort":1213},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":