[{"data":1,"prerenderedAt":-1},["ShallowReactive",2],{"aniimo-detail-10003509-tw":3,"header-aniimo-list-tw":231,"morphology-tags-tw":1173},{"id":4,"previousId":5,"nextId":6,"previousAnchor":7,"nextAnchor":11,"viewCount":13,"visible":14,"searchKey":15,"directories":26,"morphologyList":229},"10003509","10003410","10003413",{"entryId":8,"currentMorphology":9,"type":10},"090","Basic Form","ANIIMO",{"entryId":12,"currentMorphology":9,"type":10},"092",342,true,{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":22,"attributes":24},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。","3",[23],"position-dps",[25],"attributes-water",[27,119],{"id":28,"title":29,"components":30},1,"基本資訊",[31,58,86,102],{"id":32,"type":33,"props":34,"children":57},"91268540_0","aniimoInfo",{"id":35,"formData":36},"91268540_1",{"name":18,"sortOrder":28,"serialNumber":16,"heightMin":28,"heightMax":28,"weightMin":37,"weightMax":38,"attributes":39,"position":40,"gender":41,"desc":20,"maleImage":19,"femaleImage":19,"noGenderImage":19,"illustrationImage":44,"backgroundImage":45,"attributeValue":46,"hp":47,"magicAttack":48,"physicalAttack":49,"magicDefense":50,"haste":47,"physicalDefense":51,"displayNames":52,"currentMorphology":9,"currentStage":56,"femaleIllustrationImage":45,"maleIllustrationImage":45},23.4,34.93,[25],[23],[42,43],"male","female","/cdn/Vfx/1062300.mp4","",529,106,51,121,77,68,{"maleImage":53,"femaleImage":54,"illustrationImage":55,"backgroundImage":45,"noGenderImage":45},"Stellarys.png","Scorchhowl.png","evolutionarySpirit.png",3,null,{"id":59,"type":60,"props":61,"children":66},"91268540_2","crumbTitle",{"title":62,"type":63,"id":64,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"進化路線","big","91268540_3",false,[67],{"id":68,"type":69,"props":70,"children":57},"91268540_4","evolution",{"data":71,"id":85},{"id":72,"name":73,"label":73,"icon":74,"stage":28,"position":75,"stageStrength":28,"condition":76,"children":78},"root","吐泡章魚","/cdn/init/Wiki_PetHead_10621.png",0,{"isVariant":65,"list":77},[],[79],{"id":80,"name":18,"label":18,"icon":81,"stage":56,"position":28,"stageStrength":56,"condition":82,"children":84},"91268540_6","/cdn/init/Wiki_PetHead_10623.png",{"isVariant":65,"list":83},[],[],"91268540_5",{"id":87,"type":60,"props":88,"children":92},"91268540_7",{"title":89,"type":90,"id":91,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"出現地區","small","91268540_8",[93],{"id":94,"type":95,"props":96,"children":57},"91268540_9","capsule",{"id":97,"customKey":45,"title":98,"icon":45,"bgColor":99,"fontColor":100,"type":101},"91268540_10","新月海灣","#dee2ec","#60606e","normal",{"id":103,"type":60,"props":104,"children":107},"91268540_11",{"title":105,"type":90,"id":106,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"家園能力","91268540_12",[108,114],{"id":109,"type":95,"props":110,"children":57},"91268540_13",{"id":111,"customKey":112,"title":21,"icon":45,"bgColor":45,"fontColor":45,"type":113},"91268540_14","home-1101","spritePic",{"id":115,"type":95,"props":116,"children":57},"91268540_15",{"id":117,"customKey":118,"title":21,"icon":45,"bgColor":45,"fontColor":45,"type":113},"91268540_16","home-1002",{"id":120,"title":121,"components":122},2,"伊莫能力",[123,139,155],{"id":124,"type":60,"props":125,"children":128},"91268540_17",{"title":126,"type":90,"id":127,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"Pathfinding","91268540_18",[129],{"id":130,"type":131,"props":132,"children":57},"91268540_19","circle",{"id":133,"customKey":134,"icon":45,"iconStyle":45,"iconTitle":135,"descTitle":45,"descContent":45,"source":136,"bgColor":99,"fontColor":100,"type":101},"91268540_20","SWIM","游泳 Lv.3",{"attributes":137,"type":138,"consume":45,"power":45},[],[],{"id":140,"type":60,"props":141,"children":144},"91268540_23",{"title":142,"type":63,"id":143,"isUse":14,"isEdit":14,"useTabs":65,"blackHeader":65},"伊莫特性","91268540_24",[145],{"id":146,"type":131,"props":147,"children":57},"91268540_25",{"id":148,"customKey":45,"icon":149,"iconStyle":63,"iconTitle":45,"descTitle":150,"descContent":151,"source":152},"91268540_26","/cdn/init/1062300_Feature_162301_Icon.png","扭蛋機","每次普攻或技能會進行一次扭蛋，隨機吐出橙、紫、藍、金四種顏色的泡泡，並將對應顏色的泡泡放入扭蛋插槽。吐出金色泡泡的機率為1%，其餘顏色的機率為33%。當扭蛋插槽有5個同色泡泡或者出現金色泡泡時，清空扭蛋插槽，並進入「中獎」狀態，持續10秒。「中獎」狀態下必定會射出彩虹泡泡，且普攻傷害提升60%。",{"attributes":153,"type":154,"consume":45,"power":45},[],[],{"id":156,"type":60,"props":157,"children":57},"91268540_27",{"title":158,"type":63,"id":159,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":65,"tabs":160},"技能介紹","91268540_28",[161,202],{"id":162,"title":163,"children":164},"91268540_29","戰鬥技能",[165,178,190],{"id":166,"type":131,"props":167},"91268540_30",{"id":168,"customKey":45,"icon":169,"iconStyle":63,"iconTitle":45,"descTitle":170,"descContent":171,"source":172},"91268540_31","/cdn/init/1062300_Skill_10301190_Icon.png","清倉大拍賣","持續向目標噴吐泡泡，持續5秒。施放過程中可以緩慢移動，造成的傷害視作普攻傷害。",{"attributes":173,"type":174,"consume":176,"power":177},[21],[175],"1","40","124",{"id":179,"type":131,"props":180},"91268540_32",{"id":181,"customKey":45,"icon":182,"iconStyle":63,"iconTitle":45,"descTitle":183,"descContent":184,"source":185},"91268540_33","/cdn/init/1062300_Skill_10301180_Icon.png","黑箱作業","消耗當前顏色最少的泡泡，下次普攻必定會射出當前數量最多的顏色的泡泡，同時普攻傷害提升25%，持續15秒。",{"attributes":186,"type":187,"consume":189,"power":188},[21],[188],"0","10",{"id":191,"type":131,"props":192},"91268540_34",{"id":193,"customKey":45,"icon":194,"iconStyle":63,"iconTitle":45,"descTitle":195,"descContent":196,"source":197},"91268540_35","/cdn/init/1062300_Skill_10301200_Icon.png","強化泡泡","向目標噴吐強化泡泡，根據泡泡的顏色獲得不同的效果：「橙色泡泡」會造成範圍傷害，「藍色泡泡」命中後回復5點能量，「紫色泡泡」額外造成20%傷害，「金色泡泡」和「彩虹泡泡」同時擁有三種顏色泡泡的效果。",{"attributes":198,"type":199,"consume":200,"power":201},[21],[175],"20","43",{"id":203,"title":204,"children":205},"91268540_36","固有技能",[206,217],{"id":207,"type":131,"props":208},"91268540_37",{"id":209,"customKey":45,"icon":210,"iconStyle":63,"iconTitle":45,"descTitle":211,"descContent":212,"source":213},"91268540_38","/cdn/init/1062300_Skill_11600000_Icon.png","攻擊","使用水元素能力，遠距離攻擊目標。",{"attributes":214,"type":215,"consume":188,"power":216},[21],[175],"6",{"id":218,"type":131,"props":219},"91268540_39",{"id":220,"customKey":45,"icon":221,"iconStyle":63,"iconTitle":45,"descTitle":222,"descContent":223,"source":224},"91268540_40","/cdn/init/1062300_Skill_10301340_Icon.png","超級大獎","向目標噴吐巨大的彩虹泡泡，造成大範圍傷害，並立即進入持續10秒的「中獎」狀態。",{"attributes":225,"type":226,"consume":188,"power":228},[21],[227],"2","183",[230],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[232,243,253,263,275,285,295,307,317,327,337,348,358,369,379,390,401,411,421,431,441,451,461,472,482,492,502,512,522,532,542,552,562,572,582,592,602,613,623,633,643,653,663,673,683,693,703,713,723,733,743,753,763,773,783,793,803,813,823,833,843,853,863,873,883,893,903,913,923,933,943,953,963,973,983,993,1003,1013,1023,1033,1043,1053,1063,1073,1083,1093,1103,1113,1123,1130,1134,1142,1152,1163],{"id":233,"viewCount":57,"searchKey":234,"visible":14},"10003442",{"type":10,"entryId":235,"sortOrder":236,"name":237,"imageUrl":238,"description":239,"currentMorphology":9,"currentStage":175,"position":240,"attributes":241},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[242],"attributes-fire",{"id":244,"viewCount":57,"searchKey":245,"visible":14},"10003534",{"type":10,"entryId":246,"sortOrder":247,"name":248,"imageUrl":249,"description":250,"currentMorphology":9,"currentStage":227,"position":251,"attributes":252},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[242],{"id":254,"viewCount":57,"searchKey":255,"visible":14},"10003435",{"type":10,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":9,"currentStage":21,"position":261,"attributes":262},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[23],[242],{"id":264,"viewCount":57,"searchKey":265,"visible":14},"10003428",{"type":10,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":9,"currentStage":21,"position":271,"attributes":273},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[272],"position-break",[242,274],"attributes-dark",{"id":276,"viewCount":57,"searchKey":277,"visible":14},"10003578",{"type":10,"entryId":278,"sortOrder":279,"name":280,"imageUrl":281,"description":282,"currentMorphology":9,"currentStage":175,"position":283,"attributes":284},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[274],{"id":286,"viewCount":57,"searchKey":287,"visible":14},"10003417",{"type":10,"entryId":288,"sortOrder":289,"name":290,"imageUrl":291,"description":292,"currentMorphology":9,"currentStage":21,"position":293,"attributes":294},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[274],{"id":296,"viewCount":57,"searchKey":297,"visible":14},"10003488",{"type":10,"entryId":298,"sortOrder":299,"name":300,"imageUrl":301,"description":302,"currentMorphology":9,"currentStage":175,"position":303,"attributes":305},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[304],"position-sup",[306],"attributes-wind",{"id":308,"viewCount":57,"searchKey":309,"visible":14},"10003548",{"type":10,"entryId":310,"sortOrder":311,"name":312,"imageUrl":313,"description":314,"currentMorphology":9,"currentStage":21,"position":315,"attributes":316},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[304],[306],{"id":318,"viewCount":57,"searchKey":319,"visible":14},"10003474",{"type":10,"entryId":320,"sortOrder":321,"name":322,"imageUrl":323,"description":324,"currentMorphology":9,"currentStage":21,"position":325,"attributes":326},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[306],{"id":328,"viewCount":57,"searchKey":329,"visible":14},"10003467",{"type":10,"entryId":330,"sortOrder":331,"name":332,"imageUrl":333,"description":334,"currentMorphology":9,"currentStage":21,"position":335,"attributes":336},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[272],[306],{"id":338,"viewCount":57,"searchKey":339,"visible":14},"10003392",{"type":10,"entryId":340,"sortOrder":341,"name":342,"imageUrl":343,"description":344,"currentMorphology":9,"currentStage":175,"position":345,"attributes":346},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[23],[347],"attributes-grass",{"id":349,"viewCount":57,"searchKey":350,"visible":14},"10003510",{"type":10,"entryId":351,"sortOrder":352,"name":353,"imageUrl":354,"description":355,"currentMorphology":9,"currentStage":21,"position":356,"attributes":357},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[347],{"id":359,"viewCount":57,"searchKey":360,"visible":14},"10003477",{"type":10,"entryId":361,"sortOrder":362,"name":363,"imageUrl":364,"description":365,"currentMorphology":9,"currentStage":175,"position":366,"attributes":368},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[367],"position-heal",[25],{"id":370,"viewCount":57,"searchKey":371,"visible":14},"10003569",{"type":10,"entryId":372,"sortOrder":373,"name":374,"imageUrl":375,"description":376,"currentMorphology":9,"currentStage":227,"position":377,"attributes":378},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[367],[25],{"id":380,"viewCount":57,"searchKey":381,"visible":14},"10003470",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":9,"currentStage":21,"position":387,"attributes":388},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[367],[25,389],"attributes-ice",{"id":391,"viewCount":57,"searchKey":392,"visible":14},"10003463",{"type":10,"entryId":393,"sortOrder":394,"name":395,"imageUrl":396,"description":397,"currentMorphology":9,"currentStage":21,"position":398,"attributes":400},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[399],"position-energy",[347,25],{"id":402,"viewCount":57,"searchKey":403,"visible":14},"10003468",{"type":10,"entryId":404,"sortOrder":405,"name":406,"imageUrl":407,"description":408,"currentMorphology":9,"currentStage":175,"position":409,"attributes":410},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[304],[306],{"id":412,"viewCount":57,"searchKey":413,"visible":14},"10003365",{"type":10,"entryId":414,"sortOrder":415,"name":416,"imageUrl":417,"description":418,"currentMorphology":9,"currentStage":21,"position":419,"attributes":420},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[304],[306],{"id":422,"viewCount":57,"searchKey":423,"visible":14},"10003461",{"type":10,"entryId":424,"sortOrder":425,"name":426,"imageUrl":427,"description":428,"currentMorphology":9,"currentStage":21,"position":429,"attributes":430},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[304],[274],{"id":432,"viewCount":57,"searchKey":433,"visible":14},"10003421",{"type":10,"entryId":434,"sortOrder":435,"name":436,"imageUrl":437,"description":438,"currentMorphology":9,"currentStage":175,"position":439,"attributes":440},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[272],[347],{"id":442,"viewCount":57,"searchKey":443,"visible":14},"10003414",{"type":10,"entryId":444,"sortOrder":445,"name":446,"imageUrl":447,"description":448,"currentMorphology":9,"currentStage":21,"position":449,"attributes":450},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[399],[274,347],{"id":452,"viewCount":57,"searchKey":453,"visible":14},"10003404",{"type":10,"entryId":454,"sortOrder":455,"name":456,"imageUrl":457,"description":458,"currentMorphology":9,"currentStage":21,"position":459,"attributes":460},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[272],[347],{"id":462,"viewCount":57,"searchKey":463,"visible":14},"10003567",{"type":10,"entryId":464,"sortOrder":465,"name":466,"imageUrl":467,"description":468,"currentMorphology":9,"currentStage":175,"position":469,"attributes":470},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[272],[471,347],"attributes-rock",{"id":473,"viewCount":57,"searchKey":474,"visible":14},"10003462",{"type":10,"entryId":475,"sortOrder":476,"name":477,"imageUrl":478,"description":479,"currentMorphology":9,"currentStage":21,"position":480,"attributes":481},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[272],[471,347],{"id":483,"viewCount":57,"searchKey":484,"visible":14},"10003551",{"type":10,"entryId":485,"sortOrder":486,"name":487,"imageUrl":488,"description":489,"currentMorphology":9,"currentStage":21,"position":490,"attributes":491},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[272],[389],{"id":493,"viewCount":57,"searchKey":494,"visible":14},"10003409",{"type":10,"entryId":495,"sortOrder":496,"name":497,"imageUrl":498,"description":499,"currentMorphology":9,"currentStage":175,"position":500,"attributes":501},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[399],[242],{"id":503,"viewCount":57,"searchKey":504,"visible":14},"10003507",{"type":10,"entryId":505,"sortOrder":506,"name":507,"imageUrl":508,"description":509,"currentMorphology":9,"currentStage":21,"position":510,"attributes":511},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[399],[242],{"id":513,"viewCount":57,"searchKey":514,"visible":14},"10003542",{"type":10,"entryId":515,"sortOrder":516,"name":517,"imageUrl":518,"description":519,"currentMorphology":9,"currentStage":175,"position":520,"attributes":521},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[367],[306],{"id":523,"viewCount":57,"searchKey":524,"visible":14},"10003440",{"type":10,"entryId":525,"sortOrder":526,"name":527,"imageUrl":528,"description":529,"currentMorphology":9,"currentStage":21,"position":530,"attributes":531},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[367],[306],{"id":533,"viewCount":57,"searchKey":534,"visible":14},"10003563",{"type":10,"entryId":535,"sortOrder":536,"name":537,"imageUrl":538,"description":539,"currentMorphology":9,"currentStage":188,"position":540,"attributes":541},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[399],[306,347],{"id":543,"viewCount":57,"searchKey":544,"visible":14},"10003368",{"type":10,"entryId":545,"sortOrder":546,"name":547,"imageUrl":548,"description":549,"currentMorphology":9,"currentStage":175,"position":550,"attributes":551},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[304],[306],{"id":553,"viewCount":57,"searchKey":554,"visible":14},"10003363",{"type":10,"entryId":555,"sortOrder":556,"name":557,"imageUrl":558,"description":559,"currentMorphology":9,"currentStage":21,"position":560,"attributes":561},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[304],[306],{"id":563,"viewCount":57,"searchKey":564,"visible":14},"10003515",{"type":10,"entryId":565,"sortOrder":566,"name":567,"imageUrl":568,"description":569,"currentMorphology":9,"currentStage":175,"position":570,"attributes":571},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[347],{"id":573,"viewCount":57,"searchKey":574,"visible":14},"10003496",{"type":10,"entryId":575,"sortOrder":576,"name":577,"imageUrl":578,"description":579,"currentMorphology":9,"currentStage":21,"position":580,"attributes":581},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[347],{"id":583,"viewCount":57,"searchKey":584,"visible":14},"10003378",{"type":10,"entryId":585,"sortOrder":586,"name":587,"imageUrl":588,"description":589,"currentMorphology":9,"currentStage":21,"position":590,"attributes":591},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[304],[347],{"id":593,"viewCount":57,"searchKey":594,"visible":14},"10003456",{"type":10,"entryId":595,"sortOrder":596,"name":597,"imageUrl":598,"description":599,"currentMorphology":9,"currentStage":175,"position":600,"attributes":601},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[272],[347],{"id":603,"viewCount":57,"searchKey":604,"visible":14},"10003374",{"type":10,"entryId":605,"sortOrder":606,"name":607,"imageUrl":608,"description":609,"currentMorphology":9,"currentStage":21,"position":610,"attributes":611},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[304],[612],"attributes-electric",{"id":614,"viewCount":57,"searchKey":615,"visible":14},"10003443",{"type":10,"entryId":616,"sortOrder":617,"name":618,"imageUrl":619,"description":620,"currentMorphology":9,"currentStage":21,"position":621,"attributes":622},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[272],[347],{"id":624,"viewCount":57,"searchKey":625,"visible":14},"10003503",{"type":10,"entryId":626,"sortOrder":627,"name":628,"imageUrl":629,"description":630,"currentMorphology":9,"currentStage":175,"position":631,"attributes":632},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[304],[274],{"id":634,"viewCount":57,"searchKey":635,"visible":14},"10003521",{"type":10,"entryId":636,"sortOrder":637,"name":638,"imageUrl":639,"description":640,"currentMorphology":9,"currentStage":21,"position":641,"attributes":642},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[304],[274],{"id":644,"viewCount":57,"searchKey":645,"visible":14},"10003508",{"type":10,"entryId":646,"sortOrder":647,"name":648,"imageUrl":649,"description":650,"currentMorphology":9,"currentStage":175,"position":651,"attributes":652},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[274],{"id":654,"viewCount":57,"searchKey":655,"visible":14},"10003369",{"type":10,"entryId":656,"sortOrder":657,"name":658,"imageUrl":659,"description":660,"currentMorphology":9,"currentStage":21,"position":661,"attributes":662},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[274],{"id":664,"viewCount":57,"searchKey":665,"visible":14},"10003501",{"type":10,"entryId":666,"sortOrder":667,"name":668,"imageUrl":669,"description":670,"currentMorphology":9,"currentStage":21,"position":671,"attributes":672},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[612],{"id":674,"viewCount":57,"searchKey":675,"visible":14},"10003422",{"type":10,"entryId":676,"sortOrder":677,"name":678,"imageUrl":679,"description":680,"currentMorphology":9,"currentStage":175,"position":681,"attributes":682},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[389],{"id":684,"viewCount":57,"searchKey":685,"visible":14},"10003575",{"type":10,"entryId":686,"sortOrder":687,"name":688,"imageUrl":689,"description":690,"currentMorphology":9,"currentStage":227,"position":691,"attributes":692},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[389],{"id":694,"viewCount":57,"searchKey":695,"visible":14},"10003415",{"type":10,"entryId":696,"sortOrder":697,"name":698,"imageUrl":699,"description":700,"currentMorphology":9,"currentStage":21,"position":701,"attributes":702},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[389],{"id":704,"viewCount":57,"searchKey":705,"visible":14},"10003524",{"type":10,"entryId":706,"sortOrder":707,"name":708,"imageUrl":709,"description":710,"currentMorphology":9,"currentStage":175,"position":711,"attributes":712},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[272],[612],{"id":714,"viewCount":57,"searchKey":715,"visible":14},"10003475",{"type":10,"entryId":716,"sortOrder":717,"name":718,"imageUrl":719,"description":720,"currentMorphology":9,"currentStage":21,"position":721,"attributes":722},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[272],[612],{"id":724,"viewCount":57,"searchKey":725,"visible":14},"10003523",{"type":10,"entryId":726,"sortOrder":727,"name":728,"imageUrl":729,"description":730,"currentMorphology":9,"currentStage":175,"position":731,"attributes":732},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[272],[25],{"id":734,"viewCount":57,"searchKey":735,"visible":14},"10003398",{"type":10,"entryId":736,"sortOrder":737,"name":738,"imageUrl":739,"description":740,"currentMorphology":9,"currentStage":227,"position":741,"attributes":742},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[272],[25],{"id":744,"viewCount":57,"searchKey":745,"visible":14},"10003516",{"type":10,"entryId":746,"sortOrder":747,"name":748,"imageUrl":749,"description":750,"currentMorphology":9,"currentStage":21,"position":751,"attributes":752},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[304],[25],{"id":754,"viewCount":57,"searchKey":755,"visible":14},"10003566",{"type":10,"entryId":756,"sortOrder":757,"name":758,"imageUrl":759,"description":760,"currentMorphology":9,"currentStage":21,"position":761,"attributes":762},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[272],[25],{"id":764,"viewCount":57,"searchKey":765,"visible":14},"10003453",{"type":10,"entryId":766,"sortOrder":767,"name":768,"imageUrl":769,"description":770,"currentMorphology":9,"currentStage":175,"position":771,"attributes":772},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[25],{"id":774,"viewCount":57,"searchKey":775,"visible":14},"10003577",{"type":10,"entryId":776,"sortOrder":777,"name":778,"imageUrl":779,"description":780,"currentMorphology":9,"currentStage":227,"position":781,"attributes":782},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[25],{"id":784,"viewCount":57,"searchKey":785,"visible":14},"10003570",{"type":10,"entryId":786,"sortOrder":787,"name":788,"imageUrl":789,"description":790,"currentMorphology":9,"currentStage":21,"position":791,"attributes":792},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[25],{"id":794,"viewCount":57,"searchKey":795,"visible":14},"10003565",{"type":10,"entryId":796,"sortOrder":797,"name":798,"imageUrl":799,"description":800,"currentMorphology":9,"currentStage":175,"position":801,"attributes":802},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[471],{"id":804,"viewCount":57,"searchKey":805,"visible":14},"10003476",{"type":10,"entryId":806,"sortOrder":807,"name":808,"imageUrl":809,"description":810,"currentMorphology":9,"currentStage":21,"position":811,"attributes":812},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[471],{"id":814,"viewCount":57,"searchKey":815,"visible":14},"10003466",{"type":10,"entryId":816,"sortOrder":817,"name":818,"imageUrl":819,"description":820,"currentMorphology":9,"currentStage":21,"position":821,"attributes":822},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[304],[471],{"id":824,"viewCount":57,"searchKey":825,"visible":14},"10003379",{"type":10,"entryId":826,"sortOrder":827,"name":828,"imageUrl":829,"description":830,"currentMorphology":9,"currentStage":175,"position":831,"attributes":832},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[612],{"id":834,"viewCount":57,"searchKey":835,"visible":14},"10003376",{"type":10,"entryId":836,"sortOrder":837,"name":838,"imageUrl":839,"description":840,"currentMorphology":9,"currentStage":21,"position":841,"attributes":842},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[612],{"id":844,"viewCount":57,"searchKey":845,"visible":14},"10003543",{"type":10,"entryId":846,"sortOrder":847,"name":848,"imageUrl":849,"description":850,"currentMorphology":9,"currentStage":175,"position":851,"attributes":852},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[272],[274],{"id":854,"viewCount":57,"searchKey":855,"visible":14},"10003557",{"type":10,"entryId":856,"sortOrder":857,"name":858,"imageUrl":859,"description":860,"currentMorphology":9,"currentStage":21,"position":861,"attributes":862},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[274],{"id":864,"viewCount":57,"searchKey":865,"visible":14},"10003522",{"type":10,"entryId":866,"sortOrder":867,"name":868,"imageUrl":869,"description":870,"currentMorphology":9,"currentStage":21,"position":871,"attributes":872},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[272],[274],{"id":874,"viewCount":57,"searchKey":875,"visible":14},"10003579",{"type":10,"entryId":876,"sortOrder":877,"name":878,"imageUrl":879,"description":880,"currentMorphology":9,"currentStage":175,"position":881,"attributes":882},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[272],[306],{"id":884,"viewCount":57,"searchKey":885,"visible":14},"10003389",{"type":10,"entryId":886,"sortOrder":887,"name":888,"imageUrl":889,"description":890,"currentMorphology":9,"currentStage":227,"position":891,"attributes":892},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[272],[306],{"id":894,"viewCount":57,"searchKey":895,"visible":14},"10003536",{"type":10,"entryId":896,"sortOrder":897,"name":898,"imageUrl":899,"description":900,"currentMorphology":9,"currentStage":21,"position":901,"attributes":902},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[272],[306],{"id":904,"viewCount":57,"searchKey":905,"visible":14},"10003529",{"type":10,"entryId":906,"sortOrder":907,"name":908,"imageUrl":909,"description":910,"currentMorphology":9,"currentStage":21,"position":911,"attributes":912},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[242],{"id":914,"viewCount":57,"searchKey":915,"visible":14},"10003433",{"type":10,"entryId":916,"sortOrder":917,"name":918,"imageUrl":919,"description":920,"currentMorphology":9,"currentStage":175,"position":921,"attributes":922},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[471],{"id":924,"viewCount":57,"searchKey":925,"visible":14},"10003427",{"type":10,"entryId":926,"sortOrder":927,"name":928,"imageUrl":929,"description":930,"currentMorphology":9,"currentStage":21,"position":931,"attributes":932},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[471],{"id":934,"viewCount":57,"searchKey":935,"visible":14},"10003405",{"type":10,"entryId":936,"sortOrder":937,"name":938,"imageUrl":939,"description":940,"currentMorphology":9,"currentStage":175,"position":941,"attributes":942},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[272],[471],{"id":944,"viewCount":57,"searchKey":945,"visible":14},"10003525",{"type":10,"entryId":946,"sortOrder":947,"name":948,"imageUrl":949,"description":950,"currentMorphology":9,"currentStage":227,"position":951,"attributes":952},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[272],[242,471],{"id":954,"viewCount":57,"searchKey":955,"visible":14},"10003399",{"type":10,"entryId":956,"sortOrder":957,"name":958,"imageUrl":959,"description":960,"currentMorphology":9,"currentStage":21,"position":961,"attributes":962},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[272],[242,471],{"id":964,"viewCount":57,"searchKey":965,"visible":14},"10003518",{"type":10,"entryId":966,"sortOrder":967,"name":968,"imageUrl":969,"description":970,"currentMorphology":9,"currentStage":227,"position":971,"attributes":972},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[272],[471],{"id":974,"viewCount":57,"searchKey":975,"visible":14},"10003393",{"type":10,"entryId":976,"sortOrder":977,"name":978,"imageUrl":979,"description":980,"currentMorphology":9,"currentStage":21,"position":981,"attributes":982},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[272],[471],{"id":984,"viewCount":57,"searchKey":985,"visible":14},"10003386",{"type":10,"entryId":986,"sortOrder":987,"name":988,"imageUrl":989,"description":990,"currentMorphology":9,"currentStage":175,"position":991,"attributes":992},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[304],[471],{"id":994,"viewCount":57,"searchKey":995,"visible":14},"10003447",{"type":10,"entryId":996,"sortOrder":997,"name":998,"imageUrl":999,"description":1000,"currentMorphology":9,"currentStage":21,"position":1001,"attributes":1002},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[304],[471],{"id":1004,"viewCount":57,"searchKey":1005,"visible":14},"10003497",{"type":10,"entryId":1006,"sortOrder":1007,"name":1008,"imageUrl":1009,"description":1010,"currentMorphology":9,"currentStage":175,"position":1011,"attributes":1012},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[304],[612],{"id":1014,"viewCount":57,"searchKey":1015,"visible":14},"10003479",{"type":10,"entryId":1016,"sortOrder":1017,"name":1018,"imageUrl":1019,"description":1020,"currentMorphology":9,"currentStage":227,"position":1021,"attributes":1022},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[304],[612],{"id":1024,"viewCount":57,"searchKey":1025,"visible":14},"10003388",{"type":10,"entryId":1026,"sortOrder":1027,"name":1028,"imageUrl":1029,"description":1030,"currentMorphology":9,"currentStage":21,"position":1031,"attributes":1032},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[304],[612],{"id":1034,"viewCount":57,"searchKey":1035,"visible":14},"10003429",{"type":10,"entryId":1036,"sortOrder":1037,"name":1038,"imageUrl":1039,"description":1040,"currentMorphology":9,"currentStage":175,"position":1041,"attributes":1042},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[399],[25],{"id":1044,"viewCount":57,"searchKey":1045,"visible":14},"10003430",{"type":10,"entryId":1046,"sortOrder":1047,"name":1048,"imageUrl":1049,"description":1050,"currentMorphology":9,"currentStage":21,"position":1051,"attributes":1052},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[399],[25],{"id":1054,"viewCount":57,"searchKey":1055,"visible":14},"10003549",{"type":10,"entryId":1056,"sortOrder":1057,"name":1058,"imageUrl":1059,"description":1060,"currentMorphology":9,"currentStage":188,"position":1061,"attributes":1062},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[399],[612],{"id":1064,"viewCount":57,"searchKey":1065,"visible":14},"10003494",{"type":10,"entryId":1066,"sortOrder":1067,"name":1068,"imageUrl":1069,"description":1070,"currentMorphology":9,"currentStage":175,"position":1071,"attributes":1072},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[399],[471,25],{"id":1074,"viewCount":57,"searchKey":1075,"visible":14},"10003486",{"type":10,"entryId":1076,"sortOrder":1077,"name":1078,"imageUrl":1079,"description":1080,"currentMorphology":9,"currentStage":21,"position":1081,"attributes":1082},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[399],[471,25],{"id":1084,"viewCount":57,"searchKey":1085,"visible":14},"10003530",{"type":10,"entryId":1086,"sortOrder":1087,"name":1088,"imageUrl":1089,"description":1090,"currentMorphology":9,"currentStage":175,"position":1091,"attributes":1092},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[272],[389],{"id":1094,"viewCount":57,"searchKey":1095,"visible":14},"10003457",{"type":10,"entryId":1096,"sortOrder":1097,"name":1098,"imageUrl":1099,"description":1100,"currentMorphology":9,"currentStage":21,"position":1101,"attributes":1102},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[272],[389],{"id":1104,"viewCount":57,"searchKey":1105,"visible":14},"10003423",{"type":10,"entryId":1106,"sortOrder":1107,"name":1108,"imageUrl":1109,"description":1110,"currentMorphology":9,"currentStage":175,"position":1111,"attributes":1112},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[367],[347,25],{"id":1114,"viewCount":57,"searchKey":1115,"visible":14},"10003419",{"type":10,"entryId":1116,"sortOrder":1117,"name":1118,"imageUrl":1119,"description":1120,"currentMorphology":9,"currentStage":21,"position":1121,"attributes":1122},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[367],[347,25],{"id":5,"viewCount":57,"searchKey":1124,"visible":14},{"type":10,"entryId":8,"sortOrder":1125,"name":73,"imageUrl":1126,"description":1127,"currentMorphology":9,"currentStage":175,"position":1128,"attributes":1129},1062100,"/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[25],{"id":4,"viewCount":57,"searchKey":1131,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1132,"attributes":1133},[23],[25],{"id":6,"viewCount":57,"searchKey":1135,"visible":14},{"type":10,"entryId":12,"sortOrder":1136,"name":1137,"imageUrl":1138,"description":1139,"currentMorphology":9,"currentStage":175,"position":1140,"attributes":1141},1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[389],{"id":1143,"viewCount":57,"searchKey":1144,"visible":14},"10003407",{"type":10,"entryId":1145,"sortOrder":1146,"name":1147,"imageUrl":1148,"description":1149,"currentMorphology":9,"currentStage":21,"position":1150,"attributes":1151},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[389],{"id":1153,"viewCount":57,"searchKey":1154,"visible":14},"10003498",{"type":10,"entryId":1155,"sortOrder":1156,"name":1157,"imageUrl":1158,"description":1159,"currentMorphology":9,"currentStage":188,"position":1160,"attributes":1161},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1162],"attributes-holy",{"id":1164,"viewCount":57,"searchKey":1165,"visible":14},"10003375",{"type":10,"entryId":1166,"sortOrder":1167,"name":1168,"imageUrl":1169,"description":1170,"currentMorphology":9,"currentStage":188,"position":1171,"attributes":1172},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1162],[1174,1182,1187,1192,1197,1202,1207,1212,1216,1220,1225,1230,1235,1240,1245,1250,1255,1260,1263],{"id":1175,"parentId":1176,"tagType":1177,"tagKey":1178,"name":1179,"language":1180,"sort":1181},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1183,"parentId":1176,"tagType":1177,"tagKey":1184,"name":1185,"language":1180,"sort":1186},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1188,"parentId":1176,"tagType":1177,"tagKey":1189,"name":1190,"language":1180,"sort":1191},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1193,"parentId":1176,"tagType":1177,"tagKey":1194,"name":1195,"language":1180,"sort":1196},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1198,"parentId":1176,"tagType":1177,"tagKey":1199,"name":1200,"language":1180,"sort":1201},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1203,"parentId":1176,"tagType":1177,"tagKey":1204,"name":1205,"language":1180,"sort":1206},"5264fcf4157b04e2ba108f70d7b10d07","Plateau Form","高原型態",17,{"id":1208,"parentId":1176,"tagType":1177,"tagKey":1209,"name":1210,"language":1180,"sort":1211},"568127bc77f184cd43080