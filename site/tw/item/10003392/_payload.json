莫特性","91268422_24",[146],{"id":147,"type":131,"props":148,"children":57},"91268422_25",{"id":149,"customKey":46,"icon":150,"iconStyle":63,"iconTitle":46,"descTitle":151,"descContent":152,"source":153},"91268422_26","/cdn/init/1021100_Feature_121102_Icon.png","舞力四射","在草地上時傷害提升20%。戰鬥中技能每造成一次傷害獲得1點「舞力值」，累積24點後，下次施放技能時不消耗能量。",{"attributes":154,"type":155,"consume":46,"power":46},[],[],{"id":157,"type":60,"props":158,"children":57},"91268422_27",{"title":159,"type":63,"id":160,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":65,"tabs":161},"技能介紹","91268422_28",[162,192],{"id":163,"title":164,"children":165},"91268422_29","戰鬥技能",[166,180],{"id":167,"type":131,"props":168},"91268422_30",{"id":169,"customKey":46,"icon":170,"iconStyle":63,"iconTitle":46,"descTitle":171,"descContent":172,"source":173},"91268422_31","/cdn/init/1021100_Skill_10600913_Icon.png","花葉風暴","邊旋轉移動邊施放追蹤目標的魔法花葉。施放的魔法花葉隨著時間逐漸增加1朵，最多施放3朵。再次按下技能可中斷施放。",{"attributes":174,"type":176,"consume":178,"power":179},[175],"6",[177],"2","13","26",{"id":181,"type":131,"props":182},"91268422_32",{"id":183,"customKey":46,"icon":184,"iconStyle":63,"iconTitle":46,"descTitle":185,"descContent":186,"source":187},"91268422_33","/cdn/init/1021100_Skill_10600150_Icon.png","花瓣漩渦","在目標的腳下產生大範圍的花瓣漩渦並攻擊目標。",{"attributes":188,"type":189,"consume":190,"power":191},[175],[177],"15","46",{"id":193,"title":194,"children":195},"91268422_34","固有技能",[196],{"id":197,"type":131,"props":198},"91268422_35",{"id":199,"customKey":46,"icon":200,"iconStyle":63,"iconTitle":46,"descTitle":201,"descContent":202,"source":203},"91268422_36","/cdn/init/1021100_Skill_14200000_Icon.png","攻擊","使用草元素能力，遠距離攻擊目標。",{"attributes":204,"type":205,"consume":206,"power":175},[175],[177],"0",[208,209,210,213,216,219,222],{"id":4,"entryId":12,"currentMorphology":20,"visible":14},{"id":6,"entryId":12,"currentMorphology":9,"visible":14},{"id":211,"entryId":12,"currentMorphology":212,"visible":14},"10003377","Forest Form",{"id":214,"entryId":12,"currentMorphology":215,"visible":14},"10003380","Grassland Form",{"id":217,"entryId":12,"currentMorphology":218,"visible":14},"10003382","Prismana Form",{"id":220,"entryId":12,"currentMorphology":221,"visible":14},"10003384","Plateau Form",{"id":223,"entryId":12,"currentMorphology":224,"visible":14},"10003370","Mountain Woods Form",[226,237,247,258,270,280,290,302,312,322,331,335,344,356,366,377,388,398,408,418,428,438,448,459,469,479,489,499,509,519,529,539,549,559,569,579,589,600,610,620,630,640,650,660,670,680,690,700,710,720,730,740,750,760,770,780,790,800,810,820,830,840,850,860,870,880,890,900,910,920,930,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1090,1100,1110,1120,1130,1140,1150,1161],{"id":227,"viewCount":57,"searchKey":228,"visible":14},"10003442",{"type":10,"entryId":229,"sortOrder":230,"name":231,"imageUrl":232,"description":233,"currentMorphology":20,"currentStage":21,"position":234,"attributes":235},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[23],[236],"attributes-fire",{"id":238,"viewCount":57,"searchKey":239,"visible":14},"10003534",{"type":10,"entryId":240,"sortOrder":241,"name":242,"imageUrl":243,"description":244,"currentMorphology":20,"currentStage":177,"position":245,"attributes":246},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[23],[236],{"id":248,"viewCount":57,"searchKey":249,"visible":14},"10003435",{"type":10,"entryId":250,"sortOrder":251,"name":252,"imageUrl":253,"description":254,"currentMorphology":20,"currentStage":255,"position":256,"attributes":257},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。","3",[23],[236],{"id":259,"viewCount":57,"searchKey":260,"visible":14},"10003428",{"type":10,"entryId":261,"sortOrder":262,"name":263,"imageUrl":264,"description":265,"currentMorphology":20,"currentStage":255,"position":266,"attributes":268},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[267],"position-break",[236,269],"attributes-dark",{"id":271,"viewCount":57,"searchKey":272,"visible":14},"10003578",{"type":10,"entryId":273,"sortOrder":274,"name":275,"imageUrl":276,"description":277,"currentMorphology":20,"currentStage":21,"position":278,"attributes":279},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[23],[269],{"id":281,"viewCount":57,"searchKey":282,"visible":14},"10003417",{"type":10,"entryId":283,"sortOrder":284,"name":285,"imageUrl":286,"description":287,"currentMorphology":20,"currentStage":255,"position":288,"attributes":289},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[23],[269],{"id":291,"viewCount":57,"searchKey":292,"visible":14},"10003488",{"type":10,"entryId":293,"sortOrder":294,"name":295,"imageUrl":296,"description":297,"currentMorphology":20,"currentStage":21,"position":298,"attributes":300},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[299],"position-sup",[301],"attributes-wind",{"id":303,"viewCount":57,"searchKey":304,"visible":14},"10003548",{"type":10,"entryId":305,"sortOrder":306,"name":307,"imageUrl":308,"description":309,"currentMorphology":20,"currentStage":255,"position":310,"attributes":311},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[299],[301],{"id":313,"viewCount":57,"searchKey":314,"visible":14},"10003474",{"type":10,"entryId":315,"sortOrder":316,"name":317,"imageUrl":318,"description":319,"currentMorphology":20,"currentStage":255,"position":320,"attributes":321},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[23],[301],{"id":323,"viewCount":57,"searchKey":324,"visible":14},"10003467",{"type":10,"entryId":8,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":20,"currentStage":255,"position":329,"attributes":330},1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[267],[301],{"id":4,"viewCount":57,"searchKey":332,"visible":14},{"type":10,"entryId":12,"sortOrder":16,"name":17,"imageUrl":18,"description":19,"currentMorphology":20,"currentStage":21,"position":333,"attributes":334},[23],[25],{"id":336,"viewCount":57,"searchKey":337,"visible":14},"10003510",{"type":10,"entryId":338,"sortOrder":339,"name":79,"imageUrl":340,"description":341,"currentMorphology":20,"currentStage":255,"position":342,"attributes":343},"012",1021200,"/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[23],[25],{"id":345,"viewCount":57,"searchKey":346,"visible":14},"10003477",{"type":10,"entryId":347,"sortOrder":348,"name":349,"imageUrl":350,"description":351,"currentMorphology":20,"currentStage":21,"position":352,"attributes":354},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[353],"position-heal",[355],"attributes-water",{"id":357,"viewCount":57,"searchKey":358,"visible":14},"10003569",{"type":10,"entryId":359,"sortOrder":360,"name":361,"imageUrl":362,"description":363,"currentMorphology":20,"currentStage":177,"position":364,"attributes":365},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[353],[355],{"id":367,"viewCount":57,"searchKey":368,"visible":14},"10003470",{"type":10,"entryId":369,"sortOrder":370,"name":371,"imageUrl":372,"description":373,"currentMorphology":20,"currentStage":255,"position":374,"attributes":375},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[353],[355,376],"attributes-ice",{"id":378,"viewCount":57,"searchKey":379,"visible":14},"10003463",{"type":10,"entryId":380,"sortOrder":381,"name":382,"imageUrl":383,"description":384,"currentMorphology":20,"currentStage":255,"position":385,"attributes":387},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[386],"position-energy",[25,355],{"id":389,"viewCount":57,"searchKey":390,"visible":14},"10003468",{"type":10,"entryId":391,"sortOrder":392,"name":393,"imageUrl":394,"description":395,"currentMorphology":20,"currentStage":21,"position":396,"attributes":397},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[299],[301],{"id":399,"viewCount":57,"searchKey":400,"visible":14},"10003365",{"type":10,"entryId":401,"sortOrder":402,"name":403,"imageUrl":404,"description":405,"currentMorphology":20,"currentStage":255,"position":406,"attributes":407},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[299],[301],{"id":409,"viewCount":57,"searchKey":410,"visible":14},"10003461",{"type":10,"entryId":411,"sortOrder":412,"name":413,"imageUrl":414,"description":415,"currentMorphology":20,"currentStage":255,"position":416,"attributes":417},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[299],[269],{"id":419,"viewCount":57,"searchKey":420,"visible":14},"10003421",{"type":10,"entryId":421,"sortOrder":422,"name":423,"imageUrl":424,"description":425,"currentMorphology":20,"currentStage":21,"position":426,"attributes":427},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[267],[25],{"id":429,"viewCount":57,"searchKey":430,"visible":14},"10003414",{"type":10,"entryId":431,"sortOrder":432,"name":433,"imageUrl":434,"description":435,"currentMorphology":20,"currentStage":255,"position":436,"attributes":437},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[386],[269,25],{"id":439,"viewCount":57,"searchKey":440,"visible":14},"10003404",{"type":10,"entryId":441,"sortOrder":442,"name":443,"imageUrl":444,"description":445,"currentMorphology":20,"currentStage":255,"position":446,"attributes":447},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[267],[25],{"id":449,"viewCount":57,"searchKey":450,"visible":14},"10003567",{"type":10,"entryId":451,"sortOrder":452,"name":453,"imageUrl":454,"description":455,"currentMorphology":20,"currentStage":21,"position":456,"attributes":457},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[267],[458,25],"attributes-rock",{"id":460,"viewCount":57,"searchKey":461,"visible":14},"10003462",{"type":10,"entryId":462,"sortOrder":463,"name":464,"imageUrl":465,"description":466,"currentMorphology":20,"currentStage":255,"position":467,"attributes":468},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[267],[458,25],{"id":470,"viewCount":57,"searchKey":471,"visible":14},"10003551",{"type":10,"entryId":472,"sortOrder":473,"name":474,"imageUrl":475,"description":476,"currentMorphology":20,"currentStage":255,"position":477,"attributes":478},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[267],[376],{"id":480,"viewCount":57,"searchKey":481,"visible":14},"10003409",{"type":10,"entryId":482,"sortOrder":483,"name":484,"imageUrl":485,"description":486,"currentMorphology":20,"currentStage":21,"position":487,"attributes":488},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[386],[236],{"id":490,"viewCount":57,"searchKey":491,"visible":14},"10003507",{"type":10,"entryId":492,"sortOrder":493,"name":494,"imageUrl":495,"description":496,"currentMorphology":20,"currentStage":255,"position":497,"attributes":498},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[386],[236],{"id":500,"viewCount":57,"searchKey":501,"visible":14},"10003542",{"type":10,"entryId":502,"sortOrder":503,"name":504,"imageUrl":505,"description":506,"currentMorphology":20,"currentStage":21,"position":507,"attributes":508},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[353],[301],{"id":510,"viewCount":57,"searchKey":511,"visible":14},"10003440",{"type":10,"entryId":512,"sortOrder":513,"name":514,"imageUrl":515,"description":516,"currentMorphology":20,"currentStage":255,"position":517,"attributes":518},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[353],[301],{"id":520,"viewCount":57,"searchKey":521,"visible":14},"10003563",{"type":10,"entryId":522,"sortOrder":523,"name":524,"imageUrl":525,"description":526,"currentMorphology":20,"currentStage":206,"position":527,"attributes":528},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[386],[301,25],{"id":530,"viewCount":57,"searchKey":531,"visible":14},"10003368",{"type":10,"entryId":532,"sortOrder":533,"name":534,"imageUrl":535,"description":536,"currentMorphology":20,"currentStage":21,"position":537,"attributes":538},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[299],[301],{"id":540,"viewCount":57,"searchKey":541,"visible":14},"10003363",{"type":10,"entryId":542,"sortOrder":543,"name":544,"imageUrl":545,"description":546,"currentMorphology":20,"currentStage":255,"position":547,"attributes":548},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[299],[301],{"id":550,"viewCount":57,"searchKey":551,"visible":14},"10003515",{"type":10,"entryId":552,"sortOrder":553,"name":554,"imageUrl":555,"description":556,"currentMorphology":20,"currentStage":21,"position":557,"attributes":558},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[23],[25],{"id":560,"viewCount":57,"searchKey":561,"visible":14},"10003496",{"type":10,"entryId":562,"sortOrder":563,"name":564,"imageUrl":565,"description":566,"currentMorphology":20,"currentStage":255,"position":567,"attributes":568},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[23],[25],{"id":570,"viewCount":57,"searchKey":571,"visible":14},"10003378",{"type":10,"entryId":572,"sortOrder":573,"name":574,"imageUrl":575,"description":576,"currentMorphology":20,"currentStage":255,"position":577,"attributes":578},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[299],[25],{"id":580,"viewCount":57,"searchKey":581,"visible":14},"10003456",{"type":10,"entryId":582,"sortOrder":583,"name":584,"imageUrl":585,"description":586,"currentMorphology":20,"currentStage":21,"position":587,"attributes":588},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[267],[25],{"id":590,"viewCount":57,"searchKey":591,"visible":14},"10003374",{"type":10,"entryId":592,"sortOrder":593,"name":594,"imageUrl":595,"description":596,"currentMorphology":20,"currentStage":255,"position":597,"attributes":598},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[299],[599],"attributes-electric",{"id":601,"viewCount":57,"searchKey":602,"visible":14},"10003443",{"type":10,"entryId":603,"sortOrder":604,"name":605,"imageUrl":606,"description":607,"currentMorphology":20,"currentStage":255,"position":608,"attributes":609},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[267],[25],{"id":611,"viewCount":57,"searchKey":612,"visible":14},"10003503",{"type":10,"entryId":613,"sortOrder":614,"name":615,"imageUrl":616,"description":617,"currentMorphology":20,"currentStage":21,"position":618,"attributes":619},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[299],[269],{"id":621,"viewCount":57,"searchKey":622,"visible":14},"10003521",{"type":10,"entryId":623,"sortOrder":624,"name":625,"imageUrl":626,"description":627,"currentMorphology":20,"currentStage":255,"position":628,"attributes":629},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[299],[269],{"id":631,"viewCount":57,"searchKey":632,"visible":14},"10003508",{"type":10,"entryId":633,"sortOrder":634,"name":635,"imageUrl":636,"description":637,"currentMorphology":20,"currentStage":21,"position":638,"attributes":639},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[23],[269],{"id":641,"viewCount":57,"searchKey":642,"visible":14},"10003369",{"type":10,"entryId":643,"sortOrder":644,"name":645,"imageUrl":646,"description":647,"currentMorphology":20,"currentStage":255,"position":648,"attributes":649},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[23],[269],{"id":651,"viewCount":57,"searchKey":652,"visible":14},"10003501",{"type":10,"entryId":653,"sortOrder":654,"name":655,"imageUrl":656,"description":657,"currentMorphology":20,"currentStage":255,"position":658,"attributes":659},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[23],[599],{"id":661,"viewCount":57,"searchKey":662,"visible":14},"10003422",{"type":10,"entryId":663,"sortOrder":664,"name":665,"imageUrl":666,"description":667,"currentMorphology":20,"currentStage":21,"position":668,"attributes":669},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[23],[376],{"id":671,"viewCount":57,"searchKey":672,"visible":14},"10003575",{"type":10,"entryId":673,"sortOrder":674,"name":675,"imageUrl":676,"description":677,"currentMorphology":20,"currentStage":177,"position":678,"attributes":679},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[23],[376],{"id":681,"viewCount":57,"searchKey":682,"visible":14},"10003415",{"type":10,"entryId":683,"sortOrder":684,"name":685,"imageUrl":686,"description":687,"currentMorphology":20,"currentStage":255,"position":688,"attributes":689},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[23],[376],{"id":691,"viewCount":57,"searchKey":692,"visible":14},"10003524",{"type":10,"entryId":693,"sortOrder":694,"name":695,"imageUrl":696,"description":697,"currentMorphology":20,"currentStage":21,"position":698,"attributes":699},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[267],[599],{"id":701,"viewCount":57,"searchKey":702,"visible":14},"10003475",{"type":10,"entryId":703,"sortOrder":704,"name":705,"imageUrl":706,"description":707,"currentMorphology":20,"currentStage":255,"position":708,"attributes":709},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[267],[599],{"id":711,"viewCount":57,"searchKey":712,"visible":14},"10003523",{"type":10,"entryId":713,"sortOrder":714,"name":715,"imageUrl":716,"description":717,"currentMorphology":20,"currentStage":21,"position":718,"attributes":719},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[267],[355],{"id":721,"viewCount":57,"searchKey":722,"visible":14},"10003398",{"type":10,"entryId":723,"sortOrder":724,"name":725,"imageUrl":726,"description":727,"currentMorphology":20,"currentStage":177,"position":728,"attributes":729},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[267],[355],{"id":731,"viewCount":57,"searchKey":732,"visible":14},"10003516",{"type":10,"entryId":733,"sortOrder":734,"name":735,"imageUrl":736,"description":737,"currentMorphology":20,"currentStage":255,"position":738,"attributes":739},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[299],[355],{"id":741,"viewCount":57,"searchKey":742,"visible":14},"10003566",{"type":10,"entryId":743,"sortOrder":744,"name":745,"imageUrl":746,"description":747,"currentMorphology":20,"currentStage":255,"position":748,"attributes":749},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[267],[355],{"id":751,"viewCount":57,"searchKey":752,"visible":14},"10003453",{"type":10,"entryId":753,"sortOrder":754,"name":755,"imageUrl":756,"description":757,"currentMorphology":20,"currentStage":21,"position":758,"attributes":759},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[23],[355],{"id":761,"viewCount":57,"searchKey":762,"visible":14},"10003577",{"type":10,"entryId":763,"sortOrder":764,"name":765,"imageUrl":766,"description":767,"currentMorphology":20,"currentStage":177,"position":768,"attributes":769},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[23],[355],{"id":771,"viewCount":57,"searchKey":772,"visible":14},"10003570",{"type":10,"entryId":773,"sortOrder":774,"name":775,"imageUrl":776,"description":777,"currentMorphology":20,"currentStage":255,"position":778,"attributes":779},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[23],[355],{"id":781,"viewCount":57,"searchKey":782,"visible":14},"10003565",{"type":10,"entryId":783,"sortOrder":784,"name":785,"imageUrl":786,"description":787,"currentMorphology":20,"currentStage":21,"position":788,"attributes":789},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[23],[458],{"id":791,"viewCount":57,"searchKey":792,"visible":14},"10003476",{"type":10,"entryId":793,"sortOrder":794,"name":795,"imageUrl":796,"description":797,"currentMorphology":20,"currentStage":255,"position":798,"attributes":799},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[23],[458],{"id":801,"viewCount":57,"searchKey":802,"visible":14},"10003466",{"type":10,"entryId":803,"sortOrder":804,"name":805,"imageUrl":806,"description":807,"currentMorphology":20,"currentStage":255,"position":808,"attributes":809},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[299],[458],{"id":811,"viewCount":57,"searchKey":812,"visible":14},"10003379",{"type":10,"entryId":813,"sortOrder":814,"name":815,"imageUrl":816,"description":817,"currentMorphology":20,"currentStage":21,"position":818,"attributes":819},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[23],[599],{"id":821,"viewCount":57,"searchKey":822,"visible":14},"10003376",{"type":10,"entryId":823,"sortOrder":824,"name":825,"imageUrl":826,"description":827,"currentMorphology":20,"currentStage":255,"position":828,"attributes":829},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[23],[599],{"id":831,"viewCount":57,"searchKey":832,"visible":14},"10003543",{"type":10,"entryId":833,"sortOrder":834,"name":835,"imageUrl":836,"description":837,"currentMorphology":20,"currentStage":21,"position":838,"attributes":839},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[267],[269],{"id":841,"viewCount":57,"searchKey":842,"visible":14},"10003557",{"type":10,"entryId":843,"sortOrder":844,"name":845,"imageUrl":846,"description":847,"currentMorphology":20,"currentStage":255,"position":848,"attributes":849},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[23],[269],{"id":851,"viewCount":57,"searchKey":852,"visible":14},"10003522",{"type":10,"entryId":853,"sortOrder":854,"name":855,"imageUrl":856,"description":857,"currentMorphology":20,"currentStage":255,"position":858,"attributes":859},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[267],[269],{"id":861,"viewCount":57,"searchKey":862,"visible":14},"10003579",{"type":10,"entryId":863,"sortOrder":864,"name":865,"imageUrl":866,"description":867,"currentMorphology":20,"currentStage":21,"position":868,"attributes":869},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[267],[301],{"id":871,"viewCount":57,"searchKey":872,"visible":14},"10003389",{"type":10,"entryId":873,"sortOrder":874,"name":875,"imageUrl":876,"description":877,"currentMorphology":20,"currentStage":177,"position":878,"attributes":879},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[267],[301],{"id":881,"viewCount":57,"searchKey":882,"visible":14},"10003536",{"type":10,"entryId":883,"sortOrder":884,"name":885,"imageUrl":886,"description":887,"currentMorphology":20,"currentStage":255,"position":888,"attributes":889},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[267],[301],{"id":891,"viewCount":57,"searchKey":892,"visible":14},"10003529",{"type":10,"entryId":893,"sortOrder":894,"name":895,"imageUrl":896,"description":897,"currentMorphology":20,"currentStage":255,"position":898,"attributes":899},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[23],[236],{"id":901,"viewCount":57,"searchKey":902,"visible":14},"10003433",{"type":10,"entryId":903,"sortOrder":904,"name":905,"imageUrl":906,"description":907,"currentMorphology":20,"currentStage":21,"position":908,"attributes":909},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[23],[458],{"id":911,"viewCount":57,"searchKey":912,"visible":14},"10003427",{"type":10,"entryId":913,"sortOrder":914,"name":915,"imageUrl":916,"description":917,"currentMorphology":20,"currentStage":255,"position":918,"attributes":919},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[23],[458],{"id":921,"viewCount":57,"searchKey":922,"visible":14},"10003405",{"type":10,"entryId":923,"sortOrder":924,"name":925,"imageUrl":926,"description":927,"currentMorphology":20,"currentStage":21,"position":928,"attributes":929},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[267],[458],{"id":931,"viewCount":57,"searchKey":932,"visible":14},"10003525",{"type":10,"entryId":933,"sortOrder":934,"name":935,"imageUrl":936,"description":937,"currentMorphology":20,"currentStage":177,"position":938,"attributes":939},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[267],[236,458],{"id":941,"viewCount":57,"searchKey":942,"visible":14},"10003399",{"type":10,"entryId":943,"sortOrder":944,"name":945,"imageUrl":946,"description":947,"currentMorphology":20,"currentStage":255,"position":948,"attributes":949},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[267],[236,458],{"id":951,"viewCount":57,"searchKey":952,"visible":14},"10003518",{"type":10,"entryId":953,"sortOrder":954,"name":955,"imageUrl":956,"description":957,"currentMorphology":20,"currentStage":177,"position":958,"attributes":959},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[267],[458],{"id":961,"viewCount":57,"searchKey":962,"visible":14},"10003393",{"type":10,"entryId":963,"sortOrder":964,"name":965,"imageUrl":966,"description":967,"currentMorphology":20,"currentStage":255,"position":968,"attributes":969},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[267],[458],{"id":971,"viewCount":57,"searchKey":972,"visible":14},"10003386",{"type":10,"entryId":973,"sortOrder":974,"name":975,"imageUrl":976,"description":977,"currentMorphology":20,"currentStage":21,"position":978,"attributes":979},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[299],[458],{"id":981,"viewCount":57,"searchKey":982,"visible":14},"10003447",{"type":10,"entryId":983,"sortOrder":984,"name":985,"imageUrl":986,"description":987,"currentMorphology":20,"currentStage":255,"position":988,"attributes":989},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[299],[458],{"id":991,"viewCount":57,"searchKey":992,"visible":14},"10003497",{"type":10,"entryId":993,"sortOrder":994,"name":995,"imageUrl":996,"description":997,"currentMorphology":20,"currentStage":21,"position":998,"attributes":999},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[299],[599],{"id":1001,"viewCount":57,"searchKey":1002,"visible":14},"10003479",{"type":10,"entryId":1003,"sortOrder":1004,"name":1005,"imageUrl":1006,"description":1007,"currentMorphology":20,"currentStage":177,"position":1008,"attributes":1009},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[299],[599],{"id":1011,"viewCount":57,"searchKey":1012,"visible":14},"10003388",{"type":10,"entryId":1013,"sortOrder":1014,"name":1015,"imageUrl":1016,"description":1017,"currentMorphology":20,"currentStage":255,"position":1018,"attributes":1019},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[299],[599],{"id":1021,"viewCount":57,"searchKey":1022,"visible":14},"10003429",{"type":10,"entryId":1023,"sortOrder":1024,"name":1025,"imageUrl":1026,"description":1027,"currentMorphology":20,"currentStage":21,"position":1028,"attributes":1029},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[386],[355],{"id":1031,"viewCount":57,"searchKey":1032,"visible":14},"10003430",{"type":10,"entryId":1033,"sortOrder":1034,"name":1035,"imageUrl":1036,"description":1037,"currentMorphology":20,"currentStage":255,"position":1038,"attributes":1039},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[386],[355],{"id":1041,"viewCount":57,"searchKey":1042,"visible":14},"10003549",{"type":10,"entryId":1043,"sortOrder":1044,"name":1045,"imageUrl":1046,"description":1047,"currentMorphology":20,"currentStage":206,"position":1048,"attributes":1049},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[386],[599],{"id":1051,"viewCount":57,"searchKey":1052,"visible":14},"10003494",{"type":10,"entryId":1053,"sortOrder":1054,"name":1055,"imageUrl":1056,"description":1057,"currentMorphology":20,"currentStage":21,"position":1058,"attributes":1059},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[386],[458,355],{"id":1061,"viewCount":57,"searchKey":1062,"visible":14},"10003486",{"type":10,"entryId":1063,"sortOrder":1064,"name":1065,"imageUrl":1066,"description":1067,"currentMorphology":20,"currentStage":255,"position":1068,"attributes":1069},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[386],[458,355],{"id":1071,"viewCount":57,"searchKey":1072,"visible":14},"10003530",{"type":10,"entryId":1073,"sortOrder":1074,"name":1075,"imageUrl":1076,"description":1077,"currentMorphology":20,"currentStage":21,"position":1078,"attributes":1079},"086",1046100,"海墩墩","/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[267],[376],{"id":1081,"viewCount":57,"searchKey":1082,"visible":14},"10003457",{"type":10,"entryId":1083,"sortOrder":1084,"name":1085,"imageUrl":1086,"description":1087,"currentMorphology":20,"currentStage":255,"position":1088,"attributes":1089},"087",1046300,"浪海象","/cdn/init/Wiki_Aniimo_10463.png","用四肢在陸地移動時略顯笨拙，但極其擅長以肚皮滑行。同性間領地意識極強，一旦動怒便會展現海嘯般的威壓。",[267],[376],{"id":1091,"viewCount":57,"searchKey":1092,"visible":14},"10003423",{"type":10,"entryId":1093,"sortOrder":1094,"name":1095,"imageUrl":1096,"description":1097,"currentMorphology":20,"currentStage":21,"position":1098,"attributes":1099},"088",1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[353],[25,355],{"id":1101,"viewCount":57,"searchKey":1102,"visible":14},"10003419",{"type":10,"entryId":1103,"sortOrder":1104,"name":1105,"imageUrl":1106,"description":1107,"currentMorphology":20,"currentStage":255,"position":1108,"attributes":1109},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[353],[25,355],{"id":1111,"viewCount":57,"searchKey":1112,"visible":14},"10003410",{"type":10,"entryId":1113,"sortOrder":1114,"name":1115,"imageUrl":1116,"description":1117,"currentMorphology":20,"currentStage":21,"position":1118,"attributes":1119},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[23],[355],{"id":1121,"viewCount":57,"searchKey":1122,"visible":14},"10003509",{"type":10,"entryId":1123,"sortOrder":1124,"name":1125,"imageUrl":1126,"description":1127,"currentMorphology":20,"currentStage":255,"position":1128,"attributes":1129},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[23],[355],{"id":1131,"viewCount":57,"searchKey":1132,"visible":14},"10003413",{"type":10,"entryId":1133,"sortOrder":1134,"name":1135,"imageUrl":1136,"description":1137,"currentMorphology":20,"currentStage":21,"position":1138,"attributes":1139},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[23],[376],{"id":1141,"viewCount":57,"searchKey":1142,"visible":14},"10003407",{"type":10,"entryId":1143,"sortOrder":1144,"name":1145,"imageUrl":1146,"description":1147,"currentMorphology":20,"currentStage":255,"position":1148,"attributes":1149},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[23],[376],{"id":1151,"viewCount":57,"searchKey":1152,"visible":14},"10003498",{"type":10,"entryId":1153,"sortOrder":1154,"name":1155,"imageUrl":1156,"description":1157,"currentMorphology":20,"currentStage":206,"position":1158,"attributes":1159},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[23],[1160],"attributes-holy",{"id":1162,"viewCount":57,"searchKey":1163,"visible":14},"10003375",{"type":10,"entryId":1164,"sortOrder":1165,"name":1166,"imageUrl":1167,"description":1168,"currentMorphology":20,"currentStage":206,"position":1169,"attributes":1170},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[23],[1160],[1172,1179,1183,1187,1192,1197,1201,1206,1210,1213,1218,1223,1228,1233,1238,1243,1247,1252,1255],{"id":1173,"parentId":1174,"tagType":1175,"tagKey":224,"name":1176,"language":1177,"sort":1178},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","山林型態","zh-TW",6,{"id":1180,"parentId":1174,"tagType":1175,"tagKey":212,"name":1181,"language":1177,"sort":1182},"169975e83c7c7cc9196859ca36b9ab26","森林型態",8,{"id":1184,"parentId":1174,"tagType":1175,"tagKey":215,"name":1185,"language":1177,"sort":1186},"450da43bc6001e686491fef2c68f8615","草原型態",16,{"id":1188,"parentId":1174,"tagType":1175,"tagKey":1189,"name":1190,"language":1177,"sort":1191},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1193,"parentId":1174,"tagType":1175,"tagKey":1194,"name":1195,"language":1177,"sort":1196},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1198,"parentId":1174,"tagType":1175,"tagKey":221,"name":1199,"language":1177,"sort":1200},"5264fcf4157b04e2ba108f70d7b10d07","高原型態",17,{"id":1202,"parentId":1174,"tagType":1175,"tagKey":1203,"name":1204,"language":1177,"sort":1205},"568127bc77f184cd4308056381642df7","Snowfield Form","雪地型態",5,{"id":1207,"parentId":1174,"tagType":1175,"tagKey":1208,"name":1209,"language":1177,"sort":120},"5989c0c15477b85af6544dca43428cd7","Rainstorm Form","雨天型態",{"id":1211,"parentId":1174,"tagType":1175,"tagKey":2