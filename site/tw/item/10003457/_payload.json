67},"伊莫特性","91268487_24",[147],{"id":148,"type":133,"props":149,"children":59},"91268487_25",{"id":150,"customKey":46,"icon":151,"iconStyle":65,"iconTitle":46,"descTitle":152,"descContent":153,"source":154},"91268487_26","/cdn/init/1046300_Feature_146302_Icon.png","凜冬","施放3次技能後，強化下次「破冰」期間施放的技能，並造成額外效果；生命值低於75%時，擊破效率提升20%；生命值低於50%時，擊破效率提升40%。",{"attributes":155,"type":156,"consume":46,"power":46},[],[],{"id":158,"type":62,"props":159,"children":59},"91268487_27",{"title":160,"type":65,"id":161,"isUse":14,"isEdit":14,"useTabs":14,"blackHeader":67,"tabs":162},"技能介紹","91268487_28",[163,212],{"id":164,"title":165,"children":166},"91268487_29","戰鬥技能",[167,180,192,203],{"id":168,"type":133,"props":169},"91268487_30",{"id":170,"customKey":46,"icon":171,"iconStyle":65,"iconTitle":46,"descTitle":172,"descContent":173,"source":174},"91268487_31","/cdn/init/1046300_Skill_10200290_Icon.png","砸地","躍向目標並下砸，造成圓形範圍傷害。強化時，額外獲得10%最大生命值的冰盾，並在目標周圍形成圓形冰牢，持續8秒；再次施放技能可以取消冰牢。",{"attributes":175,"type":177,"consume":178,"power":179},[176],"2",[120],"20","45",{"id":181,"type":133,"props":182},"91268487_32",{"id":183,"customKey":46,"icon":184,"iconStyle":65,"iconTitle":46,"descTitle":185,"descContent":186,"source":187},"91268487_33","/cdn/init/1046300_Skill_10800740_Icon.png","沙湧","朝選定的方向衝鋒，擊退目標並造成傷害，命中任意目標時，扣除自身10%當前生命值。",{"attributes":188,"type":190,"consume":191,"power":179},[189],"8",[120],"10",{"id":193,"type":133,"props":194},"91268487_34",{"id":195,"customKey":46,"icon":196,"iconStyle":65,"iconTitle":46,"descTitle":197,"descContent":198,"source":199},"91268487_35","/cdn/init/1046300_Skill_10200310_Icon.png","掀浪","在冰面上滑行，對前方造成圓形範圍傷害。強化時，會額外旋轉造成一次40%原威力的傷害，每命中一個目標，回復15%最大生命值。",{"attributes":200,"type":201,"consume":178,"power":202},[176],[176],"67",{"id":204,"type":133,"props":205},"91268487_36",{"id":206,"customKey":46,"icon":207,"iconStyle":65,"iconTitle":46,"descTitle":208,"descContent":186,"source":209},"91268487_37","/cdn/init/1046300_Skill_10200300_Icon.png","破冰",{"attributes":210,"type":211,"consume":191,"power":179},[176],[120],{"id":213,"title":214,"children":215},"91268487_38","固有技能",[216,227],{"id":217,"type":133,"props":218},"91268487_39",{"id":219,"customKey":46,"icon":220,"iconStyle":65,"iconTitle":46,"descTitle":221,"descContent":222,"source":223},"91268487_40","/cdn/init/1046300_Skill_10200360_Icon.png","極光加護","為附近所有隊友施加浪海象55%已損失生命值的護盾，持續20秒。",{"attributes":224,"type":225,"consume":226,"power":226},[176],[226],"0",{"id":228,"type":133,"props":229},"91268487_41",{"id":230,"customKey":46,"icon":231,"iconStyle":65,"iconTitle":46,"descTitle":232,"descContent":233,"source":234},"91268487_42","/cdn/init/1046300_Skill_16100000_Icon.png","攻擊","擊破使用冰元素能力，近距離攻擊目標。",{"attributes":235,"type":236,"consume":226,"power":237},[176],[120],"6",[239],{"id":4,"entryId":16,"currentMorphology":9,"visible":14},[241,253,263,273,284,294,304,316,326,336,346,357,367,379,389,399,410,420,430,440,450,460,470,481,491,501,511,521,531,541,551,561,571,581,591,601,611,622,632,642,652,662,672,682,692,702,712,722,732,742,752,762,772,782,792,802,812,822,832,842,852,862,872,882,892,902,912,922,932,942,952,962,972,982,992,1002,1012,1022,1032,1042,1052,1062,1072,1082,1092,1099,1103,1111,1121,1131,1141,1151,1161,1172],{"id":242,"viewCount":59,"searchKey":243,"visible":14},"10003442",{"type":10,"entryId":244,"sortOrder":245,"name":246,"imageUrl":247,"description":248,"currentMorphology":9,"currentStage":120,"position":249,"attributes":251},"001",1005100,"小炭狗","/cdn/init/Wiki_Aniimo_10051.png","活潑好動且總愛跟在焚火狼後頭。蓬鬆炭毛中夾雜著隱燃星火，當火光匯聚燃燒之時，便是牠成長之日。",[250],"position-dps",[252],"attributes-fire",{"id":254,"viewCount":59,"searchKey":255,"visible":14},"10003534",{"type":10,"entryId":256,"sortOrder":257,"name":258,"imageUrl":259,"description":260,"currentMorphology":9,"currentStage":176,"position":261,"attributes":262},"002",1005200,"焚火狼","/cdn/init/Wiki_Aniimo_10052.png","習慣成群結隊活動，極度重視忠誠與團結，冷靜專注的眼神下隱藏著如烈焰般熾熱的心。",[250],[252],{"id":264,"viewCount":59,"searchKey":265,"visible":14},"10003435",{"type":10,"entryId":266,"sortOrder":267,"name":268,"imageUrl":269,"description":270,"currentMorphology":9,"currentStage":21,"position":271,"attributes":272},"003",1005300,"狼鬥士","/cdn/init/Wiki_Aniimo_10053.png","性格好勝，面對越強大的對手越是熱血沸騰。烈火與焦炭將化為印記，見證牠不斷變強的歷程。",[250],[252],{"id":274,"viewCount":59,"searchKey":275,"visible":14},"10003428",{"type":10,"entryId":276,"sortOrder":277,"name":278,"imageUrl":279,"description":280,"currentMorphology":9,"currentStage":21,"position":281,"attributes":282},"004",1005500,"獄魂狼","/cdn/init/Wiki_Aniimo_10055.png","挑戰強者落敗的焚火狼，吸收了同樣懷恨倒下的同伴靈魂，以復仇的欲望驅使自身行動。",[23],[252,283],"attributes-dark",{"id":285,"viewCount":59,"searchKey":286,"visible":14},"10003578",{"type":10,"entryId":287,"sortOrder":288,"name":289,"imageUrl":290,"description":291,"currentMorphology":9,"currentStage":120,"position":292,"attributes":293},"005",1001100,"星樂蒂","/cdn/init/Wiki_Aniimo_10011.png","在林間飛行尋找食物時，頭上的發光星星常被誤認作流星。超級貪吃，有囤積食物的習慣，也會用食物來裝飾自己的小窩。",[250],[283],{"id":295,"viewCount":59,"searchKey":296,"visible":14},"10003417",{"type":10,"entryId":297,"sortOrder":298,"name":299,"imageUrl":300,"description":301,"currentMorphology":9,"currentStage":21,"position":302,"attributes":303},"006",1001200,"星法師","/cdn/init/Wiki_Aniimo_10012.png","獨來獨往，常穿梭在夜色之中。外型如同身披星空斗篷的神祕魔法師，能夠使用精神能量進行瞬移。",[250],[283],{"id":305,"viewCount":59,"searchKey":306,"visible":14},"10003488",{"type":10,"entryId":307,"sortOrder":308,"name":309,"imageUrl":310,"description":311,"currentMorphology":9,"currentStage":120,"position":312,"attributes":314},"007",1018100,"口哨鷗","/cdn/init/Wiki_Aniimo_10181.png","常盤旋於低空並時刻注意沙灘動靜。喜歡湊熱鬧並發出清脆口哨聲起哄。",[313],"position-sup",[315],"attributes-wind",{"id":317,"viewCount":59,"searchKey":318,"visible":14},"10003548",{"type":10,"entryId":319,"sortOrder":320,"name":321,"imageUrl":322,"description":323,"currentMorphology":9,"currentStage":21,"position":324,"attributes":325},"008",1018400,"長號鷗","/cdn/init/Wiki_Aniimo_10184.png","生性熱鬧且能奏出充滿節奏感的樂聲，常按捺不住內心衝動，加入同伴間的即興合奏。",[313],[315],{"id":327,"viewCount":59,"searchKey":328,"visible":14},"10003474",{"type":10,"entryId":329,"sortOrder":330,"name":331,"imageUrl":332,"description":333,"currentMorphology":9,"currentStage":21,"position":334,"attributes":335},"009",1018500,"小號鷗","/cdn/init/Wiki_Aniimo_10185.png","能發出響徹海灘的嘹亮尖叫，愛出風頭的牠並不在意製造噪音。為了耳朵健康，最好別惹怒牠。",[250],[315],{"id":337,"viewCount":59,"searchKey":338,"visible":14},"10003467",{"type":10,"entryId":339,"sortOrder":340,"name":341,"imageUrl":342,"description":343,"currentMorphology":9,"currentStage":21,"position":344,"attributes":345},"010",1018700,"大號鷗","/cdn/init/Wiki_Aniimo_10187.png","能發出低沉的大號音色。性格如音色般厚重沉穩且待人友善，風暴降臨海岸時，待在牠身邊總能感到安心。",[23],[315],{"id":347,"viewCount":59,"searchKey":348,"visible":14},"10003392",{"type":10,"entryId":349,"sortOrder":350,"name":351,"imageUrl":352,"description":353,"currentMorphology":9,"currentStage":120,"position":354,"attributes":355},"011",1021100,"飄飄花","/cdn/init/Wiki_Aniimo_10211.png","飄飄花的身軀極其輕盈，常乘風飄起並藉由花瓣裙的阻力緩緩旋轉降落，或是乾脆隨風四處旅行。",[250],[356],"attributes-grass",{"id":358,"viewCount":59,"searchKey":359,"visible":14},"10003510",{"type":10,"entryId":360,"sortOrder":361,"name":362,"imageUrl":363,"description":364,"currentMorphology":9,"currentStage":21,"position":365,"attributes":366},"012",1021200,"花舞蘭","/cdn/init/Wiki_Aniimo_10212.png","沉浸於表演之中，最大目標是精進舞藝，期盼有朝一日讓所有生物都能感受舞蹈中的生命力。",[250],[356],{"id":368,"viewCount":59,"searchKey":369,"visible":14},"10003477",{"type":10,"entryId":370,"sortOrder":371,"name":372,"imageUrl":373,"description":374,"currentMorphology":9,"currentStage":120,"position":375,"attributes":377},"014",1004100,"蓮頂魚","/cdn/init/Wiki_Aniimo_10041.png","喜歡躲在水下探頭觀察新鮮事物。牠以為蓮葉帽是絕佳偽裝，卻不知在水面移動的蓮葉更引人注目。",[376],"position-heal",[378],"attributes-water",{"id":380,"viewCount":59,"searchKey":381,"visible":14},"10003569",{"type":10,"entryId":382,"sortOrder":383,"name":384,"imageUrl":385,"description":386,"currentMorphology":9,"currentStage":176,"position":387,"attributes":388},"015",1004200,"搗蛋魚","/cdn/init/Wiki_Aniimo_10042.png","極度懼怕高溫，喜歡待在涼爽濕潤處。體表覆蓋著保濕降溫膜，觸感滑溜。若離開水太久，皮膚會乾裂。",[376],[378],{"id":390,"viewCount":59,"searchKey":391,"visible":14},"10003470",{"type":10,"entryId":392,"sortOrder":393,"name":394,"imageUrl":395,"description":396,"currentMorphology":9,"currentStage":21,"position":397,"attributes":398},"016",1004300,"熒冰龍","/cdn/init/Wiki_Aniimo_10043.png","外型與氣質皆極致優雅。天性善良且樂於照顧弱小，但若想利用這份善意傷害牠，將會被瞬間凍成冰塊。",[376],[378,25],{"id":400,"viewCount":59,"searchKey":401,"visible":14},"10003463",{"type":10,"entryId":402,"sortOrder":403,"name":404,"imageUrl":405,"description":406,"currentMorphology":9,"currentStage":21,"position":407,"attributes":409},"017",1004500,"蓮冠龍","/cdn/init/Wiki_Aniimo_10045.png","與蓮花為伴並棲身於蓮葉間，習慣以擬態蓮葉的尾部遮掩面容，展現出矜持且高雅的姿態。",[408],"position-energy",[356,378],{"id":411,"viewCount":59,"searchKey":412,"visible":14},"10003468",{"type":10,"entryId":413,"sortOrder":414,"name":415,"imageUrl":416,"description":417,"currentMorphology":9,"currentStage":120,"position":418,"attributes":419},"018",1026100,"雲朵羊","/cdn/init/Wiki_Aniimo_10261.png","喜歡在晴朗草原上成群活動，輕飄飄的身軀能懸停於雲霧中，三三兩兩擠作一團。",[313],[315],{"id":421,"viewCount":59,"searchKey":422,"visible":14},"10003365",{"type":10,"entryId":423,"sortOrder":424,"name":425,"imageUrl":426,"description":427,"currentMorphology":9,"currentStage":21,"position":428,"attributes":429},"019",1026200,"蓬蓬羊","/cdn/init/Wiki_Aniimo_10262.png","喜歡躲在雲團中睡覺，因風壓與靜電存在，蓬鬆羊毛極易吸附隨風飛過的小物。",[313],[315],{"id":431,"viewCount":59,"searchKey":432,"visible":14},"10003461",{"type":10,"entryId":433,"sortOrder":434,"name":435,"imageUrl":436,"description":437,"currentMorphology":9,"currentStage":21,"position":438,"attributes":439},"020",1026300,"眠眠羊","/cdn/init/Wiki_Aniimo_10263.png","吸收夢境能量的毛髮呈現出迷離幻彩。當牠將這團毛髮當作枕頭呼呼大睡時，便能沉入甜美夢鄉。",[313],[283],{"id":441,"viewCount":59,"searchKey":442,"visible":14},"10003421",{"type":10,"entryId":443,"sortOrder":444,"name":445,"imageUrl":446,"description":447,"currentMorphology":9,"currentStage":120,"position":448,"attributes":449},"021",1020100,"跑調草","/cdn/init/Wiki_Aniimo_10201.png","成群結隊生活在草原上，平時鑽入地底吸收養分。喜歡聚在一起唱歌，卻對自己的走音毫無自覺。",[23],[356],{"id":451,"viewCount":59,"searchKey":452,"visible":14},"10003414",{"type":10,"entryId":453,"sortOrder":454,"name":455,"imageUrl":456,"description":457,"currentMorphology":9,"currentStage":21,"position":458,"attributes":459},"022",1020300,"女巫草","/cdn/init/Wiki_Aniimo_10203.png","討厭闖入領地的生物，會發出古怪音波擾亂對手心智、降低防禦力，甚至能讓對方陷入昏迷。",[408],[283,356],{"id":461,"viewCount":59,"searchKey":462,"visible":14},"10003404",{"type":10,"entryId":463,"sortOrder":464,"name":465,"imageUrl":466,"description":467,"currentMorphology":9,"currentStage":21,"position":468,"attributes":469},"023",1020700,"埋埋草","/cdn/init/Wiki_Aniimo_10207.png","曾長時間埋入地底，重見天日時已變得巨大無比。需靠根系吸收土壤養分維持活力，極度厭惡離開土地。",[23],[356],{"id":471,"viewCount":59,"searchKey":472,"visible":14},"10003567",{"type":10,"entryId":473,"sortOrder":474,"name":475,"imageUrl":476,"description":477,"currentMorphology":9,"currentStage":120,"position":478,"attributes":479},"024",1016100,"花芽蟹","/cdn/init/Wiki_Aniimo_10161.png","一生只會選擇一名伴侶，對愛情極其專一且總是成雙成對活動。頭頂的蟹心草代表著牠的幸福程度。",[23],[480,356],"attributes-rock",{"id":482,"viewCount":59,"searchKey":483,"visible":14},"10003462",{"type":10,"entryId":484,"sortOrder":485,"name":486,"imageUrl":487,"description":488,"currentMorphology":9,"currentStage":21,"position":489,"attributes":490},"025",1016200,"蔥蔥蟹","/cdn/init/Wiki_Aniimo_10162.png","茂盛植株完全覆蓋背殼並透過吸收日光提供養分，在陽光充足時，不必額外進食就能生存。",[23],[480,356],{"id":492,"viewCount":59,"searchKey":493,"visible":14},"10003551",{"type":10,"entryId":494,"sortOrder":495,"name":496,"imageUrl":497,"description":498,"currentMorphology":9,"currentStage":21,"position":499,"attributes":500},"026",1016300,"晶殼蟹","/cdn/init/Wiki_Aniimo_10163.png","幽居於洞穴中且因食物含豐富礦物質，背殼逐漸被晶體覆蓋。平時藏身地下，以華麗背殼吸引獵物靠近。",[23],[25],{"id":502,"viewCount":59,"searchKey":503,"visible":14},"10003409",{"type":10,"entryId":504,"sortOrder":505,"name":506,"imageUrl":507,"description":508,"currentMorphology":9,"currentStage":120,"position":509,"attributes":510},"027",1033100,"幽幽焰","/cdn/init/Wiki_Aniimo_10331.png","外表雖如火焰，但那僅是能量流動的型態，不僅不發熱還會吸收周圍熱量。有時會以此偽裝成篝火戲弄他人。",[408],[252],{"id":512,"viewCount":59,"searchKey":513,"visible":14},"10003507",{"type":10,"entryId":514,"sortOrder":515,"name":516,"imageUrl":517,"description":518,"currentMorphology":9,"currentStage":21,"position":519,"attributes":520},"028",1033300,"幻焰靈","/cdn/init/Wiki_Aniimo_10333.png","僅在深夜現身，身軀由氣態能量構成，因此能隨意分裂，甚至具備製造分身的能力。",[408],[252],{"id":522,"viewCount":59,"searchKey":523,"visible":14},"10003542",{"type":10,"entryId":524,"sortOrder":525,"name":526,"imageUrl":527,"description":528,"currentMorphology":9,"currentStage":120,"position":529,"attributes":530},"029",1023100,"螢粉蝶","/cdn/init/Wiki_Aniimo_10231.png","膽小且警惕，察覺危險便會尋找藏身處，但抖落的螢光鱗粉卻總是暴露行蹤。",[376],[315],{"id":532,"viewCount":59,"searchKey":533,"visible":14},"10003440",{"type":10,"entryId":534,"sortOrder":535,"name":536,"imageUrl":537,"description":538,"currentMorphology":9,"currentStage":21,"position":539,"attributes":540},"030",1023200,"幻翼蝶","/cdn/init/Wiki_Aniimo_10232.png","個性冷淡且獨來獨往，察覺危險迫近時會搧動翅膀吹出鱗粉製造幻覺迷惑對手，隨後慢悠悠地離開。",[376],[315],{"id":542,"viewCount":59,"searchKey":543,"visible":14},"10003563",{"type":10,"entryId":544,"sortOrder":545,"name":546,"imageUrl":547,"description":548,"currentMorphology":9,"currentStage":226,"position":549,"attributes":550},"031",1023300,"幻夢蝶","/cdn/init/Wiki_Aniimo_10233.png","蝶翼閃爍著絢麗光輝，揮動翅膀時灑落的鱗粉能促進花卉生長，使所到之處皆生機盎然。",[408],[315,356],{"id":552,"viewCount":59,"searchKey":553,"visible":14},"10003368",{"type":10,"entryId":554,"sortOrder":555,"name":556,"imageUrl":557,"description":558,"currentMorphology":9,"currentStage":120,"position":559,"attributes":560},"032",1044100,"大耳蝠","/cdn/init/Wiki_Aniimo_10441.png","大耳朵高高聳立且對聲音極其敏感，只要是牠追蹤的動靜，無論遠近都不會遺漏。",[313],[315],{"id":562,"viewCount":59,"searchKey":563,"visible":14},"10003363",{"type":10,"entryId":564,"sortOrder":565,"name":566,"imageUrl":567,"description":568,"currentMorphology":9,"currentStage":21,"position":569,"attributes":570},"033",1044300,"偵探蝠","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛，熱衷於搜尋痕跡與追蹤目標，尾部圓環能放大超音波，輕鬆識破隱身把戲。",[313],[315],{"id":572,"viewCount":59,"searchKey":573,"visible":14},"10003515",{"type":10,"entryId":574,"sortOrder":575,"name":576,"imageUrl":577,"description":578,"currentMorphology":9,"currentStage":120,"position":579,"attributes":580},"034",1032100,"小哭苞","/cdn/init/Wiki_Aniimo_10321.png","膽小且怕痛，稍有動靜就掉眼淚，但被逼急時也會揮舞棘刺反抗。當真正勇敢時，頭頂花苞便會綻放。",[250],[356],{"id":582,"viewCount":59,"searchKey":583,"visible":14},"10003496",{"type":10,"entryId":584,"sortOrder":585,"name":586,"imageUrl":587,"description":588,"currentMorphology":9,"currentStage":21,"position":589,"attributes":590},"035",1032300,"刺劍玫","/cdn/init/Wiki_Aniimo_10323.png","刺莖化成的長劍平時收納於手臂葉片中，唯有戰鬥時才會抽出。性格無畏且不懼挑戰，盡心盡力守護著族群。",[250],[356],{"id":592,"viewCount":59,"searchKey":593,"visible":14},"10003378",{"type":10,"entryId":594,"sortOrder":595,"name":596,"imageUrl":597,"description":598,"currentMorphology":9,"currentStage":21,"position":599,"attributes":600},"036",1032400,"魅樂薇","/cdn/init/Wiki_Aniimo_10324.png","為平息紛爭，它會散落馨香花瓣，令接觸者心生幸福感，進而使戰意消散。",[313],[356],{"id":602,"viewCount":59,"searchKey":603,"visible":14},"10003456",{"type":10,"entryId":604,"sortOrder":605,"name":606,"imageUrl":607,"description":608,"currentMorphology":9,"currentStage":120,"position":609,"attributes":610},"037",1047100,"河童蛋","/cdn/init/Wiki_Aniimo_10471.png","休息時縮入殼中，有時會被誤認為伊莫蛋。害怕戰鬥卻愛湊熱鬧，喜歡揮舞草球跳舞助威。",[23],[356],{"id":612,"viewCount":59,"searchKey":613,"visible":14},"10003374",{"type":10,"entryId":614,"sortOrder":615,"name":616,"imageUrl":617,"description":618,"currentMorphology":9,"currentStage":21,"position":619,"attributes":620},"038",1047400,"霹靂蜥","/cdn/init/Wiki_Aniimo_10474.png","四肢靈活的牠見誰都想炫耀華麗踢技，喜歡將蛻下的皮像兜帽一樣帥氣地套在頭上。",[313],[621],"attributes-electric",{"id":623,"viewCount":59,"searchKey":624,"visible":14},"10003443",{"type":10,"entryId":625,"sortOrder":626,"name":627,"imageUrl":628,"description":629,"currentMorphology":9,"currentStage":21,"position":630,"attributes":631},"039",1047500,"咆尾蜥","/cdn/init/Wiki_Aniimo_10475.png","高聳鬣毛盡顯狂放，野性咆哮張揚本色。尾部構造能收納聲波，撞擊對手時會施放音爆攻擊。",[23],[356],{"id":633,"viewCount":59,"searchKey":634,"visible":14},"10003503",{"type":10,"entryId":635,"sortOrder":636,"name":637,"imageUrl":638,"description":639,"currentMorphology":9,"currentStage":120,"position":640,"attributes":641},"040",1035100,"採蜜鳥","/cdn/init/Wiki_Aniimo_10351.png","將採集的花蜜儲存於體內發酵，吐出後可作為香水原料，是調香師們不可或缺的合作夥伴。",[313],[283],{"id":643,"viewCount":59,"searchKey":644,"visible":14},"10003521",{"type":10,"entryId":645,"sortOrder":646,"name":647,"imageUrl":648,"description":649,"currentMorphology":9,"currentStage":21,"position":650,"attributes":651},"041",1035200,"香氛鳥","/cdn/init/Wiki_Aniimo_10352.png","對氣味極其挑剔，會取食不同花蜜儲存於體內，調配專屬香水原料，全身羽毛皆浸透著獨特香氣。",[313],[283],{"id":653,"viewCount":59,"searchKey":654,"visible":14},"10003508",{"type":10,"entryId":655,"sortOrder":656,"name":657,"imageUrl":658,"description":659,"currentMorphology":9,"currentStage":120,"position":660,"attributes":661},"042",1003100,"幽爪鐮","/cdn/init/Wiki_Aniimo_10031.png","戰勝同伴是進化的唯一途徑。為了應對隨時出現的對手，牠隨時都在尋找合適的石頭磨利爪子。",[250],[283],{"id":663,"viewCount":59,"searchKey":664,"visible":14},"10003369",{"type":10,"entryId":665,"sortOrder":666,"name":667,"imageUrl":668,"description":669,"currentMorphology":9,"currentStage":21,"position":670,"attributes":671},"043",1003200,"淬刃螂","/cdn/init/Wiki_Aniimo_10032.png","磨礪利刃並靜待時機，在暗影中以匿蹤之姿戲弄對手，是名追求一擊必殺的冷酷刺客。",[250],[283],{"id":673,"viewCount":59,"searchKey":674,"visible":14},"10003501",{"type":10,"entryId":675,"sortOrder":676,"name":677,"imageUrl":678,"description":679,"currentMorphology":9,"currentStage":21,"position":680,"attributes":681},"044",1003300,"電刺螂","/cdn/init/Wiki_Aniimo_10033.png","前肢折斷的幽爪鐮吸收雷電之力進化而來，重塑後的逆刃鋒利無比，閃爍著耀眼的電光。",[250],[621],{"id":683,"viewCount":59,"searchKey":684,"visible":14},"10003422",{"type":10,"entryId":685,"sortOrder":686,"name":687,"imageUrl":688,"description":689,"currentMorphology":9,"currentStage":120,"position":690,"attributes":691},"045",1013100,"冰骨狼","/cdn/init/Wiki_Aniimo_10131.png","長著一對大耳朵的元氣狼仔，胸前的冰骨領結是牠最愛的玩具。最討厭行事沒有邊界的小炭狗。",[250],[25],{"id":693,"viewCount":59,"searchKey":694,"visible":14},"10003575",{"type":10,"entryId":695,"sortOrder":696,"name":697,"imageUrl":698,"description":699,"currentMorphology":9,"currentStage":176,"position":700,"attributes":701},"046",1013200,"冰刃狼","/cdn/init/Wiki_Aniimo_10132.png","唯恐喪失鬥志而極度反感被撫摸，跟隨族群捕獵時總是咬著冰刀衝在最前線，渴望成為獨當一面的戰士。",[250],[25],{"id":703,"viewCount":59,"searchKey":704,"visible":14},"10003415",{"type":10,"entryId":705,"sortOrder":706,"name":707,"imageUrl":708,"description":709,"currentMorphology":9,"currentStage":21,"position":710,"attributes":711},"047",1013300,"霜鋒狼","/cdn/init/Wiki_Aniimo_10133.png","對實力充滿絕對自信的高傲戰士，口中冰刃散發著凜冽寒氣，唯有面對強敵時才會感到興奮。",[250],[25],{"id":713,"viewCount":59,"searchKey":714,"visible":14},"10003524",{"type":10,"entryId":715,"sortOrder":716,"name":717,"imageUrl":718,"description":719,"currentMorphology":9,"currentStage":120,"position":720,"attributes":721},"048",1022100,"閃電貂","/cdn/init/Wiki_Aniimo_10221.png","生活在樹林間，攻擊時尾巴會冒出金色電光與劈啪作響的電流聲。動作靈巧敏捷，極難捕捉。",[23],[621],{"id":723,"viewCount":59,"searchKey":724,"visible":14},"10003475",{"type":10,"entryId":725,"sortOrder":726,"name":727,"imageUrl":728,"description":729,"currentMorphology":9,"currentStage":21,"position":730,"attributes":731},"049",1022200,"雷光貂","/cdn/init/Wiki_Aniimo_10222.png","透過特殊毛髮產生的靜電吸引空氣中的帶電粒子來蓄電。被水淋濕會影響蓄電能力，因此雨天很少出現。",[23],[621],{"id":733,"viewCount":59,"searchKey":734,"visible":14},"10003523",{"type":10,"entryId":735,"sortOrder":736,"name":737,"imageUrl":738,"description":739,"currentMorphology":9,"currentStage":120,"position":740,"attributes":741},"050",1017100,"羞羞獺","/cdn/init/Wiki_Aniimo_10171.png","會四處挖掘尋找求愛禮物，卻因太容易害羞而常告白失敗。用小爪子搓揉臉頰是牠的標誌性動作。",[23],[378],{"id":743,"viewCount":59,"searchKey":744,"visible":14},"10003398",{"type":10,"entryId":745,"sortOrder":746,"name":747,"imageUrl":748,"description":749,"currentMorphology":9,"currentStage":176,"position":750,"attributes":751},"051",1017200,"泡泡獺","/cdn/init/Wiki_Aniimo_10172.png","會精心挑選貝殼並製作與身形相配的新鏟子。據說遇到心動對象時，身邊會浮現粉紅色的泡泡。",[23],[378],{"id":753,"viewCount":59,"searchKey":754,"visible":14},"10003516",{"type":10,"entryId":755,"sortOrder":756,"name":757,"imageUrl":758,"description":759,"currentMorphology":9,"currentStage":21,"position":760,"attributes":761},"052",1017300,"漂漂獺","/cdn/init/Wiki_Aniimo_10173.png","生性自戀且每天花大量時間梳理毛髮。精心計算出水姿態並享受被追隨的感覺，發達肌肉卻因毛髮濃密而無法炫耀。",[313],[378],{"id":763,"viewCount":59,"searchKey":764,"visible":14},"10003566",{"type":10,"entryId":765,"sortOrder":766,"name":767,"imageUrl":768,"description":769,"currentMorphology":9,"currentStage":21,"position":770,"attributes":771},"053",1017400,"胖胖獺","/cdn/init/Wiki_Aniimo_10174.png","強壯身軀能爆發出驚人力量，但比起炫耀武力更喜歡宅在巢穴，並蒐集各式裝飾物來裝點家園。",[23],[378],{"id":773,"viewCount":59,"searchKey":774,"visible":14},"10003453",{"type":10,"entryId":775,"sortOrder":776,"name":777,"imageUrl":778,"description":779,"currentMorphology":9,"currentStage":120,"position":780,"attributes":781},"054",1019100,"貝殼星","/cdn/init/Wiki_Aniimo_10191.png","用柔軟腕足吸附貝殼包裹自身，混跡在沙灘的普通貝殼堆中，平時緊閉甲殼，僅在夜晚打開沐浴月光。",[250],[378],{"id":783,"viewCount":59,"searchKey":784,"visible":14},"10003577",{"type":10,"entryId":785,"sortOrder":786,"name":787,"imageUrl":788,"description":789,"currentMorphology":9,"currentStage":176,"position":790,"attributes":791},"055",1019200,"智多星","/cdn/init/Wiki_Aniimo_10192.png","嚮往著璀璨星空，常躺在背殼上搖晃身體，閉上雙眼沉浸於星辰編織的夢境之中。",[250],[378],{"id":793,"viewCount":59,"searchKey":794,"visible":14},"10003570",{"type":10,"entryId":795,"sortOrder":796,"name":797,"imageUrl":798,"description":799,"currentMorphology":9,"currentStage":21,"position":800,"attributes":801},"056",1019400,"星騎士","/cdn/init/Wiki_Aniimo_10194.png","將曾包裹自身的貝殼化作劍與盾，當脆弱的貝殼星遇險時會挺身而出。喜歡沿海岸線逐浪而行。",[250],[378],{"id":803,"viewCount":59,"searchKey":804,"visible":14},"10003565",{"type":10,"entryId":805,"sortOrder":806,"name":807,"imageUrl":808,"description":809,"currentMorphology":9,"currentStage":120,"position":810,"attributes":811},"057",1045100,"滾滾郎","/cdn/init/Wiki_Aniimo_10451.png","從出生起就與石球形影不離，透過不斷滾動讓球體越來越圓，但牠推著的石球似乎不像表面上那麼簡單。",[250],[480],{"id":813,"viewCount":59,"searchKey":814,"visible":14},"10003476",{"type":10,"entryId":815,"sortOrder":816,"name":817,"imageUrl":818,"description":819,"currentMorphology":9,"currentStage":21,"position":820,"attributes":821},"058",1045300,"機車郎","/cdn/init/Wiki_Aniimo_10453.png","像以前一樣倒著前進，因完全掌控了滾球技巧，能做出各種高難度動作攻擊目標。",[250],[480],{"id":823,"viewCount":59,"searchKey":824,"visible":14},"10003466",{"type":10,"entryId":825,"sortOrder":826,"name":827,"imageUrl":828,"description":829,"currentMorphology":9,"currentStage":21,"position":830,"attributes":831},"059",1045400,"岩球郎","/cdn/init/Wiki_Aniimo_10454.png","與滾滾郎朝夕相伴的石球因顛簸而覺醒，厭倦了身不由己的它吞噬蟲體後，終於能憑藉自身意志進行活動。",[313],[480],{"id":833,"viewCount":59,"searchKey":834,"visible":14},"10003379",{"type":10,"entryId":835,"sortOrder":836,"name":837,"imageUrl":838,"description":839,"currentMorphology":9,"currentStage":120,"position":840,"attributes":841},"060",1029100,"天使茸","/cdn/init/Wiki_Aniimo_10291.png","總是掛著招牌笑容，熱情邀請其他伊莫一同玩耍。雖偶爾因頑皮或嘴饞惹出麻煩，但總能獲得原諒。",[250],[621],{"id":843,"viewCount":59,"searchKey":844,"visible":14},"10003376",{"type":10,"entryId":845,"sortOrder":846,"name":847,"imageUrl":848,"description":849,"currentMorphology":9,"currentStage":21,"position":850,"attributes":851},"061",1029300,"疾電茸","/cdn/init/Wiki_Aniimo_10293.png","憑藉毛髮優異的導電性能，凝集雷光之力延伸出雙翼，以疾馳之姿驅散陰霾，讓心情也隨之轉晴。",[250],[621],{"id":853,"viewCount":59,"searchKey":854,"visible":14},"10003543",{"type":10,"entryId":855,"sortOrder":856,"name":857,"imageUrl":858,"description":859,"currentMorphology":9,"currentStage":120,"position":860,"attributes":861},"062",1002100,"大眼盔","/cdn/init/Wiki_Aniimo_10021.png","堅硬的頭盔保護柔軟的身體，能從口中伸出勾爪掠食，富有彈性的身體能裝下自身十倍體積的食物。",[23],[283],{"id":863,"viewCount":59,"searchKey":864,"visible":14},"10003557",{"type":10,"entryId":865,"sortOrder":866,"name":867,"imageUrl":868,"description":869,"currentMorphology":9,"currentStage":21,"position":870,"attributes":871},"063",1002600,"盔勇士","/cdn/init/Wiki_Aniimo_10026.png","獲得斷劍與盔甲並傳承了勇氣與力量，終於成為一名能守護同伴、直面強敵的勇士。",[250],[283],{"id":873,"viewCount":59,"searchKey":874,"visible":14},"10003522",{"type":10,"entryId":875,"sortOrder":876,"name":877,"imageUrl":878,"description":879,"currentMorphology":9,"currentStage":21,"position":880,"attributes":881},"064",1002700,"盔衛士","/cdn/init/Wiki_Aniimo_10027.png","身材高大卻性格膽小，遇到危險就縮成球逃避戰鬥，但為了守護同伴，牠也能鼓起勇氣應戰。",[23],[283],{"id":883,"viewCount":59,"searchKey":884,"visible":14},"10003579",{"type":10,"entryId":885,"sortOrder":886,"name":887,"imageUrl":888,"description":889,"currentMorphology":9,"currentStage":120,"position":890,"attributes":891},"065",1002400,"鋼顎仔","/cdn/init/Wiki_Aniimo_10024.png","路過什麼都想啃一口。下巴活動性極佳，張開角度驚人。牠習慣以輕咬表達喜悅，尤其偏愛金屬製品，因為不容易咬壞。",[23],[315],{"id":893,"viewCount":59,"searchKey":894,"visible":14},"10003389",{"type":10,"entryId":895,"sortOrder":896,"name":897,"imageUrl":898,"description":899,"currentMorphology":9,"currentStage":176,"position":900,"attributes":901},"066",1002200,"盔面龍","/cdn/init/Wiki_Aniimo_10022.png","幼龍將脆弱隱藏於頭盔之下，內心渴望變得更強並自由翱翔，前往世界各個角落尋找隱匿的寶藏。",[23],[315],{"id":903,"viewCount":59,"searchKey":904,"visible":14},"10003536",{"type":10,"entryId":905,"sortOrder":906,"name":907,"imageUrl":908,"description":909,"currentMorphology":9,"currentStage":21,"position":910,"attributes":911},"067",1002300,"銀盔龍","/cdn/init/Wiki_Aniimo_10023.png","全身覆蓋著堅硬鎧甲，停駐於石台時宛如高大的雕像。傳說牠會守在遺跡入口，看守古老的寶藏。",[23],[315],{"id":913,"viewCount":59,"searchKey":914,"visible":14},"10003529",{"type":10,"entryId":915,"sortOrder":916,"name":917,"imageUrl":918,"description":919,"currentMorphology":9,"currentStage":21,"position":920,"attributes":921},"068",1002500,"炎鎧龍","/cdn/init/Wiki_Aniimo_10025.png","身披烈焰淬煉後的金屬重鎧，暴怒噴發的火焰能瞬間將周遭化為熔岩。不想化為灰燼就離牠遠點。",[250],[252],{"id":923,"viewCount":59,"searchKey":924,"visible":14},"10003433",{"type":10,"entryId":925,"sortOrder":926,"name":927,"imageUrl":928,"description":929,"currentMorphology":9,"currentStage":120,"position":930,"attributes":931},"069",1050100,"迷夢仔","/cdn/init/Wiki_Aniimo_10501.png","白天處於夢遊狀態，若被吵醒會瞬間暴躁失控，一旦體力耗盡便會乖乖墜入夢鄉。",[250],[480],{"id":933,"viewCount":59,"searchKey":934,"visible":14},"10003427",{"type":10,"entryId":935,"sortOrder":936,"name":937,"imageUrl":938,"description":939,"currentMorphology":9,"currentStage":21,"position":940,"attributes":941},"070",1050300,"暴睡熊","/cdn/init/Wiki_Aniimo_10503.png","在平日的溫柔之下，是時刻的隱忍與克制，但若受刺激或腹中空空時，便會無法自控並陷入狂暴之中。",[250],[480],{"id":943,"viewCount":59,"searchKey":944,"visible":14},"10003405",{"type":10,"entryId":945,"sortOrder":946,"name":947,"imageUrl":948,"description":949,"currentMorphology":9,"currentStage":120,"position":950,"attributes":951},"071",1028100,"碎岩仔","/cdn/init/Wiki_Aniimo_10281.png","天生具備感應礦石的能力，偏好進食各種礦石，且攝取的礦石種類會直接影響其成長方向。",[23],[480],{"id":953,"viewCount":59,"searchKey":954,"visible":14},"10003525",{"type":10,"entryId":955,"sortOrder":956,"name":957,"imageUrl":958,"description":959,"currentMorphology":9,"currentStage":176,"position":960,"attributes":961},"072",1028200,"熾岩龍","/cdn/init/Wiki_Aniimo_10282.png","以堅硬利爪擊碎晶石後吞服以儲存熱量，體表也因此顯現火紅紋路。體型雖小巧，卻能從口中持續噴出高熱焰流。",[23],[252,480],{"id":963,"viewCount":59,"searchKey":964,"visible":14},"10003399",{"type":10,"entryId":965,"sortOrder":966,"name":967,"imageUrl":968,"description":969,"currentMorphology":9,"currentStage":21,"position":970,"attributes":971},"073",1028300,"熔暴龍","/cdn/init/Wiki_Aniimo_10283.png","熾熱晶體如凝結的熔岩般於身軀生長，其積存的熱量若瞬間爆發，足以熔毀擋在面前的一切阻礙。",[23],[252,480],{"id":973,"viewCount":59,"searchKey":974,"visible":14},"10003518",{"type":10,"entryId":975,"sortOrder":976,"name":977,"imageUrl":978,"description":979,"currentMorphology":9,"currentStage":176,"position":980,"attributes":981},"074",1028400,"晶背龍","/cdn/init/Wiki_Aniimo_10284.png","攝取的晶礦在體內經過提煉，會化為蘊含精純能量的晶脊向外生長。",[23],[480],{"id":983,"viewCount":59,"searchKey":984,"visible":14},"10003393",{"type":10,"entryId":985,"sortOrder":986,"name":987,"imageUrl":988,"description":989,"currentMorphology":9,"currentStage":21,"position":990,"attributes":991},"075",1028500,"晶簇龍","/cdn/init/Wiki_Aniimo_10285.png","棲息於晶礦充足之地，背部晶脊極其堅硬，不僅能保護身體，更是儲存能量的重要結構。",[23],[480],{"id":993,"viewCount":59,"searchKey":994,"visible":14},"10003386",{"type":10,"entryId":995,"sortOrder":996,"name":997,"imageUrl":998,"description":999,"currentMorphology":9,"currentStage":120,"position":1000,"attributes":1001},"076",1043100,"蟻煙囪","/cdn/init/Wiki_Aniimo_10431.png","蟻煙囪用泥土一點一滴修築自己的外殼，遇險時會從頂部孔洞噴出煙霧籠罩四周，藉此遮掩身形。",[313],[480],{"id":1003,"viewCount":59,"searchKey":1004,"visible":14},"10003447",{"type":10,"entryId":1005,"sortOrder":1006,"name":1007,"imageUrl":1008,"description":1009,"currentMorphology":9,"currentStage":21,"position":1010,"attributes":1011},"077",1043300,"蟻地堡","/cdn/init/Wiki_Aniimo_10433.png","上下身體具備可獨立旋轉的結構，讓蟻地堡能靈活觀察四周，並伺機變形出砲台擊退對手。",[313],[480],{"id":1013,"viewCount":59,"searchKey":1014,"visible":14},"10003497",{"type":10,"entryId":1015,"sortOrder":1016,"name":1017,"imageUrl":1018,"description":1019,"currentMorphology":9,"currentStage":120,"position":1020,"attributes":1021},"078",1014100,"燈泡水母","/cdn/init/Wiki_Aniimo_10141.png","生性膽小，一有風吹草動便立刻逃走，頭頂燈泡狀器官會隨著健康狀況產生變化。",[313],[621],{"id":1023,"viewCount":59,"searchKey":1024,"visible":14},"10003479",{"type":10,"entryId":1025,"sortOrder":1026,"name":1027,"imageUrl":1028,"description":1029,"currentMorphology":9,"currentStage":176,"position":1030,"attributes":1031},"079",1014200,"燈紗水母","/cdn/init/Wiki_Aniimo_10142.png","極度怕黑的水母，每當夜晚降臨便會開始發光，即便入睡也不熄滅，猶如一盞守夜明燈。",[313],[621],{"id":1033,"viewCount":59,"searchKey":1034,"visible":14},"10003388",{"type":10,"entryId":1035,"sortOrder":1036,"name":1037,"imageUrl":1038,"description":1039,"currentMorphology":9,"currentStage":21,"position":1040,"attributes":1041},"080",1014300,"吊燈水母","/cdn/init/Wiki_Aniimo_10143.png","能根據心情自如調節發光的亮度與頻率。觸手不僅能閃爍出炫麗獨特的光斑，還能傳導電流攻擊目標。",[313],[621],{"id":1043,"viewCount":59,"searchKey":1044,"visible":14},"10003429",{"type":10,"entryId":1045,"sortOrder":1046,"name":1047,"imageUrl":1048,"description":1049,"currentMorphology":9,"currentStage":120,"position":1050,"attributes":1051},"081",1048100,"浴球鳥","/cdn/init/Wiki_Aniimo_10481.png","揉搓體表油脂會產生大量泡沫，既能清潔又能保護自己，但有時也會踩到泡沫而滑倒。",[408],[378],{"id":1053,"viewCount":59,"searchKey":1054,"visible":14},"10003430",{"type":10,"entryId":1055,"sortOrder":1056,"name":1057,"imageUrl":1058,"description":1059,"currentMorphology":9,"currentStage":21,"position":1060,"attributes":1061},"082",1048300,"沐羽鳥","/cdn/init/Wiki_Aniimo_10483.png","羽毛會不斷分泌油脂，稍加揉搓就能產生各式各樣的泡泡，而用於保護背上幼鳥的，自然是其中最柔軟綿密的一種。",[408],[378],{"id":1063,"viewCount":59,"searchKey":1064,"visible":14},"10003549",{"type":10,"entryId":1065,"sortOrder":1066,"name":1067,"imageUrl":1068,"description":1069,"currentMorphology":9,"currentStage":226,"position":1070,"attributes":1071},"083",1012200,"貝瑟斯","/cdn/init/Wiki_Aniimo_10122.png","深受心跳鼓點困擾的貝瑟斯，不斷尋找能掩蓋鼓聲的節奏，熱愛搖擺身體並追求前衛的音樂藝術。",[408],[621],{"id":1073,"viewCount":59,"searchKey":1074,"visible":14},"10003494",{"type":10,"entryId":1075,"sortOrder":1076,"name":1077,"imageUrl":1078,"description":1079,"currentMorphology":9,"currentStage":120,"position":1080,"attributes":1081},"084",1038100,"珊殼魚","/cdn/init/Wiki_Aniimo_10381.png","將身體埋入地底偽裝成珊瑚，一旦獵物靠近便會一口咬上。不過偶爾也會耐不住性子，露出眼睛四處張望。",[408],[480,378],{"id":1083,"viewCount":59,"searchKey":1084,"visible":14},"10003486",{"type":10,"entryId":1085,"sortOrder":1086,"name":1087,"imageUrl":1088,"description":1089,"currentMorphology":9,"currentStage":21,"position":1090,"attributes":1091},"085",1038300,"珊瑚龍","/cdn/init/Wiki_Aniimo_10383.png","喜歡將身體埋在沙子中擬態成珊瑚叢，利用頭背部珊瑚的夜光誘捕生物並伺機突襲。",[408],[480,378],{"id":5,"viewCount":59,"searchKey":1093,"visible":14},{"type":10,"entryId":8,"sortOrder":1094,"name":75,"imageUrl":1095,"description":1096,"currentMorphology":9,"currentStage":120,"position":1097,"attributes":1098},1046100,"/cdn/init/Wiki_Aniimo_10461.png","腮幫子上的圓圈常被誤認為眼睛。喜歡成群結隊出現在海岸邊，與同伴擠在一起便會感到安心。",[23],[25],{"id":4,"viewCount":59,"searchKey":1100,"visible":14},{"type":10,"entryId":16,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":1101,"attributes":1102},[23],[25],{"id":6,"viewCount":59,"searchKey":1104,"visible":14},{"type":10,"entryId":12,"sortOrder":1105,"name":1106,"imageUrl":1107,"description":1108,"currentMorphology":9,"currentStage":120,"position":1109,"attributes":1110},1058100,"覓葉羊","/cdn/init/Wiki_Aniimo_10581.png","懶洋洋地伸展葉羽，嘴裡總嚼個沒完，把綠藻和黏液變成飄飛的泡泡，輕輕一蹬，就能乘著泡泡悠悠出發。",[376],[356,378],{"id":1112,"viewCount":59,"searchKey":1113,"visible":14},"10003419",{"type":10,"entryId":1114,"sortOrder":1115,"name":1116,"imageUrl":1117,"description":1118,"currentMorphology":9,"currentStage":21,"position":1119,"attributes":1120},"089",1058300,"麗芙羊","/cdn/init/Wiki_Aniimo_10583.png","披著翠綠葉羽的麗芙羊體態輕盈，在湖岸邊悠哉漫步，特別喜歡清澈的水面，老是沉迷於水中倒影那優雅從容的模樣。",[376],[356,378],{"id":1122,"viewCount":59,"searchKey":1123,"visible":14},"10003410",{"type":10,"entryId":1124,"sortOrder":1125,"name":1126,"imageUrl":1127,"description":1128,"currentMorphology":9,"currentStage":120,"position":1129,"attributes":1130},"090",1062100,"吐泡章魚","/cdn/init/Wiki_Aniimo_10621.png","喜歡蒐集各種顏色的泡泡，氣囊裡的泡泡隨著身體動作起伏晃動，靈感一來，就會用繽紛的泡泡畫出奇妙的塗鴉。",[250],[378],{"id":1132,"viewCount":59,"searchKey":1133,"visible":14},"10003509",{"type":10,"entryId":1134,"sortOrder":1135,"name":1136,"imageUrl":1137,"description":1138,"currentMorphology":9,"currentStage":21,"position":1139,"attributes":1140},"091",1062300,"扭蛋章魚","/cdn/init/Wiki_Aniimo_10623.png","靈活的觸手可以刺激腦袋噴出不同的扭蛋泡泡，誰也不知道泡泡裡藏的是驚喜還是驚嚇。",[250],[378],{"id":1142,"viewCount":59,"searchKey":1143,"visible":14},"10003413",{"type":10,"entryId":1144,"sortOrder":1145,"name":1146,"imageUrl":1147,"description":1148,"currentMorphology":9,"currentStage":120,"position":1149,"attributes":1150},"092",1042100,"海神魔","/cdn/init/Wiki_Aniimo_10421.png","以開朗笑容偽裝自己並悄悄接近目標，一旦進入戰鬥便會顯露真面目，露出蓄勢待發的尖牙。",[250],[25],{"id":1152,"viewCount":59,"searchKey":1153,"visible":14},"10003407",{"type":10,"entryId":1154,"sortOrder":1155,"name":1156,"imageUrl":1157,"description":1158,"currentMorphology":9,"currentStage":21,"position":1159,"attributes":1160},"093",1042300,"魔海蝶","/cdn/init/Wiki_Aniimo_10423.png","柔軟身軀中藏著尖牙與利爪，最擅長以溫柔無害的模樣令其他生物掉以輕心，再隨手將其凍成冰雕。",[250],[25],{"id":1162,"viewCount":59,"searchKey":1163,"visible":14},"10003498",{"type":10,"entryId":1164,"sortOrder":1165,"name":1166,"imageUrl":1167,"description":1168,"currentMorphology":9,"currentStage":226,"position":1169,"attributes":1170},"9997",1037300,"朧月狐","/cdn/init/Wiki_Aniimo_10373.png","毛髮上流動著柔和月光，外表看似有些難以親近。總是理性冷靜地看待問題，但在面對熟悉之人時，也會露出親暱的神情。",[250],[1171],"attributes-holy",{"id":1173,"viewCount":59,"searchKey":1174,"visible":14},"10003375",{"type":10,"entryId":1175,"sortOrder":1176,"name":1177,"imageUrl":1178,"description":1179,"currentMorphology":9,"currentStage":226,"position":1180,"attributes":1181},"9998",1036100,"日耀獅","/cdn/init/Wiki_Aniimo_10361.png","熱情活潑且自信滿滿，勇於保護同伴。關鍵時刻能覺醒強大力量，爆發出驚人的戰力。",[250],[1171],[1183,1191,1196,1201,1206,1211,1216,1221,1225,1229,1234,1239,1244,1249,1254,1259,1264,1269,1272],{"id":1184,"parentId":1185,"tagType":1186,"tagKey":1187,"name":1188,"language":1189,"sort":1190},"026e4b93d02640d817320316c3e0ae25","1500","morphologyTypes","Mountain Woods Form","山林型態","zh-TW",6,{"id":1192,"parentId":1185,"tagType":1186,"tagKey":1193,"name":1194,"language":1189,"sort":1195},"169975e83c7c7cc9196859ca36b9ab26","Forest Form","森林型態",8,{"id":1197,"parentId":1185,"tagType":1186,"tagKey":1198,"name":1199,"language":1189,"sort":1200},"450da43bc6001e686491fef2c68f8615","Grassland Form","草原型態",16,{"id":1202,"parentId":1185,"tagType":1186,"tagKey":1203,"name":1204,"language":1189,"sort":1205},"48eb29eb0654bfdfc12604830648a909","Cloudmist Form","雲海型態",18,{"id":1207,"parentId":1185,"tagType":1186,"tagKey":1208,"name":1209,"language":1189,"sort":1210},"4961211f443a4bc9f68cef49da91d934","Bay Form","海灣型態",15,{"id":1212,"parentId":1185,"tagType":1186,"tagKey":1213,"na