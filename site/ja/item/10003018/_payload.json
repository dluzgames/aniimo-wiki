4,"props":210},"91268040_37",{"id":211,"customKey":46,"icon":212,"iconStyle":64,"iconTitle":46,"descTitle":213,"descContent":214,"source":215},"91268040_38","/cdn/init/1026100_Skill_10400290_Icon.png","雷弾","凝縮した雷雲の弾を投げてターゲットを攻撃する。自身が【雲霧ふよふよ】状態の場合、命中した後により広範囲の爆発を起こし、威力の250%のダメージを与える",{"attributes":216,"type":218,"consume":206,"power":207},[217],"4",[205],{"id":220,"type":144,"props":221},"91268040_39",{"id":222,"customKey":46,"icon":223,"iconStyle":64,"iconTitle":46,"descTitle":224,"descContent":225,"source":226},"91268040_40","/cdn/init/1026100_Skill_10900160_Icon.png","クラウドシールド","クラウドシールドを展開して自身を保護する。最大HP15%分のダメージを防ぎ、さらに体力消費-15%。20秒持続。【雲霧ふよふよ】状態の場合、シールド量が最大HPの18%までアップし、体力消費-18%。30秒持続",{"attributes":227,"type":228,"consume":230,"power":229},[203],[229],"0","20",{"id":232,"title":233,"children":234},"91268040_41","固有スキル",[235],{"id":236,"type":144,"props":237},"91268040_42",{"id":238,"customKey":46,"icon":239,"iconStyle":64,"iconTitle":46,"descTitle":240,"descContent":241,"source":242},"91268040_43","/cdn/init/1026100_Skill_14400000_Icon.png","攻撃","風元素能力を使用し、ターゲットを遠距離攻撃する",{"attributes":243,"type":244,"consume":229,"power":245},[203],[205],"6",[247,248,249,252],{"id":4,"entryId":12,"currentMorphology":9,"visible":15},{"id":6,"entryId":12,"currentMorphology":13,"visible":15},{"id":250,"entryId":12,"currentMorphology":251,"visible":15},"10003081","Cloudmist Form",{"id":253,"entryId":12,"currentMorphology":254,"visible":15},"10002999","Plateau Form",[256,268,278,289,301,311,321,331,341,351,361,372,382,394,404,415,424,428,437,446,456,466,476,487,497,507,517,527,537,547,557,567,577,587,597,607,617,628,638,648,658,668,678,688,698,708,718,728,738,748,758,768,778,788,798,808,818,828,838,848,858,868,878,888,898,908,918,928,938,948,958,968,978,988,998,1008,1018,1028,1038,1048,1058,1068,1078,1088,1098,1108,1118,1128,1138,1148,1158,1168,1178,1189],{"id":257,"viewCount":58,"searchKey":258,"visible":15},"10002992",{"type":10,"entryId":259,"sortOrder":260,"name":261,"imageUrl":262,"description":263,"currentMorphology":9,"currentStage":21,"position":264,"attributes":266},"001",1005100,"ワンタ","/cdn/init/Wiki_Aniimo_10051.png","活発で落ち着きがなく、いつもウルフィの後ろについていくのが好き。ふかふかの炭の毛の中にくすぶる火花が混ざっており、火花が集まって燃え上がると成長する。",[265],"position-dps",[267],"attributes-fire",{"id":269,"viewCount":58,"searchKey":270,"visible":15},"10003084",{"type":10,"entryId":271,"sortOrder":272,"name":273,"imageUrl":274,"description":275,"currentMorphology":9,"currentStage":205,"position":276,"attributes":277},"002",1005200,"ウルフィ","/cdn/init/Wiki_Aniimo_10052.png","常に群れで行動し、忠誠と団結を非常に重視している。冷静で集中した眼差しの下には、炎のように燃え盛る心がある。",[265],[267],{"id":279,"viewCount":58,"searchKey":280,"visible":15},"10002985",{"type":10,"entryId":281,"sortOrder":282,"name":283,"imageUrl":284,"description":285,"currentMorphology":9,"currentStage":286,"position":287,"attributes":288},"003",1005300,"ウルファイター","/cdn/init/Wiki_Aniimo_10053.png","負けず嫌いな性格で、相手が強敵であるほど血が騒ぐ。なぜなら、烈火とコークスが自身を強くした印を残すからだ。","3",[265],[267],{"id":290,"viewCount":58,"searchKey":291,"visible":15},"10002978",{"type":10,"entryId":292,"sortOrder":293,"name":294,"imageUrl":295,"description":296,"currentMorphology":9,"currentStage":286,"position":297,"attributes":299},"004",1005500,"ウルファントム","/cdn/init/Wiki_Aniimo_10055.png","強者に挑戦して敗れたウルフィが、同じく悔しさを抱えたまま倒れた仲間たちの魂を吸収し、復讐の欲望を原動力として行動している。",[298],"position-break",[267,300],"attributes-dark",{"id":302,"viewCount":58,"searchKey":303,"visible":15},"10003128",{"type":10,"entryId":304,"sortOrder":305,"name":306,"imageUrl":307,"description":308,"currentMorphology":9,"currentStage":21,"position":309,"attributes":310},"005",1001100,"ホシモモン","/cdn/init/Wiki_Aniimo_10011.png","とても食いしん坊。森の中を飛行して食べ物を探すとき、頭上の光る星がよく流れ星と間違えられる。食べ物をため込む習性があり、自分の巣を食べ物で飾ることもある。",[265],[300],{"id":312,"viewCount":58,"searchKey":313,"visible":15},"10002967",{"type":10,"entryId":314,"sortOrder":315,"name":316,"imageUrl":317,"description":318,"currentMorphology":9,"currentStage":286,"position":319,"attributes":320},"006",1001200,"ステラメイジ","/cdn/init/Wiki_Aniimo_10012.png","単独行動を好み、よく夜の闇の中を飛び回っている。星空のマントを羽織った神秘的な魔法使いのような姿をしている。メンタルエネルギーを使って瞬間移動できる。",[265],[300],{"id":322,"viewCount":58,"searchKey":323,"visible":15},"10003038",{"type":10,"entryId":324,"sortOrder":325,"name":326,"imageUrl":327,"description":328,"currentMorphology":9,"currentStage":21,"position":329,"attributes":330},"007",1018100,"フエカモメ","/cdn/init/Wiki_Aniimo_10181.png","常に低空を旋回し、砂浜の動向に気を配っている。群れて騒ぐのが好きで、口笛のような声を出してはやし立てる。",[23],[25],{"id":332,"viewCount":58,"searchKey":333,"visible":15},"10003098",{"type":10,"entryId":334,"sortOrder":335,"name":336,"imageUrl":337,"description":338,"currentMorphology":9,"currentStage":286,"position":339,"attributes":340},"008",1018400,"トロンボカモメ","/cdn/init/Wiki_Aniimo_10184.png","賑やかなことが好きで、リズミカルな音を出すことができる。内なる衝動を抑えきれず、よく仲間との合奏に加わる。",[23],[25],{"id":342,"viewCount":58,"searchKey":343,"visible":15},"10003024",{"type":10,"entryId":344,"sortOrder":345,"name":346,"imageUrl":347,"description":348,"currentMorphology":9,"currentStage":286,"position":349,"attributes":350},"009",1018500,"トランペカモメ","/cdn/init/Wiki_Aniimo_10185.png","甲高い声を出し、砂浜全体に響き渡らせることができる。目立ちたがり屋の彼らは、多少騒音を立てても気にしない。耳の健康のためには、怒らせない方が良い。",[265],[25],{"id":352,"viewCount":58,"searchKey":353,"visible":15},"10003017",{"type":10,"entryId":354,"sortOrder":355,"name":356,"imageUrl":357,"description":358,"currentMorphology":9,"currentStage":286,"position":359,"attributes":360},"010",1018700,"チューバカモメ","/cdn/init/Wiki_Aniimo_10187.png","低音のチューバのような音色を出すことができる。性格も音色と同じように重厚で落ち着いており、人懐っこい。海岸に嵐が来たとき、彼らのそばにいるといつも安全だ。",[298],[25],{"id":362,"viewCount":58,"searchKey":363,"visible":15},"10002942",{"type":10,"entryId":364,"sortOrder":365,"name":366,"imageUrl":367,"description":368,"currentMorphology":9,"currentStage":21,"position":369,"attributes":370},"011",1021100,"ヒラヒラン","/cdn/init/Wiki_Aniimo_10211.png","ヒラヒランの体は非常に軽く、よく風に乗って舞い上がり、花びらのスカートが作る空気抵抗を利用してゆっくりと回転しながら降下したり、風の向くままに旅をしたりする。",[265],[371],"attributes-grass",{"id":373,"viewCount":58,"searchKey":374,"visible":15},"10003060",{"type":10,"entryId":375,"sortOrder":376,"name":377,"imageUrl":378,"description":379,"currentMorphology":9,"currentStage":286,"position":380,"attributes":381},"012",1021200,"フラフラワー","/cdn/init/Wiki_Aniimo_10212.png","パフォーマンスに夢中。最大の目標ダンスの腕を磨き続けること。いつかすべての生物にダンスに宿る生命力を感じてもらいたいと願っている。",[265],[371],{"id":383,"viewCount":58,"searchKey":384,"visible":15},"10003027",{"type":10,"entryId":385,"sortOrder":386,"name":387,"imageUrl":388,"description":389,"currentMorphology":9,"currentStage":21,"position":390,"attributes":392},"014",1004100,"ハスイモリ","/cdn/init/Wiki_Aniimo_10041.png","水の中に隠れて、頭だけを出して新しいものを観察するのが好き。ハスの葉の帽子は良いカモフラージュだと思っているが、浮き沈みしながら移動するハスの葉はかえって目立つことに気づいていない。",[391],"position-heal",[393],"attributes-water",{"id":395,"viewCount":58,"searchKey":396,"visible":15},"10003119",{"type":10,"entryId":397,"sortOrder":398,"name":399,"imageUrl":400,"description":401,"currentMorphology":9,"currentStage":205,"position":402,"attributes":403},"015",1004200,"ワンパクイモリ","/cdn/init/Wiki_Aniimo_10042.png","高温を恐れ、涼しく湿った場所を好む。体表は冷却保湿膜で覆われており、触るととても冷たくて滑らかだ。長時間水から離れると皮膚がひび割れてしまう。",[391],[393],{"id":405,"viewCount":58,"searchKey":406,"visible":15},"10003020",{"type":10,"entryId":407,"sortOrder":408,"name":409,"imageUrl":410,"description":411,"currentMorphology":9,"currentStage":286,"position":412,"attributes":413},"016",1004300,"ロータウス","/cdn/init/Wiki_Aniimo_10043.png","外見も気品も非常に優雅な生物。天性は善良で、自分より弱い生物を自発的に世話する。しかし、これを利用して危害を加えようとする者は氷にされる。",[391],[393,414],"attributes-ice",{"id":5,"viewCount":58,"searchKey":416,"visible":15},{"type":10,"entryId":8,"sortOrder":417,"name":418,"imageUrl":419,"description":420,"currentMorphology":9,"currentStage":286,"position":421,"attributes":423},1004500,"ロータスドラゴン","/cdn/init/Wiki_Aniimo_10045.png","ハスの花と共生し、ハスの葉の間に生息している。擬態したハスの葉の先端で顔を隠す習慣があり、その控えめで上品な振る舞いを示している。",[422],"position-energy",[371,393],{"id":4,"viewCount":58,"searchKey":425,"visible":15},{"type":10,"entryId":12,"sortOrder":17,"name":18,"imageUrl":19,"description":20,"currentMorphology":9,"currentStage":21,"position":426,"attributes":427},[23],[25],{"id":429,"viewCount":58,"searchKey":430,"visible":15},"10002915",{"type":10,"entryId":431,"sortOrder":432,"name":88,"imageUrl":433,"description":434,"currentMorphology":9,"currentStage":286,"position":435,"attributes":436},"019",1026200,"/cdn/init/Wiki_Aniimo_10262.png","雲の中に隠れて寝るのが好き。風圧と静電気のせいで、ふかふかの羊毛には風に乗って飛んできたものがくっきやすう。",[23],[25],{"id":438,"viewCount":58,"searchKey":439,"visible":15},"10003011",{"type":10,"entryId":440,"sortOrder":441,"name":80,"imageUrl":442,"description":443,"currentMorphology":9,"currentStage":286,"position":444,"attributes":445},"020",1026300,"/cdn/init/Wiki_Aniimo_10263.png","夢のエネルギーを吸収した毛は、幻想的な色彩を呈している。この毛の塊を枕にしてぐっすり眠ると、甘い夢の世界に浸ることができる。",[23],[300],{"id":447,"viewCount":58,"searchKey":448,"visible":15},"10002971",{"type":10,"entryId":449,"sortOrder":450,"name":451,"imageUrl":452,"description":453,"currentMorphology":9,"currentStage":21,"position":454,"attributes":455},"021",1020100,"オンチソウ","/cdn/init/Wiki_Aniimo_10201.png","群れをなして草原に生息し、普段は土の中に潜って養分を吸収している。集まって歌うのが好きだが、自分が音痴であることにはまったく気づいていない。",[298],[371],{"id":457,"viewCount":58,"searchKey":458,"visible":15},"10002964",{"type":10,"entryId":459,"sortOrder":460,"name":461,"imageUrl":462,"description":463,"currentMorphology":9,"currentStage":286,"position":464,"attributes":465},"022",1020300,"マジョソウ","/cdn/init/Wiki_Aniimo_10203.png","自分の縄張りに侵入する生物を嫌い、奇妙な音波を発して相手の精神を乱す。これによって防御力を低下させ、気絶させることすらある。",[422],[300,371],{"id":467,"viewCount":58,"searchKey":468,"visible":15},"10002954",{"type":10,"entryId":469,"sortOrder":470,"name":471,"imageUrl":472,"description":473,"currentMorphology":9,"currentStage":286,"position":474,"attributes":475},"023",1020700,"ウドー","/cdn/init/Wiki_Aniimo_10207.png","かつて長い間地中に埋まっていたため、日の目を見た時にはすでに巨大化していた。根から土壌の養分を吸収して活力を維持する必要があるため、土地から離れることを非常に嫌がる。",[298],[371],{"id":477,"viewCount":58,"searchKey":478,"visible":15},"10003117",{"type":10,"entryId":479,"sortOrder":480,"name":481,"imageUrl":482,"description":483,"currentMorphology":9,"currentStage":21,"position":484,"attributes":485},"024",1016100,"ハナメガニ","/cdn/init/Wiki_Aniimo_10161.png","生涯でたった1人の伴侶しか選ばず、愛情に非常に一途で、常につがいで活動する。頭頂部のカニクサはその幸福の度合いを表している。",[298],[486,371],"attributes-rock",{"id":488,"viewCount":58,"searchKey":489,"visible":15},"10003012",{"type":10,"entryId":490,"sortOrder":491,"name":492,"imageUrl":493,"description":494,"currentMorphology":9,"currentStage":286,"position":495,"attributes":496},"025",1016200,"アオクサガニ","/cdn/init/Wiki_Aniimo_10162.png","生い茂る植物が背中の殻を完全に覆い、日光を吸収して養分を提供する。日光が十分であれば、追加で食事をしなくても生きていける。",[298],[486,371],{"id":498,"viewCount":58,"searchKey":499,"visible":15},"10003101",{"type":10,"entryId":500,"sortOrder":501,"name":502,"imageUrl":503,"description":504,"currentMorphology":9,"currentStage":286,"position":505,"attributes":506},"026",1016300,"コウラガニ","/cdn/init/Wiki_Aniimo_10163.png","洞窟にひっそりと生息している。食べ物にミネラルが豊富に含まれているため、背中の殻は徐々に結晶で覆われていった。普段は地下に身を潜め、美しい背中の殻で獲物をおびき寄せる。",[298],[414],{"id":508,"viewCount":58,"searchKey":509,"visible":15},"10002959",{"type":10,"entryId":510,"sortOrder":511,"name":512,"imageUrl":513,"description":514,"currentMorphology":9,"currentStage":21,"position":515,"attributes":516},"027",1033100,"オニビィ","/cdn/init/Wiki_Aniimo_10331.png","外見は炎のようだが、それはエネルギーの流れる形に過ぎず、実際には熱を発しないどころか、周囲の熱を吸収する。時々これを利用してボンファイヤーに姿を変え、他人をからかう。",[422],[267],{"id":518,"viewCount":58,"searchKey":519,"visible":15},"10003057",{"type":10,"entryId":520,"sortOrder":521,"name":522,"imageUrl":523,"description":524,"currentMorphology":9,"currentStage":286,"position":525,"attributes":526},"028",1033300,"ホムラン","/cdn/init/Wiki_Aniimo_10333.png","夜にしか姿を現さない。体は気体のエネルギーで構成されているため、自由に分裂したり、分身を作ったりすることまでできる。",[422],[267],{"id":528,"viewCount":58,"searchKey":529,"visible":15},"10003092",{"type":10,"entryId":530,"sortOrder":531,"name":532,"imageUrl":533,"description":534,"currentMorphology":9,"currentStage":21,"position":535,"attributes":536},"029",1023100,"ウスバチョウ","/cdn/init/Wiki_Aniimo_10231.png","臆病で警戒心が強く、危険を感じるとすぐに隠れ場所を探すが、振り落とされる蛍光色の鱗粉のせいでいつも居場所がバレてしまう。",[391],[25],{"id":538,"viewCount":58,"searchKey":539,"visible":15},"10002990",{"type":10,"entryId":540,"sortOrder":541,"name":542,"imageUrl":543,"description":544,"currentMorphology":9,"currentStage":286,"position":545,"attributes":546},"030",1023200,"マボロシアゲハ","/cdn/init/Wiki_Aniimo_10232.png","性格は冷淡で単独行動を好む。危険が迫っていることに気づくと、羽ばたいて鱗粉を吹き出し、幻覚を作り出して相手を惑わし、自分はゆっくりと立ち去る。",[391],[25],{"id":548,"viewCount":58,"searchKey":549,"visible":15},"10003113",{"type":10,"entryId":550,"sortOrder":551,"name":552,"imageUrl":553,"description":554,"currentMorphology":9,"currentStage":229,"position":555,"attributes":556},"031",1023300,"ユメアゲハ","/cdn/init/Wiki_Aniimo_10233.png","蝶の羽は色鮮やかな輝きを放ち、羽ばたくときに降り注ぐ鱗粉は花々の成長を促す。そのため、彼らが訪れる場所はいつも生命力に満ち溢れている。",[422],[25,371],{"id":558,"viewCount":58,"searchKey":559,"visible":15},"10002918",{"type":10,"entryId":560,"sortOrder":561,"name":562,"imageUrl":563,"description":564,"currentMorphology":9,"currentStage":21,"position":565,"attributes":566},"032",1044100,"ウサバット","/cdn/init/Wiki_Aniimo_10441.png","大きな耳が高くそびえ、音に非常に敏感。自分が気になった音であれば、どんなに遠くても聞き逃さない。",[23],[25],{"id":568,"viewCount":58,"searchKey":569,"visible":15},"10002913",{"type":10,"entryId":570,"sortOrder":571,"name":572,"imageUrl":573,"description":574,"currentMorphology":9,"currentStage":286,"position":575,"attributes":576},"033",1044300,"タンテイバット","/cdn/init/Wiki_Aniimo_10443.png","好奇心旺盛で、痕跡を探索したりターゲットを追跡したりするのに熱中している。尾のリングは超音波を増幅させることができ、ステルストリックを簡単に見破る。",[23],[25],{"id":578,"viewCount":58,"searchKey":579,"visible":15},"10003065",{"type":10,"entryId":580,"sortOrder":581,"name":582,"imageUrl":583,"description":584,"currentMorphology":9,"currentStage":21,"position":585,"attributes":586},"034",1032100,"ナキツボミン","/cdn/init/Wiki_Aniimo_10321.png","臆病で痛がりで、すぐに涙を流すが、追い詰められるとトゲを振り回して反抗する。本当に勇敢になれたとき、頭頂部のつぼみが開く。",[265],[371],{"id":588,"viewCount":58,"searchKey":589,"visible":15},"10003046",{"type":10,"entryId":590,"sortOrder":591,"name":592,"imageUrl":593,"description":594,"currentMorphology":9,"currentStage":286,"position":595,"attributes":596},"035",1032300,"トゲイバラ","/cdn/init/Wiki_Aniimo_10323.png","トゲの茎でできた剣は普段は腕の葉に収められており、戦闘時にのみ引き抜かれる。恐れを知らず、挑戦を恐れず、群れを献身的に守っている。",[265],[371],{"id":598,"viewCount":58,"searchKey":599,"visible":15},"10002928",{"type":10,"entryId":600,"sortOrder":601,"name":602,"imageUrl":603,"description":604,"currentMorphology":9,"currentStage":286,"position":605,"attributes":606},"036",1032400,"メリーメリー","/cdn/init/Wiki_Aniimo_10324.png","争いを静めるために芳しい花びらを撒き散らす。花びらに触れた相手に幸福感を抱かせ、戦意を消失させる。",[23],[371],{"id":608,"viewCount":58,"searchKey":609,"visible":15},"10003006",{"type":10,"entryId":610,"sortOrder":611,"name":612,"imageUrl":613,"description":614,"currentMorphology":9,"currentStage":21,"position":615,"attributes":616},"037",1047100,"チアトカゲ","/cdn/init/Wiki_Aniimo_10471.png","休む時は殻に閉じこもり、時々アニモのタマゴと間違えられる。戦うのは怖いが賑やかなのは好きで、草のボールを振って踊りながら応援するのが好き。",[298],[371],{"id":618,"viewCount":58,"searchKey":619,"visible":15},"10002924",{"type":10,"entryId":620,"sortOrder":621,"name":622,"imageUrl":623,"description":624,"currentMorphology":9,"currentStage":286,"position":625,"attributes":626},"038",1047400,"ブレイクトカゲ","/cdn/init/Wiki_Aniimo_10474.png","手足の動きが機敏で、誰にでも華麗なキック技を自慢したがる。脱ぎ捨てた皮をフードのように頭に被るのが好き。",[23],[627],"attributes-electric",{"id":629,"viewCount":58,"searchKey":630,"visible":15},"10002993",{"type":10,"entryId":631,"sortOrder":632,"name":633,"imageUrl":634,"description":635,"currentMorphology":9,"currentStage":286,"position":636,"attributes":637},"039",1047500,"シャウトカゲ","/cdn/init/Wiki_Aniimo_10475.png","高くそびえるたてがみは奔放さを極め、野性的な咆哮は本性を見せつける。尾の構造は音波を吸収し、相手にぶつかるときにソニックブーム攻撃を放つ。",[298],[371],{"id":639,"viewCount":58,"searchKey":640,"visible":15},"10003053",{"type":10,"entryId":641,"sortOrder":642,"name":643,"imageUrl":644,"description":645,"currentMorphology":9,"currentStage":21,"position":646,"attributes":647},"040",1035100,"ミツドリ","/cdn/init/Wiki_Aniimo_10351.png","採集した花の蜜を体内に蓄えて発酵させる。吐き出したものは香水の原料となり、調香師たちにとって欠かせないパートナーである。",[23],[300],{"id":649,"viewCount":58,"searchKey":650,"visible":15},"10003071",{"type":10,"entryId":651,"sortOrder":652,"name":653,"imageUrl":654,"description":655,"currentMorphology":9,"currentStage":286,"position":656,"attributes":657},"041",1035200,"アロマドリ","/cdn/init/Wiki_Aniimo_10352.png","匂いには非常にうるさく、さまざまな花の蜜を食べて体内に蓄え、独自の香水の原料を調合する。全身の羽には独特の香りが染み込んでいる。",[23],[300],{"id":659,"viewCount":58,"searchKey":660,"visible":15},"10003058",{"type":10,"entryId":661,"sortOrder":662,"name":663,"imageUrl":664,"description":665,"currentMorphology":9,"currentStage":21,"position":666,"attributes":667},"042",1003100,"ツメカマキリ","/cdn/init/Wiki_Aniimo_10031.png","仲間に打ち勝ってこそ進化できる。いつでも現れるかわからない相手に対処するため、暇さえあれば手頃な大きさの石を探して爪を研ぎ、鋭さを保っている。",[265],[300],{"id":669,"viewCount":58,"searchKey":670,"visible":15},"10002919",{"type":10,"entryId":671,"sortOrder":672,"name":673,"imageUrl":674,"description":675,"currentMorphology":9,"currentStage":286,"position":676,"attributes":677},"043",1003200,"ヤイバカマキリ","/cdn/init/Wiki_Aniimo_10032.png","鋭い刃を研ぎ、チャンスを待ち、暗がりの中で姿を隠して相手を翻弄する。一撃必殺を追求する冷酷なアサシン。",[265],[300],{"id":679,"viewCount":58,"searchKey":680,"visible":15},"10003051",{"type":10,"entryId":681,"sortOrder":682,"name":683,"imageUrl":684,"description":685,"currentMorphology":9,"currentStage":286,"position":686,"attributes":687},"044",1003300,"デンキカマキリ","/cdn/init/Wiki_Aniimo_10033.png","前脚が折れたツメカマキリが雷電の力を吸収して進化した。再形成された逆刃は非常に鋭く、まばゆい電光を放っている。",[265],[627],{"id":689,"viewCount":58,"searchKey":690,"visible":15},"10002972",{"type":10,"entryId":691,"sortOrder":692,"name":693,"imageUrl":694,"description":695,"currentMorphology":9,"currentStage":21,"position":696,"attributes":697},"045",1013100,"ボーンスキー","/cdn/init/Wiki_Aniimo_10131.png","大きな耳を持つ元気な狼の子。胸にある氷の骨のチョウネクタイがお気に入りの玩具。距離感のないワンタが嫌い。",[265],[414],{"id":699,"viewCount":58,"searchKey":700,"visible":15},"10003125",{"type":10,"entryId":701,"sortOrder":702,"name":703,"imageUrl":704,"description":705,"currentMorphology":9,"currentStage":205,"position":706,"attributes":707},"046",1013200,"フェンリル","/cdn/init/Wiki_Aniimo_10132.png","闘志を失うのを恐れて撫でられるのを嫌がる。群れについて狩りをする時はいつも氷の刃をくわえて先頭に立ち、一人前の戦士になることを渇望している。",[265],[414],{"id":709,"viewCount":58,"searchKey":710,"visible":15},"10002965",{"type":10,"entryId":711,"sortOrder":712,"name":713,"imageUrl":714,"description":715,"currentMorphology":9,"currentStage":286,"position":716,"attributes":717},"047",1013300,"グレイシャー","/cdn/init/Wiki_Aniimo_10133.png","自分の実力に絶対的な自信を持つ高慢な戦士。口にくわえた氷の刃からは刺すような冷気が漂い、強大な敵を相手にした時にしか興奮しない。",[265],[414],{"id":719,"viewCount":58,"searchKey":720,"visible":15},"10003074",{"type":10,"entryId":721,"sortOrder":722,"name":723,"imageUrl":724,"description":725,"currentMorphology":9,"currentStage":21,"position":726,"attributes":727},"048",1022100,"イナズマミンク","/cdn/init/Wiki_Aniimo_10221.png","森の中に生息し、攻撃する時は尻尾から金色の電光とパチパチと音を立てる電流を放つ。動きが素早く機敏で、捕まえるのは難しい。",[298],[627],{"id":729,"viewCount":58,"searchKey":730,"visible":15},"10003025",{"type":10,"entryId":731,"sortOrder":732,"name":733,"imageUrl":734,"description":735,"currentMorphology":9,"currentStage":286,"position":736,"attributes":737},"049",1022200,"ボルトミンク","/cdn/init/Wiki_Aniimo_10222.png","特殊な毛から発生する静電気で空気中の荷電粒子を引き寄せ、電気を蓄える。水に濡れると毛の蓄電能力に影響するため、雨の日はめったに現れない。",[298],[627],{"id":739,"viewCount":58,"searchKey":740,"visible":15},"10003073",{"type":10,"entryId":741,"sortOrder":742,"name":743,"imageUrl":744,"description":745,"currentMorphology":9,"currentStage":21,"position":746,"attributes":747},"050",1017100,"シュシュタ","/cdn/init/Wiki_Aniimo_10171.png","求愛のための贈り物を探してあちこち掘り返すが、恥ずかしがり屋のため告白に失敗することが多い。2本の小さな手で頬をこするのがシンボル的な動作。",[298],[393],{"id":749,"viewCount":58,"searchKey":750,"visible":15},"10002948",{"type":10,"entryId":751,"sortOrder":752,"name":753,"imageUrl":754,"description":755,"currentMorphology":9,"currentStage":205,"position":756,"attributes":757},"051",1017200,"ポポタ","/cdn/init/Wiki_Aniimo_10172.png","丁寧に貝殻を選び、体格に合った新しいスコップを作る。ときめく相手に出会うと、ピンク色の泡が出るという噂がある。",[298],[393],{"id":759,"viewCount":58,"searchKey":760,"visible":15},"10003066",{"type":10,"entryId":761,"sortOrder":762,"name":763,"imageUrl":764,"description":765,"currentMorphology":9,"currentStage":286,"position":766,"attributes":767},"052",1017300,"ピョピョタ","/cdn/init/Wiki_Aniimo_10173.png","少しナルシストで、毎日多くの時間をかけて毛繕いをする。水から上がる姿勢を緻密に計算し、注目される感覚を楽しむ。発達した筋肉は、毛が濃すぎて見せびらかすことができない。",[23],[393],{"id":769,"viewCount":58,"searchKey":770,"visible":15},"10003116",{"type":10,"entryId":771,"sortOrder":772,"name":773,"imageUrl":774,"description":775,"currentMorphology":9,"currentStage":286,"position":776,"attributes":777},"053",1017400,"パンパンタ","/cdn/init/Wiki_Aniimo_10174.png","強靭な体から驚異的な力を爆発させることができるが、武力を誇示するよりも巣に引きこもり、アクセサリーを集めて巣を飾ることを好む。",[298],[393],{"id":779,"viewCount":58,"searchKey":780,"visible":15},"10003003",{"type":10,"entryId":781,"sortOrder":782,"name":783,"imageUrl":784,"description":785,"currentMorphology":9,"currentStage":21,"position":786,"attributes":787},"054",1019100,"カイガラヒトデ","/cdn/init/Wiki_Aniimo_10191.png","柔らかい触腕で貝殻に吸い付き自分を包み込み、砂浜の普通の貝殻の山に紛れ込んでいる。普段は貝殻を固く閉じているが、夜になると貝殻を開いて月明かりを浴びる。",[265],[393],{"id":789,"viewCount":58,"searchKey":790,"visible":15},"10003127",{"type":10,"entryId":791,"sortOrder":792,"name":793,"imageUrl":794,"description":795,"currentMorphology":9,"currentStage":205,"position":796,"attributes":797},"055",1019200,"シェルドン","/cdn/init/Wiki_Aniimo_10192.png","星空に憧れ、よく背中の殻の上で寝転がり体を揺らしながら、目を閉じて星々が織りなす夢の世界に浸っている。",[265],[393],{"id":799,"viewCount":58,"searchKey":800,"visible":15},"10003120",{"type":10,"entryId":801,"sortOrder":802,"name":803,"imageUrl":804,"description":805,"currentMorphology":9,"currentStage":286,"position":806,"attributes":807},"056",1019400,"ステラナイト","/cdn/init/Wiki_Aniimo_10194.png","かつて自分を包んでいた貝殻を剣と盾に変え、か弱いシェリーが危険に遭遇すると身を挺して守る。海岸線に沿って波を追いかけるのが好き。",[265],[393],{"id":809,"viewCount":58,"searchKey":810,"visible":15},"10003115",{"type":10,"entryId":811,"sortOrder":812,"name":813,"imageUrl":814,"description":815,"currentMorphology":9,"currentStage":21,"position":816,"attributes":817},"057",1045100,"タマコロン","/cdn/init/Wiki_Aniimo_10451.png","生まれた時から石の玉と片時も離れず、転がし続けることでボールはどんどん丸くなっていく。しかし、彼が押している石の玉は見た目ほど単純なものではなさそうだ。",[265],[486],{"id":819,"viewCount":58,"searchKey":820,"visible":15},"10003026",{"type":10,"entryId":821,"sortOrder":822,"name":823,"imageUrl":824,"description":825,"currentMorphology":9,"currentStage":286,"position":826,"attributes":827},"058",1045300,"タマローラー","/cdn/init/Wiki_Aniimo_10453.png","以前と同じように逆走している。玉を転がす技術を完全にマスターしたため、さまざまな高難易度のアクションでターゲットを攻撃できる。",[265],[486],{"id":829,"viewCount":58,"searchKey":830,"visible":15},"10003016",{"type":10,"entryId":831,"sortOrder":832,"name":833,"imageUrl":834,"description":835,"currentMorphology":9,"currentStage":286,"position":836,"attributes":837},"059",1045400,"ロックン","/cdn/init/Wiki_Aniimo_10454.png","タマコロンと朝から晩まで一緒にいる石の玉は、揺れによって目覚めた。自分の思い通りにならない体に嫌気がさし、虫の体を飲み込んだ後、ついに自らの意志で動けるようになった。",[23],[486],{"id":839,"viewCount":58,"searchKey":840,"visible":15},"10002929",{"type":10,"entryId":841,"sortOrder":842,"name":843,"imageUrl":844,"description":845,"currentMorphology":9,"currentStage":21,"position":846,"attributes":847},"060",1029100,"パピッピ","/cdn/init/Wiki_Aniimo_10291.png","いつもお決まりの笑顔を浮かべ、他のアニモを遊びに誘う。時々いたずらや食いしん坊が原因でトラブルを起こすこともあるが、いつも許してもらえる。",[265],[627],{"id":849,"viewCount":58,"searchKey":850,"visible":15},"10002926",{"type":10,"entryId":851,"sortOrder":852,"name":853,"imageUrl":854,"description":855,"currentMorphology":9,"currentStage":286,"position":856,"attributes":857},"061",1029300,"パビリビリ","/cdn/init/Wiki_Aniimo_10293.png","毛の優れた導電性を生かし、雷の力を凝集して両翼を伸ばす。疾走して暗いムードを吹き飛ばし、気分も一緒に晴れやかにする。",[265],[627],{"id":859,"viewCount":58,"searchKey":860,"visible":15},"10003093",{"type":10,"entryId":861,"sortOrder":862,"name":863,"imageUrl":864,"description":865,"currentMorphology":9,"currentStage":21,"position":866,"attributes":867},"062",1002100,"モノアイメット","/cdn/init/Wiki_Aniimo_10021.png","硬いヘルメットで柔らかい体を守り、口からかぎ爪のようなものを伸ばして獲物を捕食する。弾力性のある体には、自身の体積の10倍の食べ物を詰め込むことができる。",[298],[300],{"id":869,"viewCount":58,"searchKey":870,"visible":15},"10003107",{"type":10,"entryId":871,"sortOrder":872,"name":873,"imageUrl":874,"description":875,"currentMorphology":9,"currentStage":286,"position":876,"attributes":877},"063",1002600,"メットユウシ","/cdn/init/Wiki_Aniimo_10026.png","折れた剣と鎧を手に入れ、勇気と力を受け継いだ。そしてついに、仲間を守り強敵に立ち向かう勇士となった。",[265],[300],{"id":879,"viewCount":58,"searchKey":880,"visible":15},"10003072",{"type":10,"entryId":881,"sortOrder":882,"name":883,"imageUrl":884,"description":885,"currentMorphology":9,"currentStage":286,"position":886,"attributes":887},"064",1002700,"メットガード","/cdn/init/Wiki_Aniimo_10027.png","大柄だが臆病で温厚。常に戦闘を避け、危険に遭遇すると丸くなるが、仲間を守るためには勇気を振り絞って戦うこともある。",[298],[300],{"id":889,"viewCount":58,"searchKey":890,"visible":15},"10003129",{"type":10,"entryId":891,"sortOrder":892,"name":893,"imageUrl":894,"description":895,"currentMorphology":9,"currentStage":21,"position":896,"attributes":897},"065",1002400,"メタルジョー","/cdn/init/Wiki_Aniimo_10024.png","通りすがりのものは何でも噛みたがる。あごの可動性が高いため、開く角度が非常に大きい。軽く噛むことで愛情や喜びを表現し、噛んでも壊れにくい金属製品を特に好む。",[298],[25],{"id":899,"viewCount":58,"searchKey":900,"visible":15},"10002939",{"type":10,"entryId":901,"sortOrder":902,"name":903,"imageUrl":904,"description":905,"currentMorphology":9,"currentStage":205,"position":906,"attributes":907},"066",1002200,"メットゴン","/cdn/init/Wiki_Aniimo_10022.png","ヘルメットの下に脆さを隠す幼いドラゴン。より強くなり、自由に空を飛び回り、世界の隅々まで隠された宝物を探しに行きたいと渇望している。",[298],[25],{"id":909,"viewCount":58,"searchKey":910,"visible":15},"10003086",{"type":10,"entryId":911,"sortOrder":912,"name":913,"imageUrl":914,"description":915,"currentMorphology":9,"currentStage":286,"position":916,"attributes":917},"067",1002300,"ヘルゴン","/cdn/init/Wiki_Aniimo_10023.png","全身が硬い鎧で覆われている。石の台に留まっている姿は、まるで巨大な彫像のようだ。遺跡の入口にしゃがみ込み、古の宝を守っていると言われている。",[298],[25],{"id":919,"viewCount":58,"searchKey":920,"visible":15},"10003079",{"type":10,"entryId":921,"sortOrder":922,"name":923,"imageUrl":924,"description":925,"currentMorphology":9,"currentStage":286,"position":926,"attributes":927},"068",1002500,"インフェルゴン","/cdn/init/Wiki_Aniimo_10025.png","烈火で鍛えられた金属の鎧を身にまとう。激怒した際に噴き出す炎は、周囲を溶岩に変えてしまう。灰になりたくなければ、できるだけ近づかないことだ。",[265],[267],{"id":929,"viewCount":58,"searchKey":930,"visible":15},"10002983",{"type":10,"entryId":931,"sortOrder":932,"name":933,"imageUrl":934,"description":935,"currentMorphology":9,"currentStage":21,"position":936,"attributes":937},"069",1050100,"ユメミグマ","/cdn/init/Wiki_Aniimo_10501.png","日中は夢遊状態で活動し、起こされた瞬間に暴れて手がつけられなくなるが、力を使い果たすとまた大人しく夢の世界に落ちる。",[265],[486],{"id":939,"viewCount":58,"searchKey":940,"visible":15},"10002977",{"type":10,"entryId":941,"sortOrder":942,"name":943,"imageUrl":944,"description":945,"currentMorphology":9,"currentStage":286,"position":946,"attributes":947},"070",1050300,"ヒスクマ","/cdn/init/Wiki_Aniimo_10503.png","普段の優しさの裏には、常に忍耐と自制心がある。しかし、刺激を受けたりお腹が空いたりすると手がつけられなくなり、狂暴状態に陥る。",[265],[486],{"id":949,"viewCount":58,"searchKey":950,"visible":15},"10002955",{"type":10,"entryId":951,"sortOrder":952,"name":953,"imageUrl":954,"description":955,"currentMorphology":9,"currentStage":21,"position":956,"attributes":957},"071",1028100,"イワノコ","/cdn/init/Wiki_Aniimo_10281.png","生まれつき鉱石を探知する能力を持ち、さまざまな鉱石を食べるのが好き。食べた鉱石の種類によって自身の成長が変化する。",[298],[486],{"id":959,"viewCount":58,"searchKey":960,"visible":15},"10003075",{"type":10,"entryId":961,"sortOrder":962,"name":963,"imageUrl":964,"description":965,"currentMorphology":9,"currentStage":205,"position":966,"attributes":967},"072",1028200,"ラヴァサウルス","/cdn/init/Wiki_Aniimo_10282.png","硬い爪で晶石を砕いて食べ、熱量を蓄える。そのため、体表には真っ赤な模様が浮かび上がっている。小柄な体型だが、口から高熱の炎を出し続けることができる。",[298],[267,486],{"id":969,"viewCount":58,"searchKey":970,"visible":15},"10002949",{"type":10,"entryId":971,"sortOrder":972,"name":973,"imageUrl":974,"description":975,"currentMorphology":9,"currentStage":286,"position":976,"attributes":977},"073",1028300,"マグマレックス","/cdn/init/Wiki_Aniimo_10283.png","凝結した溶岩のような灼熱の結晶が体に生えている。その中に蓄えられた熱量が爆発すれば、目の前に立ちはだかるすべてを溶かすことができる。",[298],[267,486],{"id":979,"viewCount":58,"searchKey":980,"visible":15},"10003068",{"type":10,"entryId":981,"sortOrder":982,"name":983,"imageUrl":984,"description":985,"currentMorphology":9,"currentStage":205,"position":986,"attributes":987},"074",1028400,"ジオードン","/cdn/init/Wiki_Aniimo_10284.png","食べた晶石は体内で精製された後、純粋なエネルギーを秘めた結晶の背骨となって生えてくる。",[298],[486],{"id":989,"viewCount":58,"searchKey":990,"visible":15},"10002943",{"type":10,"entryId":991,"sortOrder":992,"name":993,"imageUrl":994,"description":995,"currentMorphology":9,"currentStage":286,"position":996,"attributes":997},"075",1028500,"スパインサウルス","/cdn/init/Wiki_Aniimo_10285.png","晶石が豊富な場所に生息している。背中の結晶の背骨は非常に硬く、体を保護するだけでなく、エネルギーを貯蔵するための重要な構造でもある。",[298],[486],{"id":999,"viewCount":58,"searchKey":1000,"visible":15},"10002936",{"type":10,"entryId":1001,"sortOrder":1002,"name":1003,"imageUrl":1004,"description":1005,"currentMorphology":9,"currentStage":21,"position":1006,"attributes":1007},"076",1043100,"エントツアリ","/cdn/init/Wiki_Aniimo_10431.png","エントツアリは泥で少しずつ自分の外殻を築く。危険に遭遇すると、頭の上の穴から煙を噴き出して周囲を覆い、身を隠す。",[23],[486],{"id":1009,"viewCount":58,"searchKey":1010,"visible":15},"10002997",{"type":10,"entryId":1011,"sortOrder":1012,"name":1013,"imageUrl":1014,"description":1015,"currentMorphology":9,"currentStage":286,"position":1016,"attributes":1017},"077",1043300,"オシロアリ","/cdn/init/Wiki_Aniimo_10433.png","上下の体が独立して回転できる構造により、オシロアリは柔軟に周囲を観察し、隙を見て砲台に変身して相手を撃退することができる。",[23],[486],{"id":1019,"viewCount":58,"searchKey":1020,"visible":15},"10003047",{"type":10,"entryId":1021,"sortOrder":1022,"name":1023,"imageUrl":1024,"description":1025,"currentMorphology":9,"currentStage":21,"position":1026,"attributes":1027},"078",1014100,"ランプクラゲ","/cdn/init/Wiki_Aniimo_10141.png","非常に臆病で、少しでも風の音や草のそよぎを感じるとすぐに逃げ出す。頭頂部の電球のような器官は健康状態によって変化する。",[23],[627],{"id":1029,"viewCount":58,"searchKey":1030,"visible":15},"10003029",{"type":10,"entryId":1031,"sortOrder":1032,"name":1033,"imageUrl":1034,"description":1035,"currentMorphology":9,"currentStage":205,"position":1036,"attributes":1037},"079",1014200,"アカリクラゲ","/cdn/init/Wiki_Aniimo_10142.png","暗闇を恐れるクラゲ。夜が訪れると光り始め、眠っても消えることはなく、まるで夜を守る明かりのようだ。",[23],[627],{"id":1039,"viewCount":58,"searchKey":1040,"visible":15},"10002938",{"type":10,"entryId":1041,"sortOrder":1042,"name":1043,"imageUrl":1044,"description":1045,"currentMorphology":9,"currentStage":286,"position":1046,"attributes":1047},"080",1014300,"シャンデリアクラゲ","/cdn/init/Wiki_Aniimo_10143.png","気分によって、発光の明るさと頻度を自由自在に調節できる。触手は美しく独特な光を放つだけでなく、電流を流してターゲットを攻撃することもできる。",[23],[627],{"id":1049,"viewCount":58,"searchKey":1050,"visible":15},"10002979",{"type":10,"entryId":1051,"sortOrder":1052,"name":1053,"imageUrl":1054,"description":1055,"currentMorphology":9,"currentStage":21,"position":1056,"attributes":1057},"081",1048100,"アワアワドリ","/cdn/init/Wiki_Aniimo_10481.png","体の表面の油をこすり合わせると大量の泡が発生し、体をきれいにしたり身を守ったりできるが、時々泡を踏んで滑って転ぶこともある。",[422],[393],{"id":1059,"viewCount":58,"searchKey":1060,"visible":15},"10002980",{"type":10,"entryId":1061,"sortOrder":1062,"name":1063,"imageUrl":1064,"description":1065,"currentMorphology":9,"currentStage":286,"position":1066,"attributes":1067},"082",1048300,"モクヨクドリ","/cdn/init/Wiki_Aniimo_10483.png","羽から絶えず油が分泌され、少しこするだけでさまざまな泡が生まれる。背中のヒナを守るために使われるのは、当然最も柔らかくきめ細かい泡だ。",[422],[393],{"id":1069,"viewCount":58,"searchKey":1070,"visible":15},"10003099",{"type":10,"entryId":1071,"sortOrder":1072,"name":1073,"imageUrl":1074,"description":1075,"currentMorphology":9,"currentStage":229,"position":1076,"attributes":1077},"083",1012200,"ベーシス","/cdn/init/Wiki_Aniimo_10122.png","心音のドラムビートに悩まされるベーシスは、ドラムビートをかき消すリズムを常に探している。音楽に合わせて体を揺らすのが好きで、前衛的な音楽芸術を愛している。",[422],[627],{"id":1079,"viewCount":58,"searchKey":1080,"visible":15},"10003044",{"type":10,"entryId":1081,"sortOrder":1082,"name":1083,"imageUrl":1084,"description":1085,"currentMorphology":9,"currentStage":21,"position":1086,"attributes":1087},"084",1038100,"サンゴウオ","/cdn/init/Wiki_Aniimo_10381.png","体を地中に埋め、サンゴに姿を変え、獲物が近づくと噛みつく。しかし時々、我慢できずに目を出して辺りを見回すこともある。",[422],[486,393],{"id":1089,"viewCount":58,"searchKey":1090,"visible":15},"10003036",{"type":10,"entryId":1091,"sortOrder":1092,"name":1093,"imageUrl":1094,"description":1095,"currentMorphology":9,"currentStage":286,"position":1096,"attributes":1097},"085",1038300,"サンゴリュウ","/cdn/init/Wiki_Aniimo_10383.png","体を砂の中に埋め、サンゴ礁に擬態するのが好き。頭部と背部のサンゴの夜光を利用して生物をおびき寄せ、奇襲の機会をうかがう。",[422],[486,393],{"id":1099,"viewCount":58,"searchKey":1100,"visible":15},"10003080",{"type":10,"entryId":1101,"sortOrder":1102,"name":1103,"imageUrl":1104,"description":1105,"currentMorphology":9,"currentStage":21,"position":1106,"attributes":1107},"086",1046100,"ウミボウズ","/cdn/init/Wiki_Aniimo_10461.png","頬の丸い模様はよく目と間違えられる。海岸に群れで現れるのが好きで、仲間と一緒にいると安心する。",[298],[414],{"id":1109,"viewCount":58,"searchKey":1110,"visible":15},"10003007",{"type":10,"entryId":1111,"sortOrder":1112,"name":1113,"imageUrl":1114,"description":1115,"currentMorphology":9,"currentStage":286,"position":1116,"attributes":1117},"087",1046300,"ナミセイウチ","/cdn/init/Wiki_Aniimo_10463.png","四肢を使って陸地を移動する時は少し不器用だが、お腹で滑るのがとても得意。同性間の縄張り意識が強く、一度怒ると荒波のような威圧感を放つ。",[298],[414],{"id":1119,"viewCount":58,"searchKey":1120,"visible":15},"10002973",{"type":10,"entryId":1121,"sortOrder":1122,"name":1123,"imageUrl":1124,"description":1125,"currentMorphology":9,"currentStage":21,"position":1126,"attributes":1127},"088",1058100,"ハッパウミヒツジ","/cdn/init/Wiki_Aniimo_10581.png","だるそうに葉の羽を伸ばし、口の中はいつもモグモグと動いていて、緑の藻と粘液を舞い飛ぶ泡の影に変える。軽やかにジャンプすれば、泡に乗ってのんびりと船出できる。",[391],[371,393],{"id":1129,"viewCount":58,"searchKey":1130,"visible":15},"10002969",{"type":10,"entryId":1131,"sortOrder":1132,"name":1133,"imageUrl":1134,"description":1135,"currentMorphology":9,"currentStage":286,"position":1136,"attributes":1137},"089",1058300,"リーフゴート","/cdn/init/Wiki_Aniimo_10583.png","緑の葉の羽に覆われたリーフゴートは体が軽く、のんびりと湖畔を歩き回る。澄み切った清らかな波を愛し、水面の逆さ絵に表れる優雅さと余裕を鑑賞することに夢中になっている。",[391],[371,393],{"id":1139,"viewCount":58,"searchKey":1140,"visible":15},"10002960",{"type":10,"entryId":1141,"sortOrder":1142,"name":1143,"imageUrl":1144,"description":1145,"currentMorphology":9,"currentStage":21,"position":1146,"attributes":1147},"090",1062100,"アワダコ","/cdn/init/Wiki_Aniimo_10621.png","色とりどりの泡を集めるのが好きで、気嚢の中の泡は体の動きに合わせて起伏し揺れる。インスピレーションが湧き上がると、カラフルな泡で不思議な落書きを描き出す。",[265],[393],{"id":1149,"viewCount":58,"searchKey":1150,"visible":15},"10003059",{"type":10,"entryId":1151,"sortOrder":1152,"name":1153,"imageUrl":1154,"description":1155,"currentMorphology":9,"currentStage":286,"position":1156,"attributes":1157},"091",1062300,"ガチャダコ","/cdn/init/Wiki_Aniimo_10623.png","柔軟な触手が頭を刺激してさまざまなガチャの泡を発射する。泡の中に隠されているのが驚きのプレゼントなのか、それとも予期せぬハプニングなのか、誰にもわからない。",[265],[393],{"id":1159,"viewCount":58,"searchKey":1160,"visible":15},"10002963",{"type":10,"entryId":1161,"sortOrder":1162,"name":1163,"imageUrl":1164,"description":1165,"currentMorphology":9,"currentStage":21,"position":1166,"attributes":1167},"092",1042100,"クリオネン","/cdn/init/Wiki_Aniimo_10421.png","明るい笑顔で自分を偽装し、こっそりとターゲットに近づく。いざ戦闘に入ると真の姿を現し、力を蓄えた鋭い牙を剥き出しにする。",[265],[414],{"id":1169,"viewCount":58,"searchKey":1170,"visible":15},"10002957",{"type":10,"entryId":1171,"sortOrder":1172,"name":1173,"imageUrl":1174,"description":1175,"currentMorphology":9,"currentStage":286,"position":1176,"attributes":1177},"093",1042300,"クイーンクリオネン","/cdn/init/Wiki_Aniimo_10423.png","柔らかい体の中に鋭い牙と爪を隠している。優しくて無害なふりをして他の生物を油断させ、その後に彼らを氷の彫像に変えるのが得意。",[265],[414],{"id":1179,"viewCount":58,"searchKey":1180,"visible":15},"10003048",{"type":10,"entryId":1181,"sortOrder":1182,"name":1183,"imageUrl":1184,"description":1185,"currentMorphology":9,"currentStage":229,"position":1186,"attributes":1187},"9997",1037300,"フェネルン","/cdn/init/Wiki_Aniimo_10373.png","毛の上には柔らかな月明かりが流れており、少し近づきがたいように見える。常に理性的かつ冷静に物事を捉えるが、親しい人の前では親しげな表情を見せることもある。",[265],[1188],"attributes-holy",{"id":1190,"viewCount":58,"searchKey":1191,"visible":15},"10002925",{"type":10,"entryId":1192,"sortOrder":1193,"name":1194,"imageUrl":1195,"description":1196,"currentMorphology":9,"currentStage":229,"position":1197,"attributes":1198},"9998",1036100,"ヘリオン","/cdn/init/Wiki_Aniimo_10361.png","情熱的で活発、自信に満ち溢れ、勇気を出して仲間を守る。いざという時には強力な力を覚醒させ、驚異的な戦闘力を爆発させる。",[265],[1188],[1200,1207,1210,1214,1219,1224,1229,1234,1239,1243,1248,1253,1256,1261,1266,1271,1276,1281,1286],{"id":1201,"parentId":1202,"tagType":1203,"tagKey":254,"name":1204,"language":1205,"sort":1206},"004553a5156341c3a9cca3bca3b8464c","1400","morphologyTypes","高原フォーム","ja-JP",17,{"id":1208,"parentId":1202,"tagType":1203,"tagKey":13,"name":1209,"language":1205,"sort":133},"46a8c48fa81aa0283ac2c205740b2604","雨天フォーム",{"id":1211,"parentId":1202,"tagType":1203,"tagKey":1212,"name":1213,"language":1205,"sort":82},"519a801e11a64413d3e8df6c57f1e552","Prismana Form","虹色フォーム",{"id":1215,"parentId":1202,"tagType":1203,"tagKey":1216,"name":1217,"language":1205,"sort":1218},"51bb0eb32a128ea453d9ab8892aacb73","Mountain Form","山地フォーム",7,{"id":1220,"parentId":1202,"tagType":1203,"tagKey":1221,"name":1222,"language":1205,"sort":1223},"550085c6b4f6bbd2fd46be7d87b7f829","Sea of Flowers Form","花畑フォーム",10,{"id":1225,"parentId":1202,"tagType":1203,"tagKey":1226,"name":1227,"language":1205,"sort":1228},"59dfd52fc02f120f2d9cfba89ab696cb","Towerwood Form","塔林フォーム",19,{"id":1230,"parentId":1202,"tagType":1203,"tagKey":1231,"name":1232,"language":1205,"sort":1233},"62d5df9d967baab50e078cebf37df514","Forest Form","森林フォーム",8,{"id":1235,"parentId":1202,"tagType":1203,"tagKey":1236,"name":1237,"language":1205,"sort":1238},"685b4da1115703dc6df94fab392294c5","Snowfield Form","雪原フォーム",5,{"id":1240,"parentId":1202,"tagType":1203,"tagKey":251,"name":1241,"language":1205,"sort":1242},"6877edc1c21bbb6fbf6e1b043b27cc87","雲海フォーム",18,{"id":1244,"parentId":1202,"tagType":1203,"tagKey":1245,"name":1246,"language":1205,"sort":1247},"73e8dbcccdad36e2c654505bf56d9089","Mudflat Form","湿地フォーム",13,{"id":1249,"parentId":1202,"tagType":1203,"tagKey":1250,"name":1251,"language":1205,"sort":1252},"76d25ac197634c071dbcd06041289c84","Mountain Woods Form","山林フォーム",6,{"id":1254,"parentId":1202,"tagType":1203,"tagKey":9,"name":12